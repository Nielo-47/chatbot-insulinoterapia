  <data key="d6"></data>
</node>
<node id="Professional Diabetes.org SOC URL">
  <data key="d0">Professional Diabetes.org SOC URL</data>
  <data key="d1">data</data>
  <data key="d2">The URL professional.diabetes.org/SOC provides a platform for comments on the standards of care.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
