</node>
<node id="Basal And Bolus Insulin Delivery">
  <data key="d0">Basal And Bolus Insulin Delivery</data>
  <data key="d1">method</data>
  <data key="d2">Basal and bolus insulin delivery refers to the two modes of insulin administration: continuous background (basal) and on-demand (bolus) delivery.</data>
  <data key="d3">chunk-02b21bc8135e144a626f42f84747459d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1778707371</data>
  <data key="d6"></data>
</node>
<node id="BG Target 3/4 Screen">
  <data key="d0">BG Target 3/4 Screen</data>
  <data key="d1">interface</data>
  <data key="d2">The BG Target 3/4 screen displays the target blood glucose range that the system aims to correct toward.</data>
  <data key="d3">chunk-02b21bc8135e144a626f42f84747459d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1778707371</data>
  <data key="d6"></data>
</node>
