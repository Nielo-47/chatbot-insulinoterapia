</edge>
<edge source="Hypoglycemia" target="Aspirin">
  <data key="d7">1.0</data>
  <data key="d8">Aspirin can interact with insulin therapy and contribute to hypoglycemia.</data>
  <data key="d9">drug interaction</data>
  <data key="d10">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319807</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Sulfas">
  <data key="d7">1.0</data>
  <data key="d8">Sulfas may interact with insulin and lower blood glucose, causing hypoglycemia.</data>
  <data key="d9">drug interaction</data>
  <data key="d10">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319807</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Antidepressants">
  <data key="d7">1.0</data>
  <data key="d8">Antidepressants are listed as medications that can interact with insulin and induce hypoglycemia.</data>
  <data key="d9">drug interaction</data>
  <data key="d10">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319808</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Excess Insulin Administration">
  <data key="d7">2.0</data>
  <data key="d8">Administering excess insulin is a primary cause of hypoglycemia.&lt;SEP&gt;Administering excess insulin can cause hypoglycemia episodes.</data>
