  <data key="d14"></data>
</edge>
<edge source="Insulin Aspart" target="Insulin Detemir">
  <data key="d8">1.0</data>
  <data key="d9">Insulin detemir is used as basal insulin in combination with insulin aspart as bolus insulin in basal-bolus therapy for type 1 diabetes.</data>
  <data key="d10">combination therapy, basal-bolus regimen</data>
