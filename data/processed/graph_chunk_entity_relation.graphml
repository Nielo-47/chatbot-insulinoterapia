  <data key="d5">1786370041</data>
  <data key="d6"></data>
</node>
<node id="Insulin Delivery Devices">
  <data key="d0">Insulin Delivery Devices</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin delivery devices include pumps and other systems that administer insulin to people with diabetes.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335874</data>
  <data key="d6"></data>
</node>
<node id="Blood Glucose Meters">
  <data key="d0">Blood Glucose Meters</data>
  <data key="d1">artifact</data>
  <data key="d2">Blood glucose meters are handheld devices used to measure blood glucose, requiring FDA approval for accuracy.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335874</data>
  <data key="d6"></data>
</node>
<node id="U.S. Food And Drug Administration">
  <data key="d0">U.S. Food And Drug Administration</data>
  <data key="d1">organization</data>
  <data key="d2">The U.S. Food and Drug Administration approves blood glucose meters and regulates medical device accuracy.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335874</data>
  <data key="d6"></data>
</node>
<node id="Hypoxemia">
  <data key="d0">Hypoxemia</data>
  <data key="d1">concept</data>
  <data key="d2">Hypoxemia is a medical condition that can affect the accuracy of blood glucose meter readings.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335874</data>
  <data key="d6"></data>
</node>
<node id="Parental Satisfaction">
  <data key="d0">Parental Satisfaction</data>
  <data key="d1">concept</data>
  <data key="d2">Parental satisfaction reflects caregivers’ contentment with diabetes technology use for their children.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335874</data>
  <data key="d6"></data>
</node>
<node id="Medical Nutrition Therapy">
  <data key="d0">Medical Nutrition Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Medical nutrition therapy is a dietary management method that uses glucose monitoring data to guide nutrition plans.&lt;SEP&gt;Medical nutrition therapy is a diet-focused intervention used to manage diabetes.&lt;SEP&gt;Medical nutrition therapy involves dietary planning to manage diabetes, guided by glucose data.&lt;SEP&gt;Medical nutrition therapy is a dietary management approach for diabetes that may require the addition of insulin.&lt;SEP&gt;Medical Nutrition Therapy is a dietary management approach for diabetes.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78&lt;SEP&gt;chunk-c9bc5d11c9f848439320623cad3d3a38&lt;SEP&gt;chunk-345ad64f464691cc28341ccd246032db&lt;SEP&gt;chunk-b2cd796639bdb0e10eeda7ef3d9ebbce&lt;SEP&gt;chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372096</data>
  <data key="d6"></data>
</node>
<node id="One-Size-Fits-All Approach">
  <data key="d0">One-Size-Fits-All Approach</data>
  <data key="d1">concept</data>
  <data key="d2">The one-size-fits-all approach describes a non‑individualized strategy to technology use that is considered unsuitable for people with diabetes.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335876</data>
  <data key="d6"></data>
</node>
<node id="Technology">
  <data key="d0">Technology</data>
  <data key="d1">concept</data>
  <data key="d2">Technology denotes the rapidly evolving devices and systems used in diabetes management.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335877</data>
  <data key="d6"></data>
</node>
<node id="Health Care Teams">
  <data key="d0">Health Care Teams</data>
  <data key="d1">organization</data>
  <data key="d2">Health care teams are groups of health professionals who may struggle to keep up with newly released diabetes technology.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
