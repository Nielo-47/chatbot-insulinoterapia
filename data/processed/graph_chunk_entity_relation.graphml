</edge>
<edge source="Lantus" target="Elderly Patients">
  <data key="d7">1.0</data>
  <data key="d8">For elderly patients, Lantus initial, incremental, and maintenance doses are recommended to be conservative to avoid hypoglycemia.</data>
  <data key="d9">geriatric use,indication</data>
  <data key="d10">chunk-d59c9bf7f429a82cbfd7083e36ff8f9a</data>
