  <data key="d6"></data>
</node>
<node id="Glucose Level Low Alert">
  <data key="d0">Glucose Level Low Alert</data>
  <data key="d1">method</data>
  <data key="d2">Glucose level low alert is a notification system that warns the user when blood glucose levels are approaching or falling below a predefined lower limit.&lt;SEP&gt;Glucose Level Low Alert is a notification feature that warns the user when glucose levels approach or fall below a low threshold, with options to suspend insulin delivery and resume basal rate.</data>
  <data key="d3">chunk-779002dab61d888870696234d1dbdf19&lt;SEP&gt;chunk-28e93fcffd71ed0c035f0b03374608e5</data>
