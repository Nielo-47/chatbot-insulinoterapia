  <data key="d0">National Recycling Programs</data>
  <data key="d1">concept</data>
  <data key="d2">Recycling initiatives that accept waste batteries, battery packs, electronics, and packaging from the pump.</data>
  <data key="d3">chunk-eb80f00ba2dab32852874cb384b38de3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
