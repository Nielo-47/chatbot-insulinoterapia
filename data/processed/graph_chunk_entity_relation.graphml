  <data key="d5">1786306310</data>
  <data key="d6"></data>
</node>
<node id="Company">
  <data key="d0">Company</data>
  <data key="d1">organization</data>
  <data key="d2">Company refers to the manufacturer or supplier of Humalog that should be notified about adverse reactions.</data>
  <data key="d3">chunk-e89f1dbae629e925f06732cebf41df16</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/Bula Humalog.pdf</data>
