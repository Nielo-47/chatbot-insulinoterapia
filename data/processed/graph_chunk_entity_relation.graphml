  <data key="d14"></data>
</edge>
<edge source="Insulin" target="Dual Bolus">
  <data key="d8">1.0</data>
  <data key="d9">Insulin is administered via a dual bolus, combining immediate and extended delivery to address both rapid and delayed glucose increases from meals.</data>
  <data key="d10">combination therapy,hormone delivery</data>
  <data key="d11">chunk-69f89cc6358f0fe2b490d63a60ae0581</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
