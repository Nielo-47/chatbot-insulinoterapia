  <data key="d0">Transferência De Insulina Animal Para Insulina Humana</data>
  <data key="d1">event</data>
  <data key="d2">The transfer of patients from animal‑derived insulin (bovine, porcine, or mixed) to human insulin evaluated immunological effects.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319696</data>
  <data key="d6"></data>
</node>
<node id="Glicose Oral">
  <data key="d0">Glicose Oral</data>
  <data key="d1">method</data>
  <data key="d2">Glicose oral refers to the administration of glucose by mouth used to treat mild hypoglycemia episodes.</data>
  <data key="d3">chunk-6419fb3ef4249d6c7e8d8a45d82efe80</data>
