<node id="NovoFine">
  <data key="d0">NovoFine</data>
  <data key="d1">artifact</data>
  <data key="d2">Disposable needles up to 8 mm required for administering Fiasp FlexTouch and Penfill.&lt;SEP&gt;NovoFine is a line of disposable needles intended for use with the Fiasp FlexTouch system.</data>
