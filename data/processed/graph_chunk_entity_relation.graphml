  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702782</data>
  <data key="d14"></data>
</edge>
<edge source="Hyperglycemia" target="Carbohydrate Counting Error">
  <data key="d8">1.0</data>
  <data key="d9">Miscalculating carbohydrate intake can lead to insufficient insulin and result in hyperglycemia.</data>
