  <data key="d13">1778709321</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Continuous Glucose Monitoring System">
  <data key="d8">1.0</data>
  <data key="d9">The patient uses the Continuous Glucose Monitoring System for daily diabetes management and glucose tracking.</data>
  <data key="d10">device usage,self-management</data>
  <data key="d11">chunk-3aeabf750656ceb7619502d5fd50ebe6</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/monitoramento contínuo de glicose.pdf</data>
  <data key="d13">1778709328</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Capillary Blood Glucose">
  <data key="d8">1.0</data>
  <data key="d9">Capillary blood glucose provides an immediate snapshot of current blood sugar levels.</data>
  <data key="d10">real-time monitoring, point measurement</data>
  <data key="d11">chunk-986fc7ecc813c4b7942964d7fd64d429</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694596</data>
