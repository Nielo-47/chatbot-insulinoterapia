</edge>
<edge source="Lipodystrophy" target="Injection Site">
  <data key="d7">2.0</data>
  <data key="d8">Lipodystrophy develops in the skin at the insulin injection site.&lt;SEP&gt;Repeated insulin injections in areas with lipodystrophy have been reported.</data>
  <data key="d9">association,complication,condition,location</data>
  <data key="d10">chunk-525086e26636af026c417773a8f11a92&lt;SEP&gt;chunk-a1245bd9ff75c998b49dab861cc4cebf</data>
