  <data key="d0">Concentrated Intravenous Glucose Solution</data>
  <data key="d1">artifact</data>
  <data key="d2">Concentrated Intravenous Glucose Solution is a sterile glucose preparation used intravenously to treat severe hypoglycemia.</data>
  <data key="d3">chunk-1d7223c781e745e72311fccfcdd58583</data>
