</node>
<node id="Level 2 Hyperglycemia">
  <data key="d0">Level 2 Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Level 2 Hyperglycemia refers to glucose readings above 250 mg/dL (&gt;13.9 mmol/L).</data>
