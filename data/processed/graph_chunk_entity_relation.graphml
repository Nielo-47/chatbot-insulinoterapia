</node>
<node id="Loop DIY Algorithm">
  <data key="d0">Loop DIY Algorithm</data>
  <data key="d1">method</data>
  <data key="d2">A do‑it‑yourself AID algorithm that allows manual entry of inhaled insulin doses.</data>
