  <data key="d13">1778707547</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Pattern" target="Manual Mode">
  <data key="d8">2.0</data>
  <data key="d9">Basal pattern settings are only applicable in Manual mode and do not influence insulin delivery in SmartGuard mode.&lt;SEP&gt;In Manual Mode, the insulin pump delivers basal insulin according to the active basal pattern, which must be carefully reviewed for safety.</data>
  <data key="d10">insulin delivery control,insulin delivery setting,mode dependency,operational configuration</data>
  <data key="d11">chunk-559587c4971d344102a5ceb58d84260d&lt;SEP&gt;chunk-7d37ccd138ed8a095eb197006a33b8a7</data>
