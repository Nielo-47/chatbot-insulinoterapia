  <data key="d13"></data>
</edge>
<edge source="Sensor Glucose Value" target="Vitamin C">
  <data key="d7">1.0</data>
  <data key="d8">High doses of Vitamin C can falsely raise sensor glucose readings, risking insulin over‑delivery.</data>
  <data key="d9">false elevation,interferes</data>
  <data key="d10">chunk-db5749bec4af1c3ea068b257c4376aaf</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330332</data>
  <data key="d13"></data>
</edge>
<edge source="Sensor Glucose Value" target="Hydroxyurea">
  <data key="d7">1.0</data>
  <data key="d8">Hydroxyurea results in higher sensor glucose readings compared with blood glucose measurements.</data>
  <data key="d9">false elevation,raises</data>
  <data key="d10">chunk-db5749bec4af1c3ea068b257c4376aaf</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330333</data>
  <data key="d13"></data>
</edge>
<edge source="Sensor Glucose Value" target="Acetaminophen">
  <data key="d7">1.0</data>
  <data key="d8">Acetaminophen can falsely raise sensor glucose readings, potentially causing insulin overdosing.</data>
  <data key="d9">false elevation,interferes</data>
  <data key="d10">chunk-db5749bec4af1c3ea068b257c4376aaf</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330334</data>
  <data key="d13"></data>
</edge>
<edge source="Sensor Glucose Value" target="Paracetamol">
  <data key="d7">1.0</data>
  <data key="d8">Paracetamol can falsely raise sensor glucose readings, similar to acetaminophen.</data>
  <data key="d9">false elevation,interferes</data>
  <data key="d10">chunk-db5749bec4af1c3ea068b257c4376aaf</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330335</data>
  <data key="d13"></data>
</edge>
<edge source="CGM Device" target="Magnetic Fields">
  <data key="d7">1.0</data>
  <data key="d8">Magnetic fields from MRI, diathermy, or other sources can cause the CGM device to malfunction.</data>
  <data key="d9">interference,safety risk</data>
