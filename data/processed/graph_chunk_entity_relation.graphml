  <data key="d13">1778708522</data>
  <data key="d14"></data>
</edge>
<edge source="Pump" target="Third-Party Infusion Set">
  <data key="d8">1.0</data>
  <data key="d9">Using a third-party infusion set with the pump is not supported by Medtronic Diabetes and may result in malfunction or injury.</data>
  <data key="d10">compatibility risk,safety warning</data>
  <data key="d11">chunk-6f4df342459d4afd90a81b1a3f13d859</data>
