<node id="Rise Alert Sensitivity">
  <data key="d0">Rise Alert Sensitivity</data>
  <data key="d1">method</data>
  <data key="d2">A setting that determines when an alert is triggered if the sensor glucose (SG) reading is rising rapidly, related to insulin sensitivity factor.</data>
  <data key="d3">chunk-a76c99cd46001ae6a2373d3413db020f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
