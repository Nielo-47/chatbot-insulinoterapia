<node id="Blood Sugar">
  <data key="d0">Blood Sugar</data>
  <data key="d1">concept</data>
  <data key="d2">Blood sugar refers to the level of glucose in the bloodstream, which insulin helps regulate to prevent complications.</data>
  <data key="d3">chunk-2a0a3f492aa5ef7771b2246547cb5f02</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
