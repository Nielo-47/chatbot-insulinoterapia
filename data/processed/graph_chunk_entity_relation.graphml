</node>
<node id="Small‑Molecule Drugs">
  <data key="d0">Small‑Molecule Drugs</data>
  <data key="d1">concept</data>
  <data key="d2">Small‑molecule drugs are chemical compounds that are absorbed rapidly through the lungs with high bioavailability.</data>
