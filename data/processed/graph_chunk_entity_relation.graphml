  <data key="d14"></data>
</edge>
<edge source="Suspend Before Low" target="Suspend Delivery">
  <data key="d8">1.0</data>
  <data key="d9">Suspend Before Low is a predictive function that triggers Suspend Delivery when low glucose is anticipated.</data>
