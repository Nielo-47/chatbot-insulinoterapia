<edge source="Thermal Protection Packaging" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">During transport, Novolin® R must be carried in thermal protection packaging to prevent temperature changes and light exposure.</data>
  <data key="d10">temperature stability,transport condition</data>
