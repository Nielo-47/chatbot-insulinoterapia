  <data key="d5">1786324192</data>
  <data key="d6"></data>
</node>
<node id="Configuración De Patrones Basales">
  <data key="d0">Configuración De Patrones Basales</data>
  <data key="d1">method</data>
  <data key="d2">Configuración De Patrones Basales is the procedure described in the guide for setting, adjusting, and removing basal rate indices.&lt;SEP&gt;Configuración De Patrones Basales is a method for editing and saving basal insulin patterns on the pump.</data>
  <data key="d3">chunk-1d41e93e7754b06eedcc2e2a44afcb32&lt;SEP&gt;chunk-d7305e2b34a4a57db2afea4935fe2fc2</data>
