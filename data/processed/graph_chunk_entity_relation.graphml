  <data key="d12">1786329815</data>
  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Pump">
  <data key="d7">3.0</data>
  <data key="d8">The pump delivers insulin through the infusion set to the body.&lt;SEP&gt;The pump connects to the infusion set to deliver medication.&lt;SEP&gt;The pump connects to an Infusion Set that transports insulin to the body.</data>
  <data key="d9">component usage,connection,delivery</data>
