  <data key="d13">1778707912</data>
  <data key="d14"></data>
</edge>
<edge source="Low Reservoir Alert" target="Pump">
  <data key="d8">1.0</data>
  <data key="d9">The pump triggers a low reservoir alert based on preset insulin units, warning of imminent delivery stoppage.</data>
  <data key="d10">delivery cutoff,insulin level monitoring</data>
