</edge>
<edge source="Hyperglycemia" target="Cetone Breath">
  <data key="d8">1.0</data>
  <data key="d9">Cetone breath occurs during severe hyperglycemia and is a clinical sign of ketoacidosis in diabetes.</data>
  <data key="d10">metabolic state,symptom manifestation</data>
  <data key="d11">chunk-849980827afbc1e3097aed3d19640efe</data>
