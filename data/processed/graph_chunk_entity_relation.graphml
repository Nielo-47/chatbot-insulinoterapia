  <data key="d6"></data>
</node>
<node id="Oral Glucose Tolerance Testing">
  <data key="d0">Oral Glucose Tolerance Testing</data>
  <data key="d1">method</data>
  <data key="d2">Oral Glucose Tolerance Testing is a diagnostic procedure requiring adequate carbohydrate intake prior to testing.</data>
  <data key="d3">chunk-3cc61bc2e95346d553972b4371912e7f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
