  <data key="d14"></data>
  <data key="d15">Anemia</data>
  <data key="d16">HbA1c</data>
</edge>
<edge source="HbA1c" target="Kidney Disease">
  <data key="d8">1.0</data>
  <data key="d9">Kidney disease may distort HbA1c readings, making it less reliable for glucose assessment in affected individuals.</data>
  <data key="d10">test interference, diagnostic limitation</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
