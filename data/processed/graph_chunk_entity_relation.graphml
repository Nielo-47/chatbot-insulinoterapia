  <data key="d13">1778704196</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Level" target="Low Blood Sugar">
  <data key="d8">1.0</data>
  <data key="d9">A blood glucose level below 70 mg/dL defines low blood sugar, which requires immediate treatment.</data>
  <data key="d10">health risk,threshold condition</data>
  <data key="d11">chunk-2bfad6c7b0e936c6a9c113798a2d963e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701058</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Level" target="High Blood Sugar">
  <data key="d8">1.0</data>
  <data key="d9">A blood glucose level above 250 mg/dL indicates high blood sugar, necessitating further testing and corrective action.</data>
  <data key="d10">health risk,threshold condition</data>
  <data key="d11">chunk-2bfad6c7b0e936c6a9c113798a2d963e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701059</data>
  <data key="d14"></data>
</edge>
