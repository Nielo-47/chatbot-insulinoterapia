  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Active Insulin Cleared">
  <data key="d8">1.0</data>
  <data key="d9">The Active Insulin Cleared alert is displayed by the MiniMed 780G system when active insulin is reset to zero.</data>
  <data key="d10">alert notification,insulin tracking</data>
  <data key="d11">chunk-64e8ebad9c2de6a1aeba1645920f2e35</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708221</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="U-100 Admelog">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G system is intended for use with U-100 Admelog insulin as prescribed by a healthcare professional.</data>
  <data key="d10">insulin compatibility,prescribed use</data>
