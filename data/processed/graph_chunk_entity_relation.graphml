  <data key="d15">HbA1c</data>
  <data key="d16">Pregnancy</data>
</edge>
<edge source="HbA1c" target="Anemia">
  <data key="d8">1.0</data>
  <data key="d9">Anemia can cause inaccurate HbA1c results, limiting its reliability in certain patients.</data>
  <data key="d10">test interference, diagnostic limitation</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
