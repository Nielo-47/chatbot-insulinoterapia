  <data key="d5">1786332446</data>
  <data key="d6"></data>
</node>
<node id="John Macleod">
  <data key="d0">John Macleod</data>
  <data key="d1">person</data>
  <data key="d2">John Macleod is a Scottish physiologist who was convinced by Sir Frederick Banting to collaborate on insulin research.&lt;SEP&gt;John Macleod was a professor who oversaw insulin research and was a party to the 1922 Connaught agreement.&lt;SEP&gt;John Macleod was a researcher who collaborated with Banting and Best on insulin discovery and declined Eli Lilly’s collaboration offer.&lt;SEP&gt;John Macleod first called the pancreatic extract “Insulin” and corresponded with Robert Falconer about patent matters.</data>
  <data key="d3">chunk-0ba3c49b467b6d37cd2aab29bf4a3119&lt;SEP&gt;chunk-9043f44e67d9ed02b4864043d3cbb59a&lt;SEP&gt;chunk-ad5d126f417014eb5c7a07a85db48d1d&lt;SEP&gt;chunk-c53f6d8d7aad59b28e557f5971d0d828</data>
