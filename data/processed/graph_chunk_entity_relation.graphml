  <data key="d5">1778707452</data>
  <data key="d6"></data>
</node>
<node id="Settings History">
  <data key="d0">Settings History</data>
  <data key="d1">data</data>
  <data key="d2">Settings History records past actions performed in the Manage Settings menu, such as when settings were saved, restored, or cleared.</data>
  <data key="d3">chunk-39a29f6130bd8284c7277df75ae0e90d</data>
