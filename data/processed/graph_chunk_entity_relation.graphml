  <data key="d13"></data>
</edge>
<edge source="Caneta de Insulina" target="Diretriz da Sociedade Brasileira de Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">The guideline recommends the caneta de insulina because it is associated with higher HbA1c target achievement and lower hipoglicemia.</data>
  <data key="d9">device recommendation</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298870</data>
  <data key="d13"></data>
</edge>
<edge source="Caneta de Insulina" target="Hemoglobina Glicada">
  <data key="d7">1.0</data>
  <data key="d8">Use of the caneta de insulina is linked to a greater proportion of patients reaching HbA1c goals.</data>
  <data key="d9">clinical outcome</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298870</data>
  <data key="d13"></data>
</edge>
<edge source="Caneta de Insulina" target="Hipoglicemia">
  <data key="d7">1.0</data>
  <data key="d8">Use of the caneta de insulina is associated with a lower incidence of hipoglicemia compared with syringes.</data>
  <data key="d9">safety benefit</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
