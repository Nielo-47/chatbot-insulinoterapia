<node id="William">
  <data key="d0">William</data>
  <data key="d1">person</data>
  <data key="d2">William is a person who uses a dual bolus to manage post-meal hyperglycemia, particularly when eating pizza.&lt;SEP&gt;William is a person who uses a bolus cuadrado to manage post-meal hyperglycemia, particularly after eating pizza.</data>
  <data key="d3">chunk-e96a4da2f877f1b93eb7d982c91358ea&lt;SEP&gt;chunk-e15921d1b7d6415709a3d0c795cefc3c</data>
