  <data key="d1">artifact</data>
  <data key="d2">Agulha Compatível com Administração Subcutânea are needles required for subcutaneous injection with the disposable pen.</data>
  <data key="d3">chunk-aca0b919135813e1d5b772face36989d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
