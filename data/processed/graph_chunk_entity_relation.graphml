  <data key="d0">Diabetes Treatment Satisfaction Questionnaire</data>
  <data key="d1">content</data>
  <data key="d2">The Diabetes Treatment Satisfaction Questionnaire is a standardized instrument that measures patients’ satisfaction with diabetes treatment.</data>
  <data key="d3">chunk-511f6be03d2ea98970bd4c1b29b3e5c8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
