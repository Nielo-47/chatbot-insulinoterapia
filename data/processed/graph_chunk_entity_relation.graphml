  <data key="d13"></data>
</edge>
<edge source="A1C" target="ADAG Trial">
  <data key="d7">1.0</data>
  <data key="d8">The ADAG trial observed a lower correlation (r = 0.7) between A1C and mean blood glucose in children with type 1 diabetes.</data>
  <data key="d9">correlation,source</data>
