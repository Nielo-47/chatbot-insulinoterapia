  <data key="d0">Concentração De Anticorpos Anti‑insulina</data>
  <data key="d1">data</data>
  <data key="d2">Concentração De Anticorpos Anti‑insulina denotes the measured levels of insulin‑specific antibodies evaluated at baseline and monthly thereafter.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319695</data>
  <data key="d6"></data>
</node>
