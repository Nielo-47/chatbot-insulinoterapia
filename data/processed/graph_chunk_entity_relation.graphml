  <data key="d1">artifact</data>
  <data key="d2">Inibidores Da Monoaminoxidase são medicamentos que podem reduzir as necessidades de insulina em pacientes diabéticos.</data>
  <data key="d3">chunk-54b65b433ba47e8bbf2d607b89776246</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1778698983</data>
  <data key="d6"></data>
</node>
