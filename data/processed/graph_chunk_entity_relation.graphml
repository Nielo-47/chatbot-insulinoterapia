  <data key="d6"></data>
</node>
<node id="Sensor Status Screen">
  <data key="d0">Sensor Status Screen</data>
  <data key="d1">interface</data>
  <data key="d2">The Sensor status screen displays CGM device information such as life, serial number, software version, and transmitter battery status.</data>
