<edge source="Levemir" target="Severe Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Severe hypoglycemia, requiring third‑party intervention, occurs in roughly 6% of patients treated with Levemir®.</data>
  <data key="d9">adverse effect,severity</data>
  <data key="d10">chunk-0ace26fdb0244e3d0f714a007c9bbb51</data>
