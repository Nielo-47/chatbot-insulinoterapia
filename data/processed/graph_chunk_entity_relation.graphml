  <data key="d13"></data>
</edge>
<edge source="Pre-diabetes" target="TTGO-1h Pre-diabetes Range 155‑208 mg/dl">
  <data key="d7">1.0</data>
  <data key="d8">TTGO‑1h values between 155 and 208 mg/dL define pre‑diabetes.</data>
  <data key="d9">criterion,diagnostic range</data>
  <data key="d10">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372147</data>
  <data key="d13"></data>
</edge>
<edge source="Pre-diabetes" target="TTGO-2h Pre-diabetes Range 140‑199 mg/dl">
  <data key="d7">1.0</data>
  <data key="d8">TTGO‑2h values between 140 and 199 mg/dL define pre‑diabetes.</data>
  <data key="d9">criterion,diagnostic range</data>
  <data key="d10">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372148</data>
  <data key="d13"></data>
</edge>
<edge source="National Diabetes Data Group" target="Randomized Clinical Trial of Mild GDM">
  <data key="d7">1.0</data>
  <data key="d8">The trial also demonstrated benefit for participants meeting only the higher National Diabetes Data Group thresholds.</data>
  <data key="d9">higher thresholds,treatment efficacy</data>
