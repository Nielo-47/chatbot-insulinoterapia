</edge>
<edge source="Hydroxyurea" target="Hydroxycarbamide">
  <data key="d8">2.0</data>
  <data key="d9">Hydroxyurea is also known as hydroxycarbamide, indicating they are the same substance.</data>
  <data key="d10">alternative name,chemical identity,synonym</data>
