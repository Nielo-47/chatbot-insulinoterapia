  <data key="d0">Pharmacokinetic Study in Volunteers with Renal Dysfunction</data>
  <data key="d1">event</data>
  <data key="d2">A single‑dose pharmacokinetic study in 18 volunteers with varying renal function assessed insulin aspart absorption.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
