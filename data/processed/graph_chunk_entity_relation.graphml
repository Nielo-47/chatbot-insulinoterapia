<edge source="Agulha" target="Tecido Subcutâneo">
  <data key="d8">1.0</data>
  <data key="d9">The needle is designed to deliver insulin into the subcutaneous tissue, the correct layer beneath the skin.</data>
  <data key="d10">delivery site,injection target</data>
  <data key="d11">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695445</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Prega Subcutânea">
  <data key="d8">1.0</data>
  <data key="d9">Using a skin pinch (prega subcutânea) with short needles, especially 4 mm, helps ensure correct insulin delivery and prevents intramuscular injection.</data>
  <data key="d10">injection technique,safety measure</data>
  <data key="d11">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695446</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Alta Fluência">
  <data key="d8">1.0</data>
  <data key="d9">High-flow needles have thinner walls that allow easier and faster insulin passage, improving comfort and reliability.</data>
  <data key="d10">improved delivery,needle technology</data>
  <data key="d11">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695451</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Aplicação de Insulina">
  <data key="d8">1.0</data>
  <data key="d9">Insulin is applied using a pen and needle, following a step-by-step process to ensure correct dosing and hygiene.</data>
  <data key="d10">administration method,injection process</data>
  <data key="d11">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695454</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Protetor Externo">
  <data key="d8">1.0</data>
  <data key="d9">O protetor externo é usado para remover a agulha com segurança após a aplicação.</data>
  <data key="d10">remoção,segurança</data>
  <data key="d11">chunk-8792cad0fa7c0226f159b670b4e743a1</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778695984</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Recipiente Próprio">
  <data key="d8">1.0</data>
  <data key="d9">A agulha deve ser descartada em um recipiente próprio após o uso.</data>
  <data key="d10">descarte seguro,procedimento</data>
  <data key="d11">chunk-8792cad0fa7c0226f159b670b4e743a1</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778695985</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Levemir® FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">The agulha is attached to the Levemir® FlexPen® for subcutaneous insulin delivery.</data>
  <data key="d10">injection,needle attachment</data>
  <data key="d11">chunk-5d212ccdded1e4ccf51af243a8d38b4c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698391</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Tampa Externa">
  <data key="d8">1.0</data>
  <data key="d9">The tampa externa protects the agulha when not in use and is reused to cover the needle after injection.</data>
  <data key="d10">protection,storage</data>
  <data key="d11">chunk-5d212ccdded1e4ccf51af243a8d38b4c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698394</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Tampa Interna">
  <data key="d8">1.0</data>
  <data key="d9">The tampa interna is a single-use cap that is discarded after attaching the needle to prevent injury.</data>
  <data key="d10">disposable protection,safety</data>
  <data key="d11">chunk-5d212ccdded1e4ccf51af243a8d38b4c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698395</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Selo Protetor">
  <data key="d8">1.0</data>
  <data key="d9">The selo protetor maintains sterility of the new needle before first use and must be removed prior to attachment.</data>
  <data key="d10">initial seal,sterility</data>
  <data key="d11">chunk-5d212ccdded1e4ccf51af243a8d38b4c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698397</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Contamination">
  <data key="d8">1.0</data>
  <data key="d9">Reusing the agulha increases the risk of contamination, which may lead to infection.</data>
  <data key="d10">infection risk,reuse</data>
  <data key="d11">chunk-5d212ccdded1e4ccf51af243a8d38b4c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698400</data>
  <data key="d14"></data>
</edge>
<edge source="Agulha" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">The Novolin® R FlexPen® requires the attachment of a disposable needle for each injection to ensure accurate dosing and prevent contamination.</data>
  <data key="d10">device attachment,injection mechanism</data>
  <data key="d11">chunk-b93b5769e8df2e4aa6c2c1dc9e65fd85</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699032</data>
  <data key="d14"></data>
</edge>
<edge source="Storage Temperature" target="Insulin Stability">
  <data key="d8">1.0</data>
  <data key="d9">Storage temperature (2–8°C, room temperature, or 37°C) did not result in statistically significant differences in insulin stability after 28 days.</data>
  <data key="d10">chemical stability,temperature impact</data>
  <data key="d11">chunk-a7740b86f0b3f110bb2c3f3d05e4da41</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695212</data>
  <data key="d14"></data>
</edge>
<edge source="Storage Temperature" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R FlexPen® must be stored between 2°C and 8°C when unopened and up to 30°C after opening, without freezing.</data>
  <data key="d10">storage requirement,temperature sensitivity</data>
  <data key="d11">chunk-ea9fa1ee045093083e543d672f1309db</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699180</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohipertrophy" target="Insulin Injection Site Rotation">
  <data key="d8">1.0</data>
  <data key="d9">Proper rotation of insulin injection sites reduces the risk of lipohipertrophy, with only 5% of correct rotators affected compared to 98% of non-rotators.</data>
  <data key="d10">prevention,risk reduction</data>
  <data key="d11">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695247</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohipertrophy" target="Unexplained Hypoglycemia">
  <data key="d8">1.0</data>
  <data key="d9">Unexplained hypoglycemia occurs in 39.1% of patients with lipohipertrophy versus 5.9% in those without.</data>
  <data key="d10">hypoglycemia risk,metabolic complication</data>
  <data key="d11">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695249</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohipertrophy" target="Daily Insulin Dose">
  <data key="d8">1.0</data>
  <data key="d9">Patients with lipohipertrophy require higher average daily insulin doses (56 UI/day vs 41 UI/day), increasing healthcare costs.</data>
  <data key="d10">cost impact,treatment intensity</data>
  <data key="d11">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695250</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohipertrophy" target="Blanco M">
  <data key="d8">1.0</data>
  <data key="d9">Blanco M led a study on the prevalence and risk factors of lipohipertrophy in insulin-injecting patients with diabetes.</data>
  <data key="d10">complication study,medical research</data>
  <data key="d11">chunk-f7da978df74ee7f686dcc3c260d75577</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
  <data key="d13">1778696276</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohipertrophy" target="Hernandez Mt">
  <data key="d8">1.0</data>
  <data key="d9">Hernandez Mt co-authored research on lipohipertrophy, a potential complication of repeated insulin injections.</data>
  <data key="d10">diabetes complication,medical research</data>
  <data key="d11">chunk-f7da978df74ee7f686dcc3c260d75577</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
  <data key="d13">1778696277</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohipertrophy" target="Amaya M">
  <data key="d8">1.0</data>
  <data key="d9">Amaya M contributed to a study examining the occurrence and risk factors of lipohipertrophy in diabetic patients using insulin therapy.</data>
  <data key="d10">clinical study,injection site health</data>
  <data key="d11">chunk-f7da978df74ee7f686dcc3c260d75577</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
  <data key="d13">1778696278</data>
  <data key="d14"></data>
</edge>
<edge source="Controle Glicêmico" target="Gravidez">
  <data key="d8">1.0</data>
  <data key="d9">Glycemic control during pregnancy was evaluated to ensure safety and effectiveness of Levemir® in diabetic pregnant women.</data>
  <data key="d10">maternal health,treatment effectiveness</data>
  <data key="d11">chunk-2e2fd1844a95ab6fd4f7d89cdbddbc58</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698225</data>
  <data key="d14"></data>
</edge>
<edge source="Controle Glicêmico" target="Neuropatia Dolorosa">
  <data key="d8">1.0</data>
  <data key="d9">Melhora rápida do controle glicêmico pode desencadear neuropatia dolorosa aguda, uma complicação reversível.</data>
  <data key="d10">metabolic effect,neurological impact</data>
  <data key="d11">chunk-61071ebd09f043bc8e0041fda9bdf64a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698315</data>
  <data key="d14"></data>
</edge>
<edge source="Abdomen" target="Injection Sites">
  <data key="d8">1.0</data>
  <data key="d9">The abdomen is a recommended insulin injection site, applied laterally and 3–4 finger widths from the navel.</data>
  <data key="d10">anatomical guidance,location specification</data>
  <data key="d11">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694485</data>
  <data key="d14"></data>
</edge>
<edge source="Abdomen" target="Insulin Absorption Rate">
  <data key="d8">2.0</data>
  <data key="d9">The abdomen has the fastest insulin absorption rate, making it a preferred injection site.&lt;SEP&gt;The abdomen is the fastest site for insulin absorption, making it ideal for rapid-acting insulin needs.</data>
  <data key="d10">fastest absorption,injection site</data>
  <data key="d11">chunk-1d9f7234865211afc5d8343294b276d1&lt;SEP&gt;chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d12">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695431</data>
  <data key="d14"></data>
</edge>
<edge source="Room Temperature" target="Insulin in Use">
  <data key="d8">1.0</data>
  <data key="d9">Insulin in use, including in vials or disposable pens, can be kept at room temperature up to 30°C for 4 to 8 weeks.</data>
  <data key="d10">short-term storage,usage period</data>
  <data key="d11">chunk-a81bec86298f297d9be7cc985a7eddb6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696039</data>
  <data key="d14"></data>
</edge>
<edge source="Room Temperature" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">After opening, Novolin® R can be stored at room temperature (15°C to 30°C) for up to 6 weeks.</data>
  <data key="d10">post-opening use,storage condition</data>
  <data key="d11">chunk-0e1d7f92cdb7923807a9067d937837a4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699112</data>
  <data key="d14"></data>
</edge>
<edge source="Thighs" target="Injection Sites">
  <data key="d8">1.0</data>
  <data key="d9">The thighs are a recommended insulin injection site, specifically the front and outer side between defined anatomical landmarks.</data>
  <data key="d10">anatomical guidance,location specification</data>
  <data key="d11">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694491</data>
  <data key="d14"></data>
</edge>
<edge source="Arms" target="Injection Sites">
  <data key="d8">1.0</data>
  <data key="d9">The arms are a recommended insulin injection site, specifically the back of the upper arm between 4 finger widths below the armpit and above the elbow.</data>
  <data key="d10">anatomical guidance,location specification</data>
  <data key="d11">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694492</data>
  <data key="d14"></data>
</edge>
<edge source="Air Bubbles" target="Syringe">
  <data key="d8">1.0</data>
  <data key="d9">Air bubbles in the syringe during insulin preparation must be removed to ensure accurate dosing.</data>
  <data key="d10">correction procedure,dosing error</data>
  <data key="d11">chunk-035472811a4a16d98e62eba23a86dceb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695220</data>
  <data key="d14"></data>
</edge>
<edge source="Air Bubbles" target="Dosing Error">
  <data key="d8">1.0</data>
  <data key="d9">The presence of air bubbles in insulin devices can lead to inaccurate dosing and must be removed before injection.</data>
  <data key="d10">administration risk,injection safety</data>
  <data key="d11">chunk-a81bec86298f297d9be7cc985a7eddb6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696040</data>
  <data key="d14"></data>
</edge>
<edge source="Air Bubbles" target="Insulin Homogenization">
  <data key="d8">1.0</data>
  <data key="d9">Vigorous shaking during homogenization can introduce air bubbles, leading to incorrect dosing if not removed.</data>
  <data key="d10">administration error,dosing accuracy</data>
  <data key="d11">chunk-c8702ff00244abf3caabafff5aad4a65</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte e conservação Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
  <data key="d13">1778696372</data>
  <data key="d14"></data>
</edge>
<edge source="Air Bubbles" target="Tubing">
  <data key="d8">2.0</data>
  <data key="d9">Air bubbles in the tubing must be moved out by pushing the plunger slightly after connecting the reservoir.&lt;SEP&gt;Air bubbles in the tubing can lead to inaccurate insulin delivery and must be removed by filling until drops appear.</data>
  <data key="d10">delivery obstruction,performance issue,priming step,safety concern</data>
  <data key="d11">chunk-edefb6aab17535eddb38eddb8b8fc7df&lt;SEP&gt;chunk-cc61f77b003d0086bd985ddb94fc2a98</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707542</data>
  <data key="d14"></data>
</edge>
<edge source="Air Bubbles" target="Reservoir">
  <data key="d8">1.0</data>
  <data key="d9">Air bubbles in the reservoir can cause inaccurate insulin delivery and must be removed by tapping and pushing the plunger.</data>
  <data key="d10">bubble removal,delivery risk</data>
  <data key="d11">chunk-cc61f77b003d0086bd985ddb94fc2a98</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708128</data>
  <data key="d14"></data>
</edge>
<edge source="Geladeira" target="Caneta De Insulina">
  <data key="d8">1.0</data>
  <data key="d9">Canetas recarregáveis de insulina não devem ser guardadas na geladeira porque o frio pode danificar seu mecanismo.</data>
  <data key="d10">armazenamento inadequado,risco de dano</data>
  <data key="d11">chunk-8336dc27990f6189c99863d64435c6c6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/Armazenamento e transporte.docx</data>
  <data key="d13">1778696092</data>
  <data key="d14"></data>
</edge>
<edge source="Seringa de Insulina" target="Agulha Removível">
  <data key="d8">1.0</data>
  <data key="d9">Using an insulin syringe with a detachable needle can lead to volume loss and inaccurate dosing due to dead space.</data>
  <data key="d10">device design,dosing error</data>
  <data key="d11">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696024</data>
  <data key="d14"></data>
</edge>
<edge source="Seringa de Insulina" target="Agulha Fixa">
  <data key="d8">1.0</data>
  <data key="d9">Insulin syringes with fixed, short needles are recommended to minimize dead space and ensure accurate dosing.</data>
  <data key="d10">device recommendation,safety improvement</data>
  <data key="d11">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696026</data>
  <data key="d14"></data>
</edge>
<edge source="Water" target="Ketone Bodies">
  <data key="d8">1.0</data>
  <data key="d9">Drinking water helps flush out ketone bodies and supports metabolic balance during hyperglycemia.</data>
  <data key="d10">hydration,metabolic support</data>
  <data key="d11">chunk-6ec727091282384bd8f9c91eb1d29b78</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702858</data>
  <data key="d14"></data>
</edge>
<edge source="Alcohol 70%" target="Skin">
  <data key="d8">2.0</data>
  <data key="d9">Alcohol 70% is applied to the skin before insulin injection and must be allowed to dry completely.&lt;SEP&gt;Alcohol 70% is applied to the skin to disinfect the injection site before insulin administration.</data>
  <data key="d10">disinfection,hygiene,preparation</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef&lt;SEP&gt;chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
  <data key="d12">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/Documento sem título.docx</data>
  <data key="d13">1778694982</data>
  <data key="d14"></data>
</edge>
<edge source="Alcohol 70%" target="Step-by-Step Insulin Administration">
  <data key="d8">1.0</data>
  <data key="d9">Alcohol 70% is used in the step-by-step process to clean the insulin vial before drawing the dose.</data>
  <data key="d10">infection control,preparation</data>
  <data key="d11">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695427</data>
  <data key="d14"></data>
</edge>
<edge source="Alcohol 70%" target="Skin Care">
  <data key="d8">1.0</data>
  <data key="d9">Alcohol 70% is recommended for cleaning the skin in clinical settings before insulin injection.</data>
  <data key="d10">disinfection,hygiene practice</data>
  <data key="d11">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695458</data>
  <data key="d14"></data>
</edge>
<edge source="Alcohol 70%" target="Insulin Application Technique">
  <data key="d8">1.0</data>
  <data key="d9">Alcohol 70% is used to clean both the injection site and the pen’s needle attachment area.</data>
  <data key="d10">disinfection,preparation</data>
  <data key="d11">chunk-e68da6d45eb01c249e854b711007d805</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Insulinas CANETAS.pdf</data>
  <data key="d13">1778695612</data>
  <data key="d14"></data>
</edge>
<edge source="Alcohol 70%" target="Insulin Injection Procedure">
  <data key="d8">1.0</data>
  <data key="d9">Alcohol 70% is used during the insulin injection procedure to disinfect the injection site and equipment.</data>
  <data key="d10">disinfection,infection prevention</data>
  <data key="d11">chunk-180dc3d244f7d832cf505b09cfc34746</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696044</data>
  <data key="d14"></data>
</edge>
<edge source="Skin" target="Redness">
  <data key="d8">1.0</data>
  <data key="d9">Redness on the skin is a sign of inflammation and indicates the site should be avoided for insulin injection.</data>
  <data key="d10">contraindication,inflammation indicator</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694471</data>
  <data key="d14"></data>
</edge>
<edge source="Skin" target="Swelling">
  <data key="d8">1.0</data>
  <data key="d9">Swelling or edema in the skin is a reason to avoid insulin injection in that area.</data>
  <data key="d10">contraindication,edema</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694477</data>
  <data key="d14"></data>
</edge>
<edge source="Skin" target="Wounds">
  <data key="d8">1.0</data>
  <data key="d9">Wounds, injuries, or scars on the skin are sites where insulin should not be administered.</data>
  <data key="d10">contraindication,injury</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694478</data>
  <data key="d14"></data>
</edge>
<edge source="Skin" target="Infections">
  <data key="d8">1.0</data>
  <data key="d9">Infected skin with discharge is unsuitable for insulin injection due to risk of complications.</data>
  <data key="d10">contraindication,infection risk</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694479</data>
  <data key="d14"></data>
</edge>
<edge source="Skin" target="Fistulas">
  <data key="d8">1.0</data>
  <data key="d9">Fistulas, or abnormal passages in the skin, are unsafe sites for insulin injection.</data>
  <data key="d10">abnormal passage,contraindication</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694479</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Fold" target="Intramuscular Injection">
  <data key="d8">1.0</data>
  <data key="d9">Using the subcutaneous fold helps prevent accidental intramuscular injection of insulin.</data>
  <data key="d10">proper placement,risk prevention</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694462</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Fold" target="Children Under 6 Years">
  <data key="d8">1.0</data>
  <data key="d9">Children under 6 years old should always use the subcutaneous fold technique during insulin injection.</data>
  <data key="d10">required technique,safety</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694468</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Fold" target="Adolescents With Low Body Fat">
  <data key="d8">1.0</data>
  <data key="d9">Adolescents with low body fat should use the subcutaneous fold to ensure insulin is injected into subcutaneous tissue.</data>
  <data key="d10">required technique,safety</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694468</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Fold" target="Adults With High Body Fat">
  <data key="d8">1.0</data>
  <data key="d9">Adults with high body fat may not need to use the subcutaneous fold, especially when using short needles (4–5 mm).</data>
  <data key="d10">needle length,optional technique</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694474</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Fold" target="Insulin Application">
  <data key="d8">1.0</data>
  <data key="d9">The subcutaneous fold method is used during insulin application to ensure correct injection depth based on needle length.</data>
  <data key="d10">injection technique,patient safety</data>
  <data key="d11">chunk-035472811a4a16d98e62eba23a86dceb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695217</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Fold" target="Insulin Application Technique">
  <data key="d8">1.0</data>
  <data key="d9">Creating a subcutaneous fold is required before injecting insulin to ensure proper subcutaneous delivery.</data>
  <data key="d10">injection method,technique</data>
  <data key="d11">chunk-e68da6d45eb01c249e854b711007d805</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Insulinas CANETAS.pdf</data>
  <data key="d13">1778695615</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="Skin Fold">
  <data key="d8">1.0</data>
  <data key="d9">Using a skin fold helps prevent intramuscular injection by ensuring proper needle depth during insulin administration.</data>
  <data key="d10">correct technique,risk prevention</data>
  <data key="d11">chunk-ee3024e95a663f89ec3c7a35028cc636</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695233</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="4 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">Using a 4 mm needle reduces the rate of intramuscular injections in young children to 20.2% when no skin fold is used.</data>
  <data key="d10">risk reduction,safe injection</data>
  <data key="d11">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695241</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="5 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">The 5 mm needle doubles the risk of intramuscular injection in children aged 2–6 years compared to the 4 mm needle.</data>
  <data key="d10">increased risk,injection depth</data>
  <data key="d11">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695242</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="6 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">The 6 mm needle triples the risk of intramuscular injection in young children when no skin fold is applied.</data>
  <data key="d10">increased risk,injection depth</data>
  <data key="d11">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695243</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="Skin Pinch">
  <data key="d8">1.0</data>
  <data key="d9">Using a proper skin pinch with the thumb and index finger helps avoid intramuscular injection by isolating subcutaneous tissue.</data>
  <data key="d10">prevention,technique</data>
  <data key="d11">chunk-8b2243846b349d5b78af57a8e77b6ff5</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696028</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="Removable-Needle Syringe">
  <data key="d8">1.0</data>
  <data key="d9">The 13 mm needle of the removable-needle syringe increases the risk of intramuscular injection, potentially causing hypoglycemia.</data>
  <data key="d10">hypoglycemia,injection risk</data>
  <data key="d11">chunk-eb4a4dec39574c303988e93b87c351d4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696032</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">Intramuscular injection of Novolin® R is possible only under medical supervision.</data>
  <data key="d10">administration route,medical guidance</data>
  <data key="d11">chunk-0e1d7f92cdb7923807a9067d937837a4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699137</data>
  <data key="d14"></data>
</edge>
<edge source="Intramuscular Injection" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Intramuscular administration of Novolin® R FlexPen® is possible but only under the guidance of a healthcare professional.</data>
  <data key="d10">administration route,medical supervision</data>
  <data key="d11">chunk-c2e44a4ca961f1a97305607fa263ed91</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699234</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Injection Technique" target="Skin Fold">
  <data key="d8">1.0</data>
  <data key="d9">The skin fold technique is used during insulin injection to prevent intramuscular delivery, especially with longer needles.</data>
  <data key="d10">injection method,safety measure</data>
  <data key="d11">chunk-ee3024e95a663f89ec3c7a35028cc636</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695235</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Angle" target="4 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">A 4 mm needle can be inserted at a 90-degree angle to ensure proper subcutaneous insulin delivery.</data>
  <data key="d10">injection technique,subcutaneous delivery</data>
  <data key="d11">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695433</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Angle" target="5 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">A 5 mm needle can be inserted at a 90-degree angle for correct subcutaneous administration.</data>
  <data key="d10">injection technique,subcutaneous delivery</data>
  <data key="d11">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695434</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Angle" target="6 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">A 6 mm needle requires an angle between 45° and 90° for adults and 45° for children to avoid intramuscular injection.</data>
  <data key="d10">age consideration,injection technique</data>
  <data key="d11">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695434</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Angle" target="8 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">An 8 mm needle requires an angle between 45° and 90° in adults and 45° in children to ensure subcutaneous delivery.</data>
  <data key="d10">age consideration,injection technique</data>
  <data key="d11">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695435</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Angle" target="Needle Longer Than 8 mm">
  <data key="d8">1.0</data>
  <data key="d9">Needles longer than 8 mm must be injected at a 45-degree angle and are not recommended for children due to risk of muscle penetration.</data>
  <data key="d10">injection technique,safety restriction</data>
  <data key="d11">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695436</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Angle" target="Short Needles">
  <data key="d8">1.0</data>
  <data key="d9">Short needles (4 mm or 5 mm) are typically inserted at a 90-degree angle during insulin injection to ensure proper delivery into subcutaneous fat.</data>
  <data key="d10">device specification,injection method</data>
  <data key="d11">chunk-708e3c514f667dc9979cfa8df875e473</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695440</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Angle" target="Longer Needles">
  <data key="d8">1.0</data>
  <data key="d9">Longer needles (6 mm or 8 mm) require an angle between 45° and 90° for adults and 45° for children to avoid intramuscular injection.</data>
  <data key="d10">injection method,patient adaptation</data>
  <data key="d11">chunk-708e3c514f667dc9979cfa8df875e473</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695441</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Leakage" target="Levemir® FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Damage to the Levemir® FlexPen® can cause insulin leakage, leading to inaccurate dosing.</data>
  <data key="d10">device integrity,risk factor</data>
  <data key="d11">chunk-5d212ccdded1e4ccf51af243a8d38b4c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698397</data>
  <data key="d14"></data>
</edge>
<edge source="Arm" target="Insulin Absorption Rate">
  <data key="d8">2.0</data>
  <data key="d9">The arm offers moderate insulin absorption speed, suitable for balanced insulin action.&lt;SEP&gt;The arm has a moderate insulin absorption rate, slower than the abdomen but faster than thighs and buttocks.</data>
  <data key="d10">injection site,moderate absorption</data>
  <data key="d11">chunk-1d9f7234865211afc5d8343294b276d1&lt;SEP&gt;chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d12">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695432</data>
  <data key="d14"></data>
</edge>
<edge source="Children Under 6 Years" target="Subcutaneous Skin Fold">
  <data key="d8">1.0</data>
  <data key="d9">Children under 6 years should use the subcutaneous skin fold technique during insulin injection due to low body fat, regardless of needle size.</data>
  <data key="d10">age-specific care,patient safety</data>
  <data key="d11">chunk-708e3c514f667dc9979cfa8df875e473</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695439</data>
  <data key="d14"></data>
</edge>
<edge source="Adults With High Body Fat" target="Subcutaneous Skin Fold">
  <data key="d8">1.0</data>
  <data key="d9">Adults with high body fat may not need the subcutaneous skin fold technique when using short needles (4 mm or 5 mm).</data>
  <data key="d10">body composition,technique necessity</data>
  <data key="d11">chunk-708e3c514f667dc9979cfa8df875e473</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695445</data>
  <data key="d14"></data>
</edge>
<edge source="4 Mm Needle" target="Hirsch Et Al">
  <data key="d8">1.0</data>
  <data key="d9">Hirsch et al. studied the use of 4 mm needles for insulin injection and found them to be safe and well-tolerated with no significant insulin leakage.</data>
  <data key="d10">clinical study,safety evaluation</data>
  <data key="d11">chunk-7cb18b1ccdbe7c3a6bbce149470c1ca1</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696027</data>
  <data key="d14"></data>
</edge>
<edge source="4 Mm Needle" target="Tremor">
  <data key="d8">1.0</data>
  <data key="d9">Individuals with tremors may have difficulty using a 4 mm needle and may require help or switch to longer needles for easier self-application.</data>
  <data key="d10">need for adaptation,usage difficulty</data>
  <data key="d11">chunk-7cb18b1ccdbe7c3a6bbce149470c1ca1</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696028</data>
  <data key="d14"></data>
</edge>
<edge source="8 Mm Needle" target="Adults">
  <data key="d8">1.0</data>
  <data key="d9">Adults using an 8 mm needle are at higher risk of muscle penetration and must use a skin fold during injection.</data>
  <data key="d10">risk of muscle injection,technique requirement</data>
  <data key="d11">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694482</data>
  <data key="d14"></data>
</edge>
<edge source="8 Mm Needle" target="Intramuscular Injection Risk">
  <data key="d8">1.0</data>
  <data key="d9">The 8 mm needle poses a risk of intramuscular injection and is not recommended for children and adolescents.</data>
  <data key="d10">age restriction,safety concern</data>
  <data key="d11">chunk-7cb18b1ccdbe7c3a6bbce149470c1ca1</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696026</data>
  <data key="d14"></data>
</edge>
<edge source="Adults" target="Subcutaneous Pinch">
  <data key="d8">1.0</data>
  <data key="d9">Adults may not need a subcutaneous pinch when using 4–5 mm needles, but it is recommended when subcutaneous tissue is scarce.</data>
  <data key="d10">conditional use,patient guideline</data>
  <data key="d11">chunk-5bbc7b2df438b8290a4da57f63f1ff5d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696015</data>
  <data key="d14"></data>
</edge>
<edge source="Adults" target="Gibney et al. Study">
  <data key="d8">1.0</data>
  <data key="d9">The Gibney et al. study showed that adult skin thickness is typically under 3 mm, supporting the use of 4–8 mm needles for all adults.</data>
  <data key="d10">needle length recommendation,research finding</data>
  <data key="d11">chunk-eb4a4dec39574c303988e93b87c351d4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696035</data>
  <data key="d14"></data>
</edge>
<edge source="Injection Sites" target="Buttocks">
  <data key="d8">1.0</data>
  <data key="d9">The buttocks, specifically the upper outer quadrant, are a recommended site for insulin injection.</data>
  <data key="d10">anatomical guidance,location specification</data>
  <data key="d11">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694494</data>
  <data key="d14"></data>
</edge>
<edge source="Buttocks" target="Insulin Absorption Rate">
  <data key="d8">1.0</data>
  <data key="d9">The buttocks have the slowest insulin absorption rate among common injection sites.</data>
  <data key="d10">injection site,slowest absorption</data>
  <data key="d11">chunk-1d9f7234865211afc5d8343294b276d1</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694562</data>
  <data key="d14"></data>
</edge>
<edge source="Injection Technique" target="45 Degree Angle">
  <data key="d8">1.0</data>
  <data key="d9">A 45-degree angle is recommended for children or when using longer needles.</data>
  <data key="d10">longer needles,pediatric use</data>
  <data key="d11">chunk-e68da6d45eb01c249e854b711007d805</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Insulinas CANETAS.pdf</data>
  <data key="d13">1778695621</data>
  <data key="d14"></data>
</edge>
<edge source="Injection Technique" target="90 Degree Angle">
  <data key="d8">1.0</data>
  <data key="d9">A 90-degree angle is used for adults, particularly with shorter needles.</data>
  <data key="d10">adult use,shorter needles</data>
  <data key="d11">chunk-e68da6d45eb01c249e854b711007d805</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Insulinas CANETAS.pdf</data>
  <data key="d13">1778695622</data>
  <data key="d14"></data>
</edge>
<edge source="Injection Technique" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Keeping the needle under the skin for at least 6 seconds ensures complete insulin delivery during injection.</data>
  <data key="d10">administration accuracy,delivery assurance</data>
  <data key="d11">chunk-ea9fa1ee045093083e543d672f1309db</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699186</data>
  <data key="d14"></data>
</edge>
<edge source="Sealed Insulin Vials" target="Thermal Bag">
  <data key="d8">2.0</data>
  <data key="d9">Sealed insulin vials must be transported in a thermal bag with gel packs to maintain 2°C to 8°C.&lt;SEP&gt;Thermal bags with gel packs are used to store sealed insulin vials at safe temperatures during transport.</data>
  <data key="d10">cooling method,safe transport,temperature regulation</data>
  <data key="d11">chunk-525086e26636af026c417773a8f11a92&lt;SEP&gt;chunk-ca576cb8eccfdd91ed235c273f829e81</data>
  <data key="d12">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte insulinas.pdf</data>
  <data key="d13">1778696418</data>
  <data key="d14"></data>
</edge>
<edge source="Sealed Insulin Vials" target="Gelox">
  <data key="d8">1.0</data>
  <data key="d9">Gelox or ice packs are used to cool insulin vials, but direct contact must be avoided to prevent freezing.</data>
  <data key="d10">cooling method,indirect contact</data>
  <data key="d11">chunk-525086e26636af026c417773a8f11a92</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694494</data>
  <data key="d14"></data>
</edge>
<edge source="Thermal Bag" target="Gelox">
  <data key="d8">1.0</data>
  <data key="d9">Gelox or ice packs are placed in thermal bags but must not directly touch insulin vials to prevent freezing.</data>
  <data key="d10">cooling agent,indirect contact</data>
  <data key="d11">chunk-ca576cb8eccfdd91ed235c273f829e81</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte insulinas.pdf</data>
  <data key="d13">1778696419</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetes Supplies" target="Sharps Waste">
  <data key="d8">1.0</data>
  <data key="d9">Used syringes, needles, lancets, and insulin pens are classified as sharps waste due to blood contamination.</data>
  <data key="d10">contamination risk,waste classification</data>
  <data key="d11">chunk-525086e26636af026c417773a8f11a92</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694494</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetes Supplies" target="TSA">
  <data key="d8">1.0</data>
  <data key="d9">TSA provides updated information on traveling with diabetes supplies, including lancets and syringes.</data>
  <data key="d10">regulatory information,travel guidelines</data>
  <data key="d11">chunk-f9bc8ba4b622225a9f3f1bb8a9d4fb21</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778700969</data>
  <data key="d14"></data>
</edge>
<edge source="Finger Prick" target="Lancet Device">
  <data key="d8">1.0</data>
  <data key="d9">The lancet device enables a gentler and more consistent finger prick experience.</data>
  <data key="d10">controlled puncture,user comfort</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694524</data>
  <data key="d14"></data>
</edge>
<edge source="Finger Prick" target="Finger Selection">
  <data key="d8">1.0</data>
  <data key="d9">Choosing the side of the fingertip and rotating fingers helps reduce pain and prevent calluses from frequent pricking.</data>
  <data key="d10">pain reduction,skin protection</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694528</data>
  <data key="d14"></data>
</edge>
<edge source="Result Recording" target="Mobile Application">
  <data key="d8">1.0</data>
  <data key="d9">Mobile apps can be used to record and analyze blood glucose results over time.</data>
  <data key="d10">data analysis,digital logging</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694525</data>
  <data key="d14"></data>
</edge>
<edge source="Result Recording" target="Computer-Connected Device">
  <data key="d8">1.0</data>
  <data key="d9">Some glucometers store results and connect to computers for comprehensive review by healthcare providers.</data>
  <data key="d10">data transfer,long-term tracking</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694526</data>
  <data key="d14"></data>
</edge>
<edge source="Caneta De Insulina" target="Caneta Recarregável">
  <data key="d8">1.0</data>
  <data key="d9">A caneta recarregável é um tipo de caneta de insulina que utiliza refis substituíveis.</data>
  <data key="d10">device category,product type</data>
  <data key="d11">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694529</data>
  <data key="d14"></data>
</edge>
<edge source="Caneta De Insulina" target="Agulha De 4 Mm">
  <data key="d8">1.0</data>
  <data key="d9">A agulha de 4 mm é a mais curta para canetas de insulina e é recomendada por ser menos dolorosa e segura.</data>
  <data key="d10">device compatibility,injection comfort</data>
  <data key="d11">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694530</data>
  <data key="d14"></data>
</edge>
<edge source="Caneta Recarregável" target="Fabricante">
  <data key="d8">1.0</data>
  <data key="d9">The reusable pen must be used with cartridges from the same manufacturer to ensure accurate dosing and proper function.</data>
  <data key="d10">device compatibility,manufacturer requirement</data>
  <data key="d11">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695442</data>
  <data key="d14"></data>
</edge>
<edge source="Prega Subcutânea" target="Músculo">
  <data key="d8">1.0</data>
  <data key="d9">Forming a skin fold ensures insulin is injected subcutaneously and not into the muscle, preventing hypoglycemia.</data>
  <data key="d10">injection safety,technique importance</data>
  <data key="d11">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d13">1778695762</data>
  <data key="d14"></data>
</edge>
<edge source="Depósito Rígido" target="Unidade De Saúde">
  <data key="d8">1.0</data>
  <data key="d9">O depósito rígido contendo agulhas usadas deve ser entregue à Unidade de Saúde para descarte seguro.</data>
  <data key="d10">safety protocol,waste disposal</data>
  <data key="d11">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694529</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Application" target="Insulin Storage And Transport">
  <data key="d8">1.0</data>
  <data key="d9">Proper insulin application depends on correct storage and transport to ensure the medication remains effective.</data>
  <data key="d10">safety practice,treatment protocol</data>
  <data key="d11">chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
  <data key="d12">data/raw/Documento sem título.docx</data>
  <data key="d13">1778694981</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Application" target="Skin Inspection">
  <data key="d8">1.0</data>
  <data key="d9">Skin inspection is performed before insulin application to detect abnormalities like lipohypertrophy.</data>
  <data key="d10">complication prevention,site assessment</data>
  <data key="d11">chunk-035472811a4a16d98e62eba23a86dceb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695219</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Application" target="Diabetes Brazil Society">
  <data key="d8">1.0</data>
  <data key="d9">The Diabetes Brazil Society provides official recommendations for proper insulin application techniques.</data>
  <data key="d10">clinical guidelines,standardization</data>
  <data key="d11">chunk-035472811a4a16d98e62eba23a86dceb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695219</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Application" target="Short Needle">
  <data key="d8">1.0</data>
  <data key="d9">Using short needles (4–6 mm) helps reduce pain and improve comfort during insulin injection.</data>
  <data key="d10">comfort improvement,pain reduction</data>
  <data key="d11">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695451</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Application" target="i-Port">
  <data key="d8">1.0</data>
  <data key="d9">The i-Port device allows multiple insulin applications without daily skin punctures, increasing convenience and comfort.</data>
  <data key="d10">convenience,reduced skin punctures</data>
  <data key="d11">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695451</data>
  <data key="d14"></data>
