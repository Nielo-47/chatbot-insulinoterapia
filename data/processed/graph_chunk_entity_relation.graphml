  <data key="d5">1786326169</data>
  <data key="d6"></data>
</node>
<node id="Product Label">
  <data key="d0">Product Label</data>
  <data key="d1">content</data>
  <data key="d2">The product label must be checked before each injection to prevent medication errors.</data>
  <data key="d3">chunk-1ee5400065df79b02b6c04efc0f4854d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
