  <data key="d14"></data>
</edge>
<edge source="Resume Basal Alert" target="Suspend On Low">
  <data key="d8">1.0</data>
  <data key="d9">Following a Suspend On Low event, the Resume Basal Alert is activated to notify the user to resume basal insulin delivery.</data>
  <data key="d10">event response,insulin resumption</data>
