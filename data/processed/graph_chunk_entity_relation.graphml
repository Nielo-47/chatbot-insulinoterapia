  <data key="d12">1786317685</data>
  <data key="d13"></data>
</edge>
<edge source="Botão Injetor" target="Novolin® R FlexPen®">
  <data key="d7">1.0</data>
  <data key="d8">Novolin® R FlexPen® includes a Botão Injetor that is pressed to deliver the selected dose.</data>
  <data key="d9">activation,component</data>
