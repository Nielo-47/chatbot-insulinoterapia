  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Insulin Flow Blocked Event">
  <data key="d7">1.0</data>
  <data key="d8">When insulin flow is blocked, the Infusion Set should be removed and replaced.</data>
