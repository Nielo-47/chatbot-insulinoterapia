</node>
<node id="Cold Place">
  <data key="d0">Cold Place</data>
  <data key="d1">concept</data>
  <data key="d2">Any location that is cold, other than a refrigerator, noted as unsuitable for battery storage.</data>
  <data key="d3">chunk-527777f044e20410ca47d2c5b35306ca</data>
