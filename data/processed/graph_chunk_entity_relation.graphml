  <data key="d5">1786325514</data>
  <data key="d6"></data>
</node>
<node id="Iniciar">
  <data key="d0">Iniciar</data>
  <data key="d1">method</data>
  <data key="d2">A command to start a selected basal or temporary basal operation.&lt;SEP&gt;The action to start a temporary basal index after configuration.</data>
  <data key="d3">chunk-1312783ffe5039c618a48f7f29ec51ed&lt;SEP&gt;chunk-adb365cf52e00c7b4647e65dc0411d56</data>
