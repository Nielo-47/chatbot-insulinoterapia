  <data key="d13">1778696152</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Room Temperature">
  <data key="d8">1.0</data>
  <data key="d9">Insulin in use can be stored at room temperature up to 30°C for up to 8 weeks, as per manufacturer guidelines.</data>
  <data key="d10">ambient storage,usage condition</data>
  <data key="d11">chunk-c8702ff00244abf3caabafff5aad4a65</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte e conservação Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
  <data key="d13">1778696368</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Reusable Insulin Pen">
  <data key="d8">1.0</data>
  <data key="d9">Reusable insulin pens should not be refrigerated to avoid damaging the internal mechanism and affecting dose accuracy.</data>
  <data key="d10">device protection,storage recommendation</data>
  <data key="d11">chunk-c8702ff00244abf3caabafff5aad4a65</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte e conservação Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
  <data key="d13">1778696370</data>
  <data key="d14"></data>
</edge>
<edge source="Type 1 Diabetes" target="Insulin Aspart">
  <data key="d8">1.0</data>
  <data key="d9">Insulin aspart is used as a bolus insulin in basal-bolus regimens for managing blood glucose in type 1 diabetes patients.</data>
  <data key="d10">bolus insulin therapy, blood glucose control</data>
