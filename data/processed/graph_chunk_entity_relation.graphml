<node id="Alimentação Saudável e Balanceada">
  <data key="d0">Alimentação Saudável e Balanceada</data>
  <data key="d1">method</data>
  <data key="d2">Alimentação Saudável e Balanceada is a balanced healthy diet recommended to control blood glucose in HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337248</data>
  <data key="d6"></data>
</node>
<node id="Fome e Sede">
  <data key="d0">Fome e Sede</data>
  <data key="d1">concept</data>
  <data key="d2">Fome e Sede are symptoms of intense hunger and thirst associated with HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337248</data>
  <data key="d6"></data>
</node>
<node id="Aumento da Urina">
  <data key="d0">Aumento da Urina</data>
  <data key="d1">concept</data>
  <data key="d2">Aumento da Urina is the symptom of increased urination linked to HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337248</data>
  <data key="d6"></data>
</node>
<node id="Cansaço e Fraqueza">
  <data key="d0">Cansaço e Fraqueza</data>
  <data key="d1">concept</data>
  <data key="d2">Cansaço e Fraqueza are symptoms of fatigue and weakness observed in HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Perda ou Ganho de Peso">
  <data key="d0">Perda ou Ganho de Peso</data>
  <data key="d1">concept</data>
  <data key="d2">Perda ou Ganho de Peso denotes weight loss or gain as a symptom of HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Dificuldade para Enxergar">
  <data key="d0">Dificuldade para Enxergar</data>
  <data key="d1">concept</data>
  <data key="d2">Dificuldade para Enxergar is the symptom of visual difficulty associated with HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Difícil Cicatrização">
  <data key="d0">Difícil Cicatrização</data>
  <data key="d1">concept</data>
  <data key="d2">Difícil Cicatrização describes delayed wound healing as a symptom of HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Suor Excessivo">
  <data key="d0">Suor Excessivo</data>
  <data key="d1">concept</data>
  <data key="d2">Suor Excessivo is excessive sweating observed in HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Tontura">
  <data key="d0">Tontura</data>
  <data key="d1">concept</data>
  <data key="d2">Tontura is dizziness experienced as a symptom of HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Mudança de Comportamento">
  <data key="d0">Mudança de Comportamento</data>
  <data key="d1">concept</data>
  <data key="d2">Mudança de Comportamento refers to behavior change noted in individuals with HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Palidez">
  <data key="d0">Palidez</data>
  <data key="d1">concept</data>
  <data key="d2">Palidez is paleness that can occur as a symptom of HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Sensação de Fome">
  <data key="d0">Sensação de Fome</data>
  <data key="d1">concept</data>
  <data key="d2">Sensação de Fome is the feeling of hunger associated with HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Glicemia Acima de 100 Mg/Dl">
  <data key="d0">Glicemia Acima de 100 Mg/Dl</data>
  <data key="d1">concept</data>
  <data key="d2">Glicemia Acima de 100 Mg/Dl is the blood glucose level threshold defining HiperGlicemia, i.e., a measurement above 100 mg/dL.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337249</data>
  <data key="d6"></data>
</node>
<node id="Monitorar e Controlar a Glicemia">
  <data key="d0">Monitorar e Controlar a Glicemia</data>
  <data key="d1">method</data>
  <data key="d2">Monitorar e Controlar a Glicemia is the practice of regularly checking and managing blood glucose levels to control HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337250</data>
  <data key="d6"></data>
</node>
<node id="Tomar as Medicações e/ou Insulina">
  <data key="d0">Tomar as Medicações e/ou Insulina</data>
  <data key="d1">method</data>
  <data key="d2">Tomar as Medicações e/ou Insulina is the therapeutic action of taking prescribed medications or insulin to treat HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1786337250</data>
  <data key="d6"></data>
</node>
<node id="Batedeira">
  <data key="d0">Batedeira</data>
  <data key="d1">concept</data>
  <data key="d2">Batedeira is a symptom (likely shaking or tremor) associated with HiperGlicemia.</data>
  <data key="d3">chunk-d6a0699569d4d9d7344609e3680eec66</data>
