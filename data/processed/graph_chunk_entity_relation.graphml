  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Clinical Trial">
  <data key="d7">1.0</data>
  <data key="d8">Clinical trials are considered to potentially delay the development of clinical diabetes.</data>
  <data key="d9">intervention,prevention</data>
