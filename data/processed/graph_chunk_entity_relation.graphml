  <data key="d5">1786319727</data>
  <data key="d6"></data>
</node>
<node id="Lactation">
  <data key="d0">Lactation</data>
  <data key="d1">concept</data>
  <data key="d2">Lactation is the production of breast milk postpartum, during which NovoRapid® may be used without restriction.&lt;SEP&gt;Lactation is the period of breast‑feeding after childbirth, during which insulin dosing may need adjustment.&lt;SEP&gt;Lactation is a physiological condition mentioned alongside pregnancy regarding lack of study data for Toujeo 300 U/mL.&lt;SEP&gt;Lactation is the period of breastfeeding where it is uncertain whether APIDRA is excreted in breast milk, and dose adjustments may be required.&lt;SEP&gt;Lactation is the period of breast‑milk production; it is uncertain whether APIDRA SOLOSTAR is excreted in human milk and dosage may need adjustment.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052&lt;SEP&gt;chunk-4319d08c10ed2b48857a6d42eadd9db0&lt;SEP&gt;chunk-3397508bdfddde019cb1dfdcfb352435&lt;SEP&gt;chunk-d65840dd2cbd5c9984dfc4334378df5e&lt;SEP&gt;chunk-f09811b149a29105854a0b1e84951e5d&lt;SEP&gt;chunk-3237e202569462c758ec3d878c9faeae</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315465</data>
  <data key="d6"></data>
</node>
