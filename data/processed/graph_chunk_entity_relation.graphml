</edge>
<edge source="Calibration" target="Rapid Glucose Change">
  <data key="d8">1.0</data>
  <data key="d9">Calibration should not be performed during Rapid Glucose Change, such as when two or three arrows appear on the device, to avoid reduced accuracy.</data>
  <data key="d10">accuracy risk,calibration timing</data>
  <data key="d11">chunk-86d3bb81c7595510175054c288b122fb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703028</data>
  <data key="d14"></data>
</edge>
<edge source="Calibration" target="Glucose Sensor Calibration">
  <data key="d8">1.0</data>
  <data key="d9">Calibration is a core component of Glucose Sensor Calibration, ensuring the sensor's readings align with actual blood glucose levels.</data>
  <data key="d10">process refinement,system accuracy</data>
  <data key="d11">chunk-86d3bb81c7595510175054c288b122fb</data>
