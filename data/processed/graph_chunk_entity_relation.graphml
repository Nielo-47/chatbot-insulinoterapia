  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377593</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Pernicious Anemia">
  <data key="d7">1.0</data>
  <data key="d8">Pernicious Anemia, an autoimmune anemia, is linked to Type 1 Diabetes.</data>
