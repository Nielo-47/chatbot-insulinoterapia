<node id="Noninsulin Therapies">
  <data key="d0">Noninsulin Therapies</data>
  <data key="d1">method</data>
  <data key="d2">Noninsulin therapies are diabetes treatments that do not involve insulin administration.&lt;SEP&gt;Noninsulin therapies are treatment methods for diabetes that do not involve insulin.&lt;SEP&gt;Noninsulin therapies are treatment approaches for diabetes that may require the addition of insulin.&lt;SEP&gt;Noninsulin Therapies are treatment options for diabetes that do not involve insulin.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78&lt;SEP&gt;chunk-511f6be03d2ea98970bd4c1b29b3e5c8&lt;SEP&gt;chunk-345ad64f464691cc28341ccd246032db&lt;SEP&gt;chunk-b2cd796639bdb0e10eeda7ef3d9ebbce</data>
