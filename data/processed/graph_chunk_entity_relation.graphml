</edge>
<edge source="Dual Wave Bolus" target="Now % Amount">
  <data key="d8">1.0</data>
  <data key="d9">The Now % Amount determines the portion of a Dual Wave Bolus delivered immediately.</data>
  <data key="d10">delivery parameter,immediate dose</data>
