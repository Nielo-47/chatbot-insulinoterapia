  <data key="d13">1778704364</data>
  <data key="d14"></data>
</edge>
<edge source="Scroll Bar" target="Main Menu">
  <data key="d8">1.0</data>
  <data key="d9">The scroll bar appears in menus or screens with more than six lines, enabling access to additional items.</data>
  <data key="d10">content navigation,interface element</data>
  <data key="d11">chunk-0aabf7352e5784edc898ebb03d127f44</data>
