  <data key="d6"></data>
</node>
<node id="Fabricação, Validade E Número De Lote">
  <data key="d0">Fabricação, Validade E Número De Lote</data>
  <data key="d1">concept</data>
  <data key="d2">Fabricação, Validade E Número De Lote refers to manufacturing date, expiration, and batch number information provided on the KWIKPEN packaging.</data>
  <data key="d3">chunk-b4916e2524690f1ce85df7c187f6d7a7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310746</data>
  <data key="d6"></data>
</node>
<node id="Alergia Sistêmica à Insulina">
  <data key="d0">Alergia Sistêmica à Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Alergia sistêmica à insulina is a systemic insulin allergy that can cause widespread rash, respiratory distress, hypotension, and, in severe cases, death.</data>
  <data key="d3">chunk-8ef35bd45e4ba8d20f4e9181011ccfcd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310746</data>
  <data key="d6"></data>
</node>
<node id="Posologia">
  <data key="d0">Posologia</data>
  <data key="d1">concept</data>
  <data key="d2">Posologia is the dosage regimen determined by a physician for administering Humalog Mix 25 KwikPen based on metabolic needs and lifestyle.&lt;SEP&gt;Posologia refers to the dosage guidelines determined by the physician for Humalog Mix 50 KwikPen.&lt;SEP&gt;The dosage guidelines and administration schedule for Fiasp®.</data>
  <data key="d3">chunk-8ef35bd45e4ba8d20f4e9181011ccfcd&lt;SEP&gt;chunk-aca0b919135813e1d5b772face36989d&lt;SEP&gt;chunk-add4469fba80232b7c0742f24c0914c9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316112</data>
  <data key="d6"></data>
</node>
<node id="Lilly SAC 0800 701 0444">
  <data key="d0">Lilly SAC 0800 701 0444</data>
  <data key="d1">artifact</data>
  <data key="d2">Lilly SAC 0800 701 0444 is the customer service telephone number for Eli Lilly do Brasil Ltda.</data>
  <data key="d3">chunk-8ef35bd45e4ba8d20f4e9181011ccfcd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310748</data>
  <data key="d6"></data>
</node>
<node id="Intoxicação">
  <data key="d0">Intoxicação</data>
  <data key="d1">concept</data>
  <data key="d2">Intoxicação is the condition of insulin poisoning for which a phone number is provided for emergency assistance.&lt;SEP&gt;Intoxicação refers to cases of poisoning or adverse reaction requiring emergency assistance.&lt;SEP&gt;Intoxicação denotes a poisoning situation that requires immediate medical guidance.&lt;SEP&gt;Intoxicação refers to the condition for which a specific emergency telephone number is provided in the text.</data>
  <data key="d3">chunk-8ef35bd45e4ba8d20f4e9181011ccfcd&lt;SEP&gt;chunk-0e7689ca0fc736d9eae94256f73fed52&lt;SEP&gt;chunk-922791f49d1bf928fe4f02ddd336927b&lt;SEP&gt;chunk-6419fb3ef4249d6c7e8d8a45d82efe80</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319698</data>
  <data key="d6"></data>
</node>
<node id="Insulina Lispro Protamina (NPL)">
  <data key="d0">Insulina Lispro Protamina (NPL)</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Lispro Protamina (NPL) is an insulin formulation combining lispro and protamine studied for absorption and activity profiles.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310748</data>
  <data key="d6"></data>
</node>
<node id="Insulina Humana (NPH)">
  <data key="d0">Insulina Humana (NPH)</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Humana (NPH) is a suspension of human insulin used as a comparator in glucose clamp studies.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310748</data>
  <data key="d6"></data>
</node>
<node id="Mistura de Insulina Lispro/NPL">
  <data key="d0">Mistura de Insulina Lispro/NPL</data>
  <data key="d1">artifact</data>
  <data key="d2">Mistura de Insulina Lispro/NPL is a mixture containing insulin lispro and insulin lispro protamine examined for pharmacokinetic and glucodynamic properties.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310748</data>
  <data key="d6"></data>
</node>
<node id="Estudo Clamp de Glicose">
  <data key="d0">Estudo Clamp de Glicose</data>
  <data key="d1">event</data>
  <data key="d2">Estudo Clamp de Glicose is a glucose‑clamp investigation performed on healthy volunteers to assess insulin pharmacology.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310748</data>
  <data key="d6"></data>
</node>
<node id="Voluntários Sadios">
  <data key="d0">Voluntários Sadios</data>
  <data key="d1">other</data>
  <data key="d2">Voluntários Sadios are healthy human participants enrolled in the glucose clamp studies.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310748</data>
  <data key="d6"></data>
</node>
<node id="Fígado">
  <data key="d0">Fígado</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Fígado is the liver organ where insulin promotes glucose uptake, glycogen storage, and lipogenesis.&lt;SEP&gt;Liver organ referenced as a site where disease may affect insulin dosing.&lt;SEP&gt;The liver, an organ where insulin suppresses endogenous glucose production.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8&lt;SEP&gt;chunk-45ee3dcb366c1301c9fb1d2ce9f323c1&lt;SEP&gt;chunk-e4e1124e7acf6619a1a7c60febd5211c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1786318535</data>
  <data key="d6"></data>
</node>
<node id="Glicogênio">
  <data key="d0">Glicogênio</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Glicogênio is the stored form of glucose in the liver.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310749</data>
  <data key="d6"></data>
</node>
<node id="Glicogênese">
  <data key="d0">Glicogênese</data>
  <data key="d1">concept</data>
  <data key="d2">Glicogênese is the metabolic pathway that generates glucose, which insulin inhibits.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310749</data>
  <data key="d6"></data>
</node>
<node id="Anabolismo">
  <data key="d0">Anabolismo</data>
  <data key="d1">concept</data>
  <data key="d2">Anabolismo is the building‑up of molecules, a process enhanced by insulin in muscle and other tissues.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310750</data>
  <data key="d6"></data>
</node>
<node id="Catabolismo Proteico">
  <data key="d0">Catabolismo Proteico</data>
  <data key="d1">concept</data>
  <data key="d2">Catabolismo Proteico is the breakdown of proteins, which insulin suppresses.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310750</data>
  <data key="d6"></data>
</node>
<node id="Insulina de Origem Animal">
  <data key="d0">Insulina de Origem Animal</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina de Origem Animal is insulin derived from animal sources, historically used before switching to human insulin.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310750</data>
  <data key="d6"></data>
</node>
<node id="Cérebro">
  <data key="d0">Cérebro</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cérebro is the brain tissue mentioned as an exception where insulin does not stimulate rapid glucose transport.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310750</data>
  <data key="d6"></data>
</node>
<node id="Testes de Toxicidade Crônica">
  <data key="d0">Testes de Toxicidade Crônica</data>
  <data key="d1">event</data>
  <data key="d2">Testes de Toxicidade Crônica are long‑duration animal toxicity studies assessing proliferative and tumor effects of insulin lispro.</data>
  <data key="d3">chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
