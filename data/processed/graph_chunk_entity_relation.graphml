</node>
<node id="Intensive Glycemic Management">
  <data key="d0">Intensive Glycemic Management</data>
  <data key="d1">concept</data>
  <data key="d2">Intensive glycemic management is a treatment strategy aiming for tight blood glucose control to reduce complications.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
