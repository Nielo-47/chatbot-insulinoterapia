  <data key="d14"></data>
</edge>
<edge source="Novolin® R" target="Storage Of Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">Proper storage of Novolin® R is required to maintain efficacy, including refrigeration before use and protection from light and heat.</data>
  <data key="d10">handling instructions,medication stability</data>
  <data key="d11">chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
