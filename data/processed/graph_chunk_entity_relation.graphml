  <data key="d0">2IQP Study Group</data>
  <data key="d1">organization</data>
  <data key="d2">2IQP Study Group is the research group that performed a randomized trial of automated insulin delivery in type 2 diabetes.</data>
  <data key="d3">chunk-d30bfc1840eec64224c3568470e6c539</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
