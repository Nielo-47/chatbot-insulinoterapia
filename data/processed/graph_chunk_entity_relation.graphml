  <data key="d0">Recipiente de Plástico Rígido</data>
  <data key="d1">artifact</data>
  <data key="d2">Recipiente de plástico rígido is a rigid plastic container recommended for home disposal of sharps when a proper disposal container is unavailable.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1786337565</data>
  <data key="d6"></data>
</node>
