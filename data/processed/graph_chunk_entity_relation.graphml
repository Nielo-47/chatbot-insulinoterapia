<node id="Treatment Discontinuation">
  <data key="d0">Treatment Discontinuation</data>
  <data key="d1">concept</data>
  <data key="d2">Treatment Discontinuation is the cessation of NovoRapid® therapy, which may occur due to severe injection‑site reactions.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
