<edge source="HbA1c" target="Pregnancy">
  <data key="d8">1.0</data>
  <data key="d9">Pregnancy can alter HbA1c accuracy, necessitating alternative monitoring methods during gestation.</data>
  <data key="d10">test interference, physiological impact</data>
