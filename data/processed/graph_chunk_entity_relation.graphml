<edge source="Subcutaneous Injection" target="Cutaneous Amyloidosis">
  <data key="d8">1.0</data>
  <data key="d9">Rotating injection sites helps prevent cutaneous amyloidosis associated with repeated insulin injections.</data>
  <data key="d10">complication,prevention strategy</data>
