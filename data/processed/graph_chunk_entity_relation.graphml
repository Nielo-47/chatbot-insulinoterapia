  <data key="d5">1778699007</data>
  <data key="d6"></data>
</node>
<node id="Excipients">
  <data key="d0">Excipients</data>
  <data key="d1">artifact</data>
  <data key="d2">Excipients are inactive ingredients in the Levemir product, to which hypersensitivity is a contraindication.&gt;</data>
  <data key="d3">chunk-7a4232687a569d10d6942d933172488f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698079</data>
  <data key="d6"></data>
</node>
<node id="Insulin Human Analog">
  <data key="d0">Insulin Human Analog</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin human analog refers to modified forms of human insulin, such as insulin detemir, used in Levemir.&gt;</data>
  <data key="d3">chunk-7a4232687a569d10d6942d933172488f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698079</data>
