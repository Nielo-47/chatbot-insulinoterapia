  <data key="d2">Transient neonatal diabetes is often caused by imprinting abnormalities at chromosome 6q24.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373329</data>
  <data key="d6"></data>
</node>
<node id="DMNP">
  <data key="d0">DMNP</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d2">Permanent neonatal diabetes can result from mutations in KCNJ11.</data>
  <data key="d1">UNKNOWN</data>
