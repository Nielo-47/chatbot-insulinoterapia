  <data key="d12">1786325629</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Susie">
  <data key="d7">1.0</data>
  <data key="d8">Susie prefers using the insulin pump to give bolus doses instead of injections.</data>
  <data key="d9">convenience,usage</data>
  <data key="d10">chunk-3d24fce6aa8866fb4a11514ae0e4d675</data>
