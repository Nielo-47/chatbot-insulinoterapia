  <data key="d0">Cell‑Phone Interface</data>
  <data key="d1">method</data>
  <data key="d2">Cell‑Phone Interface refers to insulin pump system interfaces that operate via mobile phones, as mentioned among hybrid closed‑loop system innovations.</data>
