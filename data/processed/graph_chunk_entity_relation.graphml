  <data key="d14"></data>
</edge>
<edge source="Insulina Humana" target="Eliminação">
  <data key="d8">1.0</data>
  <data key="d9">A eliminação da insulina humana é determinada pela taxa de absorção no tecido subcutâneo, com meia-vida terminal refletindo esse processo.</data>
  <data key="d10">absorption rate,pharmacokinetic elimination</data>
  <data key="d11">chunk-b1d9cc89371adea01fc1a946ca6d1690</data>
