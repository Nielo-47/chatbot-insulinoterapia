<node id="Mudança Repentina no Local da Injeção">
  <data key="d0">Mudança Repentina no Local da Injeção</data>
  <data key="d1">method</data>
  <data key="d2">Mudança Repentina no Local da Injeção is the action of abruptly switching the insulin injection site to an area not previously used.&lt;SEP&gt;Mudança Repentina no Local da Injeção is an abrupt shift of the injection site that can trigger hypoglycemia.</data>
  <data key="d3">chunk-e3418c4ee80182ca29214dd54b0d9647&lt;SEP&gt;chunk-9bcc4202330d45ebfca8f79c3d4998b3</data>
