<edge source="Insulin Pen" target="Insulin Dose">
  <data key="d8">1.0</data>
  <data key="d9">The insulin dose must be correctly selected on the insulin pen to ensure proper medication delivery.</data>
  <data key="d10">dose selection, accurate delivery</data>
  <data key="d11">chunk-180dc3d244f7d832cf505b09cfc34746</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
