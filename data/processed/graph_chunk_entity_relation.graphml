<node id="Evidence Class IIa Level B">
  <data key="d0">Evidence Class IIa Level B</data>
  <data key="d1">concept</data>
  <data key="d2">Evidence Class IIa Level B denotes a moderate level of evidence supporting the recommendation for long‑acting insulin analogues in basal insulinization.</data>
