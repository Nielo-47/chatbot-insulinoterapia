  <data key="d0">Classification Of Diabetes Mellitus</data>
  <data key="d1">content</data>
  <data key="d2">Classification Of Diabetes Mellitus is a WHO publication that provides a framework for classifying diabetes.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373050</data>
  <data key="d6"></data>
</node>
<node id="MODY-GCK">
  <data key="d0">MODY-GCK</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-GCK is the most common MODY subtype, presenting with mild fasting hyperglycemia from birth, asymptomatic and non‑progressive.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373050</data>
  <data key="d6"></data>
</node>
<node id="MODY-HNF4A">
  <data key="d0">MODY-HNF4A</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-HNF4A is a common MODY subtype that responds well to sulfonylureas and is associated with fetal macrosomia and neonatal hypoglycemia.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373051</data>
  <data key="d6"></data>
</node>
<node id="MODY-HNF1A">
  <data key="d0">MODY-HNF1A</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-HNF1A is a common MODY subtype with childhood/adolescent onset hyperglycemia, excessive glucosuria and good response to sulfonylureas.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373051</data>
  <data key="d6"></data>
</node>
<node id="MODY-HNF1B">
  <data key="d0">MODY-HNF1B</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-HNF1B is a common MODY subtype that may lack family history and is linked to urogenital malformations, renal cysts, pancreatic atrophy and other anomalies.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373051</data>
  <data key="d6"></data>
</node>
<node id="MODY-KCNJ11">
  <data key="d0">MODY-KCNJ11</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-KCNJ11 is a MODY subtype that shows response to sulfonylureas.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373051</data>
  <data key="d6"></data>
</node>
<node id="MODY-ABCC8">
  <data key="d0">MODY-ABCC8</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-ABCC8 is a MODY subtype that shows response to sulfonylureas.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373052</data>
  <data key="d6"></data>
</node>
<node id="MODY-PDX1">
  <data key="d0">MODY-PDX1</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-PDX1 is a rare MODY subtype characterized by diabetes and partial pancreatic agenesis.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373052</data>
  <data key="d6"></data>
</node>
<node id="MODY-CEL">
  <data key="d0">MODY-CEL</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-CEL is a rare MODY subtype associated with pancreatic atrophy, dyslipidemia and exocrine insufficiency.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373052</data>
  <data key="d6"></data>
</node>
<node id="MODY-NEUROD1">
  <data key="d0">MODY-NEUROD1</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-NEUROD1 is a rare MODY subtype with few reported cases.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373053</data>
  <data key="d6"></data>
</node>
<node id="MODY-INS">
  <data key="d0">MODY-INS</data>
  <data key="d1">concept</data>
  <data key="d2">MODY-INS is a rare MODY subtype with few reported cases.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373053</data>
  <data key="d6"></data>
</node>
<node id="APPL1">
  <data key="d0">APPL1</data>
  <data key="d1">concept</data>
  <data key="d2">APPL1 is a gene linked to a few described MODY cases.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373053</data>
  <data key="d6"></data>
</node>
<node id="HNF">
  <data key="d0">HNF</data>
  <data key="d1">concept</data>
  <data key="d2">HNF refers to the hepatocyte nuclear factor family of transcription factors implicated in several MODY subtypes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373054</data>
  <data key="d6"></data>
</node>
<node id="PDX1">
  <data key="d0">PDX1</data>
  <data key="d1">concept</data>
  <data key="d2">PDX1 is the pancreatic and duodenal homeobox 1 gene associated with the MODY-PDX1 subtype.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373054</data>
  <data key="d6"></data>
</node>
<node id="NEUROD1">
  <data key="d0">NEUROD1</data>
  <data key="d1">concept</data>
  <data key="d2">NEUROD1 is the neurogenic differentiation 1 gene associated with the MODY-NEUROD1 subtype.&lt;SEP&gt;NEUROD1 is a transcription factor gene reported in extremely rare MODY forms.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-0bdb8ef335f3531317a3a5bd7de3a561</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377367</data>
  <data key="d6"></data>
</node>
<node id="ABCC8">
  <data key="d0">ABCC8</data>
  <data key="d1">concept</data>
  <data key="d2">ABCC8 encodes a subunit of the ATP‑binding cassette transporter; its mutations are involved in MODY-ABCC8 and neonatal diabetes.&lt;SEP&gt;ABCC8 mutations cause permanent or transient neonatal diabetes and are responsive to sulfonylureas.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377237</data>
  <data key="d6"></data>
</node>
<node id="Sanger Method">
  <data key="d0">Sanger Method</data>
  <data key="d1">method</data>
  <data key="d2">Sanger Method is a DNA sequencing technique used to detect GCK mutations in MODY diagnosis.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373055</data>
  <data key="d6"></data>
</node>
<node id="Genetic Panel">
  <data key="d0">Genetic Panel</data>
  <data key="d1">method</data>
  <data key="d2">Genetic Panel refers to a targeted genetic test recommended for diagnosing neonatal diabetes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373055</data>
  <data key="d6"></data>
</node>
<node id="Neonatal Diabetes (DMN)">
  <data key="d0">Neonatal Diabetes (DMN)</data>
  <data key="d1">concept</data>
  <data key="d2">Neonatal Diabetes is a form of diabetes that begins within the first six months of life, caused by single‑gene mutations affecting insulin secretion.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373055</data>
  <data key="d6"></data>
</node>
<node id="Permanent Neonatal Diabetes (DMNP)">
  <data key="d0">Permanent Neonatal Diabetes (DMNP)</data>
  <data key="d1">concept</data>
  <data key="d2">DMNP is a lifelong form of neonatal diabetes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373056</data>
  <data key="d6"></data>
</node>
<node id="Transient Neonatal Diabetes (DMNT)">
  <data key="d0">Transient Neonatal Diabetes (DMNT)</data>
  <data key="d1">concept</data>
  <data key="d2">DMNT is a temporary form of neonatal diabetes that may resolve in weeks or months but can recur later.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373056</data>
  <data key="d6"></data>
</node>
<node id="Renal Cysts">
  <data key="d0">Renal Cysts</data>
  <data key="d1">concept</data>
  <data key="d2">Renal cysts are kidney cysts observed in MODY-HNF1B cases.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373057</data>
  <data key="d6"></data>
</node>
<node id="Pancreatic Atrophy">
  <data key="d0">Pancreatic Atrophy</data>
  <data key="d1">concept</data>
  <data key="d2">Pancreatic atrophy is a reduction in pancreatic size seen in MODY-HNF1B and MODY-CEL.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373057</data>
  <data key="d6"></data>
</node>
<node id="Exocrine Insufficiency">
  <data key="d0">Exocrine Insufficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Exocrine insufficiency is a digestive deficiency linked to MODY-CEL.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373058</data>
  <data key="d6"></data>
</node>
<node id="Single Gene Mutation">
  <data key="d0">Single Gene Mutation</data>
  <data key="d1">concept</data>
  <data key="d2">Single Gene Mutation refers to the genetic alteration responsible for most MODY and neonatal diabetes cases.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373058</data>
  <data key="d6"></data>
</node>
<node id="Imprinting Abnormalities at 6q24">
  <data key="d0">Imprinting Abnormalities at 6q24</data>
  <data key="d1">concept</data>
  <data key="d2">Imprinting abnormalities at chromosome 6q24 cause many cases of transient neonatal diabetes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373058</data>
  <data key="d6"></data>
</node>
<node id="KATP Channel">
  <data key="d0">KATP Channel</data>
  <data key="d1">concept</data>
  <data key="d2">KATP Channel is an ATP‑dependent potassium channel whose gene mutations (KCNJ11, ABCC8) cause neonatal diabetes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373058</data>
  <data key="d6"></data>
</node>
<node id="Wolcott‑Rallison Syndrome">
  <data key="d0">Wolcott‑Rallison Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Wolcott‑Rallison syndrome is a rare disorder caused by EIF2AK3 mutations.&lt;SEP&gt;Wolcott‑Rallison syndrome is a rare disorder caused by EIF2AK3 mutations, characterized by epiphyseal dysplasia and pancreatic insufficiency.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377240</data>
  <data key="d6"></data>
</node>
<node id="Consanguinity">
  <data key="d0">Consanguinity</data>
  <data key="d1">concept</data>
  <data key="d2">Consanguinity refers to the practice of intermarriage between close relatives, increasing the risk of homozygous gene mutations.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373059</data>
  <data key="d6"></data>
</node>
<node id="Persistent Hyperglycemia">
  <data key="d0">Persistent Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Persistent hyperglycemia is the continuous high blood glucose level characteristic of neonatal diabetes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373059</data>
  <data key="d6"></data>
</node>
<node id="R6">
  <data key="d0">R6</data>
  <data key="d1">concept</data>
  <data key="d2">R6 is a recommendation identifier indicating that genetic screening is advised for neonatal diabetes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373059</data>
  <data key="d6"></data>
</node>
<node id="Hipomagnesemia">
  <data key="d0">Hipomagnesemia</data>
  <data key="d1">concept</data>
  <data key="d2">Hipomagnesemia is a condition of low blood magnesium levels mentioned as a clinical feature of MODY-HNF1B.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373060</data>
  <data key="d6"></data>
</node>
<node id="Gout">
  <data key="d0">Gout</data>
  <data key="d1">concept</data>
  <data key="d2">Gout is an inflammatory joint disorder listed among clinical manifestations of MODY-HNF1B.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373060</data>
  <data key="d6"></data>
</node>
<node id="Hyperuricemia">
  <data key="d0">Hyperuricemia</data>
  <data key="d1">concept</data>
  <data key="d2">Hyperuricemia is elevated uric acid in the blood, cited as a clinical feature of MODY-HNF1B.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373060</data>
  <data key="d6"></data>
</node>
<node id="Abnormal Liver Function Tests">
  <data key="d0">Abnormal Liver Function Tests</data>
  <data key="d1">concept</data>
  <data key="d2">Abnormal Liver Function Tests refer to irregular liver enzyme results associated with MODY-HNF1B.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373060</data>
  <data key="d6"></data>
</node>
<node id="Uterine Malformations">
  <data key="d0">Uterine Malformations</data>
  <data key="d1">concept</data>
  <data key="d2">Uterine Malformations are developmental anomalies of the uterus mentioned in MODY-HNF1B cases.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373060</data>
  <data key="d6"></data>
</node>
<node id="Mild Fasting Hyperglycemia">
  <data key="d0">Mild Fasting Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Mild Fasting Hyperglycemia describes the slight elevation of blood glucose after fasting characteristic of MODY-GCK.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373061</data>
  <data key="d6"></data>
</node>
<node id="Genetic Evaluation">
  <data key="d0">Genetic Evaluation</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic Evaluation is the process of assessing specific gene mutations, recommended for diagnosing MODY subtypes.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373061</data>
  <data key="d6"></data>
</node>
<node id="No Family History">
  <data key="d0">No Family History</data>
  <data key="d1">concept</data>
  <data key="d2">No Family History indicates the absence of a known familial occurrence of diabetes, noted in about 50 % of MODY-HNF1B cases.</data>
  <data key="d3">chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373061</data>
  <data key="d6"></data>
</node>
<node id="Clinical Prediction Model">
  <data key="d0">Clinical Prediction Model</data>
  <data key="d1">method</data>
  <data key="d2">A model designed to determine the probability of MODY in patients with young‑onset diabetes.</data>
  <data key="d3">chunk-cc432bf15c11ef31f7aff87b534b5eaf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373061</data>
  <data key="d6"></data>
</node>
<node id="Young‑Onset Diabetes">
  <data key="d0">Young‑Onset Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes diagnosed at a young age.</data>
  <data key="d3">chunk-cc432bf15c11ef31f7aff87b534b5eaf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373061</data>
  <data key="d6"></data>
</node>
<node id="Stankute I">
  <data key="d0">Stankute I</data>
  <data key="d1">person</data>
  <data key="d2">Author of a diabetes genetics study cited in the text.</data>
  <data key="d3">chunk-cc432bf15c11ef31f7aff87b534b5eaf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373062</data>
  <data key="d6"></data>
