</node>
<node id="Mitogenic Proliferative Pathway">
  <data key="d0">Mitogenic Proliferative Pathway</data>
  <data key="d1">concept</data>
  <data key="d2">Mitogenic proliferative pathway is the cellular growth‑promotion cascade downstream of IGF‑1 receptor activation.</data>
  <data key="d3">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
