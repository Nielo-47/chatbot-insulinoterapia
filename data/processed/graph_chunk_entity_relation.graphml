<node id="Pão">
  <data key="d0">Pão</data>
  <data key="d1">artifact</data>
  <data key="d2">Pão is a light snack recommended after treating low blood sugar to help stabilize glucose levels.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
