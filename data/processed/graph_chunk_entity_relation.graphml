  <data key="d0">Unexpected Glucose Results</data>
  <data key="d3">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d2">Control solution should be used when unexpected glucose results occur repeatedly.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1776645512</data>
  <data key="d6"></data>
</node>
