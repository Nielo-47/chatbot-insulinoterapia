</node>
<node id="Hipoglicemia De Esforço">
  <data key="d0">Hipoglicemia De Esforço</data>
  <data key="d1">concept</data>
  <data key="d2">Hipoglicemia De Esforço is exercise‑induced hypoglycemia, with risk factors such as prolonged duration, unusual intensity, and inadequate energy supply.</data>
  <data key="d3">chunk-6f645bd7019e94151caaff47d6cbfcaf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Hipoglicemia_SBD_transcricao.docx</data>
