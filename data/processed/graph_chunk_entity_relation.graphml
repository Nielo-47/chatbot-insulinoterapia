  <data key="d5">1786332081</data>
  <data key="d6"></data>
</node>
<node id="ISO 11608-1">
  <data key="d0">ISO 11608-1</data>
  <data key="d1">concept</data>
  <data key="d2">ISO 11608-1 is the international standard for dose precision and functionality applicable to insulin pens.&lt;SEP&gt;ISO 11608-1 is the international standard for dose precision and functionality referenced for the KWIKPEN.</data>
  <data key="d3">chunk-6f0c10866496bbb0b388b1e5ed69901c&lt;SEP&gt;chunk-b4916e2524690f1ce85df7c187f6d7a7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310744</data>
  <data key="d6"></data>
</node>
<node id="Dose Selector Button">
  <data key="d0">Dose Selector Button</data>
  <data key="d1">artifact</data>
  <data key="d2">Dose Selector Button is a control on the KwikPen that sets and displays the insulin dose.&lt;SEP&gt;Dose Selector Button is a component of BASAGLAR KwikPen used to select the insulin dose.</data>
  <data key="d3">chunk-6f0c10866496bbb0b388b1e5ed69901c&lt;SEP&gt;chunk-0b9c41c968bcc1d46185583661e8f989</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310007</data>
  <data key="d6"></data>
</node>
<node id="France">
  <data key="d0">France</data>
  <data key="d1">location</data>
  <data key="d2">France is the country where Lilly France S.A.S. is located.&lt;SEP&gt;France is the country where Roche Diabetes Care France SAS distributes the device.&lt;SEP&gt;France is the country where the RELIEF study documented a drop in acute diabetes complications after flash glucose monitoring initiation.</data>
  <data key="d3">chunk-6f0c10866496bbb0b388b1e5ed69901c&lt;SEP&gt;chunk-4f540d57f26133557d784c93e6ea2dca&lt;SEP&gt;chunk-d3a9b76fabae2f788f96d06b7d98c924</data>
