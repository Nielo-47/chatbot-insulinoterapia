  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Patient With Type 1 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Individuals with type 1 diabetes may use a continuous insulin infusion system as part of their treatment.</data>
  <data key="d9">therapy,usage</data>
  <data key="d10">chunk-60530d1861f7c2d1efecc069c0913d37</data>
