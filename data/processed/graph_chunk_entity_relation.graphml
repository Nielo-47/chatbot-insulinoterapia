  <data key="d0">Outros Tipos de Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Outros Tipos de Diabetes groups less common diabetes variants such as monogenic and mitochondrial forms.</data>
  <data key="d3">chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
