  <data key="d14"></data>
</edge>
<edge source="Insulina Humana" target="Escherichia Coli">
  <data key="d8">1.0</data>
  <data key="d9">Human insulin is synthesized using a genetically modified strain of Escherichia coli that carries the human insulin gene.</data>
  <data key="d10">biosynthesis,genetic engineering</data>
  <data key="d11">chunk-b24ac2a9beff09325af7272be567cf82</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699705</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina Humana" target="Insulina Não Homóloga">
  <data key="d8">1.0</data>
  <data key="d9">Switching from non-homologous (animal) insulin to human insulin can result in significant immunological improvement, reducing anti-insulin antibody levels.</data>
  <data key="d10">immunological improvement,therapeutic substitution</data>
  <data key="d11">chunk-b24ac2a9beff09325af7272be567cf82</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699708</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina Humana" target="Anticorpos Anti-Insulina">
  <data key="d8">1.0</data>
  <data key="d9">The use of human insulin reduces the production of anti-insulin antibodies compared to animal-derived insulin.</data>
  <data key="d10">antibody reduction,immune response</data>
  <data key="d11">chunk-b24ac2a9beff09325af7272be567cf82</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699709</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina Humana" target="Fígado">
  <data key="d8">1.0</data>
  <data key="d9">In the liver, human insulin promotes glucose uptake and glycogen storage, inhibits gluconeogenesis, and stimulates conversion of glucose to fat.</data>
  <data key="d10">gluconeogenesis inhibition,glycogen storage</data>
  <data key="d11">chunk-b24ac2a9beff09325af7272be567cf82</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699713</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina Humana" target="Amiloidose Cutânea Localizada">
  <data key="d8">1.0</data>
  <data key="d9">Localized cutaneous amyloidosis at injection sites can impair insulin absorption and lead to hyperglycemia.</data>
  <data key="d10">impaired absorption,localized amyloidosis</data>
  <data key="d11">chunk-b24ac2a9beff09325af7272be567cf82</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
