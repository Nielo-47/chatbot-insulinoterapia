  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="FSBG">
  <data key="d0">FSBG</data>
  <data key="d1">data</data>
  <data key="d2">Finger‑stick blood glucose measurement used to confirm glucose excursions below 70 mg/dL.</data>
  <data key="d3">chunk-91f290894e2d3b4216cac1721f22bb67</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="Symptomatic Hypoglycemia">
  <data key="d0">Symptomatic Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Clinically relevant hypoglycemia episodes presenting symptoms, used as the primary component of the composite outcome.</data>
  <data key="d3">chunk-91f290894e2d3b4216cac1721f22bb67</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="Patient‑Year">
  <data key="d0">Patient‑Year</data>
  <data key="d1">data</data>
  <data key="d2">Metric combining number of patients and observation time, used to express hypoglycemia episode rates.</data>
  <data key="d3">chunk-91f290894e2d3b4216cac1721f22bb67</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="Elderly Patients (≥ 60 years)">
  <data key="d0">Elderly Patients (≥ 60 years)</data>
  <data key="d1">concept</data>
  <data key="d2">Elderly patients are a population group advised to receive conservative insulin dosing to avoid hypoglycemia.</data>
  <data key="d3">chunk-3e50c145614f04be2319a31b74b80411</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="Vision Disturbance">
  <data key="d0">Vision Disturbance</data>
  <data key="d1">concept</data>
  <data key="d2">Vision disturbance refers to temporary visual impairment caused by acute changes in blood glucose levels.</data>
  <data key="d3">chunk-3e50c145614f04be2319a31b74b80411</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="Short‑acting Insulin">
  <data key="d0">Short‑acting Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Short‑acting insulin is a rapid‑acting insulin type mentioned as being mistakenly administered instead of insulin glargine.</data>
  <data key="d3">chunk-3e50c145614f04be2319a31b74b80411</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="Pediatric Patients (≤ 18 years)">
  <data key="d0">Pediatric Patients (≤ 18 years)</data>
  <data key="d1">concept</data>
  <data key="d2">Pediatric patients are a population with a safety profile similar to adults but with higher frequency of certain adverse events.</data>
  <data key="d3">chunk-3e50c145614f04be2319a31b74b80411</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310048</data>
  <data key="d6"></data>
</node>
<node id="Intensive Insulin Therapy">
  <data key="d0">Intensive Insulin Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Intensive insulin therapy describes a heightened insulin dosing regimen that rapidly lowers blood glucose.&lt;SEP&gt;Intensive insulin therapy denotes a treatment regimen with high insulin doses that can temporarily worsen diabetic retinopathy.&lt;SEP&gt;Intensive Insulin Therapy involves multiple daily injections or continuous infusion to closely mimic physiological insulin patterns.&lt;SEP&gt;Intensive Insulin Therapy refers to a regimen using multiple daily injections or an insulin pump to achieve tight glycemic control in DM1.&lt;SEP&gt;Intensive Insulin Therapy is a diabetes treatment regimen involving multiple daily insulin doses, referenced as a condition influencing BGM prescribing.&lt;SEP&gt;Intensive Insulin Therapy is a treatment approach for clinically insulin‑deficient diabetes patients.&lt;SEP&gt;A treatment approach using high doses of insulin to achieve tight blood‑glucose control.</data>
  <data key="d3">chunk-3e50c145614f04be2319a31b74b80411&lt;SEP&gt;chunk-e8934881ec5ab7cfeb836126b3f0e8b2&lt;SEP&gt;chunk-fd6fa98b7767319460b4a421a719c5c2&lt;SEP&gt;chunk-494fef0b8efc2c44b3b49ebf9d74b7f2&lt;SEP&gt;chunk-9cd925790899146eeb8a373879b5feac&lt;SEP&gt;chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-54ce8d1437c0ec0329819123568df11e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372182</data>
  <data key="d6"></data>
</node>
<node id="Safety Profile">
  <data key="d0">Safety Profile</data>
  <data key="d1">concept</data>
  <data key="d2">Safety profile describes the overall pattern of adverse events observed for a medication across different age groups.</data>
  <data key="d3">chunk-3e50c145614f04be2319a31b74b80411</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Proliferative Diabetic Retinopathy">
  <data key="d0">Proliferative Diabetic Retinopathy</data>
  <data key="d1">concept</data>
  <data key="d2">Proliferative diabetic retinopathy is an advanced stage of diabetic eye disease that can be aggravated by severe hypoglycemia if not treated with fotocoagulação.</data>
  <data key="d3">chunk-3e50c145614f04be2319a31b74b80411</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Paralisia Respiratória">
  <data key="d0">Paralisia Respiratória</data>
  <data key="d1">concept</data>
  <data key="d2">Respiratory paralysis is a severe loss of breathing function that may result from untreated hipocalemia.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Arritmia Ventricular">
  <data key="d0">Arritmia Ventricular</data>
  <data key="d1">concept</data>
  <data key="d2">Ventricular arrhythmia is an irregular heart rhythm that may be induced by untreated hipocalemia.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Morte">
  <data key="d0">Morte</data>
  <data key="d1">concept</data>
  <data key="d2">Death is a possible fatal outcome of untreated hipocalemia.&lt;SEP&gt;Morte denotes death, a potential lethal outcome of severe hypo‑ or hyperglycemia and ketoacidosis.&lt;SEP&gt;Morte is the fatal outcome that can result from severe hypoglycemia or untreated ketoacidosis.&lt;SEP&gt;Desfecho fatal possível se a cetoacidose não for tratada.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb&lt;SEP&gt;chunk-a247846b9ec5d44d0bcbe6c5f15599f8&lt;SEP&gt;chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319719</data>
  <data key="d6"></data>
</node>
<node id="Feto">
  <data key="d0">Feto</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The fetus is the developing offspring inside the pregnant woman.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Recém‑nascido">
  <data key="d0">Recém‑nascido</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A newborn infant may be exposed to insulin glargina through breast milk.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Pacientes Geriátricos">
  <data key="d0">Pacientes Geriátricos</data>
  <data key="d1">concept</data>
  <data key="d2">Geriatric patients are advised to start and adjust insulin glargina conservatively to avoid hypoglycemia.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Inibidores da Enzima Conversora de">
  <data key="d0">Inibidores da Enzima Conversora de</data>
  <data key="d1">concept</data>
  <data key="d2">ACE inhibitors are enzyme‑converting‑enzyme inhibitors that may amplify insulin’s effect and increase hypoglycemia susceptibility.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Leite Humano">
  <data key="d0">Leite Humano</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Human milk is the lactational fluid that may contain insulin glargina, though excretion is unknown.&lt;SEP&gt;Human breast milk, relevant for considerations of medication use during lactation and donation.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319739</data>
  <data key="d6"></data>
</node>
<node id="Capacidade de Dirigir e Operar Máquinas">
  <data key="d0">Capacidade de Dirigir e Operar Máquinas</data>
  <data key="d1">concept</data>
  <data key="d2">The ability to drive and operate machines, which can be compromised by hypoglycemia, hyperglycemia, or impaired vision.</data>
  <data key="d3">chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Hypersensitivity to Insulin Glargine">
  <data key="d0">Hypersensitivity to Insulin Glargine</data>
  <data key="d1">concept</data>
  <data key="d2">Hypersensitivity to insulin glargine describes an allergic reaction to insulin glargine or any component of its formulation.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310049</data>
  <data key="d6"></data>
</node>
<node id="Blood Flow">
  <data key="d0">Blood Flow</data>
  <data key="d1">concept</data>
  <data key="d2">Blood flow denotes the circulation of blood in a tissue region, affecting insulin absorption speed.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310050</data>
  <data key="d6"></data>
</node>
<node id="Body Temperature">
  <data key="d0">Body Temperature</data>
  <data key="d1">concept</data>
  <data key="d2">Body temperature is the internal temperature of the patient, which can modify insulin action time.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310050</data>
  <data key="d6"></data>
</node>
<node id="Coronary Artery Stenosis">
  <data key="d0">Coronary Artery Stenosis</data>
  <data key="d1">concept</data>
  <data key="d2">Coronary artery stenosis is a narrowing of the heart’s arteries that increases risk of severe hypoglycemia complications.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310050</data>
  <data key="d6"></data>
</node>
<node id="Cerebral Vein Stenosis">
  <data key="d0">Cerebral Vein Stenosis</data>
  <data key="d1">concept</data>
  <data key="d2">Cerebral vein stenosis is a narrowing of brain‑draining veins that raises risk of neurological complications from hypoglycemia.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310050</data>
  <data key="d6"></data>
</node>
<node id="Psychiatric Disease">
  <data key="d0">Psychiatric Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Psychiatric disease refers to mental health disorders that can alter perception of hypoglycemia symptoms.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310050</data>
  <data key="d6"></data>
</node>
<node id="Better Glycemic Control">
  <data key="d0">Better Glycemic Control</data>
  <data key="d1">concept</data>
  <data key="d2">Better glycemic control describes a tightly managed blood glucose level that can mask early hypoglycemia symptoms.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538&lt;SEP&gt;chunk-91a114d8b89cacee37b56501f349ce85</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310050</data>
  <data key="d6"></data>
</node>
<node id="Gradual Development of Hypoglycemia">
  <data key="d0">Gradual Development of Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Gradual development of hypoglycemia refers to a slow onset of low blood glucose, potentially reducing warning signs.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310050</data>
  <data key="d6"></data>
</node>
<node id="Long Diabetes History">
  <data key="d0">Long Diabetes History</data>
  <data key="d1">concept</data>
  <data key="d2">Long diabetes history denotes patients who have lived with diabetes for many years, possibly affecting hypoglycemia awareness.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310051</data>
  <data key="d6"></data>
</node>
<node id="Concurrent Medications">
  <data key="d0">Concurrent Medications</data>
  <data key="d1">concept</data>
  <data key="d2">Concurrent medications are other drugs taken alongside insulin that may interfere with hypoglycemia symptom perception.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310051</data>
  <data key="d6"></data>
</node>
<node id="Altered Hypoglycemia Symptoms">
  <data key="d0">Altered Hypoglycemia Symptoms</data>
  <data key="d1">concept</data>
  <data key="d2">Altered hypoglycemia symptoms are atypical or absent warning signs of low blood glucose occurring under certain clinical conditions.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310051</data>
  <data key="d6"></data>
</node>
<node id="Insulin Regimen Adjustments">
  <data key="d0">Insulin Regimen Adjustments</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin regimen adjustments refer to changes in insulin concentration, manufacturer, type, or administration method.</data>
  <data key="d3">chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310051</data>
