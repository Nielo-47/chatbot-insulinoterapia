  <data key="d14"></data>
</edge>
<edge source="Período De Utilização" target="Boletim De Ocorrência">
  <data key="d8">1.0</data>
  <data key="d9">Em caso de perda ou quebra da caneta antes de 3 anos, é necessário apresentar um Boletim de Ocorrência para obter reposição.</data>
  <data key="d10">policy compliance,replacement requirement</data>
  <data key="d11">chunk-60fe44346c0b02882f7625cbf43d8ca0</data>
