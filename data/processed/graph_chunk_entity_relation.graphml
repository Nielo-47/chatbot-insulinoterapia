  <data key="d13">1778707528</data>
  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="MiniMed 780G Insulin Pump">
  <data key="d8">2.0</data>
  <data key="d9">The MiniMed 780G insulin pump can deliver a Dual Wave bolus using either the Bolus Wizard or Manual bolus feature.&lt;SEP&gt;The MiniMed 780G insulin pump supports the delivery of Dual Wave boluses as part of its advanced features.&gt;</data>
  <data key="d10">combination bolus,device function,insulin delivery</data>
  <data key="d11">chunk-d536bf636b4a29c1f9f46de648b2b306&lt;SEP&gt;chunk-bb895500e1ede1e328c1d3f50e5e9b36</data>
