  <data key="d0">Tanner Stage III</data>
  <data key="d1">concept</data>
  <data key="d2">Pubertal development stage of participants in the TODAY study.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
