<node id="Continuous Subcutaneous Infusion">
  <data key="d0">Continuous Subcutaneous Infusion</data>
  <data key="d1">concept</data>
  <data key="d2">Continuous Subcutaneous Infusion describes the steady delivery of insulin beneath the skin, offered by patch‑like devices.</data>
