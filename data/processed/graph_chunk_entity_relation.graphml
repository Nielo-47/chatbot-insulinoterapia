  <data key="d14"></data>
</edge>
<edge source="GS" target="Medidor Compatible">
  <data key="d8">2.0</data>
  <data key="d9">Medidor compatible transmits GS values directly to the insulin pump for use in Bolus Wizard calculations.&lt;SEP&gt;Medidor Compatible provides GS readings directly to the system for use in bolus calculations.</data>
  <data key="d10">data integration,glucose measurement,glucose monitoring</data>
