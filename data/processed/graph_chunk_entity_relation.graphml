  <data key="d14"></data>
</edge>
<edge source="Glucometer" target="Hand Washing">
  <data key="d8">1.0</data>
  <data key="d9">Washing hands before testing prevents sugar residue from affecting glucometer readings.</data>
  <data key="d10">contamination prevention,test accuracy</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694525</data>
  <data key="d14"></data>
</edge>
<edge source="Glucometer" target="Test Strip Expiration">
  <data key="d8">1.0</data>
  <data key="d9">The glucometer user must verify that the test strip is within its expiration date to ensure reliable glucose readings.</data>
  <data key="d10">accuracy verification,quality control</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694526</data>
  <data key="d14"></data>
</edge>
<edge source="Glucometer" target="Test Strip Coding">
  <data key="d8">1.0</data>
  <data key="d9">The glucometer must be coded to match the test strip batch code to provide accurate blood glucose results.</data>
  <data key="d10">device calibration,measurement accuracy</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694526</data>
  <data key="d14"></data>
</edge>
