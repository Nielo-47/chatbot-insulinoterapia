  <data key="d5">1786325505</data>
  <data key="d6"></data>
</node>
<node id="Mensaje Bolus Cuadrado">
  <data key="d0">Mensaje Bolus Cuadrado</data>
  <data key="d1">content</data>
  <data key="d2">Mensaje Bolus Cuadrado is a screen notification that appears while a square bolus is being administered and remains until completion.</data>
  <data key="d3">chunk-35a3bbe287cd55b2fd0a1505c706e7a4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
