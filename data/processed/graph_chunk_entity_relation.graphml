  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Possible Signaling Interference Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Possible Signaling Interference Alert indicates that electronic devices may be disrupting communication between the insulin pump and the CGM Device.</data>
  <data key="d10">communication disruption,electronic interference</data>
