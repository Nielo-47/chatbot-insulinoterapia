<node id="15-15 Rule">
  <data key="d0">15-15 Rule</data>
  <data key="d1">method</data>
  <data key="d2">The 15-15 Rule is a guideline to treat low blood glucose by consuming 15 grams of fast-acting carbohydrates and rechecking after 15 minutes.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372321</data>
  <data key="d6"></data>
</node>
<node id="Fast-Acting Carbohydrates">
  <data key="d0">Fast-Acting Carbohydrates</data>
  <data key="d1">concept</data>
  <data key="d2">Fast-acting carbohydrates are carbohydrate sources that raise blood glucose quickly during hypoglycemia.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372321</data>
  <data key="d6"></data>
</node>
<node id="Glucose Gel Tube">
  <data key="d0">Glucose Gel Tube</data>
  <data key="d1">artifact</data>
  <data key="d2">Glucose gel tube is a flavored gel delivering approximately 15 grams of carbs for treating low blood glucose.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372321</data>
  <data key="d6"></data>
</node>
<node id="Juice">
  <data key="d0">Juice</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Juice (1/2 cup) is listed as a fast-acting carbohydrate option to raise blood glucose.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372321</data>
  <data key="d6"></data>
</node>
<node id="Regular Soda">
  <data key="d0">Regular Soda</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Regular soda (1/2 cup, non-diet) is listed as a fast-acting carbohydrate option.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372322</data>
  <data key="d6"></data>
</node>
<node id="Corn Syrup">
  <data key="d0">Corn Syrup</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Corn syrup (1 tablespoon) is listed as a fast-acting carbohydrate option.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372322</data>
  <data key="d6"></data>
</node>
<node id="Honey">
  <data key="d0">Honey</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Honey is listed as a fast-acting carbohydrate option for children older than one year.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372322</data>
  <data key="d6"></data>
</node>
<node id="Hard Candies">
  <data key="d0">Hard Candies</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hard candies are fast-acting carbohydrates counted to provide 15 grams of carbs.</data>
  <data key="d3">chunk-0645201ac55eff389c44997aecbb6ce7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372322</data>
  <data key="d6"></data>
</node>
<node id="Jellybeans">
