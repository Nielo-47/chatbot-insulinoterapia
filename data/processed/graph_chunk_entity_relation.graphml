</node>
<node id="Post-prandial">
  <data key="d0">Post-prandial</data>
  <data key="d1">concept</data>
  <data key="d2">Post-prandial describes the period or treatment administered after a meal.</data>
  <data key="d3">chunk-9ff211ed5ca723fa2074871af58a4eb8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
