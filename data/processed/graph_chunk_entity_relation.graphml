  <data key="d12">1786325727</data>
  <data key="d13"></data>
</edge>
<edge source="Bomba" target="Icono de la Pila">
  <data key="d7">1.0</data>
  <data key="d8">The battery icon displays the pump’s battery condition, showing low or replace‑needed states.</data>
  <data key="d9">battery,status indicator</data>
