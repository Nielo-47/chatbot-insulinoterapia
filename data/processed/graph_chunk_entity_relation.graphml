</edge>
<edge source="Bomba De Insulina" target="Reservorio">
  <data key="d8">1.0</data>
  <data key="d9">The reservorio is a part of the bomba de insulina that holds insulin for delivery.</data>
  <data key="d10">device component,insulin storage</data>
