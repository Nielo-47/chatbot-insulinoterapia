  <data key="d14"></data>
</edge>
<edge source="Basal Rate" target="MiniMed 670G">
  <data key="d8">2.0</data>
  <data key="d9">The MiniMed 670G delivers insulin based on programmed basal rate settings.&lt;SEP&gt;The MiniMed 670G delivers a programmed basal rate of insulin to maintain stable glucose levels throughout the day and night.</data>
  <data key="d10">automated control,continuous insulin delivery,glucose control,insulin delivery</data>
