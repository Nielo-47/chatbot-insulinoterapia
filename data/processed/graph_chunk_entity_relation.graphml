  <data key="d13"></data>
</edge>
<edge source="Cetoacidose Diabética" target="Hiperventilação">
  <data key="d7">1.0</data>
  <data key="d8">Rapid breathing is a symptom of diabetic ketoacidosis.</data>
  <data key="d9">symptom</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319822</data>
  <data key="d13"></data>
</edge>
<edge source="Cetoacidose Diabética" target="Pulso Acelerado">
  <data key="d7">2.0</data>
  <data key="d8">An accelerated pulse indicates severe ketoacidosis.&lt;SEP&gt;Rapid pulse signifies severe ketoacidosis.</data>
  <data key="d9">indicator,severe symptom,symptom</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
