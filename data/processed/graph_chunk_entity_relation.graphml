<edge source="Paciente" target="Terapia SAP">
  <data key="d8">1.0</data>
  <data key="d9">The patient benefits from Sensor-Augmented Pump therapy when combined with carbohydrate counting and Bolus Wizard™.</data>
  <data key="d10">advanced therapy,insulin delivery</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702744</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Bolus Wizard">
  <data key="d8">1.0</data>
  <data key="d9">The patient uses the Bolus Wizard™ feature to calculate accurate insulin bolus doses based on carbohydrate intake and current glucose levels.</data>
  <data key="d10">dose calculation,technology integration</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702750</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Formacion En Contaje De Hidratos De Carbono">
  <data key="d8">1.0</data>
  <data key="d9">The patient can access training resources to learn how to properly count carbohydrates for effective diabetes management.</data>
  <data key="d10">education,skill development</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702756</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Representante De Medtronic">
  <data key="d8">1.0</data>
  <data key="d9">The patient can contact a Medtronic representative to receive education on carbohydrate counting and insulin pump use.</data>
  <data key="d10">technical assistance,training</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702768</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Dieta Durante Enfermedad">
  <data key="d8">1.0</data>
  <data key="d9">The patient must follow a specific diet during illness, using appropriate fluids to manage hydration and caloric needs without worsening glucose control.</data>
  <data key="d10">illness response,nutritional management</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
