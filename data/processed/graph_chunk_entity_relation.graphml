  <data key="d5">1778707385</data>
  <data key="d6"></data>
</node>
<node id="Bolus Wizard Example">
  <data key="d0">Bolus Wizard Example</data>
  <data key="d1">content</data>
  <data key="d2">Bolus Wizard Example illustrates how the Bolus Wizard calculates insulin doses.</data>
  <data key="d3">chunk-f2667d6936a8a9a26e886ba90b060796</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
