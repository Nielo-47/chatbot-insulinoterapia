  <data key="d14"></data>
</edge>
<edge source="Basal Rate Pattern" target="8:00 A.M.">
  <data key="d8">1.0</data>
  <data key="d9">At 8:00 A.M., the basal rate pattern changes to a lower rate of 0.650 units per hour.</data>
  <data key="d10">rate change,time trigger</data>
  <data key="d11">chunk-113df8f96ec77242ec482c5116a12b1e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704352</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Rate Pattern" target="6:00 P.M.">
  <data key="d8">1.0</data>
  <data key="d9">At 6:00 P.M., the basal rate pattern changes back from 0.650 to 0.900 units per hour.</data>
  <data key="d10">rate change,time trigger</data>
  <data key="d11">chunk-113df8f96ec77242ec482c5116a12b1e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704352</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Rate Pattern" target="12:00 A.M.">
  <data key="d8">1.0</data>
  <data key="d9">The basal rate pattern begins and ends at 12:00 A.M., completing a 24-hour cycle.</data>
  <data key="d10">cycle end,cycle start</data>
  <data key="d11">chunk-113df8f96ec77242ec482c5116a12b1e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704353</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Rate Pattern" target="5:30 P.M.">
  <data key="d8">1.0</data>
  <data key="d9">At 5:30 P.M., the basal rate pattern is set to change from 0.700 back to 0.900 units per hour.</data>
  <data key="d10">rate change,time trigger</data>
  <data key="d11">chunk-113df8f96ec77242ec482c5116a12b1e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704354</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis Prevention" target="Ketone Bodies">
  <data key="d8">1.0</data>
  <data key="d9">Checking for ketone bodies is a key step in the prevention of diabetic ketoacidosis, especially when glucose levels are high.</data>
  <data key="d10">early detection,risk assessment</data>
  <data key="d11">chunk-2fdccbdc819ab6cd813190d6db8dc9c3</data>
