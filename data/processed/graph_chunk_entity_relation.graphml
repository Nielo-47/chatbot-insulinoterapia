<node id="Faixas Seguras">
  <data key="d0">Faixas Seguras</data>
  <data key="d1">concept</data>
  <data key="d2">Safe glucose ranges (70‑130 mg/dL fasting, up to 180 mg/dL two hours post‑prandial) used for monitoring.</data>
