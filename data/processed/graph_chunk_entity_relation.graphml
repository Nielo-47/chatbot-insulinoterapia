  <data key="d0">Breakthrough T1D</data>
  <data key="d1">organization</data>
  <data key="d2">An initiative (formerly JDRF) that suggests identifying patients with multiple autoantibodies for type 1 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372003</data>
  <data key="d6"></data>
</node>
<node id="Anti‑GAD">
  <data key="d0">Anti‑GAD</data>
  <data key="d1">artifact</data>
  <data key="d2">An autoantibody targeting glutamic acid decarboxylase, used as a marker for type 1 diabetes risk.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372003</data>
  <data key="d6"></data>
</node>
<node id="Anti‑Insulin">
  <data key="d0">Anti‑Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">An autoantibody targeting insulin, used as a marker for type 1 diabetes risk.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372003</data>
  <data key="d6"></data>
</node>
<node id="Anti‑Tyrosine Phosphatase">
  <data key="d0">Anti‑Tyrosine Phosphatase</data>
  <data key="d1">artifact</data>
  <data key="d2">An autoantibody targeting tyrosine phosphatase, used as a marker for type 1 diabetes risk.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372003</data>
  <data key="d6"></data>
</node>
<node id="Screening Criteria For Type 2 Diabetes">
  <data key="d0">Screening Criteria For Type 2 Diabetes</data>
  <data key="d1">method</data>
  <data key="d2">A set of clinical indicators including overweight, age ≥10, family history, acanthosis nigricans, hypertension, dyslipidemia, and polycystic ovary syndrome used to identify asymptomatic children at risk for type 2 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372003</data>
  <data key="d6"></data>
</node>
<node id="Screening For Type 1 Diabetes">
  <data key="d0">Screening For Type 1 Diabetes</data>
  <data key="d1">method</data>
  <data key="d2">The practice of measuring autoantibodies in first‑degree relatives of individuals with type 1 diabetes to reduce risk of ketoacidosis and guide prevention.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372003</data>
  <data key="d6"></data>
</node>
<node id="Polyuria">
  <data key="d0">Polyuria</data>
  <data key="d1">concept</data>
  <data key="d2">Excessive urination, a symptom associated with hyperglycemia.&lt;SEP&gt;Excessive urination observed in about 30% of children with type 2 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372003</data>
  <data key="d6"></data>
</node>
<node id="Polydipsia">
  <data key="d0">Polydipsia</data>
  <data key="d1">concept</data>
  <data key="d2">Excessive thirst, a symptom associated with hyperglycemia.&lt;SEP&gt;Excessive thirst observed in about 30% of children with type 2 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372004</data>
  <data key="d6"></data>
</node>
<node id="Vaginal Candidiasis">
  <data key="d0">Vaginal Candidiasis</data>
  <data key="d1">concept</data>
  <data key="d2">A possible history of vaginal yeast infection reported in some children with type 2 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372004</data>
  <data key="d6"></data>
</node>
<node id="Family History">
  <data key="d0">Family History</data>
  <data key="d1">concept</data>
  <data key="d2">Presence of diabetes in first- or second-degree relatives, used as a risk factor for type 2 diabetes screening.&lt;SEP&gt;Record of disease in relatives, which currently does not allow prediction of Type 1 Diabetes risk.&lt;SEP&gt;Presence of Type 2 Diabetes in first‑degree relatives, increasing individual risk.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-2752a78fbaafd94ca566ff099a4ba551&lt;SEP&gt;chunk-9eb02ab1ab7d834858bf60a8b402e6ea</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377347</data>
  <data key="d6"></data>
</node>
<node id="Female">
  <data key="d0">Female</data>
  <data key="d1">concept</data>
  <data key="d2">Sex category, majority of TODAY study participants were female.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
