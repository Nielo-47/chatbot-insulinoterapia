<node id="Retrospective Insulin Adjustment">
  <data key="d0">Retrospective Insulin Adjustment</data>
  <data key="d1">concept</data>
  <data key="d2">Retrospective Insulin Adjustment is the process of modifying insulin doses based on previously recorded glucose data.</data>
  <data key="d3">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
