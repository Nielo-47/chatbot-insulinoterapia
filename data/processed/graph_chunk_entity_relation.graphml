  <data key="d13">1778708117</data>
  <data key="d14"></data>
</edge>
<edge source="Sensor" target="Change Sensor">
  <data key="d8">2.0</data>
  <data key="d9">A Change Sensor alert is issued when the sensor is not working properly or multiple calibration attempts fail.&lt;SEP&gt;Change Sensor is a prompt indicating the current sensor should be replaced.</data>
  <data key="d10">device replacement,end of life,malfunction response,replacement</data>
  <data key="d11">chunk-cfb8f4a2fd599a5ec7cbad8c356a6ed4&lt;SEP&gt;chunk-3f39c0ebbd9b32994a3bb5daf68794d7</data>
