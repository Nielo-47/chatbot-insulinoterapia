  <data key="d0">Grupo de Controle</data>
  <data key="d1">concept</data>
  <data key="d2">Grupo de Controle is the control group in the randomized clinical trial comparing education versus usual care.</data>
  <data key="d3">chunk-8375bd3e65b9aa9965acd81fd9a448f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d5">1786298842</data>
  <data key="d6"></data>
</node>
