<node id="Confirm CODE Screen">
  <data key="d0">Confirm CODE Screen</data>
  <data key="d1">content</data>
  <data key="d2">Confirm CODE Screen prompts the user to verify that the sensor code matches the label before confirming pairing.</data>
  <data key="d3">chunk-ab510c8377992bab31045a97eb95893a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
