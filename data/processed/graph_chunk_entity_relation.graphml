  <data key="d5">1786368422</data>
  <data key="d6"></data>
</node>
<node id="Cefaleia">
  <data key="d0">Cefaleia</data>
  <data key="d1">concept</data>
  <data key="d2">Cefaleia refers to headache, listed as a symptom of severe hypoglycemia.</data>
  <data key="d3">chunk-aca0b919135813e1d5b772face36989d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
