<edge source="Glycemia Above 250 Mg/Dl" target="Ketones">
  <data key="d8">1.0</data>
  <data key="d9">Persistent glycemia above 250 mg/dL is a clinical trigger for measuring ketones to prevent diabetic ketoacidosis.</data>
