</node>
<node id="AFRESA">
  <data key="d0">AFRESA</data>
  <data key="d1">artifact</data>
  <data key="d2">AFRESA is a brand of inhaled insulin evaluated in pharmacokinetic comparisons with regular human insulin.</data>
  <data key="d3">chunk-161a201d846100f42e643139469a1e6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
