  <data key="d13">1778696039</data>
  <data key="d14"></data>
</edge>
<edge source="Healthcare Professionals" target="Retrospective SMCG">
  <data key="d8">1.0</data>
  <data key="d9">Healthcare professionals use retrospective SMCG data to analyze glycemic patterns and adjust treatment plans.</data>
  <data key="d10">data analysis,treatment adjustment</data>
