  <data key="d13"></data>
</edge>
<edge source="Técnica de Aplicação de Insulina" target="Protetor da Agulha">
  <data key="d7">1.0</data>
  <data key="d8">The technique advises keeping the Protetor da Agulha on the needle until the moment of injection.</data>
  <data key="d9">handling,safety</data>
  <data key="d10">chunk-fed051c0c90a644e72ac31d765d73a6f</data>
