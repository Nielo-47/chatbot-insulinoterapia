  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia Noturna" target="Levemir® FlexPen®">
  <data key="d7">1.0</data>
  <data key="d8">Clinical studies show Levemir® FlexPen® reduces nocturnal hypoglycemia risk by 61–65 % compared with NPH insulin.</data>
  <data key="d9">lower risk,safety</data>
  <data key="d10">chunk-b65a4249ac93aec086cb333ed1507ea7</data>
