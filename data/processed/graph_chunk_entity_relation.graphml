<node id="Seção 6">
  <data key="d0">Seção 6</data>
  <data key="d1">concept</data>
  <data key="d2">Seção 6 is the sixth section of the medication leaflet, giving usage instructions and drug interaction information.</data>
  <data key="d3">chunk-759c20cc4c3fc0d3529aabc2fe7dbf99</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
