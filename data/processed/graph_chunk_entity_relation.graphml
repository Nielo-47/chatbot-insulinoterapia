  <data key="d0">Diagnóstico de Diabetes Mellitus</data>
  <data key="d1">content</data>
  <data key="d2">“Diagnóstico de Diabetes Mellitus” is a guideline published by the Sociedade Brasileira de Diabetes providing diagnostic recommendations for diabetes.</data>
  <data key="d3">chunk-cc0d4df5f59432ca990767b120f983a7</data>
