  <data key="d6"></data>
</node>
<node id="Insulin Human">
  <data key="d0">Insulin Human</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Human is a standard human insulin formulation referenced for comparison in clinical studies.&lt;SEP&gt;Insulin human refers to the type of insulin contained in Novolin® R, used at concentrations of 0.05 to 1.0 UI/mL.</data>
  <data key="d3">chunk-f9e5c50e8a808c537075377966ae2ccd&lt;SEP&gt;chunk-73559dc5d86ea52a348d603482e056e9</data>
