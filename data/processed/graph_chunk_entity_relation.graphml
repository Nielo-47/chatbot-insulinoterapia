</edge>
<edge source="Armazenamento de Insulina" target="Heparinas">
  <data key="d8">1.0</data>
  <data key="d9">Heparins must be stored separately from insulin to prevent administration errors due to similar packaging.</data>
  <data key="d10">medication safety,storage separation</data>
