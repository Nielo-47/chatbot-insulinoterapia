  <data key="d5">1778702514</data>
  <data key="d6"></data>
</node>
<node id="Inicio">
  <data key="d0">Inicio</data>
  <data key="d1">concept</data>
  <data key="d2">Inicio refers to the start time of a basal insulin infusion segment within a basal pattern configuration.&lt;SEP&gt;Inicio denotes the start time of a specific basal rate segment within a basal pattern.</data>
  <data key="d3">chunk-1134674d4e1ab07998567f3fa77e251d&lt;SEP&gt;chunk-3b28f926a642d5f692433ed41fafafa4</data>
