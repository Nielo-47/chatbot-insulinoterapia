</node>
<node id="Sanofi‑Aventis Farmacêutica Ltda">
  <data key="d0">Sanofi‑Aventis Farmacêutica Ltda</data>
  <data key="d1">organization</data>
  <data key="d2">Sanofi‑Aventis Farmacêutica Ltda is the pharmaceutical company that manufactures Lantus.</data>
