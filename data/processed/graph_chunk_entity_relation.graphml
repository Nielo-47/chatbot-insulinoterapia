  <data key="d6"></data>
</node>
<node id="Review Function">
  <data key="d0">Review Function</data>
  <data key="d1">method</data>
  <data key="d2">The Review function allows users to check the programmed basal pattern before saving or making changes.</data>
  <data key="d3">chunk-f608f07eae4ddd5409aed9d4ecef75ad</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
