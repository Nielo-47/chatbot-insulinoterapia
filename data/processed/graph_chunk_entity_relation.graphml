  <data key="d0">Glicemia Baixa</data>
  <data key="d1">concept</data>
  <data key="d2">Glicemia baixa describes hypoglycemia, a blood glucose level below 70 mg/dL.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
