  <data key="d0">Seção 5</data>
  <data key="d1">concept</data>
  <data key="d2">Seção 5 is the fifth section of the medication leaflet, providing warnings and precautions.</data>
  <data key="d3">chunk-759c20cc4c3fc0d3529aabc2fe7dbf99</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
