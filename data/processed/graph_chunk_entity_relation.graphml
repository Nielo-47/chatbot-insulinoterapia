<node id="Jejum">
  <data key="d0">Jejum</data>
  <data key="d1">concept</data>
  <data key="d2">Jejum refers to the fasting state, typically upon waking, when blood glucose should be between 70 and 130 mg/dL.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
