  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377572</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Acanthosis Nigricans">
  <data key="d7">1.0</data>
  <data key="d8">Acanthosis nigricans is a skin condition associated with insulin resistance, serving as a diabetes risk factor.</data>
  <data key="d9">risk factor</data>
