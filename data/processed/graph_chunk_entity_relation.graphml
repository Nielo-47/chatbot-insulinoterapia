  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Change of Injection Site">
  <data key="d7">2.0</data>
  <data key="d8">A sudden shift to an unaffected injection area can provoke hypoglycemia.&lt;SEP&gt;Switching to a non‑affected injection site has been reported to cause hypoglycemia.</data>
  <data key="d9">adverse effect,cause,effect,injection alteration</data>
  <data key="d10">chunk-14772c7de5db762c492a75a1c744dae6&lt;SEP&gt;chunk-8ac99e7359716e2cecc2ec93159218b6</data>
