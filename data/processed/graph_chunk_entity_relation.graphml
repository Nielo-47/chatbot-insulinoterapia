</node>
<node id="Consultation">
  <data key="d0">Consultation</data>
  <data key="d1">event</data>
  <data key="d2">A consultation is a medical appointment where the rotation plan may be reviewed and adapted.</data>
  <data key="d3">chunk-191286ebd759321d40620f77c84ef5a0</data>
