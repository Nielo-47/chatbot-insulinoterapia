</node>
<node id="Signs">
  <data key="d0">Signs</data>
  <data key="d1">concept</data>
  <data key="d2">Signs are observable indicators like pallor and rapid heartbeat associated with low blood glucose.</data>
  <data key="d3">chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
