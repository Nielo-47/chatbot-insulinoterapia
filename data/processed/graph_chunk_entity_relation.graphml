  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Household Refrigerator">
  <data key="d8">1.0</data>
  <data key="d9">Household refrigerators should store insulin between 2 and 8°C, placed on middle or lower shelves or in the vegetable drawer, away from walls.</data>
  <data key="d10">refrigeration guidelines,safe placement</data>
  <data key="d11">chunk-11ac81b4dee4dbb3636b8dc2403e0661</data>
