  <data key="d5">1778707385</data>
  <data key="d6"></data>
</node>
<node id="High Sg Settings">
  <data key="d0">High Sg Settings</data>
  <data key="d1">concept</data>
  <data key="d2">High SG settings are user-defined thresholds in the insulin pump that trigger alerts or actions when blood sugar levels are too high.</data>
  <data key="d3">chunk-f608f07eae4ddd5409aed9d4ecef75ad</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1778707385</data>
  <data key="d6"></data>
</node>
<node id="Low Sg Settings">
  <data key="d0">Low Sg Settings</data>
  <data key="d1">concept</data>
  <data key="d2">Low SG settings are user-defined thresholds in the insulin pump that trigger alerts or actions when blood sugar levels are too low.</data>
  <data key="d3">chunk-f608f07eae4ddd5409aed9d4ecef75ad</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1778707386</data>
  <data key="d6"></data>
</node>
<node id="Bg Target">
  <data key="d0">Bg Target</data>
  <data key="d1">concept</data>
  <data key="d2">BG target is a user-defined blood glucose level that the insulin pump aims to achieve and maintain.&lt;SEP&gt;A target blood glucose level set by a healthcare professional, used by the Bolus Wizard to determine correction doses.</data>
  <data key="d3">chunk-f608f07eae4ddd5409aed9d4ecef75ad&lt;SEP&gt;chunk-73b840edccb54a2c256450df95d80f4f</data>
