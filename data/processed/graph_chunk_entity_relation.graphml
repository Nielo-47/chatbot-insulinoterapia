  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Suspend Infusion">
  <data key="d7">1.0</data>
  <data key="d8">The Suspend Infusion method stops all insulin flow from the insulin pump.</data>
  <data key="d9">function,insulin delivery</data>
  <data key="d10">chunk-3d24fce6aa8866fb4a11514ae0e4d675</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d12">1786325628</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Resume Infusion">
  <data key="d7">1.0</data>
  <data key="d8">The Resume Infusion method restarts insulin delivery from the insulin pump after a manual suspension.</data>
  <data key="d9">function,insulin delivery</data>
  <data key="d10">chunk-3d24fce6aa8866fb4a11514ae0e4d675</data>
