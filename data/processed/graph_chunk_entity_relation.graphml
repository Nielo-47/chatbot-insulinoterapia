</edge>
<edge source="Insulin Glargine" target="Adipose Tissue">
  <data key="d7">2.0</data>
  <data key="d8">Insulin glargine stimulates glucose uptake in adipose tissue, facilitating peripheral glucose utilization.&lt;SEP&gt;Insulin glargine inhibits lipolysis in adipose tissue, reducing breakdown of fat stores.</data>
  <data key="d9">glucose uptake,inhibition,lipolysis,stimulation</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d12">1786313745</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Skeletal Muscle">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargine stimulates glucose uptake in skeletal muscle, enhancing peripheral glucose clearance.</data>
  <data key="d9">glucose uptake,stimulation</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d12">1786313746</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Liver">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargine suppresses hepatic glucose production in the liver, lowering endogenous glucose output.</data>
  <data key="d9">hepatic glucose production,inhibition</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
