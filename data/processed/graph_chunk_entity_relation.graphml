  <data key="d5">1778709734</data>
  <data key="d6"></data>
  <data key="d7">Capillary Blood Glucose Monitoring</data>
</node>
<node id="Genetic Blood Disorders">
  <data key="d0">Genetic Blood Disorders</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic blood disorders are inherited conditions affecting blood composition that can lead to misleading HbA1c results.</data>
