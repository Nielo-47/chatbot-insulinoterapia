  <data key="d13">1778702910</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina" target="Car">
  <data key="d8">1.0</data>
  <data key="d9">Leaving insulin inside a car, especially in hot conditions, can alter its effect due to excessive heat.</data>
  <data key="d10">storage hazard,temperature risk</data>
  <data key="d11">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
  <data key="d12">data/raw/Documento sem título.docx</data>
  <data key="d13">1778694989</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina" target="Fogão">
  <data key="d8">1.0</data>
  <data key="d9">Keeping insulin near the fogão (stove) exposes it to heat, which may cause it to lose effectiveness.</data>
  <data key="d10">storage hazard,temperature risk</data>
  <data key="d11">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
  <data key="d12">data/raw/Documento sem título.docx</data>
  <data key="d13">1778694989</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina" target="Sol">
  <data key="d8">1.0</data>
  <data key="d9">Exposing insulin to sol (sunlight) can degrade the medication and reduce its therapeutic effect.</data>
  <data key="d10">storage hazard,temperature risk</data>
  <data key="d11">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
  <data key="d12">data/raw/Documento sem título.docx</data>
  <data key="d13">1778694990</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina" target="Caneta Descartável">
  <data key="d8">1.0</data>
  <data key="d9">The disposable insulin pen comes with insulin already inside and is discarded after the insulin is used up.</data>
