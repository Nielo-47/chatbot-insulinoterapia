  <data key="d5">1786333258</data>
  <data key="d6"></data>
</node>
<node id="Hipoglicemia Alert">
  <data key="d0">Hipoglicemia Alert</data>
  <data key="d1">concept</data>
  <data key="d2">Hipoglicemia Alert is a warning signal emitted by certain insulin pumps to indicate low blood glucose levels.</data>
  <data key="d3">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330157</data>
  <data key="d6"></data>
</node>
<node id="Automatic Shutdown">
  <data key="d0">Automatic Shutdown</data>
  <data key="d1">concept</data>
  <data key="d2">Automatic Shutdown is a function of insulin pumps that turns off the device when necessary, such as during hypoglycemia.</data>
  <data key="d3">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330157</data>
  <data key="d6"></data>
</node>
<node id="Waterproofness">
  <data key="d0">Waterproofness</data>
  <data key="d1">concept</data>
  <data key="d2">Waterproofness denotes the ability of a device to resist water ingress; MiniMed® 640G is noted as water‑proof unlike other pumps.</data>
  <data key="d3">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330158</data>
  <data key="d6"></data>
</node>
<node id="Bolus De Correção">
  <data key="d0">Bolus De Correção</data>
  <data key="d1">concept</data>
  <data key="d2">The insulin amount calculated to lower blood glucose when it is above the pre‑prandial target, using a software algorithm.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330158</data>
  <data key="d6"></data>
</node>
<node id="Bolus De Alimentação">
  <data key="d0">Bolus De Alimentação</data>
  <data key="d1">concept</data>
  <data key="d2">The total insulin needed to cover the carbohydrates of an upcoming meal.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330158</data>
  <data key="d6"></data>
</node>
<node id="Fator De Sensibilidade">
  <data key="d0">Fator De Sensibilidade</data>
  <data key="d1">concept</data>
  <data key="d2">A factor that quantifies how much one unit of insulin reduces blood glucose, employed in dose calculations.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330158</data>
  <data key="d6"></data>
</node>
<node id="Relação Insulina/Carboidrato">
  <data key="d0">Relação Insulina/Carboidrato</data>
  <data key="d1">concept</data>
  <data key="d2">The ratio that relates grams of carbohydrate to units of insulin needed for coverage.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330158</data>
  <data key="d6"></data>
</node>
<node id="Quantidade De Carboidrato Ingerida">
  <data key="d0">Quantidade De Carboidrato Ingerida</data>
  <data key="d1">data</data>
  <data key="d2">The measured amount of carbohydrate consumed, input for the meal‑bolus calculation.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330159</data>
  <data key="d6"></data>
</node>
<node id="Glicemia No Momento Do Cálculo">
  <data key="d0">Glicemia No Momento Do Cálculo</data>
  <data key="d1">data</data>
  <data key="d2">The current blood glucose reading taken at the time of dose calculation.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330159</data>
  <data key="d6"></data>
</node>
<node id="Insulina Ativa">
  <data key="d0">Insulina Ativa</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin that is presently biologically active in the bloodstream.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330159</data>
  <data key="d6"></data>
</node>
<node id="Eventos De Saúde">
  <data key="d0">Eventos De Saúde</data>
  <data key="d1">concept</data>
  <data key="d2">Health events such as pre‑menstrual disorder, exercise, illness, or stress that affect insulin requirements.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330159</data>
  <data key="d6"></data>
</node>
<node id="Dose Total Diária De Insulina (DTD)">
  <data key="d0">Dose Total Diária De Insulina (DTD)</data>
  <data key="d1">concept</data>
  <data key="d2">The total amount of insulin to be delivered over 24 hours, divided between basal and bolus portions.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330159</data>
  <data key="d6"></data>
</node>
<node id="Software De Bomba">
  <data key="d0">Software De Bomba</data>
  <data key="d1">artifact</data>
  <data key="d2">The embedded computer program in the infusion pump that sums variables to calculate bolus doses.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330159</data>
  <data key="d6"></data>
</node>
<node id="Patient With Type 1 Diabetes">
  <data key="d0">Patient With Type 1 Diabetes</data>
  <data key="d1">person</data>
  <data key="d2">Individuals diagnosed with type 1 diabetes who must monitor glucose multiple times daily and may use an insulin pump.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330160</data>
  <data key="d6"></data>
</node>
<node id="Programação Da Dose Total De Insulina">
  <data key="d0">Programação Da Dose Total De Insulina</data>
  <data key="d1">method</data>
  <data key="d2">The process of setting the daily total insulin dose in the pump, allocating portions to basal and bolus.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330161</data>
  <data key="d6"></data>
</node>
