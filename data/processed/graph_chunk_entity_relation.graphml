  <data key="d14"></data>
</edge>
<edge source="GS" target="Cetoacidosis Diabetica">
  <data key="d8">1.0</data>
  <data key="d9">A GS value above 250 mg/dL may indicate risk of cetoacidosis diabetica, prompting user action.</data>
