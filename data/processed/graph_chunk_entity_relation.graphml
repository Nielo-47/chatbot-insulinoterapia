  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694532</data>
  <data key="d14"></data>
</edge>
<edge source="Aplicação De Insulina" target="Álcool 70%">
  <data key="d8">1.0</data>
  <data key="d9">O álcool 70% é usado para limpar o local de aplicação e o acoplamento da agulha antes da injeção.</data>
  <data key="d10">hygiene,site preparation</data>
  <data key="d11">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694532</data>
  <data key="d14"></data>
</edge>
<edge source="Aplicação De Insulina" target="Algodão">
  <data key="d8">1.0</data>
  <data key="d9">O algodão é usado para comprimir o local da aplicação por cinco segundos após a retirada da agulha.</data>
  <data key="d10">compression,post-injection care</data>
