  <data key="d5">1778707442</data>
  <data key="d6"></data>
</node>
<node id="Medical Emergency Card">
  <data key="d0">Medical Emergency Card</data>
  <data key="d1">artifact</data>
  <data key="d2">A medical emergency card is a printed document that provides critical health information, such as having diabetes and using an insulin pump, to assist during travel or emergencies.&lt;SEP&gt;A medical emergency card contains critical health information and should be printed and carried by individuals with diabetes who use insulin pumps.&lt;SEP&gt;The Medical Emergency Card contains critical information about airport security systems and safe pump use during air travel.</data>
  <data key="d3">chunk-f9bc8ba4b622225a9f3f1bb8a9d4fb21&lt;SEP&gt;chunk-a1faf2db5ce0667a0d479a8832c2bc8d&lt;SEP&gt;chunk-a4f0986d34b7b73e98fe14c73abfb6f3</data>
