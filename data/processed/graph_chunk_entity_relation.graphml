  <data key="d13">1778702709</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Liquidos Sin Azucar">
  <data key="d8">1.0</data>
  <data key="d9">The patient should consume sugar-free liquids to prevent dehydration without increasing blood glucose.</data>
  <data key="d10">hydration,illness management</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702711</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Liquidos Que Contienen Azucar">
  <data key="d8">1.0</data>
  <data key="d9">The patient may use sugary liquids to maintain caloric intake when unable to eat solid food.</data>
  <data key="d10">calorie intake,illness nutrition</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
