  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Betabloqueadores Não Seletivos">
  <data key="d7">1.0</data>
  <data key="d8">Non‑selective beta blockers can mask the symptoms of hypoglycemia and delay recovery.</data>
  <data key="d9">masking,symptom concealment</data>
