  <data key="d13">1778708145</data>
  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="Pump">
  <data key="d8">1.0</data>
  <data key="d9">The pump delivers Dual Wave boluses, which can be interrupted and resumed if within the ten-minute recovery window.</data>
  <data key="d10">dose delivery,partial delivery</data>
