<node id="Human Insulin 50/50 Mixture">
  <data key="d0">Human Insulin 50/50 Mixture</data>
  <data key="d1">artifact</data>
  <data key="d2">The Human Insulin 50/50 mixture is a comparator formulation containing equal parts regular human insulin and NPH insulin used in the clinical study.</data>
  <data key="d3">chunk-7084240a735ca2fe3b6d426e3b8c5756</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310731</data>
  <data key="d6"></data>
</node>
<node id="Human Insulin 70/30 Mixture">
  <data key="d0">Human Insulin 70/30 Mixture</data>
  <data key="d1">artifact</data>
  <data key="d2">The Human Insulin 70/30 mixture is a comparator formulation containing 70% NPH insulin and 30% regular human insulin used in the clinical study.</data>
  <data key="d3">chunk-7084240a735ca2fe3b6d426e3b8c5756</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310731</data>
  <data key="d6"></data>
</node>
<node id="Night Hypoglycemia">
  <data key="d0">Night Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Night hypoglycemia denotes episodes of low blood glucose occurring during sleep, monitored in the study.&lt;SEP&gt;Episodes of low blood glucose occurring during the night.</data>
  <data key="d3">chunk-7084240a735ca2fe3b6d426e3b8c5756&lt;SEP&gt;chunk-5c804699375feba4c866cc3a1bc00211</data>
