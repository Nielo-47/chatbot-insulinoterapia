  <data key="d14"></data>
</edge>
<edge source="Carpule" target="Novolin® R Penfill">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill is supplied in a carpule, a cartridge designed for use with insulin pens.</data>
