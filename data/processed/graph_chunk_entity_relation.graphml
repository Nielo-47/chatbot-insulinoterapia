  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Equipo Medico">
  <data key="d8">1.0</data>
  <data key="d9">The patient is advised to report symptoms and test results to their medical team for proper management during illness.</data>
  <data key="d10">medical communication,treatment oversight</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702696</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Supervision De Glucosa En Sangre">
  <data key="d8">1.0</data>
  <data key="d9">The patient is required to check blood glucose every two hours during illness to maintain control and prevent complications.</data>
  <data key="d10">blood glucose monitoring,illness management</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702707</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Analisis De Cuerpos Cetonico">
  <data key="d8">1.0</data>
  <data key="d9">The patient should test for ketone bodies frequently during illness to assess the risk of developing diabetic ketoacidosis.</data>
  <data key="d10">ketone testing,risk assessment</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
