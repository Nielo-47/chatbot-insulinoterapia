</edge>
<edge source="Square Wave Bolus" target="Pump">
  <data key="d8">1.0</data>
  <data key="d9">The pump administers Square Wave boluses as extended insulin doses that can be resumed after interruption.</data>
  <data key="d10">dose delivery,extended delivery</data>
