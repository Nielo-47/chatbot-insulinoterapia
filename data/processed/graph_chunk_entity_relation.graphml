  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1778704182</data>
  <data key="d6"></data>
</node>
<node id="Target Blood Glucose">
  <data key="d0">Target Blood Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Target Blood Glucose is the desired blood glucose level to achieve, defined by high and low values (Ba-Al) in mg/dL.</data>
