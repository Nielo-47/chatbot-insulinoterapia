</edge>
<edge source="Subcutaneous Injection" target="Novolin® R Penfill">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill is administered via subcutaneous injection into areas like the abdomen, thigh, or deltoid.</data>
  <data key="d10">administration route,delivery method</data>
  <data key="d11">chunk-98a0b8b861ae9af417a572907fe16408</data>
