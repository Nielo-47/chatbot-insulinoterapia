</node>
<node id="Dr. Banting">
  <data key="d0">Dr. Banting</data>
  <data key="d1">person</data>
  <data key="d2">Dr. Banting is a researcher who led early insulin experiments, performing pancreatectomies and administering pancreatic extracts to dogs.</data>
  <data key="d3">chunk-9c2889fe850f241cf3ebb528da2adbb1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
