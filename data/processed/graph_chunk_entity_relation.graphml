</edge>
<edge source="Insulin Flow" target="Application Button">
  <data key="d7">2.0</data>
  <data key="d8">The Application Button is held while insulin flows through the needle.&lt;SEP&gt;Pressing the application button starts the insulin flow through the needle.</data>
  <data key="d9">delivery,initiation,operation</data>
  <data key="d10">chunk-f0710d91bd443ae1af3fd98049f4ad42&lt;SEP&gt;chunk-dd25c8bd4672601d6ee40e4b7e28a69c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d12">1786316206</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Flow" target="Insulin Drop">
  <data key="d7">1.0</data>
  <data key="d8">A visible insulin drop confirms that insulin flow is correct.</data>
  <data key="d9">confirmation,verification</data>
  <data key="d10">chunk-f0710d91bd443ae1af3fd98049f4ad42</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d12">1786316208</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Flow" target="Clogged Needle">
  <data key="d7">1.0</data>
  <data key="d8">When the needle is clogged, insulin flow does not appear as a drop at the tip, indicating a delivery problem.</data>
  <data key="d9">obstruction,verification</data>
  <data key="d10">chunk-dd25c8bd4672601d6ee40e4b7e28a69c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d12">1786316273</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Flow" target="Damaged Needle">
  <data key="d7">1.0</data>
  <data key="d8">A damaged needle can also prevent insulin flow, leading to the absence of a visible drop at the needle tip.</data>
  <data key="d9">damage,verification</data>
  <data key="d10">chunk-dd25c8bd4672601d6ee40e4b7e28a69c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d12">1786316274</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Flow" target="Flow Blocked Alarm">
  <data key="d7">1.0</data>
  <data key="d8">The Flow Blocked Alarm indicates obstruction in the insulin flow pathway.</data>
  <data key="d9">alarm for</data>
  <data key="d10">chunk-db8e2f5011e0e0fe7dc11273e2f345b9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329873</data>
  <data key="d13"></data>
</edge>
<edge source="Continuous Glucose Monitoring (CGM)" target="Lag Time">
  <data key="d7">1.0</data>
  <data key="d8">CGM readings exhibit a lag time of roughly ten minutes compared with finger‑prick blood measurements.</data>
  <data key="d9">characteristic,delay</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299898</data>
  <data key="d13"></data>
</edge>
<edge source="Continuous Glucose Monitoring (CGM)" target="Diabetes Treatment Goals">
  <data key="d7">1.0</data>
  <data key="d8">CGM provides data that helps patients and clinicians meet individualized diabetes treatment goals.</data>
  <data key="d9">goal‑achievement,support</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299899</data>
  <data key="d13"></data>
</edge>
<edge source="Continuous Glucose Monitoring (CGM)" target="Frequent Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">CGM is especially useful for individuals experiencing frequent hypoglycemia by offering early warnings.</data>
  <data key="d9">benefit,management</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299899</data>
  <data key="d13"></data>
</edge>
<edge source="Continuous Glucose Monitoring (CGM)" target="Asymptomatic Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">CGM detects asymptomatic hypoglycemia events that the user may not feel.</data>
  <data key="d9">benefit,detection</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299900</data>
  <data key="d13"></data>
</edge>
<edge source="Continuous Glucose Monitoring (CGM)" target="Hydroxyurea (Hydroxycarbamide)">
  <data key="d7">1.0</data>
  <data key="d8">Hydroxyurea use can cause inaccurate sensor glucose readings and risk of hypoglycemia when using CGM.</data>
  <data key="d9">interferes with,warning</data>
