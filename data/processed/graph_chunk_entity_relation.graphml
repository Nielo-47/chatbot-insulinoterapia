  <data key="d6"></data>
</node>
<node id="Vial of Rapid-Acting U-100 Insulin">
  <data key="d0">Vial of Rapid-Acting U-100 Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">The vial of rapid-acting U-100 insulin contains insulin that can be loaded into the pump.</data>
  <data key="d3">chunk-a0267d2986a48c4c31790b6f183277dc</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329594</data>
  <data key="d6"></data>
</node>
<node id="MiniMed or Medtronic Reservoir">
  <data key="d0">MiniMed or Medtronic Reservoir</data>
  <data key="d1">artifact</data>
  <data key="d2">MiniMed or Medtronic reservoir is a compatible insulin reservoir for the pump.</data>
  <data key="d3">chunk-a0267d2986a48c4c31790b6f183277dc</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
