  <data key="d5">1786377377</data>
  <data key="d6"></data>
</node>
<node id="Standards of Care in Diabetes">
  <data key="d0">Standards of Care in Diabetes</data>
  <data key="d1">content</data>
  <data key="d2">Clinical practice recommendations published by the ADA that outline components of diabetes care, treatment goals, and quality‑of‑care tools.&lt;SEP&gt;Standards of Care in Diabetes is a set of clinical practice recommendations published by the American Diabetes Association.</data>
  <data key="d3">chunk-e4c5ae163a494feafedb71ed2205c02f&lt;SEP&gt;chunk-b9fe6f17fdb504b9177e8ebc48505716</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372132</data>
  <data key="d6"></data>
</node>
