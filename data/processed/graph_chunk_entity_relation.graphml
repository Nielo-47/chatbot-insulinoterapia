  <data key="d6"></data>
</node>
<node id="Prática E Intensidade De Exercícios">
  <data key="d0">Prática E Intensidade De Exercícios</data>
  <data key="d1">concept</data>
  <data key="d2">Exercise practice and intensity, health events influencing insulin needs.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330162</data>
  <data key="d6"></data>
</node>
<node id="Artificial Pancreas">
  <data key="d0">Artificial Pancreas</data>
  <data key="d1">concept</data>
  <data key="d2">Artificial Pancreas refers to a closed‑circuit insulin pump system that mimics pancreatic function for people with diabetes.&lt;SEP&gt;A technology integrating continuous glucose monitoring with automated insulin delivery to manage diabetes.&lt;SEP&gt;The artificial pancreas is an automated insulin delivery system that integrates a continuous glucose monitor with an insulin pump to regulate blood glucose levels.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34&lt;SEP&gt;chunk-f35eed8b49aa0b698012777f6ec96ce5&lt;SEP&gt;chunk-a414fa1274ab6f8e05af931a0c52be4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335950</data>
  <data key="d6"></data>
</node>
<node id="Closed Loop System">
  <data key="d0">Closed Loop System</data>
  <data key="d1">method</data>
  <data key="d2">Closed Loop System (close loop) is a control method for insulin delivery that does not require calibrations or meal announcements, aiming to reduce long‑term complications.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330162</data>
  <data key="d6"></data>
</node>
<node id="Low‑Glucose Suspension Pump">
  <data key="d0">Low‑Glucose Suspension Pump</data>
  <data key="d1">artifact</data>
  <data key="d2">Low‑Glucose Suspension Pump automatically suspends insulin delivery for up to two hours when glucose values fall below a predefined threshold.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330162</data>
  <data key="d6"></data>
</node>
<node id="Predictive Low‑Glucose Suspension Pump">
  <data key="d0">Predictive Low‑Glucose Suspension Pump</data>
  <data key="d1">artifact</data>
  <data key="d2">Predictive Low‑Glucose Suspension Pump anticipates glucose drops and proactively suspends insulin administration.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330162</data>
  <data key="d6"></data>
</node>
<node id="Hybrid Closed Loop Pump">
  <data key="d0">Hybrid Closed Loop Pump</data>
  <data key="d1">artifact</data>
  <data key="d2">Hybrid Closed Loop Pump integrates real‑time insulin and glucose data with automated basal modulation while requiring manual meal bolus.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330163</data>
  <data key="d6"></data>
</node>
<node id="Fully Closed Loop Pump">
  <data key="d0">Fully Closed Loop Pump</data>
  <data key="d1">artifact</data>
  <data key="d2">Fully Closed Loop Pump provides fully automated insulin delivery without the need for manual meal bolus.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330163</data>
  <data key="d6"></data>
</node>
<node id="Continuous Insulin Infusion System (SICI)">
  <data key="d0">Continuous Insulin Infusion System (SICI)</data>
  <data key="d1">artifact</data>
  <data key="d2">Continuous Insulin Infusion System (SICI) integrates an insulin infusion pump with a skin‑adhesive catheter to deliver insulin continuously.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330163</data>
  <data key="d6"></data>
</node>
<node id="Insulin Patch Pump">
  <data key="d0">Insulin Patch Pump</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin Patch Pump is a wearable, disposable insulin pump that adheres to the skin and offers low‑cost, discreet insulin delivery.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330163</data>
  <data key="d6"></data>
</node>
<node id="Accu‑Chek Solo">
  <data key="d0">Accu‑Chek Solo</data>
  <data key="d1">artifact</data>
  <data key="d2">Accu‑Chek Solo is a patch‑type insulin pump with a four‑month lifespan, a 200‑unit insulin reservoir, and replacement components every 2–3 days.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
