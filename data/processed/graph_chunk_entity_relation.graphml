  <data key="d0">HGPRT</data>
  <data key="d1">method</data>
  <data key="d2">HGPRT is an in‑vitro mammalian cell mutation assay applied to insulin glargina.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
