  <data key="d12">1786377558</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Prediabetes">
  <data key="d7">2.0</data>
  <data key="d8">A1C is used as a diagnostic test to identify prediabetes.&lt;SEP&gt;An A1C level of 5.7%–6.4% defines prediabetes according to the guidelines.</data>
  <data key="d9">diagnostic range,diagnostic test,screening</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0&lt;SEP&gt;chunk-2a430bf53157529ccb22e67171fb28e5</data>
