</node>
<node id="Wireless Pairing">
  <data key="d0">Wireless Pairing</data>
  <data key="d1">method</data>
  <data key="d2">Wireless pairing is the process of connecting the Accu-Chek Guide Link meter to the MiniMed 770G pump for automatic data transmission.</data>
  <data key="d3">chunk-641adeabab10205d29d07a0c3e82f2e2</data>
