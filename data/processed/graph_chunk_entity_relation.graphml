  <data key="d0">F. G Banting</data>
  <data key="d1">person</data>
  <data key="d2">F. G Banting is a researcher who conducted insulin-related experiments on dogs and corresponded with Macleod.</data>
  <data key="d3">chunk-eff48c1408719e81f1f423f76dfd19e5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332063</data>
  <data key="d6"></data>
</node>
<node id="Mr. Best">
  <data key="d0">Mr. Best</data>
  <data key="d1">person</data>
  <data key="d2">Mr. Best is a collaborator of Banting who assisted in operations, taught chemistry, and worked closely on the experiments.</data>
  <data key="d3">chunk-eff48c1408719e81f1f423f76dfd19e5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332063</data>
  <data key="d6"></data>
</node>
<node id="Macleod">
  <data key="d0">Macleod</data>
  <data key="d1">person</data>
  <data key="d2">Macleod was the professor at the University of Toronto who received Banting’s 9 August 1921 letter reporting experimental results.&lt;SEP&gt;Macleod is a senior scientist who received Banting’s letter and provided cautious advice on the experimental results.</data>
  <data key="d3">chunk-eff48c1408719e81f1f423f76dfd19e5&lt;SEP&gt;chunk-172719b5694ed1fb8003b6874395d641</data>
