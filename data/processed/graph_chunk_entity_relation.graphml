  <data key="d12">1786377571</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Posttransplantation Diabetes Mellitus (PTDM)">
  <data key="d7">1.0</data>
  <data key="d8">A1C screening can identify high‑risk individuals for PTDM.</data>
