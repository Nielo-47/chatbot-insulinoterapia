  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702651</data>
  <data key="d14"></data>
</edge>
<edge source="Correction Bolus" target="Glucose Target">
  <data key="d8">1.0</data>
  <data key="d9">Glucose target is the desired level used to calculate the difference that the correction bolus must address.</data>
