  <data key="d5">1786335921</data>
  <data key="d6"></data>
</node>
<node id="Músculos">
  <data key="d0">Músculos</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Músculos are muscle tissues that store glucose for later energy use.&lt;SEP&gt;Muscle tissue that stores glycogen and utilizes glucose during the initial phase of exercise.</data>
  <data key="d3">chunk-50d9a787da93a3bf7ea1e315273b560c&lt;SEP&gt;chunk-7cbaec668e54aa5cf462a7bd08d7813c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324188</data>
  <data key="d6"></data>
</node>
<node id="Energía">
  <data key="d0">Energía</data>
  <data key="d1">concept</data>
  <data key="d2">Energía is the cellular energy derived from the metabolism of glucose.</data>
  <data key="d3">chunk-50d9a787da93a3bf7ea1e315273b560c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324188</data>
  <data key="d6"></data>
</node>
<node id="Tubo Digestivo">
  <data key="d0">Tubo Digestivo</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Tubo Digestivo is the digestive tract through which glucose is absorbed into the bloodstream.</data>
  <data key="d3">chunk-50d9a787da93a3bf7ea1e315273b560c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324188</data>
  <data key="d6"></data>
</node>
<node id="Pared Celular">
  <data key="d0">Pared Celular</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pared Celular is the cell membrane that insulin binds to, enabling glucose entry into the cell.</data>
  <data key="d3">chunk-50d9a787da93a3bf7ea1e315273b560c</data>
