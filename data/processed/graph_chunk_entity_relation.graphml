<edge source="Home Screen" target="Easy Bolus Feature">
  <data key="d8">1.0</data>
  <data key="d9">The Easy Bolus feature is accessed through the Home Screen via Device Settings.</data>
  <data key="d10">menu access,navigation path</data>
