  <data key="d7">2.0</data>
  <data key="d8">The alarm also appears on the Bolus screen during the reset event.&lt;SEP&gt;The alarm also appears on Bolus screens until the time shown.</data>
  <data key="d9">display,notification</data>
  <data key="d10">chunk-a01dc8dc15b92e2b0b570753b0f57632&lt;SEP&gt;chunk-f94cd06ab0d1bcc7a9349bc40ea3eb22</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330098</data>
  <data key="d13"></data>
</edge>
<edge source="Bolus Screen" target="Active Insulin Reminder Message">
  <data key="d7">1.0</data>
  <data key="d8">The Active Insulin Reminder Message also appears on the Bolus screen until the time shown.</data>
  <data key="d9">display,notification</data>
  <data key="d10">chunk-f94cd06ab0d1bcc7a9349bc40ea3eb22</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330315</data>
  <data key="d13"></data>
</edge>
<edge source="Auto Correction Feature" target="SmartGuard Feature">
  <data key="d7">1.0</data>
  <data key="d8">Auto Correction Feature is part of SmartGuard and is turned on by default to deliver correction boluses.</data>
  <data key="d9">automation,sub‑feature</data>
  <data key="d10">chunk-b48243f8e773d3c94abc58e2314db2c0</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329923</data>
  <data key="d13"></data>
</edge>
<edge source="SmartGuard Max Delivery Alert" target="SmartGuard Checklist">
  <data key="d7">1.0</data>
  <data key="d8">The max delivery alert advises checking the SmartGuard Checklist to determine the required steps.</data>
  <data key="d9">guidance,reference</data>
  <data key="d10">chunk-05241912c4f8f5e79ae75071a1c7c604</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329757</data>
  <data key="d13"></data>
</edge>
<edge source="SmartGuard Max Delivery Alert" target="SmartGuard Feature">
  <data key="d7">1.0</data>
  <data key="d8">When the SmartGuard Feature reaches its maximum insulin delivery, a SmartGuard Max Delivery Alert appears.</data>
  <data key="d9">alert,notification</data>
  <data key="d10">chunk-d4d222786e6ed163a90874659266c72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330176</data>
  <data key="d13"></data>
</edge>
<edge source="Enter BG Now Alert" target="SmartGuard Feature">
  <data key="d7">2.0</data>
  <data key="d8">When a blood glucose entry is needed, the SmartGuard Feature displays an Enter BG Now Alert.&lt;SEP&gt;SmartGuard feature generates the Enter BG Now alert when it has been at maximum delivery rate for several hours.</data>
  <data key="d9">alert,condition,max delivery,user action</data>
  <data key="d10">chunk-3d0824c9d8a9ff5f2da52b7b5ea69c86&lt;SEP&gt;chunk-d4d222786e6ed163a90874659266c72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330022</data>
  <data key="d13"></data>
</edge>
<edge source="Enter BG Now Alert" target="Blood Glucose (BG)">
  <data key="d7">2.0</data>
  <data key="d8">The alert prompts entering a blood glucose value to resume or adjust SmartGuard delivery.&lt;SEP&gt;Enter BG Now Alert urges immediate entry of Blood Glucose (BG) values.</data>
  <data key="d9">alert,input,required reading,user action</data>
  <data key="d10">chunk-3d0824c9d8a9ff5f2da52b7b5ea69c86&lt;SEP&gt;chunk-a111edb31d6739acf013ce812b952366</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330026</data>
  <data key="d13"></data>
</edge>
<edge source="Enter BG Now Alert" target="Auto Basal">
  <data key="d7">1.0</data>
  <data key="d8">The Enter BG Now Alert prompts the user to input a blood glucose value, after which Auto Basal delivery resumes.</data>
  <data key="d9">basal resume,user action</data>
  <data key="d10">chunk-3d0824c9d8a9ff5f2da52b7b5ea69c86</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330027</data>
  <data key="d13"></data>
</edge>
<edge source="Enter BG Now Alert" target="Blood Glucose (BG) Meter Reading">
  <data key="d7">1.0</data>
  <data key="d8">Enter BG Now Alert prompts the user to provide a BG meter reading for verification.</data>
  <data key="d9">alert,user action</data>
  <data key="d10">chunk-8741750a7bf86eb5d1fadf82a9c7720e</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330319</data>
  <data key="d13"></data>
</edge>
<edge source="SG Readings" target="SmartGuard Feature">
  <data key="d7">1.0</data>
  <data key="d8">SmartGuard uses SG readings to calculate basal insulin delivery and correction boluses.</data>
  <data key="d9">calculation,glucose monitoring</data>
  <data key="d10">chunk-4a4a75301f61fc3c86ad768de09d0c3f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329761</data>
  <data key="d13"></data>
</edge>
<edge source="SG Readings" target="BG Meter">
  <data key="d7">1.0</data>
  <data key="d8">BG meter readings must be used to confirm SG values before treatment decisions.</data>
  <data key="d9">confirmation,verification</data>
  <data key="d10">chunk-4a4a75301f61fc3c86ad768de09d0c3f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329763</data>
  <data key="d13"></data>
</edge>
<edge source="SG Readings" target="Blood Glucose (BG)">
  <data key="d7">1.0</data>
  <data key="d8">SG readings may differ from blood glucose (BG) measurements, especially during early sensor use.</data>
  <data key="d9">difference</data>
  <data key="d10">chunk-4a4a75301f61fc3c86ad768de09d0c3f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329770</data>
  <data key="d13"></data>
</edge>
<edge source="SG Readings" target="First 12 Hours">
  <data key="d7">1.0</data>
  <data key="d8">During the first 12 hours of sensor use, SG readings should be interpreted with caution.</data>
  <data key="d9">caution period</data>
  <data key="d10">chunk-4a4a75301f61fc3c86ad768de09d0c3f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329771</data>
  <data key="d13"></data>
</edge>
<edge source="SG Readings" target="SmartGuard Technology">
  <data key="d7">1.0</data>
  <data key="d8">SmartGuard uses SG readings to calculate basal insulin delivery and correction boluses.</data>
  <data key="d9">usage</data>
  <data key="d10">chunk-9ec9cae555a06ac660e6c16d90116c8b</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330050</data>
  <data key="d13"></data>
</edge>
<edge source="SG Readings" target="Basal Rates">
  <data key="d7">1.0</data>
  <data key="d8">SG readings are used to adjust basal rates in SmartGuard mode.</data>
  <data key="d9">calculation</data>
  <data key="d10">chunk-9ec9cae555a06ac660e6c16d90116c8b</data>
