  <data key="d13">1778708143</data>
  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="Now Percentage">
  <data key="d8">1.0</data>
  <data key="d9">The Now Percentage determines the immediate portion of the Dual Wave bolus delivered at the start.</data>
  <data key="d10">dosage distribution,immediate delivery</data>
