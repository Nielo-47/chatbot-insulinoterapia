  <data key="d14"></data>
</edge>
<edge source="Cateter" target="Conjunto de Infusão">
  <data key="d8">1.0</data>
  <data key="d9">O cateter é parte do conjunto de infusão e conduz a insulina do reservatório até a cânula.</data>
  <data key="d10">componente,condução</data>
  <data key="d11">chunk-8792cad0fa7c0226f159b670b4e743a1</data>
