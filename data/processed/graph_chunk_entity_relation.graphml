  <data key="d13">1778708408</data>
  <data key="d14"></data>
</edge>
<edge source="SmartGuard Feature" target="Suspend By Sensor Icon">
  <data key="d8">1.0</data>
  <data key="d9">The Suspend By Sensor Icon is linked to the SmartGuard Feature's Suspend before low or Suspend on low functions.</data>
