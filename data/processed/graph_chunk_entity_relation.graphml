<edge source="Simplera Sync Sensor" target="Twenty-Minute Pairing Window">
  <data key="d8">1.0</data>
  <data key="d9">The Simplera Sync Sensor must be paired within 20 minutes of cap removal for security purposes.</data>
  <data key="d10">security,time constraint</data>
