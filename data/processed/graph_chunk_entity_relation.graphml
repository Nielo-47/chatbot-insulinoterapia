  <data key="d5">1786318476</data>
  <data key="d6"></data>
</node>
<node id="Congestive Heart Failure">
  <data key="d0">Congestive Heart Failure</data>
  <data key="d1">concept</data>
  <data key="d2">Congestive Heart Failure is a medical condition characterized by the heart's inability to pump blood effectively.&lt;SEP&gt;Congestive heart failure is a cardiac condition reported when tiazolidinediones are combined with insulin.&lt;SEP&gt;Congestive heart failure is a cardiac condition reported in patients receiving combined thiazolidinediones and insulin therapy.&lt;SEP&gt;A cardiac condition reported in patients receiving combined tiazolidinediones and insulin therapy, especially in those with risk factors.&lt;SEP&gt;Congestive Heart Failure is a cardiac condition that has been reported when tiazolidinediones are combined with insulin.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052&lt;SEP&gt;chunk-d10a1f849386df540104c79e33a7b242&lt;SEP&gt;chunk-9a6f9e10c0d4af5fff0338eb861f9c86&lt;SEP&gt;chunk-dd396c45bc09fb646d156b4e69d328e3&lt;SEP&gt;chunk-acaa1440ae268669e1894588bb9e37c2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1786318477</data>
  <data key="d6"></data>
</node>
<node id="Antinsulin Antibodies">
  <data key="d0">Antinsulin Antibodies</data>
  <data key="d1">concept</data>
  <data key="d2">Antinsulin Antibodies are immune proteins that can develop in response to insulin administration.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305918</data>
