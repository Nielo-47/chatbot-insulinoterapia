<node id="Manufacturer Recommendations">
  <data key="d0">Manufacturer Recommendations</data>
  <data key="d1">concept</data>
  <data key="d2">Manufacturer Recommendations are the guidelines provided by insulin producers regarding storage, handling, and transportation of insulin products.</data>
  <data key="d3">chunk-1b1b73e9b7285819a4ba5caa6fdfa785</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
