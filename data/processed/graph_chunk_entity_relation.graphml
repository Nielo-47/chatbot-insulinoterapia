</edge>
<edge source="Physical Activity" target="Humulin R">
  <data key="d8">1.0</data>
  <data key="d9">Changes in physical activity may necessitate adjustment in Humulin R dosage to maintain glycemic control.</data>
  <data key="d10">dosage adjustment,lifestyle factor</data>
