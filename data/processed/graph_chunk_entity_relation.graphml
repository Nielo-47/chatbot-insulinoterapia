  <data key="d1">organization</data>
  <data key="d2">Unidade Básica de Saúde is a basic health unit where collectors can be obtained for free and where used collectors are delivered.</data>
  <data key="d3">chunk-a48e1013c4a32aca64a00d073b2ee797</data>
