  <data key="d0">Poucas comorbidades crônicas</data>
  <data key="d1">concept</data>
  <data key="d2">Poucas comorbidades crônicas describes a state with few chronic comorbid diseases.</data>
  <data key="d3">chunk-9dee0a79e4583f41e757f9a20f56f397</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1786370018</data>
  <data key="d6"></data>
</node>
