  <data key="d1">method</data>
  <data key="d2">DAFNE (Dose Adjustment For Normal Eating) is a structured education program for flexible insulin therapy in type 1 diabetes.</data>
  <data key="d3">chunk-acba683ee0809d1c3f6e35c228f485ac</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372154</data>
