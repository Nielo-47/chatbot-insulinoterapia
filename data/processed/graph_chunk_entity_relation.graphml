  <data key="d3">chunk-d68acc5f59d78c14cf4d2e4d34edf5e4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329552</data>
  <data key="d6"></data>
</node>
<node id="Bolus Wizard Settings">
  <data key="d0">Bolus Wizard Settings</data>
  <data key="d1">artifact</data>
  <data key="d2">The set of user-defined parameters (carb ratio, insulin sensitivity factor, BG target, active insulin time) used by the Bolus Wizard Feature.&lt;SEP&gt;Bolus Wizard Settings are the four configurable parameters (Carb Ratio, Insulin Sensitivity Factor, BG Target Range, Active Insulin Time) used by the Bolus Wizard feature.&lt;SEP&gt;Bolus Wizard Settings allow configuration of insulin dosing parameters in manual mode.</data>
  <data key="d3">chunk-d68acc5f59d78c14cf4d2e4d34edf5e4&lt;SEP&gt;chunk-97eb00dc26d33c23bf8bf473c0a98472&lt;SEP&gt;chunk-ede0f32eb8f8ea1eaab76cc0bc7648fd</data>
