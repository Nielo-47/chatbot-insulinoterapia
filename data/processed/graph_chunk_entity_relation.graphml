  <data key="d5">1786372009</data>
  <data key="d6"></data>
</node>
<node id="Symptoms of Hyperglycemia">
  <data key="d0">Symptoms of Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Clinical manifestations such as polyuria, polydipsia, and unexplained weight loss indicative of high blood sugar.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372009</data>
  <data key="d6"></data>
</node>
<node id="Unexplained Weight Loss">
  <data key="d0">Unexplained Weight Loss</data>
  <data key="d1">concept</data>
  <data key="d2">Involuntary loss of body weight, a symptom associated with hyperglycemia.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372009</data>
  <data key="d6"></data>
</node>
<node id="Sensitivity">
  <data key="d0">Sensitivity</data>
  <data key="d1">concept</data>
  <data key="d2">Measure of a test’s ability to correctly identify true positive cases.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
