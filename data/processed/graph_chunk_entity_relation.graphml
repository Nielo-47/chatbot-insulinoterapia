</edge>
<edge source="Basal Rate Pattern" target="Multiple Basal Rate Settings">
  <data key="d8">1.0</data>
  <data key="d9">The basal rate pattern is configured using multiple basal rate settings to allow time-specific insulin delivery.</data>
  <data key="d10">programmable control,time-based adjustment</data>
  <data key="d11">chunk-113df8f96ec77242ec482c5116a12b1e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
