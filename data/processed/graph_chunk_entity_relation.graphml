<node id="Real-Time Continuous Glucose Monitoring C">
  <data key="d0">Real-Time Continuous Glucose Monitoring C</data>
  <data key="d1">artifact</data>
  <data key="d2">Real‑time continuous glucose monitoring C is a CGM device recommended for adults with diabetes on basal insulin.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335922</data>
