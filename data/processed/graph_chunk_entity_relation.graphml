  <data key="d6"></data>
</node>
<node id="Hemoglobin A1c Assay">
  <data key="d0">Hemoglobin A1c Assay</data>
  <data key="d1">method</data>
  <data key="d2">Hemoglobin A1c assay is a point‑of‑care test evaluated for accuracy in diabetes monitoring.\</data>
  <data key="d3">chunk-3a15ed0aa8749d4f76e8d725e8752873</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377417</data>
  <data key="d6"></data>
</node>
<node id="A1C Criteria">
  <data key="d0">A1C Criteria</data>
  <data key="d1">concept</data>
  <data key="d2">A1C criteria refer to hemoglobin A1c thresholds used to classify diabetes and prediabetes.\&lt;SEP&gt;Diagnostic threshold using glycated hemoglobin to identify diabetes and high‑risk individuals.</data>
  <data key="d3">chunk-3a15ed0aa8749d4f76e8d725e8752873&lt;SEP&gt;chunk-84032013252fd71963ed381e09a3116d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377417</data>
  <data key="d6"></data>
</node>
<node id="Underdiagnosis of Prediabetes">
  <data key="d0">Underdiagnosis of Prediabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Underdiagnosis of Prediabetes describes the missed identification of prediabetes when an OGTT is not performed.\</data>
  <data key="d3">chunk-3a15ed0aa8749d4f76e8d725e8752873</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="One-Step Screening Strategy">
  <data key="d0">One-Step Screening Strategy</data>
  <data key="d1">method</data>
  <data key="d2">A screening approach that uses a single oral glucose tolerance test (e.g., 75‑g OGTT) to diagnose GDM.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="Two-Step Screening Strategy">
  <data key="d0">Two-Step Screening Strategy</data>
  <data key="d1">method</data>
  <data key="d2">A screening approach that first uses a 1‑hour 50‑g glucose load test followed by a 3‑hour 100‑g OGTT for those who screen positive.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="1‑hour 50‑g GLT">
  <data key="d0">1‑hour 50‑g GLT</data>
  <data key="d1">method</data>
  <data key="d2">A 1‑hour 50‑gram glucose load test used as the initial screen in the two‑step strategy.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="3‑hour 100‑g OGTT">
  <data key="d0">3‑hour 100‑g OGTT</data>
  <data key="d1">method</data>
  <data key="d2">A 3‑hour 100‑gram oral glucose tolerance test performed after a positive GLT in the two‑step strategy.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="HAPO Follow‑up Study (HAPO FUS)">
  <data key="d0">HAPO Follow‑up Study (HAPO FUS)</data>
  <data key="d1">data</data>
  <data key="d2">A follow‑up study of the Hyperglycemia and Adverse Pregnancy Outcome cohort that links neonatal adiposity and fetal hyperinsulinemia to maternal hyperglycemia.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="Neonatal Adiposity">
  <data key="d0">Neonatal Adiposity</data>
  <data key="d1">concept</data>
  <data key="d2">Increased body fat in newborns, identified as a mediator of later childhood body fat.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="Fetal Hyperinsulinemia">
  <data key="d0">Fetal Hyperinsulinemia</data>
  <data key="d1">concept</data>
  <data key="d2">Elevated fetal insulin levels, measured by cord C‑peptide, associated with maternal hyperglycemia.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377418</data>
  <data key="d6"></data>
</node>
<node id="Childhood Body Fat">
  <data key="d0">Childhood Body Fat</data>
  <data key="d1">concept</data>
  <data key="d2">Increased adiposity in children, linked to neonatal adiposity and maternal hyperglycemia.</data>
  <data key="d3">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
