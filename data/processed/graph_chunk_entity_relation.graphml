<node id="Técnicas de aplicação de insulina">
  <data key="d0">Técnicas de aplicação de insulina</data>
  <data key="d1">content</data>
  <data key="d2">‘Técnicas de aplicação de insulina’ is the guideline document detailing insulin injection recommendations.</data>
  <data key="d3">chunk-26c5ab6d7b3b32c5f6aca2b58489782a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
