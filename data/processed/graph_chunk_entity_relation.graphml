  <data key="d14"></data>
</edge>
<edge source="American Diabetes Association" target="Hemoglobina A1C">
  <data key="d8">1.0</data>
  <data key="d9">La American Diabetes Association establece un objetivo de HbA1C &lt;7% como estándar de control glucémico.</data>
  <data key="d10">clinical guidelines,health standards</data>
