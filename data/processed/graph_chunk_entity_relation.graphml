  <data key="d0">Análogos Ultrarrápidos</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Análogos Ultrarrápidos are ultra‑rapid insulin analogs used in the continuous subcutaneous infusion.</data>
  <data key="d3">chunk-86f2f88ae14da4b0c5b7b883da36000d</data>
