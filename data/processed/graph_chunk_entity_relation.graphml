  <data key="d0">ASPIRE Trial</data>
  <data key="d1">event</data>
  <data key="d2">ASPIRE Trial is a clinical study of 247 participants with type 1 diabetes evaluating sensor‑augmented insulin pump therapy with low‑glucose‑suspend.</data>
  <data key="d3">chunk-9cd925790899146eeb8a373879b5feac</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
