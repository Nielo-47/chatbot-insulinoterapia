<node id="50 U Syringe">
  <data key="d0">50 U Syringe</data>
  <data key="d1">artifact</data>
  <data key="d2">50 U syringes, similarly graduated, provide precise dosing for low insulin requirements.</data>
  <data key="d3">chunk-26c5ab6d7b3b32c5f6aca2b58489782a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
