</node>
<node id="Toxicidade Crônica">
  <data key="d0">Toxicidade Crônica</data>
  <data key="d1">concept</data>
  <data key="d2">Toxicidade Crônica denotes the effects of repeated subcutaneous doses of insulin glargina over time.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
