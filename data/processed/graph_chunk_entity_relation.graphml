  <data key="d14"></data>
</edge>
<edge source="Basal Pattern" target="Pattern Editing">
  <data key="d8">2.0</data>
  <data key="d9">Users can edit the insulin delivery indices within a basal pattern to suit changing therapeutic needs.&lt;SEP&gt;Pattern editing allows users to modify an existing basal pattern by changing time segments or basal index values.</data>
