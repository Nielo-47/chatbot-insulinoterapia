  <data key="d13"></data>
</edge>
<edge source="A1C" target="G202A Variant">
  <data key="d7">1.0</data>
  <data key="d8">Carriage of the G202A variant is linked to A1C decreases of about 0.8 % in men and 0.7 % in women relative to non‑carriers.</data>
  <data key="d9">genetic effect,reduction</data>
  <data key="d10">chunk-ba0417a72f50cf7ca66c87a351bd1ff8</data>
