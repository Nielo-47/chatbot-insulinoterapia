</edge>
<edge source="Dual Wave Bolus" target="Square Wave">
  <data key="d8">1.0</data>
  <data key="d9">The Dual Wave bolus includes a Square Wave component that delivers insulin over time for delayed nutrient absorption.</data>
  <data key="d10">component,delivery method</data>
