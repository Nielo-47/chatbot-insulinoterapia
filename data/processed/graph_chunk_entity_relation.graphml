  <data key="d1">content</data>
  <data key="d2">All Sensor Alerts is an option to silence virtually all sensor alerts except certain mandatory ones.</data>
  <data key="d3">chunk-fd751b869edcd6c88d9e467cfb2cb0fd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329642</data>
  <data key="d6"></data>
</node>
<node id="Cancel Alert Silence">
  <data key="d0">Cancel Alert Silence</data>
  <data key="d1">artifact</data>
  <data key="d2">Cancel Alert Silence is the command used to stop an active alert silence period.</data>
  <data key="d3">chunk-fd751b869edcd6c88d9e467cfb2cb0fd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329643</data>
  <data key="d6"></data>
</node>
