  <data key="d6"></data>
</node>
<node id="Sharps Disposal Container">
  <data key="d0">Sharps Disposal Container</data>
  <data key="d1">artifact</data>
  <data key="d2">Sharps Disposal Container is a designated receptacle for discarding used syringes and needles.</data>
  <data key="d3">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
