</edge>
<edge source="Disglycemia" target="Internal Inflammation">
  <data key="d7">2.0</data>
  <data key="d8">Frequent glucose swings (disglycemia) trigger internal inflammatory responses.&lt;SEP&gt;Disglycemia causes Internal Inflammation.</data>
  <data key="d9">cause,causes</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd&lt;SEP&gt;chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d11">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1786336980</data>
  <data key="d13"></data>
</edge>
<edge source="Disglycemia" target="Vascular Damage">
  <data key="d7">2.0</data>
  <data key="d8">Disglycemia contributes to damage of blood vessels.&lt;SEP&gt;Disglycemia damages blood vessels, leading to Vascular Damage.</data>
  <data key="d9">cause,causes</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd&lt;SEP&gt;chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d11">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1786336980</data>
  <data key="d13"></data>
</edge>
<edge source="Disglycemia" target="Metabolic Memory">
  <data key="d7">2.0</data>
  <data key="d8">Oscillating blood glucose creates metabolic memory, preserving harmful cellular effects.&lt;SEP&gt;Disglycemia contributes to Metabolic Memory.</data>
  <data key="d9">cause,contributes to</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd&lt;SEP&gt;chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d11">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1786336981</data>
  <data key="d13"></data>
</edge>
<edge source="Disglycemia" target="Cell Function Changes">
  <data key="d7">1.0</data>
  <data key="d8">Disglycemia can change how cells function, including immune cells.</data>
  <data key="d9">alters</data>
  <data key="d10">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1786336981</data>
  <data key="d13"></data>
</edge>
<edge source="Disglycemia" target="Treatment of Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Treatment of Diabetes aims to prevent Disglycemia and its harmful effects.</data>
  <data key="d9">prevention</data>
  <data key="d10">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1786336995</data>
  <data key="d13"></data>
</edge>
<edge source="Disglycemia" target="Metabolic Memory Theory">
  <data key="d7">1.0</data>
  <data key="d8">Disglycemia is linked to the Metabolic Memory Theory, which posits lasting cellular effects from prior hyperglycemic states.</data>
  <data key="d9">association,mechanism</data>
  <data key="d10">chunk-2d8f17f3f250a37a1effaaa88cc8b382</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338564</data>
  <data key="d13"></data>
</edge>
<edge source="Disglycemia" target="RAGE Receptor">
  <data key="d7">1.0</data>
  <data key="d8">Advanced glycation end-products formed during Disglycemia bind to RAGE Receptors, initiating cellular responses.</data>
  <data key="d9">activation,signaling</data>
  <data key="d10">chunk-2d8f17f3f250a37a1effaaa88cc8b382</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338565</data>
  <data key="d13"></data>
</edge>
<edge source="Metabolic Memory" target="DCCT/EDIC">
  <data key="d7">1.0</data>
  <data key="d8">DCCT/EDIC demonstrated metabolic memory, a legacy effect.</data>
  <data key="d9">finding,research</data>
  <data key="d10">chunk-aff91698679a52cd7b07563b7b2627a3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d12">1786372371</data>
  <data key="d13"></data>
</edge>
<edge source="Metabolic Memory" target="UKPDS">
  <data key="d7">1.0</data>
  <data key="d8">UKPDS demonstrated metabolic memory, a legacy effect.</data>
  <data key="d9">finding,research</data>
