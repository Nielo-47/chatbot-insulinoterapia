  <data key="d12">1786313775</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Subcutaneous Injection">
  <data key="d7">1.0</data>
  <data key="d8">Subcutaneous injection of insulin can result in lipohypertrophy.</data>
  <data key="d9">adverse effect</data>
  <data key="d10">chunk-779af610d7298ce98490962cd90b4e76</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319801</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Fine Needle">
  <data key="d7">1.0</data>
  <data key="d8">Repeated use of the same injection spot with a fine needle can cause lipohypertrophy.</data>
  <data key="d9">cause,risk</data>
  <data key="d10">chunk-c7e6ef38db0b62d161b13473af47d738</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Documento sem título.docx</data>
  <data key="d12">1786330503</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Subcutaneous Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Subcutaneous insulin therapy may lead to lipohypertrophy at injection sites.</data>
  <data key="d9">adverse effect,injection</data>
  <data key="d10">chunk-8644d98286c4a296063176435b45d589</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/edelman-et-al-2026-dosing-afrezza-it-s-not-that-complicated.pdf</data>
