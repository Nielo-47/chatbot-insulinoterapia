<node id="Threshold Low Glucose Suspend (Algorithm)">
  <data key="d0">Threshold Low Glucose Suspend (Algorithm)</data>
  <data key="d1">method</data>
  <data key="d2">A safety algorithm that suspends insulin delivery when glucose falls below a low threshold.</data>
  <data key="d3">chunk-f35eed8b49aa0b698012777f6ec96ce5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335962</data>
  <data key="d6"></data>
</node>
<node id="Predictive Low‑Glucose Suspend (PLGS)">
  <data key="d0">Predictive Low‑Glucose Suspend (PLGS)</data>
  <data key="d1">method</data>
  <data key="d2">An algorithm that predicts impending hypoglycaemia and temporarily suspends insulin delivery.</data>
  <data key="d3">chunk-f35eed8b49aa0b698012777f6ec96ce5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335962</data>
  <data key="d6"></data>
</node>
