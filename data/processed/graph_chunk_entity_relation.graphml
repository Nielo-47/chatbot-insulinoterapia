  <data key="d0">Sensitivity 2/4 Screen</data>
  <data key="d1">interface</data>
  <data key="d2">The Sensitivity 2/4 screen displays insulin sensitivity factor settings during the setup process.</data>
  <data key="d3">chunk-02b21bc8135e144a626f42f84747459d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1778707370</data>
  <data key="d6"></data>
</node>
<node id="Edit Sensitivity 2/4 Screen">
  <data key="d0">Edit Sensitivity 2/4 Screen</data>
  <data key="d1">interface</data>
  <data key="d2">The Edit Sensitivity 2/4 screen allows users to input and modify the insulin sensitivity factor in mg/dL per unit of insulin.</data>
  <data key="d3">chunk-02b21bc8135e144a626f42f84747459d</data>
