  <data key="d6"></data>
</node>
<node id="Consultations">
  <data key="d0">Consultations</data>
  <data key="d1">method</data>
  <data key="d2">Consultations (face‑to‑face or remote) are clinical interactions used to set glycemic goals, shown to be more effective than usual care.</data>
  <data key="d3">chunk-b275f50028ef32e322bf8643e0342810</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372156</data>
  <data key="d6"></data>
</node>
<node id="Usual Care">
  <data key="d0">Usual Care</data>
  <data key="d1">concept</data>
  <data key="d2">Usual Care refers to standard medical management without specialized consultation, used as a comparison in effectiveness studies.</data>
  <data key="d3">chunk-b275f50028ef32e322bf8643e0342810</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372157</data>
  <data key="d6"></data>
</node>
<node id="Non‑Pregnant Adults">
  <data key="d0">Non‑Pregnant Adults</data>
  <data key="d1">concept</data>
  <data key="d2">Non‑Pregnant Adults are a population group mentioned with specific A1C and time‑in‑range goals.</data>
  <data key="d3">chunk-b275f50028ef32e322bf8643e0342810</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372157</data>
  <data key="d6"></data>
</node>
<node id="Frailty">
  <data key="d0">Frailty</data>
  <data key="d1">concept</data>
  <data key="d2">Frailty is a condition indicating reduced physiological reserve, for which adjusted glycemic targets are recommended.</data>
  <data key="d3">chunk-b275f50028ef32e322bf8643e0342810</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372157</data>
  <data key="d6"></data>
</node>
<node id="Holt et al.">
  <data key="d0">Holt et al.</data>
  <data key="d1">content</data>
  <data key="d2">Holt et al. are the authors credited for Figure 6.1 in the Diabetes Care supplement.</data>
  <data key="d3">chunk-b275f50028ef32e322bf8643e0342810</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372157</data>
  <data key="d6"></data>
</node>
<node id="Hybrid Closed‑Loop System">
  <data key="d0">Hybrid Closed‑Loop System</data>
  <data key="d1">artifact</data>
  <data key="d2">Hybrid closed‑loop systems are advanced insulin delivery technologies shown to reduce hypoglycemia in Type 1 Diabetes.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372157</data>
  <data key="d6"></data>
</node>
<node id="Human Islet Transplantation">
  <data key="d0">Human Islet Transplantation</data>
  <data key="d1">method</data>
  <data key="d2">Human islet transplantation is an experimental treatment option for people with Type 1 Diabetes who have Level 3 hypoglycemia and hypoglycemia unawareness.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372157</data>
  <data key="d6"></data>
</node>
<node id="A1C Goals">
  <data key="d0">A1C Goals</data>
  <data key="d1">concept</data>
  <data key="d2">A1C goals are long‑term glycemic control objectives linked to specific glycemic target ranges.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372158</data>
  <data key="d6"></data>
</node>
<node id="Fast‑Acting Carbohydrates">
  <data key="d0">Fast‑Acting Carbohydrates</data>
  <data key="d1">concept</data>
  <data key="d2">Fast‑acting carbohydrates are recommended to treat hypoglycemia at or below the alert value of 70 mg/dL.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372158</data>
  <data key="d6"></data>
</node>
<node id="Pure Glucose">
  <data key="d0">Pure Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Pure glucose is the preferred carbohydrate for acute hypoglycemia treatment because its glucose content drives the glycemic response.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372158</data>
  <data key="d6"></data>
</node>
<node id="Intranasal Glucagon">
  <data key="d0">Intranasal Glucagon</data>
  <data key="d1">artifact</data>
  <data key="d2">Intranasal glucagon is a ready‑to‑use formulation of glucagon for subcutaneous administration.&lt;SEP&gt;A nasal delivery method for glucagon aimed at treating hypoglycemia in diabetic patients.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24&lt;SEP&gt;chunk-c8df31d65b128b9d70b82bb8af257332</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372158</data>
  <data key="d6"></data>
</node>
<node id="Ready‑to‑Inject Glucagon">
  <data key="d0">Ready‑to‑Inject Glucagon</data>
  <data key="d1">artifact</data>
  <data key="d2">Ready‑to‑inject glucagon is a pre‑filled preparation that simplifies subcutaneous glucagon administration.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372158</data>
  <data key="d6"></data>
</node>
<node id="Glucagon Injection Powder">
  <data key="d0">Glucagon Injection Powder</data>
  <data key="d1">artifact</data>
  <data key="d2">Glucagon injection powder requires reconstitution before subcutaneous injection.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372158</data>
  <data key="d6"></data>
</node>
<node id="Level 1">
  <data key="d0">Level 1</data>
  <data key="d1">concept</data>
  <data key="d2">Level 1 hypoglycemia is defined as glucose &lt;70 mg/dL (3.9 mmol/L).</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372158</data>
  <data key="d6"></data>
</node>
<node id="Level 2">
  <data key="d0">Level 2</data>
  <data key="d1">concept</data>
  <data key="d2">Level 2 hypoglycemia is defined as glucose &lt;54 mg/dL (3.0 mmol/L).</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372159</data>
  <data key="d6"></data>
</node>
<node id="Level 3">
  <data key="d0">Level 3</data>
  <data key="d1">concept</data>
  <data key="d2">Level 3 hypoglycemia is a severe event requiring assistance for treatment.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372159</data>
  <data key="d6"></data>
</node>
<node id="Routine Clinical Surveillance">
  <data key="d0">Routine Clinical Surveillance</data>
  <data key="d1">method</data>
  <data key="d2">Routine clinical surveillance refers to regular clinical review to improve patient outcomes in diabetes care.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372159</data>
  <data key="d6"></data>
</node>
<node id="Hypoglycemia Prevention">
  <data key="d0">Hypoglycemia Prevention</data>
  <data key="d1">concept</data>
  <data key="d2">Hypoglycemia prevention includes education, monitoring, and lifestyle adjustments to avoid low glucose events.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372159</data>
  <data key="d6"></data>
</node>
<node id="Protein">
  <data key="d0">Protein</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Protein in carbohydrate sources may increase insulin response without raising plasma glucose, and is not recommended for hypoglycemia treatment.&lt;SEP&gt;Nutrient discussed in relation to optimal health, heart disease, and type 2 diabetes.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24&lt;SEP&gt;chunk-c8df31d65b128b9d70b82bb8af257332</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372159</data>
  <data key="d6"></data>
</node>
<node id="Family Members">
  <data key="d0">Family Members</data>
  <data key="d1">concept</data>
  <data key="d2">Family members are relatives who may provide emergency glucagon for hypoglycemia.&lt;SEP&gt;Family members are among caregivers who should be instructed on glucagon use for people with hypoglycemia‑prone diabetes.&lt;SEP&gt;Family members are relatives who may also carry monogenic diabetes mutations and can be identified after a MODY diagnosis.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24&lt;SEP&gt;chunk-36ddeaa53bc38bee375d7ac6d71485d4&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377239</data>
  <data key="d6"></data>
</node>
<node id="Automated Low Glucose Suspend">
  <data key="d0">Automated Low Glucose Suspend</data>
  <data key="d1">method</data>
  <data key="d2">Automated low glucose suspend is a CGM feature that temporarily halts insulin delivery when glucose falls below a preset threshold to prevent hypoglycemia.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372160</data>
  <data key="d6"></data>
</node>
<node id="Glucose Alert Value">
  <data key="d0">Glucose Alert Value</data>
  <data key="d1">concept</data>
  <data key="d2">Glucose alert value is the blood glucose threshold (70 mg/dL or 3.9 mmol/L) at which treatment for hypoglycemia should be initiated.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372160</data>
  <data key="d6"></data>
</node>
<node id="Acute Glycemic Response">
  <data key="d0">Acute Glycemic Response</data>
  <data key="d1">concept</data>
  <data key="d2">Acute glycemic response refers to the immediate rise in blood glucose after ingesting carbohydrate‑containing foods, correlating with glucose content.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372160</data>
  <data key="d6"></data>
</node>
<node id="Patient Outcomes">
  <data key="d0">Patient Outcomes</data>
  <data key="d1">concept</data>
  <data key="d2">Patient outcomes denote the health results and quality‑of‑life measures achieved through diabetes management interventions.</data>
  <data key="d3">chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372160</data>
  <data key="d6"></data>
</node>
<node id="VADT Trial">
  <data key="d0">VADT Trial</data>
  <data key="d1">event</data>
  <data key="d2">VADT trial is a clinical study reporting a 1.5% reduction in A1C compared with control and a long‑term reduction in cardiovascular event risk.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372160</data>
  <data key="d6"></data>
</node>
<node id="Joint ADA Position Statement Intensive Glycemic Control and the Prevention of Cardiovascular Events: Implications of the ACCORD, ADVANCE, and VADT Trials">
  <data key="d0">Joint ADA Position Statement Intensive Glycemic Control and the Prevention of Cardiovascular Events: Implications of the ACCORD, ADVANCE, and VADT Trials</data>
  <data key="d1">content</data>
  <data key="d2">The joint ADA position statement synthesizes evidence from the ACCORD, ADVANCE, and VADT trials regarding intensive glycemic control and cardiovascular risk.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372160</data>
  <data key="d6"></data>
</node>
<node id="Retinopathy Signs">
  <data key="d0">Retinopathy Signs</data>
  <data key="d3">chunk-44aa59c0e5cc620a11b8fb017d1aefcf</data>
  <data key="d2">The study examines retinopathy markers in a non‑diabetic population.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372160</data>
  <data key="d6"></data>
</node>
<node id="Section 10 Cardiovascular Disease and Risk Management">
  <data key="d0">Section 10 Cardiovascular Disease and Risk Management</data>
  <data key="d1">content</data>
  <data key="d2">Section 10 outlines risk‑management principles for cardiovascular disease in diabetes patients.&lt;SEP&gt;A referenced section covering cardiovascular disease risk management in the context of diabetes.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b&lt;SEP&gt;chunk-9eb02ab1ab7d834858bf60a8b402e6ea</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377429</data>
  <data key="d6"></data>
</node>
<node id="6.5% A1C">
  <data key="d0">6.5% A1C</data>
  <data key="d1">data</data>
  <data key="d2">6.5% A1C (48 mmol/mol) is a stringent glycemic target referenced for the ADVANCE trial and other intensive‑control recommendations.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372161</data>
  <data key="d6"></data>
</node>
<node id="7% A1C">
  <data key="d0">7% A1C</data>
  <data key="d1">data</data>
  <data key="d2">7% A1C (53 mmol/mol) is presented as a less stringent target for certain patient groups.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372161</data>
  <data key="d6"></data>
</node>
<node id="Resources and Support System">
  <data key="d0">Resources and Support System</data>
  <data key="d1">concept</data>
  <data key="d2">Resources and support system refers to the external assistance available to patients that can affect glycemic target decisions.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372161</data>
  <data key="d6"></data>
</node>
<node id="Comorbidities">
  <data key="d0">Comorbidities</data>
  <data key="d1">concept</data>
  <data key="d2">Comorbidities are additional health conditions that affect glycemic target selection.&lt;SEP&gt;Comorbidities are additional health conditions that coexist with diabetes and affect treatment decisions.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b&lt;SEP&gt;chunk-aff91698679a52cd7b07563b7b2627a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372161</data>
  <data key="d6"></data>
</node>
<node id="Vascular Complications">
  <data key="d0">Vascular Complications</data>
  <data key="d1">concept</data>
  <data key="d2">Vascular complications are established vascular disease manifestations that influence glycemic management decisions.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="Advanced Atherosclerosis">
  <data key="d0">Advanced Atherosclerosis</data>
  <data key="d1">concept</data>
  <data key="d2">Advanced atherosclerosis is a severe form of vascular disease that may lead to less aggressive glycemic targets.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="Advanced Age/Frailty">
  <data key="d0">Advanced Age/Frailty</data>
  <data key="d1">concept</data>
  <data key="d2">Advanced age or frailty describes older patients with decreased physiological reserve, affecting glycemic target choices.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="End‑Stage Renal Disease">
  <data key="d0">End‑Stage Renal Disease</data>
  <data key="d1">concept</data>
  <data key="d2">End‑stage renal disease is a severe kidney condition whose incident rate was lower in the intensive treatment group of the ADVANCE trial.</data>
  <data key="d3">chunk-38ab5af7e42588297df4330ffb2c046b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="Preprandial Blood Glucose Monitoring">
  <data key="d0">Preprandial Blood Glucose Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Preprandial Blood Glucose Monitoring (BGM) is a method relied upon overwhelmingly to predict complications in diabetes management.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="Postprandial Plasma Glucose">
  <data key="d0">Postprandial Plasma Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Postprandial plasma glucose is the glucose level measured 1–2 hours after a meal, used to guide treatment and lower A1C.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="Premeal Glucose Target">
  <data key="d0">Premeal Glucose Target</data>
  <data key="d1">concept</data>
  <data key="d2">Premeal glucose target of 80–130 mg/dL is the ADA‑recommended range for glucose before meals.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="Level 1 Hypoglycemia">
  <data key="d0">Level 1 Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Level 1 Hypoglycemia refers to glucose readings between 54–69 mg/dL (3.0–3.8 mmol/L).&lt;SEP&gt;Level 1 hypoglycemia is defined as a blood glucose concentration below 70 mg/dL (3.9 mmol/L).</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4&lt;SEP&gt;chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="Pedersen‑Bjergaard Score">
  <data key="d0">Pedersen‑Bjergaard Score</data>
  <data key="d1">method</data>
  <data key="d2">Pedersen‑Bjergaard score is a method used to assess impaired hypoglycemia awareness.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372162</data>
  <data key="d6"></data>
</node>
<node id="School Personnel">
  <data key="d0">School Personnel</data>
  <data key="d1">person</data>
  <data key="d2">School personnel are staff members who may need to administer glucagon to students with hypoglycemia risk.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372163</data>
  <data key="d6"></data>
</node>
<node id="Table 6.1">
  <data key="d0">Table 6.1</data>
  <data key="d1">content</data>
  <data key="d2">Table 6.1 presents glucose ranges deemed adequate to meet targets and decrease hypoglycemia.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372163</data>
  <data key="d6"></data>
</node>
<node id="Table 6.4">
  <data key="d0">Table 6.4</data>
  <data key="d1">content</data>
  <data key="d2">Table 6.4 outlines the classification of hypoglycemia levels.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372163</data>
  <data key="d6"></data>
</node>
<node id="Insulin Treatment Plans">
  <data key="d0">Insulin Treatment Plans</data>
  <data key="d1">method</data>
  <data key="d2">Insulin treatment plans target either postprandial or preprandial glucose to manage diabetes.&lt;SEP&gt;Insulin treatment plans are therapeutic regimens using insulin to control blood glucose.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4&lt;SEP&gt;chunk-aff91698679a52cd7b07563b7b2627a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Predictor of Complications">
  <data key="d0">Predictor of Complications</data>
  <data key="d1">concept</data>
  <data key="d2">Predictor of complications refers to using blood glucose monitoring to anticipate adverse diabetes outcomes.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Hypoglycemia Avoidance Education">
  <data key="d0">Hypoglycemia Avoidance Education</data>
  <data key="d1">concept</data>
  <data key="d2">Hypoglycemia avoidance education aims to prevent future hypoglycemic episodes in at‑risk individuals.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Glucose Treatment (15–20 g)">
  <data key="d0">Glucose Treatment (15–20 g)</data>
  <data key="d1">artifact</data>
  <data key="d2">Glucose (approximately 15–20 g) is the preferred treatment for conscious individuals with blood glucose below 70 mg/dL.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Insulin‑treated Patients">
  <data key="d0">Insulin‑treated Patients</data>
  <data key="d1">person</data>
  <data key="d2">Insulin‑treated patients are individuals receiving insulin therapy, particularly those who may experience hypoglycemia unawareness.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Landmark Trials of Glycemic Control">
  <data key="d0">Landmark Trials of Glycemic Control</data>
  <data key="d1">event</data>
  <data key="d2">Landmark trials of glycemic control investigated predictors of diabetes complications.</data>
  <data key="d3">chunk-36ddeaa53bc38bee375d7ac6d71485d4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Risk of Complications">
  <data key="d0">Risk of Complications</data>
  <data key="d1">concept</data>
  <data key="d2">Risk of complications denotes the likelihood of developing diabetes-related health problems.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372165</data>
  <data key="d6"></data>
</node>
<node id="Ambulatory Glucose Profile Report">
  <data key="d0">Ambulatory Glucose Profile Report</data>
  <data key="d1">artifact</data>
  <data key="d2">The Ambulatory Glucose Profile (AGP) Report is a standardized visual summary of CGM data.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372165</data>
  <data key="d6"></data>
</node>
<node id="International Consensus on TIR">
  <data key="d0">International Consensus on TIR</data>
  <data key="d1">organization</data>
  <data key="d2">International Consensus on TIR is a collaborative group that issues guidance on standardized CGM metrics.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372165</data>
  <data key="d6"></data>
</node>
<node id="Standardized CGM Metrics">
  <data key="d0">Standardized CGM Metrics</data>
  <data key="d1">concept</data>
  <data key="d2">Standardized CGM Metrics are a set of agreed-upon measurements derived from CGM data for clinical interpretation.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372165</data>
  <data key="d6"></data>
</node>
<node id="Glucose Management">
  <data key="d0">Glucose Management</data>
  <data key="d1">concept</data>
  <data key="d2">Glucose management encompasses strategies to maintain target glucose levels and reduce complications.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372165</data>
  <data key="d6"></data>
</node>
<node id="Telehealth">
  <data key="d0">Telehealth</data>
  <data key="d1">concept</data>
  <data key="d2">Telehealth is the remote delivery of health care services using digital communication technologies.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372165</data>
  <data key="d6"></data>
</node>
<node id="Remote Access">
  <data key="d0">Remote Access</data>
  <data key="d1">concept</data>
  <data key="d2">Remote access refers to the ability to retrieve CGM data from a distance for clinical use.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372165</data>
  <data key="d6"></data>
</node>
<node id="Accuracy">
  <data key="d0">Accuracy</data>
  <data key="d1">concept</data>
  <data key="d2">Accuracy denotes the degree to which CGM measurements reflect true glucose values.</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372166</data>
  <data key="d6"></data>
</node>
<node id="Affordability">
  <data key="d0">Affordability</data>
  <data key="d1">concept</data>
