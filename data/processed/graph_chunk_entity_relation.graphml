  <data key="d13">1778708528</data>
  <data key="d14"></data>
</edge>
<edge source="Warm Up Not Started" target="CGM Device">
  <data key="d8">1.0</data>
  <data key="d9">The CGM device triggers the Warm Up Not Started alert when it cannot detect interstitial fluid to begin the warm-up process after a new sensor is paired.</data>
  <data key="d10">failure detection,sensor initialization</data>
  <data key="d11">chunk-92b103916c0aae66fd1ad9496d81e3dc</data>
