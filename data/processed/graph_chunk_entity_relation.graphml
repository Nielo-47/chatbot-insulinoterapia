</node>
<node id="Allergy to Insulin Lispro">
  <data key="d0">Allergy to Insulin Lispro</data>
  <data key="d1">concept</data>
  <data key="d2">Allergy to insulin lispro is a hypersensitivity condition that contraindicates the use of Humalog.</data>
  <data key="d3">chunk-c3daabbd42055dc30154f5f97c85fb7d</data>
