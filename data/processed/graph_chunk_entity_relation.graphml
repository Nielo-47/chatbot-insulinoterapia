<node id="Systemic Edema">
  <data key="d0">Systemic Edema</data>
  <data key="d1">concept</data>
  <data key="d2">Systemic Edema is generalized fluid retention that can arise from heart failure or medication side effects.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
