  <data key="d0">Balinhas Comuns</data>
  <data key="d1">artifact</data>
  <data key="d2">Balinhas comuns are regular candies used as a rapid glucose source to manage low blood sugar.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
