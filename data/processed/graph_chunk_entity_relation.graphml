<edge source="Toujeo 300/mL" target="Hyperglycemic Episodes with Ketosis">
  <data key="d7">1.0</data>
  <data key="d8">Toujeo 300/mL showed fewer hyperglycemic episodes with ketosis (6.4%) than LANTUS (11.8%).</data>
