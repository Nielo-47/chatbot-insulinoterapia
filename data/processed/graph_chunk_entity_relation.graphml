  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/monitoramento contínuo de glicose.pdf</data>
  <data key="d13">1778709316</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Family">
  <data key="d8">1.0</data>
  <data key="d9">The family supports the patient in managing diabetes, including monitoring and recording glucose levels.</data>
  <data key="d10">shared responsibility,support system</data>
  <data key="d11">chunk-3aeabf750656ceb7619502d5fd50ebe6</data>
