  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia Treatment" target="Pure Glucose">
  <data key="d7">1.0</data>
  <data key="d8">Pure glucose is the preferred carbohydrate for acute hypoglycemia treatment.</data>
  <data key="d9">preferred,therapy</data>
