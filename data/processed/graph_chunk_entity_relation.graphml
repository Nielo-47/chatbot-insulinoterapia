<edge source="UKPDS" target="Intensive Glycemic Control">
  <data key="d7">1.0</data>
  <data key="d8">The UKPDS examined intensive glycemic control in newly diagnosed type 2 diabetes.</data>
  <data key="d9">intensive control,trial evaluation</data>
  <data key="d10">chunk-f99d05e1089d59496d56d86ff40197cc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d12">1786372313</data>
  <data key="d13"></data>
</edge>
<edge source="UKPDS" target="Cardiovascular Disease (CVD)">
  <data key="d7">1.0</data>
  <data key="d8">The UKPDS observed a 16% reduction in cardiovascular events, which did not reach statistical significance.</data>
  <data key="d9">modest reduction,outcome</data>
  <data key="d10">chunk-f99d05e1089d59496d56d86ff40197cc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d12">1786372316</data>
  <data key="d13"></data>
</edge>
<edge source="ADVANCE" target="Microvascular Events">
  <data key="d7">1.0</data>
  <data key="d8">ADVANCE reported a hazard ratio of 0.86 for microvascular events, indicating reduced risk with intensive control.</data>
  <data key="d9">hazard ratio,risk reduction</data>
  <data key="d10">chunk-4f9624abde6cf128707fcc0466a4c9a7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1786370145</data>
  <data key="d13"></data>
</edge>
<edge source="ADVANCE" target="Intensive Glycemic Control">
  <data key="d7">1.0</data>
  <data key="d8">The ADVANCE trial evaluated intensive glycemic control in type 2 diabetes.</data>
  <data key="d9">intensive control,trial evaluation</data>
  <data key="d10">chunk-f99d05e1089d59496d56d86ff40197cc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d12">1786372311</data>
  <data key="d13"></data>
</edge>
<edge source="ADVANCE" target="Cardiovascular Disease (CVD)">
  <data key="d7">1.0</data>
  <data key="d8">The ADVANCE trial found no significant reduction in cardiovascular disease outcomes.</data>
  <data key="d9">no benefit,outcome</data>
  <data key="d10">chunk-f99d05e1089d59496d56d86ff40197cc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d12">1786372315</data>
  <data key="d13"></data>
</edge>
<edge source="Coefficient of Variation (CV)" target="International Consensus on Continuous Glucose Monitoring">
  <data key="d7">1.0</data>
  <data key="d8">The International Consensus on Continuous Glucose Monitoring established a CV cutoff of 36% for hypoglycemia risk.</data>
  <data key="d9">cutoff,guideline</data>
  <data key="d10">chunk-6d83801272f7a0ae0d797d60572fe578</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1786370141</data>
  <data key="d13"></data>
</edge>
<edge source="Coefficient of Variation (CV)" target="Monnier">
  <data key="d7">1.0</data>
  <data key="d8">Monnier’s study identified that a Coefficient of Variation above 36% is associated with increased hypoglycemia episodes.</data>
  <data key="d9">association,research</data>
  <data key="d10">chunk-6d83801272f7a0ae0d797d60572fe578</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1786370142</data>
  <data key="d13"></data>
</edge>
<edge source="ACCORD" target="Cardiovascular Disease (CVD)">
  <data key="d7">2.0</data>
  <data key="d8">The ACCORD trial enrolled participants with known cardiovascular disease (CVD).&lt;SEP&gt;The ACCORD trial found no significant reduction in cardiovascular disease outcomes.</data>
  <data key="d9">no benefit,outcome,participant condition,trial focus</data>
  <data key="d10">chunk-74ef8c063d84e34c44021aa138b9b903&lt;SEP&gt;chunk-f99d05e1089d59496d56d86ff40197cc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d12">1786372272</data>
  <data key="d13"></data>
</edge>
<edge source="ACCORD" target="Intensive Glycemic Control">
  <data key="d7">1.0</data>
  <data key="d8">The ACCORD trial evaluated the effects of intensive glycemic control in type 2 diabetes.</data>
  <data key="d9">intensive control,trial evaluation</data>
  <data key="d10">chunk-f99d05e1089d59496d56d86ff40197cc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
