  <data key="d1">artifact</data>
  <data key="d2">Caveolins are proteins deficient due to PTRF mutations, leading to muscular dystrophy.</data>
  <data key="d3">chunk-336c6084eb6cb7c8ada29ed26c0cd20d</data>
