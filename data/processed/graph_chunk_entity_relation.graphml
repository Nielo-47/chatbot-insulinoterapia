<node id="Glicemia Alta">
  <data key="d0">Glicemia Alta</data>
  <data key="d1">concept</data>
  <data key="d2">Glicemia alta describes hyperglycemia, a blood glucose level above the target range.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
