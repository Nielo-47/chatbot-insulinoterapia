  <data key="d6"></data>
</node>
<node id="Device Limit Exceeded Alarm">
  <data key="d0">Device Limit Exceeded Alarm</data>
  <data key="d1">concept</data>
  <data key="d2">Device Limit Exceeded Alarm occurs when the hourly insulin delivery limit is reached, causing suspension of insulin delivery.</data>
  <data key="d3">chunk-71de01baf40871c616eaa39cb8189f43</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329648</data>
  <data key="d6"></data>
</node>
