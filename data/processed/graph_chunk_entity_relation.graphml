  <data key="d12">1786325777</data>
  <data key="d13"></data>
</edge>
<edge source="Bomba" target="Bolus Wizard™">
  <data key="d7">2.0</data>
  <data key="d8">Bolus Wizard™ is a function activated on the Bomba to assist with bolus calculations.&lt;SEP&gt;Bolus Wizard™ within the pump calculates the corrective bolus amount.</data>
  <data key="d9">device integration,dose calculation,software,software feature</data>
  <data key="d10">chunk-1312783ffe5039c618a48f7f29ec51ed&lt;SEP&gt;chunk-644dc086af7b196cc5bc332524608d5f</data>
