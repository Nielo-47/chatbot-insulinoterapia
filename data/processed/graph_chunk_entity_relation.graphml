  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Overweight or Obesity">
  <data key="d7">1.0</data>
  <data key="d8">Overweight or obesity (BMI ≥25 kg/m2 or ≥23 kg/m2 for Asian American individuals) is listed as a criterion for diabetes screening in asymptomatic adults.</data>
  <data key="d9">risk factor,screening criterion</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377563</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="First-Degree Relative with Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Having a first-degree relative with diabetes increases an individual's risk and qualifies them for screening.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377564</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="High-Risk Race/Ethnicity">
  <data key="d7">1.0</data>
  <data key="d8">Identified high‑risk racial/ethnic groups are associated with a greater likelihood of developing diabetes.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377566</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="History of Cardiovascular Disease (CVD)">
  <data key="d7">1.0</data>
  <data key="d8">A prior history of cardiovascular disease is a risk factor prompting diabetes screening.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377567</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Hypertension">
  <data key="d7">1.0</data>
  <data key="d8">Hypertension (≥130/80 mmHg or treated) is listed as a risk factor for diabetes.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377568</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Low HDL Cholesterol">
  <data key="d7">1.0</data>
  <data key="d8">HDL cholesterol levels below 35 mg/dL constitute a risk factor for diabetes.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377568</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="High Triglycerides">
  <data key="d7">1.0</data>
  <data key="d8">Triglyceride levels above 250 mg/dL are identified as a risk factor for diabetes.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377569</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Polycystic Ovary Syndrome (PCOS)">
  <data key="d7">1.0</data>
  <data key="d8">Polycystic ovary syndrome is recognized as a clinical condition associated with insulin resistance and diabetes risk.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377570</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Physical Inactivity">
  <data key="d7">1.0</data>
  <data key="d8">Physical inactivity is cited as a risk factor for diabetes.</data>
  <data key="d9">risk factor</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377571</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes" target="Severe Obesity">
  <data key="d7">1.0</data>
  <data key="d8">Severe obesity is listed among clinical conditions linked to insulin resistance and diabetes.</data>
  <data key="d9">risk factor</data>
