</node>
<node id="Humalog®">
  <data key="d0">Humalog®</data>
  <data key="d1">artifact</data>
  <data key="d2">Humalog® is a rapid‑acting insulin analogue evaluated in Study ANA‑2126.&lt;SEP&gt;Humalog® is insulin lispro, a rapid‑acting insulin analog mentioned as a comparator option.</data>
  <data key="d3">chunk-6e42637e4286cbc19cce4502b22634bd&lt;SEP&gt;chunk-fe094dd3d94334373a8497a7cb841e0f</data>
