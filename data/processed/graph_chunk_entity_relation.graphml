  <data key="d0">Lente Insulin</data>
  <data key="d1">product</data>
  <data key="d2">A type of slow-acting insulin, requiring 20 gentle movements of the pen before use.</data>
  <data key="d3">chunk-e68da6d45eb01c249e854b711007d805</data>
