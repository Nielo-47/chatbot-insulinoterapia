  <data key="d0">Familial Partial Lipodystrophy</data>
  <data key="d1">concept</data>
  <data key="d2">Familial partial lipodystrophy is a hereditary disorder of fat distribution studied using dual‑energy X‑ray absorptiometry.</data>
  <data key="d3">chunk-c1ee3f56f3180d8544dbba6a542c9d68</data>
