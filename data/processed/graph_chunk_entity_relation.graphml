  <data key="d0">Açúcar Dissolvido Em Água</data>
  <data key="d1">artifact</data>
  <data key="d2">Açúcar dissolvido em água is a quick source of glucose used to raise blood sugar levels during hypoglycemic episodes.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
  <data key="d5">1778694916</data>
