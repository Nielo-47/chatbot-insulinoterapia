  <data key="d0">Multiple Daily Injection Regimen</data>
  <data key="d1">method</data>
  <data key="d2">Multiple Daily Injection Regimen is a therapeutic method involving several insulin injections per day, used in the studies cited.</data>
  <data key="d3">chunk-3397508bdfddde019cb1dfdcfb352435</data>
