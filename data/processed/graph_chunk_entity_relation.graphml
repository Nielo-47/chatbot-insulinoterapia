  <data key="d1">concept</data>
  <data key="d2">Temperature Condition refers to sensor temperature being too hot or too cold, triggering safety alerts.</data>
  <data key="d3">chunk-46d04af5292fae98e3aa651d9cec4512</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329684</data>
  <data key="d6"></data>
</node>
