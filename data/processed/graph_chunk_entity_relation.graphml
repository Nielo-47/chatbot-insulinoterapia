  <data key="d5">1786373032</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Monogenic (MODY)">
  <data key="d0">Diabetes Monogenic (MODY)</data>
  <data key="d1">concept</data>
  <data key="d2">Monogenic form of diabetes, autosomal dominant, with early onset before 25 years, 2‑3 generations of family history, negative autoantibodies, and detectable C‑peptide above 0.6 ng/ml after five years.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373032</data>
  <data key="d6"></data>
</node>
