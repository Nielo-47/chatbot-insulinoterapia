  <data key="d6"></data>
</node>
<node id="New Set Only">
  <data key="d0">New Set Only</data>
  <data key="d1">method</data>
  <data key="d2">New Set Only is the procedure for changing only the infusion set while retaining the current insulin reservoir.</data>
