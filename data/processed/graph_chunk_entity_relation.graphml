  <data key="d6"></data>
</node>
<node id="Label">
  <data key="d0">Label</data>
  <data key="d1">concept</data>
  <data key="d2">The label shows the insulin name and concentration on the pen.&lt;SEP&gt;Label denotes the printed information on Levemir® packaging that must be checked before injection.</data>
