  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Adjunctive CGM">
  <data key="d0">Adjunctive CGM</data>
  <data key="d1">concept</data>
  <data key="d2">Adjunctive CGM refers to CGM systems that require confirmatory Blood Glucose Monitoring before making insulin dosing or hypoglycemia treatment decisions.</data>
  <data key="d3">chunk-0fe1eff7b58582dec4c8ae7578e20e66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335978</data>
  <data key="d6"></data>
</node>
<node id="Nonadjunctive CGM">
  <data key="d0">Nonadjunctive CGM</data>
  <data key="d1">concept</data>
  <data key="d2">Nonadjunctive CGM refers to CGM systems that can be used for treatment decisions without separate Blood Glucose Monitoring except in certain clinical situations.</data>
  <data key="d3">chunk-0fe1eff7b58582dec4c8ae7578e20e66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
