  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694527</data>
  <data key="d14"></data>
</edge>
<edge source="Aplicação De Insulina" target="Agulha De 6 Mm">
  <data key="d8">1.0</data>
  <data key="d9">A agulha de 6 mm exige prega de pele e aplicação em ângulo de 90° para adultos ou 45° para crianças.</data>
  <data key="d10">angle requirement,injection technique</data>
