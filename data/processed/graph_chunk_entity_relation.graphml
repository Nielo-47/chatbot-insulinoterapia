  <data key="d10">chunk-cd40a6d69921cf300ed8eda043698d1a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d12">1786318744</data>
  <data key="d13"></data>
</edge>
<edge source="Normoglycemia" target="Stage 1 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Stage 1 diabetes is characterized by normoglycemia.</data>
  <data key="d9">characteristic,stage</data>
  <data key="d10">chunk-ba38023866c2db7437e618a60033f21f</data>
