  <data key="d14"></data>
</edge>
<edge source="Monitorização Contínua de Glicose" target="Sensor de Glicose">
  <data key="d8">1.0</data>
  <data key="d9">O sensor de glicose é o dispositivo utilizado na monitorização contínua da glicemia.</data>
