<node id="Administracion De Un Bolus">
  <data key="d0">Administracion De Un Bolus</data>
  <data key="d1">event</data>
  <data key="d2">Administracion De Un Bolus refers to the process of delivering an insulin bolus, either for meals or correction.</data>
