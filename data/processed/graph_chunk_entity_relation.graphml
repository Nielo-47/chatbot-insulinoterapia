  <data key="d13">1778707834</data>
  <data key="d14"></data>
</edge>
<edge source="Sensor" target="Failed To Pair With Pump Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Failed To Pair With Pump Alert indicates unsuccessful wireless connection between the sensor and pump.</data>
  <data key="d10">connectivity issue,pairing failure</data>
