  <data key="d6"></data>
</node>
<node id="Interstitial Glucose">
  <data key="d0">Interstitial Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Interstitial glucose is the glucose concentration in the fluid surrounding body cells, measured by CGM sensors and correlates with plasma glucose.</data>
  <data key="d3">chunk-0fe1eff7b58582dec4c8ae7578e20e66</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335977</data>
  <data key="d6"></data>
</node>
<node id="Plasma Glucose">
  <data key="d0">Plasma Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Plasma glucose is the concentration of glucose in the blood plasma, which interstitial glucose approximates.&lt;SEP&gt;A biological metric examined in the relationship with HbA1c.&lt;SEP&gt;Plasma glucose is the blood glucose concentration measured in tests, requiring prompt centrifugation of samples.</data>
  <data key="d3">chunk-0fe1eff7b58582dec4c8ae7578e20e66&lt;SEP&gt;chunk-1dec009976a44828d0e619e7fa5b1c5d&lt;SEP&gt;chunk-6601fea85bfbb9f20040c70b7e21695d</data>
