  <data key="d0">Sodium Phosphate Dibasic Dihydrate</data>
  <data key="d1">data</data>
  <data key="d2">Sodium phosphate dibasic dihydrate is an excipient used to buffer the Levemir® solution.</data>
  <data key="d3">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698085</data>
  <data key="d6"></data>
</node>
<node id="Sodium Chloride">
  <data key="d0">Sodium Chloride</data>
  <data key="d1">data</data>
  <data key="d2">Sodium chloride is an excipient in Levemir® FlexPen® solution, used to maintain osmotic balance.&lt;SEP&gt;Sodium chloride is an excipient in Levemir® Penfill® solution, used to adjust tonicity.</data>
  <data key="d3">chunk-975d0ad130a42cf2fe8a0f91e4da2b29&lt;SEP&gt;chunk-5561a191d3b525d406e49933648e27bf</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698085</data>
  <data key="d6"></data>
</node>
<node id="Sodium Hydroxide">
  <data key="d0">Sodium Hydroxide</data>
  <data key="d1">artifact</data>
  <data key="d2">Sodium hydroxide is an excipient used to adjust the pH of the insulin detemir solution.&lt;SEP&gt;Sodium hydroxide is an excipient in Levemir® Penfill® solution, used to adjust pH.&lt;SEP&gt;Sodium hydroxide is an excipient in Novolin® R used to adjust the pH of the solution.</data>
  <data key="d3">chunk-975d0ad130a42cf2fe8a0f91e4da2b29&lt;SEP&gt;chunk-5561a191d3b525d406e49933648e27bf&lt;SEP&gt;chunk-4db353458c93e1b1abc9f696ebf195a9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1778698995</data>
  <data key="d6"></data>
</node>
<node id="Hydrochloric Acid">
  <data key="d0">Hydrochloric Acid</data>
  <data key="d1">artifact</data>
  <data key="d2">Hydrochloric acid is an excipient used to adjust the pH of the insulin detemir solution.&lt;SEP&gt;Hydrochloric acid is an excipient in Levemir® Penfill® solution, used to adjust pH.&lt;SEP&gt;Hydrochloric acid is an excipient in Novolin® R used to adjust the pH of the solution.</data>
  <data key="d3">chunk-975d0ad130a42cf2fe8a0f91e4da2b29&lt;SEP&gt;chunk-5561a191d3b525d406e49933648e27bf&lt;SEP&gt;chunk-4db353458c93e1b1abc9f696ebf195a9</data>
