  <data key="d6"></data>
</node>
<node id="SG Cursor">
  <data key="d0">SG Cursor</data>
  <data key="d1">artifact</data>
  <data key="d2">SG Cursor is a graphical indicator on the sensor graph showing a specific sensor glucose value.</data>
  <data key="d3">chunk-ede0f32eb8f8ea1eaab76cc0bc7648fd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329662</data>
  <data key="d6"></data>
</node>
