  <data key="d1">method</data>
  <data key="d2">2ª Etapa: Afixando a Agulha is the second method step that guides users to attach a new sterile needle to the SoloStar pen.</data>
  <data key="d3">chunk-79f891b1d7c0c6ca0eab9dbcc76c902d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
