<node id="Oral Agents">
  <data key="d0">Oral Agents</data>
  <data key="d1">method</data>
  <data key="d2">Oral Agents are medication tablets used to manage blood glucose in diabetes, referenced alongside basal insulin.&lt;SEP&gt;Oral agents are medications taken by mouth to treat diabetes.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-72a2488e8176f7676c76504e76dd6c04</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377300</data>
  <data key="d6"></data>
</node>
<node id="Noninsulin Injectables">
  <data key="d0">Noninsulin Injectables</data>
  <data key="d1">concept</data>
  <data key="d2">Noninsulin Injectables are injectable diabetes medications other than insulin, included in treatment descriptions.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335915</data>
  <data key="d6"></data>
</node>
<node id="International Organization for Standardization">
  <data key="d0">International Organization for Standardization</data>
  <data key="d1">organization</data>
  <data key="d2">The International Organization for Standardization develops international standards such as ISO 15197:2013 for blood glucose meter accuracy.&lt;SEP&gt;The International Organization for Standardization (ISO) issues international standards such as ISO 15197:2013 for blood glucose meter performance.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-c9bc5d11c9f848439320623cad3d3a38</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335915</data>
  <data key="d6"></data>
</node>
<node id="Acute Complications">
  <data key="d0">Acute Complications</data>
  <data key="d1">concept</data>
  <data key="d2">Acute Complications refer to short‑term adverse health events associated with diabetes, such as severe hypoglycemia.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Study of 27,000 Children and Adolescents">
  <data key="d0">Study of 27,000 Children and Adolescents</data>
  <data key="d1">data</data>
  <data key="d2">A database study involving nearly 27,000 youths with Type 1 Diabetes examined the relationship between BGM frequency and health outcomes.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Paper Tool">
  <data key="d0">Paper Tool</data>
  <data key="d1">artifact</data>
  <data key="d2">Paper Tool is a low‑technology instrument used quarterly to collect seven‑point BGM profiles over consecutive days in a structured monitoring program.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Seven‑Point BGM Profiles">
  <data key="d0">Seven‑Point BGM Profiles</data>
  <data key="d1">data</data>
  <data key="d2">Seven‑Point BGM Profiles are sets of glucose measurements taken at seven times during three consecutive days for detailed monitoring.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Meta‑Analyses">
  <data key="d0">Meta‑Analyses</data>
  <data key="d1">content</data>
  <data key="d2">Meta‑Analyses are systematic reviews that have aggregated evidence showing BGM can reduce A1C by 0.25–0.3% over six months.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Structured Blood Glucose Monitoring">
  <data key="d0">Structured Blood Glucose Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Structured Blood Glucose Monitoring is an organized BGM approach using tools such as paper logs to inform treatment adjustments.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Consensus Error Grid">
  <data key="d0">Consensus Error Grid</data>
  <data key="d1">concept</data>
  <data key="d2">Consensus Error Grid categorizes blood glucose meter readings into clinically acceptable (A, B) or outlier regions.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Home Use Setting">
  <data key="d0">Home Use Setting</data>
  <data key="d1">concept</data>
  <data key="d2">Home Use Setting describes the context in which blood glucose meters are used by patients outside clinical facilities, with specific accuracy requirements.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Hospital Use Setting">
  <data key="d0">Hospital Use Setting</data>
  <data key="d1">concept</data>
  <data key="d2">Hospital Use Setting refers to the clinical environment where stricter blood glucose meter accuracy standards apply.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Nutrition">
  <data key="d0">Nutrition</data>
  <data key="d1">concept</data>
  <data key="d2">Nutrition refers to dietary intake influencing blood glucose levels.&lt;SEP&gt;Dietary intake changes that affect blood glucose levels in acute illness.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-6fe769b03fc66d4a691f3b7f741b92cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Medication Management">
  <data key="d0">Medication Management</data>
  <data key="d1">concept</data>
  <data key="d2">Medication Management involves adjusting diabetes drugs to achieve glucose targets.&lt;SEP&gt;Medication Management involves adjusting drug regimens, such as insulin, based on glucose monitoring data.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372167</data>
  <data key="d6"></data>
</node>
<node id="Glucose Oxidase">
  <data key="d0">Glucose Oxidase</data>
  <data key="d1">artifact</data>
  <data key="d2">Glucose Oxidase is an enzyme used in some blood glucose meters to catalyze the oxidation of glucose during measurement.&lt;SEP&gt;Glucose Oxidase is an enzyme incorporated in biosensor strips for glucose detection.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338531</data>
  <data key="d6"></data>
</node>
<node id="Glucose Dehydrogenase">
  <data key="d0">Glucose Dehydrogenase</data>
  <data key="d1">artifact</data>
  <data key="d2">Glucose Dehydrogenase is an alternative enzyme employed in blood glucose meters for electrochemical detection of glucose.&lt;SEP&gt;Glucose Dehydrogenase is an enzyme incorporated in biosensor strips for glucose detection.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338531</data>
  <data key="d6"></data>
</node>
<node id="Critical Illness">
  <data key="d0">Critical Illness</data>
  <data key="d1">concept</data>
  <data key="d2">Critical Illness denotes severe medical conditions, such as those encountered in intensive care units, where glucose meter accuracy may be compromised.&lt;SEP&gt;Critical illness is a severe health condition that increases the risk of inaccurate glucose meter readings.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Laboratory Testing">
  <data key="d0">Laboratory Testing</data>
  <data key="d1">method</data>
  <data key="d2">Laboratory Testing is a clinical procedure used to obtain reference blood glucose values, especially when meter readings are discordant with the clinical picture.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335916</data>
  <data key="d6"></data>
</node>
<node id="Error Message">
  <data key="d0">Error Message</data>
  <data key="d1">concept</data>
  <data key="d2">Error Message refers to alerts generated by some blood glucose meters when a reading is likely erroneous.&lt;SEP&gt;Error message is a notification shown by glucose monitors when a reading may be inaccurate due to environmental factors.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335917</data>
  <data key="d6"></data>
</node>
<node id="Electrochemical Reaction">
  <data key="d0">Electrochemical Reaction</data>
  <data key="d1">concept</data>
  <data key="d2">Electrochemical Reaction is the chemical process coupled with enzymatic activity in glucose meters to produce an electrical signal proportional to glucose concentration.&lt;SEP&gt;Electrochemical reaction is the chemical process coupled with the enzymatic reaction in glucose monitors to generate an electrical signal.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1&lt;SEP&gt;chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335917</data>
  <data key="d6"></data>
</node>
<node id="Enzymatic Reaction">
  <data key="d0">Enzymatic Reaction</data>
  <data key="d1">concept</data>
  <data key="d2">Enzymatic Reaction describes the biochemical conversion of glucose by enzymes such as glucose oxidase or dehydrogenase within a blood glucose meter.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335917</data>
  <data key="d6"></data>
</node>
<node id="Blood Glucose Meter Accuracy Standards">
  <data key="d0">Blood Glucose Meter Accuracy Standards</data>
  <data key="d1">concept</data>
  <data key="d2">Blood Glucose Meter Accuracy Standards are defined criteria, such as those in ISO 15197:2013 and FDA guidelines, that specify acceptable measurement error ranges.</data>
  <data key="d3">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335917</data>
  <data key="d6"></data>
</node>
<node id="ADA Professional Practice Committee">
  <data key="d0">ADA Professional Practice Committee</data>
  <data key="d1">organization</data>
  <data key="d2">A multidisciplinary expert committee of the ADA responsible for annually updating the Standards of Care in Diabetes.&lt;SEP&gt;ADA Professional Practice Committee is a multidisciplinary expert committee of the American Diabetes Association responsible for updating the Standards of Care.&lt;SEP&gt;The ADA Professional Practice Committee is a multidisciplinary expert committee responsible for updating the ADA Standards of Care.</data>
  <data key="d3">chunk-e4c5ae163a494feafedb71ed2205c02f&lt;SEP&gt;chunk-b9fe6f17fdb504b9177e8ebc48505716&lt;SEP&gt;chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
