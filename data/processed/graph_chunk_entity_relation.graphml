</node>
<node id="American Association of Clinical Endocrinologists">
  <data key="d0">American Association of Clinical Endocrinologists</data>
  <data key="d1">organization</data>
  <data key="d2">The American Association of Clinical Endocrinologists (AACE) is an organization that sets a target HbA1c of less than 6.5%.&lt;SEP&gt;Professional organization of clinical endocrinologists that co‑authored a 2018 position statement on insulin pump and continuous glucose monitoring integration.&lt;SEP&gt;Clinical society that issued the 2018 position statement on integrating insulin pumps and continuous glucose monitoring.&lt;SEP&gt;The American Association of Clinical Endocrinologists co‑authored the consensus statement on comprehensive type 2 diabetes management.&lt;SEP&gt;The American Association of Clinical Endocrinologists contributed to a consensus report on outcome measures beyond HbA1c.&lt;SEP&gt;The American Association of Clinical Endocrinologists contributed a consensus statement on detection of lipodystrophy.</data>
  <data key="d3">chunk-f8e89a2540c525a104b0a1a5513347a8&lt;SEP&gt;chunk-126f927723331d6ce149cf77ed397bbf&lt;SEP&gt;chunk-16a76447c936e157673f084ffb74520d&lt;SEP&gt;chunk-f4c458a11c8c36c5c212c3aa69b026c5&lt;SEP&gt;chunk-998bee92df7a33cd9c3ddc60144e14f1&lt;SEP&gt;chunk-c1ee3f56f3180d8544dbba6a542c9d68</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373008</data>
