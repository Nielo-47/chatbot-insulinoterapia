  <data key="d12">1786329876</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="SmartGuard Feature">
  <data key="d7">1.0</data>
  <data key="d8">SmartGuard feature monitors sensor glucose and issues a low SG alarm when values fall below the threshold.</data>
  <data key="d9">low glucose,monitoring</data>
  <data key="d10">chunk-3d0824c9d8a9ff5f2da52b7b5ea69c86</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330022</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="Blood Glucose (BG)">
  <data key="d7">2.0</data>
  <data key="d8">Low SG Alarm instructs the user to check Blood Glucose (BG) and treat as needed.&lt;SEP&gt;The low SG alarm triggers when sensor glucose falls below 55 mg/dL.</data>
  <data key="d9">low threshold,monitoring,treatment,trigger</data>
  <data key="d10">chunk-3d0824c9d8a9ff5f2da52b7b5ea69c86&lt;SEP&gt;chunk-59d8fcf807f0beb090b2f3d68cc7c168</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330024</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="Low SG Value">
  <data key="d7">1.0</data>
  <data key="d8">Low SG Alarm activates when sensor glucose falls below the preset Low SG Value.</data>
  <data key="d9">condition,low glucose</data>
  <data key="d10">chunk-fd751b869edcd6c88d9e467cfb2cb0fd</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330115</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="MiniMed 780G">
  <data key="d7">1.0</data>
  <data key="d8">MiniMed 780G generates the Low SG Alarm when sensor glucose falls below the low threshold.</data>
  <data key="d9">alarm generation,device</data>
  <data key="d10">chunk-59d8fcf807f0beb090b2f3d68cc7c168</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330320</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="Instinct">
  <data key="d7">1.0</data>
  <data key="d8">Instinct mode presents the Low SG Alarm message prompting the user to check BG and treat.</data>
  <data key="d9">alarm,display</data>
  <data key="d10">chunk-59d8fcf807f0beb090b2f3d68cc7c168</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330321</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="Pump Suspended Alarm">
  <data key="d7">1.0</data>
  <data key="d8">If Low SG Alarm persists without response for 10 minutes, it escalates to the Pump Suspended Alarm.</data>
  <data key="d9">escalation,trigger</data>
  <data key="d10">chunk-59d8fcf807f0beb090b2f3d68cc7c168</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330322</data>
  <data key="d13"></data>
</edge>
