  <data key="d5">1778702540</data>
  <data key="d6"></data>
</node>
<node id="Energia">
  <data key="d0">Energia</data>
  <data key="d1">concept</data>
  <data key="d2">Energia is the physiological energy produced when glucose is delivered into cells with the help of insulin.</data>
  <data key="d3">chunk-63644bff2af5cc96a50e636bff8e339b</data>
