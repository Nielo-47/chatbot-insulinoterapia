</node>
<node id="Adrenergic Counter‑Regulation">
  <data key="d0">Adrenergic Counter‑Regulation</data>
  <data key="d1">concept</data>
  <data key="d2">Adrenergic counter‑regulation refers to the body’s adrenergic response that precedes neuroglycopenic symptoms during hypoglycemia.</data>
  <data key="d3">chunk-e8934881ec5ab7cfeb836126b3f0e8b2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313634</data>
  <data key="d6"></data>
</node>
<node id="Transient Visual Disturbance">
  <data key="d0">Transient Visual Disturbance</data>
  <data key="d1">concept</data>
  <data key="d2">Transient visual disturbance is a temporary vision impairment caused by acute changes in blood glucose levels.</data>
  <data key="d3">chunk-e8934881ec5ab7cfeb836126b3f0e8b2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313634</data>
  <data key="d6"></data>
</node>
