<node id="Avoidance of Hypoglycemia">
  <data key="d0">Avoidance of Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Avoidance of Hypoglycemia refers to the practice of preventing low blood glucose episodes, shown to improve counterregulation and hypoglycemia awareness.</data>
  <data key="d3">chunk-345ad64f464691cc28341ccd246032db</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372100</data>
  <data key="d6"></data>
</node>
<node id="Hypoglycemia Awareness">
  <data key="d0">Hypoglycemia Awareness</data>
  <data key="d1">concept</data>
  <data key="d2">Hypoglycemia Awareness is the ability to recognize early signs of low blood glucose, mentioned as improving with avoidance of hypoglycemia.</data>
