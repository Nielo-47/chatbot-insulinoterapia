  <data key="d13"></data>
</edge>
<edge source="Subcutaneous Fold" target="Adults with Low Subcutaneous Fat">
  <data key="d7">1.0</data>
  <data key="d8">Adults with minimal fat at the injection site are advised to use a subcutaneous fold.</data>
  <data key="d9">necessity,recommendation</data>
  <data key="d10">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
