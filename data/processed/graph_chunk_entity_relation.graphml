<node id="Hypoglycemic Effect">
  <data key="d0">Hypoglycemic Effect</data>
  <data key="d1">concept</data>
  <data key="d2">Hypoglycemic effect denotes the reduction in blood glucose produced by insulin administration.</data>
  <data key="d3">chunk-2f4f01a72f35d6db3ff333e64f8400ce</data>
