  <data key="d13"></data>
</edge>
<edge source="Pump" target="Start New Sensor">
  <data key="d7">2.0</data>
  <data key="d8">Pump shows the Start New Sensor option to begin a new sensor insertion.&lt;SEP&gt;Pump starts a new sensor’s warm‑up period after the user selects Start New Sensor.</data>
  <data key="d9">UI,method,sensor initiation</data>
