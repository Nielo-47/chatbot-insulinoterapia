</node>
<node id="Intermittently Scanned Continuous Glucose Monitoring E">
  <data key="d0">Intermittently Scanned Continuous Glucose Monitoring E</data>
  <data key="d1">artifact</data>
  <data key="d2">Intermittently scanned continuous glucose monitoring E is a CGM device recommended for youth with type 1 diabetes on multiple daily injections or continuous subcutaneous insulin infusion.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
