  <data key="d7">1.0</data>
  <data key="d8">Insulina Humana Solúvel is described as the aqueous form of the biosynthetic human insulin referenced as IHB.</data>
  <data key="d9">equivalent product,terminology</data>
  <data key="d10">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
