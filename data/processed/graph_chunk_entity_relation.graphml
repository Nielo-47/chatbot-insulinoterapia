<edge source="Gestational Diabetes Mellitus" target="Lifestyle Interventions">
  <data key="d7">1.0</data>
  <data key="d8">Individuals with a history of Gestational Diabetes Mellitus who develop prediabetes should receive intensive lifestyle interventions to prevent progression to diabetes.</data>
