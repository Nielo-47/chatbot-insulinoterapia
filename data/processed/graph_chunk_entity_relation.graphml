  <data key="d7">1.0</data>
  <data key="d8">Variability in red blood cell turnover influences HbA1c accuracy.</data>
  <data key="d9">affect,limitation</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338617</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Adultos Em Geral (DM1 Ou DM2)">
  <data key="d7">1.0</data>
  <data key="d8">Adultos em geral aim for HbA1c lower than 7 %.</data>
  <data key="d9">glycemic control,target</data>
  <data key="d10">chunk-82e0d8e22a06c73855abed11561ce467</data>
