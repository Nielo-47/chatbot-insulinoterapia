  <data key="d5">1786372129</data>
  <data key="d6"></data>
</node>
<node id="Insulin Secretion Mimicry">
  <data key="d0">Insulin Secretion Mimicry</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Secretion Mimicry refers to therapeutic regimens designed to replicate the body’s natural insulin release pattern.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
