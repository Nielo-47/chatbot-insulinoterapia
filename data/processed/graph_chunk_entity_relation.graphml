  <data key="d11">chunk-cf172904e354a6f4cca233304bf69b51</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702958</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Level" target="Glucagon">
  <data key="d8">1.0</data>
  <data key="d9">Glucagon increases blood glucose levels by signaling the liver to release stored glucose.</data>
  <data key="d10">hormone action,physiological regulation</data>
  <data key="d11">chunk-a5cace75be2ca46efd8033523e47b6de</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
