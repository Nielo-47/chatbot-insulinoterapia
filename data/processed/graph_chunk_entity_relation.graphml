  <data key="d0">Quetiapina</data>
  <data key="d1">concept</data>
  <data key="d2">Quetiapina is a second‑generation antipsychotic linked to higher diabetes risk.</data>
  <data key="d3">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
