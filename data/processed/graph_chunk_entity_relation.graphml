  <data key="d0">Twice Daily Dosing</data>
  <data key="d1">concept</data>
  <data key="d2">Twice Daily Dosing refers to the regimen of administering medication two times per day.</data>
  <data key="d3">chunk-bf25fca295be60e28b7c7d3103f722fc</data>
