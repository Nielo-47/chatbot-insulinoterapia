</edge>
<edge source="Hydroxyurea" target="Sensor Glucose">
  <data key="d8">1.0</data>
  <data key="d9">Hydroxyurea use results in substantially higher sensor glucose readings compared to actual blood glucose levels.</data>
  <data key="d10">elevated readings,medication interference</data>
  <data key="d11">chunk-a5904918561a819f1c95321943d91162</data>
