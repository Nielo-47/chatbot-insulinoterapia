  <data key="d0">Tempo De Uso</data>
  <data key="d1">concept</data>
  <data key="d2">The period of use specified in the pen’s instructions, after which the pen should be discarded.</data>
  <data key="d3">chunk-64d156e12ba8d9418249ea309aab0552</data>
