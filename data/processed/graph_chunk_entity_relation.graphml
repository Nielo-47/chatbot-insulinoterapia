</edge>
<edge source="Hypoglycemia" target="Contrarregulação Adrenérgica">
  <data key="d7">1.0</data>
  <data key="d8">Rapid drops in glucose trigger adrenal‑mediated counterregulatory responses.</data>
  <data key="d9">counterregulation,hormonal</data>
  <data key="d10">chunk-3e50c145614f04be2319a31b74b80411</data>
