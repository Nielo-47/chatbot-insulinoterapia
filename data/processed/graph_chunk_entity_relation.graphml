  <data key="d0">28‑Day Use Period</data>
  <data key="d1">concept</data>
  <data key="d2">The 28‑Day Use Period denotes the maximum time an opened Humalog Mix 25 Kwikpen can be used.</data>
  <data key="d3">chunk-4ce520f0fe7dc4a6c79f92a25dfaff19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310729</data>
