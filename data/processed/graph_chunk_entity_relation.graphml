  <data key="d12">1786336962</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Controle do açúcar no sangue">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c is one metric used to assess blood sugar control.</data>
  <data key="d9">measured by</data>
  <data key="d10">chunk-a79d0e4d0f656bd87d2d0c4657378db4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1786336967</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Hemoglobina">
  <data key="d7">1.0</data>
  <data key="d8">Hemoglobin is the protein whose glycated form (HbA1c) is measured for diabetes monitoring.</data>
  <data key="d9">biomarker,measurement</data>
  <data key="d10">chunk-e5570f88766511a4a62cbe9a2dff0bdb</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1786337591</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Diabetes Mellitus">
  <data key="d7">4.0</data>
  <data key="d8">HbA1c levels serve as an indicator for Diabetes Mellitus.&lt;SEP&gt;HbA1c level ≥6.5% is used to diagnose diabetes mellitus.&lt;SEP&gt;HbA1c levels near diagnostic cut‑offs are used to assess Diabetes Mellitus risk.&lt;SEP&gt;HbA1c ≥ 6.5% is used as a diagnostic criterion for Diabetes Mellitus.</data>
  <data key="d9">biomarker,diagnosis,diagnostic criterion</data>
  <data key="d10">chunk-e5570f88766511a4a62cbe9a2dff0bdb&lt;SEP&gt;chunk-6a92f811a7d2d835dc4b730c9bbf08cf&lt;SEP&gt;chunk-078f5907e86c2158587c79b26b0cd683&lt;SEP&gt;chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372038</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Glycemic Variability">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c levels vary with the degree of glycemic variability among individuals.</data>
  <data key="d9">biomarker,variability</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338575</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Clinical Guidelines">
  <data key="d7">1.0</data>
  <data key="d8">Clinical Guidelines recommend HbA1c targets while considering hypoglycemia risk.</data>
  <data key="d9">recommendation,target</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338575</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Figure 2">
  <data key="d7">1.0</data>
  <data key="d8">Figure 2 shows that the same HbA1c can correspond to different glycemic fluctuation patterns.</data>
  <data key="d9">example,illustration</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338577</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Estimated HbA1c (eA1C)">
  <data key="d7">1.0</data>
  <data key="d8">Estimated HbA1c often does not align with measured HbA1c, leading to confusion.</data>
  <data key="d9">comparison,discrepancy</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338579</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Wang et al.">
  <data key="d7">1.0</data>
  <data key="d8">Wang et al. studied the relationship between HbA1c levels and health outcomes.</data>
  <data key="d9">association,research</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338580</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Mortality">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c shows a J‑shaped relationship with all‑cause mortality, with increased risk below 6 % and above 8 %.</data>
  <data key="d9">J‑shape,association</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338581</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Cardiovascular Events">
  <data key="d7">1.0</data>
  <data key="d8">Low HbA1c was not linked to fewer cardiovascular events and may be associated with higher risk.</data>
  <data key="d9">association,risk</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338582</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="AMGC">
  <data key="d7">1.0</data>
  <data key="d8">AMGC complements HbA1c testing for comprehensive glucose control assessment.</data>
  <data key="d9">complementary,management</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338583</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Red Blood Cells">
  <data key="d7">1.0</data>
  <data key="d8">The lifespan of red blood cells influences HbA1c levels, making HbA1c a biomarker of red cell turnover.</data>
  <data key="d9">biomarker,lifespan</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338583</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Fragility Marker">
  <data key="d7">1.0</data>
  <data key="d8">Very low HbA1c levels are associated with the fragility marker, indicating increased patient vulnerability.</data>
  <data key="d9">association,risk</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338584</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="J-shaped Relationship">
  <data key="d7">1.0</data>
  <data key="d8">The J-shaped relationship describes how both low and high HbA1c values are linked to higher mortality risk.</data>
  <data key="d9">mortality risk,pattern</data>
  <data key="d10">chunk-a5f7cad1fb0e1a0a02f63b5928b8acd2</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338585</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="SMCG">
  <data key="d7">1.0</data>
  <data key="d8">SMCG provides additional glucose data that complements HbA1c for glycemic control assessment.</data>
  <data key="d9">assessment,complement</data>
  <data key="d10">chunk-d8e26d518805695de3e4f9d41ae1d3e1</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338591</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="DCCT">
  <data key="d7">2.0</data>
  <data key="d8">The DCCT established a direct correlation between HbA1c levels and diabetes outcomes.&lt;SEP&gt;DCCT demonstrated that maintaining HbA1c below 7% reduces microvascular complications.</data>
  <data key="d9">correlation,evidence,research,target</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008&lt;SEP&gt;chunk-9dee0a79e4583f41e757f9a20f56f397</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1786370129</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="AACE">
  <data key="d7">1.0</data>
  <data key="d8">AACE clinical practice guidelines include HbA1c monitoring.</data>
  <data key="d9">guideline,inclusion</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338606</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="EASD">
  <data key="d7">1.0</data>
  <data key="d8">EASD recommendations consider HbA1c essential for diabetes care.</data>
  <data key="d9">guideline,inclusion</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338608</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Point of Care">
  <data key="d7">1.0</data>
  <data key="d8">Point‑of‑Care testing enables measurement of HbA1c from a small blood sample at the care site.</data>
  <data key="d9">enables,method</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338609</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Variability (VG)">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c does not reflect glucose variability throughout the day.</data>
  <data key="d9">does not capture,limitation</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338610</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c does not capture episodes of hypoglycemia.</data>
  <data key="d9">does not capture,limitation</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338611</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Hemoglobinopathies">
  <data key="d7">2.0</data>
  <data key="d8">Hemoglobinopathies affect the accuracy of HbA1c measurements.&lt;SEP&gt;Hemoglobinopathies interfere with HbA1c accuracy.</data>
  <data key="d9">affect,interference,measurement</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008&lt;SEP&gt;chunk-23ad6eb7138be249f01b479174a34076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372102</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Gestation">
  <data key="d7">1.0</data>
  <data key="d8">Gestation influences HbA1c values due to changes in red blood cell turnover.</data>
  <data key="d9">affect,interference</data>
  <data key="d10">chunk-7f716359c14483f9be36a73861d75008</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d12">1786338614</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Uremia">
  <data key="d7">1.0</data>
