</edge>
<edge source="Hypoglycemia" target="Coronary Artery Stenosis">
  <data key="d7">1.0</data>
  <data key="d8">Patients with significant coronary artery stenosis are at increased risk of severe hypoglycemia complications.</data>
  <data key="d9">risk</data>
