  <data key="d13"></data>
</edge>
<edge source="Sensor Glucose Value" target="SmartGuard Feature">
  <data key="d7">1.0</data>
  <data key="d8">SmartGuard uses sensor glucose (SG) values to determine appropriate bolus amounts.</data>
  <data key="d9">data,uses</data>
  <data key="d10">chunk-db5749bec4af1c3ea068b257c4376aaf</data>
