</node>
<node id="Minimum Delivery Alert">
  <data key="d0">Minimum Delivery Alert</data>
  <data key="d1">concept</data>
  <data key="d2">An alert triggered when the pump has been suspended and the minimum delivery time of three to six hours is reached.</data>
  <data key="d3">chunk-4b8de1434b9d9f57cd225b5d3e0d7f3b</data>
