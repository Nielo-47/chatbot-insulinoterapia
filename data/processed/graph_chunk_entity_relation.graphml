  <data key="d14"></data>
</edge>
<edge source="Cetoacidosis Diabética" target="Cuerpos Cetónicos">
  <data key="d8">1.0</data>
  <data key="d9">Elevated cuerpos cetónicos are a key sign of cetoacidosis diabética.</data>
  <data key="d10">diagnostic indicator,metabolic imbalance</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701032</data>
  <data key="d14"></data>
</edge>
<edge source="Cetoacidosis Diabética" target="Enfermedad">
  <data key="d8">1.0</data>
  <data key="d9">Enfermedad increases the likelihood of cetoacidosis diabética due to metabolic instability.</data>
  <data key="d10">medical complication,risk trigger</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701034</data>
  <data key="d14"></data>
</edge>
<edge source="Cetoacidosis Diabética" target="Servicio De Emergencias">
  <data key="d8">1.0</data>
  <data key="d9">Servicio de emergencias must be contacted if symptoms of cetoacidosis diabética worsen.</data>
  <data key="d10">emergency care,medical intervention</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701035</data>
  <data key="d14"></data>
</edge>
<edge source="Cetoacidosis Diabética" target="Prevención De La Cetoacidosis Diabética">
  <data key="d8">1.0</data>
  <data key="d9">La prevención de la cetoacidosis diabética tiene como objetivo evitar el desarrollo de esta complicación grave.</data>
  <data key="d10">disease management,risk prevention</data>
  <data key="d11">chunk-d0fdf7fe6f512616144e110952e56f02</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703085</data>
  <data key="d14"></data>
</edge>
<edge source="Cetoacidosis Diabética" target="Administración De Bolus">
  <data key="d8">1.0</data>
  <data key="d9">The process includes warnings to help prevent Cetoacidosis Diabética by prompting appropriate actions when GS is too high.</data>
  <data key="d10">medical warning,risk prevention</data>
  <data key="d11">chunk-69b83b1b837df0b960758dfd02d42d69</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704441</data>
  <data key="d14"></data>
</edge>
<edge source="Cuerpos Cetónicos" target="Prueba De Cuerpos Cetónicos">
  <data key="d8">1.0</data>
  <data key="d9">Prueba de cuerpos cetónicos is used to measure the level of cuerpos cetónicos in blood or urine.</data>
  <data key="d10">diagnostic testing,measurement</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701030</data>
  <data key="d14"></data>
</edge>
<edge source="Cuerpos Cetónicos" target="Control De Glucosa">
  <data key="d8">1.0</data>
  <data key="d9">La verificación de cuerpos cetónicos en caso de glucosa alta ayuda a prevenir complicaciones y mantener un control adecuado de la glucosa.</data>
  <data key="d10">monitoreo,prevención</data>
  <data key="d11">chunk-59696e5e7f94ff9d51e39d90ec169e17</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702649</data>
  <data key="d14"></data>
</edge>
<edge source="Cuerpos Cetónicos" target="Hiperglucemia Superior A 250 Mg/Dl">
  <data key="d8">1.0</data>
  <data key="d9">La presencia de cuerpos cetónicos en casos de hiperglucemia superior a 250 mg/dL puede indicar un riesgo de cetoacidosis diabética.</data>
  <data key="d10">diagnostic indicator,metabolic risk</data>
  <data key="d11">chunk-0d266340be3ade6b2a58718fd568af4f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702798</data>
  <data key="d14"></data>
</edge>
<edge source="Jeringa" target="Insulina De Acción Prolongada">
  <data key="d8">1.0</data>
  <data key="d9">La jeringa es el dispositivo empleado para inyectar insulina de acción prolongada una o dos veces al día.</data>
  <data key="d10">administración,inyección</data>
  <data key="d11">chunk-59696e5e7f94ff9d51e39d90ec169e17</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702649</data>
  <data key="d14"></data>
</edge>
<edge source="Jeringa" target="Insulina De Acción Intermedia">
  <data key="d8">1.0</data>
  <data key="d9">La jeringa se utiliza para inyectar insulina de acción intermedia, un método tradicional que contrasta con el uso de bombas de insulina.</data>
  <data key="d10">administración,inyección</data>
  <data key="d11">chunk-59696e5e7f94ff9d51e39d90ec169e17</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702650</data>
  <data key="d14"></data>
</edge>
<edge source="Lugar De Infusión" target="Equipo De Infusión">
  <data key="d8">1.0</data>
  <data key="d9">Lugar de infusión is where the equipo de infusión is placed on the body for insulin delivery.</data>
  <data key="d10">delivery site,device placement</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701033</data>
  <data key="d14"></data>
</edge>
<edge source="Equipo De Infusión" target="Hiperglucemia Inferior A 250 Mg/Dl">
  <data key="d8">1.0</data>
  <data key="d9">Un equipo de infusión desconectado o doblado puede causar hiperglucemia inexplicable que no responde al bolus de corrección.</data>
  <data key="d10">device malfunction,glucose fluctuation</data>
  <data key="d11">chunk-0d266340be3ade6b2a58718fd568af4f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702799</data>
  <data key="d14"></data>
</edge>
<edge source="Equipo De Infusión" target="Irritación Del Sitio">
  <data key="d8">1.0</data>
  <data key="d9">Es importante cambiar el equipo de infusión cada 2-3 días para prevenir irritación del sitio y otras complicaciones cutáneas.</data>
  <data key="d10">infection prevention,maintenance</data>
  <data key="d11">chunk-f7c10f0a011d51190fa761b5c0aff4ed</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703049</data>
  <data key="d14"></data>
</edge>
<edge source="Equipo De Infusión" target="Enrojecimiento/Irritación De La Piel">
  <data key="d8">1.0</data>
  <data key="d9">Enrojecimiento/irritación de la piel can occur at the site where the equipo de infusión is inserted.</data>
  <data key="d10">site complication,skin reaction</data>
  <data key="d11">chunk-01ce95c3ebe034549347b078008daa3c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703189</data>
  <data key="d14"></data>
</edge>
<edge source="Equipo De Infusión" target="Burbujas En El Tubo">
  <data key="d8">1.0</data>
  <data key="d9">Burbujas en el tubo within the equipo de infusión can block insulin delivery and require purging.</data>
  <data key="d10">flow obstruction,system malfunction</data>
  <data key="d11">chunk-01ce95c3ebe034549347b078008daa3c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703190</data>
  <data key="d14"></data>
</edge>
<edge source="Equipo De Infusión" target="Sangre En El Tubo">
  <data key="d8">1.0</data>
  <data key="d9">Sangre en el tubo may occur in the equipo de infusión and indicates a need for system replacement.</data>
  <data key="d10">backflow,system contamination</data>
  <data key="d11">chunk-01ce95c3ebe034549347b078008daa3c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703191</data>
  <data key="d14"></data>
</edge>
<edge source="Equipo De Infusión" target="Guía De Solución De Problemas">
  <data key="d8">1.0</data>
  <data key="d9">The guía de solución de problemas helps identify problems with the equipo de infusión such as blockages or leaks.</data>
  <data key="d10">issue diagnosis,system maintenance</data>
  <data key="d11">chunk-01ce95c3ebe034549347b078008daa3c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703193</data>
  <data key="d14"></data>
</edge>
<edge source="Prueba De Cuerpos Cetónicos" target="Kit De Análisis De Cetonas">
  <data key="d8">1.0</data>
  <data key="d9">Kit de análisis de cetonas is used to perform the prueba de cuerpos cetónicos.</data>
  <data key="d10">medical device,testing tool</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701031</data>
  <data key="d14"></data>
</edge>
