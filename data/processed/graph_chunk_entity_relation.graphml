</edge>
<edge source="Infusion Set" target="Removing The Infusion Set">
  <data key="d8">1.0</data>
  <data key="d9">Removing The Infusion Set from the body is a necessary step before rewinding the pump or replacing components.</data>
  <data key="d10">device maintenance,replacement procedure</data>
  <data key="d11">chunk-30fd82ff17ab8577d82477ed97f94075</data>
