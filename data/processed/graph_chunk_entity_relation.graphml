  <data key="d0">Insulin Aspart Ultrarrápida</data>
  <data key="d1">artifact</data>
  <data key="d2">A rapid‑acting insulin analogue used as a comparator for ultrarapid inhaled insulin in post‑prandial glucose control studies.</data>
  <data key="d3">chunk-ca8620e735c40bfe850134ccea9a7154</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
