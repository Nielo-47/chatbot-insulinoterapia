<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Prednisolona">
  <data key="d7">1.0</data>
  <data key="d8">Prednisolona doses &gt; 20 mg/day are linked to increased risk of glucocorticoid‑induced diabetes.</data>
  <data key="d9">dose‑dependent,risk</data>
