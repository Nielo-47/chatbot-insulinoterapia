  <data key="d5">1786329645</data>
  <data key="d6"></data>
</node>
<node id="SmartGuard Mode">
  <data key="d0">SmartGuard Mode</data>
  <data key="d1">concept</data>
  <data key="d2">SmartGuard mode automatically adjusts basal insulin and delivers correction boluses to maintain target glucose levels.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="Medtronic Website">
  <data key="d0">Medtronic Website</data>
  <data key="d1">content</data>
  <data key="d2">The Medtronic website offers information about compatible mobile devices, operating systems, and support for the MiniMed 780G system.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="Patient Therapy Data">
  <data key="d0">Patient Therapy Data</data>
  <data key="d1">data</data>
  <data key="d2">Patient therapy data are the treatment information generated by the insulin pump that can be viewed by care partners via the CareLink Connect app.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="Patient Alerts">
  <data key="d0">Patient Alerts</data>
  <data key="d1">data</data>
  <data key="d2">Patient alerts are notifications of selected therapy events that can be sent to care partners through the CareLink Connect app.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="Care Partner">
  <data key="d0">Care Partner</data>
  <data key="d1">person</data>
  <data key="d2">A care partner is an individual who can use the CareLink Connect app to view patient therapy data and receive alerts.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="Primary Display Device">
  <data key="d0">Primary Display Device</data>
  <data key="d1">artifact</data>
  <data key="d2">The primary display device shows real-time insulin pump data and is the reference for all therapy decisions.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="CareLink Share">
  <data key="d0">CareLink Share</data>
  <data key="d1">artifact</data>
  <data key="d2">CareLink Share is a licensed name under which the CareLink Connect product may be registered in some countries.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
