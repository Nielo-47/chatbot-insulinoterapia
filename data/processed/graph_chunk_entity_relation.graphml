  <data key="d13">1778707767</data>
  <data key="d14"></data>
</edge>
<edge source="Suspend Before Low" target="Two-Hour Suspend Time">
  <data key="d8">1.0</data>
  <data key="d9">If insulin delivery is suspended by the Suspend before low feature, it automatically resumes after a maximum of two hours.</data>
  <data key="d10">automatic resumption,time limit</data>
  <data key="d11">chunk-77d9c07e6a38b29ecca31e8c42df37e6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707770</data>
  <data key="d14"></data>
</edge>
<edge source="Suspend Before Low" target="Basal Insulin Delivery">
  <data key="d8">1.0</data>
  <data key="d9">Basal insulin delivery automatically resumes if sensor glucose levels rise sufficiently above the low limit after a Suspend Before Low event.</data>
  <data key="d10">glucose recovery,resumption condition</data>
  <data key="d11">chunk-77d9c07e6a38b29ecca31e8c42df37e6</data>
