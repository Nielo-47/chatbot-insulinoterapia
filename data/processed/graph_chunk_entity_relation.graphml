  <data key="d13"></data>
</edge>
<edge source="APIDRA SOLOSTAR" target="Propoxyphene">
  <data key="d7">1.0</data>
  <data key="d8">Propoxyphene can intensify the hypoglycemic effect of APIDRA SOLOSTAR.</data>
  <data key="d9">interaction,potentiation</data>
