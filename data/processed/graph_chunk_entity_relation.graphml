</node>
<node id="Actividad Acuática">
  <data key="d0">Actividad Acuática</data>
  <data key="d1">concept</data>
  <data key="d2">Aquatic activities are a common reason for manually suspending insulin infusion.</data>
  <data key="d3">chunk-63f6eb3be969569b166fc1e5f7e7567f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d5">1786322886</data>
  <data key="d6"></data>
</node>
<node id="Ducha">
  <data key="d0">Ducha</data>
  <data key="d1">concept</data>
  <data key="d2">Showering is a common reason for manually suspending insulin infusion.</data>
  <data key="d3">chunk-63f6eb3be969569b166fc1e5f7e7567f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d5">1786322886</data>
