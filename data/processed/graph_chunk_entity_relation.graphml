</edge>
<edge source="Sistema de Infusão Contínua de Insulina (SICI)" target="National Institute for Health and Care Excellence (NICE)">
  <data key="d7">2.0</data>
  <data key="d8">NICE recommends SICI as a treatment option for children younger than 12 years when multiple daily injections are impracticable or inappropriate.&lt;SEP&gt;NICE limits SICI use to patients experiencing poor glycemic control or severe hypoglycemia despite MDI therapy.</data>
  <data key="d9">glycemic control,pediatric care,recommendation,restriction</data>
  <data key="d10">chunk-277e136948d5572acf031988fd092dce</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330347</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema de Infusão Contínua de Insulina (SICI)" target="Sociedade Francesa de Diabetes (SFD)">
  <data key="d7">1.0</data>
  <data key="d8">SFD recommends SICI for patients of any age who have persistently elevated HbA1c, recurrent hypoglycemia, high glucose variability, variable insulin needs, insulin allergy, or negative social impact from MDI.</data>
  <data key="d9">clinical criteria,recommendation</data>
  <data key="d10">chunk-277e136948d5572acf031988fd092dce</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330348</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema de Infusão Contínua de Insulina (SICI)" target="International Diabetes Federation (IDF)">
  <data key="d7">1.0</data>
  <data key="d8">IDF states that SICI should be available and considered for pediatric and adolescent patients when proper education and support are provided.</data>
  <data key="d9">pediatric support,recommendation</data>
  <data key="d10">chunk-277e136948d5572acf031988fd092dce</data>
