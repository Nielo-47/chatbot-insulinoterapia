  <data key="d1">person</data>
  <data key="d2">Dental surgeon who may be consulted regarding medication use during lactation.</data>
  <data key="d3">chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319739</data>
  <data key="d6"></data>
</node>
<node id="Uso de Medicamento no Período da Lactação">
  <data key="d0">Uso de Medicamento no Período da Lactação</data>
  <data key="d1">concept</data>
  <data key="d2">Administration of the medication during breastfeeding, requiring evaluation by a physician or dentist.</data>
  <data key="d3">chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319739</data>
  <data key="d6"></data>
</node>
<node id="Locais Médicos Apropriados">
  <data key="d0">Locais Médicos Apropriados</data>
  <data key="d1">concept</data>
  <data key="d2">Appropriate medical facilities where intravenous glucose or glucagon can be administered.</data>
  <data key="d3">chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319739</data>
  <data key="d6"></data>
</node>
<node id="Disposable Needle">
  <data key="d0">Disposable Needle</data>
  <data key="d1">artifact</data>
  <data key="d2">Disposable needles are single‑use devices used with syringes for insulin injection and must be compatible with subcutaneous administration.</data>
  <data key="d3">chunk-8ac99e7359716e2cecc2ec93159218b6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319739</data>
  <data key="d6"></data>
</node>
<node id="Lipo-Hipertrofia (LH)">
  <data key="d0">Lipo-Hipertrofia (LH)</data>
  <data key="d1">concept</data>
  <data key="d2">Lipo-Hipertrofia is the more common type of lipodystrophy, presenting as hard nodules caused by fat accumulation at injection sites.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320223</data>
  <data key="d6"></data>
</node>
<node id="Lipohypertrophy Nodule">
  <data key="d0">Lipohypertrophy Nodule</data>
  <data key="d1">concept</data>
  <data key="d2">Lipohypertrophy Nodule is a hard lump formed at an insulin injection site due to lipo-hipertrofia.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320224</data>
  <data key="d6"></data>
</node>
<node id="Blood Glucose Variation">
  <data key="d0">Blood Glucose Variation</data>
  <data key="d1">concept</data>
  <data key="d2">Blood Glucose Variation refers to large swings in glucose levels throughout the day caused by irregular insulin absorption.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320224</data>
  <data key="d6"></data>
</node>
<node id="Reduced Insulin Efficacy">
  <data key="d0">Reduced Insulin Efficacy</data>
  <data key="d1">concept</data>
  <data key="d2">Reduced Insulin Efficacy is the diminished effectiveness of insulin when injected into a lipohypertrophy nodule.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320224</data>
  <data key="d6"></data>
</node>
<node id="Postprandial Glucose Increase">
  <data key="d0">Postprandial Glucose Increase</data>
  <data key="d1">concept</data>
  <data key="d2">Postprandial Glucose Increase denotes higher blood sugar after meals, reported up to 26% when insulin is injected into a nodule.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320224</data>
  <data key="d6"></data>
</node>
<node id="Blood Glucose &gt;300 mg/dL">
  <data key="d0">Blood Glucose &gt;300 mg/dL</data>
  <data key="d1">data</data>
  <data key="d2">Blood Glucose &gt;300 mg/dL is a reported measurement observed in some patients after injecting insulin into nodular areas.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320225</data>
  <data key="d6"></data>
</node>
<node id="New Needle Use">
  <data key="d0">New Needle Use</data>
  <data key="d1">method</data>
  <data key="d2">New Needle Use is the practice of using a fresh needle for each insulin injection to lower risk of lipo-hipertrofia.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320225</data>
  <data key="d6"></data>
</node>
<node id="Application Site (Altered Area)">
  <data key="d0">Application Site (Altered Area)</data>
  <data key="d1">concept</data>
  <data key="d2">Application Site (Altered Area) refers to skin regions affected by lipo-hipertrofia that should be avoided for insulin injection.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320225</data>
  <data key="d6"></data>
</node>
<node id="Frequent Glucose Monitoring">
  <data key="d0">Frequent Glucose Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Frequent Glucose Monitoring is the recommendation to measure blood glucose more often during transition from altered to healthy injection sites.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320225</data>
  <data key="d6"></data>
</node>
<node id="Improper Injection Site Rotation">
  <data key="d0">Improper Injection Site Rotation</data>
  <data key="d1">concept</data>
  <data key="d2">Improper Injection Site Rotation refers to the failure to alternate insulin injection locations, contributing to lipohypertrophy.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320225</data>
  <data key="d6"></data>
</node>
<node id="Prolonged Same Site Insulin Use">
  <data key="d0">Prolonged Same Site Insulin Use</data>
  <data key="d1">concept</data>
  <data key="d2">Prolonged Same Site Insulin Use describes injecting insulin repeatedly into the same skin spot over an extended period, a cause of lipohypertrophy.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320225</data>
  <data key="d6"></data>
</node>
<node id="Reduced Skin Sensitivity">
  <data key="d0">Reduced Skin Sensitivity</data>
  <data key="d1">concept</data>
  <data key="d2">Reduced Skin Sensitivity denotes decreased pain perception in skin areas affected by lipohypertrophy.</data>
  <data key="d3">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d5">1786320225</data>
  <data key="d6"></data>
</node>
<node id="Berardinelli-Seip Syndrome">
  <data key="d0">Berardinelli-Seip Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Berardinelli‑Seip syndrome is a congenital generalized form of lipodystrophy.&lt;SEP&gt;A genetic generalized lipodystrophy described as inherited (type 1‑4) in the text.&lt;SEP&gt;Berardinelli‑Seip syndrome is an alternate name for Berardinelli‑Seip congenital lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-336c6084eb6cb7c8ada29ed26c0cd20d&lt;SEP&gt;chunk-003b19adf9ab32e9587902e8d639d701</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321213</data>
  <data key="d6"></data>
</node>
<node id="Lawrence Syndrome">
  <data key="d0">Lawrence Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Lawrence syndrome is an acquired generalized form of lipodystrophy.&lt;SEP&gt;An acquired generalized lipodystrophy syndrome distinguished from Berardinelli‑Seip by normal early fat distribution.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-003b19adf9ab32e9587902e8d639d701</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321213</data>
  <data key="d6"></data>
</node>
<node id="Lipodystrophy Generalized Inherited">
  <data key="d0">Lipodystrophy Generalized Inherited</data>
  <data key="d1">concept</data>
  <data key="d2">Inherited form of generalized lipodystrophy associated with Berardinelli‑Seip syndrome.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321213</data>
  <data key="d6"></data>
</node>
<node id="Lipodystrophy Generalized Acquired">
  <data key="d0">Lipodystrophy Generalized Acquired</data>
  <data key="d1">concept</data>
  <data key="d2">Acquired form of generalized lipodystrophy associated with Lawrence syndrome.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321213</data>
  <data key="d6"></data>
</node>
<node id="Lipodystrophy Congenita">
  <data key="d0">Lipodystrophy Congenita</data>
  <data key="d1">concept</data>
  <data key="d2">Congenital generalized lipodystrophy (LCG) referenced in patient evaluations.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321213</data>
  <data key="d6"></data>
</node>
<node id="AGPAT2">
  <data key="d0">AGPAT2</data>
  <data key="d1">concept</data>
  <data key="d2">Gene whose mutation defines type 1 of Berardinelli‑Seip syndrome.&lt;SEP&gt;AGPAT2 is a gene that is mutated in congenital generalized lipodystrophy linked to chromosome 9q34.&lt;SEP&gt;AGPAT2 is a gene whose homozygous or compound heterozygous mutations cause congenital generalized lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-336c6084eb6cb7c8ada29ed26c0cd20d&lt;SEP&gt;chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373086</data>
  <data key="d6"></data>
</node>
<node id="BSCL2">
  <data key="d0">BSCL2</data>
  <data key="d1">concept</data>
  <data key="d2">Gene whose mutation defines type 2 of Berardinelli‑Seip syndrome.&lt;SEP&gt;BSCL2 is a gene implicated in congenital generalized lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373086</data>
  <data key="d6"></data>
</node>
<node id="CAV1">
  <data key="d0">CAV1</data>
  <data key="d1">concept</data>
  <data key="d2">Gene whose mutation defines type 3 of Berardinelli‑Seip syndrome.&lt;SEP&gt;CAV1 is a gene associated with congenital generalized lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373086</data>
  <data key="d6"></data>
</node>
<node id="CAVIN1">
  <data key="d0">CAVIN1</data>
  <data key="d1">concept</data>
  <data key="d2">Gene whose mutation defines type 4 of Berardinelli‑Seip syndrome and is present in muscle cells.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Hypertriglyceridemia">
  <data key="d0">Hypertriglyceridemia</data>
  <data key="d1">concept</data>
  <data key="d2">Hypertriglyceridemia refers to severe elevation of triglycerides and is a feature of metabolic syndrome.&lt;SEP&gt;Hypertriglyceridemia is elevated blood triglyceride levels observed in individuals with lipodystrophies.&lt;SEP&gt;Elevated triglyceride levels associated with Lpf Tipo 4.&lt;SEP&gt;Elevated serum triglyceride levels commonly observed in patients, sometimes exceeding 2000 mg/dL.&lt;SEP&gt;Elevated triglyceride levels common in patients, potentially causing acute pancreatitis.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-f86b5a9c60ab13c2016dd454edf634c7&lt;SEP&gt;chunk-003b19adf9ab32e9587902e8d639d701&lt;SEP&gt;chunk-383b02cc66391d66174344ff49464766&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Hypertriglyceridemia &gt; 2000 mg/dL">
  <data key="d0">Hypertriglyceridemia &gt; 2000 mg/dL</data>
  <data key="d1">data</data>
  <data key="d2">A reported threshold indicating severe hypertriglyceridemia in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Leptin">
  <data key="d0">Leptin</data>
  <data key="d1">concept</data>
  <data key="d2">Leptin is a hormone with normal or elevated serum levels in lipodystrophy, often accompanied by reduced adiponectin.&lt;SEP&gt;Hormone found at very low serum levels in patients, contributing to metabolic disturbances.&lt;SEP&gt;A hormone whose low serum dosage can aid diagnostic confirmation of lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-f86b5a9c60ab13c2016dd454edf634c7&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Hyperphagia">
  <data key="d0">Hyperphagia</data>
  <data key="d1">concept</data>
  <data key="d2">Excessive eating behavior linked to low leptin levels in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Hypertension">
  <data key="d0">Hypertension</data>
  <data key="d1">concept</data>
  <data key="d2">Hypertension is high blood pressure reported as a comorbidity of lipodystrophies.&lt;SEP&gt;Elevated arterial blood pressure reported in about one third of patients.&lt;SEP&gt;Elevated blood pressure, noted as a screening factor and present in 26.3% of adolescents with type 2 diabetes.&lt;SEP&gt;High blood pressure (≥130/80 mmHg or receiving therapy), listed as a risk factor.&lt;SEP&gt;High blood pressure, noted as a condition that enhances risk for Type 2 Diabetes.&lt;SEP&gt;Hypertension is a cardiovascular condition associated with type 2 diabetes.&lt;SEP&gt;Hypertension is a high‑blood‑pressure condition examined as a risk factor for incident diabetes.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-003b19adf9ab32e9587902e8d639d701&lt;SEP&gt;chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-ca8741dfdb9ff0f12f049953db6cb9c0&lt;SEP&gt;chunk-9ab98b1c07f7bbaa3ad28fb83167f489&lt;SEP&gt;chunk-1a111d4b40ec241cf54126f594a80308&lt;SEP&gt;chunk-9eb02ab1ab7d834858bf60a8b402e6ea</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377326</data>
  <data key="d6"></data>
</node>
<node id="Hepatomegaly">
  <data key="d0">Hepatomegaly</data>
  <data key="d1">concept</data>
  <data key="d2">Hepatomegaly is an enlarged liver, listed among metabolic‑syndrome manifestations.&lt;SEP&gt;Enlarged liver frequently detected in patients, often in childhood.&lt;SEP&gt;Enlargement of the liver that improves with metreleptin therapy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-f86b5a9c60ab13c2016dd454edf634c7&lt;SEP&gt;chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Xanthomas Eruptive">
  <data key="d0">Xanthomas Eruptive</data>
  <data key="d1">concept</data>
  <data key="d2">Skin lesions that may appear in patients indicating important hypertriglyceridemia.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Acanthosis Nigricans">
  <data key="d0">Acanthosis Nigricans</data>
  <data key="d1">concept</data>
  <data key="d2">Acanthosis nigricans is a skin condition that forms part of metabolic‑syndrome presentation.&lt;SEP&gt;Acanthosis nigricans is skin hyperpigmentation often present in insulin‑resistant lipodystrophy patients.&lt;SEP&gt;Skin pigmentation sign observed in patients.&lt;SEP&gt;A skin condition that worsens with intensified insulin resistance.&lt;SEP&gt;A skin condition present in about 90% of children with type 2 diabetes, used as a screening indicator.&lt;SEP&gt;A skin condition associated with insulin resistance, listed as a risk factor.&lt;SEP&gt;Acanthosis nigricans is a skin condition indicating insulin resistance.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-f86b5a9c60ab13c2016dd454edf634c7&lt;SEP&gt;chunk-003b19adf9ab32e9587902e8d639d701&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9&lt;SEP&gt;chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-ca8741dfdb9ff0f12f049953db6cb9c0&lt;SEP&gt;chunk-1a111d4b40ec241cf54126f594a80308</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377327</data>
  <data key="d6"></data>
</node>
<node id="Acrocordons">
  <data key="d0">Acrocordons</data>
  <data key="d1">concept</data>
  <data key="d2">Skin lesions noted among phenotypic alterations in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Hypertrichosis">
  <data key="d0">Hypertrichosis</data>
  <data key="d1">concept</data>
  <data key="d2">Excessive hair growth reported as a phenotypic sign in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="CPK Elevation">
  <data key="d0">CPK Elevation</data>
  <data key="d1">concept</data>
  <data key="d2">Increased creatine phosphokinase levels found in patients with lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321214</data>
  <data key="d6"></data>
</node>
<node id="Muscle Weakness">
  <data key="d0">Muscle Weakness</data>
  <data key="d1">concept</data>
  <data key="d2">Reduced muscle strength reported in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="Paniculitis">
  <data key="d0">Paniculitis</data>
  <data key="d1">concept</data>
  <data key="d2">Inflammatory condition associated with type 1 acquired lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="Autoimmune Disease">
  <data key="d0">Autoimmune Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Autoimmune conditions associated with type 2 acquired lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="Idiopathic">
  <data key="d0">Idiopathic</data>
  <data key="d1">concept</data>
  <data key="d2">Unspecified cause associated with type 3 acquired lipodystrophy.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="Muscle Cells">
  <data key="d0">Muscle Cells</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cellular structures of muscle tissue where CAVIN1 protein is present.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="LCG">
  <data key="d0">LCG</data>
  <data key="d1">concept</data>
  <data key="d2">Abbreviation for Lipodystrophy Congenita (congenital generalized lipodystrophy) used throughout the text.&lt;SEP&gt;Lipodystrophy condition (type 2) with high mortality, often causing death before age 30.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="Bichat Fat Pad">
  <data key="d0">Bichat Fat Pad</data>
  <data key="d1">concept</data>
  <data key="d2">The fat pad of Bichat, whose absence is noted as a phenotypic sign in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="Polycystic Ovary Syndrome">
  <data key="d0">Polycystic Ovary Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Polycystic Ovary Syndrome (SOP) is an endocrine disorder linked to lipodystrophies.&lt;SEP&gt;Referred to as SOP in Portuguese, a condition with insulin resistance similar to that seen in patients.&lt;SEP&gt;A hormonal disorder present in 26% of girls with type 2 diabetes, listed as a screening factor.&lt;SEP&gt;A hormonal disorder linked to increased risk of Type 2 Diabetes.&lt;SEP&gt;Polycystic ovary syndrome is a hormonal disorder associated with insulin resistance.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-003b19adf9ab32e9587902e8d639d701&lt;SEP&gt;chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-1a111d4b40ec241cf54126f594a80308&lt;SEP&gt;chunk-9eb02ab1ab7d834858bf60a8b402e6ea</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377426</data>
  <data key="d6"></data>
</node>
<node id="Prader-Willi Syndrome">
  <data key="d0">Prader-Willi Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic syndrome mentioned as a comparison for hyperphagia in patients.&lt;SEP&gt;Prader-Willi Syndrome is a genetic disorder listed among other syndromes associated with diabetes mellitus.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-429fba9c3900b6d0b0c3ccfb38323e54</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786372990</data>
  <data key="d6"></data>
</node>
<node id="TGP">
  <data key="d0">TGP</data>
  <data key="d1">concept</data>
  <data key="d2">Alanine aminotransferase enzyme whose levels rise in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321215</data>
  <data key="d6"></data>
</node>
<node id="TGO">
  <data key="d0">TGO</data>
  <data key="d1">concept</data>
  <data key="d2">Aspartate aminotransferase enzyme whose levels rise in patients.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="GGT">
  <data key="d0">GGT</data>
  <data key="d1">concept</data>
  <data key="d2">Gamma‑glutamyl transferase enzyme elevated in patients.&lt;SEP&gt;Gamma‑glutamyl transferase, a liver enzyme frequently elevated in hepatic steatosis.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="Cirrhosis">
  <data key="d0">Cirrhosis</data>
  <data key="d1">concept</data>
  <data key="d2">Advanced liver disease stage mentioned where transaminases normalize.&lt;SEP&gt;Advanced liver disease where transaminase levels normalize and platelet count decreases.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="Platelet Count">
  <data key="d0">Platelet Count</data>
  <data key="d1">concept</data>
  <data key="d2">Decrease in platelet numbers observed in advanced disease stage.&lt;SEP&gt;Laboratory measure of platelets that decreases in advanced liver disease and serves as a mortality indicator.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="Transaminases">
  <data key="d0">Transaminases</data>
  <data key="d1">concept</data>
  <data key="d2">Liver enzymes (including TGP, TGO, GGT) whose levels change during disease.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="LCG Type 1">
  <data key="d0">LCG Type 1</data>
  <data key="d1">concept</data>
  <data key="d2">Subtype of congenital generalized lipodystrophy with AGPAT2 mutation, may have fat in palms and soles.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="LCG Type 2">
  <data key="d0">LCG Type 2</data>
  <data key="d1">concept</data>
  <data key="d2">Subtype of congenital generalized lipodystrophy with BSCL2 mutation, associated with greater fat loss and cognitive deficit.</data>
  <data key="d3">chunk-5c6243c304001345b8f15d1659f91051</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="Lipodistrofias Parciais">
  <data key="d0">Lipodistrofias Parciais</data>
  <data key="d1">concept</data>
  <data key="d2">Partial lipodystrophies, disorders characterized by loss of adipose tissue in specific regions and associated metabolic complications.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="Lipodistrofia Generalizada">
  <data key="d0">Lipodistrofia Generalizada</data>
  <data key="d1">concept</data>
  <data key="d2">Generalized lipodystrophy, a severe form involving widespread loss of adipose tissue, treated with metreleptin.&lt;SEP&gt;Lipodistrofia Generalizada denotes extensive loss of adipose tissue throughout the body.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5&lt;SEP&gt;chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373085</data>
  <data key="d6"></data>
</node>
<node id="Lipodistrofia Associada ao HIV">
  <data key="d0">Lipodistrofia Associada ao HIV</data>
  <data key="d1">concept</data>
  <data key="d2">HIV‑related lipodystrophy affecting up to 50 % of seropositive individuals, presenting with partial loss of facial, limb and buttock fat, possible cervical, dorsal and abdominal fat accumulation, double‑chin appearance, gibosity and variable truncal adiposity.&lt;SEP&gt;HIV‑associated lipodystrophy, a condition linked to antiretroviral therapy and metabolic disturbances.&lt;SEP&gt;A form of lipodystrophy occurring in patients with HIV, characterized by abnormal fat distribution.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5&lt;SEP&gt;chunk-e3ed9d0b8e96400d871602cdd7862d35&lt;SEP&gt;chunk-f54dda12a0c5f43832ff3c6f0dc78369</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321216</data>
  <data key="d6"></data>
</node>
<node id="Síndrome de Resistência à Insulina Tipo A">
  <data key="d0">Síndrome de Resistência à Insulina Tipo A</data>
  <data key="d1">concept</data>
  <data key="d2">Type A insulin‑resistance syndrome, a genetic disorder affecting insulin‑receptor function.&lt;SEP&gt;Síndrome de Resistência à Insulina Tipo A is a genetic insulin‑resistance syndrome.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5&lt;SEP&gt;chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373022</data>
  <data key="d6"></data>
</node>
<node id="Síndrome de Resistência à Insulina Tipo B">
  <data key="d0">Síndrome de Resistência à Insulina Tipo B</data>
  <data key="d1">concept</data>
  <data key="d2">Type B insulin‑resistance syndrome, an autoimmune form targeting the insulin receptor.&lt;SEP&gt;Síndrome de Resistência à Insulina Tipo B is an antibody‑mediated insulin‑resistance syndrome causing diabetes.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5&lt;SEP&gt;chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373029</data>
  <data key="d6"></data>
</node>
<node id="Leprechaunismo">
  <data key="d0">Leprechaunismo</data>
  <data key="d1">concept</data>
  <data key="d2">Leprechaunism (Donohue syndrome), an extreme congenital insulin‑resistance condition.&lt;SEP&gt;Leprechaunismo is a rare genetic disorder associated with diabetes.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5&lt;SEP&gt;chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373022</data>
  <data key="d6"></data>
</node>
<node id="Síndrome de Cushing">
  <data key="d0">Síndrome de Cushing</data>
  <data key="d1">concept</data>
  <data key="d2">Cushing syndrome, a hormonal disorder causing metabolic imbalance.&lt;SEP&gt;Síndrome de Cushing is a cortisol‑excess syndrome that predisposes to diabetes.&lt;SEP&gt;Síndrome de Cushing is an endocrinopathy relevant to diabetes classification.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5&lt;SEP&gt;chunk-72da6fb8b6a9ed059d146b43a3174f90&lt;SEP&gt;chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373025</data>
  <data key="d6"></data>
</node>
<node id="Tiazolidinedionas (TZD)">
  <data key="d0">Tiazolidinedionas (TZD)</data>
  <data key="d1">artifact</data>
  <data key="d2">Oral insulin‑sensitizing agents that increase peripheral subcutaneous fat, reduce visceral fat, and lower hepatic inflammation.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321217</data>
  <data key="d6"></data>
</node>
<node id="Metreleptina">
  <data key="d0">Metreleptina</data>
  <data key="d1">artifact</data>
  <data key="d2">Recombinant human leptin approved for treating generalized lipodystrophy.&lt;SEP&gt;Metreleptina is recombinant leptin therapy indicated for generalized and selected partial lipodystrophy.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5&lt;SEP&gt;chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373087</data>
  <data key="d6"></data>
</node>
<node id="Estatinas">
  <data key="d0">Estatinas</data>
  <data key="d1">artifact</data>
  <data key="d2">Cholesterol‑lowering medications that may interact with gemfibrozila, increasing myopathy risk.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321218</data>
  <data key="d6"></data>
</node>
<node id="Gemfibrozila">
  <data key="d0">Gemfibrozila</data>
  <data key="d1">artifact</data>
  <data key="d2">Fibrate that elevates serum statin levels, raising the risk of statin‑induced myopathy.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321218</data>
  <data key="d6"></data>
</node>
<node id="Niacina">
  <data key="d0">Niacina</data>
  <data key="d1">artifact</data>
  <data key="d2">Vitamin B3 used for lipid control but can exacerbate insulin resistance.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321218</data>
  <data key="d6"></data>
</node>
<node id="Omega‑3">
  <data key="d0">Omega‑3</data>
  <data key="d1">artifact</data>
  <data key="d2">Polyunsaturated fatty‑acid supplement (5–10 g/day) that lowers serum triglycerides and may slow atherosclerosis.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321218</data>
  <data key="d6"></data>
</node>
<node id="Triglicerídeos de Cadeia Média">
  <data key="d0">Triglicerídeos de Cadeia Média</data>
  <data key="d1">artifact</data>
  <data key="d2">Medium‑chain triglycerides proposed as beneficial nutritional support for lipodystrophy patients.</data>
  <data key="d3">chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321218</data>
  <data key="d6"></data>
</node>
<node id="DXA">
  <data key="d0">DXA</data>
  <data key="d1">method</data>
