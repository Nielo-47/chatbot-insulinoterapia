  <data key="d13">1778703193</data>
  <data key="d14"></data>
</edge>
<edge source="Bomba De Insulina" target="Guía De Solución De Problemas">
  <data key="d8">1.0</data>
  <data key="d9">The guía de solución de problemas includes verifying bomba de insulina settings such as basal rates and time.</data>
  <data key="d10">configuration check,system troubleshooting</data>
  <data key="d11">chunk-01ce95c3ebe034549347b078008daa3c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703195</data>
  <data key="d14"></data>
</edge>
<edge source="Bomba De Insulina" target="Cetoacidosis Diabetica">
  <data key="d8">1.0</data>
  <data key="d9">La interrupcion del suministro de insulina mediante la bomba puede provocar rapidamente cetoacidosis diabetica.</data>
  <data key="d10">device interruption,treatment risk</data>
  <data key="d11">chunk-17d4cfa9183f9c1eb5a0c2212479127a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703201</data>
  <data key="d14"></data>
</edge>
<edge source="CGM" target="Multiple Daily Insulin Injections">
  <data key="d8">1.0</data>
  <data key="d9">People using multiple daily insulin injections benefit from CGM by better adjusting insulin doses based on continuous data.</data>
  <data key="d10">dosage adjustment,treatment support</data>
  <data key="d11">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694582</data>
  <data key="d14"></data>
</edge>
<edge source="CGM" target="Glucose Measurement Every 5 Minutes">
  <data key="d8">1.0</data>
  <data key="d9">CGM provides glucose readings every 5 minutes, enabling constant tracking without frequent finger pricks.</data>
  <data key="d10">continuous monitoring,data frequency</data>
  <data key="d11">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694583</data>
  <data key="d14"></data>
</edge>
<edge source="CGM" target="Glucose Trend Arrows">
  <data key="d8">1.0</data>
  <data key="d9">CGM displays trend arrows to show whether glucose is rising, falling, or stable, aiding in proactive management.</data>
  <data key="d10">predictive insight,trend analysis</data>
  <data key="d11">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694584</data>
  <data key="d14"></data>
</edge>
<edge source="CGM" target="Low Glucose Alarm">
  <data key="d8">1.0</data>
  <data key="d9">The CGM can trigger alarms when glucose levels are dangerously low, helping prevent severe hypoglycemic events.</data>
  <data key="d10">hypoglycemia prevention,safety feature</data>
  <data key="d11">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694584</data>
  <data key="d14"></data>
</edge>
<edge source="CGM" target="High Glucose Alarm">
  <data key="d8">1.0</data>
  <data key="d9">The CGM alerts users when glucose levels are too high, allowing timely corrective action.</data>
  <data key="d10">hyperglycemia prevention,safety feature</data>
  <data key="d11">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694585</data>
  <data key="d14"></data>
</edge>
