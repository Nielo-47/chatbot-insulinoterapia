  <data key="d0">Water for Injectables</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Water for injectables is an excipient component of the Tresiba® formulation.</data>
  <data key="d3">chunk-e590341aac73dca916e560c2df9e60e0</data>
