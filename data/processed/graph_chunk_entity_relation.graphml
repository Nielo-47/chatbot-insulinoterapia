  <data key="d14"></data>
</edge>
<edge source="Easy Bolus" target="MiniMed 780G Insulin Pump">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G insulin pump supports the Easy bolus feature for fast and convenient insulin delivery after setup.</data>
