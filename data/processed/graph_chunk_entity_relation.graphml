  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704431</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus Cuadrado" target="Gastroparesis">
  <data key="d8">1.0</data>
  <data key="d9">Bolus cuadrado is useful for individuals with gastroparesis to counteract delayed digestion of carbohydrates.</data>
  <data key="d10">clinical application,delayed digestion</data>
