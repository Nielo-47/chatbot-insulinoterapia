  <data key="d14"></data>
</edge>
<edge source="Hyperglycemia" target="Glucose Trend Chart">
  <data key="d8">1.0</data>
  <data key="d9">The glucose trend chart helps detect causes of hyperglycemia, such as delayed insulin absorption or high-protein meals.</data>
  <data key="d10">pattern recognition,risk identification</data>
