  <data key="d5">1778710028</data>
  <data key="d6"></data>
  <data key="d7">Metformina</data>
</node>
<node id="Diagnosis of Diabetes">
  <data key="d0">Diagnosis of Diabetes</data>
  <data key="d1">event</data>
  <data key="d2">Diagnosis of diabetes refers to the clinical determination of diabetes type, which can be challenging in adults due to overlapping phenotypes between Type 1 and Type 2.&lt;SEP&gt;The diagnosis of diabetes involves classification into types based on etiology, including autoimmune, monogenic, and type 2 diabetes.</data>
  <data key="d3">chunk-8631f035300b1b65337131c6c6079b19&lt;SEP&gt;chunk-1fb7f10473b84f2de23852febe7ef317&lt;SEP&gt;chunk-eb9c311fc732ddd262c56ddc696da954</data>
