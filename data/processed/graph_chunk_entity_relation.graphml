<edge source="Lipohypertrophy" target="Insulin Injection Technique">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy develops in patients due to improper insulin injection technique.</data>
  <data key="d9">clinical complication</data>
  <data key="d10">chunk-e480a6a15b0d8e7069746e3f3f788f80</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298854</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Irregular Insulin Absorption">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy creates irregular insulin absorption, making uptake either too rapid or too slow.</data>
  <data key="d9">cause,tissue change</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299862</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Reduced Pain Sensitivity">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophic skin areas become less sensitive to pain.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299863</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Rotation of Injection Sites">
  <data key="d7">1.0</data>
  <data key="d8">Rotating injection sites helps prevent the development of lipohypertrophy.</data>
  <data key="d9">prevention</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299864</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Use of New Needle Each Application">
  <data key="d7">1.0</data>
  <data key="d8">Using a fresh needle for each injection reduces the risk of lipohypertrophy.</data>
  <data key="d9">prevention</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299864</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Skin Inspection">
  <data key="d7">1.0</data>
  <data key="d8">Performing skin inspection before injection helps identify and avoid lipohypertrophic areas.</data>
  <data key="d9">detection,prevention</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299866</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Large Glycemic Variability">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy causes large glycemic variability due to erratic insulin uptake.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299867</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Tissue Recovery Time">
  <data key="d7">1.0</data>
  <data key="d8">Presence of lipohypertrophy requires a period of tissue recovery before the site can be reused.</data>
  <data key="d9">necessitates</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299868</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Avoid Repeated Injection at Same Point">
  <data key="d7">1.0</data>
  <data key="d8">Not injecting repeatedly in the same spot reduces the development of lipohypertrophy.</data>
  <data key="d9">prevention</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299868</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Skin Palpation">
  <data key="d7">1.0</data>
  <data key="d8">Palpating the skin helps detect hidden nodules indicative of lipohypertrophy.</data>
  <data key="d9">detection</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299869</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Lipohypertrophic Nodule">
  <data key="d7">1.0</data>
  <data key="d8">A lipohypertrophic nodule is a manifestation of lipohypertrophy.</data>
  <data key="d9">part_of</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299869</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Repeated Insulin Injection">
  <data key="d7">1.0</data>
  <data key="d8">Repeated insulin injections in the same area can lead to lipohypertrophy, a hardened skin nodule.</data>
  <data key="d9">complication,risk</data>
  <data key="d10">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299927</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Injection Site Rotation">
  <data key="d7">2.0</data>
  <data key="d8">Rotating injection sites helps prevent the development of lipohypertrophy.&lt;SEP&gt;Proper injection site rotation reduces the risk of developing lipohypertrophy.</data>
  <data key="d9">mitigation,prevention,prevents</data>
  <data key="d10">chunk-708e3c514f667dc9979cfa8df875e473&lt;SEP&gt;chunk-c7e6ef38db0b62d161b13473af47d738</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Documento sem título.docx</data>
  <data key="d12">1786330504</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Skin Lesion">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy is a type of skin lesion that forms from repeated insulin injections in the same spot.</data>
  <data key="d9">type of</data>
  <data key="d10">chunk-708e3c514f667dc9979cfa8df875e473</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1786300326</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Hyperglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy impairs insulin absorption, leading to hyperglycemia.</data>
  <data key="d9">complication,consequence</data>
  <data key="d10">chunk-cc6a26a5d2c41087b58a0f7f71ad21cc</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d12">1786301093</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Administration of Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Failure to rotate injection sites can cause lipohypertrophy, a depot of extra subcutaneous fat.</data>
  <data key="d9">complication,rotation</data>
  <data key="d10">chunk-cc6a26a5d2c41087b58a0f7f71ad21cc</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d12">1786301095</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Subcutaneous Tissue and Skin Disorders">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy is recorded under subcutaneous tissue and skin disorders.</data>
  <data key="d9">categorization</data>
  <data key="d10">chunk-5c580ebfc111aa29796af1a6f15941c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d12">1786310122</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="BASAGLAR">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy was reported as an adverse reaction for BASAGLAR in type 1 diabetes patients.</data>
  <data key="d9">adverse event occurrence</data>
  <data key="d10">chunk-5c580ebfc111aa29796af1a6f15941c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d12">1786310124</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Lantus®">
  <data key="d7">1.0</data>
  <data key="d8">Lipohypertrophy was reported as an adverse reaction for Lantus® in type 2 diabetes patients.</data>
  <data key="d9">adverse event occurrence</data>
  <data key="d10">chunk-5c580ebfc111aa29796af1a6f15941c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d12">1786310125</data>
  <data key="d13"></data>
</edge>
<edge source="Lipohypertrophy" target="Insulina Glargina 100 U/mL">
  <data key="d7">1.0</data>
  <data key="d8">Clinical studies reported lipohypertrophy in 1‑2% of patients using insulin glargina.</data>
  <data key="d9">adverse effect,lipohypertrophy</data>
  <data key="d10">chunk-e8934881ec5ab7cfeb836126b3f0e8b2</data>
