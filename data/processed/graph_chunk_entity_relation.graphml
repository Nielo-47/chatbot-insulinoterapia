  <data key="d13">1778696011</data>
  <data key="d14"></data>
</edge>
<edge source="American Diabetes Association" target="Traveler">
  <data key="d8">1.0</data>
  <data key="d9">The American Diabetes Association advises travelers with diabetes to contact them at 1.703.549.1500 ext. 1768 if they encounter problems during security screening.</data>
  <data key="d10">advocacy,support</data>
