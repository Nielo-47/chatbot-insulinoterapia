  <data key="d5">1786377380</data>
  <data key="d6"></data>
</node>
<node id="Mortality Reduction">
  <data key="d0">Mortality Reduction</data>
  <data key="d1">concept</data>
  <data key="d2">Mortality Reduction denotes the 42 % decrease in death observed when normoglycemia was achieved with Novolin® R (8 % vs 4.6 %).&lt;SEP&gt;Mortality reduction refers to the observed 42 % decrease in death among ICU patients receiving intravenous Novolin® R.</data>
  <data key="d3">chunk-2378c57a337d1ce7103c7086ebba76ac&lt;SEP&gt;chunk-cd40a6d69921cf300ed8eda043698d1a</data>
