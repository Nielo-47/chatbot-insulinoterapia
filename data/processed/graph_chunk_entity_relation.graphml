</edge>
<edge source="Hipoglicemia" target="Sintomas de Hipoglicemia Leve a Moderada">
  <data key="d7">1.0</data>
  <data key="d8">Hipoglicemia presents mild to moderate symptoms such as sweating, dizziness, and tremor.</data>
