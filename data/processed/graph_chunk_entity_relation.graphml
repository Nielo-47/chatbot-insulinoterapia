  <data key="d6"></data>
</node>
<node id="Graft Survival">
  <data key="d0">Graft Survival</data>
  <data key="d1">concept</data>
  <data key="d2">Graft survival is the continued function of a transplanted organ, mentioned as a benefit of immunosuppressive regimens regardless of PTDM risk.</data>
  <data key="d3">chunk-9cdf6af658e42c2f4f7dca5e4dbdd3db</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
