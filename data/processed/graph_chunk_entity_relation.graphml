<edge source="Resume Basal Alert" target="MiniMed™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G activates the Resume Basal Alert when insulin infusion resumes automatically after glucose levels rise.</data>
