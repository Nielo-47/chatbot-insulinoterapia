  <data key="d14"></data>
</edge>
<edge source="Basal Rate" target="24-Hour Cycle">
  <data key="d8">1.0</data>
  <data key="d9">Basal rates are programmed across the 24-hour cycle to match the body's varying insulin needs throughout the day and night.</data>
  <data key="d10">insulin scheduling,time-based delivery</data>
