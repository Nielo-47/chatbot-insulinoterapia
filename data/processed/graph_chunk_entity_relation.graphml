  <data key="d13">1778707976</data>
  <data key="d14"></data>
</edge>
<edge source="Startup Wizard" target="Enter Date Screen">
  <data key="d8">1.0</data>
  <data key="d9">Following time entry, the Enter Date Screen appears in the Startup Wizard to collect the current date.</data>
  <data key="d10">data entry,setup step</data>
