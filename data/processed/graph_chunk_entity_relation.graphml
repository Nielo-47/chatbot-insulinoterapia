  <data key="d0">GLP-1 Agonist</data>
  <data key="d1">substance</data>
  <data key="d2">A class of injectable medications used in diabetes treatment that mimic the action of incretin hormones.</data>
  <data key="d3">chunk-180dc3d244f7d832cf505b09cfc34746</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1778695978</data>
  <data key="d6"></data>
</node>
<node id="Prefilled Insulin Pen">
  <data key="d0">Prefilled Insulin Pen</data>
  <data key="d1">artifact</data>
  <data key="d2">An insulin pen preloaded with medication, including those containing GLP-1 agonists or insulin combinations.</data>
  <data key="d3">chunk-180dc3d244f7d832cf505b09cfc34746</data>
