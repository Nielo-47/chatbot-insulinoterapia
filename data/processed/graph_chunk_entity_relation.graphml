<edge source="Combur-Test" target="Reagent Strip Testing">
  <data key="d8">1.0</data>
  <data key="d9">Combur-Test is a reagent strip test used for evaluating glycosuria.</data>
  <data key="d10">glycosuria assessment,method evolution</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
