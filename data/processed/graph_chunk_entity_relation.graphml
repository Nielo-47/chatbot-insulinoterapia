<edge source="Home Screen" target="Deliver Bolus">
  <data key="d8">1.0</data>
  <data key="d9">The Deliver Bolus function is accessed from the Home screen to initiate insulin delivery.&gt;</data>
  <data key="d10">function access,user interface</data>
  <data key="d11">chunk-9cb3ef3e959b16d99ac4debc0210965b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707535</data>
