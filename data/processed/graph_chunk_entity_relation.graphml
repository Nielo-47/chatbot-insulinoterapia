  <data key="d7">1.0</data>
  <data key="d8">The total daily insulin dose programming is applied to the insulin pump system.</data>
  <data key="d9">device,programming</data>
  <data key="d10">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330245</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Configuração Da Bomba De Infusão">
  <data key="d7">1.0</data>
  <data key="d8">The pump configuration process sets parameters on the insulin infusion system.</data>
  <data key="d9">configuration,device</data>
  <data key="d10">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330246</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Infusão De Pulsos">
  <data key="d7">1.0</data>
  <data key="d8">Pulse infusion is the method by which the insulin pump delivers correction and meal boluses.</data>
  <data key="d9">delivery,method</data>
  <data key="d10">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330247</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Software De Bomba">
  <data key="d7">1.0</data>
  <data key="d8">The pump’s embedded software is a component of the continuous insulin infusion system.</data>
  <data key="d9">component,software</data>
  <data key="d10">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330247</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Múltiplas Doses De Insulina">
  <data key="d7">1.0</data>
  <data key="d8">No statistically significant differences were observed between SICI and MDI for mother and fetus outcomes.</data>
  <data key="d9">comparison,efficacy</data>
  <data key="d10">chunk-336a2f2c9b510e23c35be95e2ff7a72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330327</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Hipoglicemias Significantes">
  <data key="d7">1.0</data>
  <data key="d8">Significant hypoglycemia is listed as a clinical situation where SICI may be used.</data>
  <data key="d9">indication,therapy</data>
  <data key="d10">chunk-336a2f2c9b510e23c35be95e2ff7a72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330329</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Alergia Aos Adesivos">
  <data key="d7">1.0</data>
  <data key="d8">Allergic reactions to adhesives reduce comfort and may lead to discontinuation of SICI.</data>
  <data key="d9">adverse effect,discontinuation</data>
  <data key="d10">chunk-336a2f2c9b510e23c35be95e2ff7a72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330332</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Insulina Asparte">
  <data key="d7">1.0</data>
  <data key="d8">Insulina asparte is preferred over glulisina for SICI therapy.</data>
  <data key="d9">rapid‑acting,usage</data>
  <data key="d10">chunk-336a2f2c9b510e23c35be95e2ff7a72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330335</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Glulisina is mentioned as less preferred compared to lispro and asparte for SICI.</data>
  <data key="d9">alternative,less preferred</data>
  <data key="d10">chunk-336a2f2c9b510e23c35be95e2ff7a72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330336</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Descontinuação Do Uso Da Bomba De Infusão De Insulina">
  <data key="d7">1.0</data>
  <data key="d8">The discontinuation event pertains to stopping the use of the insulin pump in continuous insulin infusion therapy.</data>
  <data key="d9">cessation,event</data>
  <data key="d10">chunk-336a2f2c9b510e23c35be95e2ff7a72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330338</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Guidelines">
  <data key="d7">1.0</data>
  <data key="d8">Guidelines provide recommendations for the use of SICI in gestantes and diabetes management.</data>
  <data key="d9">clinical recommendation</data>
  <data key="d10">chunk-336a2f2c9b510e23c35be95e2ff7a72a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330339</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Sociedade Brasileira De Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">The Brazilian Diabetes Society recommends the insulin pump as the gold‑standard treatment for type 1 diabetes.</data>
  <data key="d9">gold standard,recommendation</data>
  <data key="d10">chunk-51c7617f1e335789b870332231de4058</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330341</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Fenômeno Do Alvorecer">
  <data key="d7">1.0</data>
  <data key="d8">The presence of the dawn phenomenon (fasting glucose &gt; 140–160 mg/dL) is an indication for using the insulin pump.</data>
  <data key="d9">glycemic control,indication</data>
  <data key="d10">chunk-51c7617f1e335789b870332231de4058</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330343</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Fenômeno Do Entardecer">
  <data key="d7">1.0</data>
  <data key="d8">The occurrence of the dusk phenomenon is listed as an indication for insulin pump therapy.</data>
  <data key="d9">glycemic control,indication</data>
  <data key="d10">chunk-51c7617f1e335789b870332231de4058</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330344</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Crianças Menores De 12 Anos">
  <data key="d7">1.0</data>
  <data key="d8">Children under twelve with poor glycemic control despite intensive MDI are indicated for insulin pump use.</data>
  <data key="d9">indication,pediatric</data>
  <data key="d10">chunk-51c7617f1e335789b870332231de4058</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330346</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Atletas Profissionais">
  <data key="d7">1.0</data>
  <data key="d8">Professional athletes or competition participants are recommended the insulin pump to accommodate demanding training schedules.</data>
  <data key="d9">indication,lifestyle flexibility</data>
  <data key="d10">chunk-51c7617f1e335789b870332231de4058</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330347</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Desejo De Estilo De Vida Flexível">
  <data key="d7">1.0</data>
  <data key="d8">Patients motivated by a desire for a more flexible lifestyle are considered suitable candidates for insulin pump therapy.</data>
  <data key="d9">indication,quality of life</data>
  <data key="d10">chunk-51c7617f1e335789b870332231de4058</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330348</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Pacientes Com Cetose">
  <data key="d7">1.0</data>
  <data key="d8">Individuals prone to ketosis are indicated for insulin pump use to achieve better metabolic stability.</data>
  <data key="d9">indication,metabolic stability</data>
