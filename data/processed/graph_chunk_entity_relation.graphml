<node id="MODY (Mature Onset Diabetes of the Young)">
  <data key="d0">MODY (Mature Onset Diabetes of the Young)</data>
  <data key="d1">concept</data>
  <data key="d2">MODY is a monogenic form of diabetes caused by defects in pancreatic beta‑cell function.</data>
  <data key="d3">chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373022</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Neonatal Transitório ou Permanente">
  <data key="d0">Diabetes Neonatal Transitório ou Permanente</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Neonatal Transitório ou Permanente refers to diabetes presenting in the neonatal period, either temporary or permanent.</data>
  <data key="d3">chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373022</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Mitocondrial">
  <data key="d0">Diabetes Mitocondrial</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Mitocondrial is a rare form of diabetes caused by mitochondrial DNA mutations.&lt;SEP&gt;Diabetes Mitocondrial is a hereditary form of diabetes caused by mitochondrial DNA mutations.</data>
  <data key="d3">chunk-72da6fb8b6a9ed059d146b43a3174f90&lt;SEP&gt;chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373022</data>
  <data key="d6"></data>
</node>
<node id="Síndrome de Rabson-Mendenhall">
  <data key="d0">Síndrome de Rabson-Mendenhall</data>
  <data key="d1">concept</data>
  <data key="d2">Síndrome de Rabson-Mendenhall is a severe insulin‑receptor defect syndrome linked to diabetes.</data>
  <data key="d3">chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373023</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Lipoatrófico">
  <data key="d0">Diabetes Lipoatrófico</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Lipoatrófico is a lipodystrophy‑related form of diabetes.</data>
  <data key="d3">chunk-72da6fb8b6a9ed059d146b43a3174f90</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373023</data>
  <data key="d6"></data>
</node>
<node id="Pancreatite">
  <data key="d0">Pancreatite</data>
  <data key="d1">concept</data>
  <data key="d2">Pancreatite is inflammation of the exocrine pancreas listed as a condition associated with diabetes.</data>
