</node>
<node id="Teste De Função Pancreática">
  <data key="d0">Teste De Função Pancreática</data>
  <data key="d1">method</data>
  <data key="d2">Teste De Função Pancreática is a diagnostic method used to assess pancreatic function in diabetes patients.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
