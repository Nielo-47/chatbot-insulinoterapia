<node id="Família">
  <data key="d0">Família</data>
  <data key="d1">person</data>
  <data key="d2">Família refers to family members who may assist the Paciente during the initial insulin administration.&lt;SEP&gt;Família are the patient's relatives who should know the steps to take during hypo‑ or hyperglycemic episodes.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792&lt;SEP&gt;chunk-9cd336474a2e9457985162b1ddb4b603</data>
