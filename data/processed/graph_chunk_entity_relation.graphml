  <data key="d0">SMCG Terapêutico</data>
  <data key="d1">concept</data>
  <data key="d2">SMCG Terapêutico denotes the therapeutic use of real‑time interstitial glucose data to guide insulin dosing.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
