  <data key="d14"></data>
</edge>
<edge source="Alert Silence" target="Low SG Alert">
  <data key="d8">1.0</data>
  <data key="d9">Low SG Alert cannot be silenced if Suspend Before Low or Suspend On Low features are enabled, ensuring user awareness during critical low events.</data>
