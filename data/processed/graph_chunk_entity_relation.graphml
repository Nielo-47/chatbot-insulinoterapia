  <data key="d0">Disposable Injector Pen</data>
  <data key="d1">artifact</data>
  <data key="d2">The disposable injector pen is a single‑use device supplied with each Humalog Mix 50 KwikPen, allowing subcutaneous administration.</data>
  <data key="d3">chunk-7084240a735ca2fe3b6d426e3b8c5756</data>
