<edge source="Bolus Wizard" target="Configuracion Bolus">
  <data key="d8">1.0</data>
  <data key="d9">Bolus Wizard requires Configuracion Bolus to be properly set up for accurate insulin dose recommendations.</data>
  <data key="d10">dose calculation,parameter setup</data>
