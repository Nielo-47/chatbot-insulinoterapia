  <data key="d0">Neketar</data>
  <data key="d1">organization</data>
  <data key="d2">Neketar is a pharmaceutical company that participated in a clinical trial for the inhaled insulin product Exubera.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333586</data>
  <data key="d6"></data>
</node>
<node id="Nebulizer‑Compatible Liposomal Carrier">
  <data key="d0">Nebulizer‑Compatible Liposomal Carrier</data>
  <data key="d1">artifact</data>
  <data key="d2">The nebulizer‑compatible liposomal carrier is a specially designed liposome formulation suitable for aerosol delivery of insulin via nebulization.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333587</data>
  <data key="d6"></data>
</node>
<node id="Detergent Dialyzing Method">
  <data key="d0">Detergent Dialyzing Method</data>
  <data key="d1">method</data>
  <data key="d2">The detergent dialyzing method is a technique used to encapsulate drugs into preformed vesicles without loss of biological activity.&lt;SEP&gt;A laboratory technique used to encapsulate insulin into liposomes.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699&lt;SEP&gt;chunk-292ec5ef0e73074be4398f1729c06661</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333587</data>
  <data key="d6"></data>
</node>
<node id="Membrane Destabilizing Method">
  <data key="d0">Membrane Destabilizing Method</data>
  <data key="d1">method</data>
  <data key="d2">The membrane destabilizing method is a technique employed to improve drug encapsulation into liposomes.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333587</data>
  <data key="d6"></data>
</node>
<node id="40% Ethanol">
  <data key="d0">40% Ethanol</data>
  <data key="d1">naturalobject</data>
  <data key="d2">40% ethanol is a solvent concentration identified as optimal for achieving high encapsulation efficiency in liposomal carriers.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333587</data>
  <data key="d6"></data>
</node>
<node id="Sigma Chemical Company">
  <data key="d0">Sigma Chemical Company</data>
  <data key="d1">organization</data>
  <data key="d2">Sigma Chemical Company supplied hydrogenated egg yolk phosphatidylcholine, egg yolk phosphatidylcholine, cholesterol, insulin, and phosphate‑buffered saline for the study.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333587</data>
  <data key="d6"></data>
</node>
<node id="NOF Corporation">
  <data key="d0">NOF Corporation</data>
  <data key="d1">organization</data>
  <data key="d2">NOF Corporation supplied PEG‑DPPE used in the liposomal formulations.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333587</data>
  <data key="d6"></data>
</node>
<node id="National Science Council of Taiwan">
  <data key="d0">National Science Council of Taiwan</data>
  <data key="d1">organization</data>
  <data key="d2">The National Science Council of Taiwan provided financial support for the research on liposomal pulmonary delivery of insulin.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333588</data>
  <data key="d6"></data>
</node>
<node id="Ultrasonic Nebulizer">
  <data key="d0">Ultrasonic Nebulizer</data>
  <data key="d1">artifact</data>
  <data key="d2">The ultrasonic nebulizer is a device that generates aerosolized liposomal particles with an approximate size of 1 µm for inhalation.&lt;SEP&gt;A device that generates aerosol droplets from liposomal formulations for inhalation.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699&lt;SEP&gt;chunk-292ec5ef0e73074be4398f1729c06661</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333588</data>
  <data key="d6"></data>
</node>
<node id="Liposomal Carrier">
  <data key="d0">Liposomal Carrier</data>
  <data key="d1">artifact</data>
  <data key="d2">The liposomal carrier is a lipid‑based delivery system shown to encapsulate insulin efficiently for inhalation therapy.&lt;SEP&gt;A liposome‑based delivery vehicle designed to encapsulate insulin for inhalation.</data>
