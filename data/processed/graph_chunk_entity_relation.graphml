<node id="Pila Aa De Litio">
  <data key="d0">Pila Aa De Litio</data>
  <data key="d1">artifact</data>
  <data key="d2">A lithium AA battery is a variant that provides a longer useful life for the insulin pump.</data>
  <data key="d3">chunk-cf725cb54eea97f946e1f27eae125a0b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d5">1786322877</data>
  <data key="d6"></data>
</node>
<node id="Pila Aa Alcalina">
  <data key="d0">Pila Aa Alcalina</data>
  <data key="d1">artifact</data>
  <data key="d2">An alkaline AA battery is a variant that can be used to power the insulin pump.</data>
  <data key="d3">chunk-cf725cb54eea97f946e1f27eae125a0b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
