</edge>
<edge source="Hypoglycemia" target="Continuous Carbohydrate Intake">
  <data key="d7">1.0</data>
  <data key="d8">Continuous carbohydrate intake is recommended to manage hypoglycemia.</data>
  <data key="d9">treatment</data>
  <data key="d10">chunk-431b48980656b0322f263c358250b593</data>
