</edge>
<edge source="Levemir® FlexPen®" target="Anvisa">
  <data key="d8">1.0</data>
  <data key="d9">Anvisa approved the professional leaflet of Levemir® FlexPen® on 09/12/2021 and oversees its regulatory compliance.</data>
  <data key="d10">product registration,regulatory approval</data>
  <data key="d11">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
