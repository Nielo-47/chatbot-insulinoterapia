<node id="National Diabetes Data Group Criteria">
  <data key="d0">National Diabetes Data Group Criteria</data>
  <data key="d1">method</data>
  <data key="d2">National Diabetes Data Group Criteria are classification and diagnostic thresholds for diabetes mellitus used as a reference standard in gestational diabetes studies.</data>
  <data key="d3">chunk-037075addb77da4a5a1721a95ee298c0</data>
