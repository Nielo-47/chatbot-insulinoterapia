  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Hypotension">
  <data key="d7">2.0</data>
  <data key="d8">Insulin can cause hypotension.&lt;SEP&gt;Insulin administration is associated with hypotension as a possible severe adverse event.</data>
  <data key="d9">adverse reaction,cardiovascular adverse effect,hemodynamic</data>
