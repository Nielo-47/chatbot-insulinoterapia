  <data key="d8">The insulin pump is a small device that adheres to the skin to deliver continuous insulin doses.</data>
  <data key="d9">attachment,device</data>
  <data key="d10">chunk-c7e6ef38db0b62d161b13473af47d738</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Documento sem título.docx</data>
  <data key="d12">1786330502</data>
  <data key="d13"></data>
</edge>
<edge source="Skin" target="Glucose Sensor">
  <data key="d7">1.0</data>
  <data key="d8">The glucose sensor is placed just below the skin.</data>
  <data key="d9">attachment,placement</data>
  <data key="d10">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1786336972</data>
  <data key="d13"></data>
</edge>
<edge source="Irregular Insulin Absorption" target="Hypoglycemia">
  <data key="d7">2.0</data>
  <data key="d8">Irregular insulin absorption can lead to episodes of low blood sugar (hypoglycemia).&lt;SEP&gt;Irregular Insulin Absorption can cause Hypoglycemia.</data>
  <data key="d9">cause,low glucose,potential outcome</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd&lt;SEP&gt;chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1786320235</data>
  <data key="d13"></data>
</edge>
<edge source="Irregular Insulin Absorption" target="Hyperglycemia">
  <data key="d7">2.0</data>
  <data key="d8">Irregular insulin absorption can also cause high blood sugar (hyperglycemia) when uptake is insufficient.&lt;SEP&gt;Irregular Insulin Absorption can cause Hyperglycemia.</data>
  <data key="d9">cause,high glucose,potential outcome</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd&lt;SEP&gt;chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1786320235</data>
  <data key="d13"></data>
</edge>
<edge source="Irregular Insulin Absorption" target="Avoid Injection in Altered Skin Area">
  <data key="d7">1.0</data>
  <data key="d8">Avoiding injection into altered skin areas reduces the risk of irregular insulin absorption.</data>
  <data key="d9">prevention</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299866</data>
  <data key="d13"></data>
</edge>
<edge source="Irregular Insulin Absorption" target="Large Glycemic Variability">
  <data key="d7">1.0</data>
  <data key="d8">Irregular insulin absorption leads to substantial day‑to‑day glucose swings.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299868</data>
  <data key="d13"></data>
</edge>
<edge source="Irregular Insulin Absorption" target="Lipo‑hipertrofia (LH)">
  <data key="d7">1.0</data>
  <data key="d8">Lipo‑hipertrofia leads to irregular insulin absorption, either too fast or too slow.</data>
  <data key="d9">consequence,physiology</data>
  <data key="d10">chunk-525086e26636af026c417773a8f11a92</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299917</data>
  <data key="d13"></data>
</edge>
<edge source="Irregular Insulin Absorption" target="Lipo-Hipertrofia (LH)">
  <data key="d7">1.0</data>
  <data key="d8">Lipo-Hipertrofia leads to Irregular Insulin Absorption.</data>
  <data key="d9">effect,physiological</data>
  <data key="d10">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
