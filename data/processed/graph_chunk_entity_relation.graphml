<node id="Classification Schemes for Ketosis‑Prone Diabetes">
  <data key="d0">Classification Schemes for Ketosis‑Prone Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Classification schemes are analytical tools used to categorize ketosis‑prone diabetes, assessed for accuracy and predictive value.</data>
  <data key="d3">chunk-c1ee3f56f3180d8544dbba6a542c9d68</data>
