</edge>
<edge source="Insulin Aspart (Novorapid®)" target="Insulin Receptor">
  <data key="d7">1.0</data>
  <data key="d8">In vitro tests showed insulin aspart dissociates from the insulin receptor with kinetics equivalent to human insulin.</data>
  <data key="d9">binding,pharmacodynamics</data>
