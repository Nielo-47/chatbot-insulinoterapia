<node id="Sympathomimetics">
  <data key="d0">Sympathomimetics</data>
  <data key="d1">artifact</data>
  <data key="d2">Sympathomimetics are drugs that stimulate the sympathetic nervous system and may increase insulin requirements.&lt;SEP&gt;Sympathomimetics are drugs that can elevate blood glucose levels, increasing insulin requirements.&lt;SEP&gt;Sympathomimetics are drugs that can increase insulin requirements by stimulating glucose release and reducing insulin sensitivity.</data>
  <data key="d3">chunk-bc07da1fd30cc15e0022830f701a9c38&lt;SEP&gt;chunk-62a6c42a674563e36382f398efac64a3&lt;SEP&gt;chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
