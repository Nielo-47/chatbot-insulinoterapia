  <data key="d6"></data>
</node>
<node id="Asymptomatic Hypoglycemia">
  <data key="d0">Asymptomatic Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Asymptomatic hypoglycemia describes low blood glucose events that occur without noticeable symptoms.&lt;SEP&gt;Asymptomatic hypoglycemia denotes low blood glucose without noticeable symptoms, posing risk especially in pediatric or fasting patients.&lt;SEP&gt;Asymptomatic Hypoglycemia refers to low blood glucose episodes without symptoms, noted as an indication for SICI.&lt;SEP&gt;Low blood glucose that occurs without noticeable symptoms.</data>
