<node id="Lote">
  <data key="d0">Lote</data>
  <data key="d1">data</data>
  <data key="d2">Lote is the batch number and accompanying manufacturing/expiry dates printed on the APIDRA SOLOSTAR packaging.&lt;SEP&gt;Lote refers to the batch number and manufacturing/expiry dates printed on the medication’s packaging.&lt;SEP&gt;Lote is the batch number and manufacturing/expiry dates printed on the medication packaging.</data>
  <data key="d3">chunk-b060d4f68031bd35dfafc19eadf1e9fe&lt;SEP&gt;chunk-4615ca664e7ff898d8c5929cbc79e7d8&lt;SEP&gt;chunk-ba6b31518be6fff1db8b68a28e82f200</data>
