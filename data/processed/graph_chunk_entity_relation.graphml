</edge>
<edge source="CareLink Software" target="MiniMed 780G System">
  <data key="d8">2.0</data>
  <data key="d9">CareLink software receives uploaded device data from the MiniMed 780G system for clinical review.&lt;SEP&gt;CareLink software interfaces with the MiniMed 780G system to manage data and display related alerts and messages.</data>
  <data key="d10">alert integration,data management,data upload,device analysis</data>
  <data key="d11">chunk-3fd001e1c01f7ba101b7beb19f131c79&lt;SEP&gt;chunk-64e8ebad9c2de6a1aeba1645920f2e35</data>
