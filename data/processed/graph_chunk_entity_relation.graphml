<node id="Tmax">
  <data key="d0">Tmax</data>
  <data key="d1">data</data>
  <data key="d2">Tmax is the time to reach maximum plasma concentration, observed to be approximately half for insulin aspart compared with regular insulin.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
