  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G system requires regular calibration with blood glucose values to ensure accurate sensor readings.</data>
  <data key="d10">accuracy maintenance,system requirement</data>
  <data key="d11">chunk-86d3bb81c7595510175054c288b122fb</data>
