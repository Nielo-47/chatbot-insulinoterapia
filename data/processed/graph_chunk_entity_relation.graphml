  <data key="d6"></data>
</node>
<node id="Fixed Dosing Schedule">
  <data key="d0">Fixed Dosing Schedule</data>
  <data key="d1">method</data>
  <data key="d2">Fixed Dosing Schedule is administration of TOUJEO 300 U/mL at the same time each day (every 24 hours).</data>
  <data key="d3">chunk-3553e80da33ab48fb157ac9ff75436eb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313652</data>
  <data key="d6"></data>
</node>
<node id="Flexible Dosing Schedule">
  <data key="d0">Flexible Dosing Schedule</data>
  <data key="d1">method</data>
  <data key="d2">Flexible Dosing Schedule is administration of TOUJEO 300 U/mL within ±3 hours of the usual time, used at least two days per week.</data>
  <data key="d3">chunk-3553e80da33ab48fb157ac9ff75436eb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313652</data>
  <data key="d6"></data>
</node>
