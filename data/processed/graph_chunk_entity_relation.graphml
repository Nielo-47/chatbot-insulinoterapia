  <data key="d6"></data>
</node>
<node id="Mixed Liposomal Formulation">
  <data key="d0">Mixed Liposomal Formulation</data>
  <data key="d1">artifact</data>
  <data key="d2">The mixed liposomal formulation (dipalmitoylphosphatidyl choline:cholesterol, 7:2) is a lipid-based carrier evaluated for enhancing insulin delivery to the lungs.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333586</data>
  <data key="d6"></data>
</node>
<node id="IL-2 Liposomes">
  <data key="d0">IL-2 Liposomes</data>
  <data key="d1">artifact</data>
  <data key="d2">IL-2 liposomes are liposomal particles encapsulating interleukin‑2, administered as an aerosol to individuals with immune deficiency.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333586</data>
  <data key="d6"></data>
</node>
<node id="Immune Deficiency">
  <data key="d0">Immune Deficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Immune deficiency refers to a condition of compromised immune function addressed by IL-2 liposome therapy.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
  <data key="d5">1786333586</data>
  <data key="d6"></data>
</node>
<node id="Pfizer">
  <data key="d0">Pfizer</data>
  <data key="d1">organization</data>
  <data key="d2">Pfizer is a pharmaceutical company that participated in a clinical trial for the inhaled insulin product Exubera.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
