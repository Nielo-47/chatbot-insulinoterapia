<edge source="Paciente" target="Monitoramento Da Glicose No Sangue">
  <data key="d8">1.0</data>
  <data key="d9">Patients should frequently monitor blood glucose, especially before activities like driving, to prevent severe hypoglycemia.</data>
  <data key="d10">preventive measure,symptom management</data>
