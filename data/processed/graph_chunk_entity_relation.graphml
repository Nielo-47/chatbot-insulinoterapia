<node id="Cell Wall">
  <data key="d0">Cell Wall</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The cell wall is the outer membrane of a cell that includes specific receptor sites for insulin binding.</data>
  <data key="d3">chunk-6b867cec4c5eed3b10e431cbd4078dee</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
