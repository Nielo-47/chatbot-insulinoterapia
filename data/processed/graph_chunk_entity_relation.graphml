  <data key="d13">1778707644</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus Wizard" target="BG Target">
  <data key="d8">3.0</data>
  <data key="d9">Bolus Wizard uses the BG Target setting to calculate correction doses for high blood glucose.&lt;SEP&gt;The Bolus Wizard calculates correction doses based on the BG Target range; if blood glucose is above the high target, a correction dose is added, and if below the low target, a negative correction is subtracted.&gt;&lt;SEP&gt;The BG Target must be set when using the Bolus Wizard to determine correction bolus recommendations.</data>
  <data key="d10">configuration dependency,correction bolus,correction dosing,dose calculation,glucose management</data>
  <data key="d11">chunk-1ef4fd0fa0c26a81460d7687cc37cf95&lt;SEP&gt;chunk-fe3d4956e4290b26b4d22092a403c4d6&lt;SEP&gt;chunk-14b0e9023a7c03c6a284d69e0930b8a9</data>
