  <data key="d12">1786325595</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Danielle">
  <data key="d7">1.0</data>
  <data key="d8">Danielle disconnects and manually suspends the insulin pump to prevent insulin delivery while swimming.</data>
