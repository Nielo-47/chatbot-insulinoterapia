  <data key="d6"></data>
</node>
<node id="Low Target Value">
  <data key="d0">Low Target Value</data>
  <data key="d1">data</data>
  <data key="d2">Low Target Value is the lower glucose threshold used to determine when a negative correction is applied.</data>
