<edge source="Individuals" target="IM">
  <data key="d8">1.0</data>
  <data key="d9">There is a high risk associated with intramuscular (IM) insulin injection in all individuals, making subcutaneous administration essential.</data>
  <data key="d10">injection risk,medical warning</data>
