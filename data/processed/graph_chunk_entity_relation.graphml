  <data key="d6"></data>
</node>
<node id="Suspend Event">
  <data key="d0">Suspend Event</data>
  <data key="d1">concept</data>
  <data key="d2">An event where insulin delivery is temporarily halted.</data>
  <data key="d3">chunk-4b8de1434b9d9f57cd225b5d3e0d7f3b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329663</data>
  <data key="d6"></data>
</node>
<node id="Sensor Update Delay Alert">
  <data key="d0">Sensor Update Delay Alert</data>
  <data key="d1">concept</data>
  <data key="d2">An alert that occurs if the time required to update the glucose sensor exceeds four hours.</data>
  <data key="d3">chunk-4b8de1434b9d9f57cd225b5d3e0d7f3b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329663</data>
  <data key="d6"></data>
</node>
