  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis" target="Ketone Bodies">
  <data key="d8">2.0</data>
  <data key="d9">Elevated ketone bodies are a key sign of impending diabetic ketoacidosis.&lt;SEP&gt;The presence of ketone bodies in the blood is a key sign of diabetic ketoacidosis.</data>
  <data key="d10">biomarker,diagnostic indicator,pathophysiology,risk indicator</data>
  <data key="d11">chunk-23235296c6ccfffc5ec397dd6b0dc7b7&lt;SEP&gt;chunk-6ec727091282384bd8f9c91eb1d29b78</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702692</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis" target="Enfermedades E Infecciones">
  <data key="d8">1.0</data>
  <data key="d9">During illness, the risk of developing diabetic ketoacidosis increases due to higher insulin requirements and potential insulin deficiency.</data>
  <data key="d10">complication risk,metabolic imbalance</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702747</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis" target="Healthcare Team">
  <data key="d8">1.0</data>
  <data key="d9">The healthcare team should be contacted if symptoms of DKA develop, such as nausea, vomiting, or difficulty breathing.</data>
  <data key="d10">emergency response,medical intervention</data>
  <data key="d11">chunk-6ec727091282384bd8f9c91eb1d29b78</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702849</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis" target="Emergency Service">
  <data key="d8">2.0</data>
  <data key="d9">Emergency services must be accessed if DKA symptoms worsen or blood glucose remains elevated.&lt;SEP&gt;The nearest emergency service should be visited if there are signs of moderate to high ketone levels and difficulty breathing.</data>
  <data key="d10">health risk,medical emergency,urgent care,urgent treatment</data>
  <data key="d11">chunk-6ec727091282384bd8f9c91eb1d29b78&lt;SEP&gt;chunk-2fdccbdc819ab6cd813190d6db8dc9c3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702851</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis" target="Glucagon Emergency Kit">
  <data key="d8">1.0</data>
  <data key="d9">The glucagon emergency kit is referenced in the manual for managing severe hypoglycemia, a risk related to insulin therapy and DKA prevention.</data>
  <data key="d10">complication management,emergency treatment</data>
  <data key="d11">chunk-e6b7bb277d16feead8d082fc004d51d2</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702961</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis" target="Medical Team">
  <data key="d8">1.0</data>
  <data key="d9">The medical team should be contacted if symptoms of diabetic ketoacidosis, such as nausea or high ketones, persist.</data>
  <data key="d10">emergency care,medical intervention</data>
  <data key="d11">chunk-2fdccbdc819ab6cd813190d6db8dc9c3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703113</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetic Ketoacidosis" target="Non-Carbohydrate Fluids">
  <data key="d8">1.0</data>
  <data key="d9">Drinking non-carbohydrate fluids helps manage dehydration during episodes of high glucose and potential ketoacidosis.</data>
