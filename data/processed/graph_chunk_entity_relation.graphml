  <data key="d0">New Pen</data>
  <data key="d1">artifact</data>
  <data key="d2">New Pen denotes a replacement pen that should be used when the SoloStar pen is suspected of being damaged.</data>
  <data key="d3">chunk-fdeef3e06ffaa7cc0442c3d94917f0c4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
