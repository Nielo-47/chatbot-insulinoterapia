</edge>
<edge source="Hypoglycemia" target="Vomiting">
  <data key="d7">2.0</data>
  <data key="d8">Vomiting is a symptom of hypoglycemia.&lt;SEP&gt;Vomiting can impair glucose absorption, contributing to hypoglycemia.</data>
  <data key="d9">clinical condition,nutrient loss,symptom</data>
