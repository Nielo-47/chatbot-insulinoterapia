  <data key="d0">Hospital Universitário Walter Cantídio - HUWC</data>
  <data key="d1">organization</data>
  <data key="d2">A university hospital involved in the production of insulin use guidelines.&lt;SEP&gt;A university hospital affiliated with UFC, providing endocrinology and diabetes services.</data>
  <data key="d3">chunk-e68da6d45eb01c249e854b711007d805&lt;SEP&gt;chunk-afd148f1edc7929cecea8e4d981ed04e</data>
