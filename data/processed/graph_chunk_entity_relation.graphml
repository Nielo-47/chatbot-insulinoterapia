  <data key="d14"></data>
</edge>
<edge source="Insulin Degradation" target="Sulfides">
  <data key="d8">1.0</data>
  <data key="d9">Sulfides may degrade Novolin® R if added to its solution, resulting in incompatibility.</data>
  <data key="d10">chemical incompatibility,drug interaction</data>
  <data key="d11">chunk-b2339435aa42eeb6f0cb8bffbf4d5184</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
