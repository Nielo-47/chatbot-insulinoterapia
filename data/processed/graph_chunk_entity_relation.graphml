  <data key="d5">1778709373</data>
  <data key="d6"></data>
  <data key="d7">Médico</data>
</node>
<node id="Diabetes Mellitus Type 1">
  <data key="d0">Diabetes Mellitus Type 1</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Mellitus Type 1 is a chronic condition where the body produces little or no insulin, requiring insulin therapy for glucose control.&lt;SEP&gt;Diabetes Mellitus Type 1 is a chronic condition in which the pancreas produces little or no insulin, requiring lifelong insulin therapy.&lt;SEP&gt;Diabetes Mellitus Type 1 (DM1) is a chronic condition characterized by the body's inability to produce insulin, requiring careful glucose monitoring and insulin administration.</data>
  <data key="d3">chunk-bcba435392a61e072dfaad9195e42ed7&lt;SEP&gt;chunk-a04357a03a35f68e0068d23b80593b8c&lt;SEP&gt;chunk-bdbc37da05a342443ccfd48642dd1c3b</data>
