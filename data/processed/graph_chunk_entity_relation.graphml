</edge>
<edge source="Diabetes Type 1" target="Lipo-hypertrophy">
  <data key="d8">1.0</data>
  <data key="d9">Lipo-hypertrophy is more commonly found in individuals with Diabetes Type 1 due to prolonged insulin therapy.</data>
  <data key="d10">prevalence,risk factor</data>
