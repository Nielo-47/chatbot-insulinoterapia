<node id="Mãos">
  <data key="d0">Mãos</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Mãos are the hands that should be washed before handling insulin.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
