</edge>
<edge source="Square Wave Bolus" target="MiniMed 780G System">
  <data key="d8">1.0</data>
  <data key="d9">The Square Wave Bolus feature is available on the MiniMed 780G system but must be turned on before use.</data>
  <data key="d10">device functionality,feature availability</data>
  <data key="d11">chunk-14b0e9023a7c03c6a284d69e0930b8a9</data>
