  <data key="d13">1778709764</data>
  <data key="d14"></data>
</edge>
<edge source="Non-Invasive Glucose Sensors" target="Glucose-Sensing Contact Lenses">
  <data key="d8">1.0</data>
  <data key="d9">Glucose-sensing contact lenses are a form of non-invasive glucose sensor that measure glucose through the eyes.</data>
  <data key="d10">ocular monitoring,wearable technology</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
