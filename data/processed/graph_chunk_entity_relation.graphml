  <data key="d0">Bloqueadores do Receptor da Angiotensina II</data>
  <data key="d1">artifact</data>
  <data key="d2">Bloqueadores do Receptor da Angiotensina II são medicamentos que podem diminuir as necessidades de insulina em pacientes diabéticos.</data>
  <data key="d3">chunk-6398afdc8e1faa94220df6d070a1ade7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1778699599</data>
  <data key="d6"></data>
</node>
<node id="Plantas Medicinais">
  <data key="d0">Plantas Medicinais</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Plantas Medicinais são substâncias cujas interações com HUMULIN R não foram estudadas.</data>
  <data key="d3">chunk-6398afdc8e1faa94220df6d070a1ade7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1778699600</data>
  <data key="d6"></data>
</node>
<node id="Nicotina">
  <data key="d0">Nicotina</data>
  <data key="d1">artifact</data>
  <data key="d2">Nicotina é uma substância cuja interação com HUMULIN R não foi estudada.</data>
  <data key="d3">chunk-6398afdc8e1faa94220df6d070a1ade7</data>
