  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Obesidade">
  <data key="d7">1.0</data>
  <data key="d8">Obesity, especially severe obesity, is strongly associated with higher risk of type 2 diabetes in children and adolescents.</data>
  <data key="d9">association,risk</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372070</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Histórico Familiar de DM">
  <data key="d7">1.0</data>
  <data key="d8">A family history of diabetes adds an additive risk for developing type 2 diabetes.</data>
  <data key="d9">additive,risk</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372070</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Afro‑Americanos">
  <data key="d7">1.0</data>
  <data key="d8">The reduced insulin sensitivity in Afro‑American populations contributes to a higher prevalence of type 2 diabetes.</data>
  <data key="d9">higher prevalence,risk</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372071</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Antiretroviral Medications">
  <data key="d7">1.0</data>
  <data key="d8">It is not yet clear whether newer antiretroviral medications are associated with an increased risk of type 2 diabetes.</data>
  <data key="d9">association,risk,uncertainty</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372072</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Overweight">
  <data key="d7">1.0</data>
  <data key="d8">Overweight individuals who have young siblings with DM2 have a fourfold higher risk of glucose intolerance, indicating increased risk for type 2 diabetes.</data>
  <data key="d9">familial,risk</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372074</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Severe Obesity">
  <data key="d7">1.0</data>
  <data key="d8">Severe obesity is present in 38% of patients with type 2 diabetes and contributes significantly to disease risk.</data>
  <data key="d9">risk,severe obesity</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
