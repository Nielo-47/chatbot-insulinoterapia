  <data key="d14"></data>
</edge>
<edge source="Manual Mode" target="BG Meter">
  <data key="d8">1.0</data>
  <data key="d9">A BG meter reading is required before administering a correction bolus in Manual mode or during the first 12 hours of sensor use.</data>
  <data key="d10">safety protocol,treatment validation</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708018</data>
  <data key="d14"></data>
</edge>
<edge source="Manual Mode" target="Easy Bolus">
  <data key="d8">1.0</data>
  <data key="d9">Easy bolus is only available when the MiniMed 780G insulin pump is in Manual mode.</data>
