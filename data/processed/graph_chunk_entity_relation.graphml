  <data key="d13">1778707994</data>
  <data key="d14"></data>
</edge>
<edge source="SmartGuard Feature" target="Auto Basal">
  <data key="d8">2.0</data>
  <data key="d9">The SmartGuard feature uses Auto Basal to automatically adjust and deliver basal insulin based on sensor glucose values.&lt;SEP&gt;Auto basal insulin is delivered by the SmartGuard feature based on current SG readings.</data>
  <data key="d10">automated delivery,automation,insulin adjustment,insulin delivery</data>
  <data key="d11">chunk-8080e2e312ed6994d0dc059a4aeca5f7&lt;SEP&gt;chunk-550045a3f1fc05491e77159dba8b4fd4</data>
