  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708335</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Manual Bolus Feature">
  <data key="d8">1.0</data>
  <data key="d9">The Manual bolus feature allows users to select and deliver a Square Wave bolus after enabling the feature in settings.&gt;</data>
  <data key="d10">bolus type selection,manual configuration</data>
  <data key="d11">chunk-654d7a203c4eab9f3a89f577edc2a5ad</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708336</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Delivery Settings">
  <data key="d8">1.0</data>
  <data key="d9">The Square Wave bolus feature must be turned on in Delivery Settings before it can be used in either Bolus Wizard or Manual bolus modes.&gt;</data>
  <data key="d10">feature activation,system configuration</data>
  <data key="d11">chunk-654d7a203c4eab9f3a89f577edc2a5ad</data>
