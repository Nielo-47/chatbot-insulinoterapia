  <data key="d6"></data>
</node>
<node id="Dawn Phenomenon">
  <data key="d0">Dawn Phenomenon</data>
  <data key="d1">concept</data>
  <data key="d2">The expressive dawn phenomenon is a glycemic pattern listed as an indication for SICI in both DM1 and DM2.&lt;SEP&gt;Dawn Phenomenon is a pronounced early‑morning rise in blood glucose observed in some diabetes patients.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9&lt;SEP&gt;chunk-277e136948d5572acf031988fd092dce</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330166</data>
  <data key="d6"></data>
</node>
<node id="Severe Insulin Resistance">
  <data key="d0">Severe Insulin Resistance</data>
  <data key="d1">concept</data>
  <data key="d2">Severe insulin resistance is cited as an indication for SICI in DM2 patients with irregular lifestyles.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330166</data>
  <data key="d6"></data>
</node>
<node id="OpT2mise Study">
  <data key="d0">OpT2mise Study</data>
  <data key="d1">content</data>
  <data key="d2">The OpT2mise trial is a study demonstrating that CISI is more effective than MDI in lowering HbA1c in poorly controlled DM2.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330166</data>
  <data key="d6"></data>
</node>
<node id="Beta Cell Reserve">
  <data key="d0">Beta Cell Reserve</data>
  <data key="d1">concept</data>
  <data key="d2">Low beta‑cell reserve, due to long disease evolution, is a patient characteristic that may benefit from SICI therapy.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330166</data>
  <data key="d6"></data>
</node>
<node id="Anorexia Nervosa">
  <data key="d0">Anorexia Nervosa</data>
  <data key="d1">concept</data>
  <data key="d2">Anorexia nervosa is a psychiatric disorder listed as a contraindication for SICI use.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330167</data>
  <data key="d6"></data>
</node>
<node id="Bulimia">
  <data key="d0">Bulimia</data>
  <data key="d1">concept</data>
  <data key="d2">Bulimia is a psychiatric disorder listed as a contraindication for SICI use.</data>
