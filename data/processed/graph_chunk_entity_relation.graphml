  <data key="d6"></data>
</node>
<node id="Administracion De Bolus">
  <data key="d0">Administracion De Bolus</data>
  <data key="d1">method</data>
  <data key="d2">Administracion de bolus refers to the process of delivering an insulin bolus using a pump, either manually or via Bolus Wizard.&lt;SEP&gt;Administracion De Bolus refers to the process of delivering an insulin bolus dose using the pump interface.</data>
