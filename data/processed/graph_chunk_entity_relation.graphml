<edge source="Levemir" target="Pediatric Patients">
  <data key="d7">1.0</data>
  <data key="d8">Levemir® may be used in adolescents and children from 1 year old with individualized dose reduction to minimize hypoglycemia risk.</data>
  <data key="d9">approved use,dosage adjustment</data>
  <data key="d10">chunk-0ace26fdb0244e3d0f714a007c9bbb51</data>
