  <data key="d13">1778708055</data>
  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="Square Amount">
  <data key="d8">1.0</data>
  <data key="d9">The Square Amount is the portion of a Dual Wave Bolus delivered over time, derived from the Now % Amount.</data>
  <data key="d10">delivery parameter,extended dose</data>
