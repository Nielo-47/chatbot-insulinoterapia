  <data key="d6"></data>
</node>
<node id="CareLink Software Alerts and Messages">
  <data key="d0">CareLink Software Alerts and Messages</data>
  <data key="d1">content</data>
  <data key="d2">CareLink software alerts and messages are notifications produced by the CareLink platform.</data>
  <data key="d3">chunk-4a75df3ab63706f501e8d3134e74a64b</data>
