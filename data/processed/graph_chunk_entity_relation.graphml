  <data key="d5">1786330164</data>
  <data key="d6"></data>
</node>
<node id="Factory‑Calibrated MCG">
  <data key="d0">Factory‑Calibrated MCG</data>
  <data key="d1">artifact</data>
  <data key="d2">Factory‑Calibrated MCG denotes continuous glucose monitor devices calibrated at the manufacturing stage.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330164</data>
  <data key="d6"></data>
</node>
<node id="Dual Hormone Therapy">
  <data key="d0">Dual Hormone Therapy</data>
  <data key="d1">concept</data>
  <data key="d2">Dual Hormone Therapy describes a treatment approach that delivers both insulin and glucagon in a coordinated manner.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330164</data>
  <data key="d6"></data>
</node>
<node id="Manual Meal Bolus">
  <data key="d0">Manual Meal Bolus</data>
  <data key="d1">concept</data>
  <data key="d2">Manual Meal Bolus is the user‑administered insulin dose required at mealtime in certain hybrid closed‑loop systems.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
