</edge>
<edge source="Levemir® FlexPen®" target="Laura F. O. Azevedo">
  <data key="d8">1.0</data>
  <data key="d9">Laura F. O. Azevedo is the responsible pharmacist for Levemir® FlexPen® in Brazil, ensuring compliance with health regulations.</data>
  <data key="d10">pharmaceutical responsibility,regulatory compliance</data>
  <data key="d11">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
