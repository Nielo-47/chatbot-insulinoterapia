</edge>
<edge source="Hypoglycemia" target="GLP-1 Receptor Agonist">
  <data key="d7">1.0</data>
  <data key="d8">Adding a GLP-1 receptor agonist to Levemir® prompts a 20 % dose reduction to reduce hypoglycemia risk.</data>
  <data key="d9">dose reduction,risk mitigation</data>
  <data key="d10">chunk-56fc1d5df1b34d9120c3cf8a760c40f9</data>
