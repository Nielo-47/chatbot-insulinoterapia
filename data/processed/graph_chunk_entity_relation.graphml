  <data key="d6"></data>
</node>
<node id="retro-SMCG">
  <data key="d0">retro-SMCG</data>
  <data key="d1">data</data>
  <data key="d2">retro‑SMCG (retrospective SMCG) stores glucose patterns in memory for later analysis by health professionals.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338535</data>
  <data key="d6"></data>
</node>
