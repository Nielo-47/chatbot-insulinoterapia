</node>
<node id="Paciente Pediátrico">
  <data key="d0">Paciente Pediátrico</data>
  <data key="d1">person</data>
  <data key="d2">Paciente Pediátrico designates a patient younger than 18 years, for whom safety and efficacy of Humalog Mix 25 KwikPen have not been established.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310739</data>
  <data key="d6"></data>
</node>
<node id="Paciente Idoso">
  <data key="d0">Paciente Idoso</data>
  <data key="d1">person</data>
  <data key="d2">Paciente Idoso designates a patient aged 65 years or older, a group with limited clinical data on Humalog Mix 25 KwikPen and special dosing considerations.&lt;SEP&gt;Paciente Idoso denotes an elderly patient, noted for having potentially atypical or unrecognized hypoglycemia symptoms.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315335</data>
  <data key="d6"></data>
</node>
<node id="Paciente com Insuficiência Renal">
  <data key="d0">Paciente com Insuficiência Renal</data>
  <data key="d1">person</data>
  <data key="d2">Paciente com Insuficiência Renal is a patient with renal impairment, a condition that may modify insulin needs and pharmacokinetic response.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310740</data>
  <data key="d6"></data>
</node>
<node id="Paciente com Insuficiência Hepática">
  <data key="d0">Paciente com Insuficiência Hepática</data>
  <data key="d1">person</data>
  <data key="d2">Paciente com Insuficiência Hepática is a patient with hepatic impairment, a condition that may affect circulating insulin levels and drug handling.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310740</data>
  <data key="d6"></data>
</node>
<node id="Função Hepática">
  <data key="d0">Função Hepática</data>
  <data key="d1">concept</data>
  <data key="d2">Função Hepática describes liver performance, which can affect circulating insulin levels and drug metabolism.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310740</data>
  <data key="d6"></data>
</node>
<node id="Monitoramento da Glicose">
  <data key="d0">Monitoramento da Glicose</data>
  <data key="d1">concept</data>
  <data key="d2">Monitoramento da Glicose is the systematic checking of blood glucose levels, essential for safe insulin therapy in various patient populations.&lt;SEP&gt;Glucose monitoring is the measurement of blood glucose levels after changes in injection practices.&lt;SEP&gt;Glucose monitoring is the practice of checking blood sugar levels, especially during changes in insulin regimen.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9&lt;SEP&gt;chunk-e212a20942ed5387efe96e92bdb4ba98&lt;SEP&gt;chunk-929e31613caadc967412041c8c2155b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319689</data>
  <data key="d6"></data>
</node>
<node id="Cirurgião‑dentista">
  <data key="d0">Cirurgião‑dentista</data>
  <data key="d1">person</data>
  <data key="d2">Cirurgião‑dentista is a dental surgeon whose guidance may be required before using this insulin product in pregnant or lactating patients.&lt;SEP&gt;Dental surgeon referenced as a professional to consult during pregnancy while using insulin.&lt;SEP&gt;Cirurgião‑dentista is a dental surgeon professional mentioned as a source of medical guidance for pregnant women using insulin.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9&lt;SEP&gt;chunk-45ee3dcb366c1301c9fb1d2ce9f323c1&lt;SEP&gt;chunk-9bcc4202330d45ebfca8f79c3d4998b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317600</data>
  <data key="d6"></data>
</node>
<node id="Mutagenic Tests">
  <data key="d0">Mutagenic Tests</data>
  <data key="d1">method</data>
  <data key="d2">Mutagenic tests are experimental procedures used to assess whether a substance causes genetic mutations, referenced for Insulina Lispro.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310741</data>
  <data key="d6"></data>
</node>
<node id="Fertility Studies">
  <data key="d0">Fertility Studies</data>
  <data key="d1">method</data>
  <data key="d2">Fertility studies evaluate the impact of a substance on reproductive health, referenced for Insulina Lispro in animal experiments.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310741</data>
  <data key="d6"></data>
</node>
<node id="Human Milk Excretion">
  <data key="d0">Human Milk Excretion</data>
  <data key="d1">concept</data>
  <data key="d2">Human Milk Excretion describes the transfer of substances into breast milk, mentioned regarding Insulina Lispro and Insulina Humana.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310741</data>
  <data key="d6"></data>
</node>
<node id="Therapeutic Dose of Insulina">
  <data key="d0">Therapeutic Dose of Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Therapeutic Dose of Insulina denotes the medically appropriate amount of insulin administered to achieve glycemic control.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310741</data>
  <data key="d6"></data>
</node>
<node id="Insulina Needs">
  <data key="d0">Insulina Needs</data>
  <data key="d1">concept</data>
  <data key="d2">Insulina Needs represent the amount of insulin required by a patient, varying with pregnancy, organ function, or drug interactions.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310741</data>
  <data key="d6"></data>
</node>
<node id="Pregnancy Category B">
  <data key="d0">Pregnancy Category B</data>
  <data key="d1">concept</data>
  <data key="d2">Pregnancy Category B indicates that animal studies have not demonstrated risk to the fetus, applied to Humalog Mix 25 KwikPen.&lt;SEP&gt;Pregnancy Category B indicates a medication may be used during pregnancy with careful monitoring.</data>
  <data key="d3">chunk-518838d3c8e8110567b1891b704bfef9&lt;SEP&gt;chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319722</data>
  <data key="d6"></data>
</node>
<node id="Insulin Lispro Protamina (NPL)">
  <data key="d0">Insulin Lispro Protamina (NPL)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Insulin Lispro Protamina (NPL) is a protamine‑bound form of insulin lispro used in pharmacokinetic comparison studies.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310741</data>
  <data key="d6"></data>
</node>
<node id="Insulin Humana Isofana (NPH)">
  <data key="d0">Insulin Humana Isofana (NPH)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Insulin Humana Isofana (NPH) is an intermediate‑acting human insulin suspension used as a reference in absorption studies.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310741</data>
  <data key="d6"></data>
</node>
<node id="Hypersensitivity to Insulin Lispro">
  <data key="d0">Hypersensitivity to Insulin Lispro</data>
  <data key="d1">concept</data>
  <data key="d2">Hypersensitivity to Insulin Lispro is an allergic reaction to insulin lispro or any component of its formulation.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310742</data>
  <data key="d6"></data>
</node>
<node id="TZD (Thiazolidinedione)">
  <data key="d0">TZD (Thiazolidinedione)</data>
  <data key="d1">concept</data>
  <data key="d2">TZD (Thiazolidinedione) is a class of oral antidiabetic drugs that, when combined with insulin, raises the risk of edema and heart failure.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310742</data>
  <data key="d6"></data>
</node>
<node id="Activity Change">
  <data key="d0">Activity Change</data>
  <data key="d1">concept</data>
  <data key="d2">Activity Change is a modification in physical activity that may necessitate insulin dose adjustment.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310742</data>
  <data key="d6"></data>
</node>
<node id="Diet Change">
  <data key="d0">Diet Change</data>
  <data key="d1">concept</data>
  <data key="d2">Diet Change is a modification in dietary habits that may necessitate insulin dose adjustment.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310743</data>
  <data key="d6"></data>
</node>
<node id="Mutagenesis">
  <data key="d0">Mutagenesis</data>
  <data key="d1">concept</data>
  <data key="d2">Mutagenesis is the potential genetic mutation effect examined for insulin lispro, found to be negative.&lt;SEP&gt;Mutagenesis is the induction of genetic mutations, which human insulin was shown not to cause.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3&lt;SEP&gt;chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319728</data>
  <data key="d6"></data>
</node>
<node id="Fertility Damage">
  <data key="d0">Fertility Damage</data>
  <data key="d1">concept</data>
  <data key="d2">Fertility Damage is a possible adverse effect on reproductive capacity investigated for insulin lispro.&lt;SEP&gt;Fertility damage refers to impairment of reproductive capability, not caused by human insulin in studies.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3&lt;SEP&gt;chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319728</data>
  <data key="d6"></data>
</node>
<node id="Animal Study">
  <data key="d0">Animal Study</data>
  <data key="d1">event</data>
  <data key="d2">Animal Study is a one‑year toxicology investigation in animals evaluating high subcutaneous doses of insulin lispro.</data>
  <data key="d3">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310743</data>
  <data key="d6"></data>
</node>
