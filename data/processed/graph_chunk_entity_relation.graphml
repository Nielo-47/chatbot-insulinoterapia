<node id="Nível De Glicose No Sangue">
  <data key="d0">Nível De Glicose No Sangue</data>
  <data key="d1">data</data>
  <data key="d2">The measured concentration of glucose in the bloodstream.</data>
  <data key="d3">chunk-1be43b1b23852278983f60d0f150b0f9</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
