  <data key="d14"></data>
</edge>
<edge source="Insulina Humana" target="Unidade Internacional">
  <data key="d8">2.0</data>
  <data key="d9">One Unidade Internacional (UI) of human insulin corresponds to 0.035 mg of anhydrous human insulin.&lt;SEP&gt;The potency of human insulin is measured in International Units (UI), with 1 UI equivalent to 0.035 mg of anhydrous insulin.</data>
  <data key="d10">biological equivalence,dosage measurement,pharmaceutical standard</data>
  <data key="d11">chunk-e53353cd9fcafe8d9581b3d0e7980b50&lt;SEP&gt;chunk-b1d9cc89371adea01fc1a946ca6d1690</data>
