  <data key="d11">chunk-cd6b0367ed2176146798e5cf697d0aeb</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694596</data>
  <data key="d14"></data>
</edge>
<edge source="Infection" target="Agulha">
  <data key="d8">1.0</data>
  <data key="d9">Using a non-sterile or reused agulha can lead to infection at the injection site.</data>
  <data key="d10">health risk,sterile use</data>
  <data key="d11">chunk-5d212ccdded1e4ccf51af243a8d38b4c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698401</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Abdomen">
  <data key="d8">1.0</data>
  <data key="d9">During the third trimester of pregnancy, insulin should not be injected into the abdomen to avoid risks to the baby and ensure proper dosing.</data>
  <data key="d10">contraindication,safety precaution</data>
  <data key="d11">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695458</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="4 mm Needle">
  <data key="d8">2.0</data>
  <data key="d9">A 4 mm needle is recommended during pregnancy to ensure insulin is delivered safely into subcutaneous tissue.&lt;SEP&gt;A 4 mm needle is recommended during pregnancy due to thinning of subcutaneous tissue from uterine expansion.</data>
  <data key="d10">adaptation,medical device,recommended equipment,safe delivery</data>
  <data key="d11">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696009</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="45° Injection Angle">
  <data key="d8">1.0</data>
  <data key="d9">A 45° injection angle is advised during pregnancy to prevent intramuscular injection due to stretched abdominal skin.</data>
  <data key="d10">recommended technique,safe delivery</data>
  <data key="d11">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695461</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Insulin Application">
  <data key="d8">1.0</data>
  <data key="d9">Pregnancy requires modifications to insulin application techniques, including needle length, injection angle, and avoidance of abdominal injections in the third trimester.</data>
  <data key="d10">safety,treatment adaptation</data>
  <data key="d11">chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696011</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Levemir">
  <data key="d8">3.0</data>
  <data key="d9">Levemir can be used during pregnancy under medical supervision, with clinical and post-marketing data supporting its safety.&lt;SEP&gt;Levemir was studied in pregnant women with diabetes to assess risks of congenital malformations, perinatal death, and other adverse outcomes.&lt;SEP&gt;Levemir has been studied in pregnant women with type 1 diabetes and may be used during pregnancy if clinically necessary, showing a safety profile similar to insulin NPH.</data>
  <data key="d10">clinical use,fetal safety,maternal treatment,medical use,safety,safety evaluation</data>
  <data key="d11">chunk-da213aa66bddbd8e1bd2aba01ceb9f2d&lt;SEP&gt;chunk-00bac63e27caeb094fe802c0bfe00a44&lt;SEP&gt;chunk-9266b0855586c9a971861beb4d3289fa</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698149</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Clinical Study">
  <data key="d8">1.0</data>
  <data key="d9">A clinical study evaluated the safety of Levemir in pregnant women with type 1 diabetes.</data>
  <data key="d10">research focus,safety evaluation</data>
  <data key="d11">chunk-00bac63e27caeb094fe802c0bfe00a44</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698167</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Post-Marketing Data">
  <data key="d8">1.0</data>
  <data key="d9">Post-marketing data from over 4,500 pregnancies support the safety of Levemir during pregnancy.</data>
  <data key="d10">real-world data,safety evidence</data>
  <data key="d11">chunk-00bac63e27caeb094fe802c0bfe00a44</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698168</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Post-Authorization Safety Study">
  <data key="d8">1.0</data>
  <data key="d9">A post-authorization safety study was conducted to evaluate pregnancy outcomes in women exposed to Levemir or other basal insulins.</data>
  <data key="d10">observational study,safety monitoring</data>
  <data key="d11">chunk-9266b0855586c9a971861beb4d3289fa</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698191</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Novolin® R Penfill®">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill® is safe during pregnancy, with insulin needs typically decreasing in the first trimester and increasing in the second and third trimesters.</data>
  <data key="d10">dosage dynamics,treatment safety</data>
  <data key="d11">chunk-62a6c42a674563e36382f398efac64a3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699014</data>
  <data key="d14"></data>
</edge>
<edge source="Pregnancy" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R is categorized as pregnancy risk class B and is safe to use during pregnancy as insulin does not cross the placenta.</data>
  <data key="d10">medication safety,placental barrier</data>
  <data key="d11">chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699236</data>
  <data key="d14"></data>
</edge>
<edge source="Glycemic Monitoring" target="Novolin® R Penfill">
  <data key="d8">1.0</data>
  <data key="d9">Glycemic monitoring is necessary during intravenous infusion of Novolin® R to manage blood glucose levels safely.</data>
  <data key="d10">safety measure,treatment requirement</data>
  <data key="d11">chunk-ff021af578e58080f6a865c5f105e6d3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699083</data>
  <data key="d14"></data>
</edge>
<edge source="Glycemic Monitoring" target="Insulin Dose Adjustment">
  <data key="d8">1.0</data>
  <data key="d9">Glycemic monitoring informs the need for insulin dose adjustments, especially after changing injection sites.</data>
  <data key="d10">clinical decision,treatment guidance</data>
  <data key="d11">chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699238</data>
  <data key="d14"></data>
</edge>
<edge source="ACOG" target="Metas De Glicemia">
  <data key="d8">1.0</data>
  <data key="d9">A ACOG recomenda metas de glicemia abaixo de 90 mg/dL em jejum e abaixo de 140 mg/dL uma hora após as refeições para gestantes com diabetes.</data>
  <data key="d10">clinical guidelines,glycemic targets</data>
  <data key="d11">chunk-cd6b0367ed2176146798e5cf697d0aeb</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
