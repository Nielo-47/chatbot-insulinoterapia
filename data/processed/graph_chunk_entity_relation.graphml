  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707657</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Serial Number">
  <data key="d8">1.0</data>
  <data key="d9">The Serial Number on the CGM Device is used to match and select the correct device during pairing.</data>
  <data key="d10">device authentication,matching</data>
