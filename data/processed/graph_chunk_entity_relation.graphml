  <data key="d14"></data>
</edge>
<edge source="Startup Wizard" target="Enter Time Screen">
  <data key="d8">1.0</data>
  <data key="d9">After selecting the time format, the Enter Time screen appears as part of the Startup Wizard to collect the current time.</data>
