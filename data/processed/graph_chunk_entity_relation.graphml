  <data key="d6"></data>
</node>
<node id="Last Glucose Entry">
  <data key="d0">Last Glucose Entry</data>
  <data key="d1">data</data>
  <data key="d2">Last glucose entry is the most recent blood glucose value input into the pump system.</data>
  <data key="d3">chunk-28e93fcffd71ed0c035f0b03374608e5</data>
