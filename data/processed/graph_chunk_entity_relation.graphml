  <data key="d13">1778704362</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Rate" target="Pattern Basal">
  <data key="d8">1.0</data>
  <data key="d9">The pattern basal allows the user to switch between different predefined basal rate schedules.</data>
  <data key="d10">delivery programming,schedule selection</data>
  <data key="d11">chunk-0aabf7352e5784edc898ebb03d127f44</data>
