  <data key="d0">SMCG Diagnóstico</data>
  <data key="d1">concept</data>
  <data key="d2">SMCG Diagnóstico refers to the diagnostic application of glucose sensor data for clinical evaluation.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
