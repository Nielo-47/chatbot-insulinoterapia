  <data key="d13"></data>
</edge>
<edge source="Instinct Sensor" target="MiniMed 780G Insulin Pump System">
  <data key="d7">1.0</data>
  <data key="d8">The Instinct sensor requires the MiniMed Mobile App for security precautions during pairing with the pump.</data>
  <data key="d9">app security,pairing</data>
