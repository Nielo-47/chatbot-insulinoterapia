  <data key="d0">CNPJ</data>
  <data key="d1">data</data>
  <data key="d2">CNPJ is a Brazilian corporate tax identification number, with the value 82.277.955/0001-55 assigned to Novo Nordisk Farmacêutica do Brasil Ltda.&lt;SEP&gt;CNPJ is a Brazilian corporate tax identification number, with value 82.277.955/0001-55 assigned to Novo Nordisk Farmacêutica do Brasil Ltda.</data>
  <data key="d3">chunk-6ca90008a805c9c66eac7ba65db90fdb&lt;SEP&gt;chunk-bad7b7e8e5212b6d7ea0f4b0505f82c0</data>
