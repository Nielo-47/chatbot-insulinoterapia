<node id="Cancelacion Basal Temporal">
  <data key="d0">Cancelacion Basal Temporal</data>
  <data key="d1">method</data>
  <data key="d2">Cancelacion Basal Temporal is the process of stopping a temporary basal insulin rate before its scheduled end.</data>
  <data key="d3">chunk-5b6ed50dde321317a11d8dcc6ef2a579</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d5">1778700896</data>
