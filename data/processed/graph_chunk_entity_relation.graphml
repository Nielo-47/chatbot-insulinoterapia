  <data key="d0">Mistura De Insulina Bovina‑Suína</data>
  <data key="d1">artifact</data>
  <data key="d2">Mistura De Insulina Bovina‑Suína (MBS) is a combined bovine‑porcine insulin formulation used in a long‑term study and later switched to human insulin.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319695</data>
  <data key="d6"></data>
</node>
<node id="Insulina Humana Solúvel">
  <data key="d0">Insulina Humana Solúvel</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Humana Solúvel is a sterile aqueous solution of human insulin produced by genetically modified Escherichia coli and acts as a short‑acting glucose‑lowering agent.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319695</data>
  <data key="d6"></data>
</node>
<node id="Concentração Média De Glicose">
  <data key="d0">Concentração Média De Glicose</data>
  <data key="d1">data</data>
  <data key="d2">Concentração Média De Glicose represents the average capillary blood glucose measured over seven samples in a day for each treatment group.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319695</data>
  <data key="d6"></data>
</node>
<node id="Índice M Modificado">
  <data key="d0">Índice M Modificado</data>
  <data key="d1">data</data>
  <data key="d2">Índice M Modificado is a modified M index employed to assess glucose control in the clinical trial.&lt;SEP&gt;Índice M Modificado is a calculated insulin requirement index compared between treatment groups in the study.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d&lt;SEP&gt;chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319695</data>
  <data key="d6"></data>
</node>
