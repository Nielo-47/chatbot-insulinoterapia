<node id="Profissional">
  <data key="d0">Profissional</data>
  <data key="d1">person</data>
  <data key="d2">Profissional refers to the healthcare provider who reviews glucose data and adjusts treatment.&lt;SEP&gt;Profissional is the healthcare worker who reported not shaking the insulin vial before use.</data>
