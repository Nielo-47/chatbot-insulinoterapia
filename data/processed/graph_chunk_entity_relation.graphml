  <data key="d14"></data>
</edge>
<edge source="Pump" target="Insulin-Filled Reservoir">
  <data key="d8">1.0</data>
  <data key="d9">Inserting an insulin-filled reservoir into the pump during training is warned against to prevent unintentional insulin infusion.</data>
  <data key="d10">insulin delivery,safety warning</data>
  <data key="d11">chunk-6f4df342459d4afd90a81b1a3f13d859</data>
