  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Gastroparesis">
  <data key="d8">1.0</data>
  <data key="d9">A Square Wave bolus is beneficial for individuals with gastroparesis due to delayed food digestion.</data>
  <data key="d10">clinical use case,therapeutic benefit</data>
  <data key="d11">chunk-14b0e9023a7c03c6a284d69e0930b8a9</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708461</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Meals High In Fat">
  <data key="d8">1.0</data>
  <data key="d9">A Square Wave bolus is recommended for meals high in fat because they digest slowly and require prolonged insulin delivery.</data>
  <data key="d10">clinical use case,digestion delay</data>
  <data key="d11">chunk-14b0e9023a7c03c6a284d69e0930b8a9</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708462</data>
  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="Normal Bolus">
  <data key="d8">3.0</data>
  <data key="d9">A Normal Bolus can be delivered while the Square portion of a Dual Wave Bolus is being administered.&lt;SEP&gt;When a normal bolus and the Square portion of a Dual Wave bolus are delivered together, both are stopped if one is interrupted.&gt;&lt;SEP&gt;The Dual Wave bolus includes a normal bolus as part of its combined insulin delivery method.</data>
  <data key="d10">bolus combination,bolus interaction,bolus type,delivery mode,insulin delivery,simultaneous delivery</data>
  <data key="d11">chunk-d536bf636b4a29c1f9f46de648b2b306&lt;SEP&gt;chunk-02b21bc8135e144a626f42f84747459d&lt;SEP&gt;chunk-e90de561bcfc1f3544a690722c75e6f2</data>
