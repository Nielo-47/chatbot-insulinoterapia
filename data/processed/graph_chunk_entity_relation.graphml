</node>
<node id="Insulin Manufacturing Process">
  <data key="d0">Insulin Manufacturing Process</data>
  <data key="d1">method</data>
  <data key="d2">Insulin manufacturing process involves recombinant DNA techniques to produce human insulin in bacterial cultures.</data>
  <data key="d3">chunk-a1245bd9ff75c998b49dab861cc4cebf</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
