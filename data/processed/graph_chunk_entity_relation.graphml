</node>
<node id="Cloud Connectivity">
  <data key="d0">Cloud Connectivity</data>
  <data key="d1">concept</data>
  <data key="d2">Cloud Connectivity refers to the capability of insulin pumps to transmit data to internet‑based storage or services.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
