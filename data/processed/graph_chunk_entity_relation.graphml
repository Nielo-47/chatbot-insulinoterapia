</node>
<node id="Insulina Humana Biossintética">
  <data key="d0">Insulina Humana Biossintética</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Humana Biossintética (IHB) is a biosynthetic human insulin used in a six‑week comparative study with animal insulins.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
