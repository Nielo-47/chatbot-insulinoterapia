</edge>
<edge source="Novolin® R Penfill" target="Insulin Adsorption">
  <data key="d8">1.0</data>
  <data key="d9">A certain amount of insulin is initially adsorbed onto the infusion bag material, affecting available dosage.</data>
  <data key="d10">dosage impact,material interaction</data>
  <data key="d11">chunk-ff021af578e58080f6a865c5f105e6d3</data>
