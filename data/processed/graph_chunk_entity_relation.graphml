  <data key="d0">Não Congelar</data>
  <data key="d1">concept</data>
  <data key="d2">Não congelar specifies that APIDRA SOLOSTAR must not be placed in a freezer or subjected to freezing temperatures.</data>
  <data key="d3">chunk-b060d4f68031bd35dfafc19eadf1e9fe</data>
