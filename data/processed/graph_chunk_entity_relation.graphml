</node>
<node id="Abdomen (Lateral Sides)">
  <data key="d0">Abdomen (Lateral Sides)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The right and left lateral areas of the abdomen, a recommended injection site except during the third trimester of pregnancy.</data>
  <data key="d3">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1786299840</data>
