  <data key="d6"></data>
</node>
<node id="Insulina Bovina">
  <data key="d0">Insulina Bovina</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Bovina is bovine insulin used as a comparator in the clinical study.&lt;SEP&gt;Insulina Bovina is bovine insulin administered to patients and compared with IHB in glucose and insulin‑dose outcomes.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d&lt;SEP&gt;chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319695</data>
  <data key="d6"></data>
</node>
<node id="Insulina Suína">
  <data key="d0">Insulina Suína</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Suína is porcine insulin used as a comparator in the clinical study.&lt;SEP&gt;Insulina Suína is porcine insulin administered to patients and compared with IHB in glucose and insulin‑dose outcomes.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d&lt;SEP&gt;chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319695</data>
  <data key="d6"></data>
</node>
