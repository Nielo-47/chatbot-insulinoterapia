  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G Insulin Pump" target="Pump Error">
  <data key="d8">1.0</data>
  <data key="d9">After storage, the MiniMed 780G Insulin Pump displays a Pump Error alarm requiring user confirmation to restart.</data>
  <data key="d10">error condition,system restart</data>
