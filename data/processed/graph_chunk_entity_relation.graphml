  <data key="d13"></data>
</edge>
<edge source="Irregular Insulin Absorption" target="Blood Glucose Variation">
  <data key="d7">1.0</data>
  <data key="d8">Irregular Insulin Absorption can cause large Blood Glucose Variation throughout the day.</data>
  <data key="d9">potential outcome,variability</data>
