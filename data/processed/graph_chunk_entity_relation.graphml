<edge source="Teplizumab" target="DM1 Phase 3">
  <data key="d7">1.0</data>
  <data key="d8">Use of teplizumab was associated with a later diagnosis of DM1 (median 48.4 months vs 24.4 months for placebo).</data>
  <data key="d9">delayed progression</data>
