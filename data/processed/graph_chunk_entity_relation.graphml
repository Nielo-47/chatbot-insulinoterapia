<node id="Subcutaneous Aspart">
  <data key="d0">Subcutaneous Aspart</data>
  <data key="d1">concept</data>
  <data key="d2">A rapid‑acting insulin administered subcutaneously, used as the control arm in the Galderisi Study.</data>
  <data key="d3">chunk-e76c949a607724dd052d9fc4c7127a18</data>
