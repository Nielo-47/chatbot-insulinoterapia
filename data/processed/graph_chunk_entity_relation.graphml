  <data key="d14"></data>
</edge>
<edge source="Test Strip" target="Enzyme">
  <data key="d8">2.0</data>
  <data key="d9">The enzyme in the test strip reacts with glucose in the blood to produce an electrical current proportional to the glucose concentration.&lt;SEP&gt;The enzyme on the test strip reacts with blood sugar to initiate the glucose measurement process.</data>
  <data key="d10">chemical component,chemical reaction,glucose detection,reaction mechanism</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5&lt;SEP&gt;chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
