</edge>
<edge source="Hyperglycemia" target="Cold">
  <data key="d7">1.0</data>
  <data key="d8">Cold (cold compress, dehydration) slows insulin absorption, potentially leading to Hyperglycemia.</data>
  <data key="d9">deceleration,risk</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
