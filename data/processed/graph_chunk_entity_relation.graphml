</node>
<node id="Lipólise">
  <data key="d0">Lipólise</data>
  <data key="d1">concept</data>
  <data key="d2">Lipólise is the breakdown of lipids in adipocytes, which is suppressed by insulin action.</data>
  <data key="d3">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315408</data>
  <data key="d6"></data>
</node>
<node id="Proteólise">
  <data key="d0">Proteólise</data>
  <data key="d1">concept</data>
  <data key="d2">Proteólise is the degradation of proteins, a process that insulin inhibits.</data>
  <data key="d3">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
