  <data key="d0">Estudo Caso-Controle Clínico</data>
  <data key="d1">method</data>
  <data key="d2">Estudo Caso-Controle Clínico is a clinical case‑control study design employed to compare diabetes classification methods.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
