<node id="Lipodystrophy Syndromes">
  <data key="d0">Lipodystrophy Syndromes</data>
  <data key="d1">concept</data>
  <data key="d2">Lipodystrophy syndromes are disorders of abnormal fat distribution addressed in multi‑society practice guidelines.</data>
