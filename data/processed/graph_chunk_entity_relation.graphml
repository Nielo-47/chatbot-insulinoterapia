<edge source="MiniMed 780G Insulin Pump" target="Blood Glucose Meter Reading">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G insulin pump allows users to enter and accept blood glucose (BG) meter readings for system calibration and verification.</data>
