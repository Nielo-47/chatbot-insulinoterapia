  <data key="d0">U‑500 Syringes</data>
  <data key="d1">artifact</data>
  <data key="d2">U‑500 syringes are syringes marked for use with U‑500 insulin, allowing delivery of higher‑concentration insulin doses.</data>
  <data key="d3">chunk-05cc642337c2a615c9b40de9336aec18</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335936</data>
