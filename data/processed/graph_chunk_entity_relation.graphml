</node>
<node id="Glycemic Targets: Standards Of Care In Diabetes">
  <data key="d0">Glycemic Targets: Standards Of Care In Diabetes</data>
  <data key="d1">content</data>
  <data key="d2">This publication outlines recommended glycemic targets and standards of care for diabetes management.</data>
  <data key="d3">chunk-ee7ecd9171c82c15f635a8a9b605621c</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Hipoglicemia_SBD_transcricao.docx</data>
