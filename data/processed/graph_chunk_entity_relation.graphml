  <data key="d0">Análogo De Insulina Na Refeição</data>
  <data key="d1">concept</data>
  <data key="d2">Análogo de insulina na refeição is a prandial insulin analog referenced for use in combination therapy.</data>
  <data key="d3">chunk-97208e231aa338c60205244ac12e0492</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313541</data>
  <data key="d6"></data>
</node>
<node id="Insulin Glargine 300 U/mL">
  <data key="d0">Insulin Glargine 300 U/mL</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin Glargine 300 U/mL is a high‑concentration formulation of insulin glargine supplied at 300 units per milliliter.</data>
  <data key="d3">chunk-97208e231aa338c60205244ac12e0492</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
