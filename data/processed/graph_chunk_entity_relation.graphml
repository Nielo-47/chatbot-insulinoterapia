</node>
<node id="Clinical Study Data">
  <data key="d0">Clinical Study Data</data>
  <data key="d1">data</data>
  <data key="d2">Clinical Study Data refers to the results of two randomized controlled trials involving pregnant women exposed to NovoRapid®.</data>
