  <data key="d0">AUC Insulin Aspart 0-30 Min</data>
  <data key="d1">data</data>
  <data key="d2">AUC Insulin Aspart 0‑30 min quantifies insulin exposure during the first half hour after dosing.</data>
  <data key="d3">chunk-2f4f01a72f35d6db3ff333e64f8400ce</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316038</data>
  <data key="d6"></data>
</node>
