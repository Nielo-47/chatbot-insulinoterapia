</node>
<node id="Finalizado">
  <data key="d0">Finalizado</data>
  <data key="d1">concept</data>
  <data key="d2">Finalizado indicates the completion of a configuration or editing process, signaling that changes have been applied.</data>
  <data key="d3">chunk-1134674d4e1ab07998567f3fa77e251d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
