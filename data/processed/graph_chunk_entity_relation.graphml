  <data key="d0">Inserção a 90 graus</data>
  <data key="d1">method</data>
  <data key="d2">Inserção a 90 graus describes inserting the needle at a right angle to the skin surface.</data>
  <data key="d3">chunk-b64741e11a7d852f462b1269fabfbe43</data>
