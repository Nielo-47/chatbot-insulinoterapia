  <data key="d1">artifact</data>
  <data key="d2">Recipiente de material contaminado e/ou perfurocortante is a specialized container provided for the disposal of syringes, needles, lancets, and test strips.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
