  <data key="d14"></data>
</edge>
<edge source="Hipoglicemia" target="Sulfonamides">
  <data key="d8">1.0</data>
  <data key="d9">Sulfonamides may enhance insulin's hypoglycemic action, leading to an increased risk of hypoglycemia.</data>
  <data key="d10">drug interaction,glucose lowering</data>
