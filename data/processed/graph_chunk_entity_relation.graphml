  <data key="d13"></data>
</edge>
<edge source="A1C" target="Nathan et al. Study">
  <data key="d7">1.0</data>
  <data key="d8">The Nathan et al. study reported a strong correlation (0.92) between A1C and average glucose based on data from adults with type 1, type 2, or no diabetes.</data>
  <data key="d9">correlation,source</data>
  <data key="d10">chunk-ba0417a72f50cf7ca66c87a351bd1ff8</data>
