  <data key="d13">1778704682</data>
  <data key="d14"></data>
</edge>
<edge source="Adverse Events" target="Accu-Chek Solo">
  <data key="d8">1.0</data>
  <data key="d9">Adverse events are linked to the use of the Accu-Chek Solo device and must be monitored and reported for safety and regulatory purposes.</data>
  <data key="d10">device safety,risk monitoring</data>
  <data key="d11">chunk-a66c98111c91022bbcbc621e0fea07fe</data>
