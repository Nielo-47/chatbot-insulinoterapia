<node id="Temporal Basal Rate">
  <data key="d0">Temporal Basal Rate</data>
  <data key="d1">method</data>
  <data key="d2">Temporal basal rate is a temporary adjustment to the basal insulin delivery, either as a percentage or a defined rate, for a specified duration.</data>
  <data key="d3">chunk-e96a4da2f877f1b93eb7d982c91358ea</data>
