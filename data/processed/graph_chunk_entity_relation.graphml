  <data key="d12">1786329797</data>
  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Soft Cannula">
  <data key="d7">2.0</data>
  <data key="d8">The soft cannula is part of the infusion set and may become dislodged or clogged.&lt;SEP&gt;The infusion set incorporates a soft cannula that connects the pump to the body.</data>
  <data key="d9">component,contains</data>
  <data key="d10">chunk-474703bb16e6e26e009e9d433c3d3647&lt;SEP&gt;chunk-db5749bec4af1c3ea068b257c4376aaf</data>
