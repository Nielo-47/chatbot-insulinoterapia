  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Overdose of Humalog">
  <data key="d7">1.0</data>
  <data key="d8">A large dose of Humalog can cause hypoglycemia, a dangerous drop in blood sugar.</data>
  <data key="d9">adverse effect</data>
  <data key="d10">chunk-431b48980656b0322f263c358250b593</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/Bula Humalog.pdf</data>
