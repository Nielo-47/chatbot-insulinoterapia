  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313637</data>
  <data key="d6"></data>
</node>
<node id="Toxicidade Reprodutiva">
  <data key="d0">Toxicidade Reprodutiva</data>
  <data key="d1">concept</data>
  <data key="d2">Toxicidade Reprodutiva includes embryotoxicity, teratogenicity and fertility investigations of insulin glargina.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313637</data>
  <data key="d6"></data>
</node>
<node id="Teratogenicidade">
  <data key="d0">Teratogenicidade</data>
  <data key="d1">concept</data>
  <data key="d2">Teratogenicidade refers to the potential of a substance to cause birth defects; insulin glargina was found non‑teratogenic.&lt;SEP&gt;Teratogenicidade is the potential of a substance to cause embryonic or fetal developmental defects.&lt;SEP&gt;Teratogenicidade denotes the ability of a substance to cause fetal developmental abnormalities.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e212a20942ed5387efe96e92bdb4ba98&lt;SEP&gt;chunk-e3418c4ee80182ca29214dd54b0d9647</data>
