<edge source="Insulin" target="Square Bolus">
  <data key="d8">1.0</data>
  <data key="d9">Insulin is delivered through a square bolus method, which administers a steady dose over a set period to match delayed carbohydrate absorption.</data>
  <data key="d10">extended release,hormone delivery</data>
  <data key="d11">chunk-69f89cc6358f0fe2b490d63a60ae0581</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
