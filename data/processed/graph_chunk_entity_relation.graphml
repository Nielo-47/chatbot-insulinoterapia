</node>
<node id="Cmáx Humana">
  <data key="d0">Cmáx Humana</data>
  <data key="d1">concept</data>
  <data key="d2">Cmáx Humana denotes the maximum human concentration used as a reference for scaling animal dose exposures.</data>
  <data key="d3">chunk-c95471c4c993fa3a499f99443ee7c922</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315457</data>
  <data key="d6"></data>
</node>
<node id="Insulin Potency">
  <data key="d0">Insulin Potency</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Potency describes the strength of an insulin preparation, changes of which can affect required dosing.</data>
  <data key="d3">chunk-c95471c4c993fa3a499f99443ee7c922</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315458</data>
  <data key="d6"></data>
</node>
<node id="First Trimester">
  <data key="d0">First Trimester</data>
  <data key="d1">concept</data>
  <data key="d2">First Trimester is the initial three‑month period of pregnancy during which insulin needs may decrease.</data>
  <data key="d3">chunk-c95471c4c993fa3a499f99443ee7c922</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315458</data>
  <data key="d6"></data>
</node>
<node id="Second Trimester">
  <data key="d0">Second Trimester</data>
  <data key="d1">concept</data>
  <data key="d2">Second Trimester is the middle three‑month period of pregnancy during which insulin needs generally increase.</data>
  <data key="d3">chunk-c95471c4c993fa3a499f99443ee7c922</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315459</data>
  <data key="d6"></data>
</node>
<node id="Postpartum Period">
  <data key="d0">Postpartum Period</data>
  <data key="d1">concept</data>
  <data key="d2">Postpartum Period refers to the time after delivery when insulin requirements rapidly decline.&lt;SEP&gt;Postpartum Period refers to the 4–12 weeks after delivery during which diabetes screening may be performed.</data>
  <data key="d3">chunk-c95471c4c993fa3a499f99443ee7c922&lt;SEP&gt;chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Fetus">
  <data key="d0">Fetus</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Fetus is the developing human organism in utero, referenced regarding safety of insulin glulisina exposure.</data>
  <data key="d3">chunk-c95471c4c993fa3a499f99443ee7c922</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315459</data>
  <data key="d6"></data>
</node>
<node id="Newborn">
  <data key="d0">Newborn</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Newborn is the infant shortly after birth, referenced regarding safety of insulin glulisina exposure.</data>
  <data key="d3">chunk-c95471c4c993fa3a499f99443ee7c922</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315460</data>
  <data key="d6"></data>
</node>
