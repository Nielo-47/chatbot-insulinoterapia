<node id="Caneta Vazia">
  <data key="d0">Caneta Vazia</data>
  <data key="d1">artifact</data>
  <data key="d2">Caneta vazia is an empty insulin pen that must never be reused and should be discarded properly.</data>
  <data key="d3">chunk-b060d4f68031bd35dfafc19eadf1e9fe</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
