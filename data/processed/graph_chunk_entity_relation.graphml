  <data key="d5">1778708763</data>
  <data key="d6"></data>
  <data key="d7">Insulina Regular</data>
</node>
<node id="Cateter">
  <data key="d0">Cateter</data>
  <data key="d1">artifact</data>
  <data key="d2">Cateter é um tubo fino, flexível e transparente que conduz a insulina do reservatório até a cânula.</data>
