  <data key="d13">1778707485</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Pattern" target="Temp Basal">
  <data key="d8">1.0</data>
  <data key="d9">Temp Basal allows temporary modification of the basal rate defined in the Basal Pattern.</data>
  <data key="d10">insulin delivery adjustment,scheduling</data>
  <data key="d11">chunk-583197b9760861a9bb1ee261914759fc</data>
