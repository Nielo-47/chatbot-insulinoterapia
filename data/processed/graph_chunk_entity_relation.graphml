  <data key="d13"></data>
</edge>
<edge source="Levemir" target="Renal Dysfunction">
  <data key="d7">1.0</data>
  <data key="d8">Patients with renal dysfunction using Levemir® need intensified glucose monitoring and individualized dose adjustment.</data>
  <data key="d9">dosage adjustment,monitoring</data>
  <data key="d10">chunk-0ace26fdb0244e3d0f714a007c9bbb51</data>
