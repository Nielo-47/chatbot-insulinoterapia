  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Full‑Body Scanner">
  <data key="d7">1.0</data>
  <data key="d8">Passengers may need to temporarily remove the insulin pump when passing through a full‑body scanner.</data>
  <data key="d9">removal,security</data>
