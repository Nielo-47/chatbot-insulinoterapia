  <data key="d6"></data>
</node>
<node id="Insulinização Plena">
  <data key="d0">Insulinização Plena</data>
  <data key="d1">concept</data>
  <data key="d2">Insulinização Plena refers to full insulinization of patients with diabetes, particularly type 1 and type 2.</data>
  <data key="d3">chunk-6f645bd7019e94151caaff47d6cbfcaf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Hipoglicemia_SBD_transcricao.docx</data>
