</edge>
<edge source="Levemir" target="Intramuscular Administration">
  <data key="d8">1.0</data>
  <data key="d9">Intramuscular administration of Levemir should be avoided due to unpredictable absorption.</data>
  <data key="d10">absorption risk,contraindication</data>
