</edge>
<edge source="Editar Basal 1" target="Finalizado">
  <data key="d8">1.0</data>
  <data key="d9">Selecting Finalizado confirms the completion of changes made in Editar Basal 1.</data>
  <data key="d10">process completion,user action</data>
  <data key="d11">chunk-1134674d4e1ab07998567f3fa77e251d</data>
