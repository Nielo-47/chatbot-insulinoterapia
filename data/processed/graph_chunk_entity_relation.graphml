  <data key="d6"></data>
</node>
<node id="Bolacha">
  <data key="d0">Bolacha</data>
  <data key="d1">artifact</data>
  <data key="d2">Bolacha is a type of cracker used as a follow-up snack after consuming fast-acting sugar to maintain stable glucose levels.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
