<node id="Aplicação da Insulina">
  <data key="d0">Aplicação da Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Aplicação da Insulina is the subtopic focusing on how to prepare and inject insulin.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
