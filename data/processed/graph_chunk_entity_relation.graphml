</edge>
<edge source="Bomba" target="Estado de la Bomba">
  <data key="d7">1.0</data>
  <data key="d8">The pump status screen provides details about battery level, reservoir volume, start time, and device identifiers.</data>
  <data key="d9">device info,status overview</data>
