  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d12">1786322981</data>
  <data key="d13"></data>
</edge>
<edge source="Bomba" target="Desbloqueo de la Bomba">
  <data key="d7">1.0</data>
  <data key="d8">The pump unlock method enables the user to regain access to the pump after inactivity mode.</data>
  <data key="d9">access,unlock method</data>
  <data key="d10">chunk-9b74c4d587eaa1f27358b25bcf758f1f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d12">1786322982</data>
  <data key="d13"></data>
</edge>
<edge source="Bomba" target="Icono de Audio">
  <data key="d7">1.0</data>
  <data key="d8">The audio icon indicates the current alert mode (audio, vibration, or both) of the pump.</data>
  <data key="d9">alert indicator,notification</data>
