</edge>
<edge source="Glucosa En Sangre" target="Cetoacidosis Diabetica">
  <data key="d8">1.0</data>
  <data key="d9">El aumento de glucosa en sangre es un indicador temprano y constante en el desarrollo de cetoacidosis diabetica.</data>
  <data key="d10">biochemical indicator,symptom progression</data>
  <data key="d11">chunk-17d4cfa9183f9c1eb5a0c2212479127a</data>
