  <data key="d13">1778707525</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Lost Sensor Signal Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Lost Sensor Signal Alert is generated when the CGM device fails to transmit data to the pump for up to 30 minutes.</data>
  <data key="d10">connectivity issue,signal loss</data>
  <data key="d11">chunk-a4dae9b37ffd9805fb682b2152950552</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707538</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Low Battery Transmitter Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Low Battery Transmitter Alert indicates the CGM transmitter requires recharging within 24 hours to continue functioning.</data>
  <data key="d10">device maintenance,power management</data>
  <data key="d11">chunk-a4dae9b37ffd9805fb682b2152950552</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707539</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Alert Before High">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device triggers an Alert Before High when sensor glucose levels approach the predefined high limit.</data>
  <data key="d10">glucose monitoring,threshold alert</data>
