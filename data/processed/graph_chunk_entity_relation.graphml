  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299922</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Intramuscular Route">
  <data key="d7">1.0</data>
  <data key="d8">Intramuscular Route accelerates absorption, raising risk of Hypoglycemia, especially in Children.</data>
  <data key="d9">hypoglycemia,risk</data>
  <data key="d10">chunk-4902fb11e4844af5cf6fd61f18b6e4ce</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1786301890</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Massage">
  <data key="d7">1.0</data>
  <data key="d8">Massage can cause rapid Insulin absorption, potentially leading to Hypoglycemia.</data>
  <data key="d9">hypoglycemia,risk</data>
  <data key="d10">chunk-4902fb11e4844af5cf6fd61f18b6e4ce</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1786301891</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Children">
  <data key="d7">2.0</data>
  <data key="d8">Children are particularly vulnerable to severe Hypoglycemia after Intramuscular insulin injection.&lt;SEP&gt;Children experience hypoglycemia more frequently due to excess insulin, missed meals, or intense activity.</data>
  <data key="d9">child,insulin overdose,population risk,vulnerability</data>
  <data key="d10">chunk-4902fb11e4844af5cf6fd61f18b6e4ce&lt;SEP&gt;chunk-dd2bfbe7cac15c6f6dc444a35691ae83</data>
