<node id="Liu">
  <data key="d0">Liu</data>
  <data key="d1">person</data>
  <data key="d2">Liu is an author who studied the effects of a mixed liposomal formulation on the pulmonary bioavailability of insulin.</data>
  <data key="d3">chunk-72d17b623cb9a58c2a50eac2ea814699</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/insulina inalavel.pdf</data>
