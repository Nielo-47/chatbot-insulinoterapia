<node id="Autoantibody Disappearance">
  <data key="d0">Autoantibody Disappearance</data>
  <data key="d1">concept</data>
  <data key="d2">Autoantibody Disappearance refers to the loss of detectable islet autoantibodies over time in the progression of type 1 diabetes.</data>
  <data key="d3">chunk-3cc61bc2e95346d553972b4371912e7f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
