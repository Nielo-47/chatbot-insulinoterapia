<node id="Oxygen Therapy">
  <data key="d0">Oxygen Therapy</data>
  <data key="d1">concept</data>
  <data key="d2">Oxygen therapy is medical administration of supplemental oxygen, representing a high oxygen tension condition.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
