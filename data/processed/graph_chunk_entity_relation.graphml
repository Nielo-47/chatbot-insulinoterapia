</node>
<node id="Postpartum Insulin Needs">
  <data key="d0">Postpartum Insulin Needs</data>
  <data key="d1">concept</data>
  <data key="d2">Postpartum Insulin Needs refer to the rapid return of insulin requirements to pre‑pregnancy levels after childbirth.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
