  <data key="d14"></data>
</edge>
<edge source="Alarm" target="Auto Suspend">
  <data key="d8">1.0</data>
  <data key="d9">Auto suspend triggers an alarm and stops insulin delivery if no buttons are pressed for a specified time.</data>
