  <data key="d14"></data>
</edge>
<edge source="Airport Security Devices" target="Transportation Security Administration">
  <data key="d8">1.0</data>
  <data key="d9">The Transportation Security Administration sets rules for airport security screening, including procedures for passengers with medical devices.</data>
  <data key="d10">regulatory oversight,travel guidelines</data>
