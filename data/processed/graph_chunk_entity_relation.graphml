  <data key="d14"></data>
</edge>
<edge source="Crianças" target="HUMULIN R">
  <data key="d8">1.0</data>
  <data key="d9">The use of HUMULIN R in children under 3 years of age has not been studied and should occur under medical supervision.</data>
  <data key="d10">medical supervision,pediatric use</data>
  <data key="d11">chunk-6398afdc8e1faa94220df6d070a1ade7</data>
