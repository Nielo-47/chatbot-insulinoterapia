  <data key="d0">Time in Target Range</data>
  <data key="d1">data</data>
  <data key="d2">Time in Target Range indicates the number of hours or percent of time blood glucose was within 70–180 mg/dL.</data>
  <data key="d3">chunk-da4119d4fc266b13dd11e47dd6f506ca</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
