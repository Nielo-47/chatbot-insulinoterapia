  <data key="d6"></data>
</node>
<node id="Insulin Syringes">
  <data key="d0">Insulin Syringes</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin syringes are disposable or reusable devices used to inject insulin, available in various volume markings.</data>
  <data key="d3">chunk-05cc642337c2a615c9b40de9336aec18</data>
