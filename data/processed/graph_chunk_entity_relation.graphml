  <data key="d13"></data>
</edge>
<edge source="Hyperglycemia" target="Lipo-Hipertrofia">
  <data key="d7">1.0</data>
  <data key="d8">Unpredictable insulin absorption in lipo-hipertrofia tissue can cause hyperglycemia.</data>
