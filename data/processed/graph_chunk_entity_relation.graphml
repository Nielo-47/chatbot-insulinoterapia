  <data key="d5">1786324183</data>
  <data key="d6"></data>
</node>
<node id="Medicamentos">
  <data key="d0">Medicamentos</data>
  <data key="d1">concept</data>
  <data key="d2">Medicamentos are medications that can interact with basal insulin dosing.&lt;SEP&gt;Medications are drugs that can influence glucose levels and may require consultation with the medical team.&lt;SEP&gt;Medication category of precipitating factors.</data>
  <data key="d3">chunk-505b4450257d1a728c397959b044ee97&lt;SEP&gt;chunk-4eaa74c3ef8165f52ddf18e17a240a9d&lt;SEP&gt;chunk-cbede05ec60d9c79d637d9a0eb0efe48</data>
