  <data key="d6"></data>
</node>
<node id="Luz De Fondo">
  <data key="d0">Luz De Fondo</data>
  <data key="d1">data</data>
  <data key="d2">Luz De Fondo adjusts the duration and behavior of the screen backlight for improved usability in low-light conditions.&lt;SEP&gt;Luz De Fondo determines how long the screen remains illuminated before entering power-saving mode.</data>
  <data key="d3">chunk-63644bff2af5cc96a50e636bff8e339b&lt;SEP&gt;chunk-b9a22fae9e4c986d3a8e2a8dcdad44fd</data>
