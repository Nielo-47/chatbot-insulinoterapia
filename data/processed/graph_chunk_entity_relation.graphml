  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Carbohydrate (20 G)">
  <data key="d7">1.0</data>
  <data key="d8">Hypoglycemia can be corrected by the immediate ingestion of 20 g of carbohydrate.</data>
  <data key="d9">correction,treatment</data>
  <data key="d10">chunk-3397508bdfddde019cb1dfdcfb352435</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
