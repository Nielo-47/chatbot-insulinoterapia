</edge>
<edge source="Insulin Pump" target="Alarm">
  <data key="d8">1.0</data>
  <data key="d9">An alarm is displayed on the insulin pump with a red icon, text, and repeated audio/vibration to indicate a critical issue preventing insulin delivery.</data>
