  <data key="d1">artifact</data>
  <data key="d2">Insulin U‑100 is the insulin formulation (100 units/mL) contained within the KWIKPEN.</data>
  <data key="d3">chunk-95354772f87ab3bc86a4730a1138dee9</data>
