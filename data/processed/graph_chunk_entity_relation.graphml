</edge>
<edge source="Correction Bolus" target="Current Glucose">
  <data key="d8">1.0</data>
  <data key="d9">Current glucose is used in the formula (current - target) to determine how much insulin is needed for correction.</data>
  <data key="d10">glucose difference,input parameter</data>
