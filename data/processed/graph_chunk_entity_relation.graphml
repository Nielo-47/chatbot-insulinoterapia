  <data key="d5">1786298825</data>
  <data key="d6"></data>
</node>
<node id="Seringa">
  <data key="d0">Seringa</data>
  <data key="d1">artifact</data>
  <data key="d2">Seringa is the syringe employed to draw and inject insulin from a vial.&lt;SEP&gt;Seringa is a syringe used to deliver insulina during injection.&lt;SEP&gt;Seringa is the syringe used to draw, mix, and inject insulin.&lt;SEP&gt;A syringe is the device used to draw and inject insulin doses.&lt;SEP&gt;A syringe employed to hold and administer insulin, possibly with a fixed needle for mixtures.&lt;SEP&gt;Seringa is a syringe required for drawing and administering insulin from vials.&lt;SEP&gt;Seringa is a disposable syringe used in diabetes treatment that must be discarded in a proper collector.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792&lt;SEP&gt;chunk-fed051c0c90a644e72ac31d765d73a6f&lt;SEP&gt;chunk-b64741e11a7d852f462b1269fabfbe43&lt;SEP&gt;chunk-59ce0fcadc9ae2a47a525390ae59d81c&lt;SEP&gt;chunk-2df359ca3783191b2159f8d3f6ea6c52&lt;SEP&gt;chunk-3396320470ee682ec5cc4f70ab001ef4&lt;SEP&gt;chunk-a48e1013c4a32aca64a00d073b2ee797</data>
