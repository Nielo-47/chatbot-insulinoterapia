  <data key="d13"></data>
</edge>
<edge source="One-Step Screening Strategy" target="Economic Evaluations of GDM Screening">
  <data key="d7">1.0</data>
  <data key="d8">Economic reviews found the one‑step method identifies more GDM cases than the two‑step method.</data>
  <data key="d9">case detection,cost‑effectiveness</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
