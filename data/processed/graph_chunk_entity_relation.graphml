<edge source="Insulina de Ação Rápida" target="Metanálise">
  <data key="d7">1.0</data>
  <data key="d8">The meta‑analysis compared rapid‑acting insulin analogues with regular human insulin and found reduced hypoglycemia.</data>
  <data key="d9">comparison,efficacy</data>
  <data key="d10">chunk-95c81e7ab8160456d9a63a9e0868205b</data>
