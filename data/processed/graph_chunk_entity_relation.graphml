  <data key="d12">1786372436</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Time in Range (TIR)">
  <data key="d7">1.0</data>
  <data key="d8">Time in Range correlates well with A1C in most studies, supporting its use as a metric of glycemic control.</data>
  <data key="d9">correlation,glycemic control</data>
