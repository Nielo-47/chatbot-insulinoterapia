<node id="Continuous Glucose Monitor (MCG)">
  <data key="d0">Continuous Glucose Monitor (MCG)</data>
  <data key="d1">artifact</data>
  <data key="d2">Continuous Glucose Monitor (MCG) provides real‑time glucose measurements used by various insulin pump systems.</data>
