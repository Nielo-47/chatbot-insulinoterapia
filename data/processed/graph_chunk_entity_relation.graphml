  <data key="d0">SMCG Pessoal</data>
  <data key="d1">concept</data>
  <data key="d2">SMCG Pessoal describes personal, continuous glucose monitoring intended for individual self‑management.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
