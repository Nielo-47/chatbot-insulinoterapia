  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="High‑Risk HLA‑DR4">
  <data key="d7">1.0</data>
  <data key="d8">High‑Risk HLA‑DR4 is present in the majority of checkpoint inhibitor‑related Type 1 Diabetes cases.</data>
