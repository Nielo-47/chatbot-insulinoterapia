</edge>
<edge source="Insulina" target="Reservorio">
  <data key="d8">2.0</data>
  <data key="d9">Reservorio holds the insulina used for continuous or bolus delivery.&lt;SEP&gt;The reservorio contains insulina before it is delivered to the body.</data>
  <data key="d10">device content,drug containment,medication storage</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d&lt;SEP&gt;chunk-01ce95c3ebe034549347b078008daa3c</data>
