  <data key="d0">95% Confidence Interval</data>
  <data key="d1">data</data>
  <data key="d2">95% Confidence Interval denotes the statistical range within which the true treatment ratio is expected to lie with 95 % certainty.</data>
  <data key="d3">chunk-2f4f01a72f35d6db3ff333e64f8400ce</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
