  <data key="d14"></data>
</edge>
<edge source="Easy Bolus" target="Manual Bolus">
  <data key="d8">2.0</data>
  <data key="d9">Easy Bolus allows users to deliver a bolus manually without complex calculations.&lt;SEP&gt;Easy bolus is a simplified form of manual bolus with preset options for quick delivery.</data>
  <data key="d10">bolus delivery,simplified dosing,user control</data>
  <data key="d11">chunk-1ef4fd0fa0c26a81460d7687cc37cf95&lt;SEP&gt;chunk-e2ad78a5db5d547aed7e2552fb1ec900</data>
