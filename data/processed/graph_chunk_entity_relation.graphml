  <data key="d0">Horm Metab Res</data>
  <data key="d1">content</data>
  <data key="d2">Horm Metab Res is a scientific journal cited in the reference list.&lt;SEP&gt;Horm Metab Res is a scientific journal referenced for several cited articles.&lt;SEP&gt;Horm Metab Res is a scientific journal cited as the source of reference 4.</data>
  <data key="d3">chunk-f46c503a378e6c69618036a038672417&lt;SEP&gt;chunk-b65ee62ad12239ddc729c50a1aef854c&lt;SEP&gt;chunk-2479751a6475c09415f0d79759db091d</data>
