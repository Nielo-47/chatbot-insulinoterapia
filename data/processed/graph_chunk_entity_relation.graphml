  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698255</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Zinc Acetate">
  <data key="d8">1.0</data>
  <data key="d9">Zinc acetate is used in Levemir® FlexPen® to stabilize insulin detemir and prolong its duration of action.</data>
  <data key="d10">excipient,stabilization</data>
  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698256</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Sodium Phosphate Dibasic Dihydrate">
  <data key="d8">1.0</data>
  <data key="d9">Sodium phosphate dibasic dihydrate is used to buffer the pH of the insulin solution in Levemir® FlexPen®.</data>
  <data key="d10">buffering agent,excipient</data>
  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698257</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Sodium Chloride">
  <data key="d8">1.0</data>
  <data key="d9">Sodium chloride is used to maintain osmotic balance in the Levemir® FlexPen® solution.</data>
  <data key="d10">excipient,isotonicity</data>
  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698258</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Sodium Hydroxide">
  <data key="d8">1.0</data>
  <data key="d9">Sodium hydroxide is used to adjust the pH of the insulin detemir solution in Levemir® FlexPen®.</data>
  <data key="d10">excipient,pH adjustment</data>
  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698259</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Hydrochloric Acid">
  <data key="d8">1.0</data>
  <data key="d9">Hydrochloric acid is used to adjust the pH of the insulin detemir solution in Levemir® FlexPen®.</data>
  <data key="d10">excipient,pH adjustment</data>
  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698261</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Water For Injections">
  <data key="d8">1.0</data>
  <data key="d9">Water for injections is the solvent used in the formulation of Levemir® FlexPen®.</data>
  <data key="d10">excipient,solvent</data>
  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698261</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="NovoFine®">
  <data key="d8">2.0</data>
  <data key="d9">Levemir® FlexPen® is designed to be used with NovoFine® disposable needles for safe and effective insulin injection.&lt;SEP&gt;Levemir® FlexPen® is designed to be used with NovoFine® disposable needles, ensuring proper and safe insulin injection.</data>
  <data key="d10">device compatibility,needle requirement,needle use</data>
  <data key="d11">chunk-1724d2e466fc891cc272dc5ef36ed31a&lt;SEP&gt;chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698300</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="8 °C">
  <data key="d8">1.0</data>
  <data key="d9">Unopened Levemir® FlexPen® must be stored refrigerated at temperatures not exceeding 8 °C and must not be frozen.</data>
  <data key="d10">refrigeration,storage condition</data>
  <data key="d11">chunk-1724d2e466fc891cc272dc5ef36ed31a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698301</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="30 °C">
  <data key="d8">1.0</data>
  <data key="d9">During use or as backup, Levemir® FlexPen® can be stored at room temperature below 30 °C for up to 42 days.</data>
  <data key="d10">ambient temperature,storage condition</data>
  <data key="d11">chunk-1724d2e466fc891cc272dc5ef36ed31a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698302</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="42 Days">
  <data key="d8">1.0</data>
  <data key="d9">Levemir® FlexPen® must be discarded 42 days after first use, even if insulin remains in the cartridge.</data>
  <data key="d10">expiration,usage duration</data>
  <data key="d11">chunk-1724d2e466fc891cc272dc5ef36ed31a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698302</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="30 Months">
  <data key="d8">1.0</data>
  <data key="d9">The unopened Levemir® FlexPen® has a shelf life of 30 months from the date of manufacture, as indicated on the packaging.</data>
  <data key="d10">expiration date,shelf life</data>
  <data key="d11">chunk-1724d2e466fc891cc272dc5ef36ed31a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698304</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Thermal Protection Packaging">
  <data key="d8">1.0</data>
  <data key="d9">Thermal protection packaging is required during transport to prevent exposure to extreme temperatures, direct light, and vibration.</data>
  <data key="d10">temperature control,transport requirement</data>
  <data key="d11">chunk-1724d2e466fc891cc272dc5ef36ed31a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698305</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Novo Nordisk A/S">
  <data key="d8">1.0</data>
  <data key="d9">Novo Nordisk A/S, based in Bagsvaerd, Denmark, manufactures and owns the Levemir® FlexPen® product.</data>
  <data key="d10">manufacturing,product ownership</data>
  <data key="d11">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
