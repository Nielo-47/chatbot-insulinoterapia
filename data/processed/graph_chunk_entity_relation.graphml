  <data key="d6"></data>
</node>
<node id="Insulin Needs Variation">
  <data key="d0">Insulin Needs Variation</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Needs Variation describes how insulin dosage requirements change across pregnancy trimesters and after delivery.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
