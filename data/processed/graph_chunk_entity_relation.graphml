  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329471</data>
  <data key="d6"></data>
</node>
<node id="Select Device Screen">
  <data key="d0">Select Device Screen</data>
  <data key="d1">content</data>
  <data key="d2">Select Device Screen lists available CGM devices for the user to choose during pairing.&lt;SEP&gt;Select Device screen lists available CGM devices for pairing with the pump.</data>
  <data key="d3">chunk-ab510c8377992bab31045a97eb95893a&lt;SEP&gt;chunk-c030749e7f9a2ae77cb8993d7250cffe</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
