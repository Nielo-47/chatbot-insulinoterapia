  <data key="d1">concept</data>
  <data key="d2">New Reservoir Only option is a setting that changes only the insulin reservoir.</data>
  <data key="d3">chunk-a0267d2986a48c4c31790b6f183277dc</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329593</data>
  <data key="d6"></data>
</node>
<node id="New Set Only Option">
  <data key="d0">New Set Only Option</data>
  <data key="d1">concept</data>
  <data key="d2">New Set Only option is a setting that changes only the infusion set.</data>
  <data key="d3">chunk-a0267d2986a48c4c31790b6f183277dc</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
