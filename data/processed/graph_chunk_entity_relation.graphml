<node id="Toxicidade Aguda">
  <data key="d0">Toxicidade Aguda</data>
  <data key="d1">concept</data>
  <data key="d2">Toxicidade Aguda refers to the adverse effects observed after a single high dose of insulin glargina administered intravenously or subcutaneously.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
