  <data key="d0">Coletor de Resíduos Perfurocortantes</data>
  <data key="d1">artifact</data>
  <data key="d2">Coletor de Resíduos Perfurocortantes is a rigid, unbreakable container with a wide mouth and lid, used for collecting perfurocortante, biological and chemical waste.</data>
  <data key="d3">chunk-a48e1013c4a32aca64a00d073b2ee797</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1786322449</data>
  <data key="d6"></data>
</node>
<node id="Resíduos Perfurocortantes">
  <data key="d0">Resíduos Perfurocortantes</data>
  <data key="d1">concept</data>
  <data key="d2">Resíduos Perfurocortantes are sharps waste such as syringes, needles, lancets, disposable pens and insulin pump materials generated from diabetes treatment.</data>
  <data key="d3">chunk-a48e1013c4a32aca64a00d073b2ee797</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1786322449</data>
  <data key="d6"></data>
</node>
<node id="Materiais da Bomba de Insulina">
  <data key="d0">Materiais da Bomba de Insulina</data>
  <data key="d1">artifact</data>
  <data key="d2">Materiais da Bomba de Insulina are components of insulin pumps that generate waste requiring proper disposal.</data>
  <data key="d3">chunk-a48e1013c4a32aca64a00d073b2ee797</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1786322450</data>
  <data key="d6"></data>
</node>
<node id="Hepatite">
  <data key="d0">Hepatite</data>
  <data key="d1">concept</data>
  <data key="d2">Hepatite is a disease that can be transmitted through improperly discarded sharps waste.</data>
