<edge source="Cetoacidose Diabética" target="BASAGLAR KWIKPEN">
  <data key="d7">1.0</data>
  <data key="d8">BASAGLAR KWIKPEN is not the insulin of choice for treating diabetic ketoacidosis.</data>
  <data key="d9">contraindication,therapy</data>
