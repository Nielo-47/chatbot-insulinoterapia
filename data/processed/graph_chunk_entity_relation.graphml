  <data key="d0">Night Period</data>
  <data key="d1">concept</data>
  <data key="d2">Night period refers to the overnight timeframe during which AMGD provides limited glucose monitoring.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338538</data>
  <data key="d6"></data>
</node>
