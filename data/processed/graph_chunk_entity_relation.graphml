  <data key="d0">Epidemiology of Diabetes Interventions and Complications</data>
  <data key="d1">event</data>
  <data key="d2">The EDIC study is the observational follow‑up of DCCT participants assessing long‑term outcomes.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1786331419</data>
  <data key="d6"></data>
</node>
