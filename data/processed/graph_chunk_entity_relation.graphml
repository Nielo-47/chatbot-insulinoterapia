  <data key="d13">1778708068</data>
  <data key="d14"></data>
</edge>
<edge source="Suspend Before Low" target="Manual Mode With CGM">
  <data key="d8">1.0</data>
  <data key="d9">In Manual mode with CGM, the Suspend Before Low feature predicts low glucose and suspends insulin delivery accordingly.</data>
  <data key="d10">glucose monitoring,predictive suspension</data>
  <data key="d11">chunk-9cb557f99f1234ecc2b21be31e823064</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707496</data>
  <data key="d14"></data>
</edge>
<edge source="Suspend Before Low" target="All">
  <data key="d8">1.0</data>
  <data key="d9">The "Suspend Before Low" alert stops insulin delivery when glucose levels are approaching the low limit, prompting the user to check blood glucose and take appropriate action.&gt;</data>
  <data key="d10">glucose monitoring,insulin delivery control</data>
  <data key="d11">chunk-fb01d55e6a22a76ca93e60f11c9b4cf6</data>
