  <data key="d6"></data>
</node>
<node id="Cancelar Basal Temporal">
  <data key="d0">Cancelar Basal Temporal</data>
  <data key="d1">artifact</data>
  <data key="d2">A menu option that allows the user to stop an active Índice Basal Temporal before its scheduled end.&lt;SEP&gt;Cancelar Basal Temporal is the menu option that stops an active temporal basal index before its scheduled end.&lt;SEP&gt;The procedure to stop a temporary basal index before its scheduled end.</data>
  <data key="d3">chunk-1312783ffe5039c618a48f7f29ec51ed&lt;SEP&gt;chunk-c1a77062463b62317e84265a3b2b6d4a&lt;SEP&gt;chunk-adb365cf52e00c7b4647e65dc0411d56</data>
