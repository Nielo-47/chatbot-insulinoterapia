  <data key="d0">Temperature Range 2° to 8°C</data>
  <data key="d1">data</data>
  <data key="d2">Temperature Range 2° to 8°C defines the recommended refrigerated temperature for SoloStar prior to first use.</data>
  <data key="d3">chunk-ffe095bda1b787c5b5ae2d61a2f74c98</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
