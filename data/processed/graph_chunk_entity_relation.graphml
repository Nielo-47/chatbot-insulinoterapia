</node>
<node id="Gerenciamento Eletrônico do Diabetes">
  <data key="d0">Gerenciamento Eletrônico do Diabetes</data>
  <data key="d1">method</data>
  <data key="d2">Gerenciamento Eletrônico do Diabetes refers to the electronic management approach for diabetes treatment, aiming to improve control and quality of life.</data>
  <data key="d3">chunk-97acd5016384ec4abfe4d43c6a9cad08</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/monitoramento contínuo de glicose.pdf</data>
