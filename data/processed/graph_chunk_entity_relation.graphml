  <data key="d12">1786377596</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Incidence and Prevalence of Type 1 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">The incidence and prevalence of Type 1 Diabetes are reported to be rising.</data>
