  <data key="d0">Guanethidine</data>
  <data key="d1">artifact</data>
  <data key="d2">Guanethidine is a sympatholytic drug that may reduce or mask hypoglycemia symptoms.</data>
  <data key="d3">chunk-3db0edd23b6b502ccbbf62bfd601ce68</data>
