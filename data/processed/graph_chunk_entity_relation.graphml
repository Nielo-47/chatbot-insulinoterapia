  <data key="d14"></data>
</edge>
<edge source="Health Care Provider" target="Treatment Plan">
  <data key="d8">1.0</data>
  <data key="d9">The health care provider may modify the treatment plan to prevent low blood glucose levels.</data>
  <data key="d10">diabetes management,treatment adjustment</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710336</data>
  <data key="d14"></data>
</edge>
<edge source="Health Care Provider" target="Hypoglycemia Unawareness">
  <data key="d8">1.0</data>
  <data key="d9">Individuals with hypoglycemia unawareness should consult their health care provider, who may adjust their treatment plan or glucose targets.</data>
  <data key="d10">medical consultation,treatment adjustment</data>
  <data key="d11">chunk-99d00bf995ac4c109277e3272b1236de</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710355</data>
  <data key="d14"></data>
</edge>
<edge source="Hypoglycemic Unawareness" target="Diabetes Care Team">
  <data key="d8">1.0</data>
  <data key="d9">The diabetes care team helps develop a plan to manage hypoglycemic unawareness and regain early warning symptoms.</data>
  <data key="d10">medical guidance,symptom recovery</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710335</data>
  <data key="d14"></data>
</edge>
<edge source="Hypoglycemic Unawareness" target="Early Warning Symptoms">
  <data key="d8">1.0</data>
  <data key="d9">Avoiding low blood glucose for several weeks can help restore early warning symptoms in individuals with hypoglycemic unawareness.</data>
  <data key="d10">glucose awareness,symptom recovery</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710337</data>
  <data key="d14"></data>
</edge>
<edge source="Early Warning Symptoms" target="Low Blood Glucose">
  <data key="d8">1.0</data>
  <data key="d9">Early warning symptoms alert individuals to the onset of low blood glucose levels.</data>
  <data key="d10">physiological response,symptom recognition</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710337</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetes Care Team" target="Young Children">
  <data key="d8">1.0</data>
  <data key="d9">The diabetes care team helps determine the appropriate amount of carbohydrates to treat lows in children.</data>
  <data key="d10">individualized care,treatment planning</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710346</data>
  <data key="d14"></data>
</edge>
<edge source="Low Blood Glucose" target="Protein And Carbohydrate Snack">
  <data key="d8">1.0</data>
  <data key="d9">After treating a low, a protein and carbohydrate snack helps prevent blood glucose from dropping again.</data>
  <data key="d10">glucose stabilization,prevention of recurrence</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710338</data>
  <data key="d14"></data>
</edge>
<edge source="Low Blood Glucose" target="Continuous Glucose Monitor">
  <data key="d8">1.0</data>
  <data key="d9">A continuous glucose monitor helps determine if blood glucose is trending up after treatment.</data>
  <data key="d10">glucose tracking,treatment monitoring</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710339</data>
  <data key="d14"></data>
</edge>
<edge source="Low Blood Glucose" target="Young Children">
  <data key="d8">1.0</data>
  <data key="d9">Young children typically need less than 15 grams of carbohydrates to treat low blood glucose.</data>
  <data key="d10">pediatric care,treatment adjustment</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710344</data>
  <data key="d14"></data>
</edge>
<edge source="Low Blood Glucose" target="Infants">
  <data key="d8">1.0</data>
  <data key="d9">Infants may require about 8 grams of carbohydrates to treat low blood glucose.</data>
  <data key="d10">pediatric care,treatment adjustment</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d13">1778710345</data>
  <data key="d14"></data>
</edge>
<edge source="Low Blood Glucose" target="Small Children">
  <data key="d8">1.0</data>
  <data key="d9">Small children may require about 10 grams of carbohydrates to treat low blood glucose.</data>
  <data key="d10">pediatric care,treatment adjustment</data>
  <data key="d11">chunk-8d4d239ddcb372531967a654526e4970</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
