</edge>
<edge source="Insulin Injection Procedure" target="Needle Dwell Time">
  <data key="d8">1.0</data>
  <data key="d9">The insulin injection procedure includes maintaining the needle in the subcutaneous tissue for several seconds to ensure complete insulin delivery.</data>
  <data key="d10">procedural step,safety measure</data>
  <data key="d11">chunk-5bbc7b2df438b8290a4da57f63f1ff5d</data>
