<node id="Frasco‑Ampola">
  <data key="d0">Frasco‑Ampola</data>
  <data key="d1">artifact</data>
  <data key="d2">Frasco‑ampola is a 10 mL vial container in which Lantus is supplied.</data>
  <data key="d3">chunk-572e715aada476f4dac69a032e16cc09</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
