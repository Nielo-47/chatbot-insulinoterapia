<edge source="4 mm Needle" target="Pregnant Person">
  <data key="d7">1.0</data>
  <data key="d8">Pregnant individuals may use a 4 mm Needle for insulin injection during the first two trimesters.</data>
  <data key="d9">recommendation,trimester</data>
