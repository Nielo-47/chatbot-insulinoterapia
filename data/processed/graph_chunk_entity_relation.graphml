  <data key="d0">New Reservoir Only</data>
  <data key="d1">method</data>
  <data key="d2">New Reservoir Only is the procedure for replacing only the insulin reservoir while keeping the existing infusion set.</data>
  <data key="d3">chunk-1c5a5c97986d9b31b155b0c8f0cac1c5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
