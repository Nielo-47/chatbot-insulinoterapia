</edge>
<edge source="Basal Pattern" target="Festivo">
  <data key="d8">1.0</data>
  <data key="d9">Festivo is a named instance of a basal pattern, likely intended for use on holidays or special days.</data>
  <data key="d10">classification,instance</data>
  <data key="d11">chunk-7534f3bc09ac6e2eece38e12eb89cf1f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
