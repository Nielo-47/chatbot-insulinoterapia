<node id="Drugstore">
  <data key="d0">Drugstore</data>
  <data key="d1">organization</data>
  <data key="d2">Drugstores are retail outlets that accept discarded needles and cartridges for proper disposal.&lt;SEP&gt;Drugstores are locations where collection bins for used syringes are available.&lt;SEP&gt;Drugstore is a retail outlet that may host collection points for needle disposal.</data>
  <data key="d3">chunk-9725072a361e9b1b97c5daa35e061e58&lt;SEP&gt;chunk-df616353e032c899b02bfa4368bc2667&lt;SEP&gt;chunk-2cd48799a027437b9fe2e1a48b61cb3d</data>
