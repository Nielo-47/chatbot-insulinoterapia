  <data key="d13">1778709754</data>
  <data key="d14"></data>
</edge>
<edge source="Postprandial Blood Glucose" target="Glycemic Control">
  <data key="d8">1.0</data>
  <data key="d9">Postprandial blood glucose reflects acute glucose changes and is used to assess glycemic control.</data>
  <data key="d10">acute fluctuation,monitoring metric</data>
  <data key="d11">chunk-3a1c7be3f5278cc80c8bc958c35be31c</data>
