  <data key="d5">1786317652</data>
  <data key="d6"></data>
</node>
<node id="Sodium Hydroxide">
  <data key="d0">Sodium Hydroxide</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Sodium hydroxide is an excipient component of the Tresiba® formulation.&lt;SEP&gt;Sodium hydroxide (hidróxido de sódio) is an excipient present in APIDRA.&lt;SEP&gt;Sodium hydroxide is a pH‑adjusting excipient included in the formulation of Apidra SoloStar.&lt;SEP&gt;Sodium hydroxide is an excipient listed in the Fiasp® formulation.&lt;SEP&gt;Sodium hydroxide is an excipient used in the formulation of Levemir® FlexPen® injectable solution.</data>
  <data key="d3">chunk-e590341aac73dca916e560c2df9e60e0&lt;SEP&gt;chunk-162882e6afffb0db8ae5e9153e5f1e82&lt;SEP&gt;chunk-77dc1a2378f763ffabe8fa379881d1cc&lt;SEP&gt;chunk-c8c7e36686d077dcb6239405f60ea031&lt;SEP&gt;chunk-b65a4249ac93aec086cb333ed1507ea7</data>
