  <data key="d5">1786371991</data>
  <data key="d6"></data>
</node>
<node id="Hemólise">
  <data key="d0">Hemólise</data>
  <data key="d1">concept</data>
  <data key="d2">Hemólise (hemolysis) affects red blood cell survival and may impact HbA1c accuracy.</data>
  <data key="d3">chunk-d35e6caf612b4c4984ade9315ebc7431</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
