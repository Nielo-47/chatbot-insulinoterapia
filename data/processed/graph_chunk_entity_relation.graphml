  <data key="d14"></data>
</edge>
<edge source="Glucosa En Sangre" target="Horario De Autocontrol De La Glucosa">
  <data key="d8">1.0</data>
  <data key="d9">The Horario De Autocontrol De La Glucosa dictates when to measure Glucosa En Sangre to inform therapy decisions.</data>
