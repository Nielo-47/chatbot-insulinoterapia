  <data key="d0">Bagagem de Mão</data>
  <data key="d1">artifact</data>
  <data key="d2">Bagagem de Mão is a hand luggage container suggested for carrying insulin during travel.</data>
  <data key="d3">chunk-8ce149c8d2ae4fe9b4a454053c8e0a71</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte insulinas.pdf</data>
  <data key="d5">1786303291</data>
