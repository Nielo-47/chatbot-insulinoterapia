  <data key="d6"></data>
</node>
<node id="Save Function">
  <data key="d0">Save Function</data>
  <data key="d1">method</data>
  <data key="d2">The Save function is used to store programmed settings in the insulin pump; if not selected, changes are lost.</data>
  <data key="d3">chunk-f608f07eae4ddd5409aed9d4ecef75ad</data>
