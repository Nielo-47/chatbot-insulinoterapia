</edge>
<edge source="Acetaminophen" target="SG Value">
  <data key="d8">1.0</data>
  <data key="d9">Acetaminophen can falsely raise sensor glucose readings, affecting insulin delivery accuracy.</data>
  <data key="d10">false reading,interference</data>
