  <data key="d5">1786335933</data>
  <data key="d6"></data>
</node>
<node id="Insulin Pens">
  <data key="d0">Insulin Pens</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin pens are devices that combine a vial and syringe, offering push‑button injection and are often preferred for insulin‑requiring diabetes.</data>
  <data key="d3">chunk-05cc642337c2a615c9b40de9336aec18</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335934</data>
  <data key="d6"></data>
</node>
