  <data key="d6"></data>
</node>
<node id="Novolin®">
  <data key="d0">Novolin®</data>
  <data key="d1">artifact</data>
  <data key="d2">Novolin® is a registered trademark for a brand of insulin produced by Novo Nordisk A/S, used in the Novolin® R FlexPen® delivery system.</data>
  <data key="d3">chunk-b93b5769e8df2e4aa6c2c1dc9e65fd85</data>
