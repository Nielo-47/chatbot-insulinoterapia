  <data key="d13"></data>
</edge>
<edge source="Sociedade Brasileira de Diabetes" target="R14">
  <data key="d7">1.0</data>
  <data key="d8">The organization issues recommendation R14 to re‑evaluate individuals with a single laboratory criterion for diabetes after 6 months.</data>
  <data key="d9">recommendation,screening</data>
  <data key="d10">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372209</data>
  <data key="d13"></data>
</edge>
<edge source="Sociedade Brasileira de Diabetes" target="R15">
  <data key="d7">1.0</data>
  <data key="d8">The organization issues recommendation R15 to screen for diabetes in individuals with comorbidities such as endocrinopathies, pancreatic diseases, HIV infection, or hepatic steatosis.</data>
  <data key="d9">comorbidity screening,recommendation</data>
  <data key="d10">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372210</data>
  <data key="d13"></data>
</edge>
<edge source="Sociedade Brasileira de Diabetes" target="R16">
  <data key="d7">1.0</data>
  <data key="d8">The organization issues recommendation R16 to screen for diabetes before and after treatment with glucocorticoids or antipsychotics.</data>
  <data key="d9">medication screening,recommendation</data>
  <data key="d10">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372210</data>
  <data key="d13"></data>
</edge>
<edge source="Sociedade Brasileira de Diabetes" target="R17">
  <data key="d7">1.0</data>
  <data key="d8">The organization issues recommendation R17 to screen for type 2 diabetes in children and adolescents with overweight/obesity and at least one risk factor.</data>
  <data key="d9">pediatric screening,recommendation</data>
  <data key="d10">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372211</data>
  <data key="d13"></data>
</edge>
<edge source="Sociedade Brasileira de Diabetes" target="R18">
  <data key="d7">1.0</data>
  <data key="d8">The organization issues recommendation R18 to consider autoantibody testing in first-degree relatives of people with type 1 diabetes.</data>
  <data key="d9">autoantibody testing,recommendation</data>
  <data key="d10">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372212</data>
  <data key="d13"></data>
</edge>
