<node id="Battle Creek, Michigan">
  <data key="d0">Battle Creek, Michigan</data>
  <data key="d1">location</data>
  <data key="d2">Battle Creek, Michigan was the city where a newspaper promoted an upcoming insulin‑related presentation by Banting, Best, and Clarke Noble.</data>
  <data key="d3">chunk-9043f44e67d9ed02b4864043d3cbb59a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332086</data>
