  <data key="d13">1778699173</data>
  <data key="d14"></data>
</edge>
<edge source="Hyperglycemia" target="Ketoacidosis">
  <data key="d8">1.0</data>
  <data key="d9">Untreated hyperglycemia in type 1 diabetes can progress to diabetic ketoacidosis, a potentially fatal condition.</data>
  <data key="d10">complication,disease progression</data>
  <data key="d11">chunk-001d95b4722fb6304af5e929d80557ac</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699173</data>
  <data key="d14"></data>
</edge>
<edge source="Hyperglycemia" target="Localized Cutaneous Amyloidosis">
  <data key="d8">2.0</data>
  <data key="d9">Repeated insulin injections in areas with localized cutaneous amyloidosis may result in hyperglycemia.&lt;SEP&gt;Repeated insulin injections in areas with localized cutaneous amyloidosis may lead to hyperglycemia due to impaired insulin absorption.</data>
  <data key="d10">injection site effect,insulin absorption,treatment complication</data>
  <data key="d11">chunk-2df8f5e1333eed2f8c4d2dca734d5e21&lt;SEP&gt;chunk-f8938c7b2cdfb8e023d3ebcda62fd027</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699624</data>
  <data key="d14"></data>
</edge>
<edge source="Hyperglycemia" target="William">
  <data key="d8">1.0</data>
  <data key="d9">William experiences hyperglycemia 3 to 4 hours after eating pizza if not using a dual bolus.</data>
