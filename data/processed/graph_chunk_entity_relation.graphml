</node>
<node id="Study on Lipodystrophy Prevalence">
  <data key="d0">Study on Lipodystrophy Prevalence</data>
  <data key="d1">data</data>
  <data key="d2">Studies indicate that 28 % to 64 % of people with diabetes type 1 or type 2 may develop lipo‑hipertrofia.</data>
