  <data key="d14"></data>
</edge>
<edge source="Canetas Descartáveis" target="Agonistas do GLP-1">
  <data key="d8">1.0</data>
  <data key="d9">Canetas descartáveis são usadas para administrar agonistas do GLP-1 no tratamento do diabetes.</data>
  <data key="d10">administração medicamentosa,tratamento</data>
  <data key="d11">chunk-8792cad0fa7c0226f159b670b4e743a1</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
