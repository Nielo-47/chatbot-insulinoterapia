  <data key="d0">Seccion 1</data>
  <data key="d1">content</data>
  <data key="d2">Seccion 1 covers capillary glucose self-monitoring, emphasizing its importance even during sensor-augmented pump therapy.</data>
  <data key="d3">chunk-bc23f53afc0fcecdd9527e9dab84cb8b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
