  <data key="d13"></data>
</edge>
<edge source="Instinct Sensor" target="Blood Glucose Meter Reading">
  <data key="d7">1.0</data>
  <data key="d8">When paired with Instinct, BG meter readings are used as a BG check to verify system performance.</data>
  <data key="d9">data,verification</data>
  <data key="d10">chunk-36ace822cd4873b8fd2adcfef0a7f9fd</data>
