  <data key="d6"></data>
  <data key="d7">Nephropathy</data>
</node>
<node id="Neuropathy">
  <data key="d0">Neuropathy</data>
  <data key="d1">concept</data>
  <data key="d2">Neuropathy refers to nerve damage, particularly in hands and feet, caused by uncontrolled diabetes.</data>
  <data key="d3">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
