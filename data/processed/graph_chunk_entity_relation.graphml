  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Humalog Mix 25 Kwikpen">
  <data key="d7">1.0</data>
  <data key="d8">Humalog Mix 25 Kwikpen can cause hypoglycemia, especially while driving.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-4ce520f0fe7dc4a6c79f92a25dfaff19</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310815</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Beta‑Adrenergic Blockers">
  <data key="d7">2.0</data>
  <data key="d8">Beta‑adrenergic blockers may mask the symptoms of hypoglycemia in some patients.</data>
  <data key="d9">interaction,masking,symptom masking</data>
  <data key="d10">chunk-4ce520f0fe7dc4a6c79f92a25dfaff19&lt;SEP&gt;chunk-fd94288932ad6675a1de2b46b3fd9128</data>
