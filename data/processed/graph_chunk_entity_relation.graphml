  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Bolus Wizard">
  <data key="d8">1.0</data>
  <data key="d9">When using the Bolus Wizard in Manual mode, a Square Wave bolus is only available for food boluses without a correction component.</data>
  <data key="d10">bolus type limitation,usage restriction</data>
  <data key="d11">chunk-14b0e9023a7c03c6a284d69e0930b8a9</data>
