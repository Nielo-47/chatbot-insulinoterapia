  <data key="d0">DIY Loop System</data>
  <data key="d1">artifact</data>
  <data key="d2">DIY Loop System is an open‑source algorithm that allows users to input exogenous insulin doses.</data>
  <data key="d3">chunk-2767372b4b5395439f542016058306a4</data>
