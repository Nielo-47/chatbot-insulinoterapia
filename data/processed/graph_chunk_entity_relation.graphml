</edge>
<edge source="Pump" target="Select No">
  <data key="d7">1.0</data>
  <data key="d8">Pump initiates sensor replacement when the user selects No indicating incorrect BG reading.</data>
  <data key="d9">sensor replacement,validation</data>
  <data key="d10">chunk-87a1bd89a18cb218431ff9359e299ee6</data>
