</node>
<node id="Registro MS">
  <data key="d0">Registro MS</data>
  <data key="d1">data</data>
  <data key="d2">Registro MS is the Brazilian Ministry of Health registration number for pharmaceutical products, with the value 1.1766.0019 assigned to Levemir® FlexPen®.</data>
  <data key="d3">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
