  <data key="d5">1786315421</data>
  <data key="d6"></data>
</node>
<node id="Refillable Pen">
  <data key="d0">Refillable Pen</data>
  <data key="d1">artifact</data>
  <data key="d2">A refillable pen is a type of insulin pen that uses replaceable 3 mL insulin cartridges (refills) and must be paired with refills from the same manufacturer.&lt;SEP&gt;Refillable Pen is a reusable insulin pen that holds replaceable insulin cartridges.</data>
  <data key="d3">chunk-ebdb9452013f0e340884677832714553&lt;SEP&gt;chunk-1b1b73e9b7285819a4ba5caa6fdfa785</data>
