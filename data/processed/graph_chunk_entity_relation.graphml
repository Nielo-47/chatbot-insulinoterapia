  <data key="d12">1786300311</data>
  <data key="d13"></data>
</edge>
<edge source="Gestante" target="Agulha De 4 Mm">
  <data key="d7">1.0</data>
  <data key="d8">During the first two trimesters, a 4 mm needle is recommended for pregnant individuals injecting insulin.</data>
  <data key="d9">pregnancy,suitable needle length</data>
  <data key="d10">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1786300311</data>
  <data key="d13"></data>
</edge>
<edge source="Gestante" target="Insulina Glargina">
  <data key="d7">1.0</data>
  <data key="d8">Insulina Glargina may be administered during pregnancy when clinically necessary.</data>
  <data key="d9">pregnancy,usage</data>
  <data key="d10">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d12">1786310273</data>
  <data key="d13"></data>
</edge>
<edge source="Gestante" target="Farmacovigilância">
  <data key="d7">1.0</data>
  <data key="d8">Post‑marketing pharmacovigilance recorded over 1,000 pregnant exposures with no specific adverse effects of Insulina Glargina.</data>
  <data key="d9">monitoring,safety data</data>
  <data key="d10">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d12">1786310284</data>
  <data key="d13"></data>
</edge>
<edge source="Gestante" target="Humalog Mix 25 KwikPen">
  <data key="d7">2.0</data>
  <data key="d8">Large observational data in pregnant women did not reveal any adverse events for the fetus or newborn.&lt;SEP&gt;Humalog Mix 25 KwikPen is classified as pregnancy category B for use in pregnant women.</data>
  <data key="d9">adverse events,pregnancy category</data>
  <data key="d10">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310845</data>
  <data key="d13"></data>
</edge>
<edge source="Gestante" target="Insulina Needs">
  <data key="d7">1.0</data>
  <data key="d8">Insulin requirements typically decrease in the first trimester and increase during the second and third trimesters of pregnancy.</data>
  <data key="d9">trimester effect</data>
  <data key="d10">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310846</data>
  <data key="d13"></data>
</edge>
<edge source="Gestante" target="Diabetic Patients">
  <data key="d7">1.0</data>
  <data key="d8">Patients with diabetes should inform their médico if they are pregnant or plan to become pregnant.</data>
  <data key="d9">clinical advice</data>
  <data key="d10">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310847</data>
  <data key="d13"></data>
</edge>
<edge source="Gestante" target="Monitoramento da Glicose">
  <data key="d7">1.0</data>
  <data key="d8">Cautious glucose monitoring is essential for pregnant diabetic patients.</data>
  <data key="d9">clinical monitoring</data>
  <data key="d10">chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310848</data>
  <data key="d13"></data>
</edge>
<edge source="Agulha De 4 Mm" target="Caneta Recarregável">
  <data key="d7">1.0</data>
  <data key="d8">A 4 mm needle is the optimal length for insulin pens, improving comfort and safety.</data>
  <data key="d9">compatible needle,pen</data>
  <data key="d10">chunk-aafda750d4900a464b1ac0c9bad5ba05</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1786301871</data>
  <data key="d13"></data>
</edge>
<edge source="Agulha De 4 Mm" target="Estudo De Lo Presti Et Al.">
  <data key="d7">1.0</data>
  <data key="d8">The study supports the use of 4 mm needles for pediatric insulin injection.</data>
  <data key="d9">needle length,recommendation</data>
  <data key="d10">chunk-aafda750d4900a464b1ac0c9bad5ba05</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1786301872</data>
  <data key="d13"></data>
</edge>
<edge source="Agulha De 4 Mm" target="Estudo De Gibney Et Al.">
  <data key="d7">1.0</data>
  <data key="d8">Findings that adult skin layers are thin support using short 4 mm needles where appropriate.</data>
  <data key="d9">guideline,needle length</data>
  <data key="d10">chunk-aafda750d4900a464b1ac0c9bad5ba05</data>
