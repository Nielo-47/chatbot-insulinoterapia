  <data key="d13">1778707688</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Bolus Delivery">
  <data key="d8">1.0</data>
  <data key="d9">The Square Wave Bolus delivers insulin evenly over a specified period as part of bolus delivery for better post-meal glucose control.</data>
  <data key="d10">digestion alignment,extended delivery</data>
  <data key="d11">chunk-a76c99cd46001ae6a2373d3413db020f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707912</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="EA Note">
  <data key="d8">1.0</data>
  <data key="d9">EA Note specifies that the Square Wave bolus can only be selected if the corresponding feature is turned on.</data>
  <data key="d10">conditional access,feature requirement</data>
  <data key="d11">chunk-242a9653f8dc2ed51da6a6ddd865d93f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708059</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Manual Mode">
  <data key="d8">1.0</data>
  <data key="d9">Square Wave bolus is only available when the MiniMed 780G insulin pump is in Manual mode.</data>
  <data key="d10">bolus availability,delivery method</data>
  <data key="d11">chunk-bc1664dd2b2f62661bb5b9e88843be38</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708109</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Delayed Food Digestion">
  <data key="d8">1.0</data>
  <data key="d9">A Square Wave bolus is used when food digestion is delayed due to conditions like gastroparesis or high-fat meals.</data>
  <data key="d10">digestive condition,medical use case</data>
  <data key="d11">chunk-0d89ab5e0b88b0b0ff15b22db8ae4450</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708120</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Insulin Delivery">
  <data key="d8">1.0</data>
  <data key="d9">The Square Wave bolus is a form of insulin delivery that releases insulin gradually over time.&gt;</data>
  <data key="d10">delivery method,extended release</data>
  <data key="d11">chunk-654d7a203c4eab9f3a89f577edc2a5ad</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708334</data>
  <data key="d14"></data>
</edge>
<edge source="Square Wave Bolus" target="Bolus Wizard Feature">
  <data key="d8">1.0</data>
  <data key="d9">The Bolus Wizard feature can deliver a Square Wave bolus only if the feature is enabled and a carb value is entered, but not if a correction bolus is required.&gt;</data>
  <data key="d10">conditional delivery,dosage calculation</data>
