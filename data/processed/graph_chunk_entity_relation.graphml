  <data key="d5">1786324183</data>
  <data key="d6"></data>
</node>
<node id="Tendencia Descendente">
  <data key="d0">Tendencia Descendente</data>
  <data key="d1">concept</data>
  <data key="d2">Tendencia Descendente describes a falling glucose trend monitored during early therapy.</data>
  <data key="d3">chunk-505b4450257d1a728c397959b044ee97</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324183</data>
  <data key="d6"></data>
</node>
<node id="Hoja De Documentación">
  <data key="d0">Hoja De Documentación</data>
  <data key="d1">artifact</data>
  <data key="d2">Hoja De Documentación is a sheet used to record glucose trends and therapy adjustments for discussion with the medical team.</data>
  <data key="d3">chunk-505b4450257d1a728c397959b044ee97</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324183</data>
  <data key="d6"></data>
</node>
<node id="Alertas Alta">
  <data key="d0">Alertas Alta</data>
  <data key="d1">concept</data>
  <data key="d2">Alertas Alta are high‑glucose alerts generated by the system during the night.</data>
