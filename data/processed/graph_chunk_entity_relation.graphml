  <data key="d13">1778707543</data>
  <data key="d14"></data>
</edge>
<edge source="CareLink Software" target="Paired Devices">
  <data key="d8">1.0</data>
  <data key="d9">Paired Devices such as CGMs or meters sync data with CareLink Software via the insulin pump.</data>
  <data key="d10">data synchronization,device connectivity</data>
