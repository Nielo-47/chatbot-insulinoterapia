  <data key="d7">1.0</data>
  <data key="d8">A high‑glucose (GS alta) message alerts the user to take steps that prevent diabetic ketoacidosis.</data>
  <data key="d9">prevention,risk</data>
  <data key="d10">chunk-01785f6f03692dc5e35c672e21b345f7</data>
