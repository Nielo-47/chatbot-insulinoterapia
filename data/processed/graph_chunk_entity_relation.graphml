  <data key="d5">1786332086</data>
  <data key="d6"></data>
</node>
<node id="James Collip">
  <data key="d0">James Collip</data>
  <data key="d1">person</data>
  <data key="d2">James Collip was a chemist who contributed to insulin purification and signed the 1922 research agreement.&lt;SEP&gt;James Collip was a chemist who identified the optimal alcohol concentration to isolate insulin and prepared Collip’s extract used for treatment.&lt;SEP&gt;James Collip was named in the U.S. patent application for the method of preparation of insulin extracts.&lt;SEP&gt;James Collip is a scientist associated with insulin development whose insulin product revived an eight‑year‑old girl in Edmonton.&lt;SEP&gt;James Collip is the scientist who purified insulin for human therapeutic use.</data>
  <data key="d3">chunk-9043f44e67d9ed02b4864043d3cbb59a&lt;SEP&gt;chunk-ad5d126f417014eb5c7a07a85db48d1d&lt;SEP&gt;chunk-47acdaf58d4f121a3948976c07c3d03c&lt;SEP&gt;chunk-c53f6d8d7aad59b28e557f5971d0d828&lt;SEP&gt;chunk-2d8f17f3f250a37a1effaaa88cc8b382</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338526</data>
  <data key="d6"></data>
</node>
