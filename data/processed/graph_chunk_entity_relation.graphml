  <data key="d0">Configuração Da Bomba De Infusão</data>
  <data key="d1">method</data>
  <data key="d2">The procedure to identify dosing coefficients (DTD, FS, RIC) and set glucose targets before using the pump.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330161</data>
  <data key="d6"></data>
</node>
<node id="Infusão De Pulsos">
  <data key="d0">Infusão De Pulsos</data>
  <data key="d1">method</data>
  <data key="d2">Pulse infusion method delivering correction or meal bolus insulin to maintain post‑meal glucose stability.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330161</data>
  <data key="d6"></data>
</node>
<node id="Altura">
  <data key="d0">Altura</data>
  <data key="d1">data</data>
  <data key="d2">Patient’s height, influencing insulin dosing decisions.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330161</data>
  <data key="d6"></data>
</node>
<node id="Fase Puberal">
  <data key="d0">Fase Puberal</data>
  <data key="d1">data</data>
  <data key="d2">Pubertal stage of the patient, affecting insulin requirements.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330161</data>
  <data key="d6"></data>
</node>
<node id="Tempo De Diabetes">
  <data key="d0">Tempo De Diabetes</data>
  <data key="d1">data</data>
  <data key="d2">Duration of diabetes since diagnosis, considered in dosing calculations.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330161</data>
  <data key="d6"></data>
</node>
<node id="Monitorização Glicêmica">
  <data key="d0">Monitorização Glicêmica</data>
  <data key="d1">method</data>
  <data key="d2">Continuous glucose monitoring practice employed by patients for dose adjustment.</data>
  <data key="d3">chunk-60530d1861f7c2d1efecc069c0913d37</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
