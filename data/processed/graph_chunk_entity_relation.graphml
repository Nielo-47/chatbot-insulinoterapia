  <data key="d3">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d2">A hard plastic container is recommended for home use when a proper sharps container is not available.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1776645524</data>
  <data key="d6"></data>
</node>
<node id="Fasting Plasma Glucose">
  <data key="d0">Fasting Plasma Glucose</data>
  <data key="d1">data</data>
  <data key="d2">Fasting plasma glucose is a key measurement used to guide Levemir dose titration, with target levels between 4.4–6.1 mmol/L (80–110 mg/dL) for adults with type 2 diabetes.&lt;SEP&gt;Fasting plasma glucose is a key measurement used to guide the titration of Levemir dosage in adult patients with type 2 diabetes.</data>
  <data key="d3">chunk-fcc0edfe7c2736912a3aa78c50f72b99&lt;SEP&gt;chunk-fdd292edf157383567920d27a920c13f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778710148</data>
  <data key="d6"></data>
  <data key="d7">Fasting Plasma Glucose</data>
</node>
<node id="Hyperglycemia Management">
  <data key="d0">Hyperglycemia Management</data>
  <data key="d1">concept</data>
  <data key="d2">Hyperglycemia Management is the second step in SAP therapy, focusing on understanding and using system options to control high glucose levels.</data>
  <data key="d3">chunk-4704ed3f5177349243c84d500af612b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1778709897</data>
  <data key="d6"></data>
  <data key="d7">Hyperglycemia Management</data>
</node>
<node id="Type 2 Diabetes Mellitus">
  <data key="d0">Type 2 Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">Type 2 diabetes mellitus is the primary condition studied in the evaluation of insulin delivery devices, particularly in adult populations.&lt;SEP&gt;Type 2 diabetes mellitus is a metabolic disorder characterized by insulin resistance and relative insulin deficiency, often managed with oral agents and insulin.&lt;SEP&gt;Type 2 diabetes mellitus is a chronic metabolic disorder treated with Levemir, often in combination with oral antidiabetics or GLP-1 receptor agonists.</data>
  <data key="d3">chunk-4fee4c8681a7629eb6ff0eb2470a98e3&lt;SEP&gt;chunk-590fb2f5c50ef31a5fd415bb01def92d&lt;SEP&gt;chunk-fdd292edf157383567920d27a920c13f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778709887</data>
  <data key="d6"></data>
  <data key="d7">Type 2 Diabetes Mellitus</data>
</node>
<node id="Diabetes Diagnosis">
  <data key="d0">Diabetes Diagnosis</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Diagnosis refers to the clinical process of identifying diabetes mellitus using criteria such as blood glucose levels from tests like TTGO-1h, TTGO-2h, or fasting plasma glucose.&gt;</data>
  <data key="d3">chunk-fff9929a18d525e3805a8ed08356d41b&lt;SEP&gt;chunk-fcce093409f85a2fbec9a754f86c8e4e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1778709911</data>
