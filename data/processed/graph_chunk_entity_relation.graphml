<node id="Non-diabetic Individuals">
  <data key="d0">Non-diabetic Individuals</data>
  <data key="d1">concept</data>
  <data key="d2">Non-diabetic individuals are people without diabetes who are often used as control subjects in pharmacokinetic studies.</data>
  <data key="d3">chunk-bf25fca295be60e28b7c7d3103f722fc</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
