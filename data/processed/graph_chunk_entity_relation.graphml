<edge source="Instinct Sensor" target="Sensor Already In Use">
  <data key="d7">1.0</data>
  <data key="d8">The “Sensor already in use” message appears when the sensor is linked to a different user account.</data>
  <data key="d9">account,conflict</data>
  <data key="d10">chunk-95ba6f1fa7d1791230f690255a8ba2df</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329719</data>
  <data key="d13"></data>
</edge>
<edge source="Instinct Sensor" target="Sensor Expired">
  <data key="d7">1.0</data>
  <data key="d8">The “Sensor expired” alert tells the user to remove and replace the sensor.</data>
  <data key="d9">expiration,replacement</data>
  <data key="d10">chunk-95ba6f1fa7d1791230f690255a8ba2df</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329720</data>
  <data key="d13"></data>
</edge>
<edge source="Instinct Sensor" target="Unpair Device? Screen">
  <data key="d7">1.0</data>
  <data key="d8">Unpair Device? Screen asks for confirmation to unpair the Instinct Sensor from the Insulin Pump.</data>
  <data key="d9">confirmation,unpairing</data>
  <data key="d10">chunk-ab510c8377992bab31045a97eb95893a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329738</data>
  <data key="d13"></data>
</edge>
<edge source="Instinct Sensor" target="Health Care Professional">
  <data key="d7">1.0</data>
  <data key="d8">Health Care Professional advises users to discard the used Instinct Sensor according to proper disposal procedures.</data>
  <data key="d9">advice,disposal</data>
  <data key="d10">chunk-ab510c8377992bab31045a97eb95893a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
