</node>
<node id="Vasinho de Sangue">
  <data key="d0">Vasinho de Sangue</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Vasinho de Sangue is a small blood vessel that can be punctured by an Agulha, causing minor bleeding.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
