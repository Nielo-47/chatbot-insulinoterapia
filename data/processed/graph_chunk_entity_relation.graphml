  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="Duration">
  <data key="d8">1.0</data>
  <data key="d9">Duration sets the time over which the Square portion of a Dual Wave Bolus is delivered.</data>
  <data key="d10">delivery parameter,time setting</data>
