  <data key="d5">1786315483</data>
  <data key="d6"></data>
</node>
<node id="Epinefrina">
  <data key="d0">Epinefrina</data>
  <data key="d1">artifact</data>
  <data key="d2">Epinefrina is adrenaline, a sympathomimetic that may lower insulin glargina’s effect.&lt;SEP&gt;Epinefrina is a sympathomimetic drug listed as an example of sympathomimetic agents.&lt;SEP&gt;Epinefrina is a substance listed as reducing the hypoglycemic effect of APIDRA SOLOSTAR.&lt;SEP&gt;Epinefrina is mentioned as an example of a sympathomimetic agent.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6&lt;SEP&gt;chunk-465ad8b77c1c2a2a179062da20337ff5&lt;SEP&gt;chunk-b060d4f68031bd35dfafc19eadf1e9fe</data>
