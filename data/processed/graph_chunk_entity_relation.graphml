  <data key="d13">1778707547</data>
  <data key="d14"></data>
</edge>
<edge source="Restore Settings" target="Manage Settings">
  <data key="d8">1.0</data>
  <data key="d9">Restore Settings replaces current settings with previously saved ones, available only if settings were saved before.</data>
  <data key="d10">configuration recovery,system reset</data>
  <data key="d11">chunk-6cf249079ffd8aa0f06700895b8b7e9f</data>
