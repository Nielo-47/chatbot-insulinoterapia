  <data key="d1">content</data>
  <data key="d2">The bula is the official medication leaflet that provides dosage, safety, and usage instructions for Tresiba®.</data>
  <data key="d3">chunk-e590341aac73dca916e560c2df9e60e0</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/TRESIBA _ BulasMed.pdf</data>
