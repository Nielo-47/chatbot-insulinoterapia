  <data key="d13">1778707484</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Pattern" target="Very High Basal Setting">
  <data key="d8">1.0</data>
  <data key="d9">A basal pattern that delivers significantly more insulin than typical triggers the Very High Basal Setting message to prevent potential overdose.</data>
  <data key="d10">insulin overdose risk,safety warning</data>
  <data key="d11">chunk-92b103916c0aae66fd1ad9496d81e3dc</data>
