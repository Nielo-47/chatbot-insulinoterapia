  <data key="d0">Comorbidades Cardíacas</data>
  <data key="d1">concept</data>
  <data key="d2">Comorbidades Cardíacas are heart‑related complications that influence therapeutic decisions in diabetes patients.</data>
  <data key="d3">chunk-ed325288512881a80fa42dba504c4bff</data>
