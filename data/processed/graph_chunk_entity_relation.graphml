  <data key="d13">1778695451</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Levemir Penfill">
  <data key="d8">1.0</data>
  <data key="d9">The patient uses Levemir Penfill for insulin delivery and must follow proper handling and dosing instructions.</data>
  <data key="d10">medication use,self-administration</data>
  <data key="d11">chunk-fdd292edf157383567920d27a920c13f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698237</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="NovoFine">
  <data key="d8">1.0</data>
  <data key="d9">The patient is instructed to use NovoFine disposable needles and must discard them after each injection to prevent infection and injury.</data>
  <data key="d10">injection safety,needle use</data>
  <data key="d11">chunk-fdd292edf157383567920d27a920c13f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698238</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Novolin® R Penfill">
  <data key="d8">1.0</data>
  <data key="d9">Patients use Novolin® R Penfill under medical guidance and must follow safety instructions for needle disposal and device use.</data>
  <data key="d10">end user,treatment recipient</data>
  <data key="d11">chunk-ff021af578e58080f6a865c5f105e6d3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699093</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Cartridge">
  <data key="d8">1.0</data>
  <data key="d9">In emergency situations such as hospitalization or device malfunction, patients may have insulin aspirated from the cartridge using an insulin syringe.</data>
  <data key="d10">emergency use,insulin extraction</data>
  <data key="d11">chunk-ff021af578e58080f6a865c5f105e6d3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699094</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Dosage Adjustment">
  <data key="d8">1.0</data>
  <data key="d9">Patients may require dosage adjustments based on illness, physical activity, diet, or changes in insulin resistance.</data>
  <data key="d10">individualized therapy,treatment modification</data>
  <data key="d11">chunk-98a0b8b861ae9af417a572907fe16408</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699177</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Needle">
  <data key="d8">1.0</data>
  <data key="d9">Patients are instructed to discard the needle after each injection to ensure safety and prevent contamination.</data>
  <data key="d10">disposal,usage</data>
  <data key="d11">chunk-c2e44a4ca961f1a97305607fa263ed91</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699235</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Insulin Solution">
  <data key="d8">1.0</data>
  <data key="d9">In emergencies, patients or healthcare providers can withdraw insulin from the Novolin® R FlexPen® cartridge using an insulin syringe.</data>
  <data key="d10">emergency use,treatment</data>
  <data key="d11">chunk-c2e44a4ca961f1a97305607fa263ed91</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699237</data>
  <data key="d14"></data>
</edge>
<edge source="Patient" target="Insulin Infusion Pump">
  <data key="d8">1.0</data>
  <data key="d9">The patient wears the insulin infusion pump externally, typically on the waist or under clothing, for 24-hour therapy.</data>
  <data key="d10">external wear,medical device use</data>
