  <data key="d0">Local De Aplicação</data>
  <data key="d1">concept</data>
  <data key="d2">The injection site is the body area where subcutaneous insulin is administered and should be rotated between injections.</data>
  <data key="d3">chunk-fec70e5369024cec08c0820152befe39</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
