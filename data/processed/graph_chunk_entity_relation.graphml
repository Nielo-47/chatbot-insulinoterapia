  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316115</data>
  <data key="d6"></data>
</node>
<node id="Clogged Needle">
  <data key="d0">Clogged Needle</data>
  <data key="d1">concept</data>
  <data key="d2">Clogged Needle describes the condition where the needle’s opening is blocked, preventing insulin flow.</data>
