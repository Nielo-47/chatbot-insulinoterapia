</node>
<node id="Heparinas">
  <data key="d0">Heparinas</data>
  <data key="d3">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
  <data key="d2">Heparins must be stored separately from insulin to prevent administration errors due to similar packaging.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
