  <data key="d5">1786319698</data>
  <data key="d6"></data>
</node>
<node id="Água Para Injeção">
  <data key="d0">Água Para Injeção</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Água Para Injeção is sterile water used as the solvent in the Humulin®R solution.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319699</data>
  <data key="d6"></data>
</node>
<node id="Estudo Cruzado Duplo-Cego">
  <data key="d0">Estudo Cruzado Duplo-Cego</data>
  <data key="d1">method</data>
  <data key="d2">Estudo Cruzado Duplo-Cego is a double‑blind crossover clinical trial of six weeks comparing different insulin types.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319699</data>
  <data key="d6"></data>
</node>
<node id="Insulina Humana Biossintética (IHB)">
  <data key="d0">Insulina Humana Biossintética (IHB)</data>
  <data key="d1">concept</data>
  <data key="d2">Insulina Humana Biossintética (IHB) is synthetic human insulin used as the reference treatment in the study.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319699</data>
  <data key="d6"></data>
</node>
<node id="Anticorpos Anti‑Insulina">
  <data key="d0">Anticorpos Anti‑Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Anticorpos Anti‑Insulina are antibodies against insulin measured to evaluate immunological response.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319699</data>
  <data key="d6"></data>
</node>
<node id="Mistura De Insulina Bovina‑Suína (MBS)">
  <data key="d0">Mistura De Insulina Bovina‑Suína (MBS)</data>
  <data key="d1">concept</data>
  <data key="d2">Mistura De Insulina Bovina‑Suína (MBS) is a mixed formulation of bovine and porcine insulin used in some patients.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319700</data>
  <data key="d6"></data>
</node>
<node id="Insulina Suína Purificada (IS)">
  <data key="d0">Insulina Suína Purificada (IS)</data>
  <data key="d1">concept</data>
  <data key="d2">Insulina Suína Purificada (IS) is purified porcine insulin used in some patients.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319700</data>
  <data key="d6"></data>
</node>
<node id="Refil De Vidro Tipo I">
  <data key="d0">Refil De Vidro Tipo I</data>
  <data key="d1">artifact</data>
  <data key="d2">Refil De Vidro Tipo I are glass vials that contain 3 mL of Humulin®R solution, packaged in pairs.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319700</data>
  <data key="d6"></data>
</node>
<node id="Uso Adulto E Pediátrico Acima De 3 Anos">
  <data key="d0">Uso Adulto E Pediátrico Acima De 3 Anos</data>
  <data key="d1">concept</data>
  <data key="d2">Uso Adulto E Pediátrico Acima De 3 Anos indicates that Humulin®R is indicated for adult and pediatric patients older than three years.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319701</data>
  <data key="d6"></data>
</node>
<node id="Glicemia Média">
  <data key="d0">Glicemia Média</data>
  <data key="d1">concept</data>
  <data key="d2">Glicemia Média refers to the average blood glucose level measured during the clinical study.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319701</data>
  <data key="d6"></data>
</node>
<node id="Glicemia Em Jejum">
  <data key="d0">Glicemia Em Jejum</data>
  <data key="d1">concept</data>
  <data key="d2">Glicemia Em Jejum denotes fasting blood glucose levels assessed in the study.&lt;SEP&gt;Glicemia em jejum is the fasting blood glucose level measured after an overnight fast.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b&lt;SEP&gt;chunk-82e0d8e22a06c73855abed11561ce467</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d5">1786368419</data>
  <data key="d6"></data>
</node>
<node id="Episódios Hipoglicêmicos">
  <data key="d0">Episódios Hipoglicêmicos</data>
  <data key="d1">concept</data>
  <data key="d2">Episódios Hipoglicêmicos are hypoglycemic episodes monitored as safety outcomes in the trial.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319701</data>
  <data key="d6"></data>
</node>
<node id="Efeitos Imunológicos">
  <data key="d0">Efeitos Imunológicos</data>
  <data key="d1">concept</data>
  <data key="d2">Efeitos Imunológicos are the immunological effects evaluated when transferring patients from animal insulin to human insulin.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319702</data>
  <data key="d6"></data>
</node>
<node id="94 Pacientes">
  <data key="d0">94 Pacientes</data>
  <data key="d1">data</data>
  <data key="d2">94 Pacientes represents the total number of participants in the crossover double‑blind study.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319702</data>
  <data key="d6"></data>
</node>
<node id="6 Semanas">
  <data key="d0">6 Semanas</data>
  <data key="d1">data</data>
  <data key="d2">6 Semanas is the duration of the crossover clinical trial.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319702</data>
  <data key="d6"></data>
</node>
<node id="Mais De 300 Pacientes">
  <data key="d0">Mais De 300 Pacientes</data>
  <data key="d1">data</data>
  <data key="d2">Mais De 300 Pacientes indicates the larger cohort examined in the immunological transfer study.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319702</data>
  <data key="d6"></data>
</node>
<node id="52%">
  <data key="d0">52%</data>
  <data key="d1">data</data>
  <data key="d2">52% denotes the percentage reduction in antibody binding observed after transfer to human insulin in the mixed insulin group.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319703</data>
  <data key="d6"></data>
</node>
<node id="31%">
  <data key="d0">31%</data>
  <data key="d1">data</data>
  <data key="d2">31% denotes the percentage reduction in antibody binding observed after transfer to human insulin in the bovine insulin group.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319703</data>
  <data key="d6"></data>
</node>
<node id="Estudo De Transferência De Insulina">
  <data key="d0">Estudo De Transferência De Insulina</data>
  <data key="d1">event</data>
  <data key="d2">Estudo De Transferência De Insulina is an immunological study evaluating the effects of switching patients from animal insulin to human insulin.</data>
  <data key="d3">chunk-10dad476eb9d365159c539ced3aeec4b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319703</data>
  <data key="d6"></data>
</node>
<node id="Systemic Allergy">
  <data key="d0">Systemic Allergy</data>
  <data key="d1">concept</data>
  <data key="d2">Systemic allergy is a rare generalized allergic reaction to insulin that can cause rash, respiratory distress, hypotension, and possibly death.&lt;SEP&gt;Systemic allergy is a very rare generalized allergic reaction to insulin that may cause rash, respiratory distress, blood‑pressure drop, tachycardia, sweating, and can be life‑threatening.</data>
  <data key="d3">chunk-779af610d7298ce98490962cd90b4e76&lt;SEP&gt;chunk-8ac99e7359716e2cecc2ec93159218b6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319704</data>
  <data key="d6"></data>
</node>
<node id="Oral Glucose">
  <data key="d0">Oral Glucose</data>
  <data key="d1">artifact</data>
  <data key="d2">Oral glucose is a carbohydrate treatment used to manage mild hypoglycemia.</data>
  <data key="d3">chunk-779af610d7298ce98490962cd90b4e76</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319705</data>
  <data key="d6"></data>
</node>
<node id="Intravenous Concentrated Glucose">
  <data key="d0">Intravenous Concentrated Glucose</data>
  <data key="d1">artifact</data>
  <data key="d2">Intravenous concentrated glucose is a glucose solution given intravenously to treat severe hypoglycemia.</data>
  <data key="d3">chunk-779af610d7298ce98490962cd90b4e76</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319705</data>
  <data key="d6"></data>
</node>
<node id="Portal da ANVISA">
  <data key="d0">Portal da ANVISA</data>
  <data key="d1">content</data>
  <data key="d2">Portal da ANVISA is the official website of ANVISA where the Sistema VigiMed can be accessed.</data>
  <data key="d3">chunk-779af610d7298ce98490962cd90b4e76</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319706</data>
  <data key="d6"></data>
</node>
<node id="Dose of 12 IU Subcutaneous">
  <data key="d0">Dose of 12 IU Subcutaneous</data>
  <data key="d1">data</data>
  <data key="d2">A 12 international unit subcutaneous dose of Humulin R used to measure pharmacologic onset time.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319707</data>
  <data key="d6"></data>
</node>
<node id="Euglycemic Study">
  <data key="d0">Euglycemic Study</data>
  <data key="d1">event</data>
  <data key="d2">An euglycemic study measured insulin onset by detecting the first change in glucose infusion rate after dosing.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319708</data>
  <data key="d6"></data>
</node>
<node id="Localized Cutaneous Amyloid">
  <data key="d0">Localized Cutaneous Amyloid</data>
  <data key="d1">concept</data>
  <data key="d2">Localized cutaneous amyloid is a skin deposition occurring after repeated insulin injections, reported to cause hyperglycemia.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319708</data>
  <data key="d6"></data>
</node>
<node id="Animal-Derived Insulin">
  <data key="d0">Animal-Derived Insulin</data>
  <data key="d1">concept</data>
  <data key="d2">Animal‑derived insulin refers to insulin extracted from bovine or porcine sources.&lt;SEP&gt;Animal-derived insulin refers to insulin obtained from animal sources, mentioned as a type not studied in combination with Humulin R.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66&lt;SEP&gt;chunk-577779892c0d463cd6bb1966b8a8ce2d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319709</data>
  <data key="d6"></data>
</node>
<node id="Symptoms of Hypoglycemia">
  <data key="d0">Symptoms of Hypoglycemia</data>
  <data key="d1">content</data>
  <data key="d2">Symptoms of hypoglycemia include sweating, dizziness, tremor, hunger, confusion, seizures, and possible death.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319709</data>
  <data key="d6"></data>
</node>
<node id="Onset Time 6.6 Minutes">
  <data key="d0">Onset Time 6.6 Minutes</data>
  <data key="d1">data</data>
  <data key="d2">The average geometric mean onset time after a 12 IU subcutaneous Humulin R dose in healthy individuals is approximately 6.6 minutes.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319709</data>
  <data key="d6"></data>
</node>
<node id="Pancreatic Insulin">
  <data key="d0">Pancreatic Insulin</data>
  <data key="d1">concept</data>
  <data key="d2">Pancreatic insulin is the naturally produced insulin in humans that human insulin is structurally identical to.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319710</data>
  <data key="d6"></data>
</node>
<node id="Aspirin">
  <data key="d0">Aspirin</data>
  <data key="d1">artifact</data>
  <data key="d2">Aspirin® is a salicylate mentioned as a drug that can interact with insulin and lower blood glucose.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319710</data>
  <data key="d6"></data>
</node>
<node id="Sulfas">
  <data key="d0">Sulfas</data>
  <data key="d1">artifact</data>
  <data key="d2">Sulfas are sulfa drugs that can lower blood glucose and increase hypoglycemia risk.&lt;SEP&gt;Sulfas are a class of medications cited as interacting with insulin and potentially causing hypoglycemia.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66&lt;SEP&gt;chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319711</data>
  <data key="d6"></data>
</node>
<node id="Antidepressants">
  <data key="d0">Antidepressants</data>
  <data key="d1">artifact</data>
  <data key="d2">Antidepressants are listed among drugs that may interact with insulin and reduce blood glucose levels.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319711</data>
  <data key="d6"></data>
</node>
<node id="Excess Insulin Administration">
  <data key="d0">Excess Insulin Administration</data>
  <data key="d1">concept</data>
  <data key="d2">Excess insulin administration is identified as a primary cause of hypoglycemia.&lt;SEP&gt;Excess Insulin Administration refers to delivering more insulin than needed for meals or corrections, leading to hypoglycemia.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66&lt;SEP&gt;chunk-36de8c99d97d234e12244c240c45f156</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324156</data>
  <data key="d6"></data>
</node>
<node id="Missed Meals">
  <data key="d0">Missed Meals</data>
  <data key="d1">concept</data>
  <data key="d2">Missing or delayed meals are identified as a cause of hypoglycemia.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319711</data>
  <data key="d6"></data>
</node>
<node id="Excessive Exercise">
  <data key="d0">Excessive Exercise</data>
  <data key="d1">concept</data>
  <data key="d2">Exercise or work above normal intensity is listed as a trigger for hypoglycemia.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319712</data>
  <data key="d6"></data>
</node>
<node id="Infectious Disease">
  <data key="d0">Infectious Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Infectious diseases, especially with diarrhea or vomiting, are cited as causes of hypoglycemia.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319712</data>
  <data key="d6"></data>
</node>
<node id="Insulin Hypersensitivity">
  <data key="d0">Insulin Hypersensitivity</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin hypersensitivity refers to allergic reactions to human insulin or formulation components, contraindicating Humulin R.</data>
  <data key="d3">chunk-1e622f0079074cd1916470223d22aa66</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319712</data>
  <data key="d6"></data>
</node>
<node id="Glicose Intravenosa">
  <data key="d0">Glicose Intravenosa</data>
  <data key="d1">artifact</data>
  <data key="d2">Glicose Intravenosa is the intravenous administration of glucose used to treat severe hypoglycemia in medical settings.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319713</data>
  <data key="d6"></data>
</node>
<node id="Beta-bloqueadores">
  <data key="d0">Beta-bloqueadores</data>
  <data key="d1">artifact</data>
  <data key="d2">Beta-bloqueadores are a class of drugs that can diminish hypoglycemia symptoms, potentially masking warning signs.&lt;SEP&gt;Classe de medicamentos que podem mascarar ou modificar os sintomas de alerta de hipoglicemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319714</data>
  <data key="d6"></data>
</node>
<node id="Hipoglicemiantes Orais">
  <data key="d0">Hipoglicemiantes Orais</data>
  <data key="d1">artifact</data>
  <data key="d2">Hipoglicemiantes Orais are oral hypoglycemic agents that lower blood glucose and can contribute to hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319714</data>
  <data key="d6"></data>
</node>
<node id="Antidepressivos">
  <data key="d0">Antidepressivos</data>
  <data key="d1">artifact</data>
  <data key="d2">Antidepressivos are certain antidepressant medications that may decrease blood glucose.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319715</data>
  <data key="d6"></data>
</node>
<node id="Bebidas Alcoólicas">
  <data key="d0">Bebidas Alcoólicas</data>
  <data key="d1">artifact</data>
  <data key="d2">Bebidas Alcoólicas are alcoholic drinks; excessive consumption can precipitate hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319715</data>
  <data key="d6"></data>
</node>
<node id="Alimentos Contendo Açúcar">
  <data key="d0">Alimentos Contendo Açúcar</data>
  <data key="d1">artifact</data>
  <data key="d2">Alimentos Contendo Açúcar are foods or drinks with sugar used to rapidly raise blood glucose in mild hypoglycemia.&lt;SEP&gt;Alimentos que fornecem açúcar rapidamente para corrigir hipoglicemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319716</data>
  <data key="d6"></data>
</node>
<node id="Balas/Drops Açucarados">
  <data key="d0">Balas/Drops Açucarados</data>
  <data key="d1">artifact</data>
  <data key="d2">Balas/Drops Açucarados are sugary candies that provide a quick source of glucose for hypoglycemia treatment.&lt;SEP&gt;Doces de rápida absorção usados como fonte imediata de açúcar.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319716</data>
  <data key="d6"></data>
</node>
<node id="Tabletes de Glicose">
  <data key="d0">Tabletes de Glicose</data>
  <data key="d1">artifact</data>
  <data key="d2">Tabletes de Glicose are glucose tablets used as a rapid oral treatment for hypoglycemia.&lt;SEP&gt;Comprimidos de glicose para tratamento rápido da hipoglicemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319716</data>
  <data key="d6"></data>
</node>
<node id="Glândulas Suprarrenais">
  <data key="d0">Glândulas Suprarrenais</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Glândulas Suprarrenais are adrenal glands; diseases affecting them can alter insulin requirements.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319717</data>
  <data key="d6"></data>
</node>
<node id="Tireoide">
  <data key="d0">Tireoide</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Tireoide is the thyroid gland; disease can affect insulin demand.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319717</data>
  <data key="d6"></data>
</node>
<node id="Doença Renal">
  <data key="d0">Doença Renal</data>
  <data key="d1">concept</data>
  <data key="d2">Doença Renal is kidney disease that can significantly change insulin requirements.&lt;SEP&gt;Doença Renal is a medical condition that can cause inaccurate HbA1c results.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-a79d0e4d0f656bd87d2d0c4657378db4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336912</data>
  <data key="d6"></data>
</node>
<node id="Doença Hepática">
  <data key="d0">Doença Hepática</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Doença Hepática is liver disease that can significantly change insulin requirements.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319717</data>
  <data key="d6"></data>
</node>
<node id="Doenças Infecciosas">
  <data key="d0">Doenças Infecciosas</data>
  <data key="d1">concept</data>
  <data key="d2">Doenças Infecciosas are infectious illnesses, often with diarrhea or vomiting, that can trigger hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319717</data>
  <data key="d6"></data>
</node>
<node id="Exercício Excessivo">
  <data key="d0">Exercício Excessivo</data>
  <data key="d1">concept</data>
  <data key="d2">Exercício Excessivo refers to physical activity above normal levels that can cause hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319718</data>
  <data key="d6"></data>
</node>
<node id="Perda ou Atraso das Refeições">
  <data key="d0">Perda ou Atraso das Refeições</data>
  <data key="d1">concept</data>
  <data key="d2">Perda ou Atraso das Refeições denotes missed or delayed meals, a recognized cause of hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319718</data>
  <data key="d6"></data>
</node>
<node id="Administração de Excesso de Insulina">
  <data key="d0">Administração de Excesso de Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Administração de Excesso de Insulina is the overdose of insulin, leading to hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319718</data>
  <data key="d6"></data>
</node>
<node id="Sintomas de Hipoglicemia Leve a Moderada">
  <data key="d0">Sintomas de Hipoglicemia Leve a Moderada</data>
  <data key="d1">concept</data>
  <data key="d2">Sintomas de Hipoglicemia Leve a Moderada include sweating, dizziness, palpitations, tremor, hunger, anxiety, blurred vision, among others.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319718</data>
  <data key="d6"></data>
</node>
<node id="Sintomas de Hipoglicemia Grave">
  <data key="d0">Sintomas de Hipoglicemia Grave</data>
  <data key="d1">concept</data>
  <data key="d2">Sintomas de Hipoglicemia Grave include disorientation, unconsciousness, seizures, and death.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319718</data>
  <data key="d6"></data>
</node>
<node id="Sintomas de Cetoacidose Diabética">
  <data key="d0">Sintomas de Cetoacidose Diabética</data>
  <data key="d1">concept</data>
  <data key="d2">Sintomas de Cetoacidose Diabética include fatigue, flushed face, thirst, loss of appetite, fruity‑smelling breath, rapid breathing, and accelerated pulse.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319718</data>
  <data key="d6"></data>
</node>
<node id="Intensificação da Terapia com Insulina">
  <data key="d0">Intensificação da Terapia com Insulina</data>
  <data key="d1">method</data>
  <data key="d2">Intensificação da Terapia com Insulina is the process of increasing insulin treatment intensity, which can affect glucose control.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319719</data>
  <data key="d6"></data>
</node>
<node id="Ajuste da Dose de Insulina">
  <data key="d0">Ajuste da Dose de Insulina</data>
  <data key="d1">method</data>
  <data key="d2">Ajuste da Dose de Insulina is the modification of insulin dosage in response to changes in activity or diet.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319719</data>
  <data key="d6"></data>
</node>
<node id="Programa de Exercícios">
  <data key="d0">Programa de Exercícios</data>
  <data key="d1">method</data>
  <data key="d2">Programa de Exercícios is a structured physical activity plan aimed at preventing hypoglycemia.&lt;SEP&gt;Exercise program that may require insulin dose adjustments.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319719</data>
  <data key="d6"></data>
</node>
<node id="Plano de Alimentação">
  <data key="d0">Plano de Alimentação</data>
  <data key="d1">method</data>
  <data key="d2">Plano de Alimentação is a dietary plan designed to avoid hypoglycemia.&lt;SEP&gt;Meal plan that can be adjusted to prevent hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319719</data>
  <data key="d6"></data>
</node>
<node id="Alterações na Necessidade de Insulina">
  <data key="d0">Alterações na Necessidade de Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Alterações na Necessidade de Insulina refer to changes in the body’s insulin requirement that can precipitate hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Não Tomar Insulina">
  <data key="d0">Não Tomar Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Não Tomar Insulina denotes the failure to administer prescribed insulin, leading to hyperglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Comer Acima do Regime Alimentar">
  <data key="d0">Comer Acima do Regime Alimentar</data>
  <data key="d1">concept</data>
  <data key="d2">Comer Acima do Regime Alimentar describes excessive food intake beyond the established diet, a cause of hyperglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Febre ou Infecção ou Estresse">
  <data key="d0">Febre ou Infecção ou Estresse</data>
  <data key="d1">concept</data>
  <data key="d2">Febre ou Infecção ou Estresse refers to fever, infection, or stress conditions that can raise blood glucose levels.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Corpos Cetônicos">
  <data key="d0">Corpos Cetônicos</data>
  <data key="d1">concept</data>
  <data key="d2">Corpos Cetônicos are ketone bodies that appear in the blood and urine during diabetic ketoacidosis.&lt;SEP&gt;Substâncias químicas produzidas durante a cetogênese, presentes na cetoacidose.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Hiperventilação">
  <data key="d0">Hiperventilação</data>
  <data key="d1">concept</data>
  <data key="d2">Hiperventilação is rapid breathing that occurs as a symptom of diabetic ketoacidosis.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Pulso Acelerado">
  <data key="d0">Pulso Acelerado</data>
  <data key="d1">concept</data>
  <data key="d2">Pulso Acelerado is an accelerated heart rate indicating severe ketoacidosis.&lt;SEP&gt;Aumento da frequência cardíaca, sintoma grave da cetoacidose.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Náusea">
  <data key="d0">Náusea</data>
  <data key="d1">concept</data>
  <data key="d2">Náusea is a feeling of sickness that can accompany diabetic ketoacidosis.&lt;SEP&gt;Sensação de vontade de vomitar associada à cetoacidose não tratada.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319720</data>
  <data key="d6"></data>
</node>
<node id="Desidratação">
  <data key="d0">Desidratação</data>
  <data key="d1">concept</data>
  <data key="d2">Desidratação is dehydration that may result from prolonged ketoacidosis.&lt;SEP&gt;Perda excessiva de fluidos corporais decorrente da cetoacidose.&lt;SEP&gt;Desidratação is listed as a typical symptom of hyperglycemia in the guideline’s symptom table.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c&lt;SEP&gt;chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372035</data>
  <data key="d6"></data>
</node>
<node id="Perda de Consciência">
  <data key="d0">Perda de Consciência</data>
  <data key="d1">concept</data>
  <data key="d2">Perda de Consciência is loss of consciousness, a possible outcome of severe ketoacidosis.&lt;SEP&gt;Estado de inconsciência potencialmente causado por cetoacidose grave.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319721</data>
  <data key="d6"></data>
</node>
<node id="Distúrbios do Sono">
  <data key="d0">Distúrbios do Sono</data>
  <data key="d1">concept</data>
  <data key="d2">Distúrbios do Sono are sleep disorders that can appear among mild to moderate hypoglycemia symptoms.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319721</data>
  <data key="d6"></data>
</node>
<node id="Ansiedade">
  <data key="d0">Ansiedade</data>
  <data key="d1">concept</data>
  <data key="d2">Ansiedade is anxiety, listed as a symptom of mild to moderate hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319721</data>
  <data key="d6"></data>
</node>
<node id="Humor Deprimido">
  <data key="d0">Humor Deprimido</data>
  <data key="d1">concept</data>
  <data key="d2">Humor Deprimido is depressed mood, identified as a symptom of mild to moderate hypoglycemia.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319721</data>
  <data key="d6"></data>
</node>
<node id="Visão Embaçada">
  <data key="d0">Visão Embaçada</data>
  <data key="d1">concept</data>
  <data key="d2">Visão Embaçada is blurred vision, noted among mild to moderate hypoglycemia symptoms.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319721</data>
  <data key="d6"></data>
</node>
<node id="Tiazolidinediona">
  <data key="d0">Tiazolidinediona</data>
  <data key="d1">artifact</data>
  <data key="d2">Tiazolidinediona are a class of oral antidiabetic drugs mentioned in the text.</data>
  <data key="d3">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319721</data>
  <data key="d6"></data>
</node>
<node id="Thyroid Hormone Replacement">
  <data key="d0">Thyroid Hormone Replacement</data>
  <data key="d1">artifact</data>
  <data key="d2">Thyroid hormone replacement therapy may increase insulin requirements in patients using Humulin R.</data>
  <data key="d3">chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319722</data>
  <data key="d6"></data>
</node>
<node id="Alcoholic Beverages">
  <data key="d0">Alcoholic Beverages</data>
  <data key="d1">artifact</data>
  <data key="d2">Alcoholic beverages are drinks that can cause hypoglycemia in users of Humulin R.&lt;SEP&gt;Alcoholic beverages are drinks that can cause hypoglycemia in individuals using insulin such as Humulin R.</data>
  <data key="d3">chunk-0fa819f7e1e42eb688d4894dc3ca7e64&lt;SEP&gt;chunk-577779892c0d463cd6bb1966b8a8ce2d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319723</data>
  <data key="d6"></data>
</node>
<node id="Plant Medicinal">
  <data key="d0">Plant Medicinal</data>
  <data key="d1">artifact</data>
  <data key="d2">Plant medicinal products are herbal substances whose interaction with Humulin R has not been studied.</data>
  <data key="d3">chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319723</data>
  <data key="d6"></data>
</node>
<node id="Emotional Changes">
  <data key="d0">Emotional Changes</data>
  <data key="d1">concept</data>
  <data key="d2">Emotional changes may increase insulin requirements in patients using Humulin R.</data>
  <data key="d3">chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319724</data>
  <data key="d6"></data>
</node>
<node id="Activity/Diet Changes">
  <data key="d0">Activity/Diet Changes</data>
  <data key="d1">concept</data>
  <data key="d2">Changes in physical activity or diet may necessitate insulin dose adjustments for Humulin R.</data>
  <data key="d3">chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319724</data>
  <data key="d6"></data>
</node>
<node id="Adrenal Gland Diseases">
  <data key="d0">Adrenal Gland Diseases</data>
  <data key="d1">concept</data>
  <data key="d2">Adrenal gland diseases are disorders that may increase insulin needs for patients using Humulin R.</data>
  <data key="d3">chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319725</data>
  <data key="d6"></data>
</node>
<node id="Pituitary Gland Diseases">
  <data key="d0">Pituitary Gland Diseases</data>
  <data key="d1">concept</data>
  <data key="d2">Pituitary gland diseases are disorders that may increase insulin needs for patients using Humulin R.</data>
  <data key="d3">chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
