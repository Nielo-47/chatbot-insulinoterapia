  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Instinct Sensor">
  <data key="d8">1.0</data>
  <data key="d9">The Instinct sensor is a compatible CGM sensor that pairs with the MiniMed 780G system.</data>
