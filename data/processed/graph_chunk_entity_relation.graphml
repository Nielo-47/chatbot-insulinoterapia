  <data key="d5">1786372096</data>
  <data key="d6"></data>
</node>
<node id="Medication">
  <data key="d0">Medication</data>
  <data key="d1">concept</data>
  <data key="d2">Medication denotes pharmacological agents used in diabetes care, including those that may cause hypoglycemia.</data>
