  <data key="d14"></data>
</edge>
<edge source="Physical Activity" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">Increased physical activity can lower blood glucose and may require reduced insulin dosage.</data>
  <data key="d10">dosage adjustment,lifestyle factor</data>
  <data key="d11">chunk-0e1d7f92cdb7923807a9067d937837a4</data>
