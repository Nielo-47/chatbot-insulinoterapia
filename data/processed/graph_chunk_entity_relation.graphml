  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G Insulin Pump" target="Suspend">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G insulin pump allows users to suspend all insulin delivery, a function that operates the same in both SmartGuard and manual modes.</data>
  <data key="d10">delivery control,safety function</data>
