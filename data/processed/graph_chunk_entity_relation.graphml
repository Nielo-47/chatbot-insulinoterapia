  <data key="d0">Preset Temp Basal</data>
  <data key="d1">method</data>
  <data key="d2">A feature to set up and save temporary basal rates for repeated use.&lt;SEP&gt;A feature to set up and save temporary basal rates for repeated use on an insulin pump.</data>
  <data key="d3">chunk-a76c99cd46001ae6a2373d3413db020f&lt;SEP&gt;chunk-e90de561bcfc1f3544a690722c75e6f2</data>
