  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316142</data>
  <data key="d6"></data>
</node>
<node id="Composite Cardiovascular Endpoint">
  <data key="d0">Composite Cardiovascular Endpoint</data>
  <data key="d1">concept</data>
  <data key="d2">Composite Cardiovascular Endpoint is the co‑primary outcome of cardiovascular death, non‑fatal myocardial infarction, or non‑fatal stroke.</data>
  <data key="d3">chunk-b916f29e047f8579110cf5da3fd73847</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310022</data>
  <data key="d6"></data>
</node>
<node id="Procedimento de Revascularização">
  <data key="d0">Procedimento de Revascularização</data>
  <data key="d1">concept</data>
  <data key="d2">Procedimento de Revascularização includes cardiac, carotid, or peripheral revascularization procedures evaluated as a secondary outcome.</data>
  <data key="d3">chunk-b916f29e047f8579110cf5da3fd73847</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310022</data>
