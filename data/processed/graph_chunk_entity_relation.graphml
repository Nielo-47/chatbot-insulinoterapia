  <data key="d5">1786318541</data>
  <data key="d6"></data>
</node>
<node id="Muscle Cell">
  <data key="d0">Muscle Cell</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Muscle cell is a type of body cell where insulin binding promotes glucose uptake.</data>
  <data key="d3">chunk-2378c57a337d1ce7103c7086ebba76ac</data>
