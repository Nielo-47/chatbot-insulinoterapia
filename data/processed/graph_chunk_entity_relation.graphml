</node>
<node id="Alerta Alta">
  <data key="d0">Alerta Alta</data>
  <data key="d1">concept</data>
  <data key="d2">Alerta Alta is a high glucose alert in the MiniMed™ 640G system that requires confirmation with a capillary blood glucose test.</data>
  <data key="d3">chunk-cfc5f5eb70e79d2ce44b3ba795b76b3e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
