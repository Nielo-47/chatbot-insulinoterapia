</node>
<node id="Dose total de insulina bolus">
  <data key="d0">Dose total de insulina bolus</data>
  <data key="d1">data</data>
  <data key="d2">Dose total de insulina bolus is the measured total daily bolus insulin dose expressed in units per kilogram per day.</data>
  <data key="d3">chunk-9ff211ed5ca723fa2074871af58a4eb8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
