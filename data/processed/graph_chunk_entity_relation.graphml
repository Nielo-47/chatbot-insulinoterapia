  <data key="d1">artifact</data>
  <data key="d2">HUMALOG® MIX 25 KWIKPEN® is a branded insulin pen product complying with ISO 11608-1.</data>
  <data key="d3">chunk-b4916e2524690f1ce85df7c187f6d7a7</data>
