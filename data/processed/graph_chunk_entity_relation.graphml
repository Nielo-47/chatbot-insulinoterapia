  <data key="d1">artifact</data>
  <data key="d2">Aplicativos de celular are mobile applications used to log glucose data.</data>
  <data key="d3">chunk-a79d0e4d0f656bd87d2d0c4657378db4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336915</data>
  <data key="d6"></data>
</node>
