  <data key="d0">Muito Comprometido</data>
  <data key="d1">concept</data>
  <data key="d2">Muito Comprometido is a category in Tabela 2 indicating an elderly individual with severe functional or cognitive compromise.</data>
  <data key="d3">chunk-9dee0a79e4583f41e757f9a20f56f397</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1786370017</data>
  <data key="d6"></data>
</node>
