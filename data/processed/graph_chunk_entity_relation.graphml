  <data key="d6"></data>
</node>
<node id="Receptor Site">
  <data key="d0">Receptor Site</data>
  <data key="d1">concept</data>
  <data key="d2">The receptor site is a specific location on the cell wall where insulin binds to trigger glucose entry.</data>
  <data key="d3">chunk-6b867cec4c5eed3b10e431cbd4078dee</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
