  <data key="d14"></data>
</edge>
<edge source="Hyperglycemia" target="Novolin® R">
  <data key="d8">2.0</data>
  <data key="d9">Novolin® R is used to treat diabetes and prevent hyperglycemia, which can lead to diabetic ketoacidosis if insulin dosing is inadequate or discontinued.&lt;SEP&gt;Inadequate dosing or discontinuation of Novolin® R, especially in type 1 diabetes, can lead to hyperglycemia and potentially diabetic ketoacidosis.</data>
  <data key="d10">disease management,therapeutic effect,treatment effect,treatment indication</data>
  <data key="d11">chunk-001d95b4722fb6304af5e929d80557ac&lt;SEP&gt;chunk-43208e8857e43453277beecb7a6c55d5</data>
