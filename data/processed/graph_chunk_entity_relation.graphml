  <data key="d7">1.0</data>
  <data key="d8">VADT Investigators carried out the Veterans Affairs Diabetes Trial (VADT).</data>
  <data key="d9">research,trial</data>
  <data key="d10">chunk-6db2125b1b94840ea29100039a6fef20</data>
