  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694568</data>
  <data key="d14"></data>
</edge>
<edge source="Healthcare Professionals" target="Continuing Education">
  <data key="d8">1.0</data>
  <data key="d9">Continuing education for healthcare professionals is essential to maintain safe insulin practices and update knowledge on protocols.</data>
  <data key="d10">safety improvement,training</data>
  <data key="d11">chunk-dc6a188926df383900f31928c8726a8f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696037</data>
  <data key="d14"></data>
</edge>
<edge source="Healthcare Professionals" target="Double-Check Procedure">
  <data key="d8">1.0</data>
  <data key="d9">Healthcare professionals, especially nurses, must perform a double-check procedure when preparing and administering insulin to prevent errors.</data>
  <data key="d10">safety protocol,verification</data>
