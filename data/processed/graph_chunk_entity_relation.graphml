</edge>
<edge source="Bomba De Insulina" target="Índices Basales">
  <data key="d8">1.0</data>
  <data key="d9">Índices basales are programmed into the bomba de insulina to regulate background insulin delivery.</data>
  <data key="d10">delivery schedule,insulin programming</data>
  <data key="d11">chunk-01ce95c3ebe034549347b078008daa3c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
