</edge>
<edge source="Diabetes Treatment" target="Wearable Glucose Sensor">
  <data key="d8">1.0</data>
  <data key="d9">Wearable glucose sensors support diabetes treatment by enabling continuous, convenient, and less invasive glucose monitoring.</data>
  <data key="d10">monitoring innovation,treatment support</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694581</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetes Treatment" target="Blood Sugar Control">
  <data key="d8">1.0</data>
  <data key="d9">Effective blood sugar control is essential in diabetes treatment to prevent complications and maintain quality of life.</data>
  <data key="d10">health outcome,treatment objective</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694582</data>
  <data key="d14"></data>
</edge>
<edge source="Diabetes Treatment" target="Insulin Injection Procedure">
  <data key="d8">1.0</data>
  <data key="d9">The insulin injection procedure is a core component of diabetes treatment for patients requiring injectable therapy.</data>
  <data key="d10">disease management,therapeutic method</data>
  <data key="d11">chunk-180dc3d244f7d832cf505b09cfc34746</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696046</data>
  <data key="d14"></data>
</edge>
<edge source="Capillary Blood Glucose Monitoring" target="Glucose Meter">
  <data key="d8">2.0</data>
  <data key="d9">Capillary Blood Glucose Monitoring uses a glucose meter and test strip to measure blood sugar from a finger-prick sample.&lt;SEP&gt;Capillary Blood Glucose Monitoring is performed using a Glucose Meter to read blood glucose levels from a biosensor strip.</data>
  <data key="d10">blood analysis,device use,measurement method,measurement tool</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de&lt;SEP&gt;chunk-9af645f149415b242f6b7443aeb536d9</data>
  <data key="d12">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709750</data>
  <data key="d14"></data>
</edge>
<edge source="Capillary Blood Glucose Monitoring" target="AMGC">
  <data key="d8">1.0</data>
  <data key="d9">Capillary Blood Glucose Monitoring is also known as AMGC, which is the technical term for finger-prick glucose testing.</data>
  <data key="d10">synonym,technical term</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694577</data>
  <data key="d14"></data>
</edge>
<edge source="Capillary Blood Glucose Monitoring" target="CareLink™ Personal">
  <data key="d8">1.0</data>
  <data key="d9">CareLink™ Personal incorporates the frequency and results of capillary blood glucose monitoring into therapy reports.</data>
  <data key="d10">data integration,monitoring frequency</data>
  <data key="d11">chunk-3bf188253bd9d2142b4fcf627eacc2b8</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702782</data>
  <data key="d14"></data>
</edge>
<edge source="Capillary Blood Glucose Monitoring" target="Diabetes Mellitus">
  <data key="d8">1.0</data>
  <data key="d9">Capillary Blood Glucose Monitoring is a key method used by individuals with Diabetes Mellitus to manage their condition through regular glucose checks.</data>
  <data key="d10">disease management,self-monitoring</data>
  <data key="d11">chunk-9af645f149415b242f6b7443aeb536d9</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709753</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Diabetes">
  <data key="d8">1.0</data>
  <data key="d9">Long-term insulin use in diabetes may lead to lipodystrophy at injection sites.</data>
  <data key="d10">long-term effect, injection-related</data>
  <data key="d11">chunk-00bac63e27caeb094fe802c0bfe00a44</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698166</data>
  <data key="d14"></data>
  <data key="d15">Diabetes</data>
  <data key="d16">Lipodystrophy</data>
</edge>
<edge source="Lipodystrophy" target="Insulin Therapy">
  <data key="d8">1.0</data>
  <data key="d9">Lipodystrophy occurs at the site of repeated insulin injections.</data>
  <data key="d10">injection site complication, repeated use</data>
  <data key="d11">chunk-f8938c7b2cdfb8e023d3ebcda62fd027</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699671</data>
  <data key="d14"></data>
  <data key="d15">Insulin Therapy</data>
  <data key="d16">Lipodystrophy</data>
</edge>
<edge source="Lipodystrophy" target="Skin">
  <data key="d8">1.0</data>
  <data key="d9">Lipodystrophy, characterized by lumps or hardening, results from repeated insulin injections in the same skin area.</data>
  <data key="d10">injection complication,tissue damage</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694470</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Reuse of Syringes and Needles">
  <data key="d8">1.0</data>
  <data key="d9">Reusing syringes and needles increases the risk of developing lipodystrophy at injection sites.</data>
  <data key="d10">health risk,medical complication</data>
  <data key="d11">chunk-ee3024e95a663f89ec3c7a35028cc636</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695232</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Multicenter Study">
  <data key="d8">1.0</data>
  <data key="d9">A multicenter study in Spain found 64% of diabetic patients had lipodystrophy, assessed through physical examination and questionnaires.</data>
  <data key="d10">clinical assessment,prevalence</data>
  <data key="d11">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695249</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Skin Care">
  <data key="d8">1.0</data>
  <data key="d9">Areas with lipodystrophy, such as lumps or hardened skin, should be avoided when administering insulin.</data>
  <data key="d10">injection site avoidance,skin condition</data>
  <data key="d11">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d13">1778695459</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Injection Site">
  <data key="d8">1.0</data>
  <data key="d9">Insulin injections must avoid areas with lipodystrophy to ensure consistent absorption and prevent further tissue damage.</data>
  <data key="d10">complication avoidance,site selection</data>
  <data key="d11">chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696013</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Levemir">
  <data key="d8">4.0</data>
  <data key="d9">Failure to rotate injection sites while using Levemir increases the risk of developing lipodystrophy.&lt;SEP&gt;Repeated injections of Levemir in the same site can lead to lipodystrophy, which can be prevented by site rotation.&lt;SEP&gt;Lipodystrophy, including lipoatrophy and lipohipertrophy, may occur at the injection site of Levemir and impair insulin absorption.&lt;SEP&gt;Lipodystrophy is an uncommon adverse effect of repeated insulin injections, including Levemir, leading to localized fat loss or hypertrophy at injection sites.</data>
  <data key="d10">adverse effect,injection site effect,injection site management,injection site reaction,prevention,risk,tissue change,tissue disorder</data>
  <data key="d11">chunk-00bac63e27caeb094fe802c0bfe00a44&lt;SEP&gt;chunk-bc07da1fd30cc15e0022830f701a9c38&lt;SEP&gt;chunk-ef496454c12f85ff1f62de19e8a22be4&lt;SEP&gt;chunk-5a07d2f5e930a504dfb7c969e65903a4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698158</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Subcutaneous Administration">
  <data key="d8">1.0</data>
  <data key="d9">Rotating injection sites within the same region during subcutaneous administration helps reduce the risk of lipodystrophy.</data>
  <data key="d10">risk mitigation,site rotation</data>
  <data key="d11">chunk-1724d2e466fc891cc272dc5ef36ed31a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698301</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Novolin® R">
  <data key="d8">7.0</data>
  <data key="d9">Repeated use of Novolin® R in the same injection site without rotation increases the risk of lipodystrophy.&lt;SEP&gt;Lipodystrophy is an uncommon adverse reaction at injection sites due to repeated Novolin® R administration.&lt;SEP&gt;Repeated insulin injections with Novolin® R in the same area may lead to lipodystrophy, which can be prevented by rotating injection sites.&lt;SEP&gt;Repeated injections in the same site can cause lipodystrophy, which is preventable by rotating sites.&lt;SEP&gt;Repeated insulin injections with Novolin® R in the same area may lead to lipodystrophy, affecting insulin absorption and glycemic control.&lt;SEP&gt;Failure to rotate injection sites when using Novolin® R increases the risk of developing Lipodystrophy.&lt;SEP&gt;Lipodystrophy, including lipoatrophy and lipohypertrophy, may occur at injection sites due to repeated use of Novolin® R.</data>
  <data key="d10">adverse effect,injection complication,injection risk,injection site reaction,injection site risk,prevention,risk factor,skin condition,tissue change,tissue effect</data>
  <data key="d11">chunk-2d59277cc4b25262a26a88992bfb526f&lt;SEP&gt;chunk-0e1d7f92cdb7923807a9067d937837a4&lt;SEP&gt;chunk-4db353458c93e1b1abc9f696ebf195a9&lt;SEP&gt;chunk-001d95b4722fb6304af5e929d80557ac&lt;SEP&gt;chunk-b2339435aa42eeb6f0cb8bffbf4d5184&lt;SEP&gt;chunk-43208e8857e43453277beecb7a6c55d5&lt;SEP&gt;chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699069</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Novolin® R Penfill">
  <data key="d8">2.0</data>
  <data key="d9">Repeated injections of Novolin® R Penfill in the same site increase the risk of lipodystrophy, which can be prevented by rotating injection areas.&lt;SEP&gt;Lipodystrophy is an uncommon reaction at injection sites due to repeated insulin injections with Novolin® R.</data>
  <data key="d10">adverse effect,prevention,risk,tissue change</data>
  <data key="d11">chunk-ff021af578e58080f6a865c5f105e6d3&lt;SEP&gt;chunk-98a0b8b861ae9af417a572907fe16408</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699097</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Skin Rotation">
  <data key="d8">1.0</data>
  <data key="d9">Rotating injection sites within a region helps prevent or reduce the risk of lipodystrophy.</data>
  <data key="d10">prevention,risk reduction</data>
  <data key="d11">chunk-4db353458c93e1b1abc9f696ebf195a9</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699143</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Injection Site Reaction">
  <data key="d8">1.0</data>
  <data key="d9">Repeated insulin injections without site rotation can lead to lipodystrophy, a skin condition that impairs insulin absorption.</data>
  <data key="d10">prevention strategy,tissue damage</data>
  <data key="d11">chunk-a0ee5ffd422bf5c38703d11eefbcff6f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699158</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Subcutaneous Injection">
  <data key="d8">1.0</data>
  <data key="d9">Rotating injection sites during subcutaneous administration helps prevent lipodystrophy.</data>
  <data key="d10">complication,prevention strategy</data>
  <data key="d11">chunk-ea9fa1ee045093083e543d672f1309db</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699181</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Humulin R">
  <data key="d8">1.0</data>
  <data key="d9">Repeated insulin injections in the same site can cause lipodystrophy, which can be prevented by rotating injection sites.</data>
  <data key="d10">complication,prevention</data>
  <data key="d11">chunk-128e097e2326548df575159ee000923b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699657</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Hyperglycemia">
  <data key="d8">1.0</data>
  <data key="d9">Repeated insulin injections in areas with lipodystrophy may result in hyperglycemia.</data>
  <data key="d10">injection site effect,treatment complication</data>
  <data key="d11">chunk-f8938c7b2cdfb8e023d3ebcda62fd027</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699675</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodystrophy" target="Insulin Injection Technique">
  <data key="d8">1.0</data>
  <data key="d9">Changing the injection technique and rotating injection sites may help prevent or alleviate lipodystrophy.</data>
  <data key="d10">prevention strategy,site rotation</data>
  <data key="d11">chunk-f8938c7b2cdfb8e023d3ebcda62fd027</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699677</data>
  <data key="d14"></data>
</edge>
<edge source="Lipoatrophy" target="Insulin Administration">
  <data key="d8">1.0</data>
  <data key="d9">Lipoatrophy can occur if insulin is repeatedly injected in the same location, emphasizing the need for site rotation.</data>
  <data key="d10">injection risk,site rotation</data>
  <data key="d11">chunk-2a0a3f492aa5ef7771b2246547cb5f02</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694482</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohypertrophy" target="Glycemic Control">
  <data key="d8">1.0</data>
  <data key="d9">Lipohypertrophy impairs consistent insulin absorption, leading to poor glycemic control.</data>
  <data key="d10">absorption variability,treatment efficacy</data>
  <data key="d11">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694463</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohypertrophy" target="4 mm Needle">
  <data key="d8">1.0</data>
  <data key="d9">The use of 4 mm needles, combined with proper training, was associated with a reduction in lipohypertrophy incidence.</data>
  <data key="d10">complication prevention,injection technique</data>
  <data key="d11">chunk-a7740b86f0b3f110bb2c3f3d05e4da41</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695215</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohypertrophy" target="Skin Inspection">
  <data key="d8">1.0</data>
  <data key="d9">Skin inspection helps identify lipohypertrophy, and insulin should not be injected into affected areas.</data>
  <data key="d10">condition detection,treatment adjustment</data>
  <data key="d11">chunk-035472811a4a16d98e62eba23a86dceb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695218</data>
  <data key="d14"></data>
</edge>
<edge source="Lipohypertrophy" target="Healthcare Professional">
  <data key="d8">1.0</data>
  <data key="d9">The healthcare professional educates patients, families, and caregivers about the importance of site inspection and rotation to prevent lipohypertrophy.</data>
  <data key="d10">patient education,prevention</data>
  <data key="d11">chunk-8b2243846b349d5b78af57a8e77b6ff5</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696028</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Refrigerator">
  <data key="d8">2.0</data>
  <data key="d9">Unopened insulin must be stored in the refrigerator within the recommended temperature range of 2 °C to 8 °C.&lt;SEP&gt;Unopened insulin must be stored in a refrigerator between 2°C and 8°C to maintain stability and efficacy.</data>
  <data key="d10">cold chain,temperature range,temperature regulation</data>
  <data key="d11">chunk-03a1de93a53fbcb513268c123e2c5a16&lt;SEP&gt;chunk-c8702ff00244abf3caabafff5aad4a65</data>
  <data key="d12">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte e conservação Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
  <data key="d13">1778696368</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Pre-Filled Insulin Pen">
  <data key="d8">1.0</data>
  <data key="d9">Pre-filled insulin pens should not be stored in the refrigerator once in use to prevent damage to the mechanism.</data>
  <data key="d10">device handling,temperature sensitivity</data>
  <data key="d11">chunk-03a1de93a53fbcb513268c123e2c5a16</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694534</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Brazilian Diabetes Society">
  <data key="d8">1.0</data>
  <data key="d9">The Brazilian Diabetes Society recommends storing unused insulin between 2–8°C and in-use insulin at room temperature up to 30°C.</data>
  <data key="d10">clinical guideline,recommendation</data>
  <data key="d11">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695249</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Heparin">
  <data key="d8">1.0</data>
  <data key="d9">Heparin should be stored separately from insulin to prevent mix-ups due to similar packaging.</data>
  <data key="d10">confusion risk,storage separation</data>
  <data key="d11">chunk-dde6c55191737188788dc809811837cc</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696006</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Vaccines">
  <data key="d8">1.0</data>
  <data key="d9">Vaccines and insulin should not be stored in the same refrigerator compartment to avoid errors and maintain proper conditions.</data>
  <data key="d10">refrigeration,storage separation</data>
  <data key="d11">chunk-dde6c55191737188788dc809811837cc</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696007</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Insulin Therapy Care">
  <data key="d8">1.0</data>
  <data key="d9">Proper insulin storage is a critical aspect of insulin therapy care to maintain medication effectiveness.</data>
  <data key="d10">medication safety,treatment efficacy</data>
  <data key="d11">chunk-11ac81b4dee4dbb3636b8dc2403e0661</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/Cuidados com a Insulinoterapia conservar.pdf</data>
  <data key="d13">1778696147</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="Sealed Insulin">
  <data key="d8">1.0</data>
  <data key="d9">Sealed insulin must be stored between 2 and 8°C and is valid for 2 to 3 years from manufacture.</data>
  <data key="d10">shelf life,temperature control</data>
  <data key="d11">chunk-11ac81b4dee4dbb3636b8dc2403e0661</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Armazenamento e Transporte/Cuidados com a Insulinoterapia conservar.pdf</data>
  <data key="d13">1778696148</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Storage" target="In-Use Insulin Vial">
  <data key="d8">1.0</data>
  <data key="d9">An in-use insulin vial can be stored refrigerated or at room temperature and remains effective for 4 to 8 weeks after opening.</data>
  <data key="d10">storage conditions,usage period</data>
