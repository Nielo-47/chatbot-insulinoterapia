  <data key="d12">1786325631</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Stop Bolus">
  <data key="d7">1.0</data>
  <data key="d8">The Stop Bolus method allows the user to interrupt an ongoing bolus on the insulin pump.</data>
  <data key="d9">control,function</data>
  <data key="d10">chunk-3d24fce6aa8866fb4a11514ae0e4d675</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d12">1786325633</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Active Insulin Duration">
  <data key="d7">1.0</data>
  <data key="d8">Active Insulin Duration is a configurable parameter within the Insulin Pump affecting insulin activity time.</data>
  <data key="d9">feature,parameter</data>
  <data key="d10">chunk-b9eee903de4b7e25fc53f52e2e739637</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d12">1786325660</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Metal Detectors">
  <data key="d7">1.0</data>
  <data key="d8">The insulin pump can be carried through airport metal detectors without removal.</data>
  <data key="d9">allowance,security</data>
  <data key="d10">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
