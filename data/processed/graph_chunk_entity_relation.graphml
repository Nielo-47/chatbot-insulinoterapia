  <data key="d1">artifact</data>
  <data key="d2">Levemir® + Liraglutida + Metformina is a triple‑therapy regimen evaluated in the Randomized Open Study.</data>
  <data key="d3">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317655</data>
