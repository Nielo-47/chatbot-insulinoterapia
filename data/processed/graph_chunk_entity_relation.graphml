  <data key="d1">organization</data>
  <data key="d2">Serviço de Atendimento ao Consumidor da SAN is the consumer service department mentioned for user assistance with TOUJEO 300 U/mL.</data>
  <data key="d3">chunk-1d7223c781e745e72311fccfcdd58583</data>
