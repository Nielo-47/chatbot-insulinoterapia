<node id="Config. Patron Basal">
  <data key="d0">Config. Patron Basal</data>
  <data key="d1">method</data>
  <data key="d2">Config. Patron Basal is a setting interface where users can configure and modify basal insulin infusion patterns.</data>
  <data key="d3">chunk-1134674d4e1ab07998567f3fa77e251d</data>
