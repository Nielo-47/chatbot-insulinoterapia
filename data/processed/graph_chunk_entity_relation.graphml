  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704358</data>
  <data key="d14"></data>
</edge>
<edge source="Glucose Reading" target="Start Screen">
  <data key="d8">1.0</data>
  <data key="d9">The Start Screen displays the latest glucose reading obtained within the past 12 minutes.</data>
  <data key="d10">health monitoring,real-time data</data>
  <data key="d11">chunk-08ad1da3ea94a4990f8ed72edc46798f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704423</data>
  <data key="d14"></data>
</edge>
<edge source="Glucose Reading" target="Trend Arrow">
  <data key="d8">1.0</data>
  <data key="d9">Trend arrows are derived from glucose readings to indicate the rate and direction of glucose level changes.</data>
  <data key="d10">data interpretation,trend analysis</data>
  <data key="d11">chunk-eb234cb663874d4e5a473c7f3e19383b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707695</data>
  <data key="d14"></data>
</edge>
<edge source="Glucose Reading" target="SmartGuard Feature">
  <data key="d8">1.0</data>
  <data key="d9">When active, the SmartGuard feature uses available glucose readings to calculate bolus insulin amounts.</data>
  <data key="d10">automated insulin delivery,bolus calculation</data>
  <data key="d11">chunk-eb234cb663874d4e5a473c7f3e19383b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707697</data>
  <data key="d14"></data>
</edge>
<edge source="User Manual" target="Accu-Chek Solo Micro Pump">
  <data key="d8">1.0</data>
  <data key="d9">The User Manual provides essential instructions, warnings, and information for the safe and correct use of the Accu-Chek Solo Micro Pump system.</data>
  <data key="d10">safety information,usage guidance</data>
  <data key="d11">chunk-bd22ca03a61055434dc1e128fb57ee3f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/IFU Accu-Chek Guide Solo Diabetes Manager.PDF</data>
  <data key="d13">1778704683</data>
  <data key="d14"></data>
</edge>
<edge source="User Manual" target="Cleaning And Disinfection">
  <data key="d8">1.0</data>
  <data key="d9">The User Manual contains a section on Cleaning And Disinfection with detailed procedures for maintaining the micro pump system.</data>
  <data key="d10">hygiene protocol,maintenance instruction</data>
  <data key="d11">chunk-bd22ca03a61055434dc1e128fb57ee3f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/IFU Accu-Chek Guide Solo Diabetes Manager.PDF</data>
  <data key="d13">1778704685</data>
  <data key="d14"></data>
</edge>
<edge source="User Manual" target="Waste Disposal">
  <data key="d8">1.0</data>
  <data key="d9">The User Manual includes guidance on Waste Disposal, advising users to follow local regulations for environmentally safe disposal of used components.</data>
  <data key="d10">environmental compliance,product lifecycle</data>
  <data key="d11">chunk-bd22ca03a61055434dc1e128fb57ee3f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/IFU Accu-Chek Guide Solo Diabetes Manager.PDF</data>
  <data key="d13">1778704686</data>
  <data key="d14"></data>
</edge>
<edge source="Extreme Temperatures" target="MiniMed 780G Insulin Pump System">
  <data key="d8">1.0</data>
  <data key="d9">Exposure to extreme temperatures can damage the insulin pump and impair its operation outside specified ranges.</data>
  <data key="d10">device damage,operational limits</data>
  <data key="d11">chunk-4a597a39961d2cb246ad385f39cfb886</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708170</data>
  <data key="d14"></data>
</edge>
<edge source="Extreme Temperatures" target="Insulin Solutions">
  <data key="d8">1.0</data>
  <data key="d9">Insulin solutions are vulnerable to freezing at 32 °F (0 °C) and degradation above 98.6 °F (37 °C), necessitating temperature control.</data>
  <data key="d10">freezing risk,insulin degradation</data>
  <data key="d11">chunk-4a597a39961d2cb246ad385f39cfb886</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708171</data>
  <data key="d14"></data>
</edge>
<edge source="Traveler" target="Stress">
  <data key="d8">1.0</data>
  <data key="d9">Stress during travel can impact blood glucose levels and complicate diabetes management.</data>
  <data key="d10">diabetes management,physiological impact</data>
  <data key="d11">chunk-40aae9750bff384ac9028ae500bc1fb4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704330</data>
  <data key="d14"></data>
</edge>
<edge source="Traveler" target="Activity Level Changes">
  <data key="d8">1.0</data>
  <data key="d9">Changes in activity levels during travel can influence blood glucose and require monitoring and insulin adjustments.</data>
  <data key="d10">diabetes management,physiological impact</data>
  <data key="d11">chunk-40aae9750bff384ac9028ae500bc1fb4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704332</data>
  <data key="d14"></data>
</edge>
<edge source="Traveler" target="Meal Schedule Changes">
  <data key="d8">1.0</data>
  <data key="d9">Changes in meal timing and food types during travel can affect blood glucose and require adjustments in insulin therapy.</data>
  <data key="d10">diabetes management,physiological impact</data>
  <data key="d11">chunk-40aae9750bff384ac9028ae500bc1fb4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d13">1778704333</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina De Acción Intermedia" target="Absorción De Insulina">
  <data key="d8">1.0</data>
  <data key="d9">La absorción de insulina de acción intermedia es variable y puede tardar entre 12 y 24 horas, lo que dificulta predecir cuánta insulina basal está disponible.</data>
  <data key="d10">retraso,variabilidad</data>
  <data key="d11">chunk-59696e5e7f94ff9d51e39d90ec169e17</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702646</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina De Acción Intermedia" target="Piel Grasa">
  <data key="d8">1.0</data>
  <data key="d9">La insulina de acción intermedia se deposita bajo la piel, y en casos de piel grasa, su absorción puede verse afectada, contribuyendo a la variabilidad en los niveles de insulina basal.</data>
  <data key="d10">absorción alterada,depósito subcutáneo</data>
  <data key="d11">chunk-59696e5e7f94ff9d51e39d90ec169e17</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702649</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina De Acción Prolongada" target="Absorción De Insulina">
  <data key="d8">1.0</data>
  <data key="d9">La insulina de acción prolongada se acumula bajo la piel y su absorción es impredecible, lo que contribuye a la dificultad para controlar los niveles de glucosa.</data>
  <data key="d10">acumulación,variabilidad</data>
  <data key="d11">chunk-59696e5e7f94ff9d51e39d90ec169e17</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702647</data>
  <data key="d14"></data>
</edge>
<edge source="Índice Basal Temporal" target="Enfermedad O Infección">
  <data key="d8">1.0</data>
  <data key="d9">Durante una enfermedad o infección, se puede usar un índice basal temporal para cubrir el aumento en las necesidades de insulina basal.</data>
  <data key="d10">ajuste terapéutico,necesidad de insulina</data>
  <data key="d11">chunk-369c90dae1a79813d89bb9a0b31ebfe9</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702808</data>
  <data key="d14"></data>
</edge>
<edge source="FSI" target="Bolus de Correccion">
  <data key="d8">1.0</data>
  <data key="d9">FSI is used in the denominator of the correction formula to determine how many units of insulin are needed per mg/dL of glucose adjustment.</data>
  <data key="d10">dose adjustment,insulin sensitivity</data>
  <data key="d11">chunk-ec2fea6c095d8e93483ff43ef875fb9b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703180</data>
  <data key="d14"></data>
</edge>
<edge source="SG" target="Tendencia">
  <data key="d8">1.0</data>
  <data key="d9">SG values are used to generate Tendencia readings that show the direction and speed of glucose changes.</data>
  <data key="d10">continuous monitoring,data analysis</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702653</data>
  <data key="d14"></data>
</edge>
<edge source="SG" target="High SG Alert">
  <data key="d8">1.0</data>
  <data key="d9">The High SG Alert is triggered when SG values are 250 mg/dL or higher for more than three hours.</data>
  <data key="d10">glucose monitoring,threshold trigger</data>
  <data key="d11">chunk-a4dae9b37ffd9805fb682b2152950552</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707537</data>
  <data key="d14"></data>
</edge>
<edge source="SG" target="Low SG Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Low SG Alert activates when SG drops below 55 mg/dL or 64 mg/dL, depending on the sensor configuration.</data>
  <data key="d10">hypoglycemia warning,threshold trigger</data>
  <data key="d11">chunk-a4dae9b37ffd9805fb682b2152950552</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707539</data>
  <data key="d14"></data>
</edge>
<edge source="SG" target="CGM Device">
  <data key="d8">1.0</data>
  <data key="d9">SG values are generated by the CGM device as estimates of blood glucose levels.</data>
  <data key="d10">continuous monitoring,data generation</data>
  <data key="d11">chunk-a4dae9b37ffd9805fb682b2152950552</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707540</data>
  <data key="d14"></data>
</edge>
<edge source="SG" target="Low Limit">
  <data key="d8">1.0</data>
  <data key="d9">When SG readings fall at or below the low limit, the system triggers a low glucose alarm or suspension.</data>
  <data key="d10">alarm condition,threshold trigger</data>
  <data key="d11">chunk-cfb8f4a2fd599a5ec7cbad8c356a6ed4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708117</data>
  <data key="d14"></data>
</edge>
<edge source="SG" target="Low SG Alarm">
  <data key="d8">1.0</data>
  <data key="d9">The Low SG Alarm is based on SG readings dropping to or below the low limit, prompting user intervention.</data>
  <data key="d10">hypoglycemia detection,threshold monitoring</data>
  <data key="d11">chunk-cfb8f4a2fd599a5ec7cbad8c356a6ed4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708120</data>
  <data key="d14"></data>
</edge>
<edge source="Tentempié Antes de Acostarse" target="Bolus Adicional">
  <data key="d8">1.0</data>
  <data key="d9">A Tentempié Antes de Acostarse may require a Bolus Adicional to prevent high glucose levels overnight.</data>
  <data key="d10">insulin dosing,snack coverage</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702654</data>
  <data key="d14"></data>
</edge>
<edge source="Alertas Alta" target="Grafico del Sensor">
  <data key="d8">1.0</data>
  <data key="d9">The Grafico del Sensor helps identify periods of high SG that may trigger Alertas Alta.</data>
  <data key="d10">high glucose detection,pattern recognition</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702653</data>
  <data key="d14"></data>
</edge>
<edge source="Alertas Alta" target="Bolus de Comida">
  <data key="d8">1.0</data>
  <data key="d9">Forgetting a Bolus de Comida can lead to high glucose levels and trigger Alertas Alta, especially if not corrected promptly.</data>
  <data key="d10">glucose elevation,missed dose</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702655</data>
  <data key="d14"></data>
</edge>
<edge source="Equipo para la Diabetes" target="Hoja de Documentacion">
  <data key="d8">1.0</data>
  <data key="d9">Patients use the Hoja de Documentacion to record data and discuss findings with the Equipo para la Diabetes.</data>
  <data key="d10">clinical discussion,data sharing</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702654</data>
  <data key="d14"></data>
</edge>
<edge source="Fundamentos de la Terapia con Bomba de Insulina" target="MiniMed™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The Fundamentos de la Terapia con Bomba de Insulina provides instructional content for using the MiniMed™ 640G.</data>
  <data key="d10">device guidance,therapy education</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702654</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus Omitidos (Comidas)" target="MiniMed™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G includes the Bolus Omitidos (Comidas) function to alert users if a mealtime bolus is missed.</data>
  <data key="d10">automated notification,missed dose alert</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702652</data>
  <data key="d14"></data>
</edge>
<edge source="Ratio Insulina/Racion" target="Comida con Grasas y Proteinas">
  <data key="d8">1.0</data>
  <data key="d9">The Ratio Insulina/Racion may need adjustment when consuming Comida con Grasas y Proteinas due to slower glucose absorption.</data>
  <data key="d10">carbohydrate counting,delayed digestion</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702653</data>
  <data key="d14"></data>
</edge>
<edge source="Ratio Insulina/Racion" target="Calculo Del Bolus De Comida">
  <data key="d8">1.0</data>
  <data key="d9">The Ratio Insulina/Racion is a key input in the Calculo Del Bolus De Comida formula.</data>
  <data key="d10">calculation parameter,formula input</data>
  <data key="d11">chunk-bd60281301900b9df0acbe6be09fa2f2</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703074</data>
  <data key="d14"></data>
</edge>
<edge source="Ratio Insulina/Racion" target="Funcion Bolus Wizard">
  <data key="d8">1.0</data>
  <data key="d9">The Funcion Bolus Wizard uses the programmed Ratio Insulina/Racion to compute the required insulin dose.</data>
  <data key="d10">dose determination,parameter programming</data>
  <data key="d11">chunk-bd60281301900b9df0acbe6be09fa2f2</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703076</data>
  <data key="d14"></data>
</edge>
<edge source="Ratio Insulina/Racion" target="Sistema Integrado Minimed™">
  <data key="d8">1.0</data>
  <data key="d9">The Ratio Insulina/Racion must be properly set in the Sistema Integrado Minimed™ to ensure accurate insulin dosing for meals.</data>
  <data key="d10">mealtime dosing,parameter configuration</data>
  <data key="d11">chunk-bc23f53afc0fcecdd9527e9dab84cb8b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703136</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus de Comida" target="Cantidad de Bolus Total">
  <data key="d8">1.0</data>
  <data key="d9">Bolus de Comida is added to the correction bolus to determine the Cantidad de Bolus Total.</data>
  <data key="d10">dose summation,total insulin</data>
  <data key="d11">chunk-ec2fea6c095d8e93483ff43ef875fb9b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703178</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus de Comida" target="Raciones">
  <data key="d8">1.0</data>
  <data key="d9">Raciones are multiplied by the inverse of the Ratio to calculate the Bolus de Comida.</data>
  <data key="d10">carbohydrate counting,insulin dosing</data>
  <data key="d11">chunk-ec2fea6c095d8e93483ff43ef875fb9b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703178</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus de Comida" target="Ratio">
  <data key="d8">1.0</data>
  <data key="d9">Ratio is used to determine how much insulin is needed to cover a given number of carbohydrate servings.</data>
  <data key="d10">insulin-to-carb ratio,meal coverage</data>
  <data key="d11">chunk-ec2fea6c095d8e93483ff43ef875fb9b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703180</data>
  <data key="d14"></data>
</edge>
<edge source="Historial de Bolus" target="MiniMed™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The Historial de Bolus in the MiniMed™ 640G system provides a record of past bolus doses for review and analysis.</data>
  <data key="d10">bolus tracking,data logging</data>
  <data key="d11">chunk-51d265f691032645cfa3e43210043f3a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702656</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta Antes Limite Bajo" target="Sistema MiniMed ™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G system includes the "Alerta antes limite bajo" to warn users before glucose reaches dangerously low levels.</data>
  <data key="d10">alert system,hypoglycemia prevention</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702655</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta En Limite Alto" target="Sistema MiniMed ™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G system uses the "Alerta en limite alto" to prevent excessive glucose levels and potential ketosis.</data>
  <data key="d10">alert system,hyperglycemia prevention</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702655</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta En Limite Alto" target="Cetosis">
  <data key="d8">1.0</data>
  <data key="d9">The "Alerta en limite alto" helps prevent ketosis by warning of dangerously high glucose levels.</data>
  <data key="d10">metabolic health,risk prevention</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702657</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta En Limite Alto" target="Cetoacidosis">
  <data key="d8">1.0</data>
  <data key="d9">By alerting at high glucose thresholds, the system helps avoid progression to cetoacidosis.</data>
  <data key="d10">emergency avoidance,risk prevention</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702658</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta En Limite Alto" target="MiniMed™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G triggers an Alerta En Limite Alto when the sensor glucose value reaches the predefined high limit.</data>
  <data key="d10">glucose monitoring,threshold alert</data>
  <data key="d11">chunk-cfc5f5eb70e79d2ce44b3ba795b76b3e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702790</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta Ascenso" target="Sistema MiniMed ™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The "Alerta ascenso" in the MiniMed™ 640G system helps users respond to rising glucose trends before they become critical.</data>
  <data key="d10">early warning,trend monitoring</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702656</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta Ascenso" target="MiniMed™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G issues an Alerta Ascenso when glucose levels rise faster than a preset rate.</data>
  <data key="d10">alert system,rapid rise detection</data>
  <data key="d11">chunk-cfc5f5eb70e79d2ce44b3ba795b76b3e</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702796</data>
  <data key="d14"></data>
</edge>
<edge source="Sistema MiniMed ™ 640G" target="Tendencia Ascendente">
  <data key="d8">1.0</data>
  <data key="d9">The system detects and displays upward glucose trends using directional arrows to inform user decisions.</data>
  <data key="d10">glucose monitoring,predictive alert</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702659</data>
  <data key="d14"></data>
</edge>
<edge source="Sistema MiniMed ™ 640G" target="Autocontrol De Glucemia Capilar">
  <data key="d8">1.0</data>
  <data key="d9">Users are instructed to perform capillary glucose tests to confirm sensor readings when alerts are triggered.</data>
  <data key="d10">therapy decision,verification method</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702659</data>
  <data key="d14"></data>
</edge>
<edge source="Sistema MiniMed ™ 640G" target="Duracion Hasta Limite Alto">
  <data key="d8">1.0</data>
  <data key="d9">The "Duracion hasta limite alto" setting determines how far in advance the system warns before reaching a high glucose threshold.</data>
  <data key="d10">customizable alert,predictive timing</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702660</data>
  <data key="d14"></data>
</edge>
<edge source="Sistema MiniMed ™ 640G" target="Guia De Usuario Del Sistema MiniMed ™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The user guide provides detailed instructions for operating the MiniMed™ 640G system and responding to alerts.</data>
  <data key="d10">instructional content,user support</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702661</data>
  <data key="d14"></data>
</edge>
<edge source="Sistema MiniMed ™ 640G" target="MiniMed ™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The "Sistema MiniMed ™ 640G" refers to the MiniMed ™ 640G insulin pump device used for diabetes therapy.</data>
  <data key="d10">device naming,product identity</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702662</data>
  <data key="d14"></data>
</edge>
<edge source="Guia De Usuario Del Sistema MiniMed ™ 640G" target="SAP En La Rutina Diaria">
  <data key="d8">1.0</data>
  <data key="d9">The "SAP En La Rutina Diaria" is a chapter in the user guide that provides instructions on using the MiniMed™ 640G system in everyday life.</data>
  <data key="d10">daily use guidance,manual section</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702662</data>
  <data key="d14"></data>
</edge>
<edge source="Autocontrol De Glucemia Capilar" target="SmartGuard™">
  <data key="d8">1.0</data>
  <data key="d9">No es obligatorio realizar un autocontrol de glucemia capilar para confirmar cuando se activa la función de suspensión antes del límite bajo de SmartGuard™.</data>
  <data key="d10">confirmation,verification</data>
  <data key="d11">chunk-1161d90ae3c3dfe3fc54cc15351e9452</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703080</data>
  <data key="d14"></data>
</edge>
<edge source="Liver" target="Glucose Regulation">
  <data key="d8">1.0</data>
  <data key="d9">The liver releases or stores glucose under insulin's regulation to maintain blood glucose balance.</data>
  <data key="d10">insulin response,metabolic function</data>
  <data key="d11">chunk-20fd2bf061c46e98e4d7791fe6728699</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702968</data>
  <data key="d14"></data>
</edge>
<edge source="Liver" target="Blood Glucose Levels">
  <data key="d8">1.0</data>
  <data key="d9">The liver maintains blood glucose levels by storing glucose when levels are high and releasing it when levels are low.</data>
  <data key="d10">glucose release,glucose storage</data>
  <data key="d11">chunk-b139e060742a21ffc13eee0fdbf0be4a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703202</data>
  <data key="d14"></data>
</edge>
<edge source="Fat" target="Ketone Bodies">
  <data key="d8">1.0</data>
  <data key="d9">When insulin is lacking, the body uses fat for energy, producing ketone bodies as acidic byproducts.</data>
  <data key="d10">energy alternative,metabolic byproduct</data>
  <data key="d11">chunk-1d2c98e899214ad3a2eb3b7863c5d5bf</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702836</data>
  <data key="d14"></data>
</edge>
<edge source="Glucose Levels" target="Illness Management Guidelines">
  <data key="d8">1.0</data>
  <data key="d9">During illness, glucose levels must be checked every two hours due to the increased risk of hyperglycemia.</data>
  <data key="d10">disease impact,monitoring frequency</data>
  <data key="d11">chunk-23235296c6ccfffc5ec397dd6b0dc7b7</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702692</data>
  <data key="d14"></data>
</edge>
<edge source="Glucose Levels" target="Therapy With Insulin Pump">
  <data key="d8">1.0</data>
  <data key="d9">Maintaining stable glucose levels is essential for the success of therapy with insulin pump.</data>
  <data key="d10">glycemic control,monitoring</data>
  <data key="d11">chunk-44b69a8e50a0a4230b6963fe643d8cd0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702911</data>
  <data key="d14"></data>
</edge>
<edge source="Ketone Bodies" target="Illness Management Guidelines">
  <data key="d8">1.0</data>
  <data key="d9">The guidelines recommend checking for ketone bodies during illness to assess the risk of developing diabetic ketoacidosis.</data>
  <data key="d10">monitoring requirement,risk assessment</data>
  <data key="d11">chunk-23235296c6ccfffc5ec397dd6b0dc7b7</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702686</data>
  <data key="d14"></data>
</edge>
<edge source="Ketone Bodies" target="Ketoacidosis Diabética">
  <data key="d8">1.0</data>
  <data key="d9">High levels of ketone bodies in the blood can lead to diabetic ketoacidosis, a life-threatening condition.</data>
  <data key="d10">metabolic crisis,pathological accumulation</data>
  <data key="d11">chunk-1d2c98e899214ad3a2eb3b7863c5d5bf</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702841</data>
  <data key="d14"></data>
</edge>
<edge source="Ketone Bodies" target="Blood Ketone Test">
  <data key="d8">1.0</data>
  <data key="d9">A blood ketone test is used to detect the presence and level of ketone bodies in the blood.</data>
  <data key="d10">detection method,diagnostic tool</data>
  <data key="d11">chunk-6ec727091282384bd8f9c91eb1d29b78</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702843</data>
  <data key="d14"></data>
</edge>
<edge source="Ketone Bodies" target="Urine Ketone Test">
  <data key="d8">1.0</data>
  <data key="d9">A urine ketone test detects ketone bodies in urine using reactive test strips.</data>
  <data key="d10">detection method,diagnostic tool</data>
  <data key="d11">chunk-6ec727091282384bd8f9c91eb1d29b78</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702853</data>
  <data key="d14"></data>
</edge>
<edge source="Ketone Bodies" target="Insulin Correction Dose">
  <data key="d8">1.0</data>
  <data key="d9">A negative ketone body test allows for insulin correction dose administration using the pump; a positive test requires alternative action.</data>
  <data key="d10">metabolic state,treatment decision</data>
