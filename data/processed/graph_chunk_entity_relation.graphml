  <data key="d5">1786317651</data>
  <data key="d6"></data>
</node>
<node id="Zinc Acetate">
  <data key="d0">Zinc Acetate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Zinc acetate is an excipient component of the Tresiba® formulation.&lt;SEP&gt;Zinc acetate is an excipient listed in the Fiasp® formulation.&lt;SEP&gt;Zinc acetate is an excipient used in the formulation of Levemir® FlexPen® injectable solution.</data>
  <data key="d3">chunk-e590341aac73dca916e560c2df9e60e0&lt;SEP&gt;chunk-c8c7e36686d077dcb6239405f60ea031&lt;SEP&gt;chunk-b65a4249ac93aec086cb333ed1507ea7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/TRESIBA _ BulasMed.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317651</data>
  <data key="d6"></data>
</node>
<node id="Hydrochloric Acid">
  <data key="d0">Hydrochloric Acid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hydrochloric acid is an excipient component of the Tresiba® formulation.&lt;SEP&gt;Hydrochloric acid is a concentrated acid used as an excipient in the Apidra SoloStar formulation.&lt;SEP&gt;Hydrochloric acid is an excipient listed in the Fiasp® formulation.&lt;SEP&gt;Hydrochloric acid is an excipient used in the formulation of Levemir® FlexPen® injectable solution.</data>
  <data key="d3">chunk-e590341aac73dca916e560c2df9e60e0&lt;SEP&gt;chunk-162882e6afffb0db8ae5e9153e5f1e82&lt;SEP&gt;chunk-c8c7e36686d077dcb6239405f60ea031&lt;SEP&gt;chunk-b65a4249ac93aec086cb333ed1507ea7</data>
