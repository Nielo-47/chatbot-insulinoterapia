  <data key="d7">1.0</data>
  <data key="d8">A1C correlates with mean glycemia, representing average blood glucose levels.</data>
  <data key="d9">correlation</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
