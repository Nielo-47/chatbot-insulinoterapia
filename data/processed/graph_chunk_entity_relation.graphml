<node id="Combination Therapy">
  <data key="d0">Combination Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Combination Therapy describes a treatment regime that includes a prandial insulin analog together with oral hypoglycemic agents, optionally metformin.</data>
  <data key="d3">chunk-97208e231aa338c60205244ac12e0492</data>
