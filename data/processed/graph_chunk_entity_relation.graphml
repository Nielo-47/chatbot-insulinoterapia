  <data key="d13"></data>
</edge>
<edge source="Insulina de Ação Rápida" target="Hipoglicemia Grave">
  <data key="d7">1.0</data>
  <data key="d8">Use of rapid‑acting insulin analogues reduced the incidence of severe hypoglycemia by 32%.</data>
  <data key="d9">outcome,risk reduction</data>
  <data key="d10">chunk-95c81e7ab8160456d9a63a9e0868205b</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
