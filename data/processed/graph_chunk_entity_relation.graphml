  <data key="d13">1778695764</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina Regular" target="Insulina de Ação Rápida">
  <data key="d8">1.0</data>
  <data key="d9">A insulina Regular é um exemplo de insulina de ação rápida com início em 30-60 minutos e duração de até 8 horas.</data>
  <data key="d10">duração,efeito farmacológico</data>
  <data key="d11">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
  <data key="d12">data/raw/Documento sem título.docx</data>
  <data key="d13">1778694985</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina Regular" target="SUS">
  <data key="d8">1.0</data>
  <data key="d9">O SUS fornece insulina Regular em tubetes de 3 mL para uso nas canetas reutilizáveis.</data>
  <data key="d10">medication supply,provision</data>
  <data key="d11">chunk-60fe44346c0b02882f7625cbf43d8ca0</data>
