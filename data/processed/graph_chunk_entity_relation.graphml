  <data key="d14"></data>
</edge>
<edge source="Carpule" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">The carpule is an integral component of the Novolin® R FlexPen® that stores insulin and may accumulate air bubbles requiring priming before use.</data>
  <data key="d10">component integration,fluid storage</data>
