</edge>
<edge source="Home Screen" target="Device Settings">
  <data key="d8">1.0</data>
  <data key="d9">Device Settings is a submenu accessible from the Home Screen where users configure pump features.</data>
  <data key="d10">menu hierarchy,system navigation</data>
