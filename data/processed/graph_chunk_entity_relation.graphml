<node id="Extreme Insulin Sensitivity">
  <data key="d0">Extreme Insulin Sensitivity</data>
  <data key="d1">concept</data>
  <data key="d2">Extreme insulin sensitivity describes patients who respond excessively to insulin and are indicated for SICI treatment.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
