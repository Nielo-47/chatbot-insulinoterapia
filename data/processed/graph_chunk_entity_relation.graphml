  <data key="d0">Densitometria</data>
  <data key="d1">method</data>
  <data key="d2">Densitometria is a body‑composition assessment method that can be performed with dual‑energy X‑ray absorptiometry to evaluate lipodistrofia.</data>
  <data key="d3">chunk-ed325288512881a80fa42dba504c4bff</data>
