  <data key="d6"></data>
</node>
<node id="Type 3c Diabetes">
  <data key="d0">Type 3c Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Type 3c diabetes, also called pancreatogenic diabetes, arises secondary to chronic pancreatitis or pancreatic cancer.&lt;SEP&gt;Type 3c diabetes is a synonym for pancreatic diabetes.&lt;SEP&gt;Type 3c Diabetes, also called pancreatic diabetes, is examined for underdiagnosis.</data>
  <data key="d3">chunk-c1ee3f56f3180d8544dbba6a542c9d68&lt;SEP&gt;chunk-355eedbe74750d3739f7257279494c9a&lt;SEP&gt;chunk-090b8f9281aa75054311d8f275a2c8f8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377235</data>
  <data key="d6"></data>
</node>
<node id="Chronic Pancreatitis">
  <data key="d0">Chronic Pancreatitis</data>
  <data key="d1">concept</data>
  <data key="d2">Chronic pancreatitis is a long‑standing inflammation of the pancreas linked to type 3c diabetes.&lt;SEP&gt;Chronic pancreatitis is a long‑standing form of pancreatitis that can cause postpancreatitis diabetes mellitus.&lt;SEP&gt;Chronic Pancreatitis is a long-term pancreatic disease discussed in relation to type 3c diabetes management.&lt;SEP&gt;A long‑standing inflammation of the pancreas that can lead to pancreatogenic diabetes.</data>
  <data key="d3">chunk-c1ee3f56f3180d8544dbba6a542c9d68&lt;SEP&gt;chunk-355eedbe74750d3739f7257279494c9a&lt;SEP&gt;chunk-090b8f9281aa75054311d8f275a2c8f8&lt;SEP&gt;chunk-8f1215318cea8c61dc12042476611f9f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377236</data>
  <data key="d6"></data>
</node>
<node id="Pancreatic Cancer">
  <data key="d0">Pancreatic Cancer</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pancreatic cancer is a malignant disease of the pancreas associated with type 3c diabetes.&lt;SEP&gt;Pancreatic Cancer is a disease associated with pancreatogenic diabetes.</data>
  <data key="d3">chunk-c1ee3f56f3180d8544dbba6a542c9d68&lt;SEP&gt;chunk-355eedbe74750d3739f7257279494c9a</data>
