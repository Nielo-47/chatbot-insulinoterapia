<node id="Nutritional Guidance">
  <data key="d0">Nutritional Guidance</data>
  <data key="d1">artifact</data>
  <data key="d2">Dietary counseling recommended as a preventive measure for high‑risk individuals.</data>
  <data key="d3">chunk-e428438c632682ef93541430ec497ed5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="One-Hour Plasma Glucose Level">
  <data key="d0">One-Hour Plasma Glucose Level</data>
  <data key="d1">concept</data>
  <data key="d2">The concentration of glucose in plasma measured one hour after the oral glucose tolerance test, identified as a strong predictor of incident type 2 diabetes.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="Israel Study of Glucose Intolerance, Obesity and Hypertension">
  <data key="d0">Israel Study of Glucose Intolerance, Obesity and Hypertension</data>
  <data key="d1">content</data>
  <data key="d2">A 24‑year longitudinal study that observed that one‑hour post‑load plasma glucose predicts dysglycemia.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="Brazilian Diabetes Society">
  <data key="d0">Brazilian Diabetes Society</data>
  <data key="d1">organization</data>
  <data key="d2">The professional society in Brazil that issued a position update on the management of metabolic dysfunction‑associated steatotic liver disease (MASLD) in people with prediabetes or type 2 diabetes.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="MASLD">
  <data key="d0">MASLD</data>
  <data key="d1">concept</data>
  <data key="d2">Metabolic dysfunction‑associated steatotic liver disease, a liver condition linked to metabolic abnormalities such as prediabetes and type 2 diabetes.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="NAFLD">
  <data key="d0">NAFLD</data>
  <data key="d1">concept</data>
  <data key="d2">Non‑alcoholic fatty liver disease, a condition associated with an almost twofold increased risk of incident type 2 diabetes and metabolic syndrome.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="Glucocorticoid‑Induced Diabetes Mellitus">
  <data key="d0">Glucocorticoid‑Induced Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes that develops as a result of glucocorticoid therapy, often overlooked in clinical practice.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="Algorithm for Detecting Glucocorticoid‑Induced Diabetes Mellitus">
  <data key="d0">Algorithm for Detecting Glucocorticoid‑Induced Diabetes Mellitus</data>
  <data key="d1">method</data>
  <data key="d2">A novel computational algorithm designed to identify glucocorticoid‑induced diabetes using a medical information database.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="Medical Information Database">
  <data key="d0">Medical Information Database</data>
  <data key="d1">data</data>
  <data key="d2">A large clinical data repository employed to develop and validate the algorithm for detecting glucocorticoid‑induced diabetes.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="Antipsychotic Medication Use">
  <data key="d0">Antipsychotic Medication Use</data>
  <data key="d1">concept</data>
  <data key="d2">The administration of antipsychotic drugs, which has been associated with an increased incidence of diabetes.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372025</data>
  <data key="d6"></data>
</node>
<node id="Dabelea 2014 Diabetes Prevalence Study">
  <data key="d0">Dabelea 2014 Diabetes Prevalence Study</data>
  <data key="d1">content</data>
  <data key="d2">A study reporting the prevalence of type 1 and type 2 diabetes among children and adolescents from 2001 to 2009.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372026</data>
  <data key="d6"></data>
</node>
<node id="Beta‑Cell Dysfunction">
  <data key="d0">Beta‑Cell Dysfunction</data>
  <data key="d1">concept</data>
  <data key="d2">Impaired function of pancreatic β‑cells, leading to inadequate insulin secretion.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372026</data>
  <data key="d6"></data>
</node>
<node id="Omiya MA Cohort Study">
  <data key="d0">Omiya MA Cohort Study</data>
  <data key="d1">content</data>
  <data key="d2">A population-based cohort study that examined fasting plasma glucose and diabetes incidence, including thresholds for impaired fasting glucose.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372026</data>
  <data key="d6"></data>
</node>
<node id="Systemic Inflammation">
  <data key="d0">Systemic Inflammation</data>
  <data key="d1">concept</data>
  <data key="d2">The body-wide inflammatory response examined for its association with incident diabetes in HIV-infected patients.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372026</data>
  <data key="d6"></data>
</node>
<node id="HIV-Infected Patients">
  <data key="d0">HIV-Infected Patients</data>
  <data key="d1">concept</data>
  <data key="d2">Individuals infected with HIV, studied for diabetes incidence following antiretroviral therapy and systemic inflammation.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372026</data>
  <data key="d6"></data>
</node>
<node id="Threshold for Impaired Fasting Glucose">
  <data key="d0">Threshold for Impaired Fasting Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">The glucose level cutoff used to define impaired fasting glucose, discussed in the Omiya MA cohort study.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372027</data>
  <data key="d6"></data>
</node>
<node id="Cardiovascular Risk">
  <data key="d0">Cardiovascular Risk</data>
  <data key="d1">concept</data>
  <data key="d2">The probability of experiencing cardiovascular events, which is elevated in individuals with Pre‑diabetes or high HbA1c.&lt;SEP&gt;The probability of developing cardiovascular disease, examined in relation to insulin sensitivity, glycated hemoglobin, and systemic inflammation.&lt;SEP&gt;Cardiovascular risk denotes the probability of developing heart‑related complications.&lt;SEP&gt;Cardiovascular risk refers to the likelihood of developing heart‑related disease, a concern in individuals with monogenic diabetes.</data>
  <data key="d3">chunk-ec7e786a85b1b6e6cc75bcfc9189fd27&lt;SEP&gt;chunk-3c6dca13b685243e63fb6f24f7cb301d&lt;SEP&gt;chunk-aff91698679a52cd7b07563b7b2627a3&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377239</data>
  <data key="d6"></data>
</node>
<node id="Ministério da Saúde do Brasil">
  <data key="d0">Ministério da Saúde do Brasil</data>
  <data key="d1">organization</data>
  <data key="d2">The Brazilian Ministry of Health is the governmental body that recommends the use of FINDRISC for DM2 risk stratification.&lt;SEP&gt;The Brazilian Ministry of Health that recommends the use of FINDRISC for diabetes risk assessment.</data>
  <data key="d3">chunk-67792416bc5f0609842dd2a9940d8749&lt;SEP&gt;chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372027</data>
  <data key="d6"></data>
</node>
<node id="Finnish Diabetes Risk Score (FINDRISC)">
  <data key="d0">Finnish Diabetes Risk Score (FINDRISC)</data>
  <data key="d1">method</data>
  <data key="d2">FINDRISC is a questionnaire with a maximum score of 26 that stratifies individuals into risk levels for developing Diabetes Mellitus Type 2.</data>
  <data key="d3">chunk-67792416bc5f0609842dd2a9940d8749</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372027</data>
  <data key="d6"></data>
</node>
<node id="Glicemia de Jejum (Fasting Glucose)">
  <data key="d0">Glicemia de Jejum (Fasting Glucose)</data>
  <data key="d1">method</data>
  <data key="d2">Fasting glucose is a blood test measuring glucose levels after fasting, used for DM2 screening.</data>
  <data key="d3">chunk-67792416bc5f0609842dd2a9940d8749</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372027</data>
  <data key="d6"></data>
</node>
<node id="R7 Recommendation">
  <data key="d0">R7 Recommendation</data>
  <data key="d1">content</data>
  <data key="d2">R7 recommends using fasting glucose and/or HbA1c as the first screening tests for DM2.</data>
  <data key="d3">chunk-67792416bc5f0609842dd2a9940d8749</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372027</data>
  <data key="d6"></data>
</node>
<node id="FINDRISC Calculator">
  <data key="d0">FINDRISC Calculator</data>
  <data key="d1">data</data>
  <data key="d2">The online FINDRISC calculator is available at https://diabetes.org.br/calculadoras/findrisc and implements the FINDRISC questionnaire.</data>
  <data key="d3">chunk-67792416bc5f0609842dd2a9940d8749</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="R11 Recommendation">
  <data key="d0">R11 Recommendation</data>
  <data key="d1">content</data>
  <data key="d2">R11 is a guideline referenced for situations where secondary diabetes should be screened.</data>
  <data key="d3">chunk-67792416bc5f0609842dd2a9940d8749</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="R12 Recommendation">
  <data key="d0">R12 Recommendation</data>
  <data key="d1">content</data>
  <data key="d2">R12 is a guideline referenced for situations where secondary diabetes should be screened.</data>
  <data key="d3">chunk-67792416bc5f0609842dd2a9940d8749</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="Multicenter AIDS Cohort Study (MACS)">
  <data key="d0">Multicenter AIDS Cohort Study (MACS)</data>
  <data key="d1">content</data>
  <data key="d2">MACS is a study cited that observed a higher incidence of DM among HIV‑positive individuals compared with HIV‑negative men.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="Antirretrovirais">
  <data key="d0">Antirretrovirais</data>
  <data key="d1">concept</data>
  <data key="d2">Antirretrovirais are antiretroviral drugs used to treat HIV, some of which are associated with increased risk of DM2.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="Inibidores da Integrase">
  <data key="d0">Inibidores da Integrase</data>
  <data key="d1">concept</data>
  <data key="d2">Inibidores da Integrase are a class of antiretroviral drugs mentioned as being linked to DM2 risk.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="Inibidores da Protease">
  <data key="d0">Inibidores da Protease</data>
  <data key="d1">concept</data>
  <data key="d2">Inibidores da Protease are another class of antiretroviral drugs mentioned as being linked to DM2 risk.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="Algoritmo para rastreamento de DM2">
  <data key="d0">Algoritmo para rastreamento de DM2</data>
  <data key="d1">artifact</data>
  <data key="d2">Algoritmo para rastreamento de DM2 is a flowchart provided in the guideline to determine screening frequency.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372028</data>
  <data key="d6"></data>
</node>
<node id="Classe I Nível C">
  <data key="d0">Classe I Nível C</data>
  <data key="d1">concept</data>
  <data key="d2">Classe I Nível C denotes the evidence quality level assigned to the guideline’s recommendations.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372029</data>
  <data key="d6"></data>
</node>
<node id="R11 a R14">
  <data key="d0">R11 a R14</data>
  <data key="d1">data</data>
  <data key="d2">R11 a R14 are evidence summary references cited in the guideline to support its recommendations on diabetes mellitus.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372029</data>
  <data key="d6"></data>
</node>
<node id="R15">
  <data key="d0">R15</data>
  <data key="d1">data</data>
  <data key="d2">R15 is an evidence reference cited in the guideline for the recommendation to screen individuals with secondary diabetes risk factors.&lt;SEP&gt;R15 is a recommendation to screen for diabetes in individuals with comorbidities such as endocrinopathies, pancreatic diseases, HIV infection, or hepatic steatosis.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3&lt;SEP&gt;chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372029</data>
  <data key="d6"></data>
</node>
<node id="Screening Interval">
  <data key="d0">Screening Interval</data>
  <data key="d1">concept</data>
  <data key="d2">Screening Interval refers to the time period between successive diabetes screening tests as determined by risk assessment.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372029</data>
  <data key="d6"></data>
</node>
<node id="Screening Frequency">
  <data key="d0">Screening Frequency</data>
  <data key="d1">concept</data>
  <data key="d2">Screening Frequency denotes how often DM2 screening should be performed for various patient groups.</data>
  <data key="d3">chunk-c92d117f7109ea1ce6995f23bc680ce3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372029</data>
  <data key="d6"></data>
</node>
<node id="Autoanticorpos">
  <data key="d0">Autoanticorpos</data>
  <data key="d1">concept</data>
  <data key="d2">Autoanticorpos are autoantibodies whose detection can be used to assess risk of type 1 diabetes in first-degree relatives.&lt;SEP&gt;Autoanticorpos are endogenous antibodies measured to aid the clinical diagnosis and classification of diabetes.&lt;SEP&gt;Autoanticorpos are autoantibodies that can confirm the initial clinical diagnosis of diabetes.&lt;SEP&gt;Autoanticorpos are antibodies directed against self‑antigens; their presence confirms the diagnosis of Diabetes Tipo 1.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5&lt;SEP&gt;chunk-2e6267110f4ae5f4df4c49c0653a09b2&lt;SEP&gt;chunk-858cd6ea7fba353827f5ab95be1157ae&lt;SEP&gt;chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786372997</data>
  <data key="d6"></data>
</node>
<node id="Expert Committee on the Diagnosis and Classification of Diabetes Mellitus">
  <data key="d0">Expert Committee on the Diagnosis and Classification of Diabetes Mellitus</data>
  <data key="d1">organization</data>
  <data key="d2">Expert Committee on the Diagnosis and Classification of Diabetes Mellitus produced a report outlining diagnostic criteria for diabetes.&lt;SEP&gt;Expert Committee produced reports on the classification and diagnosis of diabetes mellitus, published in Diabetes Care.\&lt;SEP&gt;The Expert Committee produced a follow‑up report on diabetes diagnosis.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5&lt;SEP&gt;chunk-9ab98b1c07f7bbaa3ad28fb83167f489&lt;SEP&gt;chunk-3a15ed0aa8749d4f76e8d725e8752873</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377389</data>
  <data key="d6"></data>
</node>
<node id="OGTT">
  <data key="d0">OGTT</data>
  <data key="d1">method</data>
  <data key="d2">OGTT (Oral Glucose Tolerance Test) is a diagnostic method used to assess glucose metabolism and diagnose diabetes.&lt;SEP&gt;OGTT is the oral glucose tolerance test, a diagnostic method for glucose metabolism.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5&lt;SEP&gt;chunk-090b8f9281aa75054311d8f275a2c8f8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377267</data>
  <data key="d6"></data>
</node>
<node id="Diabetes‑Specific Retinopathy">
  <data key="d0">Diabetes‑Specific Retinopathy</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes‑specific retinopathy denotes retinal damage directly attributable to diabetes mellitus.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372030</data>
  <data key="d6"></data>
</node>
<node id="R14">
  <data key="d0">R14</data>
  <data key="d1">concept</data>
  <data key="d2">R14 is a recommendation that after initial screening for type 2 diabetes, individuals with a single laboratory criterion should be re-evaluated in 6 months.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372030</data>
  <data key="d6"></data>
</node>
<node id="R16">
  <data key="d0">R16</data>
  <data key="d1">concept</data>
  <data key="d2">R16 is a recommendation to screen for diabetes before and after initiating medications with potential hyperglycemic effects, such as glucocorticoids or antipsychotics.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372030</data>
  <data key="d6"></data>
</node>
<node id="R17">
  <data key="d0">R17</data>
  <data key="d1">concept</data>
  <data key="d2">R17 is a recommendation to screen for type 2 diabetes in children and adolescents aged 10 years or older, or after puberty onset, who have overweight/obesity and at least one risk factor.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372030</data>
  <data key="d6"></data>
</node>
<node id="R18">
  <data key="d0">R18</data>
  <data key="d1">concept</data>
  <data key="d2">R18 is a recommendation to consider autoantibody testing in first-degree relatives of people with type 1 diabetes to reduce ketoacidosis risk and identify candidates for phase‑3 prevention trials.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372030</data>
  <data key="d6"></data>
</node>
<node id="First-Degree Relatives">
  <data key="d0">First-Degree Relatives</data>
  <data key="d1">concept</data>
  <data key="d2">First-Degree Relatives are individuals who share approximately 50% of their genetic material with a person, referenced as a target group for autoantibody testing in type 1 diabetes.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372030</data>
  <data key="d6"></data>
</node>
<node id="Phase 3">
  <data key="d0">Phase 3</data>
  <data key="d1">concept</data>
  <data key="d2">Phase 3 refers to the stage of type 1 diabetes where preventive interventions are evaluated in clinical trials.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372030</data>
  <data key="d6"></data>
</node>
<node id="International Diabetes Federation Position Statement">
  <data key="d0">International Diabetes Federation Position Statement</data>
  <data key="d1">content</data>
  <data key="d2">International Diabetes Federation Position Statement is a document outlining the use of 1‑hour post‑load plasma glucose for diagnosing intermediate hyperglycemia and type 2 diabetes.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="American Diabetes Association Standards of Care">
  <data key="d0">American Diabetes Association Standards of Care</data>
  <data key="d1">content</data>
  <data key="d2">American Diabetes Association Standards of Care is a publication providing guidelines for the diagnosis and classification of diabetes mellitus.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="Expert Committee Report on Diagnosis and Classification of Diabetes Mellitus">
  <data key="d0">Expert Committee Report on Diagnosis and Classification of Diabetes Mellitus</data>
  <data key="d1">content</data>
  <data key="d2">Expert Committee Report on Diagnosis and Classification of Diabetes Mellitus is a report detailing diagnostic criteria and classification for diabetes mellitus.</data>
  <data key="d3">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="GHO">
  <data key="d0">GHO</data>
  <data key="d1">event</data>
  <data key="d2">A prospective study that assessed the relationship between TTGO‑1h glucose concentrations and Type 2 Diabetes Mellitus risk.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="Botnia">
  <data key="d0">Botnia</data>
  <data key="d1">event</data>
  <data key="d2">A prospective study investigating TTGO‑1h glucose thresholds as predictors of Type 2 Diabetes Mellitus.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="Fiorentino">
  <data key="d0">Fiorentino</data>
  <data key="d1">person</data>
  <data key="d2">Researcher who evaluated 392 individuals without diabetes using TTGO‑1h and the euglycemic hyperinsulinemic clamp over a 5‑year follow‑up.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="Euglycemic Hyperinsulinemic Clamp">
  <data key="d0">Euglycemic Hyperinsulinemic Clamp</data>
  <data key="d1">method</data>
  <data key="d2">The gold‑standard technique for measuring insulin sensitivity, employed in Fiorentino’s longitudinal study.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="National Health and Nutrition Examination Survey">
  <data key="d0">National Health and Nutrition Examination Survey</data>
  <data key="d1">data</data>
  <data key="d2">A United States cross‑sectional survey that provided data on numbers needed to screen for diabetes across age groups.&lt;SEP&gt;The National Health and Nutrition Examination Survey supplies population data on A1C diagnostic thresholds.&lt;SEP&gt;A large, ongoing survey that collects health and nutrition data from a representative U.S. population.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d&lt;SEP&gt;chunk-44888abd4ca8a1953f751ed6c41922e6&lt;SEP&gt;chunk-c14456299df06b01b603504def87f381</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377217</data>
  <data key="d6"></data>
</node>
<node id="VIGITEL 2023">
  <data key="d0">VIGITEL 2023</data>
  <data key="d1">data</data>
  <data key="d2">Brazilian surveillance data reporting age‑specific prevalence rates of Diabetes Mellitus in the population.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372031</data>
  <data key="d6"></data>
</node>
<node id="STAND Study">
  <data key="d0">STAND Study</data>
  <data key="d1">event</data>
  <data key="d2">A subanalysis that evaluated prevalence of Type 2 Diabetes Mellitus and Pre‑diabetes using TTGO‑1h and HbA1c measurements in young adults.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="Number Needed to Screen (NNR)">
  <data key="d0">Number Needed to Screen (NNR)</data>
  <data key="d1">concept</data>
  <data key="d2">A metric indicating how many individuals must be screened to identify one case of Diabetes Mellitus, noted as higher in people under 35 years.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="Lifestyle Modification">
  <data key="d0">Lifestyle Modification</data>
  <data key="d1">method</data>
  <data key="d2">Non‑pharmacological interventions such as diet and exercise recommended after diabetes screening.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="Overweight or Obesity">
  <data key="d0">Overweight or Obesity</data>
  <data key="d1">concept</data>
  <data key="d2">A health condition defined by elevated Body Mass Index, identified as a criterion for diabetes screening.&lt;SEP&gt;Body weight condition defined by BMI ≥25 kg/m2 (or ≥23 kg/m2 for Asian American individuals) used as a screening criterion.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d&lt;SEP&gt;chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377324</data>
  <data key="d6"></data>
</node>
<node id="Additional Risk Factor">
  <data key="d0">Additional Risk Factor</data>
  <data key="d1">concept</data>
  <data key="d2">Any extra factor beyond age and BMI that increases the likelihood of developing Type 2 Diabetes Mellitus.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="Age ≥35 Years">
  <data key="d0">Age ≥35 Years</data>
  <data key="d1">concept</data>
  <data key="d2">An age threshold above which screening for Type 2 Diabetes Mellitus is recommended.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="Age &lt;35 Years">
  <data key="d0">Age &lt;35 Years</data>
  <data key="d1">concept</data>
  <data key="d2">An age group younger than 35 years, noted for having a higher Number Needed to Screen.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="Screening for Type 2 Diabetes Mellitus">
  <data key="d0">Screening for Type 2 Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">The process of identifying undiagnosed Type 2 Diabetes Mellitus in asymptomatic individuals, recommended for certain risk groups.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="High FINDRISC Score">
  <data key="d0">High FINDRISC Score</data>
  <data key="d1">concept</data>
  <data key="d2">A classification of FINDRISC results indicating a high or very high risk of developing Type 2 Diabetes Mellitus.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372032</data>
  <data key="d6"></data>
</node>
<node id="Cost of Screening">
  <data key="d0">Cost of Screening</data>
  <data key="d1">concept</data>
  <data key="d2">An economic evaluation comparing the expense of diabetes screening and subsequent interventions with the cost of not screening.</data>
  <data key="d3">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372033</data>
  <data key="d6"></data>
</node>
<node id="Report Of The Expert Committee On The Diagnosis And Classification Of Diabetes">
  <data key="d0">Report Of The Expert Committee On The Diagnosis And Classification Of Diabetes</data>
  <data key="d1">content</data>
  <data key="d2">The Report of the Expert Committee on the Diagnosis and Classification of Diabetes (1997) provides evidence supporting diagnostic cut‑off points for diabetes.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372033</data>
  <data key="d6"></data>
</node>
<node id="Diagnóstico De Diabetes Mellitus">
  <data key="d0">Diagnóstico De Diabetes Mellitus</data>
  <data key="d1">artifact</data>
  <data key="d2">The “Diagnóstico de diabetes mellitus” guideline summarizes recommendations for diagnosing diabetes and pre‑diabetes.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372033</data>
  <data key="d6"></data>
</node>
<node id="Pre‑Diabetes">
  <data key="d0">Pre‑Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Pre‑Diabetes designates individuals with intermediate hyperglycemia who are at risk of progressing to diabetes.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372034</data>
  <data key="d6"></data>
</node>
<node id="Intermediate Hyperglycemia">
  <data key="d0">Intermediate Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Intermediate hyperglycemia refers to mildly elevated glucose levels that do not meet full diabetes criteria.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372034</data>
  <data key="d6"></data>
</node>
<node id="Glicemia Plasmática De Jejum (GJ)">
  <data key="d0">Glicemia Plasmática De Jejum (GJ)</data>
  <data key="d1">method</data>
  <data key="d2">Glicemia Plasmática De Jejum (GJ) is the fasting plasma glucose test used to diagnose diabetes.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372034</data>
  <data key="d6"></data>
</node>
<node id="Teste De Tolerância À Glicose Oral (TTGO)">
  <data key="d0">Teste De Tolerância À Glicose Oral (TTGO)</data>
  <data key="d1">method</data>
  <data key="d2">Teste De Tolerância À Glicose Oral (TTGO) is the oral glucose tolerance test used to diagnose diabetes.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372034</data>
  <data key="d6"></data>
</node>
<node id="TTGO‑1h">
  <data key="d0">TTGO‑1h</data>
  <data key="d1">method</data>
  <data key="d2">TTGO‑1h is the 1‑hour measurement of the oral glucose tolerance test.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372034</data>
  <data key="d6"></data>
</node>
<node id="Fasting Glucose Threshold 126 mg/dL">
  <data key="d0">Fasting Glucose Threshold 126 mg/dL</data>
  <data key="d1">data</data>
  <data key="d2">A fasting glucose level ≥ 126 mg/dL is a diagnostic criterion for Diabetes Mellitus.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372034</data>
  <data key="d6"></data>
</node>
<node id="HbA1c Threshold 6.5 %">
  <data key="d0">HbA1c Threshold 6.5 %</data>
  <data key="d1">data</data>
  <data key="d2">An HbA1c level ≥ 6.5 % is a diagnostic criterion for Diabetes Mellitus.</data>
  <data key="d3">chunk-5e551f4b7f03919afc1d663b3b2a2efa</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
