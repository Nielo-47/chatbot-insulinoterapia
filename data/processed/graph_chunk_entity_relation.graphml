  <data key="d0">Glicose Concentrada Intravenosa</data>
  <data key="d1">method</data>
  <data key="d2">Glicose concentrada intravenosa denotes concentrated glucose given via intravenous route to treat severe hypoglycemia.</data>
  <data key="d3">chunk-6419fb3ef4249d6c7e8d8a45d82efe80</data>
