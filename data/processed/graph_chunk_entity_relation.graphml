<node id="Insulin Discovery">
  <data key="d0">Insulin Discovery</data>
  <data key="d1">event</data>
  <data key="d2">The discovery of insulin in 1921 marked a major breakthrough in diabetes treatment.</data>
  <data key="d3">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
