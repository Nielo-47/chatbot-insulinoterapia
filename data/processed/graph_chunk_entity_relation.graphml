  <data key="d1">concept</data>
  <data key="d2">Genotoxicidade covers the mutagenicity and chromosome‑aberration assessments of insulin glargina.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
