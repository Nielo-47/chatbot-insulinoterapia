  <data key="d0">Glicohemoglobina</data>
  <data key="d1">concept</data>
  <data key="d2">Glicohemoglobina is glycated hemoglobin, identified as a risk factor for nocturnal hypoglycemia.</data>
  <data key="d3">chunk-6f645bd7019e94151caaff47d6cbfcaf</data>
