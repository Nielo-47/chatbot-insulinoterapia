  <data key="d13"></data>
</edge>
<edge source="Pump" target="Alert Before Low">
  <data key="d7">2.0</data>
  <data key="d8">Alert Before Low generates a notification on the pump before sensor glucose falls below the low limit.&lt;SEP&gt;Alert Before Low is a selectable feature on the Pump that provides a pre‑low alert.</data>
  <data key="d9">alert,feature,notification,selection</data>
