  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Body">
  <data key="d7">2.0</data>
  <data key="d8">The infusion set must be confirmed disconnected from the body before loading the reservoir.&lt;SEP&gt;The infusion set is inserted into the body at a chosen insertion site.</data>
