</edge>
<edge source="Hypoglycemia" target="Insulina Lispro">
  <data key="d7">1.0</data>
  <data key="d8">Therapeutic doses of insulin can cause hypoglycemia, which may impair concentration and reaction time.</data>
  <data key="d9">adverse effect,risk</data>
  <data key="d10">chunk-4319d08c10ed2b48857a6d42eadd9db0</data>
