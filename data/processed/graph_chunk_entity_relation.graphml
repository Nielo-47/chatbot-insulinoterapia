  <data key="d0">MODY Probability Calculator</data>
  <data key="d1">artifact</data>
  <data key="d2">Prediction model that estimates the probability of MODY based on clinical and laboratory variables, with a discriminative cut‑off of 50 % in European cohorts and suggested 60 % for Brazilian populations.&lt;SEP&gt;A calculator for estimating MODY probability in GCK and HNF1A screening within a multi‑ethnic population.&lt;SEP&gt;MODY Probability Calculator is an online tool for estimating the likelihood of MODY.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624&lt;SEP&gt;chunk-cc432bf15c11ef31f7aff87b534b5eaf&lt;SEP&gt;chunk-355eedbe74750d3739f7257279494c9a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377233</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Diagnostics">
  <data key="d0">Diabetes Diagnostics</data>
  <data key="d1">artifact</data>
  <data key="d2">Mobile iOS/Android application that hosts the MODY Probability Calculator for risk assessment.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373033</data>
  <data key="d6"></data>
</node>
<node id="MODY‑GCK">
  <data key="d0">MODY‑GCK</data>
  <data key="d1">concept</data>
  <data key="d2">MODY subtype caused by GCK mutations, characterized by mild, asymptomatic fasting hyperglycemia, non‑progressive course, and often no known family history.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373033</data>
  <data key="d6"></data>
</node>
<node id="MODY‑HNF1A">
  <data key="d0">MODY‑HNF1A</data>
  <data key="d1">concept</data>
  <data key="d2">MODY subtype caused by HNF1A mutations, typically showing good long‑term response to sulfonylureas.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373033</data>
  <data key="d6"></data>
</node>
<node id="MODY‑HNF4A">
  <data key="d0">MODY‑HNF4A</data>
  <data key="d1">concept</data>
  <data key="d2">MODY subtype caused by HNF4A mutations, similarly responding well to sulfonylureas.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373034</data>
  <data key="d6"></data>
</node>
<node id="MODY‑HNF1B">
  <data key="d0">MODY‑HNF1B</data>
  <data key="d1">concept</data>
  <data key="d2">MODY subtype caused by HNF1B mutations, frequently associated with urogenital malformations and absent family history in about 50 % of cases.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373034</data>
  <data key="d6"></data>
</node>
<node id="C‑peptide">
  <data key="d0">C‑peptide</data>
  <data key="d1">data</data>
  <data key="d2">Laboratory measurement of C‑peptide; values above 0.6 ng/ml after five years support a MODY diagnosis.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373034</data>
  <data key="d6"></data>
</node>
<node id="Triglycerides">
  <data key="d0">Triglycerides</data>
  <data key="d1">data</data>
  <data key="d2">Serum triglyceride concentration; levels below 98 mg/dl are required for LADA suspicion.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373034</data>
  <data key="d6"></data>
</node>
<node id="Genetic Test">
  <data key="d0">Genetic Test</data>
  <data key="d1">method</data>
  <data key="d2">Laboratory procedure that analyzes a panel of genes to identify mutations responsible for MODY.&lt;SEP&gt;Genetic Test refers to the recommended genetic analysis to diagnose specific diabetes‑related syndromes.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624&lt;SEP&gt;chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373034</data>
  <data key="d6"></data>
</node>
<node id="Gene Panel">
  <data key="d0">Gene Panel</data>
  <data key="d1">method</data>
  <data key="d2">Targeted set of MODY‑related genes used in genetic testing.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373035</data>
  <data key="d6"></data>
</node>
<node id="Sanger Sequencing">
  <data key="d0">Sanger Sequencing</data>
  <data key="d1">method</data>
  <data key="d2">Sequencing technique employed for specific GCK mutation analysis in suspected MODY‑GCK cases.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373035</data>
  <data key="d6"></data>
</node>
<node id="Acute Symptoms">
  <data key="d0">Acute Symptoms</data>
  <data key="d1">concept</data>
  <data key="d2">Acute symptoms are a clinical feature listed as one of the five criteria to suspect LADA.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373035</data>
  <data key="d6"></data>
</node>
<node id="LADA Sensitivity">
  <data key="d0">LADA Sensitivity</data>
  <data key="d1">data</data>
  <data key="d2">Diagnostic sensitivity of 90% for LADA identification when at least two criteria are present.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373035</data>
  <data key="d6"></data>
</node>
<node id="LADA Specificity">
  <data key="d0">LADA Specificity</data>
  <data key="d1">data</data>
  <data key="d2">Diagnostic specificity of 71% for LADA identification when at least two criteria are present.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373036</data>
  <data key="d6"></data>
</node>
<node id="MODY Probability Cut‑off 50%">
  <data key="d0">MODY Probability Cut‑off 50%</data>
  <data key="d1">data</data>
  <data key="d2">Discriminative probability threshold of 50% used by the MODY Probability Calculator to differentiate MODY from type 1 and type 2 diabetes.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373036</data>
  <data key="d6"></data>
</node>
<node id="European Caucasian Population">
  <data key="d0">European Caucasian Population</data>
  <data key="d1">concept</data>
  <data key="d2">Population of individuals of European Caucasian ancestry used as the validation cohort for the MODY Probability Calculator.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373036</data>
  <data key="d6"></data>
</node>
<node id="MODY Probability Cut‑off 60%">
  <data key="d0">MODY Probability Cut‑off 60%</data>
  <data key="d1">data</data>
  <data key="d2">Suggested probability threshold of 60% for indicating MODY genetic testing in Brazilian studies.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373036</data>
  <data key="d6"></data>
</node>
<node id="Positive Predictive Value &gt;60%">
  <data key="d0">Positive Predictive Value &gt;60%</data>
  <data key="d1">data</data>
  <data key="d2">Positive predictive value exceeding 60% is recommended as a criterion to refer patients for MODY genetic testing.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373037</data>
  <data key="d6"></data>
</node>
<node id="MODY Calculator URL">
  <data key="d0">MODY Calculator URL</data>
  <data key="d1">artifact</data>
  <data key="d2">Web address https://www.diabetesgenes.org/exeter-diabetes-app/ModyCalculator that hosts the MODY Probability Calculator.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373037</data>
  <data key="d6"></data>
</node>
<node id="Urogenital Malformations">
  <data key="d0">Urogenital Malformations</data>
  <data key="d1">concept</data>
  <data key="d2">Congenital abnormalities of the urinary and genital tracts frequently observed in patients with MODY‑HNF1B.&lt;SEP&gt;Urogenital Malformations are developmental anomalies of the urinary and genital tracts associated with MODY-HNF1B.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624&lt;SEP&gt;chunk-e26b32d53b78f97e8d7fa8b815f2cc87</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373038</data>
  <data key="d6"></data>
</node>
<node id="De Novo Mutation Rate 7.3%">
  <data key="d0">De Novo Mutation Rate 7.3%</data>
  <data key="d1">data</data>
  <data key="d2">Proportion (7.3%) of MODY cases that arise from de novo genetic mutations.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373038</data>
  <data key="d6"></data>
</node>
<node id="Adult Autoimmune Diabetes">
  <data key="d0">Adult Autoimmune Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Form of autoimmune diabetes occurring in adults, commonly referred to as LADA.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373038</data>
  <data key="d6"></data>
</node>
<node id="Family History of Autoimmunity">
  <data key="d0">Family History of Autoimmunity</data>
  <data key="d1">concept</data>
  <data key="d2">Presence of autoimmune disease in family members, listed as one of the five criteria for suspecting LADA.</data>
  <data key="d3">chunk-299bcef3259f8ab6bc70544e12616624</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373038</data>
  <data key="d6"></data>
</node>
<node id="KCNJ11">
  <data key="d0">KCNJ11</data>
  <data key="d1">concept</data>
  <data key="d2">KCNJ11 gene associated with neonatal diabetes mellitus.&lt;SEP&gt;KCNJ11 encodes a potassium channel subunit; its mutations are involved in MODY-KCNJ11 and neonatal diabetes.&lt;SEP&gt;KCNJ11 mutations cause neonatal diabetes that may be permanent or transient and are responsive to sulfonylureas.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8&lt;SEP&gt;chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377237</data>
  <data key="d6"></data>
</node>
<node id="INS">
  <data key="d0">INS</data>
  <data key="d1">concept</data>
  <data key="d2">INS gene associated with neonatal diabetes mellitus.&lt;SEP&gt;INS is the insulin gene whose mutations can cause neonatal diabetes and some MODY forms.&lt;SEP&gt;INS mutations cause permanent neonatal diabetes often accompanied by intrauterine growth restriction and insulin requirement.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8&lt;SEP&gt;chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377237</data>
  <data key="d6"></data>
</node>
<node id="HNF1B">
  <data key="d0">HNF1B</data>
  <data key="d1">concept</data>
  <data key="d2">HNF1B gene linked to forms of diabetes.&lt;SEP&gt;HNF1B is the hepatocyte nuclear factor 1‑beta gene implicated in MODY-HNF1B and neonatal diabetes.&lt;SEP&gt;HNF1B mutations are associated with renal cysts and diabetes (RCAD) syndrome.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8&lt;SEP&gt;chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-0bdb8ef335f3531317a3a5bd7de3a561</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377367</data>
  <data key="d6"></data>
</node>
<node id="ABCC">
  <data key="d0">ABCC</data>
  <data key="d1">concept</data>
  <data key="d2">ABCC gene implicated in neonatal diabetes mellitus.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373039</data>
  <data key="d6"></data>
</node>
<node id="GCK">
  <data key="d0">GCK</data>
  <data key="d1">concept</data>
  <data key="d2">GCK gene whose homozygous mutations cause Wolcott‑Rallison syndrome.&lt;SEP&gt;GCK is the glucokinase gene whose mutations cause the MODY-GCK subtype.&lt;SEP&gt;A gene implicated in MODY.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8&lt;SEP&gt;chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-cc432bf15c11ef31f7aff87b534b5eaf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373039</data>
  <data key="d6"></data>
</node>
<node id="EIF2AK3">
  <data key="d0">EIF2AK3</data>
  <data key="d1">concept</data>
  <data key="d2">EIF2AK3 gene encoding eukaryotic translation initiation factor 2 alpha kinase 3; mutations cause Wolcott‑Rallison syndrome.&lt;SEP&gt;EIF2AK3 is a gene whose homozygous mutations, especially in consanguineous families, lead to Wolcott‑Rallison syndrome.&lt;SEP&gt;EIF2AK3 mutations cause Wolcott‑Rallison syndrome, featuring epiphyseal dysplasia and pancreatic exocrine insufficiency.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8&lt;SEP&gt;chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377238</data>
  <data key="d6"></data>
</node>
<node id="FOXP3">
  <data key="d0">FOXP3</data>
  <data key="d1">concept</data>
  <data key="d2">FOXP3 gene associated with autoimmunity in neonatal diabetes mellitus.&lt;SEP&gt;FOXP3 mutations cause IPEX syndrome, an X‑linked disorder with autoimmune diabetes and other autoimmune manifestations.&lt;SEP&gt;FOXP3 is a gene implicated in X-linked immunodysregulation, polyendocrinopathy, and enteropathy (IPEX) syndrome.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587&lt;SEP&gt;chunk-090b8f9281aa75054311d8f275a2c8f8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377238</data>
  <data key="d6"></data>
</node>
<node id="STAT3">
  <data key="d0">STAT3</data>
  <data key="d1">concept</data>
  <data key="d2">STAT3 gene associated with autoimmunity in neonatal diabetes mellitus.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373040</data>
  <data key="d6"></data>
</node>
<node id="LBRA">
  <data key="d0">LBRA</data>
  <data key="d1">concept</data>
  <data key="d2">LBRA gene (lipopolysaccharide‑responsive and beige‑like anchor protein) linked to autoimmunity in neonatal diabetes mellitus.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373040</data>
  <data key="d6"></data>
</node>
<node id="Wolcott‑Rallison syndrome">
  <data key="d0">Wolcott‑Rallison syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Syndrome caused by homozygous GCK and EIF2AK3 mutations, included in diabetes classification.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373040</data>
  <data key="d6"></data>
</node>
<node id="Wolfram syndrome">
  <data key="d0">Wolfram syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Autosomal recessive syndrome characterized by diabetes mellitus, optic atrophy, neurosensory deafness, and diabetes insipidus, usually due to WFS1 mutations.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373040</data>
  <data key="d6"></data>
</node>
<node id="WFS1">
  <data key="d0">WFS1</data>
  <data key="d1">concept</data>
  <data key="d2">Gene whose mutations cause Wolfram syndrome in about 90 % of cases.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373040</data>
  <data key="d6"></data>
</node>
<node id="Neonatal diabetes mellitus">
  <data key="d0">Neonatal diabetes mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">Form of diabetes manifesting in newborns, linked to genes INS, KCNJ11, ABCC and autoimmunity markers.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373041</data>
  <data key="d6"></data>
</node>
<node id="Diabetes type 1">
  <data key="d0">Diabetes type 1</data>
  <data key="d1">concept</data>
  <data key="d2">Autoimmune diabetes typically presenting in youth and identified by autoantibodies.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373041</data>
  <data key="d6"></data>
</node>
<node id="Diabetes type 2">
  <data key="d0">Diabetes type 2</data>
  <data key="d1">concept</data>
  <data key="d2">Non‑autoimmune diabetes often associated with insulin resistance and obesity.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373041</data>
  <data key="d6"></data>
</node>
<node id="Mitochondrial diabetes">
  <data key="d0">Mitochondrial diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Rare form of diabetes (&lt;1 %) caused by mitochondrial DNA mutation m.3243 A&gt;G, frequently associated with maternal inheritance, hearing loss, and ophthalmoplegia.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373042</data>
  <data key="d6"></data>
</node>
<node id="m.3243 A&gt;G">
  <data key="d0">m.3243 A&gt;G</data>
  <data key="d1">data</data>
  <data key="d2">Mitochondrial DNA point mutation associated with mitochondrial diabetes and complications such as lactic acidosis, encephalopathy, and miopathy.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373042</data>
  <data key="d6"></data>
</node>
<node id="Diabetes insipidus">
  <data key="d0">Diabetes insipidus</data>
  <data key="d1">concept</data>
  <data key="d2">Disorder of water balance that can co‑occur with Wolfram syndrome.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373042</data>
  <data key="d6"></data>
</node>
<node id="Optic atrophy">
  <data key="d0">Optic atrophy</data>
  <data key="d1">concept</data>
  <data key="d2">Progressive loss of vision, a key clinical feature of Wolfram syndrome.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373042</data>
  <data key="d6"></data>
</node>
<node id="Neurosensory deafness">
  <data key="d0">Neurosensory deafness</data>
  <data key="d1">concept</data>
  <data key="d2">Hearing loss associated with Wolfram syndrome and mitochondrial diabetes.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373042</data>
  <data key="d6"></data>
</node>
<node id="Ophthalmoplegia">
  <data key="d0">Ophthalmoplegia</data>
  <data key="d1">concept</data>
  <data key="d2">Progressive paralysis of eye muscles linked to mitochondrial diabetes.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373042</data>
  <data key="d6"></data>
</node>
<node id="Miopathy">
  <data key="d0">Miopathy</data>
  <data key="d1">concept</data>
  <data key="d2">Muscle disease that may accompany severe mitochondrial diabetes.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373043</data>
  <data key="d6"></data>
</node>
<node id="Encephalopathy">
  <data key="d0">Encephalopathy</data>
  <data key="d1">concept</data>
  <data key="d2">Brain dysfunction that may accompany severe mitochondrial diabetes.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373043</data>
  <data key="d6"></data>
</node>
<node id="Lactic acidosis">
  <data key="d0">Lactic acidosis</data>
  <data key="d1">concept</data>
  <data key="d2">Metabolic complication associated with mitochondrial diabetes, especially when treated with metformin.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373043</data>
  <data key="d6"></data>
</node>
<node id="Genetic test">
  <data key="d0">Genetic test</data>
  <data key="d1">method</data>
  <data key="d2">Molecular diagnostic procedure recommended for confirming Wolfram syndrome, mitochondrial diabetes, and neonatal diabetes.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373043</data>
  <data key="d6"></data>
</node>
<node id="Peptide C dosage">
  <data key="d0">Peptide C dosage</data>
  <data key="d1">method</data>
  <data key="d2">Measurement of C‑peptide used to differentiate diabetes types, particularly in ketosis‑prone diabetes.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373044</data>
  <data key="d6"></data>
</node>
<node id="Autoantibody measurement">
  <data key="d0">Autoantibody measurement</data>
  <data key="d1">method</data>
  <data key="d2">Testing for diabetes‑related autoantibodies to aid classification of diabetes forms.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373044</data>
  <data key="d6"></data>
</node>
<node id="Ketosis‑prone diabetes">
  <data key="d0">Ketosis‑prone diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Subtype of diabetes type 2 characterized by diabetic ketoacidosis at onset with later insulin independence.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373044</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Classification Guideline">
  <data key="d0">Diabetes Classification Guideline</data>
  <data key="d1">content</data>
  <data key="d2">Guideline issued by Sociedade Brasileira de Diabetes for classifying diabetes types and recommending diagnostic tests.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373044</data>
  <data key="d6"></data>
</node>
<node id="DMN">
  <data key="d0">DMN</data>
  <data key="d1">concept</data>
  <data key="d2">DMN is an abbreviation used in the text for neonatal diabetes mellitus.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373044</data>
  <data key="d6"></data>
</node>
<node id="SW">
  <data key="d0">SW</data>
  <data key="d1">concept</data>
  <data key="d2">SW is an abbreviation used in the text for Wolfram syndrome.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373045</data>
  <data key="d6"></data>
</node>
<node id="Mitochondrial DNA">
  <data key="d0">Mitochondrial DNA</data>
  <data key="d1">data</data>
  <data key="d2">Mitochondrial DNA is the genetic material in mitochondria referenced in relation to the m.3243 A&gt;G mutation.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373045</data>
  <data key="d6"></data>
</node>
<node id="Diabetic ketoacidosis">
  <data key="d0">Diabetic ketoacidosis</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetic ketoacidosis is a severe metabolic complication mentioned as occurring in both type 1 and type 2 diabetes and in ketosis‑prone diabetes.</data>
  <data key="d3">chunk-e007fc346ea9f699fecdba467cc5eac8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373045</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Insipidus">
  <data key="d0">Diabetes Insipidus</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Insipidus is a disorder of water balance that can be associated with Wolfram syndrome.&lt;SEP&gt;Diabetes Insipidus is a condition that may be associated with early‑onset diabetes mellitus.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51&lt;SEP&gt;chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373045</data>
  <data key="d6"></data>
</node>
<node id="Optic Atrophy">
  <data key="d0">Optic Atrophy</data>
  <data key="d1">concept</data>
  <data key="d2">Optic Atrophy is a visual impairment condition linked to early‑onset diabetes mellitus.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373045</data>
  <data key="d6"></data>
</node>
<node id="Hearing Loss">
  <data key="d0">Hearing Loss</data>
  <data key="d1">concept</data>
  <data key="d2">Hearing Loss is an auditory condition associated with early‑onset diabetes mellitus and mitochondrial diabetes.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373046</data>
  <data key="d6"></data>
</node>
<node id="Mitochondrial Diabetes">
  <data key="d0">Mitochondrial Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Mitochondrial Diabetes is a subtype of diabetes diagnosed via genetic testing, often linked with hearing loss or ophthalmoplegia.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373046</data>
  <data key="d6"></data>
</node>
<node id="Progressive External Ophthalmoplegia">
  <data key="d0">Progressive External Ophthalmoplegia</data>
  <data key="d1">concept</data>
  <data key="d2">Progressive External Ophthalmoplegia is a muscle disorder of the eyes associated with mitochondrial diabetes.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373046</data>
  <data key="d6"></data>
</node>
<node id="Pancreatic Diseases">
  <data key="d0">Pancreatic Diseases</data>
  <data key="d1">concept</data>
  <data key="d2">Pancreatic Diseases are other pancreatic conditions that can lead to secondary diabetes.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373047</data>
  <data key="d6"></data>
</node>
<node id="Thigh Skinfold Measurement">
  <data key="d0">Thigh Skinfold Measurement</data>
  <data key="d1">artifact</data>
  <data key="d2">Thigh Skinfold Measurement is a clinical metric (&lt;22 mm women, &lt;10 mm men) suggesting lipodystrophy.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
