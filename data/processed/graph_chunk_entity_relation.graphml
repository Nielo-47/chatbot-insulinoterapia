</node>
<node id="Infusion De Insulina">
  <data key="d0">Infusion De Insulina</data>
  <data key="d1">method</data>
  <data key="d2">Infusion De Insulina is the process by which the pump delivers insulin in small, continuous amounts or larger bolus doses.</data>
  <data key="d3">chunk-63644bff2af5cc96a50e636bff8e339b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
