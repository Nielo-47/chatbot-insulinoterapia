  <data key="d8">Insulin exposed near a stove can lose its effectiveness because of heat.</data>
  <data key="d9">efficacy loss,heat exposure</data>
  <data key="d10">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
  <data key="d11">data/raw/Documento sem título.docx</data>
  <data key="d12">1786297952</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Sun">
  <data key="d7">3.0</data>
  <data key="d8">Insulin exposed to direct sunlight may lose its effect due to heat.&lt;SEP&gt;Open insulin should be kept away from the sun.&lt;SEP&gt;Open insulin should be kept in a cool place away from the sun for up to 30 days.</data>
  <data key="d9">efficacy loss,heat exposure,light,light exposure,storage</data>
  <data key="d10">chunk-022aabbd0c94aa681dcd00c49d072b46&lt;SEP&gt;chunk-2a0a3f492aa5ef7771b2246547cb5f02&lt;SEP&gt;chunk-e94cedc7134adbb256c931b851235c53</data>
  <data key="d11">data/raw/Documento sem título.docx&lt;SEP&gt;data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Documento sem título.docx</data>
  <data key="d12">1786330507</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Thermal Bag">
  <data key="d7">3.0</data>
  <data key="d8">Insulin can be carried to work using a thermal bag to keep it cool.&lt;SEP&gt;Insulin can be transported in a thermal bag following manufacturer guidelines.&lt;SEP&gt;Insulin can be placed in a thermal bag during travel to maintain temperature.</data>
  <data key="d9">container,temperature maintenance,transport,transport container</data>
  <data key="d10">chunk-022aabbd0c94aa681dcd00c49d072b46&lt;SEP&gt;chunk-03a1de93a53fbcb513268c123e2c5a16&lt;SEP&gt;chunk-8336dc27990f6189c99863d64435c6c6</data>
