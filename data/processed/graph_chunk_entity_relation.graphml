</node>
<node id="AACE/ACE">
  <data key="d0">AACE/ACE</data>
  <data key="d1">organization</data>
  <data key="d2">The American Association of Clinical Endocrinologists/American College of Endocrinology presents indications for using SICI similar to those of SBD.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
