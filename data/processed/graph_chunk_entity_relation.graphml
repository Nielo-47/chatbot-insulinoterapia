<node id="Venda Sob Prescrição">
  <data key="d0">Venda Sob Prescrição</data>
  <data key="d1">concept</data>
  <data key="d2">Venda Sob Prescrição states that the KWIKPEN is sold only with a prescription.</data>
  <data key="d3">chunk-b4916e2524690f1ce85df7c187f6d7a7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
