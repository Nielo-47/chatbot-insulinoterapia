</node>
<node id="Sensor-Augmented Insulin Pump Therapy">
  <data key="d0">Sensor-Augmented Insulin Pump Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Sensor-augmented insulin pump therapy combines insulin pump delivery with continuous glucose monitoring to improve glycemic control.</data>
  <data key="d3">chunk-eab57247c382bad8d5f1e5eb84a62e24</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1778702616</data>
  <data key="d6"></data>
</node>
<node id="Automated Insulin Suspension">
  <data key="d0">Automated Insulin Suspension</data>
  <data key="d1">method</data>
  <data key="d2">Automated insulin suspension is a feature in advanced insulin pump systems that stops insulin delivery when glucose levels drop to prevent hypoglycemia.</data>
  <data key="d3">chunk-eab57247c382bad8d5f1e5eb84a62e24</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
