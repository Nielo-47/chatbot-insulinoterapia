  <data key="d14"></data>
</edge>
<edge source="Insulina Regular" target="Caneta Reutilizável">
  <data key="d8">1.0</data>
  <data key="d9">A caneta reutilizável é utilizada para administrar insulina Regular aos pacientes com diabetes.</data>
  <data key="d10">device use,medication administration</data>
