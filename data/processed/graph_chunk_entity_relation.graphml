<node id="Belgian PREDICTIVE Cohort">
  <data key="d0">Belgian PREDICTIVE Cohort</data>
  <data key="d1">data</data>
  <data key="d2">The Belgian PREDICTIVE Cohort is a patient cohort used in a 26‑week follow‑up study of insulin detemir.&lt;SEP&gt;The Belgian PREDICTIVE Cohort is a research cohort used to assess routine clinical practice of insulin detemir.</data>
  <data key="d3">chunk-e5f5165b3185feb3c6ec93a3c0ef8d02&lt;SEP&gt;chunk-b4d7abd3e1e5418ee5a931e28a18e8ad</data>
