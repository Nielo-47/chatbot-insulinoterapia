  <data key="d13">1778696092</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina" target="Insulina de Ação Rápida">
  <data key="d8">1.0</data>
  <data key="d9">A insulina de ação rápida é um tipo de insulina usada antes das refeições para controle imediato da glicemia.</data>
  <data key="d10">classificação,tipo de insulina</data>
  <data key="d11">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
  <data key="d12">data/raw/Documento sem título.docx</data>
  <data key="d13">1778694985</data>
