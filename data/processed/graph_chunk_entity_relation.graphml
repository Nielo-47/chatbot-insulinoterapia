  <data key="d0">Hypoglycemia Incidence</data>
  <data key="d1">data</data>
  <data key="d2">Incidence and rate of hypoglycemia are data points analyzed for correlation with antibody production.</data>
  <data key="d3">chunk-22df77f7bf817d736d90608e62a11d84</data>
