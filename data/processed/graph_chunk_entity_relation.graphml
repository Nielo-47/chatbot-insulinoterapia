  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G Insulin Pump" target="Delivery Settings">
  <data key="d8">1.0</data>
  <data key="d9">Delivery settings on the MiniMed 780G insulin pump determine how insulin is delivered and must be reviewed with a healthcare professional.</data>
  <data key="d10">configuration,therapy customization</data>
