</edge>
<edge source="Cetoacidose Diabética" target="Insulina Intravenosa De Curta Duração">
  <data key="d7">1.0</data>
  <data key="d8">Short‑acting intravenous insulin is the preferred treatment for diabetic ketoacidosis, whereas BASAGLAR KWIKPEN is not.</data>
  <data key="d9">contraindication,preferred therapy</data>
  <data key="d10">chunk-2db4ee43ed7cc39546184320e1328d06</data>
