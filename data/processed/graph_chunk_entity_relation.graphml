  <data key="d0">Glargine U100</data>
  <data key="d1">artifact</data>
  <data key="d2">Glargine U100 is a long‑acting insulin analog produced by recombinant DNA technology.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1786331419</data>
  <data key="d6"></data>
</node>
<node id="Long-Acting Insulin Analogs">
  <data key="d0">Long-Acting Insulin Analogs</data>
  <data key="d1">artifact</data>
  <data key="d2">Long‑Acting Insulin Analogs are insulin formulations such as glargine and detemir that provide stable basal coverage.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
