  <data key="d13">1778708060</data>
  <data key="d14"></data>
</edge>
<edge source="Sensor" target="Simplera Sync Guardian 4">
  <data key="d8">1.0</data>
  <data key="d9">The sensor is a key component of the Simplera Sync Guardian 4 CGM system used for glucose monitoring.</data>
  <data key="d10">CGM system,device component</data>
  <data key="d11">chunk-cfb8f4a2fd599a5ec7cbad8c356a6ed4</data>
