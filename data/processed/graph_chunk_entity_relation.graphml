</edge>
<edge source="Fats" target="Glucose Absorption">
  <data key="d8">1.0</data>
  <data key="d9">Fats delay digestion and slow the movement of glucose into the bloodstream, affecting timing of glucose rise.</data>
  <data key="d10">digestion delay,metabolic effect</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703173</data>
  <data key="d14"></data>
</edge>
<edge source="Fats" target="Proteins">
  <data key="d8">1.0</data>
  <data key="d9">Fats and proteins together in meals delay digestion and require special consideration for insulin dosing.</data>
  <data key="d10">digestion,nutrient combination</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703175</data>
  <data key="d14"></data>
</edge>
<edge source="Proteins" target="Glucose Absorption">
  <data key="d8">1.0</data>
  <data key="d9">Proteins, like fats, can independently affect glucose levels and contribute to delayed glucose absorption.</data>
  <data key="d10">delayed absorption,metabolic effect</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703174</data>
  <data key="d14"></data>
</edge>
<edge source="Glucose Absorption" target="Insulin Action">
  <data key="d8">1.0</data>
  <data key="d9">Proper glucose control requires alignment between insulin action and carbohydrate absorption.</data>
  <data key="d10">metabolic coordination,timing alignment</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703178</data>
  <data key="d14"></data>
</edge>
<edge source="Glucosa Actual" target="Glucosa Objetivo">
  <data key="d8">1.0</data>
  <data key="d9">Glucosa Actual is compared to Glucosa Objetivo to determine how far current blood glucose is from the target level.</data>
  <data key="d10">blood glucose comparison,target deviation</data>
  <data key="d11">chunk-ec2fea6c095d8e93483ff43ef875fb9b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
