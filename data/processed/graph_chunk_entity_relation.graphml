  <data key="d0">Assistance from Another Person</data>
  <data key="d1">concept</data>
  <data key="d2">Assistance from another person refers to the help provided to visually impaired patients for operating the insulin pen.</data>
  <data key="d3">chunk-3397508bdfddde019cb1dfdcfb352435</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
