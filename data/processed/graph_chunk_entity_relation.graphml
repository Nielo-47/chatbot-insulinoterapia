</edge>
<edge source="Insulina Humana" target="Insulina Bovina">
  <data key="d8">1.0</data>
  <data key="d9">Insulina Humana Biossintética is a safe alternative to Insulina Bovina, with comparable glycemic control and insulin requirements.</data>
  <data key="d10">comparative efficacy,therapeutic alternative</data>
  <data key="d11">chunk-67bb351395e7176e28675caef7c9b6f0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
