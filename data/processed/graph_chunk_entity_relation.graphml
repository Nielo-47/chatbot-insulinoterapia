  <data key="d5">1786318548</data>
  <data key="d6"></data>
</node>
<node id="Gordura">
  <data key="d0">Gordura</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gordura is the subcutaneous fat layer influencing whether a skin fold or straight injection technique is used.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
  <data key="d5">1786297929</data>
  <data key="d6"></data>
</node>
<node id="Pele">
  <data key="d0">Pele</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pele is the skin surface where insulin must be injected directly after cleaning.&lt;SEP&gt;The skin at the injection site, which should be clean and dry before insulin administration.&lt;SEP&gt;The skin, the surface where the subcutaneous fold and needle insertion are performed.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792&lt;SEP&gt;chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-2df359ca3783191b2159f8d3f6ea6c52</data>
