<node id="Glicemia Em Jejum">
  <data key="d0">Glicemia Em Jejum</data>
  <data key="d1">data</data>
  <data key="d2">Glicemia em Jejum is fasting blood glucose, which was higher during treatment with biosynthetic human insulin compared to animal insulins.</data>
  <data key="d3">chunk-67bb351395e7176e28675caef7c9b6f0</data>
