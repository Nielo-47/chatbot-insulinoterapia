  <data key="d6"></data>
</node>
<node id="Pila Aa Recargable">
  <data key="d0">Pila Aa Recargable</data>
  <data key="d1">artifact</data>
  <data key="d2">A rechargeable AA battery is a variant that can be used to power the insulin pump.</data>
  <data key="d3">chunk-cf725cb54eea97f946e1f27eae125a0b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
