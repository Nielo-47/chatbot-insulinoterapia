</edge>
<edge source="Prescription" target="Abbreviation &quot;UI&quot;">
  <data key="d7">1.0</data>
  <data key="d8">Prescription may contain the abbreviation "UI", which can be misinterpreted and cause dosing errors.</data>
  <data key="d9">contains,risk</data>
