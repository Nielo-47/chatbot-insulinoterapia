  <data key="d1">organization</data>
  <data key="d2">Eli Lilly Itália S.p.A. is a manufacturing entity located in Sesto Fiorentino, Italy that produces the KWIKPEN.</data>
  <data key="d3">chunk-b4916e2524690f1ce85df7c187f6d7a7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
