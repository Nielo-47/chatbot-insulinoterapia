  <data key="d13"></data>
</edge>
<edge source="APIDRA SOLOSTAR" target="Oral Hypoglycemic Agents">
  <data key="d7">1.0</data>
  <data key="d8">Oral hypoglycemic agents can intensify the hypoglycemic effect of APIDRA SOLOSTAR.</data>
  <data key="d9">interaction,potentiation</data>
  <data key="d10">chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
