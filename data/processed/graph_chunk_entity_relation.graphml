  <data key="d5">1786337566</data>
  <data key="d6"></data>
</node>
<node id="Planilha">
  <data key="d0">Planilha</data>
  <data key="d1">artifact</data>
  <data key="d2">Planilha is a spreadsheet tool used to log and analyze glucose measurements and related data.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1786337566</data>
  <data key="d6"></data>
</node>
<node id="Softwares em Nuvem">
  <data key="d0">Softwares em Nuvem</data>
  <data key="d1">artifact</data>
  <data key="d2">Softwares em nuvem are cloud‑based programs that enable patients and health professionals to share and access glucose data remotely.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1786337566</data>
  <data key="d6"></data>
</node>
<node id="Programas Informatizados">
  <data key="d0">Programas Informatizados</data>
  <data key="d1">artifact</data>
  <data key="d2">Programas informatizados are software applications that facilitate the electronic recording and retrieval of glucose measurements.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1786337567</data>
  <data key="d6"></data>
</node>
