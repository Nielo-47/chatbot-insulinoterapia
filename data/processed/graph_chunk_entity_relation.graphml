</edge>
<edge source="Levemir® FlexPen®" target="Registro MS">
  <data key="d8">1.0</data>
  <data key="d9">Levemir® FlexPen® is registered under the Ministry of Health registration number 1.1766.0019.</data>
  <data key="d10">product registration,regulatory approval</data>
  <data key="d11">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
