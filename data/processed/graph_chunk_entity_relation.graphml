</edge>
<edge source="Sensor Failed To Pair" target="Cgm Device">
  <data key="d8">1.0</data>
  <data key="d9">The CGM device generates a Sensor Failed To Pair alert when it cannot establish a connection with the sensor.</data>
  <data key="d10">device communication,pairing failure</data>
  <data key="d11">chunk-2e33e0df4fbd9e2d7b9a22d11de9476c</data>
