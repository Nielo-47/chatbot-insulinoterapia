  <data key="d12">1786336041</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Insulin Pump Therapy">
  <data key="d7">5.0</data>
  <data key="d8">Insulin pump therapy utilizes the insulin pump to provide basal and bolus insulin delivery.&lt;SEP&gt;Insulin pump therapy utilizes an insulin pump to deliver insulin.&lt;SEP&gt;Insulin Pump is the device employed in Insulin Pump Therapy.&lt;SEP&gt;The insulin pump is the device that enables insulin pump therapy.&lt;SEP&gt;Insulin pump therapy utilizes an insulin pump to deliver insulin.</data>
  <data key="d9">application,device,device usage,enables,method,treatment,treatment method</data>
  <data key="d10">chunk-7ed0b3e64751c1a28d72e087f711cc20&lt;SEP&gt;chunk-b7715667f5fca178f0988984e932ecfb&lt;SEP&gt;chunk-4b9f6a4a440ccb40e47c326ca6dd9346&lt;SEP&gt;chunk-59137a5f20ce729bcde5c65e1e45aa29&lt;SEP&gt;chunk-126f927723331d6ce149cf77ed397bbf</data>
