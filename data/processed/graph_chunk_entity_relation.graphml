</edge>
<edge source="Hipoglicemia" target="Carboidratos Ingestão Contínua">
  <data key="d7">1.0</data>
  <data key="d8">Continuous carbohydrate intake may be required to prevent hypoglycemia recurrence after apparent clinical recovery.</data>
  <data key="d9">prevention,recurrence</data>
  <data key="d10">chunk-6419fb3ef4249d6c7e8d8a45d82efe80</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319791</data>
  <data key="d13"></data>
</edge>
