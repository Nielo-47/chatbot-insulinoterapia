<node id="ALT (TGP)">
  <data key="d0">ALT (TGP)</data>
  <data key="d1">concept</data>
  <data key="d2">Alanine aminotransferase, a liver enzyme that rises more than AST in hepatic steatosis.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="AST (TGO)">
  <data key="d0">AST (TGO)</data>
  <data key="d1">concept</data>
  <data key="d2">Aspartate aminotransferase, a liver enzyme with smaller elevation than ALT in hepatic steatosis.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="Acrochordons">
  <data key="d0">Acrochordons</data>
  <data key="d1">concept</data>
  <data key="d2">Skin tags that increase as insulin resistance intensifies.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="Serum Insulin Level">
  <data key="d0">Serum Insulin Level</data>
  <data key="d1">data</data>
  <data key="d2">Blood concentration of insulin that is markedly high even in fasting state in patients with severe insulin resistance.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="Glycemia">
  <data key="d0">Glycemia</data>
  <data key="d1">data</data>
  <data key="d2">Blood glucose level that rises as insulin resistance worsens.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9&lt;SEP&gt;chunk-8393954b021d0ad02018d1a449e0cc93</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="Acute Pancreatitis">
  <data key="d0">Acute Pancreatitis</data>
  <data key="d1">concept</data>
  <data key="d2">Inflammation of the pancreas that may result from very high triglyceride levels.&lt;SEP&gt;Acute pancreatitis is a sudden form of pancreatitis that can cause postpancreatitis diabetes mellitus.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9&lt;SEP&gt;chunk-090b8f9281aa75054311d8f275a2c8f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377268</data>
  <data key="d6"></data>
</node>
<node id="Triglyceride Level">
  <data key="d0">Triglyceride Level</data>
  <data key="d1">data</data>
  <data key="d2">Measured concentration of triglycerides, often below 1000 mg/dL despite severe elevation.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="American Cohort">
  <data key="d0">American Cohort</data>
  <data key="d1">organization</data>
  <data key="d2">Study group of patients from the United States showing higher triglyceride values than Brazilian patients.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="HDL Cholesterol">
  <data key="d0">HDL Cholesterol</data>
  <data key="d1">concept</data>
  <data key="d2">High‑density lipoprotein cholesterol that correlates inversely with triglycerides and is often below 30 mg/dL.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="Abdominal Ultrasound">
  <data key="d0">Abdominal Ultrasound</data>
  <data key="d1">method</data>
  <data key="d2">Imaging technique that can detect significant hepatic steatosis and hepatosplenomegaly even in children.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="Hepatosplenomegaly">
  <data key="d0">Hepatosplenomegaly</data>
  <data key="d1">concept</data>
  <data key="d2">Enlargement of liver and spleen that may accompany severe hepatic steatosis.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321250</data>
  <data key="d6"></data>
</node>
<node id="Complications of Hepatic Impairment">
  <data key="d0">Complications of Hepatic Impairment</data>
  <data key="d1">concept</data>
  <data key="d2">Complications such as cirrhosis, digestive bleeding, renal failure, pancreatitis, and infections that lead to death.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321251</data>
  <data key="d6"></data>
</node>
<node id="Dietary Treatment">
  <data key="d0">Dietary Treatment</data>
  <data key="d1">method</data>
  <data key="d2">Nutritional management aimed at controlling hypertriglyceridemia and diabetes in lipodystrophy patients.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321251</data>
  <data key="d6"></data>
</node>
<node id="Breast Milk Leptin">
  <data key="d0">Breast Milk Leptin</data>
  <data key="d1">concept</data>
  <data key="d2">Leptin present in maternal milk that may alleviate disease in early infancy.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321251</data>
  <data key="d6"></data>
</node>
<node id="Nutritionist">
  <data key="d0">Nutritionist</data>
  <data key="d1">person</data>
  <data key="d2">Healthcare professional who guides dietary restriction of saturated fat in lipodystrophy management.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321251</data>
  <data key="d6"></data>
</node>
<node id="Pioglitazone">
  <data key="d0">Pioglitazone</data>
  <data key="d1">artifact</data>
  <data key="d2">Thiazolidinedione not indicated for generalized lipodystrophy because it may worsen steatosis and triglycerides.&lt;SEP&gt;A thiazolidinedione drug studied for use after transplantation.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9&lt;SEP&gt;chunk-c83accc14a3b482690949ff04716a0aa</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377257</data>
  <data key="d6"></data>
</node>
<node id="Sulfonylureas">
  <data key="d0">Sulfonylureas</data>
  <data key="d1">method</data>
  <data key="d2">Oral drugs usable in early diabetes when beta‑cell capacity remains.&lt;SEP&gt;Sulfonylureas are a class of oral medications that stimulate insulin secretion to lower blood glucose.&lt;SEP&gt;Oral hypoglycemic agents to which patients with MODY‑HNF1A and MODY‑HNF4A usually have a good long‑term response.&lt;SEP&gt;Sulfonylureas are a class of oral hypoglycemic agents to which several MODY subtypes respond well.&lt;SEP&gt;Sulfonylureas are oral medications that stimulate insulin secretion, used as first‑line therapy for certain MODY forms.&lt;SEP&gt;Sulfonylureas are a class of oral hypoglycemic agents used as first‑line therapy for HNF1A‑MODY, HNF4A‑MODY, and some neonatal diabetes forms.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9&lt;SEP&gt;chunk-a19f43c10a7a756e1597ff1a7f53296e&lt;SEP&gt;chunk-299bcef3259f8ab6bc70544e12616624&lt;SEP&gt;chunk-e26b32d53b78f97e8d7fa8b815f2cc87&lt;SEP&gt;chunk-9e1f69c1d604e82e14a23a29231bd587&lt;SEP&gt;chunk-0bdb8ef335f3531317a3a5bd7de3a561</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377238</data>
  <data key="d6"></data>
</node>
<node id="DPP-4 Inhibitors">
  <data key="d0">DPP-4 Inhibitors</data>
  <data key="d1">artifact</data>
  <data key="d2">Oral agents that could improve glycemic control though not specifically studied in lipodystrophy.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="SGLT2 Inhibitors">
  <data key="d0">SGLT2 Inhibitors</data>
  <data key="d1">concept</data>
  <data key="d2">Oral agents that may cause weight loss, limiting their use in already low‑weight patients.&lt;SEP&gt;A class of drugs that can cause weight loss, which may limit their use.&lt;SEP&gt;SGLT2 inhibitors are a class of glucose‑lowering drugs recommended for patients with established cardiovascular disease because of demonstrated cardiovascular benefit.&lt;SEP&gt;Sodium‑glucose cotransporter‑2 inhibitors are a class of glucose‑lowering drugs with established cardiovascular and renal benefits.&lt;SEP&gt;SGLT2 inhibitors are a class of glucose‑lowering drugs that have demonstrated cardiovascular benefit.&lt;SEP&gt;A class of drugs examined for association with diabetic ketoacidosis using FDA Adverse Event Reporting System data.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9&lt;SEP&gt;chunk-c96221c60c19f02ac6efa6a987b1e15b&lt;SEP&gt;chunk-f99d05e1089d59496d56d86ff40197cc&lt;SEP&gt;chunk-38ab5af7e42588297df4330ffb2c046b&lt;SEP&gt;chunk-aff91698679a52cd7b07563b7b2627a3&lt;SEP&gt;chunk-d5ec01ed3c32ac663f3dc6cfa6fa09a3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377384</data>
  <data key="d6"></data>
</node>
<node id="GLP-1 Analogs">
  <data key="d0">GLP-1 Analogs</data>
  <data key="d1">artifact</data>
  <data key="d2">Drugs that reduce hyperphagia from hypoleptinemia but may cause weight loss, affecting suitability.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Gastrointestinal Bleeding">
  <data key="d0">Gastrointestinal Bleeding</data>
  <data key="d1">concept</data>
  <data key="d2">Bleeding from the gastrointestinal tract that can occur as a complication of advanced liver disease.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Renal Failure">
  <data key="d0">Renal Failure</data>
  <data key="d1">concept</data>
  <data key="d2">Loss of kidney function that may arise as a severe complication of cirrhosis.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Infectious Complications">
  <data key="d0">Infectious Complications</data>
  <data key="d1">concept</data>
  <data key="d2">Infections that develop in patients with advanced hepatic disease.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Specific Genetic Mutation">
  <data key="d0">Specific Genetic Mutation</data>
  <data key="d1">concept</data>
  <data key="d2">A particular genetic alteration that can confirm the diagnosis of generalized lipodystrophy.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Saturated Fat Restriction">
  <data key="d0">Saturated Fat Restriction</data>
  <data key="d1">method</data>
  <data key="d2">Dietary approach that limits intake of saturated fats to manage hypertriglyceridemia and diabetes.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Hipoleptinemia">
  <data key="d0">Hipoleptinemia</data>
  <data key="d1">concept</data>
  <data key="d2">Condition of abnormally low leptin levels often seen in lipodystrophy patients.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Low Body Weight">
  <data key="d0">Low Body Weight</data>
  <data key="d1">concept</data>
  <data key="d2">Reduced body mass commonly observed in individuals with generalized lipodystrophy.</data>
  <data key="d3">chunk-005de970178a46619506bcc15fe94fa9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="GLP-1 Analogues">
  <data key="d0">GLP-1 Analogues</data>
  <data key="d1">concept</data>
  <data key="d2">A class of drugs that can cause weight loss, which may limit their use.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321252</data>
  <data key="d6"></data>
</node>
<node id="Weight Loss">
  <data key="d0">Weight Loss</data>
  <data key="d1">concept</data>
  <data key="d2">The reduction in body weight observed with SGLT2 inhibitors and GLP-1 analogues.&lt;SEP&gt;A health goal promoted by online diabetes programs to improve metabolic outcomes.&lt;SEP&gt;Discrete weight loss observed in about 30% of children with type 2 diabetes.&lt;SEP&gt;Weight loss through healthy nutrition and physical activity may reduce progression toward diabetes.&lt;SEP&gt;Weight loss refers to reduction in body weight, a risk factor that should prompt screening for CFRD.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b&lt;SEP&gt;chunk-5227749196a4c9226dba64a500d84b3a&lt;SEP&gt;chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-9cdf6af658e42c2f4f7dca5e4dbdd3db&lt;SEP&gt;chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377352</data>
  <data key="d6"></data>
</node>
<node id="Insulin Glargine U-300">
  <data key="d0">Insulin Glargine U-300</data>
  <data key="d1">artifact</data>
  <data key="d2">A concentrated insulin formulation that can help reduce the problem of large injection volumes.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321253</data>
  <data key="d6"></data>
</node>
<node id="Subcutaneous Adipose Tissue">
  <data key="d0">Subcutaneous Adipose Tissue</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The layer of fat under the skin whose scarcity makes subcutaneous injection difficult.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321253</data>
  <data key="d6"></data>
</node>
<node id="Generalized Lipodystrophies">
  <data key="d0">Generalized Lipodystrophies</data>
  <data key="d1">concept</data>
  <data key="d2">A disorder of widespread loss of adipose tissue for which metreleptin is an approved treatment.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321253</data>
  <data key="d6"></data>
</node>
<node id="Appetite">
  <data key="d0">Appetite</data>
  <data key="d1">concept</data>
  <data key="d2">A physiological drive for food intake that is significantly reduced by metreleptin.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321253</data>
  <data key="d6"></data>
</node>
<node id="Injection Volume Problem">
  <data key="d0">Injection Volume Problem</data>
  <data key="d1">concept</data>
  <data key="d2">The difficulty arising from the large volume of insulin that must be injected, especially when doses exceed 2 U/kg/day.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321254</data>
  <data key="d6"></data>
</node>
<node id="High Dose Insulin Therapy">
  <data key="d0">High Dose Insulin Therapy</data>
  <data key="d1">concept</data>
  <data key="d2">Therapy involving insulin doses often greater than 2 U/kg/day, leading to injection‑volume challenges.</data>
  <data key="d3">chunk-c96221c60c19f02ac6efa6a987b1e15b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321254</data>
  <data key="d6"></data>
</node>
<node id="Congenital Generalized Lipodystrophy">
  <data key="d0">Congenital Generalized Lipodystrophy</data>
  <data key="d3">chunk-336c6084eb6cb7c8ada29ed26c0cd20d</data>
  <data key="d2">The study provides clinical and laboratory data on a large series of patients with congenital generalized lipodystrophy.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
