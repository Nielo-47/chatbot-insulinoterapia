  <data key="d0">Hemoglobina Glicada</data>
  <data key="d1">concept</data>
  <data key="d2">Hemoglobina Glicada (HbA1c) is a laboratory measurement used to assess long‑term glucose control in diabetes patients.</data>
  <data key="d3">chunk-b64741e11a7d852f462b1269fabfbe43</data>
