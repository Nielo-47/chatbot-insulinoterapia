  <data key="d13">1778707517</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Sensor Glucose Not Available Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Sensor Glucose Not Available Alert is displayed when the CGM device cannot provide glucose readings for up to two hours.</data>
  <data key="d10">alert condition,data interruption</data>
