</node>
<node id="Prednisolona">
  <data key="d0">Prednisolona</data>
  <data key="d1">concept</data>
  <data key="d2">Prednisolona is a glucocorticoid whose dose above 20 mg/day is identified as a risk factor for glucocorticoid‑induced hyperglycemia.</data>
  <data key="d3">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786371973</data>
  <data key="d6"></data>
</node>
<node id="Hidrocortisona">
  <data key="d0">Hidrocortisona</data>
  <data key="d1">concept</data>
  <data key="d2">Hidrocortisona is a glucocorticoid with a risk threshold above 50 mg/day for inducing hyperglycemia.</data>
  <data key="d3">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
