</edge>
<edge source="Pump" target="Unpairing The Transmitter From The Pump">
  <data key="d8">1.0</data>
  <data key="d9">The pump must have the transmitter unpaired from its system before attempting to re-pair it correctly.</data>
  <data key="d10">connectivity,device management</data>
  <data key="d11">chunk-6f4df342459d4afd90a81b1a3f13d859</data>
