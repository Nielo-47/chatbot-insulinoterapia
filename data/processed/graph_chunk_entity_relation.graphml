</node>
<node id="Exercise-Related Hypoglycemia">
  <data key="d0">Exercise-Related Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Exercise-Related Hypoglycemia denotes low glucose events triggered by physical activity, a risk that AID systems may lower.</data>
  <data key="d3">chunk-9cd925790899146eeb8a373879b5feac</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335884</data>
  <data key="d6"></data>
</node>
<node id="Psychosocial Benefits">
  <data key="d0">Psychosocial Benefits</data>
  <data key="d1">concept</data>
  <data key="d2">Psychosocial Benefits refer to improved quality of life and reduced diabetes‑related stress associated with AID system use.</data>
  <data key="d3">chunk-9cd925790899146eeb8a373879b5feac</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
