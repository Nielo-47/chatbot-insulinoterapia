  <data key="d0">School Designees</data>
  <data key="d1">person</data>
  <data key="d2">School designees are individuals assigned to support diabetes care in school settings alongside school nurses.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
