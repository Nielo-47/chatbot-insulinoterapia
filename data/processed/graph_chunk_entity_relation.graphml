  <data key="d0">Inclusão Inicial De Texto De Bula – RDC 60/12</data>
  <data key="d1">event</data>
  <data key="d2">This event refers to the initial submission of the medication leaflet for Levemir® under regulation RDC 60/12 on 08/10/2013.</data>
  <data key="d3">chunk-bad7b7e8e5212b6d7ea0f4b0505f82c0</data>
