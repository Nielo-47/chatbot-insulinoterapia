</node>
<node id="Reanudar Basal">
  <data key="d0">Reanudar Basal</data>
  <data key="d1">method</data>
  <data key="d2">Resume Basal is a method to continue basal insulin delivery after a problem has been resolved.</data>
  <data key="d3">chunk-ca7afb2078bd96edf087859a2c89920c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
