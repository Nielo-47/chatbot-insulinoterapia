<node id="Oral Antidiabetic">
  <data key="d0">Oral Antidiabetic</data>
  <data key="d1">method</data>
  <data key="d2">Oral antidiabetics are medications used alongside Levemir in the management of type 2 diabetes in adults.</data>
  <data key="d3">chunk-fdd292edf157383567920d27a920c13f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
