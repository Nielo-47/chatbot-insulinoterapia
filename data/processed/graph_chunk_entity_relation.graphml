  <data key="d3">chunk-525086e26636af026c417773a8f11a92</data>
  <data key="d2">Correct disposal of diabetes waste reduces environmental contamination.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1778694507</data>
  <data key="d6"></data>
</node>
