  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="Medtronic Support Representative">
  <data key="d0">Medtronic Support Representative</data>
  <data key="d1">person</data>
  <data key="d2">A Medtronic support representative provides information about compatible mobile devices and operating systems.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329646</data>
  <data key="d6"></data>
</node>
<node id="Therapy Decisions">
  <data key="d0">Therapy Decisions</data>
  <data key="d1">concept</data>
  <data key="d2">Therapy decisions refer to the clinical choices made based on insulin pump data and glucose information.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
