  <data key="d1">event</data>
  <data key="d2">A 24‑week parallel‑group clinical trial involving 125 children with type 1 diabetes comparing insulin glargine once daily with insulin NPH once or twice daily.</data>
  <data key="d3">chunk-29e9c7394777a2e452b57285541f75f2</data>
