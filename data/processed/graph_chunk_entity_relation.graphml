  <data key="d12">1786317866</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Equimose">
  <data key="d7">1.0</data>
  <data key="d8">Ecchymosis can appear after Levemir® injection.</data>
  <data key="d9">adverse reaction,frequency</data>
  <data key="d10">chunk-8a68ba1e8cc1defda76cde0eff9592e6</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317866</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Hipoglicemia Maior">
  <data key="d7">1.0</data>
  <data key="d8">Levemir® can cause severe hypoglycemia in about 6 % of treated patients, necessitating third‑party intervention.</data>
  <data key="d9">adverse reaction,severe</data>
  <data key="d10">chunk-8a68ba1e8cc1defda76cde0eff9592e6</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317868</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Antibodies Against Insulin">
  <data key="d7">1.0</data>
  <data key="d8">The development of Antibodies Against Insulin was observed in patients treated with Levemir® over 24 months.</data>
  <data key="d9">immunogenicity,observed with</data>
  <data key="d10">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317868</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Randomized Open Study">
  <data key="d7">2.0</data>
  <data key="d8">In the Randomized Open Study, patients who did not meet the HbA1c target were randomized to receive Levemir® once daily.&lt;SEP&gt;Levemir® was administered in combination with Liraglutida and Metformina as part of the Randomized Open Study.</data>
  <data key="d9">combined therapy,intervention,randomization,study inclusion</data>
  <data key="d10">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317870</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Adolescent Patients with Type 2 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Levemir® is supported for use in adolescent patients with Type 2 Diabetes.</data>
  <data key="d9">suitability,treatment</data>
  <data key="d10">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317871</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Serious Maternal Adverse Events">
  <data key="d7">1.0</data>
  <data key="d8">A numerically higher frequency of serious maternal adverse events was observed in the Levemir® group versus the Insulin NPH group.</data>
  <data key="d9">higher incidence</data>
  <data key="d10">chunk-b4d7abd3e1e5418ee5a931e28a18e8ad</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317871</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Live Births">
  <data key="d7">1.0</data>
  <data key="d8">The number of live‑born children was lower (50) in the Levemir® group than in the Insulin NPH group (55).</data>
  <data key="d9">lower outcome</data>
  <data key="d10">chunk-b4d7abd3e1e5418ee5a931e28a18e8ad</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317872</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Umbilical Cord Blood">
  <data key="d7">1.0</data>
  <data key="d8">Levemir® was detected in the umbilical cord blood of approximately one‑quarter of newborns at concentrations above the lower limit of quantification.</data>
  <data key="d9">detection</data>
  <data key="d10">chunk-b4d7abd3e1e5418ee5a931e28a18e8ad</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317873</data>
  <data key="d13"></data>
</edge>
<edge source="Levemir®" target="Basal-Bolus Therapy">
  <data key="d7">1.0</data>
  <data key="d8">Levemir® can be administered once or twice daily as part of a basal‑bolus insulin regimen.</data>
  <data key="d9">regimen,usage</data>
