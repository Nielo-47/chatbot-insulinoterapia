  <data key="d6"></data>
</node>
<node id="Estudo ORIGIN">
  <data key="d0">Estudo ORIGIN</data>
  <data key="d1">event</data>
  <data key="d2">Estudo ORIGIN is a multinational, randomized, 2x2 factorial clinical trial evaluating initial glargine insulin intervention.</data>
  <data key="d3">chunk-a72472938feb27131681a1591081e8c1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310020</data>
  <data key="d6"></data>
</node>
<node id="Glicose de Jejum Alterada">
  <data key="d0">Glicose de Jejum Alterada</data>
  <data key="d1">concept</data>
  <data key="d2">Glicose de Jejum Alterada (impaired fasting glucose) is a metabolic condition defining part of the ORIGIN study population.</data>
  <data key="d3">chunk-a72472938feb27131681a1591081e8c1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310020</data>
  <data key="d6"></data>
</node>
<node id="Tolerância a Glicose Alterada">
  <data key="d0">Tolerância a Glicose Alterada</data>
  <data key="d1">concept</data>
  <data key="d2">Tolerância a Glicose Alterada (impaired glucose tolerance) is another metabolic condition defining part of the ORIGIN study population.</data>
  <data key="d3">chunk-a72472938feb27131681a1591081e8c1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310020</data>
  <data key="d6"></data>
</node>
<node id="Doença Cardiovascular">
  <data key="d0">Doença Cardiovascular</data>
  <data key="d1">concept</data>
  <data key="d2">Doença Cardiovascular refers to existing cardiovascular disease present in participants of the ORIGIN study.&lt;SEP&gt;Doença Cardiovascular is cardiovascular disease, a baseline characteristic required for enrollment in the ORIGIN Study.&lt;SEP&gt;Cardiovascular disease considered a limiting comorbidity for glycemic targets.</data>
  <data key="d3">chunk-a72472938feb27131681a1591081e8c1&lt;SEP&gt;chunk-b916f29e047f8579110cf5da3fd73847&lt;SEP&gt;chunk-d0cc9dbb0b2eb4685ac17cfe445b7ce7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1786370031</data>
  <data key="d6"></data>
</node>
<node id="SAS GENMOD">
  <data key="d0">SAS GENMOD</data>
  <data key="d1">method</data>
  <data key="d2">SAS GENMOD is a generalized linear modeling procedure used to analyze retinopathy progression.&lt;SEP&gt;SAS GENMOD is the generalized linear model procedure used for statistical analysis of the study data.&lt;SEP&gt;A generalized linear modeling procedure employed to analyze the primary retinopathy endpoint with binomial distribution and link function.</data>
  <data key="d3">chunk-a72472938feb27131681a1591081e8c1&lt;SEP&gt;chunk-b916f29e047f8579110cf5da3fd73847&lt;SEP&gt;chunk-863286c185f2a62e5b28d7e4577a1088</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313612</data>
  <data key="d6"></data>
</node>
<node id="Rosenstock et al. 2009">
  <data key="d0">Rosenstock et al. 2009</data>
  <data key="d1">content</data>
  <data key="d2">Rosenstock et al. 2009 is a cited reference describing the statistical model employed.</data>
  <data key="d3">chunk-a72472938feb27131681a1591081e8c1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310021</data>
