  <data key="d6"></data>
</node>
<node id="Reminder">
  <data key="d0">Reminder</data>
  <data key="d1">method</data>
  <data key="d2">A Reminder is a configurable notification within the pump system that prompts the user to perform a specific action, such as changing the infusion set.&lt;SEP&gt;A type of notification to help remember an action.&lt;SEP&gt;A type of notification designed to help remember an action, such as changing an infusion set.</data>
  <data key="d3">chunk-a76c99cd46001ae6a2373d3413db020f&lt;SEP&gt;chunk-54631c5494eb3fe006ea9eb279a14651&lt;SEP&gt;chunk-e90de561bcfc1f3544a690722c75e6f2</data>
