  <data key="d14"></data>
  <data key="d15">Insulin Dose</data>
  <data key="d16">Insulin Pen</data>
</edge>
<edge source="Insulin Pen" target="Needle">
  <data key="d8">2.0</data>
  <data key="d9">A new needle must be attached to the insulin pen before each use to ensure sterility and proper delivery.&lt;SEP&gt;The needle is attached to the insulin pen and must be properly secured to avoid bending and ensure correct insulin delivery.</data>
  <data key="d10">device assembly, injection setup, device attachment, injection mechanism</data>
  <data key="d11">chunk-54575ceb6b15fc8abcc2afcec7b36792&lt;SEP&gt;chunk-e490a7e963a20e2221a8097b50073543</data>
