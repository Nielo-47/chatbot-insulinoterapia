</edge>
<edge source="MiniMed 780G Insulin Pump" target="Storage Mode">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G Insulin Pump must be placed in storage mode when not in use, with periodic battery replacement to prevent deep discharge.</data>
  <data key="d10">battery management,device maintenance</data>
  <data key="d11">chunk-33e0b546270469b67078fda39a4e47d4</data>
