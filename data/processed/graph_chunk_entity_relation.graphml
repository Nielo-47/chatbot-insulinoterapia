  <data key="d13"></data>
</edge>
<edge source="Cetoacidose Diabética" target="Perda de Consciência">
  <data key="d7">2.0</data>
  <data key="d8">Loss of consciousness can result from severe diabetic ketoacidosis.&lt;SEP&gt;Loss of consciousness can result from untreated ketoacidosis.</data>
  <data key="d9">complication,severe outcome,symptom</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
