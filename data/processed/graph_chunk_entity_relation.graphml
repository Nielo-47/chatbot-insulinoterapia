  <data key="d14"></data>
</edge>
<edge source="Pump" target="Third-Party Reservoir">
  <data key="d8">1.0</data>
  <data key="d9">Using a third-party reservoir with the pump is not supported by Medtronic Diabetes and may result in malfunction or injury.</data>
  <data key="d10">compatibility risk,safety warning</data>
