</node>
<node id="High Target Value">
  <data key="d0">High Target Value</data>
  <data key="d1">data</data>
  <data key="d2">High Target Value is the upper glucose threshold used to determine when a correction dose is needed.</data>
  <data key="d3">chunk-97eb00dc26d33c23bf8bf473c0a98472</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
