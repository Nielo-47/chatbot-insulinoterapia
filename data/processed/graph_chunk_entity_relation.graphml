  <data key="d13">1778708107</data>
  <data key="d14"></data>
</edge>
<edge source="Calibration" target="Blood Glucose">
  <data key="d8">3.0</data>
  <data key="d9">Calibration of the CGM system relies on blood glucose readings as reference points to adjust and maintain the accuracy of sensor glucose values.&lt;SEP&gt;Calibration uses Blood Glucose readings as reference values to align the accuracy of Sensor Glucose outputs.&lt;SEP&gt;Blood glucose values from capillary testing are used as inputs for calibrating the sensor system.</data>
  <data key="d10">input data,reference input,reference measurement,reference value,system accuracy,system input</data>
  <data key="d11">chunk-b0f14c91b2fb52c8fcc6d43aa4f53f64&lt;SEP&gt;chunk-c03aab2b6261ddc73d474d0c866e7b37&lt;SEP&gt;chunk-86d3bb81c7595510175054c288b122fb</data>
