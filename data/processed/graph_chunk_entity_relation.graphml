  <data key="d0">Agente Hipoglicemiante Não‑Insulínico</data>
  <data key="d1">concept</data>
  <data key="d2">Agente Hipoglicemiante Não‑Insulínico denotes non‑insulin hypoglycemic agents listed among treatments in the study.</data>
  <data key="d3">chunk-3553e80da33ab48fb157ac9ff75436eb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
