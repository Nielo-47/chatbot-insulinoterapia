<edge source="Sensor" target="Transmitter">
  <data key="d7">4.0</data>
  <data key="d8">The transmitter sends glucose data from the sensor to the pump.&lt;SEP&gt;The transmitter connects to the sensor to transmit glucose data.&lt;SEP&gt;The transmitter communicates with the sensor to receive glucose data.&lt;SEP&gt;The Transmitter pairs with the Sensor to send glucose readings to the Pump.</data>
  <data key="d9">communication,connection,data transmission,pairing</data>
