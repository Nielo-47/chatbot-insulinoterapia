</edge>
<edge source="Hyperglycemia" target="Dose Reduction When Switching Sites">
  <data key="d7">1.0</data>
  <data key="d8">Reducing the insulin dose when moving to a healthy site helps prevent post‑switch hyperglycemia.</data>
  <data key="d9">mitigation</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299867</data>
  <data key="d13"></data>
</edge>
<edge source="Hyperglycemia" target="Frequent Glycemic Monitoring During Site Switch">
  <data key="d7">1.0</data>
  <data key="d8">Increased glucose measurements during site transition detect any emerging hyperglycemia.</data>
  <data key="d9">monitoring</data>
