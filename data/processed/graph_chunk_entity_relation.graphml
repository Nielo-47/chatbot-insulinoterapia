  <data key="d13">1778699123</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="Diabetes">
  <data key="d8">1.0</data>
  <data key="d9">Regular blood glucose monitoring helps optimize glycemic control and delay the onset of diabetic complications.</data>
  <data key="d10">complication prevention,disease management</data>
  <data key="d11">chunk-ea9fa1ee045093083e543d672f1309db</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699182</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="Diabetic Ketoacidosis">
  <data key="d8">1.0</data>
  <data key="d9">Frequent blood glucose monitoring helps detect high levels early and prevent the onset of diabetic ketoacidosis.</data>
  <data key="d10">early detection,prevention</data>
  <data key="d11">chunk-23235296c6ccfffc5ec397dd6b0dc7b7</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702703</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="High Glucose Alert">
  <data key="d8">1.0</data>
  <data key="d9">A high glucose alert from a sensor must be confirmed with capillary blood glucose testing before therapy changes.</data>
  <data key="d10">therapy decision,verification</data>
  <data key="d11">chunk-f63b580c3efbe7e9a671badd7807ad11</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702825</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="Therapy With Insulin Pump">
  <data key="d8">1.0</data>
  <data key="d9">Regular blood glucose monitoring is critical to ensure the effectiveness of therapy with insulin pump.</data>
  <data key="d10">data collection,routine check</data>
  <data key="d11">chunk-44b69a8e50a0a4230b6963fe643d8cd0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702923</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="Glucose Levels">
  <data key="d8">1.0</data>
  <data key="d9">Blood glucose monitoring is used to track glucose levels before meals, at bedtime, and during sleep.</data>
  <data key="d10">measurement,tracking</data>
  <data key="d11">chunk-44b69a8e50a0a4230b6963fe643d8cd0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702925</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="Sleep">
  <data key="d8">1.0</data>
  <data key="d9">Checking glucose during sleep helps prevent hypoglycemia and hyperglycemia episodes.</data>
  <data key="d10">overnight monitoring,safety</data>
  <data key="d11">chunk-44b69a8e50a0a4230b6963fe643d8cd0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702926</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="Exercise">
  <data key="d8">1.0</data>
  <data key="d9">Monitoring glucose before and during exercise ensures safe physical activity while on insulin pump therapy.</data>
  <data key="d10">glucose stability,pre-activity check</data>
  <data key="d11">chunk-44b69a8e50a0a4230b6963fe643d8cd0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702928</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="SAP Therapy">
  <data key="d8">1.0</data>
  <data key="d9">SAP therapy incorporates regular blood glucose monitoring into its system for real-time adjustments.</data>
  <data key="d10">monitoring integration,therapy component</data>
  <data key="d11">chunk-6367cc87b3326e358622e179b72cbfc3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703066</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Monitoring" target="Driving">
  <data key="d8">1.0</data>
  <data key="d9">Blood glucose must be checked and confirmed above target levels before driving to ensure safety.</data>
