  <data key="d13"></data>
</edge>
<edge source="TTGO-1h" target="FINDRISC">
  <data key="d7">1.0</data>
  <data key="d8">High FINDRISC scores indicate the need for TTGO-1h testing.</data>
  <data key="d9">risk assessment,testing recommendation</data>
  <data key="d10">chunk-23ad6eb7138be249f01b479174a34076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
