<node id="Armazenamento a 2‑8°C">
  <data key="d0">Armazenamento a 2‑8°C</data>
  <data key="d1">concept</data>
  <data key="d2">Armazenamento a 2‑8°C specifies that the insulin pen must be kept refrigerated between 2 °C and 8 °C.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
