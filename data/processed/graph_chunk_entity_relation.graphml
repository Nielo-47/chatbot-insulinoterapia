</edge>
<edge source="Hipoglicemia" target="Capacidade de Dirigir ou Operar Máquinas">
  <data key="d7">1.0</data>
  <data key="d8">Hipoglicemia can impair the patient’s ability to concentrate and react, increasing risk while driving or operating machines.</data>
  <data key="d9">impairment,safety risk</data>
