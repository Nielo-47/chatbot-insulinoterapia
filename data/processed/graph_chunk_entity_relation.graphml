  <data key="d13">1778707988</data>
  <data key="d14"></data>
</edge>
<edge source="Home Screen" target="Time In Range Screen">
  <data key="d8">1.0</data>
  <data key="d9">The Time In Range Screen is accessible from the Home Screen via a shortcut when the Sensor Feature is enabled.</data>
  <data key="d10">feature access,navigation</data>
