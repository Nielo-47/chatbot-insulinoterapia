</edge>
<edge source="TTGO-1h" target="Nutritional Guidance">
  <data key="d7">1.0</data>
  <data key="d8">TTGO‑1h testing helps identify individuals who would benefit from nutritional guidance.</data>
  <data key="d9">preventive measure,risk identification</data>
