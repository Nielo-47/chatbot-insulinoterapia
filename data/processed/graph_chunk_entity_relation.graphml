  <data key="d5">1786310682</data>
  <data key="d6"></data>
</node>
<node id="Postprandial Glycemic Control">
  <data key="d0">Postprandial Glycemic Control</data>
  <data key="d1">concept</data>
  <data key="d2">Postprandial glycemic control refers to the regulation of blood glucose levels after a meal.</data>
  <data key="d3">chunk-bf25fca295be60e28b7c7d3103f722fc</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310682</data>
