  <data key="d12">1786310095</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Insulin Glargina (Lantus)">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargina (Lantus) is a specific long‑acting formulation of insulin.</data>
  <data key="d9">specific formulation</data>
  <data key="d10">chunk-4da80e99fd3e43cb7d3b260aca23fe56</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
  <data key="d12">1786304242</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Diabetes Tipo 1">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes Tipo 1 requires continuous insulin administration and never omitting insulin.</data>
  <data key="d9">necessity,treatment</data>
  <data key="d10">chunk-a976e1642df27c488174759a35ca23f2</data>
