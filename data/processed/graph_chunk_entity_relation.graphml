<edge source="Paciente" target="Caneta Reutilizável">
  <data key="d8">1.0</data>
  <data key="d9">O paciente utiliza a caneta reutilizável e é responsável por conservá-la, armazená-la e descartá-la corretamente.</data>
  <data key="d10">device usage,responsibility</data>
  <data key="d11">chunk-de80027ca96b7501497bcb85811b669d</data>
