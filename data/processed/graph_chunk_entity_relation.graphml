<node id="HI Symbol">
  <data key="d0">HI Symbol</data>
  <data key="d1">concept</data>
  <data key="d2">HI Symbol is a high‑glucose indicator defined in the device manual, representing glucose readings above 500‑600 mg/dL.</data>
