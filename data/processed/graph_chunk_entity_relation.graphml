</edge>
<edge source="Lipodystrophy" target="HIV">
  <data key="d7">1.0</data>
  <data key="d8">HIV infection of adipocytes and macrophages promotes the development of lipodystrophy.</data>
  <data key="d9">cause,infection</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321267</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Protease Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Protease inhibitors are linked to the onset of lipodystrophy through multiple metabolic disturbances.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321268</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Nelfinavir">
  <data key="d7">1.0</data>
  <data key="d8">Nelfinavir induces lipodystrophy by blocking adipocyte differentiation and increasing insulin resistance and cytokine production.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321268</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Indinavir">
  <data key="d7">1.0</data>
  <data key="d8">Indinavir contributes to lipodystrophy via similar mechanisms as other first‑generation protease inhibitors.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321269</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Ritonavir">
  <data key="d7">1.0</data>
  <data key="d8">Ritonavir exerts deleterious effects on adipose tissue, leading to lipodystrophy through oxidative stress and altered adipokine secretion.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321270</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Lopinavir">
  <data key="d7">1.0</data>
  <data key="d8">Lopinavir causes harmful changes in adipose tissue that result in lipodystrophy.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321270</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Nucleoside Reverse Transcriptase Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">NRTIs, especially first‑generation agents, are associated with lipodystrophy, notably subcutaneous lipoatrophy.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321271</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Stavudine">
  <data key="d7">1.0</data>
  <data key="d8">Stavudine contributes to lipodystrophy by inducing mitochondrial dysfunction and oxidative stress.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321272</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Zidovudine">
  <data key="d7">1.0</data>
  <data key="d8">Zidovudine is linked to lipodystrophy through similar mitochondrial and oxidative mechanisms as stavudine.</data>
  <data key="d9">cause,drug effect</data>
  <data key="d10">chunk-f86b5a9c60ab13c2016dd454edf634c7</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1786321272</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophy" target="Tenofovir">
  <data key="d7">1.0</data>
  <data key="d8">Tenofovir does not cause the adverse metabolic effects that lead to lipodystrophy.</data>
  <data key="d9">no effect,safety</data>
