  <data key="d5">1778707388</data>
  <data key="d6"></data>
</node>
<node id="Charger">
  <data key="d0">Charger</data>
  <data key="d1">artifact</data>
  <data key="d2">The Charger is used to fully charge the transmitter before pairing with the pump.</data>
  <data key="d3">chunk-c5646d299deb5989a133b3e471666262</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1778707388</data>
  <data key="d6"></data>
</node>
<node id="Pairing Success Message">
  <data key="d0">Pairing Success Message</data>
  <data key="d1">content</data>
  <data key="d2">The Pairing Success Message appears on the pump screen when the sensor is successfully connected.</data>
  <data key="d3">chunk-c5646d299deb5989a133b3e471666262</data>
