  <data key="d2">Number of randomized volunteers treated in the study is reported in the table footnotes.</data>
  <data key="d3">chunk-7a592aedb257bad9532268b4056ec15c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310033</data>
  <data key="d6"></data>
</node>
<node id="Prior Insulin Use">
  <data key="d0">Prior Insulin Use</data>
  <data key="d1">concept</data>
  <data key="d2">Prior insulin use refers to participants' previous usage of basal insulin such as Lantus® or insulin humana NPH.</data>
  <data key="d3">chunk-7a592aedb257bad9532268b4056ec15c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310033</data>
  <data key="d6"></data>
</node>
<node id="Glycemia Conversion">
  <data key="d0">Glycemia Conversion</data>
  <data key="d1">method</data>
  <data key="d2">Glycemia conversion transforms fasting glucose from mmol/L to mg/dL using a multiplication factor.</data>
  <data key="d3">chunk-7a592aedb257bad9532268b4056ec15c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310033</data>
  <data key="d6"></data>
</node>
<node id="BASAGLAR KWIKPEN Treatment Arm">
  <data key="d0">BASAGLAR KWIKPEN Treatment Arm</data>
  <data key="d1">artifact</data>
  <data key="d2">BASAGLAR KWIKPEN treatment arm combines BASAGLAR KWIKPEN with insulin lispro for 268 participants.</data>
  <data key="d3">chunk-7a592aedb257bad9532268b4056ec15c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310033</data>
  <data key="d6"></data>
</node>
<node id="Lantus® Treatment Arm">
  <data key="d0">Lantus® Treatment Arm</data>
  <data key="d1">artifact</data>
  <data key="d2">Lantus® treatment arm combines Lantus® with insulin lispro for 267 participants.</data>
  <data key="d3">chunk-7a592aedb257bad9532268b4056ec15c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310033</data>
  <data key="d6"></data>
</node>
<node id="Glycine">
  <data key="d0">Glycine</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Glycine is the amino acid that substitutes the original asparagine at position A21 in insulin glargine.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310033</data>
  <data key="d6"></data>
</node>
<node id="Arginine">
  <data key="d0">Arginine</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Arginine is the amino acid added twice to the C‑terminal of chain B in insulin glargine.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310033</data>
  <data key="d6"></data>
</node>
<node id="Clamp Euglicemic Study">
  <data key="d0">Clamp Euglicemic Study</data>
  <data key="d1">method</data>
  <data key="d2">Clamp euglicemic study is a clinical research method employed to assess the pharmacodynamic profile of insulin preparations by maintaining constant plasma glucose levels.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Pharmacodynamic Profile">
  <data key="d0">Pharmacodynamic Profile</data>
  <data key="d1">concept</data>
  <data key="d2">Pharmacodynamic profile refers to the time‑course of insulin’s glucose‑lowering effect, including duration, peak, and total glucose infusion rate.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="pH neutral">
  <data key="d0">pH neutral</data>
  <data key="d1">concept</data>
  <data key="d2">pH neutral refers to physiological pH at which insulin glargina has low solubility.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Micro‑precipitates">
  <data key="d0">Micro‑precipitates</data>
  <data key="d1">artifact</data>
  <data key="d2">Micro‑precipitates are tiny solid formations that arise after subcutaneous injection of BASAGLAR and slowly release insulin glargina.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Molecular Formula of Insulina Glargina">
  <data key="d0">Molecular Formula of Insulina Glargina</data>
  <data key="d1">data</data>
  <data key="d2">The molecular formula C267H404N72O78S6 describes the elemental composition of insulin glargina.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Molecular Weight of Insulina Glargina">
  <data key="d0">Molecular Weight of Insulina Glargina</data>
  <data key="d1">data</data>
  <data key="d2">The molecular weight of insulin glargina is 6063 daltons.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Peripheral Glucose Uptake">
  <data key="d0">Peripheral Glucose Uptake</data>
  <data key="d1">concept</data>
  <data key="d2">Peripheral glucose uptake denotes the transport of glucose into skeletal muscle and adipose tissue stimulated by insulin.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Hormonal Counterregulatory Responses">
  <data key="d0">Hormonal Counterregulatory Responses</data>
  <data key="d1">concept</data>
  <data key="d2">Hormonal counterregulatory responses are hormonal reactions that act to raise blood glucose when it falls too low, observed in insulin studies.</data>
  <data key="d3">chunk-3a279eef99c9c70338c74ffc7b4e260e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Tratamento padrão">
  <data key="d0">Tratamento padrão</data>
  <data key="d1">method</data>
  <data key="d2">Tratamento padrão is the standard glucose‑lowering therapy used as the comparator arm in the trial.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="ORIGIN">
  <data key="d0">ORIGIN</data>
  <data key="d1">event</data>
  <data key="d2">ORIGIN is the clinical study that evaluated Lantus® versus standard treatment over a mean follow‑up of 6.2 years.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310034</data>
  <data key="d6"></data>
</node>
<node id="Desfecho microvascular composto">
  <data key="d0">Desfecho microvascular composto</data>
  <data key="d1">concept</data>
  <data key="d2">Desfecho microvascular composto is a composite microvascular outcome defined by laser photocoagulation, vitrectomy, diabetic‑retinopathy blindness, progressive albuminuria, serum creatinine duplication or need for renal transplant.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Diabetes tipo 2">
  <data key="d0">Diabetes tipo 2</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes tipo 2 is the disease whose incidence was measured at the end of the study.&lt;SEP&gt;Type 2 diabetes, also mentioned as vulnerable to hypoglycemia.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057&lt;SEP&gt;chunk-cbede05ec60d9c79d637d9a0eb0efe48</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Hipoglicemia_SBD_transcricao.docx</data>
  <data key="d5">1786338239</data>
  <data key="d6"></data>
</node>
<node id="GJA">
  <data key="d0">GJA</data>
  <data key="d1">concept</data>
  <data key="d2">GJA is a baseline characteristic of participants used for subgroup analysis.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="TGA">
  <data key="d0">TGA</data>
  <data key="d1">concept</data>
  <data key="d2">TGA is a baseline characteristic of participants used for subgroup analysis.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Morte cardiovascular">
  <data key="d0">Morte cardiovascular</data>
  <data key="d1">concept</data>
  <data key="d2">Morte cardiovascular is cardiovascular death, a component of the primary composite outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Infarto não‑fatal do miocárdio (MI)">
  <data key="d0">Infarto não‑fatal do miocárdio (MI)</data>
  <data key="d1">concept</data>
  <data key="d2">Infarto não‑fatal do miocárdio (MI) is non‑fatal myocardial infarction, a component of the primary composite outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Acidente vascular não‑fatal">
  <data key="d0">Acidente vascular não‑fatal</data>
  <data key="d1">concept</data>
  <data key="d2">Acidente vascular não‑fatal is non‑fatal stroke, a component of the primary composite outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Hospitalização por insuficiência cardíaca">
  <data key="d0">Hospitalização por insuficiência cardíaca</data>
  <data key="d1">concept</data>
  <data key="d2">Hospitalização por insuficiência cardíaca is heart‑failure hospitalization, a component of the primary composite outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Procedimento de revascularização">
  <data key="d0">Procedimento de revascularização</data>
  <data key="d1">concept</data>
  <data key="d2">Procedimento de revascularização is a revascularization procedure, a component of the primary composite outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Mortalidade por todas as causas">
  <data key="d0">Mortalidade por todas as causas</data>
  <data key="d1">concept</data>
  <data key="d2">Mortalidade por todas as causas is all‑cause mortality, a secondary outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Fotocoagulação por laser">
  <data key="d0">Fotocoagulação por laser</data>
  <data key="d1">method</data>
  <data key="d2">Fotocoagulação por laser is a laser photocoagulation procedure included in the composite microvascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Vitrectomia">
  <data key="d0">Vitrectomia</data>
  <data key="d1">method</data>
  <data key="d2">Vitrectomia is a vitrectomy procedure included in the composite microvascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Cegueira por retinopatia diabética">
  <data key="d0">Cegueira por retinopatia diabética</data>
  <data key="d1">concept</data>
  <data key="d2">Cegueira por retinopatia diabética is blindness due to diabetic retinopathy, a component of the composite microvascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310035</data>
  <data key="d6"></data>
</node>
<node id="Albuminúria progressiva">
  <data key="d0">Albuminúria progressiva</data>
  <data key="d1">concept</data>
  <data key="d2">Albuminúria progressiva is progressive albuminuria, a component of the composite microvascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Duplicação da creatinina sérica">
  <data key="d0">Duplicação da creatinina sérica</data>
  <data key="d1">concept</data>
  <data key="d2">Duplicação da creatinina sérica is serum creatinine duplication, a component of the composite microvascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Necessidade de transplante renal">
  <data key="d0">Necessidade de transplante renal</data>
  <data key="d1">concept</data>
  <data key="d2">Necessidade de transplante renal is the need for renal transplant, a component of the composite microvascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Teste Oral de Tolerância à Glicose (TOTG)">
  <data key="d0">Teste Oral de Tolerância à Glicose (TOTG)</data>
  <data key="d1">method</data>
  <data key="d2">Teste Oral de Tolerância à Glicose (TOTG) is the oral glucose tolerance test used to assess incident diabetes at study end.&lt;SEP&gt;Teste oral de tolerância à glicose (TOTG), an oral glucose tolerance test performed 3–4 weeks after discontinuation of insulin.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057&lt;SEP&gt;chunk-1b30ff3c650cf7cb71a3cf6e99f2c581</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313625</data>
  <data key="d6"></data>
</node>
<node id="Câncer (todos os tipos combinados)">
  <data key="d0">Câncer (todos os tipos combinados)</data>
  <data key="d1">concept</data>
  <data key="d2">Câncer (todos os tipos combinados) is the combined incidence of all cancer types evaluated as a safety outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Insulina glargina">
  <data key="d0">Insulina glargina</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina glargina is a long‑acting recombinant human insulin analogue evaluated in the trial.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Escherichia coli (K12)">
  <data key="d0">Escherichia coli (K12)</data>
  <data key="d1">creature</data>
  <data key="d2">Escherichia coli (K12) is a non‑pathogenic laboratory strain used as the production organism for BASAGLAR.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="DNA recombinante">
  <data key="d0">DNA recombinante</data>
  <data key="d1">naturalobject</data>
  <data key="d2">DNA recombinante is recombinant DNA employed in the manufacturing process of BASAGLAR.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Desfechos primários">
  <data key="d0">Desfechos primários</data>
  <data key="d1">concept</data>
  <data key="d2">Desfechos primários are the primary composite cardiovascular outcomes evaluated in the ORIGIN trial.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Desfechos secundários">
  <data key="d0">Desfechos secundários</data>
  <data key="d1">concept</data>
  <data key="d2">Desfechos secundários are the secondary outcomes, including all‑cause mortality and the composite microvascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Desfechos co‑primários">
  <data key="d0">Desfechos co‑primários</data>
  <data key="d1">concept</data>
  <data key="d2">Desfechos co‑primários are the individual components that constitute the composite primary cardiovascular outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310036</data>
  <data key="d6"></data>
</node>
<node id="Composite primary cardiovascular outcome">
  <data key="d0">Composite primary cardiovascular outcome</data>
  <data key="d1">concept</data>
  <data key="d2">Composite primary cardiovascular outcome comprises cardiovascular death, non‑fatal myocardial infarction, non‑fatal stroke, heart‑failure hospitalization, and revascularization.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Incidência de diabetes">
  <data key="d0">Incidência de diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Incidência de diabetes is the measured occurrence of new type‑2 diabetes cases at study end using the oral glucose tolerance test.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Incidência de câncer (todos os tipos combinados)">
  <data key="d0">Incidência de câncer (todos os tipos combinados)</data>
  <data key="d1">concept</data>
  <data key="d2">Incidência de câncer (todos os tipos combinados) is the combined cancer incidence evaluated as a safety outcome.</data>
  <data key="d3">chunk-09cd61106182a6d47854a32a39b66057</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Sanofi‑aventis">
  <data key="d0">Sanofi‑aventis</data>
  <data key="d1">organization</data>
  <data key="d2">Sanofi‑aventis is the pharmaceutical company referenced as the source of comparative data for insulin NPH.</data>
  <data key="d3">chunk-4d0ac8ad5968d54922b924fdb16b61d9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Caneta Aplicadora Descartável">
  <data key="d0">Caneta Aplicadora Descartável</data>
  <data key="d1">artifact</data>
  <data key="d2">Caneta Aplicadora Descartável is the disposable pen device packaged in boxes of five, each coupled to an individual 3 mL glass refill.&lt;SEP&gt;Caneta aplicadora descartável is a disposable applicator pen used to deliver the insulin suspension.&lt;SEP&gt;Caneta Aplicadora Descartável is the disposable applicator pen recommended for delivering Humalog Mix 50 KwikPen.</data>
  <data key="d3">chunk-4d0ac8ad5968d54922b924fdb16b61d9&lt;SEP&gt;chunk-8ef35bd45e4ba8d20f4e9181011ccfcd&lt;SEP&gt;chunk-aca0b919135813e1d5b772face36989d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310746</data>
  <data key="d6"></data>
</node>
<node id="Refil de Vidro 3 mL">
  <data key="d0">Refil de Vidro 3 mL</data>
  <data key="d1">artifact</data>
  <data key="d2">Refil de Vidro 3 mL is a sterile glass cartridge that holds 3 milliliters of insulin solution for use in the disposable pen.</data>
  <data key="d3">chunk-4d0ac8ad5968d54922b924fdb16b61d9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Óxido de Zinco">
  <data key="d0">Óxido de Zinco</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Óxido de Zinco is an excipient present in the insulin formulation of BASAGLAR KWIKPEN.</data>
  <data key="d3">chunk-4d0ac8ad5968d54922b924fdb16b61d9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Estudo Fase III">
  <data key="d0">Estudo Fase III</data>
  <data key="d1">event</data>
  <data key="d2">Estudo Fase III refers to the randomized, open‑label clinical trials involving BASAGLAR KWIKPEN and comparator insulins in patients with diabetes.</data>
  <data key="d3">chunk-4d0ac8ad5968d54922b924fdb16b61d9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Glico‑hemoglobina">
  <data key="d0">Glico‑hemoglobina</data>
  <data key="d1">concept</data>
  <data key="d2">Glico‑hemoglobina (HbA1c) is a biomarker used to assess long‑term glycemic control in diabetes studies.</data>
  <data key="d3">chunk-4d0ac8ad5968d54922b924fdb16b61d9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Oral Antidiabetic">
  <data key="d0">Oral Antidiabetic</data>
  <data key="d1">concept</data>
  <data key="d2">Oral antidiabetic agents are non‑insulin medications that were co‑administered with both BASAGLAR KWIKPEN and Lantus® in the study.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="TFG">
  <data key="d0">TFG</data>
  <data key="d1">data</data>
  <data key="d2">TFG (glomerular filtration rate) is a renal function measure reported as &gt; 90 mL/min/1.73 m² for 68 % of patients.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310037</data>
  <data key="d6"></data>
</node>
<node id="Clinical Study – DM2">
  <data key="d0">Clinical Study – DM2</data>
  <data key="d1">event</data>
  <data key="d2">The DM2 clinical study is a randomized, double‑blind, controlled trial in adults with type 2 diabetes comparing BASAGLAR KWIKPEN plus oral antidiabetics to Lantus® plus oral antidiabetics.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310038</data>
  <data key="d6"></data>
</node>
<node id="Clinical Study – DM1 Pediatric">
  <data key="d0">Clinical Study – DM1 Pediatric</data>
  <data key="d1">event</data>
  <data key="d2">The DM1 pediatric study comprises randomized, controlled trials in children aged 1‑15 years with type 1 diabetes evaluating insulin regimens including Lantus® and NPH insulin.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310038</data>
  <data key="d6"></data>
</node>
<node id="Study Participants">
  <data key="d0">Study Participants</data>
  <data key="d1">data</data>
  <data key="d2">Study participants are patients with diabetes who were randomized to treatment arms; 759 were randomized, with three assigned to BASAGLAR KWIKPEN not receiving study medication.&lt;SEP&gt;Adults with type 1 diabetes enrolled in the referenced studies, some using AID systems such as Medtronic and Tandem.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f&lt;SEP&gt;chunk-127dc0e8b8b960bfd1fce3df4f590120</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
  <data key="d5">1786332847</data>
  <data key="d6"></data>
</node>
<node id="Basal Insulin Injection Timing">
  <data key="d0">Basal Insulin Injection Timing</data>
  <data key="d1">concept</data>
  <data key="d2">Basal insulin injection timing refers to whether the basal insulin dose is administered during the day or at night (hour of sleep).</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310038</data>
  <data key="d6"></data>
</node>
<node id="Body Mass Index">
  <data key="d0">Body Mass Index</data>
  <data key="d1">concept</data>
  <data key="d2">Body Mass Index (IMC) is reported with a mean of approximately 32 kg/m² among study participants.&lt;SEP&gt;Body Mass Index is a numeric index of weight relative to height used to define obesity subgroups.&lt;SEP&gt;The average BMI (34.55 kg/m²) recorded for adult participants at baseline.&lt;SEP&gt;Body mass index is a measure of body weight relative to height.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f&lt;SEP&gt;chunk-7d9c944d51a42525c017d9109f46684c&lt;SEP&gt;chunk-891989adf06518cd34c94853444495e3&lt;SEP&gt;chunk-72a2488e8176f7676c76504e76dd6c04</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377299</data>
  <data key="d6"></data>
</node>
<node id="HbA1c Target &lt; 7%">
  <data key="d0">HbA1c Target &lt; 7%</data>
  <data key="d1">concept</data>
  <data key="d2">HbA1c target of less than 7% is a glycemic control goal used to assess treatment success in the studies.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310038</data>
  <data key="d6"></data>
</node>
<node id="Country">
  <data key="d0">Country</data>
  <data key="d1">concept</data>
  <data key="d2">Country denotes the nation where each participant was enrolled, considered as a fixed effect in the ANCOVA model.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310038</data>
  <data key="d6"></data>
</node>
<node id="Insulin‑Naïve Patients">
  <data key="d0">Insulin‑Naïve Patients</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin‑naïve patients are participants who had not previously received insulin therapy.</data>
  <data key="d3">chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310038</data>
  <data key="d6"></data>
</node>
<node id="Pramlintide">
  <data key="d0">Pramlintide</data>
  <data key="d1">artifact</data>
  <data key="d2">Pramlintide is a peptide drug that may potentiate insulin’s glucose‑lowering action.&lt;SEP&gt;Pramlintide is a medication that can increase insulin’s glucose‑lowering effect, heightening hypoglycemia risk.&lt;SEP&gt;Pramlintide is a synthetic amylin analog that can potentiate the hypoglycemic action of insulin.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b&lt;SEP&gt;chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310038</data>
  <data key="d6"></data>
</node>
<node id="Fluoxetine">
  <data key="d0">Fluoxetine</data>
  <data key="d1">artifact</data>
  <data key="d2">Fluoxetine is a selective serotonin reuptake inhibitor that can increase the hypoglycemic effect of insulin.&lt;SEP&gt;Fluoxetine is a drug that intensifies the insulin‑induced reduction of blood glucose.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b&lt;SEP&gt;chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315493</data>
  <data key="d6"></data>
</node>
<node id="Pentoxifylline">
  <data key="d0">Pentoxifylline</data>
  <data key="d1">artifact</data>
  <data key="d2">Pentoxifylline is a vasodilator that can increase the hypoglycemic effect of insulin.&lt;SEP&gt;Pentoxifylline is a vasodilator that may intensify the hypoglycemic effect of insulin.&lt;SEP&gt;Pentoxifylline is a drug that intensifies the insulin‑induced reduction of blood glucose.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b&lt;SEP&gt;chunk-d65840dd2cbd5c9984dfc4334378df5e&lt;SEP&gt;chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315468</data>
  <data key="d6"></data>
</node>
<node id="Somatostatin Analogs">
  <data key="d0">Somatostatin Analogs</data>
  <data key="d1">concept</data>
  <data key="d2">Somatostatin analogs are hormone mimetics that can increase insulin’s glucose‑lowering effect.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310039</data>
  <data key="d6"></data>
</node>
<node id="Progestogens">
  <data key="d0">Progestogens</data>
  <data key="d1">concept</data>
  <data key="d2">Progestogens are progesterone‑like hormones that can diminish insulin’s glucose‑lowering action.&lt;SEP&gt;Progestogens are hormone compounds that may attenuate insulin‑induced hypoglycemia.&lt;SEP&gt;Progestogens are hormones that reduce the insulin‑induced reduction of blood glucose.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b&lt;SEP&gt;chunk-d65840dd2cbd5c9984dfc4334378df5e&lt;SEP&gt;chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315470</data>
  <data key="d6"></data>
</node>
<node id="Sympatholytic Agents">
  <data key="d0">Sympatholytic Agents</data>
  <data key="d1">concept</data>
  <data key="d2">Sympatholytic agents such as beta‑blockers, clonidine, guanetidine and reserpine can suppress the typical warning signs of hypoglycemia.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310039</data>
  <data key="d6"></data>
</node>
<node id="Guanetidine">
  <data key="d0">Guanetidine</data>
  <data key="d1">artifact</data>
  <data key="d2">Guanetidine is a sympatholytic drug that can mask hypoglycemia symptoms.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310039</data>
  <data key="d6"></data>
</node>
<node id="Shelf Life">
  <data key="d0">Shelf Life</data>
  <data key="d1">concept</data>
  <data key="d2">Shelf life denotes that unopened BASAGLAR KWIKPEN remains stable for 24 months from the date of manufacture.&lt;SEP&gt;Shelf life denotes the period of 36 months during which Humulin R remains stable when stored correctly.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b&lt;SEP&gt;chunk-577779892c0d463cd6bb1966b8a8ce2d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319733</data>
  <data key="d6"></data>
</node>
<node id="Open‑Use Period">
  <data key="d0">Open‑Use Period</data>
  <data key="d1">data</data>
  <data key="d2">Open‑use period indicates that once opened, BASAGLAR KWIKPEN must be used within 28 days and then discarded.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310039</data>
  <data key="d6"></data>
</node>
<node id="Medication Actions">
  <data key="d0">Medication Actions</data>
  <data key="d1">concept</data>
  <data key="d2">Medication Actions refers to the effects of various substances on glucose metabolism and insulin dosing.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310039</data>
  <data key="d6"></data>
</node>
<node id="Lot Number">
  <data key="d0">Lot Number</data>
  <data key="d1">data</data>
  <data key="d2">Lot Number identifies the production batch of BASAGLAR KWIKPEN.&lt;SEP&gt;Lot number identifies the specific production batch of Humalog Mix 50 Kwikpen.&lt;SEP&gt;Lot number is the identifier printed on Humulin R packaging for traceability.&lt;SEP&gt;Lot number is the identifier printed on Humulin R packaging indicating the production batch.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b&lt;SEP&gt;chunk-fd94288932ad6675a1de2b46b3fd9128&lt;SEP&gt;chunk-0fa819f7e1e42eb688d4894dc3ca7e64&lt;SEP&gt;chunk-577779892c0d463cd6bb1966b8a8ce2d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319726</data>
  <data key="d6"></data>
</node>
<node id="Manufacture Date">
  <data key="d0">Manufacture Date</data>
  <data key="d1">data</data>
  <data key="d2">Manufacture Date indicates when BASAGLAR KWIKPEN was produced.</data>
  <data key="d3">chunk-d96761d60c65f05f1530bc19b144cf1b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Técnica de Injeção">
  <data key="d0">Técnica de Injeção</data>
  <data key="d1">method</data>
  <data key="d2">Proper injection technique method required for administering insulin safely.&lt;SEP&gt;Técnica de injeção refers to the recommended procedure for injecting insulin with the SoloStar pen.&lt;SEP&gt;Recommended injection technique to be followed by the patient or healthcare provider.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a&lt;SEP&gt;chunk-0e7689ca0fc736d9eae94256f73fed52&lt;SEP&gt;chunk-46f4c578332d81d4fc1ca84bcbc26bd6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317439</data>
  <data key="d6"></data>
</node>
<node id="Antidiabético Oral">
  <data key="d0">Antidiabético Oral</data>
  <data key="d1">artifact</data>
  <data key="d2">Oral antidiabetic medication that may require dosage adjustment when insulin dose is changed.&lt;SEP&gt;Oral antidiabetic medication whose dosage may need adjustment during therapy transition to BASAGLAR KWIKPEN.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a&lt;SEP&gt;chunk-2db4ee43ed7cc39546184320e1328d06</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Fluxo Sanguíneo">
  <data key="d0">Fluxo Sanguíneo</data>
  <data key="d1">concept</data>
  <data key="d2">Blood flow at the injection site influencing insulin absorption and action.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Temperatura Corporórea">
  <data key="d0">Temperatura Corporórea</data>
  <data key="d1">concept</data>
  <data key="d2">Body temperature influencing insulin absorption and action.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Hipersensibilidade à Insulina Glargina">
  <data key="d0">Hipersensibilidade à Insulina Glargina</data>
  <data key="d1">concept</data>
  <data key="d2">Hypersensitivity reaction to insulin glargina that contraindicates BASAGLAR.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Alteração no Local de Injeção">
  <data key="d0">Alteração no Local de Injeção</data>
  <data key="d1">concept</data>
  <data key="d2">Sudden change in the injection site that may result in hypoglycemia.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Local da Injeção">
  <data key="d0">Local da Injeção</data>
  <data key="d1">concept</data>
  <data key="d2">Specific injection site location that affects the duration and intensity of insulin action.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Estudo Clínico">
  <data key="d0">Estudo Clínico</data>
  <data key="d1">event</data>
  <data key="d2">Clinical study mentioned that compared intravenous administration of insulin glargina and insulin humana in healthy volunteers and type 1 diabetes patients.&lt;SEP&gt;The clinical trial comparing insulin regimens in type‑1 and type‑2 diabetes patients.&lt;SEP&gt;Estudo Clínico is a clinical study comparing Apidra with Insulina Humana Regular in patients with Diabetes Tipo 1.&lt;SEP&gt;Estudo Clínico refers to the randomized controlled trial comparing Levemir® and insulin NPH in pregnant women with type 1 diabetes.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a&lt;SEP&gt;chunk-f46c503a378e6c69618036a038672417&lt;SEP&gt;chunk-aecb3968c37f57b78a756e4b661ad089&lt;SEP&gt;chunk-9bcc4202330d45ebfca8f79c3d4998b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317652</data>
  <data key="d6"></data>
</node>
<node id="Idade Avançada">
  <data key="d0">Idade Avançada</data>
  <data key="d1">concept</data>
  <data key="d2">Advanced age identified as a circumstance that may alter warning signs of hypoglycemia.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310040</data>
  <data key="d6"></data>
</node>
<node id="Neuropatia Autonômica">
  <data key="d0">Neuropatia Autonômica</data>
  <data key="d1">concept</data>
  <data key="d2">Autonomic neuropathy listed as a condition that can affect hypoglycemia symptom presentation.&lt;SEP&gt;Neuropatia autonômica is autonomic nerve damage that can mask the warning symptoms of hypoglycemia.&lt;SEP&gt;Autonomic neuropathy cited as a complication relevant to diabetes management.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a&lt;SEP&gt;chunk-9cd336474a2e9457985162b1ddb4b603&lt;SEP&gt;chunk-51c7617f1e335789b870332231de4058</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330198</data>
  <data key="d6"></data>
</node>
<node id="História Longa de Diabetes">
  <data key="d0">História Longa de Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Long‑standing diabetes described as a factor influencing hypoglycemia awareness.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310041</data>
  <data key="d6"></data>
</node>
<node id="Doenças Psiquiátricas">
  <data key="d0">Doenças Psiquiátricas</data>
  <data key="d1">concept</data>
  <data key="d2">Psychiatric illnesses noted as a circumstance that may mask hypoglycemia symptoms.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310041</data>
  <data key="d6"></data>
</node>
<node id="Hipoglicemia de Desenvolvimento Gradual">
  <data key="d0">Hipoglicemia de Desenvolvimento Gradual</data>
  <data key="d1">concept</data>
  <data key="d2">Gradually developing hypoglycemia that may present with attenuated warning signs.</data>
  <data key="d3">chunk-61cacf80ada6db26d2b975df763c137a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310041</data>
  <data key="d6"></data>
</node>
<node id="Basaglar KwikPen">
  <data key="d0">Basaglar KwikPen</data>
  <data key="d1">artifact</data>
  <data key="d2">Basaglar KwikPen is a prefilled insulin glargine delivery device used for diabetes treatment, subject to contraindications and dosage adjustments.&lt;SEP&gt;Basaglar KwikPen is a brand of insulin glargina delivered via a prefilled pen, used for subcutaneous administration in diabetic patients.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2&lt;SEP&gt;chunk-6ca13e396b094f0c2f482892f220f538</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310041</data>
  <data key="d6"></data>
</node>
<node id="Tiazolidinediones (TZDs)">
  <data key="d0">Tiazolidinediones (TZDs)</data>
  <data key="d1">concept</data>
  <data key="d2">Tiazolidinediones (TZDs) are a class of oral antidiabetic agents that, when combined with insulin, raise risk of edema and heart failure.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310041</data>
  <data key="d6"></data>
</node>
<node id="Hypersensitivity">
  <data key="d0">Hypersensitivity</data>
  <data key="d1">concept</data>
  <data key="d2">Hypersensitivity is an immune‑mediated allergic reaction that can range from mild skin manifestations to severe, potentially life‑threatening responses. In the context of insulin therapy, it is defined as an adverse immune response directed against the active insulin molecule, any of its excipients, or the overall formulation, and it is considered a contraindication for the use of the affected product.

The condition has been identified as a contraindication for several insulin preparations. It is specifically noted for insulin glargine products such as Basaglar KwikPen and the Toujeo formulation, as well as for insulin detemir (Levemir®) and its excipients. Similar contraindications apply to the recombinant human insulin products Novolin® R and Novolin® R Penfill. Reports of hypersensitivity reactions have also been documented, though less frequently, with the fast‑acting insulin aspart formulation Fiasp®, where reactions may present as generalized rash and facial edema and are classified as uncommon.

Overall, hypersensitivity to insulin products encompasses any allergic reaction to the active substance or any component of the formulation, and its occurrence warrants avoidance of the implicated insulin and consideration of alternative glucose‑lowering strategies.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2&lt;SEP&gt;chunk-d6b9a8472aefa6e90793233284c15a3f&lt;SEP&gt;chunk-7fdc648ec086061141581e27adde6fc4&lt;SEP&gt;chunk-8ef15154a94043650617b3b24d8146a4&lt;SEP&gt;chunk-f36263c657ad99a80e578ac49a333d5b&lt;SEP&gt;chunk-9a6f9e10c0d4af5fff0338eb861f9c86&lt;SEP&gt;chunk-dd396c45bc09fb646d156b4e69d328e3&lt;SEP&gt;chunk-ea9b3836b3275f451c3acfb189f42a6f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1786318506</data>
  <data key="d6"></data>
</node>
<node id="Anaphylaxis">
  <data key="d0">Anaphylaxis</data>
  <data key="d1">concept</data>
  <data key="d2">Anaphylaxis is a generalized severe allergic response that may accompany hypersensitivity to insulin.&lt;SEP&gt;Anaphylaxis refers to severe hypersensitivity reactions that can be life‑threatening and are described as very rare for Levemir®.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2&lt;SEP&gt;chunk-831f4bbfc884fc8e9679630a819083e9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317638</data>
  <data key="d6"></data>
</node>
<node id="Hypokalemia">
  <data key="d0">Hypokalemia</data>
  <data key="d1">concept</data>
  <data key="d2">Hypokalemia is a decrease in extracellular potassium caused by insulin‑induced shift of potassium into cells.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310041</data>
  <data key="d6"></data>
</node>
<node id="Potassium">
  <data key="d0">Potassium</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Potassium is an electrolyte whose plasma levels can fall during insulin therapy.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310042</data>
  <data key="d6"></data>
</node>
<node id="Intercurrent Diseases">
  <data key="d0">Intercurrent Diseases</data>
  <data key="d1">concept</data>
  <data key="d2">Intercurrent diseases such as vomiting or diarrhea can trigger hypoglycemic episodes.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310042</data>
  <data key="d6"></data>
</node>
<node id="Concomitant Medications">
  <data key="d0">Concomitant Medications</data>
  <data key="d1">concept</data>
  <data key="d2">Concomitant medications refer to other drugs taken alongside insulin that may interact and affect glucose levels.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310042</data>
  <data key="d6"></data>
</node>
<node id="Monitoring Metabolic">
  <data key="d0">Monitoring Metabolic</data>
  <data key="d1">method</data>
  <data key="d2">Metabolic monitoring is intensified when intercurrent diseases or other risk factors are present.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310043</data>
  <data key="d6"></data>
</node>
<node id="Respiratory Paralysis">
  <data key="d0">Respiratory Paralysis</data>
  <data key="d1">concept</data>
  <data key="d2">Respiratory paralysis is a severe complication that can result from untreated hypokalemia.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310043</data>
  <data key="d6"></data>
</node>
<node id="Ventricular Arrhythmia">
  <data key="d0">Ventricular Arrhythmia</data>
  <data key="d1">concept</data>
  <data key="d2">Ventricular arrhythmia is a potentially fatal heart rhythm disorder that may be triggered by severe hypokalemia.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310043</data>
  <data key="d6"></data>
</node>
<node id="Underlying Heart Disease">
  <data key="d0">Underlying Heart Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Underlying heart disease refers to pre‑existing cardiac conditions that increase risk of edema and heart failure when TZDs are combined with insulin.&lt;SEP&gt;Underlying Heart Disease is pre‑existing cardiac disease that amplifies heart failure risk in TZD‑insulin therapy.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2&lt;SEP&gt;chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310742</data>
  <data key="d6"></data>
</node>
<node id="Fasting Patients">
  <data key="d0">Fasting Patients</data>
  <data key="d1">concept</data>
  <data key="d2">Fasting patients are individuals who have not eaten for an extended period, listed as a risk factor for asymptomatic hypoglycemia.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310043</data>
  <data key="d6"></data>
</node>
<node id="Irregular Food Intake">
  <data key="d0">Irregular Food Intake</data>
  <data key="d1">concept</data>
  <data key="d2">Irregular food intake describes inconsistent eating patterns, cited as a factor that can predispose to asymptomatic hypoglycemia.</data>
  <data key="d3">chunk-45d489de28e8fda3c3be3bb09ab29eb2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310043</data>
  <data key="d6"></data>
</node>
<node id="Bebê Recém‑Nascido">
  <data key="d0">Bebê Recém‑Nascido</data>
  <data key="d1">person</data>
  <data key="d2">Bebê Recém‑Nascido is the newborn infant potentially exposed to insulin through breast milk.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310043</data>
  <data key="d6"></data>
</node>
<node id="Criança">
  <data key="d0">Criança</data>
  <data key="d1">person</data>
  <data key="d2">Criança denotes children aged two years or older who may receive Insulina Glargina; safety data for children under two are lacking.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Paciente Geriátrico">
  <data key="d0">Paciente Geriátrico</data>
  <data key="d1">person</data>
  <data key="d2">Paciente Geriátrico designates elderly patients for whom conservative insulin dosing is recommended to avoid hypoglycemia.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Preexistente">
  <data key="d0">Diabetes Preexistente</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Preexistente refers to pre‑existing diabetes in pregnant women managed with insulin therapy.&lt;SEP&gt;Pre‑existing diabetes refers to diabetes present before pregnancy, also managed with insulin.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-5b40c2fbad301807d9646f27d94635cb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Função Renal">
  <data key="d0">Função Renal</data>
  <data key="d1">concept</data>
  <data key="d2">Função Renal denotes kidney function whose progressive decline in elderly patients can lead to stable reductions in insulin needs.&lt;SEP&gt;Função Renal describes kidney performance, which influences insulin clearance and dosage requirements.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310740</data>
  <data key="d6"></data>
</node>
<node id="Metabolismo de Insulina">
  <data key="d0">Metabolismo de Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Metabolismo de Insulina is the physiological processing of insulin, which may be reduced in elderly or hepatic‑insufficient patients.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Carcinogênese">
  <data key="d0">Carcinogênese</data>
  <data key="d1">concept</data>
  <data key="d2">Carcinogênese is the potential for cancer formation, for which non‑clinical data showed no special risk from insulin exposure.&lt;SEP&gt;Carcinogenesis refers to the process of cancer development, for which no special risk was observed with insulin glargina.&lt;SEP&gt;Carcinogênese refers to the process of cancer development, mentioned as a potential risk of human insulin.&lt;SEP&gt;Processo de formação de câncer, avaliado nos estudos toxicológicos da insulina humana.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-5b40c2fbad301807d9646f27d94635cb&lt;SEP&gt;chunk-a247846b9ec5d44d0bcbe6c5f15599f8&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319736</data>
  <data key="d6"></data>
</node>
<node id="Mutagênese">
  <data key="d0">Mutagênese</data>
  <data key="d1">concept</data>
  <data key="d2">Mutagênese is the potential to cause genetic mutations, for which non‑clinical data indicated no special risk.&lt;SEP&gt;Mutagenesis is the induction of genetic mutations, for which no special risk was observed with insulin glargina.&lt;SEP&gt;Mutagênese is the induction of genetic mutations, discussed in relation to insulin exposure.&lt;SEP&gt;Alteração genética induzida por agentes, investigada em testes de insulina humana.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-5b40c2fbad301807d9646f27d94635cb&lt;SEP&gt;chunk-a247846b9ec5d44d0bcbe6c5f15599f8&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319736</data>
  <data key="d6"></data>
</node>
<node id="Danos à Fertilidade">
  <data key="d0">Danos à Fertilidade</data>
  <data key="d1">concept</data>
  <data key="d2">Danos à Fertilidade refers to possible fertility impairment, shown by non‑clinical data to lack special risk.&lt;SEP&gt;Fertility damage denotes harm to reproductive capacity, for which no special risk was found with insulin glargina.&lt;SEP&gt;Danos à Fertilidade denotes potential impairment of reproductive capacity associated with some insulin formulations.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-5b40c2fbad301807d9646f27d94635cb&lt;SEP&gt;chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310749</data>
  <data key="d6"></data>
</node>
<node id="Dados Não Clínicos">
  <data key="d0">Dados Não Clínicos</data>
  <data key="d1">data</data>
  <data key="d2">Dados Não Clínicos are non‑clinical study results indicating no special carcinogenic, mutagenic or reproductive toxicity risk for humans.&lt;SEP&gt;Pre‑clinical safety data indicating no observed risk for humans in toxicity, genotoxicity, carcinogenicity, and reproductive studies.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-e4e1124e7acf6619a1a7c60febd5211c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1786318536</data>
  <data key="d6"></data>
</node>
<node id="Meta‑Análise">
  <data key="d0">Meta‑Análise</data>
  <data key="d1">content</data>
  <data key="d2">Meta‑Análise is an eight‑study observational review comparing safety of Insulina Glargina and Insulina NPH in gestational and pre‑existing diabetes.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Estudos Clínicos Observacionais">
  <data key="d0">Estudos Clínicos Observacionais</data>
  <data key="d1">content</data>
  <data key="d2">Estudos Clínicos Observacionais are the eight observational clinical studies included in the meta‑analysis of insulin safety.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Farmacovigilância">
  <data key="d0">Farmacovigilância</data>
  <data key="d1">concept</data>
  <data key="d2">Farmacovigilância is post‑marketing monitoring that provided &gt;1,000 pregnancy reports showing no specific adverse effects of Insulina Glargina.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Categoria C">
  <data key="d0">Categoria C</data>
  <data key="d1">concept</data>
  <data key="d2">Categoria C is the pregnancy safety classification assigned to Insulina Glargina.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310044</data>
  <data key="d6"></data>
</node>
<node id="Inibidores da Enzima Conversora de Angiotensina">
  <data key="d0">Inibidores da Enzima Conversora de Angiotensina</data>
  <data key="d1">concept</data>
  <data key="d2">Inibidores da Enzima Conversora de Angiotensina (ECA) are ACE inhibitors that can heighten insulin‑induced hypoglycemia risk.&lt;SEP&gt;Inibidores da Enzima Conversora de Angiotensina (ECA) are ACE inhibitors that may lower insulin requirements.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-0851222a21a012cffce7a16710847208</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1786318530</data>
  <data key="d6"></data>
</node>
<node id="Disopiramida">
  <data key="d0">Disopiramida</data>
  <data key="d1">artifact</data>
  <data key="d2">Disopiramida is a medication listed as increasing insulin’s effect on blood‑glucose reduction.&lt;SEP&gt;Disopiramida is a drug that may modify the glucose‑lowering action of insulin glargina.&lt;SEP&gt;Disopiramida is a substance listed as intensifying the hypoglycemic effect of APIDRA SOLOSTAR.&lt;SEP&gt;A drug that, when used with insulin, increases insulin’s hypoglycemic action.&lt;SEP&gt;Substance listed as interacting with insulin to raise hypoglycemia risk.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6&lt;SEP&gt;chunk-cbede05ec60d9c79d637d9a0eb0efe48&lt;SEP&gt;chunk-dd2bfbe7cac15c6f6dc444a35691ae83</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Hipoglicemia_SBD_transcricao.docx</data>
  <data key="d5">1786338242</data>
  <data key="d6"></data>
</node>
<node id="Fibratos">
  <data key="d0">Fibratos</data>
  <data key="d1">artifact</data>
  <data key="d2">Fibratos are lipid‑lowering agents that may amplify insulin’s glucose‑lowering effect.&lt;SEP&gt;Fibratos are lipid‑lowering agents that can influence insulin glargina efficacy.&lt;SEP&gt;Fibratos are a class of substances listed as intensifying the hypoglycemic effect of APIDRA SOLOSTAR.&lt;SEP&gt;Lipid‑lowering drugs considered first‑line for refractory hypertriglyceridemia.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6&lt;SEP&gt;chunk-7eabee57ef0af575162ce8d36f3589a5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321218</data>
  <data key="d6"></data>
</node>
<node id="Fluoxetina">
  <data key="d0">Fluoxetina</data>
  <data key="d1">artifact</data>
  <data key="d2">Fluoxetina is an antidepressant that can increase insulin‑induced hypoglycemia susceptibility.&lt;SEP&gt;Fluoxetina is a selective serotonin reuptake inhibitor that may increase insulin glargina’s effect.&lt;SEP&gt;Fluoxetina is an oral antidepressant that can intensify the hypoglycemic effect of insulin.&lt;SEP&gt;Fluoxetina is a substance listed as intensifying the hypoglycemic effect of APIDRA SOLOSTAR.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6&lt;SEP&gt;chunk-d65840dd2cbd5c9984dfc4334378df5e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315336</data>
  <data key="d6"></data>
</node>
<node id="Inibidores da Monoamin Oxidase">
  <data key="d0">Inibidores da Monoamin Oxidase</data>
  <data key="d1">artifact</data>
  <data key="d2">Inibidores da Monoamin Oxidase are MAO inhibitors that may raise insulin’s glucose‑lowering potency.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310045</data>
  <data key="d6"></data>
</node>
<node id="Pentoxifilina">
  <data key="d0">Pentoxifilina</data>
  <data key="d1">artifact</data>
  <data key="d2">Pentoxifilina is a vasodilator that may potentiate insulin’s hypoglycemic action.&lt;SEP&gt;Pentoxifilina is a vasodilator that may increase insulin glargina activity.&lt;SEP&gt;Pentoxifilina is a substance listed as intensifying the hypoglycemic effect of APIDRA SOLOSTAR.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315336</data>
  <data key="d6"></data>
</node>
<node id="Salicilatos">
  <data key="d0">Salicilatos</data>
  <data key="d1">artifact</data>
  <data key="d2">Salicilatos are a class of salicylate compounds and medications that interact with insulin therapy. They are recognized for their ability to intensify the hypoglycemic action of insulin, including long‑acting formulations such as insulin glargine (commercially known as Apidra Solostar). By augmenting insulin’s glucose‑lowering effect, Salicilatos can reduce the amount of insulin required to achieve adequate glycemic control, allowing patients to use lower insulin doses while maintaining target blood‑glucose levels.

Because Salicilatos increase the potency of insulin’s action, their concomitant use raises the risk of hypoglycemia. Consequently, clinicians consider these compounds as agents that may both enhance therapeutic efficacy and necessitate careful monitoring of blood‑glucose levels to avoid excessive hypoglycemic episodes.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6&lt;SEP&gt;chunk-4615ca664e7ff898d8c5929cbc79e7d8&lt;SEP&gt;chunk-d6101c469482b48e341b4095a54907fd&lt;SEP&gt;chunk-ba6b31518be6fff1db8b68a28e82f200&lt;SEP&gt;chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbede05ec60d9c79d637d9a0eb0efe48&lt;SEP&gt;chunk-dd2bfbe7cac15c6f6dc444a35691ae83</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Hipoglicemia_SBD_transcricao.docx</data>
  <data key="d5">1786338259</data>
  <data key="d6"></data>
</node>
<node id="Análogos de Somatostatina">
  <data key="d0">Análogos de Somatostatina</data>
  <data key="d1">artifact</data>
  <data key="d2">Análogos de Somatostatina are somatostatin analogues that may increase insulin‑induced hypoglycemia risk.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310045</data>
  <data key="d6"></data>
</node>
<node id="Antibióticos Sulfonamidas">
  <data key="d0">Antibióticos Sulfonamidas</data>
  <data key="d1">artifact</data>
  <data key="d2">Antibióticos Sulfonamidas are sulfonamide antibiotics that can raise insulin’s glucose‑lowering effect.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310045</data>
  <data key="d6"></data>
</node>
<node id="Corticoides">
  <data key="d0">Corticoides</data>
  <data key="d1">artifact</data>
  <data key="d2">Corticoides are corticosteroid drugs that may diminish insulin’s glucose‑lowering effect.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310045</data>
  <data key="d6"></data>
</node>
<node id="Capacidade de Dirigir">
  <data key="d0">Capacidade de Dirigir</data>
  <data key="d1">concept</data>
  <data key="d2">Capacidade de Dirigir denotes the ability to operate a vehicle, which can be impaired by hypoglycemia or visual disturbances.&lt;SEP&gt;Habilidade de operar um veículo que pode ser prejudicada por hipoglicemia.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319737</data>
  <data key="d6"></data>
</node>
<node id="Metabolismo da Glicose">
  <data key="d0">Metabolismo da Glicose</data>
  <data key="d1">concept</data>
  <data key="d2">Metabolismo da Glicose is the physiological process of glucose metabolism that can be affected by various substances, influencing insulin dosing.&lt;SEP&gt;Metabolismo da Glicose is the overall regulation of glucose utilization and storage by insulin.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-a247846b9ec5d44d0bcbe6c5f15599f8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310750</data>
  <data key="d6"></data>
</node>
<node id="Doação de Leite Humano">
  <data key="d0">Doação de Leite Humano</data>
  <data key="d1">concept</data>
  <data key="d2">Doação de Leite Humano denotes the practice of donating human milk, with guidance needed for insulin presence.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310045</data>
  <data key="d6"></data>
</node>
<node id="Operar Máquinas">
  <data key="d0">Operar Máquinas</data>
  <data key="d1">concept</data>
  <data key="d2">Operar Máquinas is the activity of operating machinery, which may be compromised by hypoglycemia, hyperglycemia, or visual impairment.&lt;SEP&gt;Habilidade de manusear equipamentos que pode ser comprometida por hipoglicemia.</data>
  <data key="d3">chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319737</data>
  <data key="d6"></data>
</node>
