<node id="Basal-bolus">
  <data key="d0">Basal-bolus</data>
  <data key="d1">concept</data>
  <data key="d2">Basal-bolus denotes an insulin therapy regimen that combines basal (long‑acting) and bolus (rapid‑acting) insulin components.</data>
  <data key="d3">chunk-9ff211ed5ca723fa2074871af58a4eb8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316107</data>
  <data key="d6"></data>
</node>
