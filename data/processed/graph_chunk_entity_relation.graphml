</node>
<node id="AUC">
  <data key="d0">AUC</data>
  <data key="d1">data</data>
  <data key="d2">AUC (area under the concentration‑time curve) quantifies overall insulin exposure and was reported as similar between insulin aspart and regular insulin across studies.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
