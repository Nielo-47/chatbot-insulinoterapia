  <data key="d6"></data>
</node>
<node id="App Manager Device">
  <data key="d0">App Manager Device</data>
  <data key="d1">artifact</data>
  <data key="d2">The App Manager device is a compatible mobile device supplied by Medtronic that comes pre‑installed with the MiniMed Mobile app.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329645</data>
  <data key="d6"></data>
</node>
<node id="Compatible CGM Device">
  <data key="d0">Compatible CGM Device</data>
  <data key="d1">artifact</data>
  <data key="d2">A compatible CGM device refers to any CGM sensor approved for use with the MiniMed™ 780G system.&lt;SEP&gt;A compatible CGM device is composed of a glucose sensor, and optionally a transmitter, that communicates with the pump wirelessly.</data>
  <data key="d3">chunk-a764dcbdd73fd1c50fa72a7cd60b6e19&lt;SEP&gt;chunk-36ace822cd4873b8fd2adcfef0a7f9fd</data>
