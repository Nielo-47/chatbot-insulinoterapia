<node id="Pediatric">
  <data key="d0">Pediatric</data>
  <data key="d1">concept</data>
  <data key="d2">Pediatric refers to children aged two years and older who may be prescribed Lantus.</data>
  <data key="d3">chunk-572e715aada476f4dac69a032e16cc09</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
