  <data key="d5">1778707452</data>
  <data key="d6"></data>
</node>
<node id="SG Review And Graph Screens">
  <data key="d0">SG Review And Graph Screens</data>
  <data key="d1">content</data>
  <data key="d2">SG Review and Graph screens display historical therapy data when the Sensor feature is enabled on the MiniMed 780G system.</data>
  <data key="d3">chunk-39a29f6130bd8284c7277df75ae0e90d</data>
