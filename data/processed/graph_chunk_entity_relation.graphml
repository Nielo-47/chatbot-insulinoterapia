<node id="Administration Timing">
  <data key="d0">Administration Timing</data>
  <data key="d1">concept</data>
  <data key="d2">The specified interval before a meal at which insulin (APIDRA or human regular insulin) is administered.&lt;SEP&gt;Administration Timing refers to the scheduling of insulin doses relative to meals.</data>
  <data key="d3">chunk-891989adf06518cd34c94853444495e3&lt;SEP&gt;chunk-f2b8be67edef23560656776b89947c10</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324178</data>
  <data key="d6"></data>
</node>
<node id="Reação Adversa">
  <data key="d0">Reação Adversa</data>
  <data key="d1">concept</data>
  <data key="d2">Reação adversa encompasses any undesirable effect observed with insulin therapy, ranging from common to rare.</data>
  <data key="d3">chunk-0e7689ca0fc736d9eae94256f73fed52</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315500</data>
  <data key="d6"></data>
</node>
<node id="Reação Alérgica Sistêmica">
  <data key="d0">Reação Alérgica Sistêmica</data>
  <data key="d1">concept</data>
  <data key="d2">Reação alérgica sistêmica is a systemic allergic reaction to insulin, potentially severe and including rash, respiratory symptoms, and hypotension.</data>
  <data key="d3">chunk-0e7689ca0fc736d9eae94256f73fed52</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315500</data>
  <data key="d6"></data>
</node>
