</node>
<node id="Proline">
  <data key="d0">Proline</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Proline is an amino acid at position B28 in regular human insulin, replaced in NovoRapid®.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305915</data>
  <data key="d6"></data>
</node>
<node id="Aspartic Acid">
  <data key="d0">Aspartic Acid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Aspartic acid is the amino acid that replaces proline at position B28 in NovoRapid®, facilitating faster absorption.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305915</data>
  <data key="d6"></data>
</node>
<node id="Fetal Health">
  <data key="d0">Fetal Health</data>
  <data key="d1">concept</data>
  <data key="d2">Fetal health refers to the well‑being of the fetus/newborn, assessed for safety of insulin aspart during pregnancy.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305915</data>
  <data key="d6"></data>
</node>
<node id="Night‑time Hypoglycemia">
  <data key="d0">Night‑time Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Night‑time hypoglycemia denotes low blood glucose events occurring during sleep, risk reduced by insulin aspart.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305916</data>
  <data key="d6"></data>
</node>
<node id="Daytime Hypoglycemia">
  <data key="d0">Daytime Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Daytime hypoglycemia denotes low blood glucose events occurring during waking hours, not significantly increased by insulin aspart.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305916</data>
  <data key="d6"></data>
</node>
<node id="Post‑prandial Glucose Control">
  <data key="d0">Post‑prandial Glucose Control</data>
  <data key="d1">concept</data>
  <data key="d2">Post‑prandial glucose control refers to the regulation of blood glucose after meals, shown to improve with insulin aspart in gestational diabetes.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
