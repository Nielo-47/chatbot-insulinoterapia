<node id="Long‑acting Insulin">
  <data key="d0">Long‑acting Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Long‑acting insulin (slow insulin) is a type of insulin used as a reference for dose changes when switching to Humalog.</data>
  <data key="d3">chunk-c3daabbd42055dc30154f5f97c85fb7d</data>
