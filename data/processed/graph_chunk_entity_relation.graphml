  <data key="d0">Intermittently Scanned Continuous Glucose Monitoring B</data>
  <data key="d1">artifact</data>
  <data key="d2">Intermittently scanned continuous glucose monitoring B is a CGM device recommended for adults with diabetes on multiple daily injections or continuous subcutaneous insulin infusion.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335922</data>
