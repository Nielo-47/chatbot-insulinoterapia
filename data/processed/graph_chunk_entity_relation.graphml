<node id="High Fat And Protein Meals">
  <data key="d0">High Fat And Protein Meals</data>
  <data key="d1">concept</data>
  <data key="d2">Meals high in fat and protein delay glucose absorption into the bloodstream, requiring adjusted insulin bolus timing.</data>
  <data key="d3">chunk-75fbd29c63ccce2c6bea49f0301c1cf5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
