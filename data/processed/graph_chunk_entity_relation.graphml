  <data key="d0">Apidra Pós-Refeição</data>
  <data key="d1">method</data>
  <data key="d2">Apidra Pós-Refeição is the post‑meal dosing regimen of Apidra administered 15 minutes after the start of a meal.</data>
  <data key="d3">chunk-f46c503a378e6c69618036a038672417</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315401</data>
  <data key="d6"></data>
</node>
