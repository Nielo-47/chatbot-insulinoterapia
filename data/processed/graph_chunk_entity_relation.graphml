</edge>
<edge source="Alert Silence" target="High SG Alert">
  <data key="d8">1.0</data>
  <data key="d9">High SG Alert cannot be silenced by the Alert Silence feature and remains active when glucose levels exceed 250 mg/dL for over three hours.</data>
