</node>
<node id="Produção Hepática de Glicose">
  <data key="d0">Produção Hepática de Glicose</data>
  <data key="d1">concept</data>
  <data key="d2">Produção hepática de glicose denotes the generation of glucose by the liver, a process inhibited by insulin.</data>
  <data key="d3">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
