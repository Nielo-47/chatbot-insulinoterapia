  <data key="d0">Insulin U200</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin U200 is an alternative insulin concentration mentioned for use in some countries.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
