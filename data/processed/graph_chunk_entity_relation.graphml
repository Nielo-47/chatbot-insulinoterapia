</node>
<node id="Pre-sleep Glucose Check">
  <data key="d0">Pre-sleep Glucose Check</data>
  <data key="d1">concept</data>
  <data key="d2">Pre-sleep Glucose Check is the practice of checking blood glucose before going to bed to ensure it is above 100 mg/dL.</data>
  <data key="d3">chunk-4b9f6a4a440ccb40e47c326ca6dd9346</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324115</data>
  <data key="d6"></data>
</node>
<node id="Driving Glucose Target">
  <data key="d0">Driving Glucose Target</data>
  <data key="d1">concept</data>
  <data key="d2">Driving Glucose Target is the recommended glucose level to be above the target before operating a vehicle.</data>
  <data key="d3">chunk-4b9f6a4a440ccb40e47c326ca6dd9346</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324115</data>
  <data key="d6"></data>
</node>
<node id="Traffic Regulations">
  <data key="d0">Traffic Regulations</data>
  <data key="d1">concept</data>
  <data key="d2">Traffic Regulations are rules of the road discussed with the medical team.</data>
  <data key="d3">chunk-4b9f6a4a440ccb40e47c326ca6dd9346</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324115</data>
