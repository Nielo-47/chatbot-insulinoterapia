  <data key="d6"></data>
</node>
<node id="Carbohydrate Intake (150 g/day)">
  <data key="d0">Carbohydrate Intake (150 g/day)</data>
  <data key="d1">concept</data>
  <data key="d2">A minimum intake of 150 g of carbohydrate per day for three days is recommended before oral glucose tolerance testing.</data>
  <data key="d3">chunk-3cc61bc2e95346d553972b4371912e7f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
