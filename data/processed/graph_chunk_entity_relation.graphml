  <data key="d14"></data>
</edge>
<edge source="Medical Prescription" target="Syringe">
  <data key="d8">1.0</data>
  <data key="d9">Unclear prescriptions using abbreviations contribute to the misuse of syringes not designed for insulin, increasing error risk.</data>
  <data key="d10">dosing accuracy,prescription clarity</data>
