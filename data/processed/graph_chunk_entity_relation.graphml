<edge source="MiniMed 780G Insulin Pump" target="Block Mode">
  <data key="d8">1.0</data>
  <data key="d9">Block mode restricts access to critical functions on the MiniMed 780G insulin pump, allowing caregivers to lock the device after inactivity.</data>
