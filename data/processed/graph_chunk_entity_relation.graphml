</node>
<node id="Mag C">
  <data key="d0">Mag C</data>
  <data key="d1">person</data>
  <data key="d2">Mag C is a listed author in a study on the long-acting insulin analog detemir, contributing to diabetes research.</data>
  <data key="d3">chunk-ced7d025f7f3232d1a0e28251b0fb63a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698101</data>
  <data key="d6"></data>
</node>
<node id="Görz E">
  <data key="d0">Görz E</data>
  <data key="d1">person</data>
  <data key="d2">Görz E is one of the authors of a clinical study on insulin detemir’s pharmacokinetic and pharmacodynamic properties.</data>
  <data key="d3">chunk-ced7d025f7f3232d1a0e28251b0fb63a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698102</data>
  <data key="d6"></data>
</node>
<node id="Regitnig W">
  <data key="d0">Regitnig W</data>
  <data key="d1">person</data>
  <data key="d2">Regitnig W is a co-author of a study analyzing insulin detemir’s dose-response relationship in diabetic patients.</data>
  <data key="d3">chunk-ced7d025f7f3232d1a0e28251b0fb63a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698102</data>
  <data key="d6"></data>
</node>
<node id="Zdravkov M">
  <data key="d0">Zdravkov M</data>
  <data key="d1">person</data>
  <data key="d2">Zdravkov M is a co-author of a clinical study on insulin detemir, providing scientific validation for its use.</data>
  <data key="d3">chunk-ced7d025f7f3232d1a0e28251b0fb63a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698102</data>
  <data key="d6"></data>
</node>
<node id="Gu Cev Z">
  <data key="d0">Gu Cev Z</data>
  <data key="d1">person</data>
  <data key="d2">Gu Cev Z is a researcher involved in the clinical comparison of insulin detemir and NPH insulin.</data>
  <data key="d3">chunk-ced7d025f7f3232d1a0e28251b0fb63a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698102</data>
  <data key="d6"></data>
</node>
<node id="Novo Nordisk Farmacêutica do Brasil Ltda.">
  <data key="d0">Novo Nordisk Farmacêutica do Brasil Ltda.</data>
  <data key="d1">organization</data>
  <data key="d2">Novo Nordisk Farmacêutica do Brasil Ltda. is the Brazilian importer and registrant of Levemir® FlexPen®, located in São Paulo, SP, with CNPJ 82.277.955/0001-55.&lt;SEP&gt;Novo Nordisk Farmacêutica do Brasil Ltda. is the Brazilian subsidiary responsible for importing, registering, and distributing Novolin® R in Brazil.</data>
  <data key="d3">chunk-6ca90008a805c9c66eac7ba65db90fdb&lt;SEP&gt;chunk-4db353458c93e1b1abc9f696ebf195a9</data>
