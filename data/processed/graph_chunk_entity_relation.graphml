  <data key="d6"></data>
</node>
<node id="Current Basal Index">
  <data key="d0">Current Basal Index</data>
  <data key="d1">data</data>
  <data key="d2">Current basal index represents the ongoing basal insulin delivery rate.</data>
  <data key="d3">chunk-28e93fcffd71ed0c035f0b03374608e5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1778704113</data>
  <data key="d6"></data>
</node>
<node id="Estimated Reservoir Volume">
  <data key="d0">Estimated Reservoir Volume</data>
  <data key="d1">data</data>
  <data key="d2">Estimated reservoir volume is the calculated amount of insulin remaining in the pump's reservoir.</data>
  <data key="d3">chunk-28e93fcffd71ed0c035f0b03374608e5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
