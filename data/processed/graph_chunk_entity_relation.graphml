</edge>
<edge source="Diabetes Type 1" target="Children and Adolescents with Type 1 Diabetes">
  <data key="d8">1.0</data>
  <data key="d9">Children and adolescents with Type 1 Diabetes are a specific patient group defined by the type of diabetes they have.</data>
  <data key="d10">disease classification,patient group</data>
