  <data key="d13"></data>
</edge>
<edge source="Hyperglycemia" target="Intradermal Route">
  <data key="d7">1.0</data>
  <data key="d8">Intradermal Route increases risk of Hyperglycemia due to slow insulin absorption.</data>
  <data key="d9">hyperglycemia,risk</data>
