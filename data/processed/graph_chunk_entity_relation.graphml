<node id="Análogo de Ação Rápida">
  <data key="d0">Análogo de Ação Rápida</data>
  <data key="d1">concept</data>
  <data key="d2">Análogo de ação rápida is a rapid‑acting insulin analogue that can be mixed with intermediate‑acting insulin in the same syringe.</data>
  <data key="d3">chunk-8d870035815524d8e4f6b0d6b05e5c2a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
