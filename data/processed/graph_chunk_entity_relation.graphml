  <data key="d13">1778707534</data>
  <data key="d14"></data>
</edge>
<edge source="Suspend Before Low" target="Suspend By Sensor Icon">
  <data key="d8">1.0</data>
  <data key="d9">The suspend by sensor icon with a red X indicates that the Suspend before low feature is currently unavailable.</data>
  <data key="d10">feature status,unavailability indicator</data>
  <data key="d11">chunk-03820ea21d982bc029e8a55fe1be600a</data>
