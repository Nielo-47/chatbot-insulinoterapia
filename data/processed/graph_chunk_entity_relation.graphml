</edge>
<edge source="Bomba De Insulina" target="Ajuste De Alarmas">
  <data key="d8">1.0</data>
  <data key="d9">Ajuste de alarmas involves modifying alert settings on the bomba de insulina.</data>
  <data key="d10">alert management,system configuration</data>
