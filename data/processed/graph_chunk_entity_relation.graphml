  <data key="d13">1778707632</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus Wizard" target="Active Insulin Time">
  <data key="d8">5.0</data>
  <data key="d9">Bolus Wizard considers active insulin time to avoid overdosing by accounting for insulin still working in the body.&lt;SEP&gt;The active insulin time setting prevents insulin stacking by informing the Bolus Wizard how long previous doses remain active.&lt;SEP&gt;The Bolus Wizard uses the Active Insulin Time setting to estimate remaining active insulin and adjust correction bolus calculations accordingly.&gt;&lt;SEP&gt;The Active Insulin Time is used by the Bolus Wizard to estimate remaining insulin and adjust correction bolus amounts.&lt;SEP&gt;Active Insulin Time setting prevents excessive insulin delivery by accounting for insulin still active in the body.</data>
  <data key="d10">configuration dependency,dose calculation,insulin activity tracking,insulin management,insulin on board,insulin stacking,safety,safety calculation</data>
  <data key="d11">chunk-1ef4fd0fa0c26a81460d7687cc37cf95&lt;SEP&gt;chunk-fe3d4956e4290b26b4d22092a403c4d6&lt;SEP&gt;chunk-e2ad78a5db5d547aed7e2552fb1ec900&lt;SEP&gt;chunk-14b0e9023a7c03c6a284d69e0930b8a9&lt;SEP&gt;chunk-73b840edccb54a2c256450df95d80f4f</data>
