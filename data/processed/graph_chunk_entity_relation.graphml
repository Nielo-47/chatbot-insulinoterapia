  <data key="d12">1786332474</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Rash">
  <data key="d7">1.0</data>
  <data key="d8">Injection site and skin reactions such as rash are reported with insulin use.</data>
  <data key="d9">adverse effect,skin reaction</data>
  <data key="d10">chunk-4da80e99fd3e43cb7d3b260aca23fe56</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
  <data key="d12">1786304237</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Urticaria">
  <data key="d7">1.0</data>
  <data key="d8">Urticaria, an allergic skin eruption, can occur as a reaction to insulin.</data>
  <data key="d9">allergic,skin reaction</data>
  <data key="d10">chunk-4da80e99fd3e43cb7d3b260aca23fe56</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
  <data key="d12">1786304237</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Angioedema">
  <data key="d7">2.0</data>
  <data key="d8">Insulin use may be associated with generalized cutaneous reactions including angioedema.&lt;SEP&gt;Insulin may cause angioedema, a severe allergic reaction that can be life‑threatening.</data>
  <data key="d9">adverse reaction,allergy,severe allergic reaction</data>
  <data key="d10">chunk-4da80e99fd3e43cb7d3b260aca23fe56&lt;SEP&gt;chunk-d194d06ef99b3f8aa6b6542b7e93e762</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d12">1786310093</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Broncoespasm">
  <data key="d7">1.0</data>
  <data key="d8">Insulin administration may lead to broncoespasm.</data>
  <data key="d9">respiratory adverse effect</data>
  <data key="d10">chunk-4da80e99fd3e43cb7d3b260aca23fe56</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
  <data key="d12">1786304238</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Shock">
  <data key="d7">2.0</data>
  <data key="d8">Severe reactions to insulin can include shock.&lt;SEP&gt;Shock is listed among the potentially fatal adverse events linked to insulin.</data>
  <data key="d9">adverse reaction,life‑threatening,life‑threatening reaction</data>
  <data key="d10">chunk-4da80e99fd3e43cb7d3b260aca23fe56&lt;SEP&gt;chunk-d194d06ef99b3f8aa6b6542b7e93e762</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
