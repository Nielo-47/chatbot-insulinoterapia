  <data key="d6"></data>
</node>
<node id="Fin">
  <data key="d0">Fin</data>
  <data key="d1">concept</data>
  <data key="d2">Fin refers to the end time of a basal insulin infusion segment within a basal pattern configuration.&lt;SEP&gt;Fin denotes the end time of a specific basal rate segment within a basal pattern.</data>
  <data key="d3">chunk-1134674d4e1ab07998567f3fa77e251d&lt;SEP&gt;chunk-3b28f926a642d5f692433ed41fafafa4</data>
