  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698251</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Hidróxido de Sódio">
  <data key="d8">1.0</data>
  <data key="d9">Hidróxido de sódio is used in Levemir formulation to adjust and stabilize pH.</data>
  <data key="d10">formulation component,pH adjustment</data>
  <data key="d11">chunk-d80de93eae49980367cf11700b83b1ee</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698251</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Ácido Clorídrico">
  <data key="d8">1.0</data>
  <data key="d9">Ácido clorídrico is used in Levemir formulation to adjust pH as needed.</data>
  <data key="d10">formulation component,pH adjustment</data>
  <data key="d11">chunk-d80de93eae49980367cf11700b83b1ee</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698252</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Água para Injetáveis">
  <data key="d8">1.0</data>
  <data key="d9">Água para injetáveis is the solvent used in the preparation of the Levemir injectable solution.</data>
  <data key="d10">formulation component,solvent</data>
  <data key="d11">chunk-d80de93eae49980367cf11700b83b1ee</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698253</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Fosfato de Sódio Dibásico Di-Hidratado">
  <data key="d8">1.0</data>
  <data key="d9">Fosfato de sódio dibásico di-hidratado acts as a buffer in Levemir to maintain pH stability.</data>
  <data key="d10">buffer,formulation component</data>
  <data key="d11">chunk-d80de93eae49980367cf11700b83b1ee</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698254</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="NovoFine">
  <data key="d8">1.0</data>
  <data key="d9">Levemir is intended to be used with NovoFine disposable needles for subcutaneous injection.</data>
  <data key="d10">compatible equipment,injection method</data>
  <data key="d11">chunk-bc07da1fd30cc15e0022830f701a9c38</data>
