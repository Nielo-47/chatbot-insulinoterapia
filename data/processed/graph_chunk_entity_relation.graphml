  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Driving Ability">
  <data key="d7">2.0</data>
  <data key="d8">Hypoglycemia can reduce concentration and reaction speed, increasing risk while driving or operating machinery.&lt;SEP&gt;Hypoglycemia can impair concentration and reaction time, posing a risk when driving or operating machinery.</data>
  <data key="d9">impairment,safety,safety risk</data>
  <data key="d10">chunk-4319d08c10ed2b48857a6d42eadd9db0&lt;SEP&gt;chunk-d10a1f849386df540104c79e33a7b242</data>
