<edge source="Type 1 Diabetes" target="Diabetes">
  <data key="d8">1.0</data>
  <data key="d9">Type 1 diabetes is a specific form of diabetes characterized by insulin deficiency.</data>
  <data key="d10">classification,disease subtype</data>
