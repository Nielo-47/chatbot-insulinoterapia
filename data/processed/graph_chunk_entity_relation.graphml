</node>
<node id="James Havens">
  <data key="d0">James Havens</data>
  <data key="d1">person</data>
  <data key="d2">James Havens, the son of an Eastman Kodak executive, received the first insulin dose administered in the United States.</data>
  <data key="d3">chunk-9043f44e67d9ed02b4864043d3cbb59a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
