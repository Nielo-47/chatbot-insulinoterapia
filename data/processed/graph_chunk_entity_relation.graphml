  <data key="d0">Diabetes Metabolism Journal</data>
  <data key="d1">content</data>
  <data key="d2">Diabetes Metabolism Journal published the study describing the glutamic acid decarboxylase autoantibody assay.\</data>
  <data key="d3">chunk-3a15ed0aa8749d4f76e8d725e8752873</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
