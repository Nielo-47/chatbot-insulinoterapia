  <data key="d0">Progeria de Hutchinson‑Gilford</data>
  <data key="d1">concept</data>
  <data key="d2">A premature‑aging syndrome classified as a laminopathy.</data>
  <data key="d3">chunk-383b02cc66391d66174344ff49464766</data>
