</edge>
<edge source="Glucometer" target="Blood Glucose">
  <data key="d8">1.0</data>
  <data key="d9">The glucometer measures blood glucose levels to help manage diabetes.</data>
  <data key="d10">diabetes care,glucose monitoring</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
