  <data key="d13">1778707988</data>
  <data key="d14"></data>
</edge>
<edge source="Battery" target="Home Screen">
  <data key="d8">1.0</data>
  <data key="d9">The Home screen appears after the battery is changed, indicating a system restart or power cycle.</data>
  <data key="d10">interface display,power event trigger</data>
  <data key="d11">chunk-8a6d7d1adf71e2872a4ddf28d3170247</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707995</data>
  <data key="d14"></data>
</edge>
<edge source="Battery" target="Battery Failed Alarm">
  <data key="d8">1.0</data>
  <data key="d9">Battery failed alarm indicates the battery is no longer functioning and must be replaced.</data>
  <data key="d10">power failure,system alert</data>
  <data key="d11">chunk-e2ad78a5db5d547aed7e2552fb1ec900</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708076</data>
  <data key="d14"></data>
</edge>
