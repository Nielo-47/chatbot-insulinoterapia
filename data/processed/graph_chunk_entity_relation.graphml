<node id="Ajustes de Infusion">
  <data key="d0">Ajustes de Infusion</data>
  <data key="d1">method</data>
  <data key="d2">Ajustes de Infusion is a menu option used to access infusion-related configurations, including basal pattern settings.</data>
  <data key="d3">chunk-1134674d4e1ab07998567f3fa77e251d</data>
