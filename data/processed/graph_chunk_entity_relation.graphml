  <data key="d13"></data>
</edge>
<edge source="A1C" target="Mean Glucose Concentration">
  <data key="d7">1.0</data>
  <data key="d8">A1C levels are correlated with mean glucose concentration, with variations observed when using continuous glucose monitoring.</data>
  <data key="d9">correlation</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377556</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Glycemic Burden">
  <data key="d7">1.0</data>
  <data key="d8">Elevated A1C indicates a higher glycemic burden on the body.</data>
  <data key="d9">indicator</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377557</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Hemoglobinopathies">
  <data key="d7">2.0</data>
  <data key="d8">Hemoglobinopathies can cause interference with A1C measurements.&lt;SEP&gt;Hemoglobinopathies may cause interference in A1C measurements.</data>
  <data key="d9">assay interference,interference,measurement bias</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d&lt;SEP&gt;chunk-3cc61bc2e95346d553972b4371912e7f</data>
