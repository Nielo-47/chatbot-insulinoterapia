  <data key="d5">1786377310</data>
  <data key="d6"></data>
</node>
<node id="Estimated Average Glucose">
  <data key="d0">Estimated Average Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Estimated average glucose is a calculated data value derived from the A1C assay to reflect average blood glucose.&lt;SEP&gt;Calculated average blood glucose level derived from HbA1c values.&lt;SEP&gt;Glucose value estimated from HbA1c assay, discussed in the Nathan et al. 2008 study.&lt;SEP&gt;Estimated average glucose is a metric derived from the A1C assay to represent average blood glucose levels.</data>
  <data key="d3">chunk-679002669c87907578534904694e17dc&lt;SEP&gt;chunk-c5c8fa42a8437c5708b04fb4ad1272cf&lt;SEP&gt;chunk-ad23b9b7ef0802d02c046415e54e3fcf&lt;SEP&gt;chunk-b2cd796639bdb0e10eeda7ef3d9ebbce</data>
