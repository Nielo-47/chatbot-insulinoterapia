  <data key="d13">1778702698</data>
  <data key="d14"></data>
</edge>
<edge source="Hyperglycemia" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Inadequate dosing or discontinuation of Novolin® R FlexPen® can lead to hyperglycemia, especially in type 1 diabetes.</data>
  <data key="d10">condition management,treatment indication</data>
  <data key="d11">chunk-849980827afbc1e3097aed3d19640efe</data>
