  <data key="d5">1786337563</data>
  <data key="d6"></data>
</node>
<node id="Hiperuricemia">
  <data key="d0">Hiperuricemia</data>
  <data key="d1">concept</data>
  <data key="d2">Elevated uric acid levels that can affect the reliability of glucose test results.&lt;SEP&gt;Hiperuricemia is a laboratory condition of elevated uric acid levels listed as an abnormal finding.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb&lt;SEP&gt;chunk-8fe1b07f3c84733fcbfca023fbfd70e6</data>
