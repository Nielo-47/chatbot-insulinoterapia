  <data key="d0">Pre-prandial</data>
  <data key="d1">concept</data>
  <data key="d2">Pre-prandial describes the period or treatment administered before a meal.</data>
  <data key="d3">chunk-9ff211ed5ca723fa2074871af58a4eb8</data>
