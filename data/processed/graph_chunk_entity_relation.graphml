<edge source="Needle" target="NovoRapid® FlexPen®">
  <data key="d7">1.0</data>
  <data key="d8">The insulin pen requires disposable needles that must not be shared and are discarded after each injection.</data>
  <data key="d9">non‑shareable,uses</data>
  <data key="d10">chunk-9725072a361e9b1b97c5daa35e061e58</data>
