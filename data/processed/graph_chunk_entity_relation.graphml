  <data key="d13"></data>
</edge>
<edge source="Automated Insulin Delivery (AID) Systems" target="Inhaled Insulin (TI)">
  <data key="d7">1.0</data>
  <data key="d8">Inhaled insulin could address the constraints of AID systems that rely on subcutaneous RAA insulin.</data>
  <data key="d9">potential,solution</data>
  <data key="d10">chunk-127dc0e8b8b960bfd1fce3df4f590120</data>
