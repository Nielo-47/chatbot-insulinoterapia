</edge>
<edge source="Humulin R" target="Concomitant Diseases">
  <data key="d8">1.0</data>
  <data key="d9">Concomitant diseases such as adrenal, pituitary, or thyroid disorders and renal or hepatic failure can significantly alter insulin requirements when using Humulin R.</data>
  <data key="d10">dosage change,medical influence</data>
  <data key="d11">chunk-128e097e2326548df575159ee000923b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699637</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Dietary Habits">
  <data key="d8">1.0</data>
  <data key="d9">Changes in dietary habits can affect the required dose of Humulin R.</data>
  <data key="d10">dosage adjustment,lifestyle factor</data>
  <data key="d11">chunk-128e097e2326548df575159ee000923b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699639</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Renal Failure">
  <data key="d8">1.0</data>
  <data key="d9">Patients with renal failure may require reduced doses of Humulin R.</data>
  <data key="d10">dosage reduction,medical condition</data>
  <data key="d11">chunk-128e097e2326548df575159ee000923b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699642</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Hepatic Failure">
  <data key="d8">1.0</data>
  <data key="d9">Patients with hepatic failure require careful glucose monitoring and insulin dose adjustments when using Humulin R.</data>
  <data key="d10">glucose monitoring,medical condition</data>
  <data key="d11">chunk-128e097e2326548df575159ee000923b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699643</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Children Under 3 Years">
  <data key="d8">1.0</data>
