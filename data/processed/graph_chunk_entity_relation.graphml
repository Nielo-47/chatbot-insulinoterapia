<edge source="Levemir" target="Change Of Insulin">
  <data key="d8">1.0</data>
  <data key="d9">Switching to or from Levemir requires strict medical supervision due to potential differences in insulin types or brands.&gt;</data>
  <data key="d10">medical supervision,treatment transition</data>
  <data key="d11">chunk-7a4232687a569d10d6942d933172488f</data>
