  <data key="d5">1786331417</data>
  <data key="d6"></data>
</node>
<node id="Type 2 Diabetes Mellitus">
  <data key="d0">Type 2 Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">A metabolic disorder characterized by insulin resistance, frequently studied in the context of insulin education and injection techniques.&lt;SEP&gt;A form of diabetes where patients often require insulin therapy within the first five years after diagnosis.&lt;SEP&gt;A form of diabetes mellitus primarily caused by insulin resistance and often screened for in adults.&lt;SEP&gt;Type 2 Diabetes Mellitus is a chronic metabolic disease characterized by high blood glucose and insulin resistance.&lt;SEP&gt;Chronic form of diabetes characterized by insulin resistance, examined for markers during pregnancy.&lt;SEP&gt;A common form of diabetes characterized by insulin resistance.</data>
  <data key="d3">chunk-e480a6a15b0d8e7069746e3f3f788f80&lt;SEP&gt;chunk-c96221c60c19f02ac6efa6a987b1e15b&lt;SEP&gt;chunk-8393954b021d0ad02018d1a449e0cc93&lt;SEP&gt;chunk-3c6dca13b685243e63fb6f24f7cb301d&lt;SEP&gt;chunk-c83accc14a3b482690949ff04716a0aa&lt;SEP&gt;chunk-525031caa389d084bc170433212cdca8</data>
