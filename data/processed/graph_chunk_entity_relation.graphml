</edge>
<edge source="Caneta de Insulina" target="Fluxo de Saída da Caneta de Insulina">
  <data key="d7">1.0</data>
  <data key="d8">Before dosing, the insulin pen’s flow is tested with 1–2 units to confirm a drop at the needle tip.</data>
  <data key="d9">procedure,verification</data>
  <data key="d10">chunk-8d870035815524d8e4f6b0d6b05e5c2a</data>
