</node>
<node id="Sensor-Augmented Pump">
  <data key="d0">Sensor-Augmented Pump</data>
  <data key="d1">artifact</data>
  <data key="d2">Sensor-Augmented Pump is an insulin pump integrated with continuous glucose monitoring that can suspend insulin delivery when glucose is low.</data>
  <data key="d3">chunk-9cd925790899146eeb8a373879b5feac</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
