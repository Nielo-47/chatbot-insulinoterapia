  <data key="d0">Camundongos</data>
  <data key="d1">creature</data>
  <data key="d2">Camundongos (mice) are a laboratory rodent species used in acute, chronic, carcinogenic and reproductive toxicity studies of insulin glargina.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
