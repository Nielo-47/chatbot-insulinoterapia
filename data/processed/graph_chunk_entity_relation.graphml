  <data key="d12">1786330246</data>
  <data key="d13"></data>
</edge>
<edge source="Instinct Sensor" target="Vitamin C">
  <data key="d7">1.0</data>
  <data key="d8">High intake of Vitamin C can falsely raise glucose readings from the Instinct sensor, risking insulin over‑delivery.</data>
  <data key="d9">false elevation,interference</data>
  <data key="d10">chunk-db5749bec4af1c3ea068b257c4376aaf</data>
