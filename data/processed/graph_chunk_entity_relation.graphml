<edge source="Dose Adjustment" target="Insulin Transfer">
  <data key="d8">1.0</data>
  <data key="d9">Switching insulin types or brands requires careful dose adjustment and medical oversight due to potential differences in pharmacological effects.</data>
  <data key="d10">medical supervision,treatment change</data>
  <data key="d11">chunk-df59f6460ce09b02f1576e31831b6eb7</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699011</data>
  <data key="d14"></data>
</edge>
<edge source="Dose Adjustment" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">Dose Adjustment of Novolin® R may be necessary during illnesses, changes in physical activity, or dietary changes.</data>
  <data key="d10">medical condition,treatment modification</data>
  <data key="d11">chunk-2d59277cc4b25262a26a88992bfb526f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699067</data>
  <data key="d14"></data>
</edge>
<edge source="Injection Site Reaction" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R FlexPen® may cause injection site reactions such as pain, redness, and swelling, which can sometimes require discontinuation of the medication.</data>
  <data key="d10">adverse effect,medication safety</data>
  <data key="d11">chunk-a0ee5ffd422bf5c38703d11eefbcff6f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699157</data>
  <data key="d14"></data>
</edge>
<edge source="Allergic Reaction" target="HUMULIN R">
  <data key="d8">1.0</data>
  <data key="d9">HUMULIN R may cause allergic reactions ranging from local skin reactions to rare but severe systemic responses.</data>
  <data key="d10">adverse effect,immune response</data>
  <data key="d11">chunk-2df8f5e1333eed2f8c4d2dca734d5e21</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699628</data>
  <data key="d14"></data>
</edge>
<edge source="Insulinas De Ação Intermediária" target="Insulinas De Ação Prolongada">
  <data key="d8">1.0</data>
  <data key="d9">Insulinas de ação intermediária e prolongada são categorias farmacológicas de insulina que diferem na duração do efeito e no perfil de liberação.</data>
  <data key="d10">insulin classification,pharmacological category</data>
  <data key="d11">chunk-61071ebd09f043bc8e0041fda9bdf64a</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698315</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodistrofia" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Lipodistrofia can occur at the injection site when using Novolin® R FlexPen®, potentially delaying local insulin absorption.</data>
  <data key="d10">absorption impact,injection site reaction</data>
  <data key="d11">chunk-1954b944b779698ff7d67b256199d202</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699101</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodistrofia" target="Tratamento Da Hipoglicemia">
  <data key="d8">1.0</data>
  <data key="d9">Continuous rotation of injection sites within a region is recommended to help reduce or prevent lipodistrofia, which can affect insulin absorption and contribute to glycemic instability.</data>
  <data key="d10">prevention strategy,site rotation</data>
  <data key="d11">chunk-1954b944b779698ff7d67b256199d202</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699102</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodistrofia" target="Insulin Injection Site">
  <data key="d8">1.0</data>
  <data key="d9">Lipodistrofia can develop at the insulin injection site and may impair local insulin absorption.</data>
  <data key="d10">absorption interference,tissue alteration</data>
  <data key="d11">chunk-1229dbbfb74d991d522a8d53f9383cdc</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699222</data>
  <data key="d14"></data>
</edge>
<edge source="Lipodistrofia" target="Insulina Humana">
  <data key="d8">1.0</data>
  <data key="d9">Repeated insulin injections in areas with lipodystrophy can lead to poor absorption and hyperglycemia.</data>
  <data key="d10">hyperglycemia risk,injection site complication</data>
  <data key="d11">chunk-b24ac2a9beff09325af7272be567cf82</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699713</data>
  <data key="d14"></data>
</edge>
<edge source="Amiloidose Cutânea" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Amiloidose cutânea, with unknown frequency, may develop at the injection site of Novolin® R FlexPen® and impair insulin absorption.</data>
  <data key="d10">absorption impact,injection site reaction</data>
  <data key="d11">chunk-1954b944b779698ff7d67b256199d202</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699102</data>
  <data key="d14"></data>
</edge>
<edge source="Amiloidose Cutânea" target="Insulin Injection Site">
  <data key="d8">1.0</data>
  <data key="d9">Amiloidose cutânea may occur at the injection site and interfere with insulin absorption, though its frequency is unknown.</data>
  <data key="d10">absorption delay,tissue deposition</data>
  <data key="d11">chunk-1229dbbfb74d991d522a8d53f9383cdc</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699223</data>
  <data key="d14"></data>
</edge>
<edge source="Reações Anafiláticas" target="Insulina Humana">
  <data key="d8">1.0</data>
  <data key="d9">Reações anafiláticas are rare but potentially life-threatening hypersensitivity reactions that can occur in response to insulina humana.</data>
  <data key="d10">hypersensitivity,life-threatening risk</data>
  <data key="d11">chunk-1954b944b779698ff7d67b256199d202</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699101</data>
  <data key="d14"></data>
</edge>
<edge source="Reações Anafiláticas" target="Distúrbios Do Sistema Imune">
  <data key="d8">1.0</data>
  <data key="d9">Reações anafiláticas are severe immune system reactions classified under distúrbios do sistema imune and are triggered by hypersensitivity to insulin or its components.</data>
  <data key="d10">hypersensitivity,immune response</data>
  <data key="d11">chunk-1229dbbfb74d991d522a8d53f9383cdc</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699226</data>
  <data key="d14"></data>
</edge>
