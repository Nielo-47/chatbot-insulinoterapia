  <data key="d1">concept</data>
  <data key="d2">Escala ETDRS is the grading scale derived from the ETDRS protocol for assessing diabetic retinopathy stages.</data>
  <data key="d3">chunk-b916f29e047f8579110cf5da3fd73847</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
