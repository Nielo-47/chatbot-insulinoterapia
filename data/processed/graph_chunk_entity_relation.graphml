  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="Refraction Disorders">
  <data key="d8">1.0</data>
  <data key="d9">Refraction disorders may occur at the start of Novolin® R therapy and are usually temporary.</data>
  <data key="d10">adverse effect,transient condition</data>
  <data key="d11">chunk-ff021af578e58080f6a865c5f105e6d3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699094</data>
  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="Light">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill must be protected from light by remaining in its original packaging to prevent degradation.</data>
  <data key="d10">degradation risk,sensitivity</data>
  <data key="d11">chunk-98a0b8b861ae9af417a572907fe16408</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699176</data>
  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="Carb-Filled Meal">
  <data key="d8">1.0</data>
  <data key="d9">A carbohydrate-containing meal or snack must be consumed within 30 minutes after Novolin® R Penfill injection to prevent low blood sugar.</data>
  <data key="d10">hypoglycemia prevention,timing</data>
  <data key="d11">chunk-98a0b8b861ae9af417a572907fe16408</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699176</data>
  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="Amyloidosis Cutis">
  <data key="d8">1.0</data>
  <data key="d9">Repeated insulin injections with Novolin® R Penfill may lead to amyloidosis cutis, a rare skin condition minimized by site rotation.</data>
  <data key="d10">risk,skin complication</data>
  <data key="d11">chunk-98a0b8b861ae9af417a572907fe16408</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699177</data>
  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="Air Travel">
  <data key="d8">1.0</data>
  <data key="d9">During air travel, Novolin® R Penfill must be carried as hand luggage to avoid freezing in the cold cargo hold.</data>
  <data key="d10">freezing risk,handling instruction</data>
  <data key="d11">chunk-98a0b8b861ae9af417a572907fe16408</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699180</data>
  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="Expired Medication">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill must not be used after the expiration date printed on the packaging.</data>
  <data key="d10">safety,usage restriction</data>
  <data key="d11">chunk-98a0b8b861ae9af417a572907fe16408</data>
