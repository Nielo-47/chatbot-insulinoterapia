  <data key="d2">In the third trimester, abdominal insulin injection is not recommended for pregnant individuals.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1786299927</data>
  <data key="d6"></data>
</node>
<node id="Defined Protocols">
  <data key="d0">Defined Protocols</data>
  <data key="d1">method</data>
  <data key="d2">Defined protocols are well‑established procedures required in hospitals for insulin safety.</data>
  <data key="d3">chunk-3d0de4d525c273cda4939a501eaecc6d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300274</data>
  <data key="d6"></data>
</node>
<node id="Double Checking">
  <data key="d0">Double Checking</data>
  <data key="d1">method</data>
  <data key="d2">Double checking is the practice of verifying insulin preparation and administration twice.</data>
  <data key="d3">chunk-3d0de4d525c273cda4939a501eaecc6d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300275</data>
  <data key="d6"></data>
</node>
<node id="Patient Education">
  <data key="d0">Patient Education</data>
  <data key="d1">method</data>
  <data key="d2">Patient education is the instruction given to patients, initiated from hospital admission.&lt;SEP&gt;Patient education refers to instructional activities that improve individuals’ understanding and self‑management of diabetes.&lt;SEP&gt;Patient Education encompasses the information and training needed for successful Afrezza therapy.&lt;SEP&gt;Patient education involves informing patients about Afrezza’s rapid action, dosing, and safety considerations.&lt;SEP&gt;Patient education involves counseling patients on hypoglycemia treatment, prevention, and self‑management.</data>
  <data key="d3">chunk-3d0de4d525c273cda4939a501eaecc6d&lt;SEP&gt;chunk-5de4e99a192602fe98c8b7e8e270a49c&lt;SEP&gt;chunk-4e6371d8083fb20b137912cdaeec1b8b&lt;SEP&gt;chunk-5419de5a030f812ab408ef47f361bebd&lt;SEP&gt;chunk-cc39a0c02d5f1bd08d5cb71bacc69a24</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/edelman-et-al-2026-dosing-afrezza-it-s-not-that-complicated.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/metas cuidado do diabetes.pdf</data>
  <data key="d5">1786372159</data>
  <data key="d6"></data>
</node>
<node id="Medical Abbreviations">
  <data key="d0">Medical Abbreviations</data>
  <data key="d1">concept</data>
  <data key="d2">Medical abbreviations are shortened terms in prescriptions that can cause misunderstandings.</data>
  <data key="d3">chunk-3d0de4d525c273cda4939a501eaecc6d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300275</data>
  <data key="d6"></data>
</node>
<node id="Medication Errors">
  <data key="d0">Medication Errors</data>
  <data key="d1">concept</data>
  <data key="d2">Medication errors are mistakes in drug administration that increase risk to patients.&lt;SEP&gt;Medication Errors encompass mistakes in insulin prescription, preparation, and administration described in the text.&lt;SEP&gt;Medication errors involve administration of the wrong insulin, such as giving short‑acting insulin instead of Basaglar KwikPen.&lt;SEP&gt;Medication errors are mistakes such as accidental substitution between insulin products, highlighted for Levemir®.</data>
  <data key="d3">chunk-3d0de4d525c273cda4939a501eaecc6d&lt;SEP&gt;chunk-b5b4c60b3de8c56d9ab869d868345fb7&lt;SEP&gt;chunk-45d489de28e8fda3c3be3bb09ab29eb2&lt;SEP&gt;chunk-3237e202569462c758ec3d878c9faeae</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317644</data>
  <data key="d6"></data>
</node>
<node id="Medical Consultation">
  <data key="d0">Medical Consultation</data>
  <data key="d1">concept</data>
  <data key="d2">Medical consultation refers to a patient encounter where insulin usage is reviewed and health professionals assess therapy.&lt;SEP&gt;Medical consultation is advised when using other medications alongside Humalog Mix 50 Kwikpen.</data>
  <data key="d3">chunk-3d0de4d525c273cda4939a501eaecc6d&lt;SEP&gt;chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310738</data>
  <data key="d6"></data>
</node>
<node id="i-Port">
  <data key="d0">i-Port</data>
  <data key="d1">artifact</data>
  <data key="d2">i-Port is a device that permits multiple insulin injections without puncturing the skin each day.&lt;SEP&gt;The i-Port is an injection port device used to facilitate subcutaneous insulin delivery.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-5de4e99a192602fe98c8b7e8e270a49c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1786301832</data>
  <data key="d6"></data>
</node>
<node id="Refrigeration">
  <data key="d0">Refrigeration</data>
  <data key="d1">concept</data>
  <data key="d2">Refrigeration refers to storing insulin between 2 °C and 8 °C to maintain its efficacy.&lt;SEP&gt;Refrigeration is the storage condition recommended for SoloStar before first use, keeping it at 2° to 8°C.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-ffe095bda1b787c5b5ae2d61a2f74c98</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315486</data>
  <data key="d6"></data>
</node>
<node id="Short Needle">
  <data key="d0">Short Needle</data>
  <data key="d1">artifact</data>
  <data key="d2">Short needle is an insulin injection needle of 4 mm, 5 mm, or 6 mm length used to reduce injection pain.&lt;SEP&gt;Short needle is a needle of reduced length recommended for subcutaneous insulin injection.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-7ed0b3e64751c1a28d72e087f711cc20</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1786301827</data>
  <data key="d6"></data>
</node>
<node id="Rechargeable Insulin Pen">
  <data key="d0">Rechargeable Insulin Pen</data>
  <data key="d1">artifact</data>
  <data key="d2">Rechargeable insulin pen is a refillable insulin pen that should not be kept in a refrigerator to avoid damaging its mechanism.&lt;SEP&gt;A rechargeable insulin pen is a device for delivering insulin doses that should not be refrigerated.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-8336dc27990f6189c99863d64435c6c6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Armazenamento e Transporte/Armazenamento e transporte.docx</data>
  <data key="d5">1786302100</data>
  <data key="d6"></data>
</node>
<node id="Homogenization of Insulin Suspension">
  <data key="d0">Homogenization of Insulin Suspension</data>
  <data key="d1">method</data>
  <data key="d2">Homogenization of insulin suspension is the practice of rolling an insulin vial about 20 times to mix particles evenly without creating bubbles.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300275</data>
  <data key="d6"></data>
</node>
<node id="Education in Diabetes">
  <data key="d0">Education in Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Education in diabetes encompasses training patients, families, and caregivers to use insulin safely and manage the disease.&lt;SEP&gt;Instruction provided to families and individuals following detection of autoantibodies.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-2cf24d486949a568d61c1de206cd3e14</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786371996</data>
  <data key="d6"></data>
</node>
<node id="Health Professionals">
  <data key="d0">Health Professionals</data>
  <data key="d1">person</data>
  <data key="d2">Health professionals are trained staff who may use removable‑needle syringes with safety equipment.&lt;SEP&gt;Health professionals include doctors, nurses, and diabetes educators who teach patients proper insulin use.&lt;SEP&gt;Health Professionals are qualified individuals authorized to administer intravenous Novolin® R.&lt;SEP&gt;Health professionals are medical staff whose safety is enhanced by proper sharps disposal.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-622f3feb1f15564393e91cefc71256ec&lt;SEP&gt;chunk-0955cb70a6ce135722726162a9811e78&lt;SEP&gt;chunk-de69fd058597c808e8be5bd334395b84</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Descarte/Documento sem título.docx</data>
  <data key="d5">1786321781</data>
  <data key="d6"></data>
</node>
<node id="Cold Bath">
  <data key="d0">Cold Bath</data>
  <data key="d1">method</data>
  <data key="d2">Cold Bath is a cold temperature exposure that can slow insulin action and raise blood glucose.&lt;SEP&gt;Cold Bath involves immersing the body in cold water, decreasing insulin absorption.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-4902fb11e4844af5cf6fd61f18b6e4ce</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1786301835</data>
  <data key="d6"></data>
</node>
<node id="Air Bubbles">
  <data key="d0">Air Bubbles</data>
  <data key="d1">concept</data>
  <data key="d2">Air bubbles are trapped gases in an insulin syringe that can interfere with delivering the correct dose.&lt;SEP&gt;Air Bubbles are gas pockets formed in insulin vials, syringes, or pens due to vigorous shaking, potentially causing dose errors.&lt;SEP&gt;Air bubbles that may appear in the syringe and must be removed to ensure the correct insulin dose.&lt;SEP&gt;Air bubbles are gas pockets that can form in a vial, syringe, or pen when insulin is shaken vigorously, potentially leading to dosing errors.&lt;SEP&gt;Air Bubbles are pockets of air that may be present in the insulin reservoir and must be eliminated during the safety test.&lt;SEP&gt;Small pockets of air that can form in the reservoir or tubing, leading to inaccurate insulin delivery.&lt;SEP&gt;Air bubbles can become trapped in the reservoir or tubing and must be removed to ensure accurate insulin delivery.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-d8310c065da1c624d58d9a0a8e9ff7d4&lt;SEP&gt;chunk-4902fb11e4844af5cf6fd61f18b6e4ce&lt;SEP&gt;chunk-4d795dc393eb02c6418957ee1678504f&lt;SEP&gt;chunk-ffe095bda1b787c5b5ae2d61a2f74c98&lt;SEP&gt;chunk-fe844728a502927fee80d42268408b1a&lt;SEP&gt;chunk-691a5ee6c6fdbea7a2ef1c835f0e66ae</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte e conservação Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329589</data>
  <data key="d6"></data>
</node>
<node id="Injection Sites">
  <data key="d0">Injection Sites</data>
  <data key="d1">concept</data>
  <data key="d2">Injection Sites are body areas such as abdomen, thigh, arm, and flank recommended for insulin administration.&lt;SEP&gt;Injection sites include upper arms, thighs, buttocks, and abdomen where subcutaneous injections are performed.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310738</data>
  <data key="d6"></data>
</node>
<node id="Distraction Techniques">
  <data key="d0">Distraction Techniques</data>
  <data key="d1">method</data>
  <data key="d2">Distraction techniques are methods used to reduce pain perception in children during insulin injection.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300276</data>
  <data key="d6"></data>
</node>
<node id="Forearm">
  <data key="d0">Forearm</data>
  <data key="d1">location</data>
  <data key="d2">Forearm is a region of the upper limb where insulin injection is not recommended.&lt;SEP&gt;Forearm is the anatomical site mentioned as not recommended for insulin administration.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-b5b4c60b3de8c56d9ab869d868345fb7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1786301841</data>
  <data key="d6"></data>
</node>
<node id="Syringe Plunger">
  <data key="d0">Syringe Plunger</data>
  <data key="d1">artifact</data>
  <data key="d2">Syringe plunger is the part of a syringe that, if pressed before needle insertion, can cause insulin loss.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300277</data>
  <data key="d6"></data>
</node>
<node id="Insulin U40">
  <data key="d0">Insulin U40</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin U40 is an alternative insulin concentration mentioned for use in some countries.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
