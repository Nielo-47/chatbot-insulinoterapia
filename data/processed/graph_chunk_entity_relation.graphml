  <data key="d0">Octreotida</data>
  <data key="d1">artifact</data>
  <data key="d2">Octreotida é um medicamento que pode tanto reduzir quanto aumentar as necessidades de insulina.</data>
  <data key="d3">chunk-54b65b433ba47e8bbf2d607b89776246</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1778698984</data>
  <data key="d6"></data>
</node>
