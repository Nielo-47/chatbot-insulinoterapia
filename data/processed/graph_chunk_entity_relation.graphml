  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699227</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin" target="100 UI/mL">
  <data key="d8">1.0</data>
  <data key="d9">The insulin in Novolin® R is formulated at a concentration of 100 UI/mL.</data>
  <data key="d10">concentration,dosage specification</data>
