</node>
<node id="Administrar Bolus Manual">
  <data key="d0">Administrar Bolus Manual</data>
  <data key="d1">method</data>
  <data key="d2">The manual bolus administration method allows the user to input a specific insulin dose to cover carbohydrates or correct high glucose.</data>
  <data key="d3">chunk-63f6eb3be969569b166fc1e5f7e7567f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
