  <data key="d13"></data>
</edge>
<edge source="APIDRA SOLOSTAR" target="Risk Category C in Pregnancy">
  <data key="d7">1.0</data>
  <data key="d8">APIDRA SOLOSTAR is classified as pregnancy risk category C and should not be used by pregnant women without medical guidance.</data>
  <data key="d9">contraindication,risk classification</data>
  <data key="d10">chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315733</data>
  <data key="d13"></data>
</edge>
<edge source="Paciente Diabético" target="Monitoramento da Glicose no Sangue">
  <data key="d7">1.0</data>
  <data key="d8">Blood glucose monitoring is recommended for all diabetic patients.</data>
  <data key="d9">monitoring,recommendation</data>
  <data key="d10">chunk-e4ba52cc293c5c002b470566321026d6</data>
