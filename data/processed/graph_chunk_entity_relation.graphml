  <data key="d6"></data>
</node>
<node id="Insulina Exógena">
  <data key="d0">Insulina Exógena</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Exógena is externally administered insulin that can provoke the formation of anti‑insulin antibodies.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373003</data>
  <data key="d6"></data>
</node>
<node id="Teste De Anticorpo Anti-Insulina">
  <data key="d0">Teste De Anticorpo Anti-Insulina</data>
  <data key="d1">artifact</data>
  <data key="d2">Teste De Anticorpo Anti-Insulina is a laboratory test measuring antibodies against exogenous insulin, whose results may be interfered with by existing anti‑insulina antibodies.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373003</data>
  <data key="d6"></data>
</node>
<node id="EEUU">
  <data key="d0">EEUU</data>
  <data key="d1">location</data>
  <data key="d2">EEUU refers to the United States, the country where a prevalence study of overweight or obesity in people with DM1 was reported.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373003</data>
  <data key="d6"></data>
</node>
<node id="Classificação Do Diabetes">
  <data key="d0">Classificação Do Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Classificação Do Diabetes is the process of categorizing diabetes into subtypes such as DM1, DM2, or monogenic forms.&lt;SEP&gt;Classificação Do Diabetes is the guideline that categorizes diabetes types using the AABBCC approach.&lt;SEP&gt;Classificação Do Diabetes is the official guideline document on diabetes classification published in 2023 by Sociedade Brasileira De Diabetes.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae&lt;SEP&gt;chunk-27380916f7cd2065a9c21259b0aa7868&lt;SEP&gt;chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373004</data>
  <data key="d6"></data>
</node>
<node id="Incidência De DM1">
  <data key="d0">Incidência De DM1</data>
  <data key="d1">concept</data>
  <data key="d2">Incidência De DM1 describes the occurrence rate of type 1 diabetes, with peaks between ages 10‑14 and a secondary peak between 65‑70 years.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373004</data>
  <data key="d6"></data>
</node>
<node id="Prevalência De DM1">
  <data key="d0">Prevalência De DM1</data>
  <data key="d1">concept</data>
  <data key="d2">Prevalência De DM1 denotes the proportion of the population affected by type 1 diabetes.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373004</data>
  <data key="d6"></data>
</node>
<node id="Sobrepeso">
  <data key="d0">Sobrepeso</data>
  <data key="d1">concept</data>
  <data key="d2">Sobrepeso is the condition of being overweight, mentioned in prevalence data for people with DM1.</data>
