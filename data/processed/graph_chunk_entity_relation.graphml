  <data key="d1">method</data>
  <data key="d2">4ª Etapa: Seleção da Dose is the fourth method step that directs users to select the desired insulin dose on the SoloStar pen.</data>
  <data key="d3">chunk-79f891b1d7c0c6ca0eab9dbcc76c902d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
