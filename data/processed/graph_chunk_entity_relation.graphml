  <data key="d13">1778707516</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="24-Hour Technical Support">
  <data key="d8">2.0</data>
  <data key="d9">24-Hour Technical Support provides help for resolving issues with the CGM device and interpreting alerts.&lt;SEP&gt;24-Hour Technical Support provides help for issues related to CGM device alerts and connectivity.</data>
  <data key="d10">technical assistance,troubleshooting</data>
