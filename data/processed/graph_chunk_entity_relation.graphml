  <data key="d0">Insulin U500</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin U500 is an alternative insulin concentration mentioned for use in some countries.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300277</data>
  <data key="d6"></data>
</node>
<node id="Syringe U100">
  <data key="d0">Syringe U100</data>
  <data key="d1">artifact</data>
  <data key="d2">Syringe U100 is a syringe calibrated in units (UI) specifically designed for insulin U100.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300277</data>
  <data key="d6"></data>
</node>
<node id="Fixed-Needle Syringe">
  <data key="d0">Fixed-Needle Syringe</data>
  <data key="d1">artifact</data>
  <data key="d2">Fixed-Needle Syringe is a type of syringe with a non‑removable needle, recommended as the safest for insulin injection.&lt;SEP&gt;Fixed-Needle Syringe is a syringe variant with a permanently attached needle, recommended for mixing insulin.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec&lt;SEP&gt;chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300277</data>
  <data key="d6"></data>
</node>
<node id="Removable-Needle Syringe">
  <data key="d0">Removable-Needle Syringe</data>
  <data key="d1">artifact</data>
  <data key="d2">Removable-Needle Syringe is a syringe with a detachable needle that is not recommended for home insulin use.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300278</data>
  <data key="d6"></data>
</node>
<node id="Needle 6 mm">
  <data key="d0">Needle 6 mm</data>
  <data key="d1">artifact</data>
  <data key="d2">Needle 6 mm is a short needle length considered the best for safety and reduced pain.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300278</data>
  <data key="d6"></data>
</node>
<node id="Needle 8 mm">
  <data key="d0">Needle 8 mm</data>
  <data key="d1">artifact</data>
  <data key="d2">Needle 8 mm is an intermediate needle length available for insulin syringes.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300278</data>
  <data key="d6"></data>
</node>
<node id="Needle 12.7 mm">
  <data key="d0">Needle 12.7 mm</data>
  <data key="d1">artifact</data>
  <data key="d2">Needle 12.7 mm is a longer needle length available for insulin syringes.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300278</data>
  <data key="d6"></data>
</node>
<node id="Children and Adolescents">
  <data key="d0">Children and Adolescents</data>
  <data key="d1">concept</data>
  <data key="d2">Children and adolescents are patient groups that often require small or odd insulin doses.&lt;SEP&gt;Children and adolescents refer to individuals roughly aged 10 to 19 years, a population discussed regarding diabetes screening and risk factors.&lt;SEP&gt;The population group comprising individuals from childhood through teenage years, examined for diabetes prevalence.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec&lt;SEP&gt;chunk-e7b4535dbb2554b84c7a2e024c4b82c4&lt;SEP&gt;chunk-ec7e786a85b1b6e6cc75bcfc9189fd27</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786371977</data>
  <data key="d6"></data>
</node>
<node id="Posto de Saúde">
  <data key="d0">Posto de Saúde</data>
  <data key="d1">organization</data>
  <data key="d2">Posto de Saúde is a health post where discarded containers are delivered.&lt;SEP&gt;A local health post that receives the disposed plastic containers with used sharps.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec&lt;SEP&gt;chunk-59ce0fcadc9ae2a47a525390ae59d81c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas FRASCOS.pdf</data>
  <data key="d5">1786300854</data>
  <data key="d6"></data>
</node>
<node id="Disposable Insulin Pen">
  <data key="d0">Disposable Insulin Pen</data>
  <data key="d1">artifact</data>
  <data key="d2">Disposable Insulin Pen is a pre‑filled insulin pen that is discarded after the insulin is depleted.&lt;SEP&gt;Single‑use insulin pen mentioned as an alternative delivery device.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec&lt;SEP&gt;chunk-cc6a26a5d2c41087b58a0f7f71ad21cc</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d5">1786301071</data>
  <data key="d6"></data>
</node>
<node id="Refillable Insulin Pen">
  <data key="d0">Refillable Insulin Pen</data>
  <data key="d1">artifact</data>
  <data key="d2">Refillable Insulin Pen is a pen that uses interchangeable 3 mL insulin cartridges.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Laboratories">
  <data key="d0">Laboratories</data>
  <data key="d1">organization</data>
  <data key="d2">Laboratories are companies that produce insulin formulations compatible with pens.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Some Countries">
  <data key="d0">Some Countries</data>
  <data key="d1">location</data>
  <data key="d2">Some Countries refer to nations other than Brazil where alternative insulin concentrations exist.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Risk of Hypoglycemia">
  <data key="d0">Risk of Hypoglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Risk of hypoglycemia refers to the increased chance of low blood sugar when insulin is injected into muscle due to overly long needle penetration.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Syringe 100 Unit">
  <data key="d0">Syringe 100 Unit</data>
  <data key="d1">artifact</data>
  <data key="d2">Syringe 100 Unit is a syringe calibrated with 2‑unit markings, suitable for delivering even doses up to 100 units.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Syringe 50 Unit">
  <data key="d0">Syringe 50 Unit</data>
  <data key="d1">artifact</data>
  <data key="d2">Syringe 50 Unit is a syringe marked in 1‑unit increments, suitable for both even and odd insulin doses up to 50 units.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Syringe 30 Unit">
  <data key="d0">Syringe 30 Unit</data>
  <data key="d1">artifact</data>
  <data key="d2">Syringe 30 Unit is a syringe that can be marked in 1‑unit or 0.5‑unit steps, allowing very small or fractional insulin doses up to 30 units.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Needle 13 Mm">
  <data key="d0">Needle 13 Mm</data>
  <data key="d1">artifact</data>
  <data key="d2">Needle 13 Mm is a longer detachable needle that can reach muscle tissue, raising the risk of hypoglycemia.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300279</data>
  <data key="d6"></data>
</node>
<node id="Marking Interval 1 Unit">
  <data key="d0">Marking Interval 1 Unit</data>
  <data key="d1">concept</data>
  <data key="d2">Marking interval of 1 unit denotes syringe graduations spaced every 1 insulin unit, enabling precise dosing.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300280</data>
  <data key="d6"></data>
</node>
<node id="Marking Interval 0.5 Unit">
  <data key="d0">Marking Interval 0.5 Unit</data>
  <data key="d1">concept</data>
  <data key="d2">Marking interval of 0.5 unit denotes finer syringe graduations that allow dosing in half‑unit increments.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300280</data>
  <data key="d6"></data>
</node>
<node id="Disposable Syringe">
  <data key="d0">Disposable Syringe</data>
  <data key="d1">artifact</data>
  <data key="d2">Disposable Syringe is a single‑use syringe designed to be discarded after one injection.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300280</data>
  <data key="d6"></data>
</node>
<node id="Single Use">
  <data key="d0">Single Use</data>
  <data key="d1">concept</data>
  <data key="d2">Single use indicates that a medical device is intended for only one application before disposal.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300280</data>
  <data key="d6"></data>
</node>
<node id="Manufacturer Compatibility Requirement">
  <data key="d0">Manufacturer Compatibility Requirement</data>
  <data key="d1">concept</data>
  <data key="d2">Manufacturer compatibility requirement specifies that refill cartridges must match the pen's original manufacturer to ensure proper fit and dosing.</data>
  <data key="d3">chunk-622f3feb1f15564393e91cefc71256ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300280</data>
  <data key="d6"></data>
</node>
<node id="Botão da Caneta">
  <data key="d0">Botão da Caneta</data>
  <data key="d1">artifact</data>
  <data key="d2">The button on the insulin pen that makes application faster, comfortable, and gives confidence of a full dose.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300280</data>
  <data key="d6"></data>
</node>
<node id="Agulha da Caneta">
  <data key="d0">Agulha da Caneta</data>
  <data key="d1">artifact</data>
  <data key="d2">The needle of the insulin pen that must be handled carefully to avoid bending during use.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300281</data>
  <data key="d6"></data>
</node>
<node id="Injetor da Caneta">
  <data key="d0">Injetor da Caneta</data>
  <data key="d1">artifact</data>
  <data key="d2">The part of the insulin pen where the dose is prepared and set according to usage instructions.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300281</data>
  <data key="d6"></data>
</node>
<node id="Tampa Protetora Interna">
  <data key="d0">Tampa Protetora Interna</data>
  <data key="d1">artifact</data>
  <data key="d2">The colored internal protective cap removed to prevent the pen needle from bending.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300281</data>
  <data key="d6"></data>
</node>
<node id="Braços">
  <data key="d0">Braços</data>
  <data key="d1">location</data>
  <data key="d2">The back of the arm area between four finger‑widths below the armpit and above the elbow, recommended for insulin injection.&lt;SEP&gt;Braços (arms) are a common subcutaneous injection site for Humalog.&lt;SEP&gt;The arms, another recommended site for subcutaneous insulin injection.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-fe370bbb9ac4bc4d475b9ef58ec9fee9&lt;SEP&gt;chunk-1aba4eb027a027fb1ad6e0105b97cfa3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/Bula Humalog.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310756</data>
  <data key="d6"></data>
</node>
<node id="Nádegas">
  <data key="d0">Nádegas</data>
  <data key="d1">location</data>
  <data key="d2">The upper outer lateral quadrant of the buttocks, recommended for insulin injection.&lt;SEP&gt;Nádegas (buttocks) are a common subcutaneous injection site for Humalog.&lt;SEP&gt;The buttocks region used as a possible site for insulin injection.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-fe370bbb9ac4bc4d475b9ef58ec9fee9&lt;SEP&gt;chunk-1aba4eb027a027fb1ad6e0105b97cfa3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/Bula Humalog.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310755</data>
  <data key="d6"></data>
</node>
<node id="Coxas">
  <data key="d0">Coxas</data>
  <data key="d1">location</data>
  <data key="d2">The front and outer side of the thigh between four finger‑widths below the groin and above the knee, recommended for insulin injection.&lt;SEP&gt;Coxas (thighs) are a common subcutaneous injection site for Humalog.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-fe370bbb9ac4bc4d475b9ef58ec9fee9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/Bula Humalog.pdf</data>
  <data key="d5">1786303794</data>
  <data key="d6"></data>
</node>
<node id="Abdômen">
  <data key="d0">Abdômen</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The sides of the abdomen, maintaining three to four finger‑widths from the navel, recommended for insulin injection except in the third trimester of pregnancy.&lt;SEP&gt;The abdominal region of the body, considered a safe site for subcutaneous insulin injection in early pregnancy.&lt;SEP&gt;Abdômen is the abdominal area, also a recommended injection site for Tresiba.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-2df359ca3783191b2159f8d3f6ea6c52&lt;SEP&gt;chunk-11cce86325de9748e794648198242578</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/TRESIBA _ BulasMed.pdf</data>
  <data key="d5">1786306308</data>
  <data key="d6"></data>
</node>
<node id="Gestante">
  <data key="d0">Gestante</data>
  <data key="d1">person</data>
  <data key="d2">A pregnant individual who may inject insulin, with specific trimester‑related site recommendations.&lt;SEP&gt;Gestante refers to pregnant women who may be exposed to Insulina Glargina during pregnancy and lactation.&lt;SEP&gt;Gestante refers to a pregnant woman, a population for which Humalog Mix 25 KwikPen is classified as pregnancy category B and for whom insulin needs change across trimesters.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-17844a4a12e6c05ba2d7b5f54b0f9bd7&lt;SEP&gt;chunk-518838d3c8e8110567b1891b704bfef9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310739</data>
  <data key="d6"></data>
</node>
<node id="Primeiro Trimestre da Gravidez">
  <data key="d0">Primeiro Trimestre da Gravidez</data>
  <data key="d1">event</data>
  <data key="d2">The first two trimesters of pregnancy during which abdomen injection of insulin is permissible.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300282</data>
  <data key="d6"></data>
</node>
<node id="Terceiro Trimestre da Gravidez">
  <data key="d0">Terceiro Trimestre da Gravidez</data>
  <data key="d1">event</data>
  <data key="d2">The third trimester of pregnancy during which abdomen injection of insulin is not recommended.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300282</data>
  <data key="d6"></data>
</node>
<node id="Selo Da Guia De Papel">
  <data key="d0">Selo Da Guia De Papel</data>
  <data key="d1">artifact</data>
  <data key="d2">The paper guide seal that must be removed from the bottom of the pen needle before use.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300282</data>
  <data key="d6"></data>
</node>
<node id="Dedos (Polegar E Indicador)">
  <data key="d0">Dedos (Polegar E Indicador)</data>
  <data key="d1">other</data>
  <data key="d2">The thumb and index finger of the person, used to pinch the skin when performing a subcutaneous fold.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300282</data>
  <data key="d6"></data>
</node>
<node id="Agulha De 4 Mm">
  <data key="d0">Agulha De 4 Mm</data>
  <data key="d1">artifact</data>
  <data key="d2">A 4 mm long insulin pen needle recommended for use during the first two trimesters of pregnancy.&lt;SEP&gt;Short 4 mm needle recommended for insulin pens and syringes to minimise intramuscular injection.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-aafda750d4900a464b1ac0c9bad5ba05</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1786301828</data>
  <data key="d6"></data>
</node>
<node id="Ângulo De 45°">
  <data key="d0">Ângulo De 45°</data>
  <data key="d1">concept</data>
  <data key="d2">The recommended injection angle of forty‑five degrees for insulin administration.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300282</data>
  <data key="d6"></data>
</node>
<node id="Dor">
  <data key="d0">Dor</data>
  <data key="d1">concept</data>
  <data key="d2">Pain that can occur if the insulin pen needle is bent or inserted incorrectly.&lt;SEP&gt;Dor is pain at the injection site reported as a common adverse reaction to Levemir®.</data>
  <data key="d3">chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-8a68ba1e8cc1defda76cde0eff9592e6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317653</data>
  <data key="d6"></data>
</node>
<node id="Medical Doctor">
  <data key="d0">Medical Doctor</data>
  <data key="d1">person</data>
  <data key="d2">Medical Doctor is a health professional consulted for injection site adjustments, especially for pregnant women and dose review.&lt;SEP&gt;Medical Doctor is a healthcare professional who prescribes Tresiba® and may adjust its dose based on blood sugar measurements.&lt;SEP&gt;Medical Doctor is the healthcare professional advised to be consulted for BASAGLAR KwikPen use.&lt;SEP&gt;Medical Doctor is the healthcare professional whose supervision is advised for travel adjustments, dose changes, and insulin transfers.&lt;SEP&gt;Medical doctor is a healthcare professional who should be consulted when using Humulin R with other medications.&lt;SEP&gt;Medical Doctor is the healthcare professional who provides specific instructions about insulin basal and other directives during illness.</data>
  <data key="d3">chunk-8abf9336f83edf5c92071da1032dc483&lt;SEP&gt;chunk-e9ae5f9ffa7eff9bb36cf1a9764df3e7&lt;SEP&gt;chunk-6f0c10866496bbb0b388b1e5ed69901c&lt;SEP&gt;chunk-ea9b3836b3275f451c3acfb189f42a6f&lt;SEP&gt;chunk-0fa819f7e1e42eb688d4894dc3ca7e64&lt;SEP&gt;chunk-2dc33cf2a90bf53c26226e44bc285c22</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/TRESIBA _ BulasMed.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324138</data>
  <data key="d6"></data>
</node>
<node id="Pregnant Woman">
  <data key="d0">Pregnant Woman</data>
  <data key="d1">person</data>
  <data key="d2">Pregnant Woman is a female patient who must adjust insulin injection site and avoid abdominal injections in the last trimester.</data>
  <data key="d3">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300283</data>
  <data key="d6"></data>
</node>
<node id="Muscle">
  <data key="d0">Muscle</data>
  <data key="d1">location</data>
  <data key="d2">Muscle is a body tissue where insulin may be injected intramuscularly in emergencies under medical supervision.&lt;SEP&gt;Muscle tissue is a site where insulin facilitates intracellular transport of glucose and amino acids.</data>
  <data key="d3">chunk-8abf9336f83edf5c92071da1032dc483&lt;SEP&gt;chunk-a1245bd9ff75c998b49dab861cc4cebf</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319693</data>
  <data key="d6"></data>
</node>
<node id="Vein">
  <data key="d0">Vein</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Vein is a blood vessel where insulin may be injected endovenously in emergencies with medical oversight.</data>
  <data key="d3">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300283</data>
  <data key="d6"></data>
</node>
<node id="Cold">
  <data key="d0">Cold</data>
  <data key="d1">concept</data>
  <data key="d2">Cold (including cold compresses, cold baths, or dehydration) slows insulin absorption.</data>
  <data key="d3">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d5">1786300284</data>
  <data key="d6"></data>
</node>
<node id="Insulin Absorption Speed">
  <data key="d0">Insulin Absorption Speed</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Absorption Speed is the rate at which injected insulin enters the bloodstream, affected by injection site and external factors.</data>
  <data key="d3">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
