</edge>
<edge source="Sensor" target="Check Sensor Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Check Sensor Alert prompts the user to verify that the sensor is functioning correctly.</data>
  <data key="d10">error detection,function verification</data>
