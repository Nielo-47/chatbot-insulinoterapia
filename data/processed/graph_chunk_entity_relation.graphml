  <data key="d0">Reservorio bajo</data>
  <data key="d1">concept</data>
  <data key="d2">Reservorio bajo is an alert indicating that the pump reservoir is low.&lt;SEP&gt;Reservorio bajo is an alert indicating that the insulin reservoir is low.&lt;SEP&gt;An alert condition indicating that the insulin reservoir is low.</data>
