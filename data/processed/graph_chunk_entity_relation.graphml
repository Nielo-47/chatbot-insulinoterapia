</node>
<node id="Nephropathy">
  <data key="d0">Nephropathy</data>
  <data key="d1">concept</data>
  <data key="d2">Nephropathy is a kidney complication of diabetes linked to poor glycemic control as indicated by HbA1c levels.</data>
  <data key="d3">chunk-8f731774e5187eb76527ebeabefeeeb5&lt;SEP&gt;chunk-4831a946dfc89918a6b2e92a9ed7da66</data>
