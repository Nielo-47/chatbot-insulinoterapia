  <data key="d0">Sangramento</data>
  <data key="d1">concept</data>
  <data key="d2">Sangramento refers to bleeding that may occur at the injection site following insulin administration.</data>
  <data key="d3">chunk-b64741e11a7d852f462b1269fabfbe43</data>
