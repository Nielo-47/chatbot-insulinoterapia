</edge>
<edge source="Rotation Plan" target="Skin Lesion">
  <data key="d7">1.0</data>
  <data key="d8">Following a rotation plan helps avoid skin lesions caused by repeated injections in the same spot.</data>
  <data key="d9">health benefit,prevention</data>
