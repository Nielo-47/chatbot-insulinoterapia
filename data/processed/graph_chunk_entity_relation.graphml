  <data key="d13">1778700976</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus Cuadrado" target="Bolus Wizard">
  <data key="d8">1.0</data>
  <data key="d9">The Bolus Wizard calculates insulin doses but cannot administer corrective doses as bolus cuadrado because they require immediate action.</data>
  <data key="d10">delivery limitation,dose calculation</data>
