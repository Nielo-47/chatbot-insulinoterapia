  <data key="d14"></data>
</edge>
<edge source="Insulinas" target="Álcool">
  <data key="d8">1.0</data>
  <data key="d9">O consumo de álcool pode intensificar ou reduzir o efeito hipoglicemiante da insulina.</data>
