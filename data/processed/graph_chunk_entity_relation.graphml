  <data key="d5">1778708575</data>
  <data key="d6"></data>
  <data key="d7">Meal Bolus</data>
</node>
<node id="Insulin-to-Carbohydrate Ratio">
  <data key="d0">Insulin-to-Carbohydrate Ratio</data>
  <data key="d1">data</data>
  <data key="d2">The insulin-to-carbohydrate ratio defines how many grams of carbohydrates are covered by one unit of insulin.&lt;SEP&gt;The insulin-to-carbohydrate ratio determines how much insulin is needed per gram of carbohydrate consumed.&lt;SEP&gt;The insulin-to-carbohydrate ratio determines how much insulin is needed per gram of carbohydrates consumed.&lt;SEP&gt;The insulin-to-carbohydrate ratio (I/C) determines how much insulin is needed to cover a specific amount of carbohydrates consumed.</data>
  <data key="d3">chunk-1d0f18d3b5098557dfd71a1955adc3a2&lt;SEP&gt;chunk-3bf188253bd9d2142b4fcf627eacc2b8&lt;SEP&gt;chunk-6e6b312daef8e67f312c6c144bbaa835&lt;SEP&gt;chunk-de222ffe4b47c380bbe3bc69fd7c2632</data>
