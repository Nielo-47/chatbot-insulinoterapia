  <data key="d14"></data>
</edge>
<edge source="Infusion Set" target="Disposal">
  <data key="d8">1.0</data>
  <data key="d9">Used Infusion Sets must be properly disposed of following the disposal information provided in the user guide.</data>
  <data key="d10">safety practice,waste management</data>
  <data key="d11">chunk-30fd82ff17ab8577d82477ed97f94075</data>
