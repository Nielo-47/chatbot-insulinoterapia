  <data key="d14"></data>
</edge>
<edge source="Physical Activity" target="Temporary Basal Rate">
  <data key="d8">2.0</data>
  <data key="d9">A temporary basal rate reduces insulin delivery during physical activity to prevent hypoglycemia.&lt;SEP&gt;The temporary basal rate is adjusted during physical activity to reduce insulin delivery and prevent hypoglycemia.</data>
  <data key="d10">hypoglycemia prevention,insulin adjustment,insulin reduction</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b&lt;SEP&gt;chunk-de222ffe4b47c380bbe3bc69fd7c2632</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703175</data>
  <data key="d14"></data>
</edge>
<edge source="Physical Activity" target="Glycogen">
  <data key="d8">1.0</data>
  <data key="d9">During physical activity, the body uses stored glycogen from the liver and muscles as a source of energy.</data>
  <data key="d10">energy source,glucose storage</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703176</data>
  <data key="d14"></data>
</edge>
<edge source="Physical Activity" target="Free Fatty Acids">
  <data key="d8">1.0</data>
  <data key="d9">After 30 minutes of exercise, the body increasingly uses free fatty acids as an energy source.</data>
  <data key="d10">energy shift,metabolism</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703176</data>
  <data key="d14"></data>
</edge>
<edge source="Physical Activity" target="Glucose Levels">
  <data key="d8">1.0</data>
  <data key="d9">Physical activity lowers glucose levels by increasing the body's use of sugar and glycogen for energy.</data>
  <data key="d10">energy utilization,hypoglycemia risk</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703178</data>
  <data key="d14"></data>
</edge>
<edge source="Physical Activity" target="Medical Team">
  <data key="d8">1.0</data>
  <data key="d9">The medical team advises on managing insulin and carbohydrate intake before and during physical activity.</data>
  <data key="d10">activity management,treatment planning</data>
  <data key="d11">chunk-4082de8021392199c251dff122fdc80b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703179</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Dosing" target="Capillary Blood Glucose">
  <data key="d8">1.0</data>
