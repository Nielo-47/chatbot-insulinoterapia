  <data key="d13">1778708047</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G Insulin Pump" target="Simplera Sync Sensor">
  <data key="d8">3.0</data>
  <data key="d9">The Simplera Sync sensor is compatible with the MiniMed 780G insulin pump and uses blood glucose readings for system calibration.&lt;SEP&gt;The MiniMed 780G insulin pump is compatible with the Simplera Sync sensor for continuous glucose monitoring.&lt;SEP&gt;The Simplera Sync sensor is compatible with the MiniMed 780G insulin pump system and is used for continuous glucose monitoring.</data>
  <data key="d10">calibration,device compatibility,glucose monitoring</data>
  <data key="d11">chunk-e3323a205200ffe0b547b90ddb5919e0&lt;SEP&gt;chunk-d5f110b7de186509276c52b62487bf1d&lt;SEP&gt;chunk-bb895500e1ede1e328c1d3f50e5e9b36</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708048</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G Insulin Pump" target="Guardian 4 Sensor">
  <data key="d8">4.0</data>
  <data key="d9">The Guardian 4 sensor is compatible with the MiniMed 780G insulin pump and uses blood glucose readings for system calibration.&lt;SEP&gt;The MiniMed 780G insulin pump is compatible with the Guardian 4 sensor for continuous glucose monitoring.&lt;SEP&gt;The Guardian 4 sensor is compatible with the MiniMed 780G insulin pump system and is used for continuous glucose monitoring.&lt;SEP&gt;The Guardian 4 sensor is designed to pair with the MiniMed 780G insulin pump for glucose monitoring.</data>
  <data key="d10">calibration,device compatibility,glucose monitoring,pairing</data>
  <data key="d11">chunk-e3323a205200ffe0b547b90ddb5919e0&lt;SEP&gt;chunk-d5f110b7de186509276c52b62487bf1d&lt;SEP&gt;chunk-ea171e9afedb933e838f1349ebb0fe50&lt;SEP&gt;chunk-bb895500e1ede1e328c1d3f50e5e9b36</data>
