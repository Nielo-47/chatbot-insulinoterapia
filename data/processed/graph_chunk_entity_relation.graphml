  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G system is intended for use with U-100 NovoLog insulin as prescribed by a healthcare professional.</data>
  <data key="d10">insulin compatibility,prescribed use</data>
  <data key="d11">chunk-6f4df342459d4afd90a81b1a3f13d859</data>
