</edge>
<edge source="Subcutaneous Injection" target="Novolin® R">
  <data key="d8">2.0</data>
  <data key="d9">Novolin® R is administered subcutaneously in the abdominal wall, thigh, gluteal, or deltoid regions.&lt;SEP&gt;Novolin® R is administered via Subcutaneous Injection into areas such as the abdomen, thigh, or deltoid.</data>
  <data key="d10">administration route,delivery method</data>
  <data key="d11">chunk-2d59277cc4b25262a26a88992bfb526f&lt;SEP&gt;chunk-0e1d7f92cdb7923807a9067d937837a4</data>
