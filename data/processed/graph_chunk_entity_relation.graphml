<node id="Objetivo Gs">
  <data key="d0">Objetivo Gs</data>
  <data key="d1">concept</data>
  <data key="d2">Objetivo Gs is the target blood glucose level that a user aims to achieve, with values defined for low (Ba) and high (Al) ranges.</data>
  <data key="d3">chunk-89156e5c9ff284920f8f122774e1ee34</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
