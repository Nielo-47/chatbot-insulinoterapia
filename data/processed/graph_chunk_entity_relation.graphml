  <data key="d1">artifact</data>
  <data key="d2">Aparelho que guarda os resultados e conecta no computador is a device that stores glucose readings and syncs with a computer.</data>
  <data key="d3">chunk-a79d0e4d0f656bd87d2d0c4657378db4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336916</data>
  <data key="d6"></data>
</node>
<node id="Continuous Glucose Monitoring System (SMCG)">
  <data key="d0">Continuous Glucose Monitoring System (SMCG)</data>
  <data key="d1">artifact</data>
  <data key="d2">Continuous Glucose Monitoring System (SMCG) is a wearable device that continuously measures glucose levels through a skin‑attached sensor.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336916</data>
  <data key="d6"></data>
</node>
<node id="Reader or Cellphone">
  <data key="d0">Reader or Cellphone</data>
  <data key="d1">artifact</data>
  <data key="d2">Reader or Cellphone is a device that receives data from the transmitter and displays the glucose value to the user.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336916</data>
  <data key="d6"></data>
</node>
<node id="Finger">
  <data key="d0">Finger</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Finger is the part of the hand that is pricked with a lancet to obtain a blood drop for testing.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336916</data>
  <data key="d6"></data>
</node>
<node id="Hand">
  <data key="d0">Hand</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hand is the body part whose fingers are used for glucose testing and should be washed before the procedure.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Blood Drop">
  <data key="d0">Blood Drop</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Blood Drop is the small amount of blood obtained from the finger after pricking, which is applied to the test strip.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Real-Time Sensor (tR‑SMCG)">
  <data key="d0">Real-Time Sensor (tR‑SMCG)</data>
  <data key="d1">artifact</data>
  <data key="d2">Real-Time Sensor (tR‑SMCG) is a type of continuous glucose monitoring sensor that provides live glucose data throughout the day.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Adjustable Lancet">
  <data key="d0">Adjustable Lancet</data>
  <data key="d1">artifact</data>
  <data key="d2">Adjustable Lancet is a lancet with regulation that provides a smoother puncture for glucose testing.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Modern Lancet Device">
  <data key="d0">Modern Lancet Device</data>
  <data key="d1">artifact</data>
  <data key="d2">Modern Lancet Device is a newer lancet that causes minimal pain during finger puncture.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Mobile App">
  <data key="d0">Mobile App</data>
  <data key="d1">artifact</data>
  <data key="d2">Mobile App is a software application used to record glucose measurements and related information.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Control Spreadsheet">
  <data key="d0">Control Spreadsheet</data>
  <data key="d1">data</data>
  <data key="d2">Control Spreadsheet is a digital spreadsheet used to store and analyze glucose readings and related data.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Measurement Time">
  <data key="d0">Measurement Time</data>
  <data key="d1">data</data>
  <data key="d2">Measurement Time is the timestamp recorded when a glucose reading is taken.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Strip Code">
  <data key="d0">Strip Code</data>
  <data key="d1">data</data>
  <data key="d2">Strip Code is the identifying code on a test strip that must match the code of the glucose meter.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336917</data>
  <data key="d6"></data>
</node>
<node id="Glucose Test">
  <data key="d0">Glucose Test</data>
  <data key="d1">concept</data>
  <data key="d2">Glucose Test is the procedure of measuring blood glucose using a lancet, test strip, and glucose meter.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336918</data>
  <data key="d6"></data>
</node>
<node id="Historical Glucose Data">
  <data key="d0">Historical Glucose Data</data>
  <data key="d1">data</data>
  <data key="d2">Historical Glucose Data is the record of past glucose measurements over hours or days.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336918</data>
  <data key="d6"></data>
</node>
<node id="Real-Time Sensor (tR-SMCG)">
  <data key="d0">Real-Time Sensor (tR-SMCG)</data>
  <data key="d1">concept</data>
  <data key="d2">A sensor that shows glucose levels continuously in real time, used every day for prolonged periods.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336918</data>
  <data key="d6"></data>
</node>
<node id="Retro Sensor (retro-SMCG)">
  <data key="d0">Retro Sensor (retro-SMCG)</data>
  <data key="d1">concept</data>
  <data key="d2">A “blind” professional sensor that records glucose information without displaying it to the patient, later downloaded by a doctor.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336919</data>
  <data key="d6"></data>
</node>
<node id="Undetected Glucose Spikes">
  <data key="d0">Undetected Glucose Spikes</data>
  <data key="d1">concept</data>
  <data key="d2">Sudden increases in glucose that go unnoticed without continuous monitoring.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336919</data>
  <data key="d6"></data>
</node>
<node id="Data">
  <data key="d0">Data</data>
  <data key="d1">data</data>
  <data key="d2">The recorded glucose information captured by sensors for later analysis.&lt;SEP&gt;Data supporting each screening strategy are mentioned in the text.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211&lt;SEP&gt;chunk-8ba9c9c7fe9dd4e901eb52088f3d59f8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377363</data>
  <data key="d6"></data>
</node>
<node id="Finger Prick">
  <data key="d0">Finger Prick</data>
  <data key="d1">method</data>
  <data key="d2">A technique to obtain a blood sample for glucose measurement, used for calibration or extreme values.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336920</data>
  <data key="d6"></data>
</node>
<node id="Comfort">
  <data key="d0">Comfort</data>
  <data key="d1">concept</data>
  <data key="d2">The increased ease and reduced discomfort experienced by users due to fewer finger pricks when using sensors.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336920</data>
  <data key="d6"></data>
</node>
<node id="Trend Monitoring">
  <data key="d0">Trend Monitoring</data>
  <data key="d1">concept</data>
  <data key="d2">The ability of sensors to display glucose trends, indicating whether glucose levels are rising or falling.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336920</data>
  <data key="d6"></data>
</node>
<node id="Body Reaction Monitoring">
  <data key="d0">Body Reaction Monitoring</data>
  <data key="d1">concept</data>
  <data key="d2">The capability of sensors to show how the body responds to meals, exercise, and stress through glucose patterns.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336921</data>
  <data key="d6"></data>
</node>
<node id="Infarcts">
  <data key="d0">Infarcts</data>
  <data key="d1">concept</data>
  <data key="d2">Infarcts are heart attacks that can occur as a complication of poor glucose control.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336921</data>
  <data key="d6"></data>
</node>
<node id="Strokes">
  <data key="d0">Strokes</data>
  <data key="d1">concept</data>
  <data key="d2">Strokes are cerebrovascular events that can occur as a complication of poor glucose control.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336921</data>
  <data key="d6"></data>
</node>
<node id="Cell Function Changes">
  <data key="d0">Cell Function Changes</data>
  <data key="d1">concept</data>
  <data key="d2">Disglycemia can alter the way some cells function, including cells of the immune system.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336922</data>
  <data key="d6"></data>
</node>
<node id="Treatment of Diabetes">
  <data key="d0">Treatment of Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">The main goal of diabetes treatment is to avoid complications by keeping blood sugar within safe values.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336922</data>
  <data key="d6"></data>
</node>
<node id="1921 Insulin Discovery">
  <data key="d0">1921 Insulin Discovery</data>
  <data key="d1">event</data>
  <data key="d2">In 1921 insulin was discovered and tested in dogs, later being used in people.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="1925 Urine Glucose Test">
  <data key="d0">1925 Urine Glucose Test</data>
  <data key="d1">event</data>
  <data key="d2">In 1925 urine tests began to be used at home to detect sugar in the urine.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="1964 Blood Glucose Test">
  <data key="d0">1964 Blood Glucose Test</data>
  <data key="d1">event</data>
  <data key="d2">In 1964 the first blood glucose test using a drop of finger blood was introduced, starting glucose monitors.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="Glucose Monitor">
  <data key="d0">Glucose Monitor</data>
  <data key="d1">artifact</data>
  <data key="d2">Glucose monitors are devices that measure blood sugar, ranging from early finger‑prick tests to modern continuous sensors.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="Watch-like Glucose Meter">
  <data key="d0">Watch-like Glucose Meter</data>
  <data key="d1">artifact</data>
  <data key="d2">Watch-like glucose meters are devices that function as a watch or contact lens to measure glucose.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="Light/Heat Glucose Meter">
  <data key="d0">Light/Heat Glucose Meter</data>
  <data key="d1">artifact</data>
  <data key="d2">Light or heat glucose meters measure glucose using light or heat without needing a finger prick.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="Tattoo Glucose Sensor">
  <data key="d0">Tattoo Glucose Sensor</data>
  <data key="d1">artifact</data>
  <data key="d2">Tattoo glucose sensors are placed like a tattoo and display glucose through the skin.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="High HbA1c">
  <data key="d0">High HbA1c</data>
  <data key="d1">data</data>
  <data key="d2">High HbA1c values indicate higher average blood sugar and are associated with increased risk of complications.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336923</data>
  <data key="d6"></data>
</node>
<node id="Peaks of Glucose">
  <data key="d0">Peaks of Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Peaks of glucose are rapid rises and falls in blood sugar that HbA1c does not capture.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1786336924</data>
  <data key="d6"></data>
</node>
