  <data key="d15">Glucose Sensor</data>
  <data key="d16">Interstitial Fluid</data>
</edge>
<edge source="Interstitial Fluid" target="Bloodstream">
  <data key="d8">2.0</data>
  <data key="d9">Glucose moves from the bloodstream into the interstitial fluid, where it becomes accessible to cells.&lt;SEP&gt;Insulin moves through interstitial fluid before entering the bloodstream, and glucose levels are often measured in this fluid.</data>
  <data key="d10">cellular environment,glucose monitoring,insulin transport,nutrient diffusion</data>
  <data key="d11">chunk-4cd2f791e7cc88d9bd36c809feb7b626&lt;SEP&gt;chunk-20fd2bf061c46e98e4d7791fe6728699</data>
