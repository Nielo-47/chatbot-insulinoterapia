  <data key="d12">1786329759</data>
  <data key="d13"></data>
</edge>
<edge source="Blood Glucose Meter Reading" target="Enter BG Now Alert">
  <data key="d7">1.0</data>
  <data key="d8">If sensor glucose readings may be lower than actual glucose, an “Enter BG now” alert appears, requesting a BG meter reading.</data>
  <data key="d9">alert,prompt</data>
