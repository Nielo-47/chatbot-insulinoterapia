  <data key="d6"></data>
</node>
<node id="Titration Strategies">
  <data key="d0">Titration Strategies</data>
  <data key="d1">method</data>
  <data key="d2">Titration strategies describe how Afrezza doses are adjusted over time to achieve glycemic targets.</data>
  <data key="d3">chunk-5419de5a030f812ab408ef47f361bebd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/edelman-et-al-2026-dosing-afrezza-it-s-not-that-complicated.pdf</data>
