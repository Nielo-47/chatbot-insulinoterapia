  <data key="d6"></data>
</node>
<node id="askada@diabetes.org">
  <data key="d0">askada@diabetes.org</data>
  <data key="d1">content</data>
  <data key="d2">askada@diabetes.org is the official email address used by the American Diabetes Association for public inquiries and communication.</data>
  <data key="d3">chunk-c2823ad09fe972962f06cf3c6e063f23</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
