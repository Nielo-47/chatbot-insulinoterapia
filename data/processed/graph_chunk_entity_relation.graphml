<node id="Delivery Stopped Alarm">
  <data key="d0">Delivery Stopped Alarm</data>
  <data key="d1">concept</data>
  <data key="d2">Delivery Stopped Alarm notifies that the pump cannot deliver insulin and advises stopping pump use.</data>
  <data key="d3">chunk-71de01baf40871c616eaa39cb8189f43</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
