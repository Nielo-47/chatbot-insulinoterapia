<node id="Outcomes">
  <data key="d0">Outcomes</data>
  <data key="d1">concept</data>
  <data key="d2">Outcomes refer to clinical results such as A1C levels, hypoglycemia frequency, and overall diabetes control.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
