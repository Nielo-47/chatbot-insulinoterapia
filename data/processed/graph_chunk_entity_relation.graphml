<node id="Humalog Mix 50 Kwikpen">
  <data key="d0">Humalog Mix 50 Kwikpen</data>
  <data key="d1">artifact</data>
  <data key="d2">Humalog Mix 50 Kwikpen is a sterile injectable insulin suspension delivered in a pen device, intended for subcutaneous use and subject to specific storage conditions.</data>
  <data key="d3">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310737</data>
  <data key="d6"></data>
</node>
<node id="Refrigerated Storage (2°C‑8°C)">
  <data key="d0">Refrigerated Storage (2°C‑8°C)</data>
  <data key="d1">method</data>
  <data key="d2">Refrigerated storage at 2°C to 8°C is the required condition for unopened Humalog Mix 50 Kwikpen, protecting it from freezing, heat, and light.</data>
  <data key="d3">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310737</data>
  <data key="d6"></data>
</node>
<node id="Ambient Temperature Storage (15°C‑30°C)">
  <data key="d0">Ambient Temperature Storage (15°C‑30°C)</data>
  <data key="d1">method</data>
  <data key="d2">Ambient temperature storage at 15°C to 30°C is allowed for an opened Humalog Mix 50 Kwikpen for up to 28 days, with protection from light and heat.</data>
  <data key="d3">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310737</data>
  <data key="d6"></data>
</node>
<node id="Therapeutic Dose">
  <data key="d0">Therapeutic Dose</data>
  <data key="d1">concept</data>
  <data key="d2">Therapeutic dose is the correct insulin dosage intended to manage blood glucose safely.</data>
  <data key="d3">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310737</data>
  <data key="d6"></data>
</node>
<node id="Dosing">
  <data key="d0">Dosing</data>
  <data key="d1">concept</data>
  <data key="d2">Dosing refers to the process of determining and administering the appropriate amount of insulin.</data>
  <data key="d3">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310738</data>
  <data key="d6"></data>
</node>
<node id="Pen Applicator">
  <data key="d0">Pen Applicator</data>
  <data key="d1">artifact</data>
  <data key="d2">The pen applicator is the device component of Humalog Mix 50 Kwikpen used to deliver insulin injections.</data>
  <data key="d3">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310738</data>
  <data key="d6"></data>
</node>
<node id="Storage Instructions">
  <data key="d0">Storage Instructions</data>
  <data key="d1">method</data>
  <data key="d2">Storage instructions specify refrigerated or ambient temperature conditions for the medication.</data>
  <data key="d3">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
