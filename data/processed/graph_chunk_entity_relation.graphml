  <data key="d12">1786330051</data>
  <data key="d13"></data>
</edge>
<edge source="BG Meter" target="Low SG Alarm">
  <data key="d7">1.0</data>
  <data key="d8">Low SG alarms at or below 60 mg/dL may not reflect true BG and should be confirmed with a BG meter.</data>
  <data key="d9">verification</data>
  <data key="d10">chunk-4a4a75301f61fc3c86ad768de09d0c3f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329766</data>
  <data key="d13"></data>
</edge>
<edge source="BG Meter" target="Bolus Wizard Feature">
  <data key="d7">1.0</data>
  <data key="d8">The Bolus Wizard Feature uses a BG Meter reading to calculate correction bolus amounts.</data>
  <data key="d9">correction,data input</data>
  <data key="d10">chunk-542e3b31a3f3a9496f26d05d1255498a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330104</data>
  <data key="d13"></data>
</edge>
<edge source="BG Meter" target="Alert Two BG Checks Failed">
  <data key="d7">1.0</data>
  <data key="d8">The alert requires a BG meter reading within 30 minutes to clear.</data>
  <data key="d9">condition,requires</data>
  <data key="d10">chunk-8a0307c83d7b514ca00334e4c8ca2357</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330229</data>
  <data key="d13"></data>
</edge>
<edge source="BG Meter" target="Alert BG Calibration Required">
  <data key="d7">1.0</data>
  <data key="d8">The alert requires the user to enter a BG meter reading to calibrate the sensor.</data>
  <data key="d9">calibration,requires</data>
  <data key="d10">chunk-8a0307c83d7b514ca00334e4c8ca2357</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330230</data>
  <data key="d13"></data>
</edge>
<edge source="BG Meter" target="Alert System Verification Failed">
  <data key="d7">1.0</data>
  <data key="d8">The alert requires a BG meter reading to verify system performance.</data>
  <data key="d9">requires,verification</data>
  <data key="d10">chunk-8a0307c83d7b514ca00334e4c8ca2357</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786330233</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="Low SG">
  <data key="d7">1.0</data>
  <data key="d8">The Low SG Alarm is triggered when the low sensor glucose condition occurs.</data>
  <data key="d9">alert for</data>
  <data key="d10">chunk-db8e2f5011e0e0fe7dc11273e2f345b9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d12">1786329871</data>
  <data key="d13"></data>
</edge>
<edge source="Low SG Alarm" target="Changed Low SG Alarm">
  <data key="d7">1.0</data>
  <data key="d8">The Changed Low SG Alarm reflects a change to the existing Low SG Alarm settings.</data>
  <data key="d9">modification of</data>
  <data key="d10">chunk-db8e2f5011e0e0fe7dc11273e2f345b9</data>
