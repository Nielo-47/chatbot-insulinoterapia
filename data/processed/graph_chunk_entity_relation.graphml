  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698260</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Transport Conditions">
  <data key="d8">1.0</data>
  <data key="d9">Levemir must be transported with thermal protection to avoid freezing, light exposure, and vibration.</data>
  <data key="d10">environmental protection,handling requirement</data>
  <data key="d11">chunk-bc07da1fd30cc15e0022830f701a9c38</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698263</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Medication Error">
  <data key="d8">1.0</data>
  <data key="d9">Patients must check the Levemir label before injection to avoid accidental mix-up with other insulins.</data>
  <data key="d10">labeling,risk mitigation</data>
  <data key="d11">chunk-bc07da1fd30cc15e0022830f701a9c38</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698263</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Anaphylactic Reactions">
  <data key="d8">1.0</data>
  <data key="d9">Anaphylactic reactions are very rare but potentially life-threatening systemic events linked to Levemir use.</data>
  <data key="d10">life-threatening reaction,severe hypersensitivity</data>
  <data key="d11">chunk-ef496454c12f85ff1f62de19e8a22be4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698265</data>
  <data key="d14"></data>
</edge>
<edge source="Levemir" target="Edema">
  <data key="d8">1.0</data>
  <data key="d9">Edema is an uncommon adverse reaction associated with Levemir therapy.</data>
  <data key="d10">adverse reaction,fluid retention</data>
  <data key="d11">chunk-ef496454c12f85ff1f62de19e8a22be4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
