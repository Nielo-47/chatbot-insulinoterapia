  <data key="d0">Hipoglicêmicos Episódios</data>
  <data key="d1">event</data>
  <data key="d2">Hipoglicêmicos Episódios are hypoglycemic events whose frequency was reported as lower in the IHB group compared with animal‑insulin groups.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
