  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Level" target="Bolus Wizard">
  <data key="d8">2.0</data>
  <data key="d9">Blood glucose level is an input used by Bolus Wizard to determine the correct insulin bolus dose.&lt;SEP&gt;Blood Glucose Level is entered into the Bolus Wizard to adjust bolus dosage based on current readings.</data>
  <data key="d10">data input,dosage determination,input parameter,real-time adjustment</data>
  <data key="d11">chunk-97d9a9de5f40419555bf7bf36cc9f84c&lt;SEP&gt;chunk-b299154da4c58d8322b7ac4e3af2f5bf</data>
