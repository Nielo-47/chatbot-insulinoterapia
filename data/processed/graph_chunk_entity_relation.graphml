  <data key="d0">Temperature Up To 30°C</data>
  <data key="d1">concept</data>
  <data key="d2">Temperature Up To 30°C specifies the maximum ambient temperature at which SoloStar may be safely stored for up to 28 days.</data>
  <data key="d3">chunk-162882e6afffb0db8ae5e9153e5f1e82</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
