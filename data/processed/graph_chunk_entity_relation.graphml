  <data key="d5">1786373049</data>
  <data key="d6"></data>
</node>
<node id="Exames De Imagem">
  <data key="d0">Exames De Imagem</data>
  <data key="d1">method</data>
  <data key="d2">Exames De Imagem are imaging examinations employed to evaluate pancreatic disease in diabetes assessment.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373050</data>
  <data key="d6"></data>
</node>
<node id="Diagnosis And Classification Of Diabetes Mellitus">
  <data key="d0">Diagnosis And Classification Of Diabetes Mellitus</data>
  <data key="d1">content</data>
  <data key="d2">Diagnosis And Classification Of Diabetes Mellitus is a publication by the American Diabetes Association outlining diabetes types and diagnostic criteria.</data>
  <data key="d3">chunk-e4adabacd09697393ca15fc999724c51</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373050</data>
  <data key="d6"></data>
</node>
