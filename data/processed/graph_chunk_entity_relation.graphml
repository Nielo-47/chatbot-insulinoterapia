<edge source="Levemir" target="Hepatic Dysfunction">
  <data key="d7">1.0</data>
  <data key="d8">Patients with hepatic dysfunction using Levemir® need intensified glucose monitoring and individualized dose adjustment.</data>
  <data key="d9">dosage adjustment,monitoring</data>
