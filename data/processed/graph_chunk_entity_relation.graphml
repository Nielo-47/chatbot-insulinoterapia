  <data key="d5">1786324187</data>
  <data key="d6"></data>
</node>
<node id="Capillary Blood">
  <data key="d0">Capillary Blood</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Capillary Blood is the blood sampled by a glucose meter to obtain blood‑glucose readings (GS).&lt;SEP&gt;Capillary blood is the small-volume blood obtained from a fingertip, recommended for use with glucose oxidase monitors in patients with normal oxygen saturation.</data>
  <data key="d3">chunk-f5f31f609ed760b9e36f235d0109b470&lt;SEP&gt;chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
