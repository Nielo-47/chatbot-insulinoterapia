<node id="Adult Clinical Study (6‑Week Randomized Double‑Blind)">
  <data key="d0">Adult Clinical Study (6‑Week Randomized Double‑Blind)</data>
  <data key="d1">event</data>
  <data key="d2">A six‑week, randomized (2:1), double‑blind, parallel‑group study that assessed the compatibility of Fiasp® and NovoRapid® administered via CSII in adults with Type 1 diabetes.</data>
  <data key="d3">chunk-77c1608c27e3114f3a14f175efe260a4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
