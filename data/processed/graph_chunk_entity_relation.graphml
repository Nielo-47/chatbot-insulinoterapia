</node>
<node id="Carpule de Levemir Penfill">
  <data key="d0">Carpule de Levemir Penfill</data>
  <data key="d1">artifact</data>
  <data key="d2">Carpule de Levemir Penfill é um recipiente contendo 3 mL de solução injetável equivalente a 300 unidades de insulina detemir.</data>
  <data key="d3">chunk-d80de93eae49980367cf11700b83b1ee</data>
