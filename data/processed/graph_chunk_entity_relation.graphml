  <data key="d0">Recombinant DNA Technique</data>
  <data key="d1">method</data>
  <data key="d2">Recombinant DNA Technique is a biotechnological method used to produce insulin analogs.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1786331419</data>
  <data key="d6"></data>
</node>
<node id="Conventional Insulin Therapy">
  <data key="d0">Conventional Insulin Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Conventional Insulin Therapy uses fewer injections and less stringent glucose targets.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1786331420</data>
  <data key="d6"></data>
</node>
<node id="Diabetic Kidney Disease">
  <data key="d0">Diabetic Kidney Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetic Kidney Disease is a microvascular complication of diabetes affecting renal function.&lt;SEP&gt;A microvascular complication of diabetes leading to renal impairment.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2&lt;SEP&gt;chunk-74ef8c063d84e34c44021aa138b9b903</data>
