  <data key="d10">chunk-6419fb3ef4249d6c7e8d8a45d82efe80</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319794</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Administração de Excesso de Insulina">
  <data key="d7">1.0</data>
  <data key="d8">Overdose of insulin directly causes hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319808</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Perda ou Atraso das Refeições">
  <data key="d7">1.0</data>
  <data key="d8">Missing or delayed meals are a recognized cause of hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319808</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Exercício Excessivo">
  <data key="d7">1.0</data>
  <data key="d8">Physical activity above normal levels can precipitate hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319809</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Doenças Infecciosas">
  <data key="d7">1.0</data>
  <data key="d8">Infectious diseases, especially with diarrhea or vomiting, can trigger hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319809</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Glândulas Suprarrenais">
  <data key="d7">1.0</data>
  <data key="d8">Diseases of the adrenal glands can alter insulin needs and lead to hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319810</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Hipófise">
  <data key="d7">1.0</data>
  <data key="d8">Pituitary gland disorders can affect insulin requirements, causing hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319811</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Tireoide">
  <data key="d7">1.0</data>
  <data key="d8">Thyroid gland disease can modify insulin demand, resulting in hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319811</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Doença Renal">
  <data key="d7">1.0</data>
  <data key="d8">Kidney disease can significantly change insulin needs, leading to hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319812</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Doença Hepática">
  <data key="d7">1.0</data>
  <data key="d8">Liver disease can significantly change insulin needs, leading to hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319812</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Beta-bloqueadores">
  <data key="d7">1.0</data>
  <data key="d8">Beta‑blockers can diminish the warning symptoms of hypoglycemia.</data>
  <data key="d9">masking</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319813</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Hipoglicemiantes Orais">
  <data key="d7">1.0</data>
  <data key="d8">Oral hypoglycemic agents lower blood glucose and can cause hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319814</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Salicilatos">
  <data key="d7">2.0</data>
  <data key="d8">Salicylate drugs can reduce glucose levels, contributing to hypoglycemia.&lt;SEP&gt;Salicylates are mentioned as precipitating factors for hypoglycemia.</data>
  <data key="d9">cause,risk factor</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbede05ec60d9c79d637d9a0eb0efe48</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Hipoglicemia_SBD_transcricao.docx</data>
  <data key="d12">1786338285</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Sulfas">
  <data key="d7">1.0</data>
  <data key="d8">Sulfa drugs can lower blood glucose, increasing hypoglycemia risk.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319815</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Antidepressivos">
  <data key="d7">1.0</data>
  <data key="d8">Certain antidepressants can decrease blood glucose, leading to hypoglycemia.</data>
  <data key="d9">cause</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319815</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Bebidas Alcoólicas">
  <data key="d7">1.0</data>
  <data key="d8">Excessive consumption of alcoholic drinks can precipitate hypoglycemia.</data>
  <data key="d9">cause</data>
