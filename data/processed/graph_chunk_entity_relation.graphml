</node>
<node id="Unidades">
  <data key="d0">Unidades</data>
  <data key="d1">concept</data>
  <data key="d2">The unit measurement for insulin dosage, ranging from 1 to 60 units per injection.&lt;SEP&gt;The count of insulin doses administered.</data>
  <data key="d3">chunk-64d156e12ba8d9418249ea309aab0552&lt;SEP&gt;chunk-f369332c7e5ee7ed284fec07f68d394d</data>
