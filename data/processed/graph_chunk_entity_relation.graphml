  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330167</data>
  <data key="d6"></data>
</node>
<node id="Recurrent Hyperglycemia">
  <data key="d0">Recurrent Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Recurrent hyperglycemia denotes repeated high‑blood‑glucose readings listed as an indication for SICI use.</data>
