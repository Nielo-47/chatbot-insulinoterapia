  <data key="d5">1778704124</data>
  <data key="d6"></data>
</node>
<node id="Medicion Resultados">
  <data key="d0">Medicion Resultados</data>
  <data key="d1">data</data>
  <data key="d2">Medicion Resultados refers to blood glucose measurement values such as "Antes Comer", "Desp. Comer", or "En ayunas" used in diabetes monitoring.&gt;</data>
