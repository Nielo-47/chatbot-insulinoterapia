  <data key="d6"></data>
</node>
<node id="Clinical Care Guidelines for Cystic Fibrosis-Related Diabetes">
  <data key="d0">Clinical Care Guidelines for Cystic Fibrosis-Related Diabetes</data>
  <data key="d1">content</data>
  <data key="d2">Clinical Care Guidelines for Cystic Fibrosis-Related Diabetes is a guideline document endorsed by multiple organizations.</data>
  <data key="d3">chunk-9cdf6af658e42c2f4f7dca5e4dbdd3db</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
