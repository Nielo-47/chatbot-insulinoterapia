  <data key="d0">Lung Macrophages</data>
  <data key="d1">concept</data>
  <data key="d2">Lung macrophages are highlighted for their significance in clearing inhaled macromolecules.</data>
  <data key="d3">chunk-d4c5bc67580e092cf1b0f395c39326f1</data>
