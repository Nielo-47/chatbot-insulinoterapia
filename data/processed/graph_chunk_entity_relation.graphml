</node>
<node id="Fotocoagulation">
  <data key="d0">Fotocoagulation</data>
  <data key="d1">method</data>
  <data key="d2">Fotocoagulation is a laser treatment used to manage proliferative retinopathy.</data>
  <data key="d3">chunk-d59c9bf7f429a82cbfd7083e36ff8f9a</data>
