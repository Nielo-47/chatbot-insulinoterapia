<node id="Seção 8">
  <data key="d0">Seção 8</data>
  <data key="d1">concept</data>
  <data key="d2">Seção 8 is the eighth section of the medication leaflet, detailing dosage and administration guidelines.</data>
  <data key="d3">chunk-759c20cc4c3fc0d3529aabc2fe7dbf99</data>
