  <data key="d13"></data>
</edge>
<edge source="HAPO Follow‑up Study (HAPO FUS)" target="Neonatal Adiposity">
  <data key="d7">1.0</data>
  <data key="d8">The study identified neonatal adiposity as a mediator of later childhood body fat.</data>
  <data key="d9">association,mediation</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377717</data>
  <data key="d13"></data>
</edge>
<edge source="HAPO Follow‑up Study (HAPO FUS)" target="Fetal Hyperinsulinemia">
  <data key="d7">1.0</data>
  <data key="d8">The study linked higher fetal C‑peptide levels (hyperinsulinemia) to maternal hyperglycemia.</data>
  <data key="d9">association,mediation</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377718</data>
  <data key="d13"></data>
</edge>
<edge source="HAPO Follow‑up Study (HAPO FUS)" target="Offspring Metabolic Outcomes">
  <data key="d7">1.0</data>
  <data key="d8">The study links maternal hyperglycemia to offspring metabolic outcomes such as insulin sensitivity and oral disposition index.</data>
  <data key="d9">association,mediation</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377720</data>
  <data key="d13"></data>
</edge>
<edge source="Childhood Body Fat" target="Offspring Metabolic Outcomes">
  <data key="d7">1.0</data>
  <data key="d8">Offspring metabolic outcomes, including neonatal adiposity, mediate increased childhood body fat.</data>
  <data key="d9">association,mediation</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377721</data>
  <data key="d13"></data>
</edge>
