  <data key="d0">One Step Versus Two Step Approach</data>
  <data key="d1">method</data>
  <data key="d2">One Step Versus Two Step Approach is a comparative screening strategy for gestational diabetes mellitus evaluated in a meta‑analysis of randomized trials.</data>
