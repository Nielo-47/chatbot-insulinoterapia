  <data key="d0">SmartGuard Start Cancelled Alert</data>
  <data key="d1">concept</data>
  <data key="d2">An alert indicating that an operation not allowed during transition to SmartGuard was selected.</data>
  <data key="d3">chunk-4b8de1434b9d9f57cd225b5d3e0d7f3b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
