  <data key="d6"></data>
</node>
<node id="Proteinuria">
  <data key="d0">Proteinuria</data>
  <data key="d1">concept</data>
  <data key="d2">Presence of protein in urine occurring even without diabetes, improves with metreleptin.&lt;SEP&gt;Proteinuria is a kidney condition evaluated in relation to metreleptin treatment.&lt;SEP&gt;Proteinuria is the presence of excess protein in urine, used as a clinical marker of kidney involvement.</data>
  <data key="d3">chunk-336c6084eb6cb7c8ada29ed26c0cd20d&lt;SEP&gt;chunk-eb7105c2156cb3f814ebb240d4a8a1fb&lt;SEP&gt;chunk-005de970178a46619506bcc15fe94fa9</data>
