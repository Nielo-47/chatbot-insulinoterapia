<node id="Injection Angle">
  <data key="d0">Injection Angle</data>
  <data key="d1">method</data>
  <data key="d2">The angle at which the needle is inserted into the skin, either 45 or 90 degrees depending on needle length and patient age.&lt;SEP&gt;The angle at which insulin is injected, either 45 or 90 degrees, depending on needle length and patient age.&lt;SEP&gt;Injection angle refers to the degree at which the needle is inserted into the skin, varying between 90° and 45° depending on needle length and patient characteristics.</data>
  <data key="d3">chunk-e68da6d45eb01c249e854b711007d805&lt;SEP&gt;chunk-afd148f1edc7929cecea8e4d981ed04e&lt;SEP&gt;chunk-7cb18b1ccdbe7c3a6bbce149470c1ca1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Insulinas CANETAS.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas FRASCOS.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1778695969</data>
  <data key="d6"></data>
</node>
<node id="Needle Disposal Container">
  <data key="d0">Needle Disposal Container</data>
  <data key="d1">artifact</data>
  <data key="d2">A rigid container used to safely discard used needles and lancets, such as a fabric softener or disinfectant bottle.</data>
  <data key="d3">chunk-e68da6d45eb01c249e854b711007d805</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Insulinas CANETAS.pdf</data>
