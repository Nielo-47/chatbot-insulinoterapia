  <data key="d0">Polissorbato 20</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Polissorbato 20 is an excipient present in the Lantus frasco‑ampola formulation.&lt;SEP&gt;Polissorbato 20 is an excipient listed in the composition of APIDRA® SOLOSTAR®.</data>
  <data key="d3">chunk-572e715aada476f4dac69a032e16cc09&lt;SEP&gt;chunk-fb620bf44b37187faceacd0405c4a819</data>
