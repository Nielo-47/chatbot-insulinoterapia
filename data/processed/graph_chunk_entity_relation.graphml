  <data key="d6"></data>
</node>
<node id="Macronutrient Retention">
  <data key="d0">Macronutrient Retention</data>
  <data key="d1">concept</data>
  <data key="d2">Macronutrient Retention refers to the preservation of proteins, fats, and carbohydrates promoted by insulin therapy.</data>
  <data key="d3">chunk-9cdf6af658e42c2f4f7dca5e4dbdd3db</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
