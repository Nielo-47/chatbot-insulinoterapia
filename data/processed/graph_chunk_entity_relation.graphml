  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703192</data>
  <data key="d14"></data>
</edge>
<edge source="Bomba De Insulina" target="Programación De La Bomba De Insulina">
  <data key="d8">1.0</data>
  <data key="d9">Programación de la bomba de insulina configures insulin delivery parameters on the device.</data>
  <data key="d10">device setup,therapy customization</data>
  <data key="d11">chunk-01ce95c3ebe034549347b078008daa3c</data>
