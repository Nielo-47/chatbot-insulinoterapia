  <data key="d0">MiniMed Mobile</data>
  <data key="d1">artifact</data>
  <data key="d2">MiniMed Mobile is a mobile application for managing the MiniMed insulin pump.&lt;SEP&gt;MiniMed Mobile is a mobile application that allows users to configure and sync their MiniMed pump with CareLink.</data>
  <data key="d3">chunk-9855ca7ae42a0c01685280c4cc5bb56a&lt;SEP&gt;chunk-1c8229e79576a8ad79f8dc8a3290e5ac</data>
