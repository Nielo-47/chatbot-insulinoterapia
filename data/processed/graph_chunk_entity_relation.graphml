  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699188</data>
  <data key="d14"></data>
</edge>
<edge source="Cross-Infection" target="Novolin® R FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">Sharing the Novolin® R FlexPen® with others is prohibited due to the risk of cross-infection.</data>
