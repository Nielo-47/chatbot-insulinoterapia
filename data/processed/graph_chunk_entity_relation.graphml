  <data key="d14"></data>
  <data key="d15">HbA1c</data>
  <data key="d16">Kidney Disease</data>
</edge>
<edge source="HbA1c" target="Genetic Blood Disorders">
  <data key="d8">1.0</data>
  <data key="d9">Genetic blood disorders can lead to erroneous HbA1c values due to abnormalities in hemoglobin structure or turnover.</data>
  <data key="d10">test interference, diagnostic limitation</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
