  <data key="d6"></data>
</node>
<node id="Metal Detectors">
  <data key="d0">Metal Detectors</data>
  <data key="d1">artifact</data>
  <data key="d2">Metal detectors are security devices that allow passengers to pass with an insulin pump without removal.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1786325540</data>
  <data key="d6"></data>
</node>
<node id="Full‑Body Scanner">
  <data key="d0">Full‑Body Scanner</data>
  <data key="d1">artifact</data>
  <data key="d2">A full‑body scanner is a security device that may require temporary removal of an insulin pump for inspection.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1786325540</data>
  <data key="d6"></data>
</node>
<node id="Airport Emergency Card">
  <data key="d0">Airport Emergency Card</data>
  <data key="d1">artifact</data>
  <data key="d2">The airport emergency card is a printed card that travelers should carry to inform security personnel of their diabetes and insulin‑pump use.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1786325541</data>
  <data key="d6"></data>
</node>
<node id="Low Blood Glucose">
  <data key="d0">Low Blood Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Low blood glucose is a condition of insufficient glucose in the bloodstream that can cause symptoms requiring rapid treatment.&lt;SEP&gt;Low blood glucose describes blood glucose levels at or below 70 mg/dL that can cause symptoms and need immediate treatment.&lt;SEP&gt;Low Blood Glucose refers to a blood glucose level below normal, often below 70 mg/dL.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4&lt;SEP&gt;chunk-0645201ac55eff389c44997aecbb6ce7&lt;SEP&gt;chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372321</data>
  <data key="d6"></data>
</node>
<node id="Travel Delays">
  <data key="d0">Travel Delays</data>
  <data key="d1">concept</data>
  <data key="d2">Travel delays refer to situations where flights are postponed or cancelled, affecting passengers’ needs for food and supplies.</data>
