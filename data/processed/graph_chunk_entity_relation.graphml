  <data key="d6"></data>
</node>
<node id="Tiras de Glicemia">
  <data key="d0">Tiras de Glicemia</data>
  <data key="d1">artifact</data>
  <data key="d2">Tiras de glicemia are disposable test strips used with the glucose meter to measure blood glucose.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1786337566</data>
  <data key="d6"></data>
</node>
<node id="Caderno/Diário">
  <data key="d0">Caderno/Diário</data>
  <data key="d1">artifact</data>
  <data key="d2">Caderno/diário is a paper notebook where patients can record glucose values, medication doses, meals, and exercise.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
