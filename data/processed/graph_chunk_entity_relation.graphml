<node id="Reutilização da Agulha">
  <data key="d0">Reutilização da Agulha</data>
  <data key="d1">concept</data>
  <data key="d2">Reutilização da Agulha refers to the practice of using the same insulin needle multiple times, increasing risk of lipodistrofia.</data>
