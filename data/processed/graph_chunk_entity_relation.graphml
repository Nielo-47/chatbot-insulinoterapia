  <data key="d6"></data>
</node>
<node id="Agulha Removível">
  <data key="d0">Agulha Removível</data>
  <data key="d3">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
  <data key="d2">Using an insulin syringe with a detachable needle can lead to volume loss and inaccurate dosing due to dead space.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1778696023</data>
  <data key="d6"></data>
</node>
<node id="Vacinas">
  <data key="d0">Vacinas</data>
  <data key="d3">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
  <data key="d2">Vaccines and insulin should not be stored in the same refrigerator section to maintain proper temperature and prevent confusion.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
