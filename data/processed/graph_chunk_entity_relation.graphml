</node>
<node id="SAC">
  <data key="d0">SAC</data>
  <data key="d1">organization</data>
  <data key="d2">SAC is the customer service channel for Novo Nordisk in Brazil, reachable at 0800 0144488 for product-related inquiries and support.&lt;SEP&gt;SAC is a customer service channel reachable via the toll-free number 0800 0144488 for inquiries related to Novo Nordisk products.</data>
  <data key="d3">chunk-6ca90008a805c9c66eac7ba65db90fdb&lt;SEP&gt;chunk-bad7b7e8e5212b6d7ea0f4b0505f82c0</data>
