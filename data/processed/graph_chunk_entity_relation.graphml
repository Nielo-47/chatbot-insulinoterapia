</node>
<node id="Special DM1 Groups">
  <data key="d0">Special DM1 Groups</data>
  <data key="d1">concept</data>
  <data key="d2">Special DM1 groups include pregnant women, children, adolescents, and athletes for whom SICI may be offered.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1786330168</data>
  <data key="d6"></data>
</node>
<node id="Irregular Lifestyle">
  <data key="d0">Irregular Lifestyle</data>
  <data key="d1">concept</data>
  <data key="d2">Irregular lifestyle covers frequent long‑distance travel, shift work, or unpredictable schedules and is cited as an indication for SICI in DM2.</data>
  <data key="d3">chunk-6fba8ea0c6bdb8427804ba05f9fe49f9</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
