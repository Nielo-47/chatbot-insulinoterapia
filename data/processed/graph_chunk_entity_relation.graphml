<node id="B‑cell Deficiency">
  <data key="d0">B‑cell Deficiency</data>
  <data key="d1">concept</data>
  <data key="d2">A reduction in pancreatic B‑cell mass or function that becomes evident over time and contributes to hyperglycemia.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377407</data>
  <data key="d6"></data>
</node>
<node id="B‑cell Mass">
  <data key="d0">B‑cell Mass</data>
  <data key="d1">concept</data>
  <data key="d2">The quantity of pancreatic B‑cells, loss of which contributes to diabetes progression.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377407</data>
  <data key="d6"></data>
</node>
<node id="B‑cell Function">
  <data key="d0">B‑cell Function</data>
  <data key="d1">concept</data>
  <data key="d2">The ability of pancreatic B‑cells to secrete insulin; dysfunction leads to hyperglycemia.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377407</data>
  <data key="d6"></data>
</node>
<node id="Latent Autoimmune Diabetes in Adults (LADA)">
  <data key="d0">Latent Autoimmune Diabetes in Adults (LADA)</data>
  <data key="d1">concept</data>
  <data key="d2">An adult‑onset autoimmune diabetes considered a subset of type 1 diabetes.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377407</data>
  <data key="d6"></data>
</node>
<node id="Insulin Secretory Defects">
  <data key="d0">Insulin Secretory Defects</data>
  <data key="d1">concept</data>
  <data key="d2">Deficiencies in insulin secretion linked to genetics, inflammation, and metabolic stress in type 2 diabetes.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377407</data>
  <data key="d6"></data>
</node>
<node id="Plasma Glucose Criteria">
  <data key="d0">Plasma Glucose Criteria</data>
  <data key="d1">concept</data>
  <data key="d2">Diagnostic thresholds based on fasting or 2‑hour plasma glucose measurements.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377407</data>
  <data key="d6"></data>
</node>
<node id="2‑hour Plasma Glucose (2‑h PG)">
  <data key="d0">2‑hour Plasma Glucose (2‑h PG)</data>
  <data key="d1">method</data>
  <data key="d2">A glucose measurement taken two hours after a 75‑g oral glucose tolerance test.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377407</data>
  <data key="d6"></data>
</node>
<node id="Ethnic and Racial Minorities">
  <data key="d0">Ethnic and Racial Minorities</data>
  <data key="d1">concept</data>
  <data key="d2">Population groups in which type 2 diabetes may present with DKA more frequently.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Classification System">
  <data key="d0">Diabetes Classification System</data>
  <data key="d1">concept</data>
  <data key="d2">An evolving framework aiming to categorize diabetes subtypes based on pathophysiology.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Pathophysiology">
  <data key="d0">Diabetes Pathophysiology</data>
  <data key="d1">concept</data>
  <data key="d2">The underlying biological mechanisms, including B‑cell loss and autoimmunity, that lead to diabetes.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Chronic Complications">
  <data key="d0">Chronic Complications</data>
  <data key="d1">concept</data>
  <data key="d2">Long‑term health issues such as cardiovascular disease, neuropathy, and retinopathy that develop in individuals with any form of diabetes.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Personalized Treatment Approaches">
  <data key="d0">Personalized Treatment Approaches</data>
  <data key="d1">concept</data>
  <data key="d2">Tailored therapeutic strategies designed for individual diabetes patients based on detailed pathophysiological and genetic profiling.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Autoantibody Titer">
  <data key="d0">Autoantibody Titer</data>
  <data key="d1">concept</data>
  <data key="d2">The quantitative level of autoantibodies present, influencing the rate of progression to clinical diabetes.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Stage 1 Diabetes">
  <data key="d0">Stage 1 Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">The earliest stage of type 1 diabetes characterized by autoimmunity with normoglycemia.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Stage 2 Diabetes">
  <data key="d0">Stage 2 Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">The intermediate stage of type 1 diabetes marked by dysglycemia but not overt hyperglycemia.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377408</data>
  <data key="d6"></data>
</node>
<node id="Stage 3 Diabetes">
  <data key="d0">Stage 3 Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">The final stage of type 1 diabetes where overt hyperglycemia is present.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377409</data>
  <data key="d6"></data>
</node>
<node id="Overt Diabetes">
  <data key="d0">Overt Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Full‑blown hyperglycemia characteristic of Stage 3 diabetes.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377409</data>
  <data key="d6"></data>
</node>
<node id="Marginal Insulin Secretory Capacity">
  <data key="d0">Marginal Insulin Secretory Capacity</data>
  <data key="d1">concept</data>
  <data key="d2">Limited ability of pancreatic β‑cells to secrete insulin, typical in adults with LADA.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377409</data>
  <data key="d6"></data>
</node>
<node id="Insulin Initiation">
  <data key="d0">Insulin Initiation</data>
  <data key="d1">concept</data>
  <data key="d2">The commencement of insulin therapy, often accelerated in LADA to prevent deterioration of glucose control.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377409</data>
  <data key="d6"></data>
</node>
<node id="Detection Rates">
  <data key="d0">Detection Rates</data>
  <data key="d1">concept</data>
  <data key="d2">The proportion of individuals correctly identified by various diabetes screening tests.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377409</data>
  <data key="d6"></data>
</node>
<node id="Rate of Progression">
  <data key="d0">Rate of Progression</data>
  <data key="d1">concept</data>
  <data key="d2">The speed at which diabetes advances, dependent on factors such as autoantibody number, specificity, and titer.</data>
  <data key="d3">chunk-ba38023866c2db7437e618a60033f21f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377409</data>
  <data key="d6"></data>
</node>
<node id="TEDDY Study">
  <data key="d0">TEDDY Study</data>
  <data key="d1">concept</data>
  <data key="d2">The Environmental Determinants of Diabetes in the Young (TEDDY) Study is a longitudinal study that observed type 1 diabetes development in children with autoantibodies.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
