<node id="Sol">
  <data key="d0">Sol</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Sol is sunlight, another hot condition that can cause insulin to lose its effect.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
