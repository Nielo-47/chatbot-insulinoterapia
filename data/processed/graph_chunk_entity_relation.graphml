  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694530</data>
  <data key="d14"></data>
</edge>
<edge source="Aplicação De Insulina" target="Prega Subcutânea">
  <data key="d8">1.0</data>
  <data key="d9">A prega subcutânea é uma técnica usada durante a aplicação de insulina para garantir que o medicamento atinja o tecido subcutâneo.</data>
  <data key="d10">injection method,tissue targeting</data>
