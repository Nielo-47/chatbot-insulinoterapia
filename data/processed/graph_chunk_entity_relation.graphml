  <data key="d3">chunk-cc432bf15c11ef31f7aff87b534b5eaf</data>
  <data key="d2">The prediction algorithms are used to interpret genetic variants of autosomal dominant monogenic diabetes.</data>
  <data key="d1">UNKNOWN</data>
