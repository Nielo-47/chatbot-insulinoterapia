  <data key="d13">1778699645</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Hyperglycemic Agents">
  <data key="d8">1.0</data>
  <data key="d9">Hyperglycemic agents such as corticosteroids and oral contraceptives can increase insulin requirements in patients using Humulin R.</data>
  <data key="d10">drug interaction,increased insulin need</data>
  <data key="d11">chunk-128e097e2326548df575159ee000923b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699646</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Oral Antidiabetic Agents">
  <data key="d8">1.0</data>
  <data key="d9">Oral antidiabetic agents can reduce the insulin requirements of patients using Humulin R.</data>
  <data key="d10">decreased insulin need,drug interaction</data>
