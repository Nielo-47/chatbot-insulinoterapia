  <data key="d13">1778702661</data>
  <data key="d14"></data>
</edge>
<edge source="Interstitial Fluid" target="Cells">
  <data key="d8">1.0</data>
  <data key="d9">Cells absorb glucose from the interstitial fluid to produce energy.</data>
  <data key="d10">energy uptake,nutrient absorption</data>
