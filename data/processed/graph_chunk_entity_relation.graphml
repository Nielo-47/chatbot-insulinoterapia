</node>
<node id="Metabolite M1 (21A‑Gly‑insulin)">
  <data key="d0">Metabolite M1 (21A‑Gly‑insulin)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Metabolite M1 is an active metabolite formed from insulin glargine metabolism with in‑vitro activity similar to insulin.</data>
  <data key="d3">chunk-f14ce019f10c2a88765380143498ba5b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
