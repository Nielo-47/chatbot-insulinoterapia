  <data key="d13">1778699078</data>
  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="Medication Incompatibility">
  <data key="d8">1.0</data>
  <data key="d9">Mixing Novolin® R with incompatible medications, such as those containing thiols or sulfides, may lead to insulin degradation.</data>
  <data key="d10">degradation risk,drug interaction</data>
  <data key="d11">chunk-ff021af578e58080f6a865c5f105e6d3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699084</data>
  <data key="d14"></data>
</edge>
<edge source="Novolin® R Penfill" target="NovoFine® Needle">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill is designed to be used with NovoFine® needles up to 8 mm in length.</data>
