  <data key="d6"></data>
</node>
<node id="Gaze">
  <data key="d0">Gaze</data>
  <data key="d1">artifact</data>
  <data key="d2">Gaze is a sterile gauze used to clean the injection site before insulin administration.&lt;SEP&gt;A piece of gauze applied gently to the injection site if blood appears after needle removal.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792&lt;SEP&gt;chunk-1aba4eb027a027fb1ad6e0105b97cfa3</data>
  <data key="d4">data/raw/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d5">1786310754</data>
  <data key="d6"></data>
</node>
<node id="Álcool 70%">
  <data key="d0">Álcool 70%</data>
  <data key="d1">artifact</data>
  <data key="d2">Álcool 70% is a disinfectant applied to the skin prior to injection.&lt;SEP&gt;Álcool 70% is the alcohol solution used for performing aseptic skin preparation before insulin injection.&lt;SEP&gt;Disinfectant used to clean the injection site and needle.&lt;SEP&gt;Disinfectant recommended for cleaning skin in clinical settings before insulin injection.&lt;SEP&gt;70 % alcohol is the disinfectant used to clean insulin vials and injection sites.&lt;SEP&gt;A 70% alcohol solution used for antisepsis before finger puncture.</data>
  <data key="d3">chunk-54575ceb6b15fc8abcc2afcec7b36792&lt;SEP&gt;chunk-b64741e11a7d852f462b1269fabfbe43&lt;SEP&gt;chunk-e490a7e963a20e2221a8097b50073543&lt;SEP&gt;chunk-780053d90e5c36ef6ea68e1a598cc53b&lt;SEP&gt;chunk-59ce0fcadc9ae2a47a525390ae59d81c&lt;SEP&gt;chunk-e5570f88766511a4a62cbe9a2dff0bdb</data>
