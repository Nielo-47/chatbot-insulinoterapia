</edge>
<edge source="TTGO-1h" target="Pré-diabetes">
  <data key="d7">1.0</data>
  <data key="d8">TTGO‑1h ≥ 155 mg/dl and &lt; 209 mg/dl is used to detect Pré-diabetes.</data>
  <data key="d9">diagnostic criterion</data>
