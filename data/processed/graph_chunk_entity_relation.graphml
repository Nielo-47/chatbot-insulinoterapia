</edge>
<edge source="Cetoacidosis Diabética" target="Cuerpos Cetónicos">
  <data key="d7">2.0</data>
  <data key="d8">Ketone bodies are measured to assess the risk of diabetic ketoacidosis.&lt;SEP&gt;Presence of ketone bodies signals diabetic ketoacidosis.</data>
  <data key="d9">diagnosis,indicator,risk assessment</data>
