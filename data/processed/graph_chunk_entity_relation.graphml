  <data key="d0">Seção 4</data>
  <data key="d1">concept</data>
  <data key="d2">Seção 4 is the fourth section of the medication leaflet, covering contraindications.</data>
  <data key="d3">chunk-759c20cc4c3fc0d3529aabc2fe7dbf99</data>
