  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Thermal Packaging">
  <data key="d7">1.0</data>
  <data key="d8">When transporting insulin with thermal packaging, precautions must prevent direct contact with ice to avoid damage.</data>
