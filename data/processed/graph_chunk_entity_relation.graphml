  <data key="d6"></data>
</node>
<node id="Sensor Life">
  <data key="d0">Sensor Life</data>
  <data key="d1">concept</data>
  <data key="d2">Sensor Life indicates the operational duration of a sensor, specified as 14 days with a 23:00 hour countdown display.&lt;SEP&gt;Sensor Life indicates the remaining operational duration of the glucose sensor.</data>
  <data key="d3">chunk-f2667d6936a8a9a26e886ba90b060796&lt;SEP&gt;chunk-6f114a018f4d8b34373a039564245abf</data>
