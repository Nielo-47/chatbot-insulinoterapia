  <data key="d0">Insulina Clara</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulina Clara refers to a clear insulin analogue whose stability trend was observed in the study.</data>
  <data key="d3">chunk-8375bd3e65b9aa9965acd81fd9a448f8</data>
