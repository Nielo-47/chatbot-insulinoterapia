<node id="Câncer">
  <data key="d0">Câncer</data>
  <data key="d1">concept</data>
  <data key="d2">Câncer is listed as a chronic comorbidity and as part of the definition of doença terminal.</data>
  <data key="d3">chunk-9dee0a79e4583f41e757f9a20f56f397</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
