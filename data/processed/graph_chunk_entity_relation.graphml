  <data key="d13">1778707659</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="MiniMed 780G System">
  <data key="d8">2.0</data>
  <data key="d9">The CGM device is integrated with the MiniMed 780G system to provide real-time glucose data.&lt;SEP&gt;The CGM device must be re-paired with the MiniMed 780G system after a pump restart.</data>
  <data key="d10">device pairing,glucose monitoring,glucose sensing,integrated monitoring</data>
