  <data key="d6"></data>
</node>
<node id="BMI Z‑Score 2.15">
  <data key="d0">BMI Z‑Score 2.15</data>
  <data key="d1">data</data>
  <data key="d2">Body mass index Z‑score reported for TODAY study participants.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
