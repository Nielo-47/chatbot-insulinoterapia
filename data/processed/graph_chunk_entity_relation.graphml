  <data key="d6"></data>
</node>
<node id="CGM Device Alarms Alerts and Messages">
  <data key="d0">CGM Device Alarms Alerts and Messages</data>
  <data key="d1">content</data>
  <data key="d2">CGM device alarms, alerts, and messages are notifications generated by the continuous glucose monitoring system.</data>
  <data key="d3">chunk-4a75df3ab63706f501e8d3134e74a64b</data>
