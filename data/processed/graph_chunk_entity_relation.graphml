<node id="Type 1 Diabetes Patients">
  <data key="d0">Type 1 Diabetes Patients</data>
  <data key="d1">concept</data>
  <data key="d2">Patients with type 1 diabetes are a clinical population examined for insulin glargine pharmacology.</data>
