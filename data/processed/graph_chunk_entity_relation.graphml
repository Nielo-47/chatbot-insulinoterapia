  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia Noturna" target="Memória">
  <data key="d7">1.0</data>
  <data key="d8">Nighttime hypoglycemia can affect memory consolidation during sleep.</data>
  <data key="d9">cognitive,impact</data>
