  <data key="d5">1778710101</data>
  <data key="d6"></data>
  <data key="d7">Fasting Blood Glucose</data>
</node>
<node id="Postprandial Blood Glucose">
  <data key="d0">Postprandial Blood Glucose</data>
  <data key="d1">data</data>
  <data key="d2">Postprandial blood glucose refers to blood sugar levels measured after meals, an important metric in diabetes management.&lt;SEP&gt;Postprandial blood glucose measures glucose levels after meals, reflecting acute glucose fluctuations.</data>
  <data key="d3">chunk-b91b40e47c97be1b62c0f3d271cd4efd&lt;SEP&gt;chunk-3a1c7be3f5278cc80c8bc958c35be31c</data>
