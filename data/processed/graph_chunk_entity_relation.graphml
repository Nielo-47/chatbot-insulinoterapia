</node>
<node id="Garrafa De Água Sanitária">
  <data key="d0">Garrafa De Água Sanitária</data>
  <data key="d1">artifact</data>
  <data key="d2">Garrafa de água sanitária is a repurposed plastic bottle used as a safe container for disposing of used needles at home.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
  <data key="d5">1778694916</data>
  <data key="d6"></data>
</node>
<node id="Bolsinha Térmica">
  <data key="d0">Bolsinha Térmica</data>
  <data key="d1">artifact</data>
  <data key="d2">Bolsinha térmica is an insulated bag used to carry insulin and keep it at a safe temperature during travel.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
  <data key="d4">data/raw/Documento sem título.docx</data>
  <data key="d5">1778694916</data>
  <data key="d6"></data>
</node>
<node id="Duas Horas Depois De Comer">
  <data key="d0">Duas Horas Depois De Comer</data>
  <data key="d1">concept</data>
  <data key="d2">Duas horas depois de comer is a recommended time to check blood glucose, with a target of up to 180 mg/dL.</data>
