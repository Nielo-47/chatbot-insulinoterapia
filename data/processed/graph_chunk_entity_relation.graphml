  <data key="d13">1778703116</data>
  <data key="d14"></data>
</edge>
<edge source="Airport Security Devices" target="Emergency Travel Card">
  <data key="d8">1.0</data>
  <data key="d9">The emergency travel card should be carried to inform security personnel about medical conditions and devices during airport screening.</data>
  <data key="d10">medical identification,travel preparation</data>
  <data key="d11">chunk-40aae9750bff384ac9028ae500bc1fb4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
