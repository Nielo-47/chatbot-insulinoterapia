  <data key="d1">creature</data>
  <data key="d2">Dog #409 is a laboratory dog used as an experimental control that did not receive the extract and died quickly.</data>
  <data key="d3">chunk-eff48c1408719e81f1f423f76dfd19e5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
