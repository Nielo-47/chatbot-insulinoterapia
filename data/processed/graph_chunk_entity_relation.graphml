  <data key="d1">method</data>
  <data key="d2">Therapy Management encompasses the ongoing tracking and adjustment of insulin delivery, glucose monitoring, and dietary intake for diabetes control.</data>
  <data key="d3">chunk-b392b58ab9f757711d038354d82e450e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
