  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694531</data>
  <data key="d14"></data>
</edge>
<edge source="Aplicação De Insulina" target="Tecido Subcutâneo">
  <data key="d8">1.0</data>
  <data key="d9">A insulina deve ser aplicada no tecido subcutâneo para garantir absorção correta.</data>
  <data key="d10">anatomical target,drug delivery</data>
