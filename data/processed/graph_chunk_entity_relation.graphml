  <data key="d0">Múltiplas comorbidades crônicas</data>
  <data key="d1">concept</data>
  <data key="d2">Múltiplas comorbidades crônicas indicates the presence of several chronic diseases.</data>
  <data key="d3">chunk-9dee0a79e4583f41e757f9a20f56f397</data>
