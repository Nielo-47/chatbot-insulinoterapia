<edge source="APIDRA SOLOSTAR" target="Storage Conditions">
  <data key="d7">1.0</data>
  <data key="d8">APIDRA SOLOSTAR must be stored in its original packaging, refrigerated between 2 °C and 8 °C, protected from light, and not frozen; discard if frozen.</data>
  <data key="d9">storage,temperature</data>
  <data key="d10">chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
