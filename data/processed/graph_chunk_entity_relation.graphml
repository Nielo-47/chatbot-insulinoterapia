  <data key="d1">person</data>
  <data key="d2">Charlotte Clarke was a 57‑year‑old diabetic with a gangrenous leg admitted to Toronto General Hospital on July 9 1922; she was considered for experimental insulin treatment by Frederick Banting.</data>
  <data key="d3">chunk-17a38cd3b50722f2d9ae2a618121bb61</data>
