  <data key="d13">1778703049</data>
  <data key="d14"></data>
</edge>
<edge source="Bomba De Insulina" target="SAP">
  <data key="d8">1.0</data>
  <data key="d9">SAP utiliza datos de glucosa para ajustar automáticamente la administración de insulina mediante la bomba.</data>
  <data key="d10">automated control,technology integration</data>
  <data key="d11">chunk-d0fdf7fe6f512616144e110952e56f02</data>
