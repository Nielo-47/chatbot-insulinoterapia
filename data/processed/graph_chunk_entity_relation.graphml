  <data key="d13">1778707583</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Alert Before Low">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device generates an Alert Before Low when sensor glucose levels are nearing the predefined low limit.</data>
  <data key="d10">glucose monitoring,threshold alert</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707585</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Alert On High">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device activates an Alert On High when sensor glucose reaches or exceeds the high limit.</data>
  <data key="d10">critical threshold,glucose monitoring</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707587</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Alert On Low">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device issues an Alert On Low when sensor glucose falls to or below the low limit.</data>
  <data key="d10">critical threshold,glucose monitoring</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707589</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Suspend Before Low">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device initiates Suspend Before Low to prevent hypoglycemia by stopping insulin delivery before glucose reaches a critical level.</data>
  <data key="d10">insulin suspension,safety mechanism</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707590</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Suspend On Low">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device triggers Suspend On Low to halt insulin delivery when glucose reaches a dangerously low level.</data>
  <data key="d10">insulin suspension,safety mechanism</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707592</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="High Limit">
  <data key="d8">1.0</data>
  <data key="d9">The High Limit is a configurable threshold on the CGM Device that determines when high glucose alerts are issued.</data>
  <data key="d10">alert condition,threshold setting</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707594</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Low Limit">
  <data key="d8">1.0</data>
  <data key="d9">The Low Limit is a configurable threshold on the CGM Device that determines when low glucose alerts are activated.</data>
  <data key="d10">alert condition,threshold setting</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707596</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Blood Glucose Check">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device alerts prompt the user to perform a Blood Glucose Check to confirm sensor readings.</data>
  <data key="d10">alert response,verification method</data>
  <data key="d11">chunk-337edc64848e071f93a58a45c1196f2c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707598</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Calibration Not Accepted Alert">
  <data key="d8">1.0</data>
