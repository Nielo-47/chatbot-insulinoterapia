<edge source="Hemoglobin A1c" target="Children and Adolescents with Type 1 Diabetes">
  <data key="d8">1.0</data>
  <data key="d9">Children and adolescents with type 1 diabetes typically aim for HbA1c &lt; 7%, up to &lt; 7.5% if at risk of severe hypoglycemia.</data>
