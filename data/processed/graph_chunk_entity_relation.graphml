</node>
<node id="2025">
  <data key="d0">2025</data>
  <data key="d1">data</data>
  <data key="d2">2025 is the copyright year mentioned for Eli Lilly and Company.</data>
  <data key="d3">chunk-6f0c10866496bbb0b388b1e5ed69901c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310008</data>
