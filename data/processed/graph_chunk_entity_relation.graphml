  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Checkpoint Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Use of checkpoint inhibitors can trigger new‑onset Type 1 Diabetes as an immune‑related adverse event.</data>
  <data key="d9">adverse event,immune activation</data>
