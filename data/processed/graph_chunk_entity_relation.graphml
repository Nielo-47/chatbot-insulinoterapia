  <data key="d11">chunk-d85d195e1f8c488146a71cdd978e8c82</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708388</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Pump" target="Updated Low SG Alarm">
  <data key="d8">1.0</data>
  <data key="d9">The Updated Low SG Alarm enhances low glucose detection within the SmartGuard system of the insulin pump.&gt;</data>
