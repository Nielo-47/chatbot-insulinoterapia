  <data key="d14"></data>
</edge>
<edge source="Glucose Meter" target="Biosensor Strip">
  <data key="d8">1.0</data>
  <data key="d9">The Glucose Meter uses a Biosensor Strip containing enzymes to detect glucose levels via electrochemical reaction.</data>
