  <data key="d1">product</data>
  <data key="d2">Insulina lispro is a rapid-acting insulin analog that should be administered close to mealtime to prevent hypoglycemia.</data>
  <data key="d3">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
