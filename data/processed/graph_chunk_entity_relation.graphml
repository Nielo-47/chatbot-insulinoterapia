</node>
<node id="Seizures">
  <data key="d0">Seizures</data>
  <data key="d1">concept</data>
  <data key="d2">Seizures are a severe complication that can arise from acute hypoglycemia.</data>
  <data key="d3">chunk-431b48980656b0322f263c358250b593</data>
