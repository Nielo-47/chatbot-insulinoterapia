</edge>
<edge source="Subcutaneous Injection" target="Abdomen">
  <data key="d8">1.0</data>
  <data key="d9">Insulin is administered subcutaneously in the abdomen, a site chosen for its reliable absorption characteristics.</data>
  <data key="d10">administration site, delivery method</data>
