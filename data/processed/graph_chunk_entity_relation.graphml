  <data key="d13">1778708362</data>
  <data key="d14"></data>
</edge>
<edge source="SmartGuard Feature" target="Suspend Before Low">
  <data key="d8">1.0</data>
  <data key="d9">When the SmartGuard feature is active, the Suspend Before Low feature is automatically disabled.</data>
  <data key="d10">deactivation,feature conflict</data>
  <data key="d11">chunk-8556667d5fd37aa22e0f1652c667c62c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708364</data>
  <data key="d14"></data>
</edge>
<edge source="SmartGuard Feature" target="Suspend On Low">
  <data key="d8">1.0</data>
  <data key="d9">When the SmartGuard feature is active, the Suspend On Low feature is automatically turned off.</data>
  <data key="d10">deactivation,feature conflict</data>
  <data key="d11">chunk-8556667d5fd37aa22e0f1652c667c62c</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708366</data>
  <data key="d14"></data>
</edge>
<edge source="SmartGuard Feature" target="Sensor Alert Settings">
  <data key="d8">1.0</data>
  <data key="d9">Sensor alert settings for high and low glucose levels apply when using the SmartGuard feature.</data>
  <data key="d10">mode operation,threshold dependency</data>
