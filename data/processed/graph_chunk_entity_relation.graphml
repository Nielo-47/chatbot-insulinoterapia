  <data key="d6"></data>
</node>
<node id="Storage Mode">
  <data key="d0">Storage Mode</data>
  <data key="d1">concept</data>
  <data key="d2">A mode for the insulin pump used when not in use, which clears active insulin and requires a fresh AA battery periodically.&lt;SEP&gt;Storage Mode places the pump in a low‑usage state for prolonged periods without insulin use.</data>
  <data key="d3">chunk-eb80f00ba2dab32852874cb384b38de3&lt;SEP&gt;chunk-b23dfd3ae95fca711f8f10fc98ab467c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329618</data>
  <data key="d6"></data>
</node>
<node id="Pump Error Alarm">
  <data key="d0">Pump Error Alarm</data>
  <data key="d1">concept</data>
  <data key="d2">An alarm displayed by the insulin pump indicating a generic error condition.</data>
  <data key="d3">chunk-eb80f00ba2dab32852874cb384b38de3</data>
