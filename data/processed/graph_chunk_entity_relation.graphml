  <data key="d14"></data>
</edge>
<edge source="Glucosa Actual" target="Bolus de Correccion">
  <data key="d8">1.0</data>
  <data key="d9">Glucosa Actual is used in the formula to calculate the Bolus de Correccion, adjusting insulin dose based on current blood glucose.</data>
  <data key="d10">correction dose,insulin calculation</data>
  <data key="d11">chunk-ec2fea6c095d8e93483ff43ef875fb9b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703176</data>
  <data key="d14"></data>
</edge>
<edge source="Glucosa Objetivo" target="Bolus de Correccion">
  <data key="d8">1.0</data>
  <data key="d9">Glucosa Objetivo serves as the reference point in the Bolus de Correccion formula to determine the necessary insulin adjustment.</data>
  <data key="d10">insulin calculation,target reference</data>
  <data key="d11">chunk-ec2fea6c095d8e93483ff43ef875fb9b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703178</data>
  <data key="d14"></data>
</edge>
<edge source="Bolus de Correccion" target="Cantidad de Bolus Total">
  <data key="d8">1.0</data>
