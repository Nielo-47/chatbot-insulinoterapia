</node>
<node id="Glucose Trend Chart">
  <data key="d0">Glucose Trend Chart</data>
  <data key="d1">artifact</data>
  <data key="d2">The glucose trend chart displays 12- and 24-hour patterns of blood glucose levels, helping identify fluctuations during sleep, meals, and physical activity.</data>
  <data key="d3">chunk-3bf188253bd9d2142b4fcf627eacc2b8</data>
