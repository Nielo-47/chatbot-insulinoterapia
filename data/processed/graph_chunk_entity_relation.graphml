  <data key="d1">concept</data>
  <data key="d2">Hiperglucemia Inferior A 250 Mg/Dl se refiere a niveles elevados de glucosa en sangre que son menores a 250 mg/dL y que pueden corregirse con un bolus de insulina.</data>
  <data key="d3">chunk-0d266340be3ade6b2a58718fd568af4f</data>
