  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709764</data>
  <data key="d14"></data>
</edge>
<edge source="GlucoWatch G2 Biographer" target="Non-Invasive Glucose Sensors">
  <data key="d8">1.0</data>
  <data key="d9">GlucoWatch G2 Biographer is a non-invasive glucose monitor that uses reverse iontophoresis to measure glucose levels.</data>
  <data key="d10">reverse iontophoresis,wearable device</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709761</data>
  <data key="d14"></data>
</edge>
<edge source="Pendra" target="Non-Invasive Glucose Sensors">
  <data key="d8">1.0</data>
  <data key="d9">Pendra is a non-invasive device that estimates blood glucose using impedance spectroscopy.</data>
  <data key="d10">glucose estimation,impedance spectroscopy</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709762</data>
  <data key="d14"></data>
</edge>
<edge source="Non-Invasive Glucose Sensors" target="Light-Based Digital Pulp Sensors">
  <data key="d8">1.0</data>
  <data key="d9">Light-based digital pulp sensors are a type of non-invasive glucose sensor using light technology on the fingertips.</data>
  <data key="d10">fingertip monitoring,optical measurement</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
