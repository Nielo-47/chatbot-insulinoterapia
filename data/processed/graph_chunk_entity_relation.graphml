  <data key="d6"></data>
</node>
<node id="MiniMed or Medtronic Infusion Set">
  <data key="d0">MiniMed or Medtronic Infusion Set</data>
  <data key="d1">artifact</data>
  <data key="d2">MiniMed or Medtronic infusion set is a compatible set for delivering insulin from the pump.</data>
  <data key="d3">chunk-a0267d2986a48c4c31790b6f183277dc</data>
