</edge>
<edge source="Oxidative Stress" target="Epigenetic Modulation">
  <data key="d8">1.0</data>
  <data key="d9">Oxidative stress results in epigenetic modulation, leading to the activation of pro-inflammatory genes.</data>
  <data key="d10">gene regulation,inflammation</data>
