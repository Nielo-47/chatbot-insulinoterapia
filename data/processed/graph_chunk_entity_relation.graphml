  <data key="d13"></data>
</edge>
<edge source="Rotation Plan" target="Insulin Absorption">
  <data key="d7">1.0</data>
  <data key="d8">Rotating injection sites improves insulin absorption by using fresh subcutaneous tissue.</data>
  <data key="d9">efficacy,optimization</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299858</data>
  <data key="d13"></data>
</edge>
<edge source="Rotation Plan" target="Diabetes Control">
  <data key="d7">1.0</data>
  <data key="d8">Proper site rotation facilitates better diabetes control by ensuring consistent insulin action.</data>
  <data key="d9">facilitation,management</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
