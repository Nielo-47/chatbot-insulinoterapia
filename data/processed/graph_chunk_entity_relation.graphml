  <data key="d0">Balinha Comum</data>
  <data key="d1">artifact</data>
  <data key="d2">Balinha comum is a regular candy used as a quick source of glucose during hypoglycemia.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15</data>
