</node>
<node id="Pacientes Idosos">
  <data key="d0">Pacientes Idosos</data>
  <data key="d1">person</data>
  <data key="d2">Pacientes Idosos are elderly diabetes patients advised to use conservative insulin dosing to avoid hypoglycemia.</data>
  <data key="d3">chunk-a976e1642df27c488174759a35ca23f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
