  <data key="d1">method</data>
  <data key="d2">Estudo de Retinopatia Diabética de Tratamento Precoce (ETDRS) is the classification protocol used to grade retinopathy.</data>
  <data key="d3">chunk-b916f29e047f8579110cf5da3fd73847</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
