</node>
<node id="Accidental Insulin Swap">
  <data key="d0">Accidental Insulin Swap</data>
  <data key="d1">concept</data>
  <data key="d2">Accidental Insulin Swap describes the error of administering the wrong insulin product due to mislabeled or confused vials.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305922</data>
  <data key="d6"></data>
</node>
<node id="Intensified Glycemic Control">
  <data key="d0">Intensified Glycemic Control</data>
  <data key="d1">method</data>
  <data key="d2">Intensified Glycemic Control is a therapeutic approach involving tighter blood‑glucose monitoring and dosing during pregnancy.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
  <data key="d5">1786305923</data>
  <data key="d6"></data>
</node>
<node id="Pregnancy Risk Category">
  <data key="d0">Pregnancy Risk Category</data>
  <data key="d1">concept</data>
  <data key="d2">Pregnancy Risk Category classifies the safety level of medications, such as insulin, for use during pregnancy.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
