  <data key="d13"></data>
</edge>
<edge source="Microvascular Complications" target="Lower A1C">
  <data key="d7">1.0</data>
  <data key="d8">Evidence across trials indicates that lower A1C levels are associated with a reduced risk of microvascular complications.</data>
  <data key="d9">association,risk reduction</data>
