  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377596</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Screening for Type 1 Diabetes Risk">
  <data key="d7">1.0</data>
  <data key="d8">Screening aims to identify individuals at high risk of developing Type 1 Diabetes before clinical onset.</data>
  <data key="d9">early identification,prevention</data>
