  <data key="d0">Estudo Cruzado Duplo Cego</data>
  <data key="d1">method</data>
  <data key="d2">The study was conducted as a double‑blind crossover trial over six weeks comparing insulin treatments.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1786319696</data>
  <data key="d6"></data>
</node>
