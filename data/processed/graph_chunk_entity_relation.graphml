  <data key="d13">1778696039</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Injection" target="Levemir® Penfill®">
  <data key="d8">1.0</data>
  <data key="d9">Levemir® Penfill® is administered via subcutaneous injection as directed for both adult and pediatric patients.</data>
  <data key="d10">administration route,delivery method</data>
