</edge>
<edge source="Agulha" target="Caneta">
  <data key="d7">3.0</data>
  <data key="d8">The needle is inserted into the insulin pen for administration.&lt;SEP&gt;The insulin pen is fitted with a needle for each injection.&lt;SEP&gt;The pen is equipped with a needle that is inserted into the skin for subcutaneous delivery.</data>
  <data key="d9">attachment,injection,insertion,usage</data>
