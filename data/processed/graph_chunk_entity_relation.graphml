<edge source="Sistema De Infusão Contínua De Insulina" target="Reservatório De Insulina">
  <data key="d7">1.0</data>
  <data key="d8">The pump includes a reservatório de insulina that stores insulin for delivery.</data>
  <data key="d9">component,composition</data>
  <data key="d10">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330229</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Cateter">
  <data key="d7">1.0</data>
  <data key="d8">The pump includes a cateter that transports insulin from the reservoir to the cannula.</data>
  <data key="d9">component,composition</data>
  <data key="d10">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330230</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Cânula">
  <data key="d7">1.0</data>
  <data key="d8">The pump includes a cânula that remains in subcutaneous tissue to receive insulin.</data>
  <data key="d9">component,composition</data>
  <data key="d10">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330231</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Conjunto De Infusão">
  <data key="d7">1.0</data>
  <data key="d8">The pump system uses a conjunto de infusão comprising the catheter and cannula.</data>
  <data key="d9">component,composition</data>
  <data key="d10">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330233</data>
  <data key="d13"></data>
</edge>
<edge source="Sistema De Infusão Contínua De Insulina" target="Baterias">
  <data key="d7">1.0</data>
  <data key="d8">The pump is powered by batteries that drive its motor and electronics.</data>
  <data key="d9">component,composition</data>
  <data key="d10">chunk-e796e8f4bb4721a269775c3d2ef0c06a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1786330234</data>
  <data key="d13"></data>
</edge>
