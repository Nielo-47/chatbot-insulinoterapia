  <data key="d14"></data>
</edge>
<edge source="RAGE Receptors" target="Oxidative Stress">
  <data key="d8">1.0</data>
  <data key="d9">Activation of RAGE receptors by advanced glycation end products leads to intracellular oxidative stress.</data>
  <data key="d10">cellular activation,inflammation</data>
  <data key="d11">chunk-3a1c7be3f5278cc80c8bc958c35be31c</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
