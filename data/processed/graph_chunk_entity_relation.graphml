  <data key="d15">Blood Glucose</data>
  <data key="d16">Capillary Blood Glucose</data>
</edge>
<edge source="Blood Glucose" target="Severely Compromised Elderly">
  <data key="d8">1.0</data>
  <data key="d9">For severely compromised elderly, the focus shifts from numerical targets to avoiding symptoms of extreme glucose levels.</data>
  <data key="d10">symptom avoidance, palliative approach</data>
  <data key="d11">chunk-986fc7ecc813c4b7942964d7fd64d429</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694598</data>
  <data key="d14"></data>
  <data key="d15">Blood Glucose</data>
  <data key="d16">Severely Compromised Elderly</data>
</edge>
<edge source="Blood Glucose" target="Enzyme">
  <data key="d8">1.0</data>
  <data key="d9">The enzyme on the test strip reacts specifically with blood glucose to produce a measurable signal.</data>
  <data key="d10">biochemical interaction,sugar detection</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694521</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Electrical Signal">
  <data key="d8">1.0</data>
  <data key="d9">The reaction between blood glucose and the enzyme generates an electrical signal used by the glucometer.</data>
  <data key="d10">measurement conversion,signal generation</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694522</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Hyperglycemia">
  <data key="d8">1.0</data>
  <data key="d9">High blood glucose levels indicate hyperglycemia, a condition monitored using the glucometer.</data>
  <data key="d10">abnormal level,health risk</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694524</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Ideal Glucose Range">
  <data key="d8">1.0</data>
  <data key="d9">Blood glucose readings are compared to the ideal range to assess diabetes control.</data>
  <data key="d10">health monitoring,target level</data>
  <data key="d11">chunk-d4cfc50689ef0b918230df31cb99e5e5</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694526</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Time in Range">
  <data key="d8">1.0</data>
  <data key="d9">Time in Range measures how often blood glucose stays between 70 and 180 mg/dL, aiming for at least 70% of the time.</data>
  <data key="d10">glucose stability,target range</data>
  <data key="d11">chunk-986fc7ecc813c4b7942964d7fd64d429</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694597</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Fasting Glucose">
  <data key="d8">1.0</data>
  <data key="d9">Fasting glucose is a specific measurement of blood glucose taken after a period of not eating, used to assess baseline glycemic control.</data>
  <data key="d10">baseline measurement,metabolic indicator</data>
  <data key="d11">chunk-986fc7ecc813c4b7942964d7fd64d429</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694599</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Postprandial Glucose">
  <data key="d8">1.0</data>
  <data key="d9">Postprandial glucose measures blood glucose levels after meals, helping to evaluate how food affects glycemic control.</data>
  <data key="d10">glucose monitoring,meal-related spike</data>
  <data key="d11">chunk-986fc7ecc813c4b7942964d7fd64d429</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694600</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose" target="Time Zone Changes">
  <data key="d8">1.0</data>
  <data key="d9">Time zone changes, stress, and altered routines during travel can affect blood glucose levels and diabetes control.</data>
  <data key="d10">diabetes management,physiological impact</data>
  <data key="d11">chunk-f9bc8ba4b622225a9f3f1bb8a9d4fb21</data>
