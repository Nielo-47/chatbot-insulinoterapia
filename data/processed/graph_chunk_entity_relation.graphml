  <data key="d0">Arm (Back of Arm)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The posterior upper arm region identified as a safe injection site that lacks bones, joints, large vessels, or nerves nearby.</data>
  <data key="d3">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1786299840</data>
  <data key="d6"></data>
</node>
<node id="Buttock (Upper Outer Quadrant)">
  <data key="d0">Buttock (Upper Outer Quadrant)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The upper‑outer lateral portion of the gluteal region designated as a safe insulin injection site.</data>
  <data key="d3">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1786299840</data>
  <data key="d6"></data>
</node>
<node id="Thigh (Front and Lateral)">
  <data key="d0">Thigh (Front and Lateral)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The front and outer lateral area of the thigh suitable for insulin injection, measured using finger‑width distances.</data>
  <data key="d3">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1786299840</data>
