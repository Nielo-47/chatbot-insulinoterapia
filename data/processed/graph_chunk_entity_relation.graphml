  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1786299904</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Individualized Goals">
  <data key="d7">1.0</data>
  <data key="d8">History of hypoglycemia can lead to more flexible HbA1c targets in individualized goal setting.</data>
  <data key="d9">goal flexibility,low glucose risk</data>
