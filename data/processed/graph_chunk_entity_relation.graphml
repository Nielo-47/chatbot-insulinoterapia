</node>
<node id="Trabecular Sites">
  <data key="d0">Trabecular Sites</data>
  <data key="d1">concept</data>
  <data key="d2">Trabecular sites refer to specific bone regions where density was found to be higher in the disease.</data>
  <data key="d3">chunk-336c6084eb6cb7c8ada29ed26c0cd20d</data>
