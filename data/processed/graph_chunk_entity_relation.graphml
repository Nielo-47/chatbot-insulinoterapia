</node>
<node id="Best">
  <data key="d0">Best</data>
  <data key="d1">person</data>
  <data key="d2">Best was a collaborator with Banting in the early insulin experiments and co‑named the extract “Isletin”.</data>
  <data key="d3">chunk-172719b5694ed1fb8003b6874395d641</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
