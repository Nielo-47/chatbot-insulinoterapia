</edge>
<edge source="Glucosa En Sangre" target="Hidratos De Carbono">
  <data key="d8">1.0</data>
  <data key="d9">Ingesting hidratos de carbono increases glucosa en sangre levels, affecting glycemic control.</data>
  <data key="d10">glucose increase,nutrient impact</data>
  <data key="d11">chunk-369c90dae1a79813d89bb9a0b31ebfe9</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
