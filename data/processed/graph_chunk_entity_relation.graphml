</edge>
<edge source="Hypoglycemia" target="Levemir">
  <data key="d7">1.0</data>
  <data key="d8">Hypoglycemia is the most frequently reported adverse reaction to Levemir®, observed in about 12% of treated patients.</data>
  <data key="d9">adverse effect,frequency</data>
  <data key="d10">chunk-0ace26fdb0244e3d0f714a007c9bbb51</data>
