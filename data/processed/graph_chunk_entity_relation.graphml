</node>
<node id="Hexamers">
  <data key="d0">Hexamers</data>
  <data key="d1">concept</data>
  <data key="d2">Hexamers are insulin aggregates whose formation is reduced by the proline‑to‑aspartic‑acid substitution in NovoRapid®.</data>
  <data key="d3">chunk-6b14c2f0985ae4a417c8fc99e339bd9e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
