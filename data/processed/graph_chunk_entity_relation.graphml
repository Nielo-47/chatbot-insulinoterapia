  <data key="d13"></data>
</edge>
<edge source="Sensor" target="24-Hour Technical Support">
  <data key="d7">2.0</data>
  <data key="d8">Users are instructed to contact 24-Hour Technical Support when the sensor signal cannot be found or calibration fails.&lt;SEP&gt;When the pump cannot find the sensor signal, users are advised to contact 24‑Hour Technical Support for assistance.</data>
  <data key="d9">assistance,support,troubleshooting</data>
  <data key="d10">chunk-95ba6f1fa7d1791230f690255a8ba2df&lt;SEP&gt;chunk-46d04af5292fae98e3aa651d9cec4512</data>
