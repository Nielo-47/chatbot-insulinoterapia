</edge>
<edge source="Meia‑vida Intravenosa Insulina Glulisina" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">The intravenous half‑life of insulin glulisina is roughly 13 minutes.</data>
  <data key="d9">half‑life</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315547</data>
  <data key="d13"></data>
</edge>
<edge source="Meia‑vida Subcutânea Insulina Glulisina" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">After subcutaneous injection, insulin glulisina’s apparent half‑life is approximately 42 minutes.</data>
  <data key="d9">half‑life</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315547</data>
  <data key="d13"></data>
</edge>
<edge source="Cmax Insulina Glulisina" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina reaches a Cmax of about 82 µUI/mL following a 0,15 UI/kg dose.</data>
  <data key="d9">peak concentration</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315548</data>
  <data key="d13"></data>
</edge>
<edge source="Tmax Insulina Glulisina" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">The Tmax for insulin glulisina after subcutaneous dosing is 55 minutes.</data>
  <data key="d9">time to peak</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315548</data>
  <data key="d13"></data>
</edge>
<edge source="Tempo Médio de Residência Insulina Glulisina" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina’s mean residence time is 98 minutes in patients with diabetes type 1.</data>
  <data key="d9">mean residence time</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315549</data>
  <data key="d13"></data>
</edge>
<edge source="Biodisponibilidade Insulina Glulisina" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina exhibits an absolute bioavailability of about 70 % after subcutaneous injection, regardless of injection site.</data>
  <data key="d9">bioavailability</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
