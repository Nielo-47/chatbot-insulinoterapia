  <data key="d1">artifact</data>
  <data key="d2">Accu-Chek Guide Link is a glucose meter that can pair with the MiniMed 770G pump and provide remote glucose sensor (GS) readings.</data>
  <data key="d3">chunk-9855ca7ae42a0c01685280c4cc5bb56a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
