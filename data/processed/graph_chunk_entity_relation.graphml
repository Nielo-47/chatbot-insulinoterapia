</edge>
<edge source="TTGO-1h" target="5.7%">
  <data key="d7">1.0</data>
  <data key="d8">TTGO-1h is recommended when HbA1c is below 5.7 % in the presence of multiple risk factors.</data>
  <data key="d9">screening,threshold</data>
