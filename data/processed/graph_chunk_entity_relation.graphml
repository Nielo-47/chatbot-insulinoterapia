</node>
<node id="Neuropatia Periférica">
  <data key="d0">Neuropatia Periférica</data>
  <data key="d1">concept</data>
  <data key="d2">Neuropatia Periférica is peripheral neuropathy, listed as a rare nervous system disorder associated with Levemir® therapy.&lt;SEP&gt;Neuropatia Periférica is peripheral neuropathy, listed as an uncommon nervous‑system disorder linked to insulin use.&lt;SEP&gt;Neuropatia Periférica is an uncommon peripheral neuropathy associated with intensified insulin therapy using Novolin® R Penfill®.</data>
  <data key="d3">chunk-8a68ba1e8cc1defda76cde0eff9592e6&lt;SEP&gt;chunk-3396320470ee682ec5cc4f70ab001ef4&lt;SEP&gt;chunk-0b4034f7cf7e37425b7c76f5e0f9fd11</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1786318506</data>
  <data key="d6"></data>
</node>
<node id="Hipoglicemia Maior">
  <data key="d0">Hipoglicemia Maior</data>
  <data key="d1">concept</data>
  <data key="d2">Hipoglicemia Maior is severe hypoglycemia requiring third‑party intervention, observed in about 6 % of Levemir®‑treated patients.</data>
  <data key="d3">chunk-8a68ba1e8cc1defda76cde0eff9592e6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317654</data>
  <data key="d6"></data>
</node>
<node id="Antibodies Against Insulin">
  <data key="d0">Antibodies Against Insulin</data>
  <data key="d1">concept</data>
  <data key="d2">Antibodies Against Insulin are immune proteins that developed in patients receiving Levemir® during long‑term treatment.</data>
  <data key="d3">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317654</data>
  <data key="d6"></data>
</node>
<node id="Severe Hypoglycemia Episodes">
  <data key="d0">Severe Hypoglycemia Episodes</data>
  <data key="d1">concept</data>
  <data key="d2">Severe hypoglycemia episodes are acute low‑blood‑sugar events monitored in the clinical trials.</data>
  <data key="d3">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317654</data>
  <data key="d6"></data>
</node>
<node id="Randomized Open Study">
  <data key="d0">Randomized Open Study</data>
  <data key="d1">method</data>
  <data key="d2">The Randomized Open Study enrolled patients with type 2 diabetes who were not at goal with oral agents and compared Levemir® versus continued Liraglutida + Metformina.</data>
  <data key="d3">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317655</data>
  <data key="d6"></data>
</node>
<node id="Double‑Blind Randomized Study">
  <data key="d0">Double‑Blind Randomized Study</data>
  <data key="d1">method</data>
  <data key="d2">The Double‑Blind Randomized Study investigated the addition of Liraglutida versus placebo on top of basal insulin (including Levemir®) in type 2 diabetes patients.</data>
  <data key="d3">chunk-3059be019782459a72891cea5e0434ea</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
