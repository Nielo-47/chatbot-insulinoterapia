<edge source="Insulina" target="Insulina de Ação Lenta">
  <data key="d8">1.0</data>
  <data key="d9">A insulina de ação lenta é um tipo de insulina usado para controle glicêmico prolongado.</data>
  <data key="d10">classificação,tipo de insulina</data>
  <data key="d11">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
