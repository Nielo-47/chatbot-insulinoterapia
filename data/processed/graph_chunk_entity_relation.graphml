  <data key="d0">Maturity-Onset Diabetes of the Young</data>
  <data key="d1">concept</data>
  <data key="d2">Maturity-Onset Diabetes of the Young (MODY) is a monogenic form of diabetes characterized by early hyperglycemia and autosomal dominant inheritance.</data>
  <data key="d3">chunk-0bdb8ef335f3531317a3a5bd7de3a561</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377369</data>
  <data key="d6"></data>
</node>
<node id="K ATP‑Related Neonatal Diabetes">
  <data key="d0">K ATP‑Related Neonatal Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">K ATP‑related neonatal diabetes refers to neonatal diabetes caused by mutations affecting the β‑cell ATP‑sensitive potassium channel.</data>
  <data key="d3">chunk-0bdb8ef335f3531317a3a5bd7de3a561</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377370</data>
  <data key="d6"></data>
</node>
<node id="Routine Care">
  <data key="d0">Routine Care</data>
  <data key="d1">method</data>
  <data key="d2">Standard diabetes management used as a comparison group.&lt;SEP&gt;Routine Care is the standard care provided to patients, used as a comparison group in treatment studies.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7&lt;SEP&gt;chunk-9eb02ab1ab7d834858bf60a8b402e6ea</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377370</data>
  <data key="d6"></data>
</node>
<node id="First CVD Events">
  <data key="d0">First CVD Events</data>
  <data key="d1">event</data>
  <data key="d2">Initial cardiovascular disease incidents measured in the trial.&lt;SEP&gt;First CVD events refer to the initial occurrence of cardiovascular disease incidents measured in the study.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7&lt;SEP&gt;chunk-9eb02ab1ab7d834858bf60a8b402e6ea</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377370</data>
  <data key="d6"></data>
</node>
<node id="Early Diagnosis and Treatment">
  <data key="d0">Early Diagnosis and Treatment</data>
  <data key="d1">method</data>
  <data key="d2">Early diagnosis and treatment refer to identifying and managing hyperglycemia and cardiovascular risk factors early to gain health benefits.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377370</data>
  <data key="d6"></data>
</node>
<node id="Asian American Population">
  <data key="d0">Asian American Population</data>
  <data key="d1">other</data>
  <data key="d2">Asian American population refers to a demographic group for which lower BMI cut points (23 kg/m²) are recommended.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377371</data>
  <data key="d6"></data>
</node>
<node id="Thiazide Diuretics">
  <data key="d0">Thiazide Diuretics</data>
  <data key="d1">artifact</data>
  <data key="d2">Thiazide diuretics are a class of medications associated with increased diabetes risk.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377371</data>
  <data key="d6"></data>
</node>
<node id="HIV Medications">
  <data key="d0">HIV Medications</data>
  <data key="d1">artifact</data>
  <data key="d2">HIV medications are treatments for HIV that may raise the risk of prediabetes and diabetes.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377371</data>
  <data key="d6"></data>
</node>
<node id="Antiretroviral Therapies">
  <data key="d0">Antiretroviral Therapies</data>
  <data key="d1">method</data>
  <data key="d2">Antiretroviral (ARV) therapies are treatments for HIV that can cause hyperglycemia and affect diabetes risk.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377372</data>
  <data key="d6"></data>
</node>
<node id="Pancreatic β-Cells">
  <data key="d0">Pancreatic β-Cells</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pancreatic β‑cells are cells that produce insulin and may undergo apoptosis due to protease inhibitors.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377372</data>
  <data key="d6"></data>
</node>
<node id="Healthy Nutrition">
  <data key="d0">Healthy Nutrition</data>
  <data key="d1">method</data>
  <data key="d2">Healthy nutrition is a lifestyle approach that supports weight loss and diabetes risk reduction.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377373</data>
  <data key="d6"></data>
</node>
<node id="Three-Year Screening Interval">
  <data key="d0">Three-Year Screening Interval</data>
  <data key="d1">method</data>
  <data key="d2">Three-year screening interval is a proposed testing frequency intended to reduce false‑positive results.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377373</data>
  <data key="d6"></data>
</node>
<node id="False-Positive Tests">
  <data key="d0">False-Positive Tests</data>
  <data key="d1">concept</data>
  <data key="d2">False‑positive tests are erroneous screening results that require confirmatory testing.&lt;SEP&gt;False‑positive tests are screening results that incorrectly indicate disease and require confirmatory testing.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7&lt;SEP&gt;chunk-0631ff2b95dd459677eaaebe9283a776</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377373</data>
  <data key="d6"></data>
</node>
<node id="False-Negative Tests">
  <data key="d0">False-Negative Tests</data>
  <data key="d1">concept</data>
  <data key="d2">False‑negative tests are missed detections in screening that may delay diagnosis.&lt;SEP&gt;False‑negative tests are screening results that miss disease, prompting retesting before complications arise.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7&lt;SEP&gt;chunk-0631ff2b95dd459677eaaebe9283a776</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377373</data>
  <data key="d6"></data>
</node>
<node id="Quality-Adjusted Life Year">
  <data key="d0">Quality-Adjusted Life Year</data>
  <data key="d1">concept</data>
  <data key="d2">Quality‑adjusted life year is a metric used to assess the value of health interventions in cost‑effectiveness analyses.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377373</data>
  <data key="d6"></data>
</node>
<node id="Testing Interval">
  <data key="d0">Testing Interval</data>
  <data key="d1">concept</data>
  <data key="d2">Testing interval denotes the time between screening tests, with a suggested 3‑year period to balance false results.&lt;SEP&gt;Testing Interval refers to the appropriate time between screening tests, which is not definitively known.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7&lt;SEP&gt;chunk-0631ff2b95dd459677eaaebe9283a776</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377374</data>
  <data key="d6"></data>
</node>
<node id="Screening Protocol">
  <data key="d0">Screening Protocol</data>
  <data key="d1">method</data>
  <data key="d2">Screening protocol is a recommended procedure for testing type 2 diabetes and prediabetes in asymptomatic individuals.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377374</data>
  <data key="d6"></data>
</node>
<node id="ARV Agents">
  <data key="d0">ARV Agents</data>
  <data key="d1">artifact</data>
  <data key="d2">ARV agents are antiretroviral medications that may need to be discontinued due to hyperglycemia risk.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377374</data>
  <data key="d6"></data>
</node>
<node id="Screening Age Recommendation">
  <data key="d0">Screening Age Recommendation</data>
  <data key="d1">concept</data>
  <data key="d2">Screening Age Recommendation specifies that diabetes screening should begin no later than age 35, or at ages 30 or 45 in certain contexts.</data>
  <data key="d3">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377374</data>
  <data key="d6"></data>
</node>
<node id="Jason L. Gaglia">
  <data key="d0">Jason L. Gaglia</data>
  <data key="d1">person</data>
  <data key="d2">Jason L. Gaglia is an author of the article on classification and diagnosis of diabetes, representing the American Diabetes Association.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377376</data>
  <data key="d6"></data>
</node>
<node id="ADA Standards of Care in Diabetes">
  <data key="d0">ADA Standards of Care in Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">The ADA Standards of Care in Diabetes are clinical practice recommendations outlining components of diabetes care, treatment goals, and quality evaluation tools.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377377</data>
  <data key="d6"></data>
</node>
<node id="Classification and Diagnosis of Diabetes: Standards of Care in Diabetes-2023">
  <data key="d0">Classification and Diagnosis of Diabetes: Standards of Care in Diabetes-2023</data>
  <data key="d1">content</data>
  <data key="d2">This article presents the 2023 standards for classification and diagnosis of diabetes, authored by multiple experts on behalf of the ADA.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377377</data>
  <data key="d6"></data>
</node>
<node id="Specific Types of Diabetes">
  <data key="d0">Specific Types of Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Specific Types of Diabetes include monogenic diabetes syndromes, exocrine pancreas diseases, and drug‑ or chemical‑induced diabetes.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377378</data>
  <data key="d6"></data>
</node>
<node id="Maturity‑Onset Diabetes of the Young">
  <data key="d0">Maturity‑Onset Diabetes of the Young</data>
  <data key="d1">concept</data>
  <data key="d2">Maturity‑Onset Diabetes of the Young is a monogenic diabetes syndrome affecting adolescents and young adults.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377378</data>
  <data key="d6"></data>
</node>
<node id="Exocrine Pancreas Diseases">
  <data key="d0">Exocrine Pancreas Diseases</data>
  <data key="d1">concept</data>
  <data key="d2">Exocrine Pancreas Diseases are conditions such as cystic fibrosis and pancreatitis that can cause diabetes.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377378</data>
  <data key="d6"></data>
</node>
<node id="Drug‑Induced Diabetes">
  <data key="d0">Drug‑Induced Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Drug‑Induced Diabetes refers to diabetes caused by medications or chemicals, including glucocorticoid use, HIV/AIDS treatment, or organ transplantation.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377378</data>
  <data key="d6"></data>
</node>
<node id="Glucocorticoid Use">
  <data key="d0">Glucocorticoid Use</data>
  <data key="d1">concept</data>
  <data key="d2">Glucocorticoid Use is a medication exposure that can induce diabetes.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377378</data>
  <data key="d6"></data>
</node>
<node id="HIV/AIDS Treatment">
  <data key="d0">HIV/AIDS Treatment</data>
  <data key="d1">concept</data>
  <data key="d2">HIV/AIDS Treatment involves therapies that can contribute to drug‑induced diabetes.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377379</data>
  <data key="d6"></data>
</node>
<node id="Polyuria/Polydipsia">
  <data key="d0">Polyuria/Polydipsia</data>
  <data key="d1">concept</data>
  <data key="d2">Polyuria/Polydipsia are classic symptoms of diabetes, especially Type 1 Diabetes.</data>
  <data key="d3">chunk-f7b840a0b5327c5e583eb70dd354d1d0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377379</data>
  <data key="d6"></data>
</node>
