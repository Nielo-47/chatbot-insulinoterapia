</edge>
<edge source="Insulin" target="Pacientes Idosos">
  <data key="d7">1.0</data>
  <data key="d8">Elderly patients are advised to start with conservative insulin doses to avoid hypoglycemia.</data>
  <data key="d9">conservatism,dose</data>
  <data key="d10">chunk-a976e1642df27c488174759a35ca23f2</data>
