  <data key="d6"></data>
</node>
<node id="Phenol">
  <data key="d0">Phenol</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Phenol is an excipient component of the Tresiba® formulation.&lt;SEP&gt;Phenol is an excipient listed in the formulation of Humalog® Mix 25 Kwikpen.&lt;SEP&gt;Phenol acts as an antimicrobial excipient in the Humalog Mix 50 KwikPen.&lt;SEP&gt;Phenol is an excipient listed in the Fiasp® formulation.&lt;SEP&gt;Phenol is an excipient used in the formulation of Levemir® FlexPen® injectable solution.</data>
  <data key="d3">chunk-e590341aac73dca916e560c2df9e60e0&lt;SEP&gt;chunk-db832f06717859b8ba6cf7fd70aa22d8&lt;SEP&gt;chunk-7084240a735ca2fe3b6d426e3b8c5756&lt;SEP&gt;chunk-c8c7e36686d077dcb6239405f60ea031&lt;SEP&gt;chunk-b65a4249ac93aec086cb333ed1507ea7</data>
