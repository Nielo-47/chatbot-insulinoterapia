  <data key="d13">1778708066</data>
  <data key="d14"></data>
</edge>
<edge source="CareLink Software" target="24-Hour Technical Support">
  <data key="d8">1.0</data>
  <data key="d9">Users are directed to contact 24-Hour Technical Support if they encounter unlisted alerts or messages in the CareLink software.</data>
  <data key="d10">issue resolution,support escalation</data>
  <data key="d11">chunk-7d37ccd138ed8a095eb197006a33b8a7</data>
