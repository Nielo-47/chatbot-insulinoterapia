</node>
<node id="Alerta Antes De Limite Alto">
  <data key="d0">Alerta Antes De Limite Alto</data>
  <data key="d1">concept</data>
  <data key="d2">Alerta Antes De Limite Alto is a proactive alert that notifies the user before reaching the high glucose threshold, allowing early intervention.</data>
  <data key="d3">chunk-cfc5f5eb70e79d2ce44b3ba795b76b3e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
