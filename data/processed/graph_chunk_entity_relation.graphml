<edge source="Levemir" target="Sistema VigiMed">
  <data key="d8">1.0</data>
  <data key="d9">Healthcare professionals and patients are advised to report adverse events related to Levemir through Sistema VigiMed.</data>
  <data key="d10">adverse event reporting,pharmacovigilance</data>
  <data key="d11">chunk-ef496454c12f85ff1f62de19e8a22be4</data>
