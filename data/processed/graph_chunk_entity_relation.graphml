<node id="0800 0144488">
  <data key="d0">0800 0144488</data>
  <data key="d1">data</data>
  <data key="d2">0800 0144488 is the toll-free customer service number (SAC) for Novo Nordisk Farmacêutica do Brasil Ltda.</data>
  <data key="d3">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
