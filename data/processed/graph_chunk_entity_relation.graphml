<edge source="Suspend Before Low Event" target="40 Mg/Dl Above Low Limit">
  <data key="d8">1.0</data>
  <data key="d9">Insulin delivery resumes after a Suspend before low event only if sensor glucose is predicted to be more than 40 mg/dL above the low limit within 30 minutes.</data>
