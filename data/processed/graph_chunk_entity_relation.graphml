  <data key="d13">1778709765</data>
  <data key="d14"></data>
</edge>
<edge source="Non-Invasive Glucose Sensors" target="Breath Sensors">
  <data key="d8">1.0</data>
  <data key="d9">Breath sensors detect glucose levels non-invasively by analyzing components in exhaled breath.</data>
  <data key="d10">glucose detection,respiratory analysis</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
