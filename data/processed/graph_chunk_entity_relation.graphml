  <data key="d0">Banting</data>
  <data key="d1">person</data>
  <data key="d2">Banting was a researcher who administered the extract to the dogs, co‑named the extract “Isletin”, and corresponded with Professor Macleod about the findings.</data>
  <data key="d3">chunk-172719b5694ed1fb8003b6874395d641</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
