  <data key="d13">1778703205</data>
  <data key="d14"></data>
  <data key="d15">Glucagon</data>
  <data key="d16">Hypoglycemia</data>
</edge>
<edge source="Hypoglycemia" target="CGM">
  <data key="d8">1.0</data>
  <data key="d9">CGM helps prevent and detect hypoglycemia by providing real-time alerts and trend data.</data>
  <data key="d10">risk prevention, condition monitoring</data>
  <data key="d11">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
