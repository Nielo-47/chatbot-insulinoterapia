  <data key="d1">location</data>
  <data key="d2">Rua Fidalga 360 São Paulo SP is the registered address of Novo Nordisk Farmacêutica do Brasil Ltda in São Paulo, Brazil.</data>
  <data key="d3">chunk-8646d585dd04c9e67fc11499ede9ae10</data>
