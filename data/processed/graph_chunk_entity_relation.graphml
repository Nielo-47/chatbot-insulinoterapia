  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707519</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Sensor Warm Up">
  <data key="d8">1.0</data>
  <data key="d9">The CGM Device undergoes a two-hour sensor warm-up period before it begins transmitting accurate sensor glucose readings to the pump.</data>
  <data key="d10">initialization process,readiness</data>
  <data key="d11">chunk-e26750d1b6c495640b752a31b9f0e262</data>
