</node>
<node id="Analog Insulin">
  <data key="d0">Analog Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Analog Insulin is a synthetic insulin variant that mimics human insulin.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
