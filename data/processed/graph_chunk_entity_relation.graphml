  <data key="d1">organization</data>
  <data key="d2">Unidade Básica de Saúde (UBS) is a primary health care unit that supplies containers for the safe disposal of contaminated sharps.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d5">1786337565</data>
  <data key="d6"></data>
</node>
