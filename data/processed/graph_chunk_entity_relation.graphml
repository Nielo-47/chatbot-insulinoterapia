</node>
<node id="Instant Occlusion Detection">
  <data key="d0">Instant Occlusion Detection</data>
  <data key="d1">concept</data>
  <data key="d2">Instant Occlusion Detection is a feature that quickly identifies blockages in insulin delivery pathways.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
