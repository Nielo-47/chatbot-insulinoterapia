  <data key="d13"></data>
</edge>
<edge source="TTGO-1h" target="RISC Study">
  <data key="d7">1.0</data>
  <data key="d8">RISC Study found that abnormal TTGO-1h without DM criteria represents an intermediate metabolic dysfunction stage.</data>
  <data key="d9">intermediate dysfunction,metabolic stage</data>
  <data key="d10">chunk-23ad6eb7138be249f01b479174a34076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372108</data>
  <data key="d13"></data>
</edge>
<edge source="TTGO-1h" target="209 mg/dl">
  <data key="d7">1.0</data>
  <data key="d8">TTGO-1h values ≥ 209 mg/dl are used to diagnose DM2 not previously detected.</data>
  <data key="d9">diagnosis,threshold</data>
  <data key="d10">chunk-23ad6eb7138be249f01b479174a34076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372109</data>
  <data key="d13"></data>
</edge>
<edge source="TTGO-1h" target="155 mg/dl">
  <data key="d7">1.0</data>
  <data key="d8">TTGO-1h values between 155 mg/dl and 209 mg/dl predict future risk of DM2.</data>
  <data key="d9">risk prediction,threshold</data>
  <data key="d10">chunk-23ad6eb7138be249f01b479174a34076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1786372109</data>
  <data key="d13"></data>
</edge>
<edge source="TTGO-1h" target="100 mg/dl">
  <data key="d7">1.0</data>
  <data key="d8">TTGO-1h is recommended for individuals with fasting glucose below 100 mg/dl.</data>
  <data key="d9">screening,threshold</data>
