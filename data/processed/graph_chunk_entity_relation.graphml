<edge source="Sociedade Brasileira de Diabetes" target="Diabetes Tipo 2">
  <data key="d7">1.0</data>
  <data key="d8">The organization recommends specific screening and re‑evaluation protocols for type 2 diabetes.</data>
  <data key="d9">guideline,recommendation</data>
  <data key="d10">chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
