</node>
<node id="Barriers">
  <data key="d0">Barriers</data>
  <data key="d1">concept</data>
  <data key="d2">Barriers denote obstacles that limit adoption of insulin pump systems among certain diabetes patient groups.</data>
  <data key="d3">chunk-6fe5eab149567b7d1c155f61afdb5a34</data>
