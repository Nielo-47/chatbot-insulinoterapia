  <data key="d12">1786319820</data>
  <data key="d13"></data>
</edge>
<edge source="Cetoacidose Diabética" target="Corpos Cetônicos">
  <data key="d7">1.0</data>
  <data key="d8">Ketone bodies are present in the blood and urine during diabetic ketoacidosis.</data>
  <data key="d9">indicator</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
