  <data key="d13">1778707518</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="High SG Alert">
  <data key="d8">1.0</data>
  <data key="d9">The High SG Alert is generated by the CGM device when sensor glucose levels exceed safe thresholds.</data>
  <data key="d10">abnormal reading,medical alert</data>
