</node>
<node id="LO Symbol">
  <data key="d0">LO Symbol</data>
  <data key="d1">concept</data>
  <data key="d2">LO Symbol is a low‑glucose indicator defined in the device manual, representing glucose readings below 20‑10 mg/dL.</data>
  <data key="d3">chunk-b2ef71fb1a347df36dbb8ea8f4856bcb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
