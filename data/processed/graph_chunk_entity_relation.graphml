  <data key="d0">Optical Method</data>
  <data key="d1">method</data>
  <data key="d2">Optical methods are non‑electrochemical technologies developed for SMCG but not yet available in routine practice.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
