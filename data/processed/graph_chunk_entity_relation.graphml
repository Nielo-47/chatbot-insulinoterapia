<edge source="Diretriz da Sociedade Brasileira de Diabetes" target="Seringa com Agulha Removível">
  <data key="d7">1.0</data>
  <data key="d8">The guideline recommends avoiding syringes with removable needles.</data>
  <data key="d9">avoid,recommendation</data>
  <data key="d10">chunk-8d870035815524d8e4f6b0d6b05e5c2a</data>
