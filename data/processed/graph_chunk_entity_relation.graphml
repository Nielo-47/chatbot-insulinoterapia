  <data key="d0">RtCGM</data>
  <data key="d1">artifact</data>
  <data key="d2">RtCGM is a real-time continuous glucose monitoring device that measures and displays glucose levels continuously.</data>
  <data key="d3">chunk-511f6be03d2ea98970bd4c1b29b3e5c8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
