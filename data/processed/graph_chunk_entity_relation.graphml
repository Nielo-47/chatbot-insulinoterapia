  <data key="d13">1778707835</data>
  <data key="d14"></data>
</edge>
<edge source="Sensor" target="Two-Hour Warm Up Period">
  <data key="d8">1.0</data>
  <data key="d9">The sensor requires a two-hour warm-up period before it begins sending glucose readings.</data>
  <data key="d10">activation,stabilization</data>
  <data key="d11">chunk-c5646d299deb5989a133b3e471666262</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707917</data>
  <data key="d14"></data>
</edge>
<edge source="Sensor" target="Five-Minute Delay">
  <data key="d8">1.0</data>
  <data key="d9">There may be up to a five-minute delay before the warm-up message appears on the Home screen.</data>
  <data key="d10">display timing,initialization</data>
