  <data key="d6"></data>
</node>
<node id="SFMG">
  <data key="d0">SFMG</data>
  <data key="d1">method</data>
  <data key="d2">Sistema de Monitorização de Glicose sem Calibração, a factory‑calibrated CGM system that does not require user calibration.&lt;SEP&gt;SFMG is a glucose sensor that comes calibrated at the factory and does not require user calibration.</data>
  <data key="d3">chunk-d8e26d518805695de3e4f9d41ae1d3e1&lt;SEP&gt;chunk-7ac99b8588a8c480f44a5519509f7713</data>
