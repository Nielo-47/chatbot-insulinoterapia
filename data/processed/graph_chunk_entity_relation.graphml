<edge source="Hyperglycemia" target="Chatbot">
  <data key="d8">1.0</data>
  <data key="d9">The chatbot identifies phrases like "the sugar went up" as indications of hyperglycemia and responds appropriately.</data>
  <data key="d10">clinical response,symptom recognition</data>
