</edge>
<edge source="Hipoglicemia" target="Alimentos Contendo Açúcar">
  <data key="d7">2.0</data>
  <data key="d8">Mild hypoglycemia is treated by ingesting foods or drinks containing sugar.&lt;SEP&gt;Sugar‑rich foods are used to treat mild to moderate hypoglycemia.</data>
  <data key="d9">rapid correction,treatment</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
