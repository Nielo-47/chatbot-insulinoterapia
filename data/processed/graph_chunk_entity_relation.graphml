  <data key="d13">1778702869</data>
  <data key="d14"></data>
</edge>
<edge source="Glucosa En Sangre" target="Bolus De Insulina">
  <data key="d8">1.0</data>
  <data key="d9">El bolus de insulina se administra para reducir los niveles de glucosa en sangre, especialmente despues de ingerir alimentos con hidratos de carbono o cuando los niveles estan elevados.</data>
  <data key="d10">glucose reduction,insulin action</data>
