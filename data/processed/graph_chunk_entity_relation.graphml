<node id="Glucose Sensor Data">
  <data key="d0">Glucose Sensor Data</data>
  <data key="d1">data</data>
  <data key="d2">Glucose sensor data are the continuous measurements collected by glucose sensors used in continuous monitoring systems.</data>
  <data key="d3">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1786299826</data>
