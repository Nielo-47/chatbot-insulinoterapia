<node id="First Dose">
  <data key="d0">First Dose</data>
  <data key="d1">concept</data>
  <data key="d2">First Dose is the initial insulin administration after a therapy change, which may need adjustment.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
