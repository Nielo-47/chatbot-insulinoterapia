  <data key="d0">Coorte de 1.352 Pacientes</data>
  <data key="d1">data</data>
  <data key="d2">Coorte de 1.352 Pacientes is a cohort of 1,352 patients used to assess predictive models for diabetes classification.</data>
  <data key="d3">chunk-858cd6ea7fba353827f5ab95be1157ae</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373002</data>
  <data key="d6"></data>
</node>
