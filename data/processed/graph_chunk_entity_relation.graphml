  <data key="d5">1786315338</data>
  <data key="d6"></data>
</node>
<node id="Isoniazida">
  <data key="d0">Isoniazida</data>
  <data key="d1">artifact</data>
  <data key="d2">Isoniazida is an anti‑tuberculosis drug that may decrease insulin glargina effect.&lt;SEP&gt;Isoniazida is a substance listed as reducing the hypoglycemic effect of APIDRA SOLOSTAR.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e4ba52cc293c5c002b470566321026d6</data>
