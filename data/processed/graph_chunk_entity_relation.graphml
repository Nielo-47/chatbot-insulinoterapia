</edge>
<edge source="Calibration" target="Sensor Glucose">
  <data key="d8">2.0</data>
  <data key="d9">Calibration improves the accuracy of sensor glucose readings by aligning them with blood glucose measurements.&lt;SEP&gt;The purpose of calibration is to make sensor glucose readings more closely match actual blood glucose levels.</data>
  <data key="d10">accuracy adjustment,accuracy improvement,data alignment,system alignment</data>
  <data key="d11">chunk-b0f14c91b2fb52c8fcc6d43aa4f53f64&lt;SEP&gt;chunk-63f9bd562c68fc510780d6f6629360a4</data>
