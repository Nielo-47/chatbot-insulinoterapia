  <data key="d0">Health Care Provider</data>
  <data key="d1">person</data>
  <data key="d2">Health Care Provider is a medical professional who can adjust treatment plans and glucose targets.</data>
  <data key="d3">chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
