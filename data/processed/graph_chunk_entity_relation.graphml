  <data key="d0">U.S. Food and Drug Administration (FDA)</data>
  <data key="d1">organization</data>
  <data key="d2">The FDA approves point‑of‑care A1C devices for clinical use in the United States.</data>
  <data key="d3">chunk-3cc61bc2e95346d553972b4371912e7f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377381</data>
  <data key="d6"></data>
</node>
<node id="Clinical Laboratory Improvement Amendments (CLIA)">
  <data key="d0">Clinical Laboratory Improvement Amendments (CLIA)</data>
  <data key="d1">organization</data>
  <data key="d2">CLIA regulates laboratory testing environments, including point‑of‑care A1C testing settings.&lt;SEP&gt;Federal regulations that set quality standards for clinical laboratory testing in the United States.</data>
  <data key="d3">chunk-3cc61bc2e95346d553972b4371912e7f&lt;SEP&gt;chunk-84032013252fd71963ed381e09a3116d</data>
