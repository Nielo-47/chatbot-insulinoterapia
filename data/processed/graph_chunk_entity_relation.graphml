  <data key="d0">Adverse Event Reporting</data>
  <data key="d1">concept</data>
  <data key="d2">Adverse Event Reporting denotes the process of notifying health authorities about adverse drug reactions.</data>
  <data key="d3">chunk-22df77f7bf817d736d90608e62a11d84</data>
