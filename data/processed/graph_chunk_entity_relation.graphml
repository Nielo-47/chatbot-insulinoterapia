  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Homogenization (20 Gentle Movements)">
  <data key="d7">1.0</data>
  <data key="d8">Proper homogenization of insulin suspensions requires about 20 gentle rolling movements between the palms.</data>
