  <data key="d6"></data>
</node>
<node id="Syringe with Fixed Needle">
  <data key="d0">Syringe with Fixed Needle</data>
  <data key="d1">artifact</data>
  <data key="d2">A syringe equipped with a permanently attached needle, required for precise combination of two insulin types in one injection.</data>
  <data key="d3">chunk-64b999805e924800faef3b856e45d8bf</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
