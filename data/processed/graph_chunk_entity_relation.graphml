  <data key="d5">1786329617</data>
  <data key="d6"></data>
</node>
<node id="CGM Device Alarms">
  <data key="d0">CGM Device Alarms</data>
  <data key="d1">content</data>
  <data key="d2">CGM device alarms, alerts, and messages provide information about sensor status and errors.&lt;SEP&gt;CGM Device Alarms encompass alerts, messages, and error notifications related to the CGM system.</data>
  <data key="d3">chunk-177e9aca0bf1c1724474ea529826bece&lt;SEP&gt;chunk-ede0f32eb8f8ea1eaab76cc0bc7648fd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329617</data>
  <data key="d6"></data>
</node>
<node id="Select Fill Amount">
  <data key="d0">Select Fill Amount</data>
  <data key="d1">artifact</data>
  <data key="d2">Select Fill Amount is a button used to choose the desired insulin fill amount before initiating filling.</data>
  <data key="d3">chunk-177e9aca0bf1c1724474ea529826bece</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
