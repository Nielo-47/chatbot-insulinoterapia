  <data key="d6"></data>
</node>
<node id="25% Risk">
  <data key="d0">25% Risk</data>
  <data key="d1">data</data>
  <data key="d2">The text reports a 25 % risk of composite diabetes outcomes in microvascular events.</data>
  <data key="d3">chunk-4f9624abde6cf128707fcc0466a4c9a7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
