  <data key="d6"></data>
</node>
<node id="Optimized Algorithms for Inhaled Insulin">
  <data key="d0">Optimized Algorithms for Inhaled Insulin</data>
  <data key="d1">method</data>
  <data key="d2">Optimized algorithms allow AID systems to account for user‑entered exogenous insulin doses.</data>
  <data key="d3">chunk-2767372b4b5395439f542016058306a4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
  <data key="d5">1786332851</data>
  <data key="d6"></data>
</node>
<node id="Large Outpatient Randomized Controlled Trial">
  <data key="d0">Large Outpatient Randomized Controlled Trial</data>
  <data key="d1">event</data>
  <data key="d2">A large outpatient RCT is proposed to evaluate the safety and efficacy of TI combined with AID systems.</data>
  <data key="d3">chunk-2767372b4b5395439f542016058306a4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
  <data key="d5">1786332851</data>
  <data key="d6"></data>
</node>
<node id="Hypoglycemia Risk Reduction">
  <data key="d0">Hypoglycemia Risk Reduction</data>
  <data key="d1">concept</data>
  <data key="d2">Hypoglycemia risk reduction describes lowering the chance of low blood glucose episodes.</data>
  <data key="d3">chunk-2767372b4b5395439f542016058306a4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
  <data key="d5">1786332851</data>
  <data key="d6"></data>
</node>
<node id="Quality of Life">
  <data key="d0">Quality of Life</data>
  <data key="d1">concept</data>
  <data key="d2">Quality of life refers to the overall well‑being of individuals using diabetes technologies.&lt;SEP&gt;Quality of life refers to the overall well‑being improvements patients may experience with effective Afrezza therapy.&lt;SEP&gt;Quality of Life refers to the overall well‑being of people with diabetes, which may improve with effective insulin delivery technologies.</data>
  <data key="d3">chunk-2767372b4b5395439f542016058306a4&lt;SEP&gt;chunk-5419de5a030f812ab408ef47f361bebd&lt;SEP&gt;chunk-9cd925790899146eeb8a373879b5feac</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/edelman-et-al-2026-dosing-afrezza-it-s-not-that-complicated.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335886</data>
  <data key="d6"></data>
</node>
<node id="Integration of Inhaled Insulin with AID Systems">
  <data key="d0">Integration of Inhaled Insulin with AID Systems</data>
  <data key="d1">concept</data>
  <data key="d2">Integration of inhaled insulin with AID systems aims to improve postprandial glucose control and overall diabetes management.</data>
  <data key="d3">chunk-2767372b4b5395439f542016058306a4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
  <data key="d5">1786332851</data>
  <data key="d6"></data>
</node>
<node id="Article">
  <data key="d0">Article</data>
  <data key="d1">content</data>
  <data key="d2">The article discusses challenges and opportunities of combining inhaled insulin with automated insulin delivery systems.</data>
  <data key="d3">chunk-2767372b4b5395439f542016058306a4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
  <data key="d5">1786332852</data>
  <data key="d6"></data>
</node>
