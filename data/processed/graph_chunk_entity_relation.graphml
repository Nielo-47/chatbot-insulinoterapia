  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="Bolus Wizard">
  <data key="d8">1.0</data>
  <data key="d9">The Bolus Wizard feature can be used to deliver a Dual Wave bolus after calculating insulin needs based on blood glucose and carbohydrate data.</data>
  <data key="d10">dosage calculation,feature integration</data>
  <data key="d11">chunk-ca312edfca5f05d148819c17f1d55943</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708140</data>
  <data key="d14"></data>
</edge>
<edge source="Dual Wave Bolus" target="Manual Bolus">
  <data key="d8">1.0</data>
  <data key="d9">A Dual Wave bolus can be delivered using the Manual Bolus feature when the Dual Wave option is enabled.</data>
  <data key="d10">delivery method,user control</data>
  <data key="d11">chunk-ca312edfca5f05d148819c17f1d55943</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
