  <data key="d6"></data>
  <data key="d7">Glicemia Em Jejum</data>
</node>
<node id="Médico">
  <data key="d0">Médico</data>
  <data key="d1">person</data>
  <data key="d2">A physician prescribed NPH insulin twice daily, but the patient miscalculated the dose due to device misunderstanding.&lt;SEP&gt;Médico is a healthcare professional whom patients should consult regarding frequent hypoglycemic episodes or therapy adjustments.&lt;SEP&gt;Médico is a healthcare professional who provides medical guidance for managing diabetes, especially during illness or complications.</data>
  <data key="d3">chunk-c0ec5707b6df65f1a6822e01b9bb3fb9&lt;SEP&gt;chunk-9c96e22adae6d8c02ec9ce8430d0cf64&lt;SEP&gt;chunk-19de4016c46aba524b40e489fd60f018&lt;SEP&gt;chunk-191c82775d35bbc705205ed493c43c7d</data>
