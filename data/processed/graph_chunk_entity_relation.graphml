<node id="Adjusted Basal Glucose">
  <data key="d0">Adjusted Basal Glucose</data>
  <data key="d1">concept</data>
  <data key="d2">Adjusted Basal Glucose refers to the average prandial glucose level corrected for each patient’s fasting baseline value.</data>
  <data key="d3">chunk-2f4f01a72f35d6db3ff333e64f8400ce</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
