  <data key="d6"></data>
</node>
<node id="Editar">
  <data key="d0">Editar</data>
  <data key="d1">method</data>
  <data key="d2">Editar is the command used to modify the time segment and value of an Índice Basal.&lt;SEP&gt;A menu option used to modify existing settings on the pump.&lt;SEP&gt;The action to modify an existing basal index or pattern.</data>
  <data key="d3">chunk-1312783ffe5039c618a48f7f29ec51ed&lt;SEP&gt;chunk-1d41e93e7754b06eedcc2e2a44afcb32&lt;SEP&gt;chunk-adb365cf52e00c7b4647e65dc0411d56</data>
