<node id="Post‑marketing Adverse Reactions">
  <data key="d0">Post‑marketing Adverse Reactions</data>
  <data key="d1">concept</data>
  <data key="d2">Post‑marketing adverse reactions are side effects reported after a drug has been released to the market.</data>
  <data key="d3">chunk-f9e5c50e8a808c537075377966ae2ccd</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
