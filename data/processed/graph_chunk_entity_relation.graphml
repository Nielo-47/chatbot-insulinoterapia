</node>
<node id="Atrofia Óptica">
  <data key="d0">Atrofia Óptica</data>
  <data key="d1">concept</data>
  <data key="d2">Atrofia Óptica is optic nerve degeneration that may occur in Wolfram syndrome.</data>
  <data key="d3">chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373082</data>
  <data key="d6"></data>
</node>
<node id="Surdez">
  <data key="d0">Surdez</data>
  <data key="d1">concept</data>
  <data key="d2">Surdez is hearing loss that can be a feature of Wolfram syndrome.</data>
  <data key="d3">chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373082</data>
  <data key="d6"></data>
</node>
<node id="Teste Genético">
  <data key="d0">Teste Genético</data>
  <data key="d1">method</data>
  <data key="d2">Teste Genético is a genetic testing procedure used to identify mutations responsible for specific diabetes subtypes.</data>
  <data key="d3">chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373082</data>
  <data key="d6"></data>
</node>
<node id="Abordagem AABBCC">
  <data key="d0">Abordagem AABBCC</data>
  <data key="d1">method</data>
  <data key="d2">Abordagem AABBCC is a systematic classification approach for diabetes based on parameters such as age, autoimmunity, BMI, background, control, and comorbidities.</data>
  <data key="d3">chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373083</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Tipo 1B">
  <data key="d0">Diabetes Tipo 1B</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Tipo 1B is a subtype of diabetes defined by low Peptídeo C levels in patients with long‑standing disease and negative autoantibodies.</data>
  <data key="d3">chunk-ed325288512881a80fa42dba504c4bff</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373083</data>
  <data key="d6"></data>
</node>
<node id="Autoanticorpos Positivos">
  <data key="d0">Autoanticorpos Positivos</data>
  <data key="d1">concept</data>
  <data key="d2">Autoanticorpos Positivos indicate an autoimmune response and are used to classify diabetes type 1.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373083</data>
  <data key="d6"></data>
</node>
<node id="Anticorpos Negativos">
  <data key="d0">Anticorpos Negativos</data>
  <data key="d1">concept</data>
  <data key="d2">Anticorpos Negativos denote the absence of autoantibodies in diabetes assessment.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373083</data>
  <data key="d6"></data>
</node>
<node id="Função Residual de Célula Beta">
  <data key="d0">Função Residual de Célula Beta</data>
  <data key="d1">concept</data>
  <data key="d2">Função Residual de Célula Beta describes remaining beta‑cell activity after 12 months.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373083</data>
  <data key="d6"></data>
</node>
<node id="DM Fulminante">
  <data key="d0">DM Fulminante</data>
  <data key="d1">concept</data>
  <data key="d2">DM Fulminante is a rapidly progressive form of diabetes lacking residual beta‑cell function.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="DM Idiopático">
  <data key="d0">DM Idiopático</data>
  <data key="d1">concept</data>
  <data key="d2">DM Idiopático denotes idiopathic type 1 diabetes without identifiable cause.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Secundário">
  <data key="d0">Diabetes Secundário</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Secundário (diabetes 3c) is diabetes secondary to exocrine pancreatic diseases.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="Doenças Pancreáticas">
  <data key="d0">Doenças Pancreáticas</data>
  <data key="d1">concept</data>
  <data key="d2">Doenças Pancreáticas are pancreatic disorders such as inflammation, neoplasia, hemocromatose, or prior surgery.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="Etilismo">
  <data key="d0">Etilismo</data>
  <data key="d1">concept</data>
  <data key="d2">Etilismo is chronic alcohol consumption that can cause pancreatic inflammation.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="Litíase Biliar">
  <data key="d0">Litíase Biliar</data>
  <data key="d1">concept</data>
  <data key="d2">Litíase Biliar denotes biliary stones that may lead to pancreatic inflammation.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="Neoplasias">
  <data key="d0">Neoplasias</data>
  <data key="d1">concept</data>
  <data key="d2">Neoplasias are pancreatic tumors associated with secondary diabetes.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="Cirurgias Pancreáticas Prévias">
  <data key="d0">Cirurgias Pancreáticas Prévias</data>
  <data key="d1">concept</data>
  <data key="d2">Cirurgias Pancreáticas Prévias are previous pancreatic surgeries contributing to secondary diabetes.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373084</data>
  <data key="d6"></data>
</node>
<node id="Lipodistrofia Congênita">
  <data key="d0">Lipodistrofia Congênita</data>
  <data key="d1">concept</data>
  <data key="d2">Lipodistrofia Congênita is a generalized congenital loss of body fat.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373085</data>
  <data key="d6"></data>
</node>
<node id="Lipodistrofia Adquirida">
  <data key="d0">Lipodistrofia Adquirida</data>
  <data key="d1">concept</data>
  <data key="d2">Lipodistrofia Adquirida is an acquired form of fat loss, frequently associated with HIV infection.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373085</data>
  <data key="d6"></data>
</node>
<node id="Lipodistrofia Parcial">
  <data key="d0">Lipodistrofia Parcial</data>
  <data key="d1">concept</data>
  <data key="d2">Lipodistrofia Parcial describes partial loss of subcutaneous fat, often with variable fat accumulation elsewhere.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1786373085</data>
  <data key="d6"></data>
</node>
