  <data key="d14"></data>
</edge>
<edge source="Temperature" target="Novolin® R Penfill">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill must be stored at room temperature (15°C to 30°C) after opening and should not be refrigerated or frozen.</data>
