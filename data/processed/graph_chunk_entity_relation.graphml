</node>
<node id="Administração De Insulina">
  <data key="d0">Administração De Insulina</data>
  <data key="d1">method</data>
  <data key="d2">Administração de insulina refers to the process of delivering insulin via injection, requiring proper technique and dosage control.</data>
  <data key="d3">chunk-9cd336474a2e9457985162b1ddb4b603</data>
