  <data key="d6"></data>
</node>
<node id="Automated Insulin Delivery Systems">
  <data key="d0">Automated Insulin Delivery Systems</data>
  <data key="d1">method</data>
  <data key="d2">Automated insulin delivery (AID) systems use CGM‑informed algorithms to modulate insulin delivery.&lt;SEP&gt;Automated insulin delivery systems are devices that automatically adjust insulin delivery based on glucose sensor data.</data>
  <data key="d3">chunk-e4c5ae163a494feafedb71ed2205c02f&lt;SEP&gt;chunk-05cc642337c2a615c9b40de9336aec18</data>
