  <data key="d13"></data>
</edge>
<edge source="Técnica de Aplicação de Insulina" target="Botão Injetor">
  <data key="d7">1.0</data>
  <data key="d8">The technique mentions pressing the Botão Injetor on an insulin pen to maintain needle position after injection.</data>
