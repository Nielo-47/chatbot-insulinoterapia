<node id="Seção 7">
  <data key="d0">Seção 7</data>
  <data key="d1">concept</data>
  <data key="d2">Seção 7 is the seventh section of the medication leaflet, outlining storage care for the medication.</data>
  <data key="d3">chunk-759c20cc4c3fc0d3529aabc2fe7dbf99</data>
