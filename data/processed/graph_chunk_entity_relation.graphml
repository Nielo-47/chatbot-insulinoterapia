</node>
<node id="Eastman Kodak">
  <data key="d0">Eastman Kodak</data>
  <data key="d1">organization</data>
  <data key="d2">Eastman Kodak is mentioned as the employer of James Havens’ father, linking the family to the early insulin treatment.</data>
  <data key="d3">chunk-9043f44e67d9ed02b4864043d3cbb59a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332086</data>
  <data key="d6"></data>
</node>
