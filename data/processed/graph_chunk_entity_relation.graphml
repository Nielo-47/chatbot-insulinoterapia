</edge>
<edge source="TTGO-1h" target="Teste de tolerância à glicose oral (TTGO)">
  <data key="d7">1.0</data>
  <data key="d8">TTGO-1h is a one‑hour oral glucose tolerance test, a subtype of the TTGO method.</data>
  <data key="d9">submethod</data>
  <data key="d10">chunk-078f5907e86c2158587c79b26b0cd683</data>
