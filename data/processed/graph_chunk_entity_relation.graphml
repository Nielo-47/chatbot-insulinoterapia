<node id="Insulin Overdose">
  <data key="d0">Insulin Overdose</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin overdose refers to the administration of a quantity of insulin larger than indicated, leading to severe hypoglycemia.</data>
  <data key="d3">chunk-4da80e99fd3e43cb7d3b260aca23fe56</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/LANTUS _ BulasMed.pdf</data>
