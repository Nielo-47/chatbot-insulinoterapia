  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694529</data>
  <data key="d14"></data>
</edge>
<edge source="Aplicação De Insulina" target="Agulha De 8 Mm">
  <data key="d8">1.0</data>
  <data key="d9">A agulha de 8 mm não é recomendada para crianças e pessoas magras devido ao risco de atingir o músculo.</data>
  <data key="d10">injection risk,usage restriction</data>
