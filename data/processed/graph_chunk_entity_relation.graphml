  <data key="d6"></data>
</node>
<node id="Anticorpos">
  <data key="d0">Anticorpos</data>
  <data key="d1">concept</data>
  <data key="d2">Anticorpos may develop during Levemir treatment but do not appear to impact glycemic control.</data>
  <data key="d3">chunk-d80de93eae49980367cf11700b83b1ee</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
