</edge>
<edge source="Hipoglicemia" target="Glicose">
  <data key="d7">3.0</data>
  <data key="d8">Oral or intravenous Glicose is used to treat mild Hipoglicemia episodes.&lt;SEP&gt;Glicose is given orally or intravenously to treat mild or moderate Hipoglicemia.&lt;SEP&gt;Mild hipoglicemia can be treated with oral administration of glucose.</data>
  <data key="d9">intervention,mild,oral therapy,treatment</data>
  <data key="d10">chunk-922791f49d1bf928fe4f02ddd336927b&lt;SEP&gt;chunk-7f2714936869e55e840f5294caefeaee&lt;SEP&gt;chunk-a7ca732691e1cbcafd65e378b8d80144</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d12">1786318684</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Levemir®">
  <data key="d7">1.0</data>
  <data key="d8">Levemir® causes hypoglycemia in roughly 12 % of patients, with severe cases in about 6 % due to its insulin action.</data>
  <data key="d9">adverse reaction,dose‑dependent</data>
  <data key="d10">chunk-8a68ba1e8cc1defda76cde0eff9592e6</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d12">1786317857</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="MedDRA">
  <data key="d7">2.0</data>
  <data key="d8">MedDRA categorizes hypoglycemia as a very common adverse reaction to Levemir®.&lt;SEP&gt;MedDRA is used to categorize Hipoglicemia as an adverse reaction.</data>
  <data key="d9">classification,frequency,system</data>
  <data key="d10">chunk-8a68ba1e8cc1defda76cde0eff9592e6&lt;SEP&gt;chunk-0b4034f7cf7e37425b7c76f5e0f9fd11</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d12">1786318721</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Glucose">
  <data key="d7">2.0</data>
  <data key="d8">Glucose, given orally or intravenously, treats hipoglicemia.&lt;SEP&gt;Hipoglicemia can be treated with oral Glucose.</data>
  <data key="d9">rehydration,treatment</data>
  <data key="d10">chunk-d01ed6a801b11c1b53f4668059c1f9cb&lt;SEP&gt;chunk-786395f3716fb61a79fd183c63e1a9d6</data>
