  <data key="d1">method</data>
  <data key="d2">3ª Etapa: Teste de Segurança is the third method step that requires performing a safety test to ensure correct dose delivery and remove air bubbles.</data>
  <data key="d3">chunk-79f891b1d7c0c6ca0eab9dbcc76c902d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315501</data>
  <data key="d6"></data>
</node>
