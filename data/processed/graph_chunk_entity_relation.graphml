  <data key="d13"></data>
</edge>
<edge source="Lantus" target="Patients Under 2 Years">
  <data key="d7">1.0</data>
  <data key="d8">No clinical safety data are available for Lantus use in patients under two years of age.</data>
  <data key="d9">data gap,safety</data>
