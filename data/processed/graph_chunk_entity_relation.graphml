  <data key="d7">1.0</data>
  <data key="d8">The Sociedade Brasileira de Diabetes guideline recommends screening for Type 2 Diabetes Mellitus.</data>
  <data key="d9">guideline,recommendation</data>
  <data key="d10">chunk-3c6dca13b685243e63fb6f24f7cb301d</data>
