</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Black">
  <data key="d7">1.0</data>
  <data key="d8">Black youth show a higher prevalence of type 2 diabetes compared to Caucasian youth.</data>
  <data key="d9">ethnicity,prevalence</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
