  <data key="d5">1778710088</data>
  <data key="d6"></data>
  <data key="d7">Diabetes Tipo 2</data>
</node>
<node id="Profissional De Saúde">
  <data key="d0">Profissional De Saúde</data>
  <data key="d1">person</data>
  <data key="d2">Profissional de saúde é responsável por ensinar, demonstrar e verificar a aplicação correta da insulina, além de evitar abreviações em prescrições.</data>
  <data key="d3">chunk-3d0de4d525c273cda4939a501eaecc6d</data>
