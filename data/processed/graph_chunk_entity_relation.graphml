  <data key="d14"></data>
</edge>
<edge source="Pessoa Com Diabetes" target="Termo De Recebimento">
  <data key="d8">1.0</data>
  <data key="d9">A pessoa com diabetes ou seu responsável deve assinar o Termo de Recebimento ao receber a caneta reutilizável do SUS.</data>
  <data key="d10">documentation,responsibility</data>
  <data key="d11">chunk-60fe44346c0b02882f7625cbf43d8ca0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Guia-Pratico-SBD-Canetas-Reutilizaveis-de-Insulina-no-SUS.pdf</data>
  <data key="d13">1778695527</data>
  <data key="d14"></data>
</edge>
<edge source="Pessoa Com Diabetes" target="Descarte Consciente">
  <data key="d8">1.0</data>
  <data key="d9">A pessoa com diabetes deve realizar o descarte consciente dos insumos, especialmente das agulhas, em recipientes apropriados para segurança.</data>
  <data key="d10">safety practice,waste management</data>
  <data key="d11">chunk-60fe44346c0b02882f7625cbf43d8ca0</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Guia-Pratico-SBD-Canetas-Reutilizaveis-de-Insulina-no-SUS.pdf</data>
