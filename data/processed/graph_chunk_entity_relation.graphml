  <data key="d12">1786319823</data>
  <data key="d13"></data>
</edge>
<edge source="Cetoacidose Diabética" target="Náusea">
  <data key="d7">2.0</data>
  <data key="d8">Nausea is a symptom of diabetic ketoacidosis.&lt;SEP&gt;Nausea can occur when ketoacidosis is untreated.</data>
  <data key="d9">complication,symptom</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
