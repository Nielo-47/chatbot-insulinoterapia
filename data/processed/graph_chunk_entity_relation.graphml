  <data key="d13">1778707480</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Failed BG Check Alert">
  <data key="d8">1.0</data>
  <data key="d9">The CGM device triggers a Failed BG Check Alert when entered blood glucose values cannot be used for calibration.</data>
  <data key="d10">calibration failure,system verification</data>
  <data key="d11">chunk-8394829309b48ea8c957132c29c4ea39</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707514</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Change Sensor Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Change Sensor Alert is issued by the CGM device when repeated calibration failures occur, indicating the need for a new sensor.</data>
  <data key="d10">sensor replacement,system maintenance</data>
  <data key="d11">chunk-8394829309b48ea8c957132c29c4ea39</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707515</data>
  <data key="d14"></data>
</edge>
<edge source="CGM Device" target="Enter BG Now Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Enter BG Now Alert is triggered by the CGM device to prompt the user to enter a blood glucose value for calibration.</data>
  <data key="d10">calibration requirement,data restoration</data>
  <data key="d11">chunk-8394829309b48ea8c957132c29c4ea39</data>
