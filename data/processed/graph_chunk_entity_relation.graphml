  <data key="d6"></data>
</node>
<node id="Suspend">
  <data key="d0">Suspend</data>
  <data key="d1">concept</data>
  <data key="d2">Suspend is the function that pauses insulin delivery.&lt;SEP&gt;Suspend refers to features that stop insulin delivery, including Suspend before low and Suspend on low.&lt;SEP&gt;An operation that temporarily halts insulin delivery.</data>
  <data key="d3">chunk-83bb94d08bdb958eff25f76c9a6ac18a&lt;SEP&gt;chunk-db8e2f5011e0e0fe7dc11273e2f345b9&lt;SEP&gt;chunk-b6025fa711665988fad0f789b9eb901a</data>
