</node>
<node id="Humalog Leaflet">
  <data key="d0">Humalog Leaflet</data>
  <data key="d1">content</data>
  <data key="d2">The Humalog leaflet contains usage instructions, warnings, and dosage information for patients.</data>
  <data key="d3">chunk-c3daabbd42055dc30154f5f97c85fb7d</data>
