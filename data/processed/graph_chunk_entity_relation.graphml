  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1786301843</data>
  <data key="d6"></data>
</node>
<node id="Medical-Hospital Environment">
  <data key="d0">Medical-Hospital Environment</data>
  <data key="d1">location</data>
  <data key="d2">Medical-Hospital Environment denotes the clinical setting where insulin practices and protocols are applied.</data>
  <data key="d3">chunk-b5b4c60b3de8c56d9ab869d868345fb7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d5">1786301843</data>
  <data key="d6"></data>
</node>
<node id="Application Angle">
  <data key="d0">Application Angle</data>
  <data key="d1">concept</data>
  <data key="d2">The angle between the needle and the skin at insertion, recommended based on needle length, patient age, and subcutaneous tissue thickness.</data>
  <data key="d3">chunk-64b999805e924800faef3b856e45d8bf</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
