</edge>
<edge source="Alerta" target="Luz Roja De La Bomba">
  <data key="d8">1.0</data>
  <data key="d9">Alerta is indicated by the luz roja de la bomba blinking in a specific pattern.</data>
  <data key="d10">device signaling,visual notification</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701034</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta" target="Audio De Alerta">
  <data key="d8">1.0</data>
  <data key="d9">Alerta is accompanied by an audio de alerta that repeats every 5 or 15 minutes.</data>
  <data key="d10">alarm signaling,auditory notification</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701034</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta" target="Pantalla De La Bomba">
  <data key="d8">1.0</data>
  <data key="d9">Pantalla de la bomba shows details and instructions when an alerta occurs.</data>
  <data key="d10">information display,user instruction</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701035</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta" target="Pila Baja">
  <data key="d8">1.0</data>
  <data key="d9">Pila baja is an example of an alerta that signals the need for battery replacement in the insulin pump.</data>
  <data key="d10">battery warning,device maintenance</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701037</data>
  <data key="d14"></data>
</edge>
<edge source="Alerta" target="Reservorio Bajo">
  <data key="d8">1.0</data>
  <data key="d9">Reservorio bajo is an example of an alerta indicating that the insulin supply is running low.</data>
  <data key="d10">device monitoring,insulin supply warning</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701038</data>
  <data key="d14"></data>
</edge>
<edge source="Alarma" target="Luz Roja De La Bomba">
  <data key="d8">1.0</data>
  <data key="d9">Alarma is signaled by the luz roja de la bomba blinking twice followed by a pause.</data>
  <data key="d10">critical signaling,visual warning</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701034</data>
  <data key="d14"></data>
</edge>
<edge source="Alarma" target="Audio De Alerta">
  <data key="d8">1.0</data>
  <data key="d9">Alarma triggers a repeated audio de alerta or vibration to demand immediate attention.</data>
  <data key="d10">auditory alarm,urgent notification</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778701035</data>
  <data key="d14"></data>
</edge>
<edge source="Alarma" target="Pantalla De La Bomba">
  <data key="d8">1.0</data>
  <data key="d9">Pantalla de la bomba displays urgent instructions when an alarma occurs.</data>
  <data key="d10">critical information,emergency display</data>
  <data key="d11">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
