<edge source="Novolin® R Penfill" target="Farmacodinâmica">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R Penfill lowers blood glucose by facilitating glucose uptake in cells and inhibiting liver glucose production.</data>
