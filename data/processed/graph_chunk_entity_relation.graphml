  <data key="d12">1786315690</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Reação Adversa">
  <data key="d7">1.0</data>
  <data key="d8">Hipoglicemia is listed as a common adverse reaction to insulin therapy.</data>
  <data key="d9">adverse event,symptom</data>
  <data key="d10">chunk-0e7689ca0fc736d9eae94256f73fed52</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315753</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Tabela 9">
  <data key="d7">1.0</data>
  <data key="d8">Tabela 9 reports the incidence percentages of hypoglycemia in pediatric patients treated with Fiasp® regimens.</data>
