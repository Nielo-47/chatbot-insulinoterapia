  <data key="d0">Conexion Bomba Medidor</data>
  <data key="d1">method</data>
  <data key="d2">Conexion Bomba Medidor refers to the procedure of connecting an insulin pump with a glucose meter for data synchronization.&gt;</data>
  <data key="d3">chunk-f61911be532419242af177a0b5feeb72</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
