  <data key="d13"></data>
</edge>
<edge source="MiniMed Mobile App" target="History Paired Sensors Screen">
  <data key="d7">1.0</data>
  <data key="d8">MiniMed Mobile App provides access to the History Paired Sensors Screen for reviewing sensor details.</data>
