  <data key="d5">1786336920</data>
  <data key="d6"></data>
</node>
<node id="Dentist">
  <data key="d0">Dentist</data>
  <data key="d1">person</data>
  <data key="d2">Dentist is a healthcare professional to be informed about undesirable reactions to Humalog.&lt;SEP&gt;Dentist is mentioned as a professional who must give guidance before a pregnant woman uses the medication.&lt;SEP&gt;Dentist is a dental professional who should be informed if a patient is using Tresiba® and other medications.&lt;SEP&gt;Dentist is a healthcare professional who may be consulted for medication guidance during pregnancy or lactation.&lt;SEP&gt;Dentist is a dental professional who should be consulted regarding Humulin R use during pregnancy or lactation.</data>
  <data key="d3">chunk-e89f1dbae629e925f06732cebf41df16&lt;SEP&gt;chunk-4704ea4d5c15ebc8c043a077f05fd7a3&lt;SEP&gt;chunk-e9ae5f9ffa7eff9bb36cf1a9764df3e7&lt;SEP&gt;chunk-4319d08c10ed2b48857a6d42eadd9db0&lt;SEP&gt;chunk-0fa819f7e1e42eb688d4894dc3ca7e64</data>
