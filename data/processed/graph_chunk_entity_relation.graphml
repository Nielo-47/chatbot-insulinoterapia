  <data key="d14"></data>
  <data key="d15">Abdomen</data>
  <data key="d16">Subcutaneous Injection</data>
</edge>
<edge source="Subcutaneous Injection" target="Insulin Injection Technique">
  <data key="d8">1.0</data>
  <data key="d9">Insulin must be administered via subcutaneous injection to ensure proper absorption and avoid complications.</data>
  <data key="d10">administration route,correct method</data>
  <data key="d11">chunk-ee3024e95a663f89ec3c7a35028cc636</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695235</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Injection" target="Forearm">
  <data key="d8">1.0</data>
  <data key="d9">The forearm is not a recommended site for subcutaneous insulin injection due to absorption issues and guidelines.</data>
  <data key="d10">contraindicated location,injection site</data>
  <data key="d11">chunk-dc6a188926df383900f31928c8726a8f</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d13">1778696037</data>
  <data key="d14"></data>
</edge>
<edge source="Subcutaneous Injection" target="Insulin Administration Through Clothing">
  <data key="d8">1.0</data>
  <data key="d9">Injecting insulin through clothing is unsafe and compromises the correct execution of subcutaneous injection techniques.</data>
  <data key="d10">improper technique,safety risk</data>
  <data key="d11">chunk-dc6a188926df383900f31928c8726a8f</data>
