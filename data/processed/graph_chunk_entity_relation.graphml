  <data key="d0">July 9, 1922 – Charlotte Clarke Admission</data>
  <data key="d1">event</data>
  <data key="d2">On July 9 1922, 57‑year‑old diabetic Charlotte Clarke was admitted to Toronto General Hospital for possible insulin treatment.</data>
