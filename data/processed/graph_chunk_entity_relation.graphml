  <data key="d13"></data>
</edge>
<edge source="TTGO-1h" target="Israel GOH Study">
  <data key="d7">1.0</data>
  <data key="d8">The study found risk ratios of 4.35 for DM2 and 1.87 for pre‑diabetes among participants with TTGO‑1h ≥ 155 mg/dl.</data>
  <data key="d9">glucose testing,risk ratio</data>
  <data key="d10">chunk-e428438c632682ef93541430ec497ed5</data>
