  <data key="d14"></data>
</edge>
<edge source="Pain Reduction In Insulin Injection" target="i-Port">
  <data key="d8">1.0</data>
  <data key="d9">The i-Port contributes to pain reduction by minimizing repeated skin punctures during insulin therapy.</data>
  <data key="d10">comfort,device benefit</data>
  <data key="d11">chunk-1d9f7234865211afc5d8343294b276d1</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694569</data>
  <data key="d14"></data>
</edge>
<edge source="i-Port" target="Insulin Injection Pain">
  <data key="d8">1.0</data>
  <data key="d9">The i-Port device reduces injection discomfort by allowing multiple doses through a single insertion site.</data>
