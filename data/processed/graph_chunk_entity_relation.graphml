  <data key="d13">1778696016</data>
  <data key="d14"></data>
</edge>
<edge source="Needle Dwell Time" target="Syringe Plunger">
  <data key="d8">1.0</data>
  <data key="d9">The syringe plunger must remain pressed for at least 5 seconds after insulin injection to ensure full dose delivery and prevent reflux.</data>
  <data key="d10">device operation,injection completion</data>
  <data key="d11">chunk-5bbc7b2df438b8290a4da57f63f1ff5d</data>
