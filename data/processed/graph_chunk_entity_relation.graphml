</edge>
<edge source="Gestational Diabetes Mellitus" target="One‑Step Method">
  <data key="d7">1.0</data>
  <data key="d8">The one‑step method identifies roughly twice as many individuals with Gestational Diabetes Mellitus as the two‑step method.</data>
  <data key="d9">higher detection</data>
  <data key="d10">chunk-59dd4faf2a2706d073fdb93e1a29da81</data>
