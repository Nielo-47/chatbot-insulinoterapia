  <data key="d5">1786315427</data>
  <data key="d6"></data>
</node>
<node id="Embriotoxicidade">
  <data key="d0">Embriotoxicidade</data>
  <data key="d1">concept</data>
  <data key="d2">Embriotoxicidade denotes toxic effects on embryos; studies with insulin glargina in rats and rabbits were performed.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313638</data>
  <data key="d6"></data>
</node>
