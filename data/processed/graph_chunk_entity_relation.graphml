<node id="Glucose Reader">
  <data key="d0">Glucose Reader</data>
  <data key="d1">artifact</data>
  <data key="d2">The glucose reader is a device that receives data from the glucose sensor and displays real-time glucose values, trends, and alarms.</data>
  <data key="d3">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
