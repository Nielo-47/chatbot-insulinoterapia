  <data key="d1">naturalobject</data>
  <data key="d2">Óxido de zinco is an excipient included in the BASAGLAR® formulation.</data>
  <data key="d3">chunk-9e62226007200589cb2143f0fb75b302</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
