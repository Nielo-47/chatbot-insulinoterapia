  <data key="d14"></data>
</edge>
<edge source="Novolin® R" target="Medication Label Verification">
  <data key="d8">1.0</data>
  <data key="d9">Patients are instructed to verify the label of Novolin® R before each use to prevent accidental mix-ups with other insulins.</data>
  <data key="d10">error prevention,patient safety</data>
  <data key="d11">chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
