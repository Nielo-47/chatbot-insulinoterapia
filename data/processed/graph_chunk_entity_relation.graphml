<node id="ANCOVA Model">
  <data key="d0">ANCOVA Model</data>
  <data key="d1">method</data>
  <data key="d2">Analysis of covariance model used to adjust for treatment, country, and injection timing as fixed effects in the study.&lt;SEP&gt;The ANCOVA model includes treatment, country and basal insulin injection timing as fixed effects and the mean HbA1c as a covariate.&lt;SEP&gt;ANCOVA Model is the statistical analysis method used to adjust for treatment, country, and injection timing.</data>
  <data key="d3">chunk-afc9722167670b0bfeef0b43f4b0df79&lt;SEP&gt;chunk-7a592aedb257bad9532268b4056ec15c&lt;SEP&gt;chunk-3ce5998d1ff6a67e2e549405b16f744f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786309962</data>
  <data key="d6"></data>
</node>
<node id="Injection Timing (Day or Night)">
  <data key="d0">Injection Timing (Day or Night)</data>
  <data key="d1">concept</data>
  <data key="d2">Timing of basal insulin injection (daytime or nighttime) considered as a covariate in the ANCOVA model.</data>
  <data key="d3">chunk-afc9722167670b0bfeef0b43f4b0df79</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786309962</data>
  <data key="d6"></data>
</node>
