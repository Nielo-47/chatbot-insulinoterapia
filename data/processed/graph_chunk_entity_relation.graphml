</edge>
<edge source="Glycemic Monitoring" target="Nocturnal Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Rigorous glycemic monitoring after the last daily meal helps prevent nighttime hypoglycemia.</data>
