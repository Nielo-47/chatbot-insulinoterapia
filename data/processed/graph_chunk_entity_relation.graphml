</edge>
<edge source="CareLink Software" target="CareLink Uploader">
  <data key="d8">2.0</data>
  <data key="d9">CareLink software relies on the CareLink uploader to receive data from the insulin pump.&lt;SEP&gt;The CareLink Uploader provides instructions for transferring device data to CareLink software.</data>
  <data key="d10">data transfer,device communication,device integration</data>
  <data key="d11">chunk-583197b9760861a9bb1ee261914759fc&lt;SEP&gt;chunk-7d37ccd138ed8a095eb197006a33b8a7</data>
