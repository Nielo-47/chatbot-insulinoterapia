</edge>
<edge source="Insulin Storage" target="In-Use Reusable Insulin Pen">
  <data key="d8">1.0</data>
  <data key="d9">An in-use reusable insulin pen should be stored at room temperature and used within 4 to 8 weeks, following manufacturer instructions.</data>
  <data key="d10">manufacturer guidance,usage period</data>
  <data key="d11">chunk-11ac81b4dee4dbb3636b8dc2403e0661</data>
