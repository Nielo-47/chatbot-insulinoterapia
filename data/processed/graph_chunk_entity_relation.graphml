  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia Treatment" target="Glucose Alert Value">
  <data key="d7">1.0</data>
  <data key="d8">The glucose alert value of 70 mg/dL defines when fast‑acting carbohydrates should be administered for hypoglycemia.</data>
