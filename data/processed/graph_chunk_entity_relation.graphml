  <data key="d6"></data>
</node>
<node id="Antipsicóticos">
  <data key="d0">Antipsicóticos</data>
  <data key="d1">concept</data>
  <data key="d2">Antipsychotic drugs are associated with increased diabetes risk through direct effects on insulin secretion and indirect weight gain.&lt;SEP&gt;Antipsicóticos are antipsychotic drugs that may raise blood glucose, leading to recommended diabetes screening.</data>
  <data key="d3">chunk-e7b4535dbb2554b84c7a2e024c4b82c4&lt;SEP&gt;chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786371974</data>
  <data key="d6"></data>
</node>
<node id="Clorpromazina">
  <data key="d0">Clorpromazina</data>
  <data key="d1">concept</data>
  <data key="d2">Clorpromazina is a first‑generation antipsychotic linked to higher diabetes risk.</data>
  <data key="d3">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
