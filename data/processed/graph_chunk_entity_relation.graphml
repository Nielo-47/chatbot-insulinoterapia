</node>
<node id="Adults With Diabetes">
  <data key="d0">Adults With Diabetes</data>
  <data key="d1">person</data>
  <data key="d2">Adults with diabetes are individuals receiving insulin therapy who may use continuous glucose monitoring devices.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335923</data>
  <data key="d6"></data>
</node>
<node id="Youth With Type 1 Diabetes">
  <data key="d0">Youth With Type 1 Diabetes</data>
  <data key="d1">person</data>
  <data key="d2">Youth with type 1 diabetes are young patients who require insulin and may use continuous glucose monitoring devices.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335923</data>
  <data key="d6"></data>
</node>
<node id="A1C Targets">
  <data key="d0">A1C Targets</data>
  <data key="d1">concept</data>
  <data key="d2">A1C targets are glycosylated hemoglobin goals used to assess long‑term glucose control in diabetes.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335923</data>
  <data key="d6"></data>
</node>
<node id="Skin Reactions">
  <data key="d0">Skin Reactions</data>
  <data key="d1">concept</data>
  <data key="d2">Skin reactions are irritation or allergy events that can occur at the site of continuous glucose monitoring device attachment.&lt;SEP&gt;Skin reactions are irritation or allergy responses that may occur at CGM sensor sites and should be assessed.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0&lt;SEP&gt;chunk-0fe1eff7b58582dec4c8ae7578e20e66</data>
