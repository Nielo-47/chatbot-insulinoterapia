  <data key="d14"></data>
</edge>
<edge source="Transmitter" target="Smartphone App">
  <data key="d8">1.0</data>
  <data key="d9">The Eversense transmitter sends glucose data and alerts to the smartphone app, enabling real-time monitoring and customizable notifications.</data>
