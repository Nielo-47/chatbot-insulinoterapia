</edge>
<edge source="Hipoglicemia" target="Balas/Drops Açucarados">
  <data key="d7">2.0</data>
  <data key="d8">Sugary candies are used to quickly raise blood glucose in mild hypoglycemia.&lt;SEP&gt;Sugary candies or drops provide a rapid source of sugar for hypoglycemia management.</data>
  <data key="d9">emergency,quick source,treatment</data>
