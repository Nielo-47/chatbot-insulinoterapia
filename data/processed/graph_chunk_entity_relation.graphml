  <data key="d14"></data>
</edge>
<edge source="Glucose Sensor" target="Sensor Glucose">
  <data key="d8">1.0</data>
  <data key="d9">The Glucose Sensor generates Sensor Glucose (SG) values by measuring glucose levels in the interstitial fluid.</data>
  <data key="d10">data generation,measurement</data>
  <data key="d11">chunk-86d3bb81c7595510175054c288b122fb</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703025</data>
  <data key="d14"></data>
</edge>
<edge source="Glucose Sensor" target="SAP">
