  <data key="d0">Insulin Flow Blocked Alarm</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Flow Blocked Alarm signals that basal or bolus insulin flow is blocked and advises checking BG and ketones.</data>
  <data key="d3">chunk-71de01baf40871c616eaa39cb8189f43</data>
