<node id="Pizza">
  <data key="d0">Pizza</data>
  <data key="d1">food</data>
  <data key="d2">Pizza is a food item that causes delayed hyperglycemia in William, prompting the use of a dual bolus.&lt;SEP&gt;Pizza is a food item that causes delayed glucose elevation in William, prompting the use of a bolus cuadrado.</data>
  <data key="d3">chunk-e96a4da2f877f1b93eb7d982c91358ea&lt;SEP&gt;chunk-e15921d1b7d6415709a3d0c795cefc3c</data>
