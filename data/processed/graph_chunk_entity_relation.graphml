  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Two‑Step Method">
  <data key="d7">1.0</data>
  <data key="d8">The two‑step method identifies fewer cases of Gestational Diabetes Mellitus compared with the one‑step method.</data>
  <data key="d9">lower detection</data>
