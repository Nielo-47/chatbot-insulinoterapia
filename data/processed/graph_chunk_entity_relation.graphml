<node id="Intercurrent Illnesses">
  <data key="d0">Intercurrent Illnesses</data>
  <data key="d1">concept</data>
  <data key="d2">Intercurrent illnesses are conditions that require intensified metabolic monitoring in patients using insulin.</data>
  <data key="d3">chunk-3397508bdfddde019cb1dfdcfb352435</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
