</node>
<node id="Exon 1 Mutation">
  <data key="d0">Exon 1 Mutation</data>
  <data key="d1">concept</data>
  <data key="d2">Rare LMNA mutations located in exon 1 that are associated with cardiomyopathy, premature congestive heart failure, cardiac arrhythmias, and may require heart transplantation.</data>
  <data key="d3">chunk-383b02cc66391d66174344ff49464766</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321240</data>
  <data key="d6"></data>
</node>
