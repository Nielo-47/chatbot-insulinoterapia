  <data key="d13"></data>
</edge>
<edge source="Pump" target="Status Screen">
  <data key="d7">2.0</data>
  <data key="d8">The pump presents current information and alerts on the Status screen.&lt;SEP&gt;The Pump shows a Status Screen presenting current system information.</data>
