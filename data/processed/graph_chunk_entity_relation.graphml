  <data key="d1">artifact</data>
  <data key="d2">Metabolite M1 (21A‑Gly‑insulin) is an active degradation product of insulin glargina identified in circulation.</data>
  <data key="d3">chunk-133169995b3ab942fd96f1fdfe7269ad</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
