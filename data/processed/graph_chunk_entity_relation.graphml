  <data key="d13">1778699643</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Children Over 3 Years">
  <data key="d8">1.0</data>
  <data key="d9">Humulin R can be used in children over 3 years without special precautions.</data>
