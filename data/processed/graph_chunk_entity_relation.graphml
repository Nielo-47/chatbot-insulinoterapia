</edge>
<edge source="Cetoacidose Diabética" target="Vômito">
  <data key="d7">2.0</data>
  <data key="d8">Vomiting occurs in diabetic ketoacidosis.&lt;SEP&gt;Vomiting is a possible manifestation of untreated ketoacidosis.</data>
  <data key="d9">complication,symptom</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
