  <data key="d0">Outcome Reduction with Initial Glargine Intervention</data>
  <data key="d1">event</data>
  <data key="d2">Outcome Reduction with Initial Glargine Intervention is the full name of the ORIGIN clinical trial evaluating initial glargine insulin intervention.</data>
  <data key="d3">chunk-a72472938feb27131681a1591081e8c1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Basaglar.pdf</data>
  <data key="d5">1786310022</data>
