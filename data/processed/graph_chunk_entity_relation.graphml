  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332064</data>
  <data key="d6"></data>
</node>
<node id="Secretin Stimulation Procedure">
  <data key="d0">Secretin Stimulation Procedure</data>
  <data key="d1">method</data>
  <data key="d2">Secretin Stimulation Procedure is a method that uses secretin to stimulate pancreatic juice production for extract preparation.</data>
