<edge source="Levemir" target="Laura F. O. Azevedo">
  <data key="d8">1.0</data>
  <data key="d9">Laura F. O. Azevedo is the responsible pharmacist for Levemir in Brazil, registered under CRF/SP nº 100487.</data>
