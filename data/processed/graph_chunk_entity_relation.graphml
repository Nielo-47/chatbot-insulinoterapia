  <data key="d0">Grupo de Educação</data>
  <data key="d1">concept</data>
  <data key="d2">Grupo de Educação is the intervention group receiving structured insulin injection education in the clinical trial.</data>
  <data key="d3">chunk-8375bd3e65b9aa9965acd81fd9a448f8</data>
