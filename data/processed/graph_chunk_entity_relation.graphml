</edge>
<edge source="Physical Activity" target="Insulin Therapy">
  <data key="d8">1.0</data>
  <data key="d9">Insulin therapy must be adjusted before and during physical activity to prevent hypoglycemia or hyperglycemia.</data>
  <data key="d10">glucose regulation,therapy adjustment</data>
  <data key="d11">chunk-835d0624a6c9c20cffbc5a61e5f42de0</data>
