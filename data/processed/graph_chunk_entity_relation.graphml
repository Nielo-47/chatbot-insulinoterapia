  <data key="d13">1778707655</data>
  <data key="d14"></data>
</edge>
<edge source="Home Screen" target="Paired Devices">
  <data key="d8">1.0</data>
  <data key="d9">The Paired Devices screen is accessed from the Home Screen to view or manage connected devices.</data>
  <data key="d10">device management,navigation</data>
