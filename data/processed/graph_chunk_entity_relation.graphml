</edge>
<edge source="Paciente" target="Cirurgião-Dentista">
  <data key="d8">1.0</data>
  <data key="d9">Patients must seek guidance from a physician or dentist before using insulin-related medication during pregnancy or lactation.</data>
  <data key="d10">medical guidance,medication safety</data>
  <data key="d11">chunk-19de4016c46aba524b40e489fd60f018</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699636</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Neuropatia Diabética">
  <data key="d8">1.0</data>
  <data key="d9">Patients with diabetic neuropathy may lose the ability to recognize early warning signs of hypoglycemia.</data>
  <data key="d10">disease complication,symptom masking</data>
  <data key="d11">chunk-19de4016c46aba524b40e489fd60f018</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699636</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Beta-Bloqueadores">
  <data key="d8">1.0</data>
  <data key="d9">Patients taking beta-blockers may experience less pronounced or altered early symptoms of hypoglycemia.</data>
  <data key="d10">medication effect,symptom suppression</data>
  <data key="d11">chunk-19de4016c46aba524b40e489fd60f018</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699637</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Controle Glicêmico">
  <data key="d8">1.0</data>
  <data key="d9">Patients with significantly improved glycemic control, such as through intensified insulin therapy, may lose some or all early warning symptoms of hypoglycemia.</data>
  <data key="d10">symptom reduction,therapy intensification</data>
  <data key="d11">chunk-19de4016c46aba524b40e489fd60f018</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699638</data>
  <data key="d14"></data>
</edge>
<edge source="Paciente" target="Medico">
  <data key="d8">1.0</data>
  <data key="d9">The patient is instructed to inform their doctor if experiencing nausea, vomiting, high glucose levels, or moderate to high ketone presence.</data>
  <data key="d10">health monitoring,medical guidance</data>
  <data key="d11">chunk-84d2aca165fc0184360972207bae8c6b</data>
