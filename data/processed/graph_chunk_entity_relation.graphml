  <data key="d6"></data>
</node>
<node id="Hidratos De Carbono">
  <data key="d0">Hidratos De Carbono</data>
  <data key="d1">substance</data>
  <data key="d2">Hidratos de carbono are carbohydrates measured in grams, used as input for insulin bolus calculations.&lt;SEP&gt;Hidratos de carbono refers to carbohydrates (measured in grams) consumed by the user, used in insulin dosage calculations.&lt;SEP&gt;Hidratos de carbono are nutrients that affect blood glucose levels and are used to treat hypoglycemia when blood sugar is low.&lt;SEP&gt;Los hidratos de carbono son nutrientes que aumentan los niveles de glucosa en sangre y se utilizan para tratar episodios de hipoglucemia.</data>
  <data key="d3">chunk-edf22db77193377cf626b08881757226&lt;SEP&gt;chunk-89156e5c9ff284920f8f122774e1ee34&lt;SEP&gt;chunk-369c90dae1a79813d89bb9a0b31ebfe9&lt;SEP&gt;chunk-1161d90ae3c3dfe3fc54cc15351e9452</data>
