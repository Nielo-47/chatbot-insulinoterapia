</edge>
<edge source="Interstitial Fluid" target="Sensor Glucose">
  <data key="d8">2.0</data>
  <data key="d9">Sensor Glucose levels reflect glucose concentrations in the interstitial fluid, which change slightly after blood glucose fluctuations.&lt;SEP&gt;Sensor glucose is measured from the glucose present in the interstitial fluid.</data>
  <data key="d10">diffusion process,measurement source,physiological basis,physiological correlation</data>
  <data key="d11">chunk-b0f14c91b2fb52c8fcc6d43aa4f53f64&lt;SEP&gt;chunk-86d3bb81c7595510175054c288b122fb</data>
