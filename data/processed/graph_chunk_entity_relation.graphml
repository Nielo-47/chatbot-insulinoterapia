  <data key="d13">1778708524</data>
  <data key="d14"></data>
</edge>
<edge source="Pump" target="Unpair Device">
  <data key="d8">1.0</data>
  <data key="d9">The Unpair Device function is used on the pump to disconnect the currently paired CGM device.</data>
  <data key="d10">device disconnection,user action</data>
