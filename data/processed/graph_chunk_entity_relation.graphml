  <data key="d14"></data>
</edge>
<edge source="Correction Bolus" target="FSI">
  <data key="d8">1.0</data>
  <data key="d9">FSI determines how many mg/dL of glucose are reduced per unit of insulin and is used to compute the correction bolus.</data>
  <data key="d10">dose determination,insulin sensitivity</data>
  <data key="d11">chunk-1d0f18d3b5098557dfd71a1955adc3a2</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
