</edge>
<edge source="Diabetes Type 1" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">Patients with diabetes type 1 typically require 0.5 to 1.0 UI/kg/day of insulin, with Novolin® R being part of their regimen.</data>
  <data key="d10">dosage,therapeutic indication</data>
  <data key="d11">chunk-0e1d7f92cdb7923807a9067d937837a4</data>
