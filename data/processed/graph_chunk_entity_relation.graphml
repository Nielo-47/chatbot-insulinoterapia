  <data key="d1">artifact</data>
  <data key="d2">Insulina NPH Turva refers to a cloudy NPH insulin whose stability trend differed from the clear analogue.</data>
  <data key="d3">chunk-8375bd3e65b9aa9965acd81fd9a448f8</data>
