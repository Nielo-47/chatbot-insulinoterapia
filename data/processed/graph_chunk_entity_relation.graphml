  <data key="d0">Teste de Ames</data>
  <data key="d1">method</data>
  <data key="d2">Teste de Ames is a bacterial reverse‑mutation assay used to evaluate the mutagenic potential of insulin glargina.&lt;SEP&gt;Teste de Ames is a bacterial reverse mutation assay used to assess mutagenicity.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e&lt;SEP&gt;chunk-e212a20942ed5387efe96e92bdb4ba98</data>
