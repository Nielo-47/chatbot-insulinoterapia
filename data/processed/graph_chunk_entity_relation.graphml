  <data key="d16">Insulin Detemir</data>
</edge>
<edge source="Insulin Aspart" target="Levemir">
  <data key="d8">1.0</data>
  <data key="d9">Levemir was used in combination with insulin aspart as part of a basal-bolus insulin regimen in the clinical study.</data>
  <data key="d10">basal-bolus regimen,combination therapy</data>
  <data key="d11">chunk-e7e33f93b79c1061267614c8283508c6</data>
