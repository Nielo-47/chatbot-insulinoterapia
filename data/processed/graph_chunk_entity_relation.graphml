  <data key="d13"></data>
</edge>
<edge source="MiniMed Mobile App" target="Compatible Mobile Device">
  <data key="d7">4.0</data>
  <data key="d8">The MiniMed Mobile App provides instructions to keep the compatible mobile device secure while paired with the pump.&lt;SEP&gt;The MiniMed Mobile app is used to pair the compatible mobile device with the insulin pump.&lt;SEP&gt;The MiniMed Mobile app runs on a compatible mobile device.&lt;SEP&gt;MiniMed Mobile App requires a compatible mobile device to function.</data>
  <data key="d9">dependency,pairing,platform,required_for,runs on,security,setup,software guidance</data>
  <data key="d10">chunk-cdb000b83632c89167783ad4e6f1fb64&lt;SEP&gt;chunk-177e9aca0bf1c1724474ea529826bece&lt;SEP&gt;chunk-1dd74224daea51112742135154e46244</data>
