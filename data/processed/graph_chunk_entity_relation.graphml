  <data key="d13">1778708115</data>
  <data key="d14"></data>
</edge>
<edge source="Sensor" target="Calibration Not Accepted">
  <data key="d8">2.0</data>
  <data key="d9">A Calibration Not Accepted alert occurs when the entered blood glucose reading differs significantly from the sensor glucose reading.&lt;SEP&gt;Calibration Not Accepted occurs when the system rejects a sensor calibration attempt.</data>
  <data key="d10">calibration failure,data validation,reading discrepancy,setup error</data>
  <data key="d11">chunk-cfb8f4a2fd599a5ec7cbad8c356a6ed4&lt;SEP&gt;chunk-3f39c0ebbd9b32994a3bb5daf68794d7</data>
