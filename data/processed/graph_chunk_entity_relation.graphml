  <data key="d12">1786368624</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Crianças E Adolescentes (DM1)">
  <data key="d7">1.0</data>
  <data key="d8">Crianças e adolescentes (DM1) aim for HbA1c lower than 7 % (up to 7.5 % if risk).</data>
  <data key="d9">glycemic control,target</data>
  <data key="d10">chunk-82e0d8e22a06c73855abed11561ce467</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1786368645</data>
  <data key="d13"></data>
</edge>
<edge source="HbA1c" target="Idosos Saudáveis">
  <data key="d7">1.0</data>
  <data key="d8">Idosos saudáveis aim for HbA1c up to 7.5 %.</data>
  <data key="d9">glycemic control,target</data>
  <data key="d10">chunk-82e0d8e22a06c73855abed11561ce467</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1786368646</data>
  <data key="d13"></data>
</edge>
