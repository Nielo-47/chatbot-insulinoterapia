<node id="0800 722 6001">
  <data key="d0">0800 722 6001</data>
  <data key="d1">data</data>
  <data key="d2">0800 722 6001 is the emergency poison control hotline number provided for cases of insulin overdose or intoxication.</data>
  <data key="d3">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
