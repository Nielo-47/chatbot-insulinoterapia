  <data key="d0">People With Insulin‑Requiring Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">People with insulin‑requiring diabetes are individuals who need multiple daily insulin injections or other insulin delivery methods.</data>
  <data key="d3">chunk-05cc642337c2a615c9b40de9336aec18</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335934</data>
  <data key="d6"></data>
</node>
<node id="Dexterity Issues">
  <data key="d0">Dexterity Issues</data>
  <data key="d1">concept</data>
  <data key="d2">Dexterity issues are physical limitations that can make manual insulin injection difficult.</data>
  <data key="d3">chunk-05cc642337c2a615c9b40de9336aec18</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335934</data>
  <data key="d6"></data>
</node>
