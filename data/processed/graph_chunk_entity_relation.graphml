  <data key="d14"></data>
</edge>
<edge source="Levemir® FlexPen®" target="Novo Nordisk Production SAS">
  <data key="d8">1.0</data>
  <data key="d9">Novo Nordisk Production SAS in Chartres, France, is a production site for Levemir® FlexPen®.</data>
