</edge>
<edge source="Medical Prescription" target="ISMP (Brasil)">
  <data key="d8">1.0</data>
  <data key="d9">ISMP (Brasil) recommends writing "units" instead of "U" in prescriptions to prevent misinterpretation and medication errors.</data>
  <data key="d10">error prevention,safety guidelines</data>
