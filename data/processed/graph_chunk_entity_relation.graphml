  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Rotation of Injection Sites">
  <data key="d7">1.0</data>
  <data key="d8">Rotating injection sites is important for effective and safe insulin treatment.</data>
  <data key="d9">method,therapy optimization</data>
  <data key="d10">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
