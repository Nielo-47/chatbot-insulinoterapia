  <data key="d13">1778699729</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina" target="Gordura">
  <data key="d8">1.0</data>
  <data key="d9">A insulina favorece a conversão de excesso de glicose em gordura no fígado.</data>
  <data key="d10">lipogenesis,metabolic conversion</data>
  <data key="d11">chunk-49e5674b4a4db2a056560132addcc354</data>
