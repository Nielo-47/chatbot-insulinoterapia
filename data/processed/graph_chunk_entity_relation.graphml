  <data key="d5">1778699600</data>
  <data key="d6"></data>
</node>
<node id="Exames Laboratoriais">
  <data key="d0">Exames Laboratoriais</data>
  <data key="d1">method</data>
  <data key="d2">Exames Laboratoriais são procedimentos cujas interações com HUMULIN R não foram investigadas.</data>
  <data key="d3">chunk-6398afdc8e1faa94220df6d070a1ade7</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
