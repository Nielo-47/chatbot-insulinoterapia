  <data key="d13"></data>
</edge>
<edge source="Levemir" target="Elderly Patients">
  <data key="d7">1.0</data>
  <data key="d8">Elderly patients using Levemir® require intensified glucose monitoring and individualized dose adjustment.</data>
  <data key="d9">dosage adjustment,monitoring</data>
