<edge source="Região Abdome" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">When injected into the abdomen, insulin glulisina has a bioavailability of about 73 %, similar to other sites.</data>
  <data key="d9">bioavailability,injection site</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
