  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316038</data>
  <data key="d6"></data>
</node>
<node id="Nicotinamide (Vitamin B3)">
  <data key="d0">Nicotinamide (Vitamin B3)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Nicotinamide (vitamin B3) is added to Fiasp® to produce a faster initial insulin absorption.</data>
  <data key="d3">chunk-2f4f01a72f35d6db3ff333e64f8400ce</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316038</data>
  <data key="d6"></data>
</node>
<node id="Subcutaneous Dose">
  <data key="d0">Subcutaneous Dose</data>
  <data key="d1">concept</data>
  <data key="d2">Subcutaneous dose is the amount of insulin administered via injection under the skin.</data>
  <data key="d3">chunk-2f4f01a72f35d6db3ff333e64f8400ce</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf</data>
  <data key="d5">1786316038</data>
  <data key="d6"></data>
</node>
