</edge>
<edge source="Atividade Física" target="HUMULIN R">
  <data key="d8">1.0</data>
  <data key="d9">Physical activity increases glucose uptake and can enhance the hypoglycemic effect of HUMULIN R.</data>
  <data key="d10">hypoglycemia risk,metabolic demand</data>
