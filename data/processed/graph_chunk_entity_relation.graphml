<node id="Level 1 Hyperglycemia">
  <data key="d0">Level 1 Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Level 1 Hyperglycemia refers to glucose readings between 181–250 mg/dL (10.1–13.9 mmol/L).</data>
  <data key="d3">chunk-a19f43c10a7a756e1597ff1a7f53296e</data>
