  <data key="d5">1786372164</data>
  <data key="d6"></data>
</node>
<node id="Time Above Range">
  <data key="d0">Time Above Range</data>
  <data key="d1">concept</data>
  <data key="d2">Time Above Range indicates the number of hours or percent of time blood glucose was above 180 mg/dL.&lt;SEP&gt;Time Above Range (TAR) is a metric representing the percentage of time glucose values exceed the target range.&lt;SEP&gt;Time Above Range denotes the percentage of glucose readings that exceed the target glucose range, used as a parameter for evaluating diabetes treatment plans.</data>
  <data key="d3">chunk-da4119d4fc266b13dd11e47dd6f506ca&lt;SEP&gt;chunk-a19f43c10a7a756e1597ff1a7f53296e&lt;SEP&gt;chunk-ba0417a72f50cf7ca66c87a351bd1ff8</data>
