</node>
<node id="Mammary Tumor Incidence (Insulin Humana Regular)">
  <data key="d0">Mammary Tumor Incidence (Insulin Humana Regular)</data>
  <data key="d1">data</data>
  <data key="d2">Frequency of mammary gland tumors observed in rats treated with regular human insulin, reported as comparable to that seen with APIDRA.</data>
  <data key="d3">chunk-ee2684edaea64aa597fd29c3bbda611d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315490</data>
  <data key="d6"></data>
</node>
<node id="Mutagenicity Tests">
  <data key="d0">Mutagenicity Tests</data>
  <data key="d1">method</data>
  <data key="d2">Ames test, in vitro chromosomal aberration assay in V79 cells, and in vivo micronucleus assay performed to assess the mutagenic potential of APIDRA.</data>
  <data key="d3">chunk-ee2684edaea64aa597fd29c3bbda611d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315490</data>
  <data key="d6"></data>
</node>
<node id="Teratology Study in Rats">
  <data key="d0">Teratology Study in Rats</data>
  <data key="d1">method</data>
  <data key="d2">Subcutaneous administration of APIDRA throughout gestation in rats to evaluate embryofetal development and toxicity.</data>
  <data key="d3">chunk-ee2684edaea64aa597fd29c3bbda611d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315490</data>
  <data key="d6"></data>
</node>
<node id="Teratology Study in Rabbits">
  <data key="d0">Teratology Study in Rabbits</data>
  <data key="d1">method</data>
  <data key="d2">Subcutaneous administration of APIDRA throughout gestation in rabbits to evaluate embryofetal development and toxicity.</data>
  <data key="d3">chunk-ee2684edaea64aa597fd29c3bbda611d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315490</data>
  <data key="d6"></data>
</node>
<node id="Ki-67">
  <data key="d0">Ki-67</data>
  <data key="d1">concept</data>
  <data key="d2">Ki-67 is a cellular proliferation marker evaluated by immunohistochemistry to compare mammary cell proliferation among APIDRA, regular insulin, and control groups.&lt;SEP&gt;Ki‑67 is a cellular proliferation marker evaluated by immunohistochemistry in mammary gland studies of APIDRA.</data>
  <data key="d3">chunk-ee2684edaea64aa597fd29c3bbda611d&lt;SEP&gt;chunk-50719bcc88f4515ec825b9d5a7aba107</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315490</data>
  <data key="d6"></data>
</node>
<node id="Immunohistochemistry">
  <data key="d0">Immunohistochemistry</data>
  <data key="d1">method</data>
  <data key="d2">Immunohistochemistry is a laboratory technique used to detect Ki‑67 expression in mammary tissue of rats treated with APIDRA.</data>
  <data key="d3">chunk-ee2684edaea64aa597fd29c3bbda611d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Glucose Infusion Rate (VIG)">
  <data key="d0">Glucose Infusion Rate (VIG)</data>
  <data key="d1">data</data>
  <data key="d2">Glucose infusion rate (VIG) is a metric used to assess insulin activity following subcutaneous dosing.&lt;SEP&gt;Glucose infusion rate (VIG) values were measured after SC dosing of APIDRA, insulin lispro, or regular human insulin in an obese population.</data>
  <data key="d3">chunk-ee2684edaea64aa597fd29c3bbda611d&lt;SEP&gt;chunk-50719bcc88f4515ec825b9d5a7aba107</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Apidra Solostar">
  <data key="d0">Apidra Solostar</data>
  <data key="d1">artifact</data>
  <data key="d2">Apidra Solostar is a recombinant human insulin analog medication presented in a pen that requires specific storage, handling, and subcutaneous administration.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Insulin Human Recombinant Analog">
  <data key="d0">Insulin Human Recombinant Analog</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Human Recombinant Analog describes the class of insulin to which Apidra Solostar belongs, being equipotent to regular human insulin.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Pre-Meal Timing">
  <data key="d0">Pre-Meal Timing</data>
  <data key="d1">method</data>
  <data key="d2">Pre-Meal Timing specifies that Apidra Solostar should be injected up to 15 minutes before or immediately after a meal.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Injection Site Abdomen">
  <data key="d0">Injection Site Abdomen</data>
  <data key="d1">concept</data>
  <data key="d2">Injection Site Abdomen is one of the recommended body locations for subcutaneous injection of Apidra Solostar.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Injection Site Thigh">
  <data key="d0">Injection Site Thigh</data>
  <data key="d1">concept</data>
  <data key="d2">Injection Site Thigh is another recommended body location for subcutaneous injection of Apidra Solostar.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Injection Site Deltoid">
  <data key="d0">Injection Site Deltoid</data>
  <data key="d1">concept</data>
  <data key="d2">Injection Site Deltoid is a third recommended body location for subcutaneous injection of Apidra Solostar.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Amyloid Cutaneous Localized">
  <data key="d0">Amyloid Cutaneous Localized</data>
  <data key="d1">concept</data>
  <data key="d2">Amyloid Cutaneous Localized is a localized skin condition contraindicated for Apidra Solostar injection sites.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Twenty-Eight Day Use Period">
  <data key="d0">Twenty-Eight Day Use Period</data>
  <data key="d1">data</data>
  <data key="d2">Twenty-Eight Day Use Period indicates that an opened Apidra Solostar pen remains usable for up to 28 days (4 weeks).</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Twenty-Four Month Shelf Life">
  <data key="d0">Twenty-Four Month Shelf Life</data>
  <data key="d1">data</data>
  <data key="d2">Twenty-Four Month Shelf Life denotes the overall shelf life of Apidra Solostar, which is 24 months from the date of manufacture.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315491</data>
  <data key="d6"></data>
</node>
<node id="Four-To-Six Mm Needle">
  <data key="d0">Four-To-Six Mm Needle</data>
  <data key="d1">artifact</data>
  <data key="d2">Four-To-Six Mm Needle is a needle size compatible with the Apidra Solostar pen for insulin injection.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315492</data>
  <data key="d6"></data>
</node>
<node id="Apidra Manual">
  <data key="d0">Apidra Manual</data>
  <data key="d1">content</data>
  <data key="d2">Apidra Manual is the instructional document that provides detailed guidance on storage, dosing, and administration of Apidra Solostar.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315492</data>
  <data key="d6"></data>
</node>
<node id="Laboratory Examinations">
  <data key="d0">Laboratory Examinations</data>
  <data key="d1">concept</data>
  <data key="d2">Laboratory Examinations are medical tests whose results can be interfered with by insulin glulisine.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315492</data>
  <data key="d6"></data>
</node>
<node id="Freezer Prohibition">
  <data key="d0">Freezer Prohibition</data>
  <data key="d1">concept</data>
  <data key="d2">Freezer Prohibition indicates that Apidra Solostar must not be stored in a freezer or frozen.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315492</data>
  <data key="d6"></data>
</node>
<node id="Mixing Prohibition">
  <data key="d0">Mixing Prohibition</data>
  <data key="d1">concept</data>
  <data key="d2">Mixing Prohibition states that Apidra Solostar must not be mixed with any other insulin.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315492</data>
  <data key="d6"></data>
</node>
<node id="Clear Solution Requirement">
  <data key="d0">Clear Solution Requirement</data>
  <data key="d1">concept</data>
  <data key="d2">Clear Solution Requirement mandates that Apidra Solostar solution must be clear, colorless, and free of visible particles before use.</data>
  <data key="d3">chunk-2dc2313c92b2af4132faaa4d41449eef</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315492</data>
  <data key="d6"></data>
</node>
<node id="Obese Non-diabetic Population">
  <data key="d0">Obese Non-diabetic Population</data>
  <data key="d1">concept</data>
  <data key="d2">Obese Non-diabetic Population designates individuals with obesity but without diabetes, in whom APIDRA’s rapid onset was maintained.</data>
  <data key="d3">chunk-50719bcc88f4515ec825b9d5a7aba107</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315492</data>
  <data key="d6"></data>
</node>
<node id="In vitro Chromosomal Aberration Test">
  <data key="d0">In vitro Chromosomal Aberration Test</data>
  <data key="d1">method</data>
  <data key="d2">In vitro Chromosomal Aberration Test assesses chromosome damage; APIDRA tested negative for mutagenicity.</data>
  <data key="d3">chunk-50719bcc88f4515ec825b9d5a7aba107</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315493</data>
  <data key="d6"></data>
</node>
<node id="Mammary Gland Tumors">
  <data key="d0">Mammary Gland Tumors</data>
  <data key="d1">concept</data>
  <data key="d2">Mammary Gland Tumors are breast tumors observed at a higher, non‑dose‑dependent incidence in APIDRA‑treated Sprague Dawley rats.</data>
  <data key="d3">chunk-50719bcc88f4515ec825b9d5a7aba107</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315493</data>
  <data key="d6"></data>
</node>
<node id="Figure 3">
  <data key="d0">Figure 3</data>
  <data key="d1">content</data>
  <data key="d2">Figure 3 presents glucose infusion rate (VIG) data after subcutaneous administration of APIDRA, insulin lispro, and insulin regular in an obese population.&lt;SEP&gt;Figure 3 displays adjusted glucose profiles during continuous subcutaneous insulin infusion for patients on Fiasp® and NovoRapid®.&lt;SEP&gt;Figure 3 is a graph showing glucose values obtained by a sensor, sourced from the FreeStyle Libre system.</data>
  <data key="d3">chunk-50719bcc88f4515ec825b9d5a7aba107&lt;SEP&gt;chunk-1bb9ea85b9ad8cd6940ae41a3ab5d1fd&lt;SEP&gt;chunk-94150b57cc35a773b7c36f33f237f8a1</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_fiasp.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/cgm.pdf</data>
  <data key="d5">1786335244</data>
  <data key="d6"></data>
</node>
<node id="Deltoid Muscle">
  <data key="d0">Deltoid Muscle</data>
  <data key="d1">concept</data>
  <data key="d2">Deltoid Muscle is an injection site used for subcutaneous administration of APIDRA.</data>
  <data key="d3">chunk-50719bcc88f4515ec825b9d5a7aba107</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315493</data>
  <data key="d6"></data>
</node>
<node id="Thigh (Coxa)">
  <data key="d0">Thigh (Coxa)</data>
  <data key="d1">concept</data>
  <data key="d2">Thigh (Coxa) is an injection site used for subcutaneous administration of APIDRA.</data>
  <data key="d3">chunk-50719bcc88f4515ec825b9d5a7aba107</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315493</data>
  <data key="d6"></data>
</node>
<node id="Children (4+ Years)">
  <data key="d0">Children (4+ Years)</data>
  <data key="d1">concept</data>
  <data key="d2">Children aged four years or older are a pediatric population for whom APIDRA SOLOSTAR may be administered; use in younger children has not been studied.</data>
  <data key="d3">chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315493</data>
  <data key="d6"></data>
</node>
<node id="Betablockers">
  <data key="d0">Betablockers</data>
  <data key="d1">artifact</data>
  <data key="d2">Betablockers are a class of drugs that can both potentiate and weaken the hypoglycemic effect of insulin.</data>
  <data key="d3">chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315493</data>
  <data key="d6"></data>
</node>
<node id="Insulin Requirements">
  <data key="d0">Insulin Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin requirements refer to the dosage of insulin needed to maintain glycemic control, which varies with physiological states.</data>
  <data key="d3">chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315494</data>
  <data key="d6"></data>
</node>
<node id="Risk Category C in Pregnancy">
  <data key="d0">Risk Category C in Pregnancy</data>
  <data key="d1">concept</data>
  <data key="d2">Risk Category C indicates that animal studies have shown adverse effects on the fetus and there are no well‑controlled studies in humans; the drug should be used in pregnancy only if the potential benefit justifies the risk.</data>
  <data key="d3">chunk-f09811b149a29105854a0b1e84951e5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d5">1786315494</data>
  <data key="d6"></data>
</node>
<node id="Storage Conditions">
  <data key="d0">Storage Conditions</data>
  <data key="d1">concept</data>
  <data key="d2">Storage conditions specify that APIDRA SOLOSTAR must be kept in the original package, refrigerated between 2 °C and 8 °C, protected from light, and not frozen; discard if frozen.&lt;SEP&gt;Storage conditions specify temperature requirements for keeping Levemir® FlexPen® between 2 °C and 8 °C.</data>
  <data key="d3">chunk-f09811b149a29105854a0b1e84951e5d&lt;SEP&gt;chunk-3237e202569462c758ec3d878c9faeae</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1786317644</data>
  <data key="d6"></data>
</node>
