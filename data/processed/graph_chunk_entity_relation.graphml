<node id="Seção 9">
  <data key="d0">Seção 9</data>
  <data key="d1">concept</data>
  <data key="d2">Seção 9 is the ninth section of the medication leaflet, listing adverse reactions.</data>
  <data key="d3">chunk-759c20cc4c3fc0d3529aabc2fe7dbf99</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
