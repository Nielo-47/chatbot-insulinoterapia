  <data key="d13">1778702907</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed™ 640G" target="SmartGuard™">
  <data key="d8">4.0</data>
  <data key="d9">SmartGuard™ is a predictive feature integrated into the MiniMed™ 640G system that automatically suspends insulin infusion when low glucose levels are anticipated.&lt;SEP&gt;The MiniMed™ 640G incorporates SmartGuard™ technology to automate insulin delivery adjustments based on glucose levels.&lt;SEP&gt;The MiniMed™ 640G system incorporates the SmartGuard™ feature to predict low glucose events and automatically suspend insulin delivery.&lt;SEP&gt;SmartGuard™ is a built-in feature of the MiniMed™ 640G insulin pump system.</data>
  <data key="d10">automated control,automated insulin control,device functionality,predictive algorithm,system integration</data>
  <data key="d11">chunk-8595240fe716dd024092310ce068d824&lt;SEP&gt;chunk-c03aab2b6261ddc73d474d0c866e7b37&lt;SEP&gt;chunk-daa5dc0d158b3af5c0f7883f98cce6d7&lt;SEP&gt;chunk-4704ed3f5177349243c84d500af612b3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702935</data>
  <data key="d14"></data>
</edge>
