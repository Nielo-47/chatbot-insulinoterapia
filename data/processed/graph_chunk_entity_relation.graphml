  <data key="d0">Macleods Letter</data>
  <data key="d1">artifact</data>
  <data key="d2">Macleod’s Letter is a piece of correspondence that arrived on 23 September 1921, indicating progress in the pancreatic extract research.</data>
  <data key="d3">chunk-047566df22e783e662966eb52799cb39</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
