  <data key="d13">1778707673</data>
  <data key="d14"></data>
</edge>
<edge source="Suspend Before Low" target="Alert On Low">
  <data key="d8">2.0</data>
  <data key="d9">The Suspend Before Low feature automatically activates Alert On Low when triggered.&lt;SEP&gt;If Suspend Before Low is enabled, the Alert on Low cannot be silenced, ensuring critical low glucose warnings remain active.</data>
  <data key="d10">activation,alert dependency,feature dependency,silencing restriction</data>
  <data key="d11">chunk-77d9c07e6a38b29ecca31e8c42df37e6&lt;SEP&gt;chunk-2cc4a95eb5f47fc9afc3b30fb1364490</data>
