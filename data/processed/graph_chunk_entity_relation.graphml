  <data key="d12">1786310817</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Humalog Mix 50 Kwikpen">
  <data key="d7">1.0</data>
  <data key="d8">Humalog Mix 50 Kwikpen can cause hypoglycemia, especially during activities requiring alertness such as driving.</data>
  <data key="d9">adverse effect,risk</data>
  <data key="d10">chunk-fd94288932ad6675a1de2b46b3fd9128</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310842</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Humalog Mix 50 KwikPen">
  <data key="d7">2.0</data>
  <data key="d8">Humalog Mix 50 KwikPen is contraindicated for use during episodes of hypoglycemia.&lt;SEP&gt;Humalog Mix 50 KwikPen can cause hypoglycemia as the most common adverse reaction.</data>
  <data key="d9">adverse reaction,contraindication,risk,safety</data>
  <data key="d10">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310849</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Insulin Lispro">
  <data key="d7">1.0</data>
  <data key="d8">Insulin lispro can cause hypoglycemia, which is the most common adverse reaction to insulin therapies.</data>
  <data key="d9">adverse reaction,risk</data>
  <data key="d10">chunk-a2416b3e5e8ebc96cdb451a794fc78e3</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
  <data key="d12">1786310853</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Toujeo 300/mL">
  <data key="d7">1.0</data>
  <data key="d8">The overall incidence of hypoglycemia was comparable between the Toujeo 300/mL and Insulina Glargina groups.</data>
  <data key="d9">incidence,safety</data>
  <data key="d10">chunk-7d9c944d51a42525c017d9109f46684c</data>
