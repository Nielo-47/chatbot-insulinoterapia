  <data key="d12">1786313740</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Escherichia coli">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargine is synthesized in Escherichia coli K12 cells using recombinant DNA methods.</data>
  <data key="d9">biotechnology,production</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
