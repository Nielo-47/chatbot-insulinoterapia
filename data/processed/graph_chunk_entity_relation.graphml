  <data key="d0">CGPARKIN.ORG</data>
  <data key="d1">organization</data>
  <data key="d2">CGPARKIN.ORG appears as the domain part of the provided email address, indicating an organization.</data>
  <data key="d3">chunk-8eb9f70b21125ece336902f61fde875c</data>
