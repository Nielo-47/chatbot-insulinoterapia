</node>
<node id="Collection Container">
  <data key="d0">Collection Container</data>
  <data key="d1">artifact</data>
  <data key="d2">Collection containers are resistant plastic or metal packages used to gather used needles and prevent accidents and contamination.</data>
  <data key="d3">chunk-9725072a361e9b1b97c5daa35e061e58</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
