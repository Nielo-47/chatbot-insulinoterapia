  <data key="d5">1786377338</data>
  <data key="d6"></data>
</node>
<node id="Protocols">
  <data key="d0">Protocols</data>
  <data key="d1">concept</data>
  <data key="d2">Protocols are systematic guidelines recommended for insulin preparation, prescribing, and administration safety.</data>
