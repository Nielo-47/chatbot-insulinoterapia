  <data key="d5">1786313545</data>
  <data key="d6"></data>
</node>
<node id="Dose Inadequada De Insulina">
  <data key="d0">Dose Inadequada De Insulina</data>
  <data key="d1">concept</data>
  <data key="d2">Dose inadequada de insulina describes situations where insulin doses are inadvertently increased, insufficient, or forgotten, leading to hypo- or hyperglycemic events.</data>
  <data key="d3">chunk-9cd336474a2e9457985162b1ddb4b603</data>
