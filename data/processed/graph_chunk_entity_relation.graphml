  <data key="d6"></data>
</node>
<node id="Contour">
  <data key="d0">Contour</data>
  <data key="d1">artifact</data>
  <data key="d2">Contour is a brand of blood glucose meter used for measuring blood sugar levels, associated with Ascensia Diabetes Care.&gt;</data>
  <data key="d3">chunk-f61911be532419242af177a0b5feeb72</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
