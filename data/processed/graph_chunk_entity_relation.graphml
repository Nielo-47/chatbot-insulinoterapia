<node id="Alarma De Bomba">
  <data key="d0">Alarma De Bomba</data>
  <data key="d1">concept</data>
  <data key="d2">The pump emits audible beeps and/or vibration every 15 minutes during manual suspension as a reminder.</data>
  <data key="d3">chunk-63f6eb3be969569b166fc1e5f7e7567f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
