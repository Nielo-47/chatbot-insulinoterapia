  <data key="d6"></data>
</node>
<node id="Guideline">
  <data key="d0">Guideline</data>
  <data key="d1">content</data>
  <data key="d2">The document providing criteria for diabetes diagnosis and screening issued by the Sociedade Brasileira de Diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372005</data>
  <data key="d6"></data>
</node>
<node id="Risk Of Type 1 Diabetes">
  <data key="d0">Risk Of Type 1 Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Elevated probability of developing type 1 diabetes, identified by presence of multiple autoantibodies.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372005</data>
  <data key="d6"></data>
</node>
<node id="First‑Degree Relatives">
  <data key="d0">First‑Degree Relatives</data>
  <data key="d1">concept</data>
  <data key="d2">Immediate family members of individuals with diabetes, identified as a risk factor for both type 1 and type 2 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372005</data>
  <data key="d6"></data>
</node>
<node id="Beta Cells">
  <data key="d0">Beta Cells</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pancreatic β‑cells that produce insulin and experience rapid deterioration in adolescents with type 2 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372005</data>
  <data key="d6"></data>
</node>
<node id="Research Protocols">
  <data key="d0">Research Protocols</data>
  <data key="d1">concept</data>
  <data key="d2">Structured research studies for prevention of type 1 diabetes phase 3, considered when selecting candidates during screening.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372005</data>
  <data key="d6"></data>
</node>
<node id="Immunomodulatory Medications">
  <data key="d0">Immunomodulatory Medications</data>
  <data key="d1">artifact</data>
  <data key="d2">Drugs that modify the immune response, approved for use to delay phase 3 of type 1 diabetes.&lt;SEP&gt;Immunomodulatory Medications are drugs that modify immune responses, mentioned in recommendation R18 as potential treatments approved by regulatory agencies for phase‑3 type 1 diabetes prevention.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762&lt;SEP&gt;chunk-ea6df8d05eb3fdd356a1eaef16a26dd5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372006</data>
  <data key="d6"></data>
</node>
<node id="Maternal History of DM2">
  <data key="d0">Maternal History of DM2</data>
  <data key="d1">concept</data>
  <data key="d2">A mother’s prior type 2 diabetes or gestational diabetes, included as a screening criterion for type 2 diabetes in children.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372006</data>
  <data key="d6"></data>
</node>
<node id="Second‑Degree Relatives">
  <data key="d0">Second‑Degree Relatives</data>
  <data key="d1">concept</data>
  <data key="d2">Extended family members (e.g., grandparents, aunts) of individuals with diabetes, considered a risk factor for type 2 diabetes.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372007</data>
  <data key="d6"></data>
</node>
<node id="Younger Sibling with DM2">
  <data key="d0">Younger Sibling with DM2</data>
  <data key="d1">concept</data>
  <data key="d2">A younger brother or sister diagnosed with type 2 diabetes, associated with a fourfold increased risk of glucose intolerance in overweight children.</data>
  <data key="d3">chunk-343246c2eef6e8430b581340d6cd4762</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372007</data>
  <data key="d6"></data>
</node>
<node id="Atherosclerosis Risk in Communities">
  <data key="d0">Atherosclerosis Risk in Communities</data>
  <data key="d1">event</data>
  <data key="d2">ARIC is a long‑term epidemiological study investigating the incidence of diabetes and related complications.&lt;SEP&gt;A prospective cohort (ARIC) of 11,092 participants followed for a median of 14 years, identifying increased risk of subsequent type 2 diabetes for individuals with higher HbA1c levels.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3&lt;SEP&gt;chunk-e428438c632682ef93541430ec497ed5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372007</data>
  <data key="d6"></data>
</node>
<node id="Cromatografia Líquida de Alta Eficiência">
  <data key="d0">Cromatografia Líquida de Alta Eficiência</data>
  <data key="d1">method</data>
  <data key="d2">CLAE (high‑efficiency liquid chromatography) is a laboratory technique used to analyze HbA1c.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372007</data>
  <data key="d6"></data>
</node>
<node id="HPLC">
  <data key="d0">HPLC</data>
  <data key="d1">method</data>
  <data key="d2">HPLC is a high‑performance liquid chromatography method employed for HbA1c analysis.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372007</data>
  <data key="d6"></data>
</node>
<node id="Random Plasma Glucose ≥200 mg/dl">
  <data key="d0">Random Plasma Glucose ≥200 mg/dl</data>
  <data key="d1">data</data>
  <data key="d2">Random plasma glucose of 200 mg/dL or higher is a diagnostic threshold for diabetes when symptoms are present.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372007</data>
  <data key="d6"></data>
</node>
<node id="Fasting Glucose ≥126 mg/dl">
  <data key="d0">Fasting Glucose ≥126 mg/dl</data>
  <data key="d1">data</data>
  <data key="d2">Fasting glucose of 126 mg/dL or higher is a diagnostic threshold for diabetes mellitus.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372008</data>
  <data key="d6"></data>
</node>
<node id="HbA1c ≥6.5%">
  <data key="d0">HbA1c ≥6.5%</data>
  <data key="d1">data</data>
  <data key="d2">HbA1c of 6.5 % or higher is a diagnostic threshold for diabetes mellitus.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372008</data>
  <data key="d6"></data>
</node>
<node id="TTGO-1h Cutoff 209 mg/dl">
  <data key="d0">TTGO-1h Cutoff 209 mg/dl</data>
  <data key="d1">data</data>
  <data key="d2">A TTGO‑1h value of 209 mg/dL is the recommended cutoff for diagnosing diabetes mellitus.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372008</data>
  <data key="d6"></data>
</node>
<node id="TTGO-2h Cutoff 200 mg/dl">
  <data key="d0">TTGO-2h Cutoff 200 mg/dl</data>
  <data key="d1">data</data>
  <data key="d2">A TTGO‑2h value of 200 mg/dL is the recommended cutoff for diagnosing diabetes mellitus.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372008</data>
  <data key="d6"></data>
</node>
<node id="Glicemia ao Acaso">
  <data key="d0">Glicemia ao Acaso</data>
  <data key="d1">data</data>
  <data key="d2">Random plasma glucose measured without fasting, used for diabetes diagnosis when ≥200 mg/dL with symptoms.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372008</data>
  <data key="d6"></data>
</node>
<node id="Glicemia de 1 Hora no TTGO">
  <data key="d0">Glicemia de 1 Hora no TTGO</data>
  <data key="d1">data</data>
  <data key="d2">One‑hour oral glucose tolerance test glucose value.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1786372008</data>
  <data key="d6"></data>
</node>
<node id="Glicemia de 2 Horas no TTGO">
  <data key="d0">Glicemia de 2 Horas no TTGO</data>
  <data key="d1">data</data>
  <data key="d2">Two‑hour oral glucose tolerance test glucose value.</data>
  <data key="d3">chunk-2faebf8275a86cd8d9995c769b0926a3</data>
