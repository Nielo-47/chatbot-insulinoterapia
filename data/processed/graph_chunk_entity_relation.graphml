  <data key="d15">Genetic Blood Disorders</data>
  <data key="d16">HbA1c</data>
</edge>
<edge source="HbA1c" target="Mulheres Grávidas Com Diabetes">
  <data key="d8">1.0</data>
  <data key="d9">Mulheres grávidas com diabetes devem manter níveis de HbA1c abaixo de 6,5% antes da gravidez e abaixo de 6% durante o segundo e terceiro trimestres.</data>
  <data key="d10">prenatal care, glycemic target</data>
  <data key="d11">chunk-cd6b0367ed2176146798e5cf697d0aeb</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694589</data>
  <data key="d14"></data>
  <data key="d15">HbA1c</data>
  <data key="d16">Mulheres Grávidas Com Diabetes</data>
</edge>
<edge source="HbA1c" target="Diabetes Treatment">
  <data key="d8">1.0</data>
  <data key="d9">Lowering HbA1c is a primary objective in diabetes treatment to reduce the risk of long-term complications.</data>
  <data key="d10">glucose control,treatment goal</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694573</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Diabetes Complications">
  <data key="d8">1.0</data>
  <data key="d9">Higher HbA1c levels are associated with increased risks of diabetes-related complications such as eye, kidney, nerve, and cardiovascular diseases.</data>
  <data key="d10">disease progression,risk correlation</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694574</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="GMI">
  <data key="d8">1.0</data>
  <data key="d9">GMI serves as a modern alternative to HbA1c, offering a more dynamic and real-time estimate of average glucose levels.</data>
  <data key="d10">alternative metric,glucose monitoring</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694578</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Structured Diabetes Education">
  <data key="d8">1.0</data>
  <data key="d9">Patients receiving structured diabetes education showed greater reductions in HbA1c levels compared to those in the control group.</data>
  <data key="d10">glycemic control,treatment efficacy</data>
  <data key="d11">chunk-a7740b86f0b3f110bb2c3f3d05e4da41</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695212</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Meta-Analysis">
  <data key="d8">1.0</data>
  <data key="d9">Meta-analyses demonstrated superior mean HbA1c reduction with insulin pens compared to syringes.</data>
  <data key="d10">outcome measure,treatment efficacy</data>
  <data key="d11">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d13">1778695246</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Levemir">
  <data key="d8">3.0</data>
  <data key="d9">Levemir provides glycemic control comparable to NPH insulin and insulin degludec, with HbA1c differences within a non-inferiority margin of 0.4%.&lt;SEP&gt;Levemir showed non-inferiority to insulin NPH in achieving target HbA1c levels during pregnancy.&lt;SEP&gt;In clinical studies, Levemir in combination with liraglutide led to greater reduction in HbA1c levels compared to placebo.</data>
  <data key="d10">blood glucose,clinical efficacy,glycemic control,non-inferiority,treatment efficacy</data>
  <data key="d11">chunk-9266b0855586c9a971861beb4d3289fa&lt;SEP&gt;chunk-e7e33f93b79c1061267614c8283508c6&lt;SEP&gt;chunk-302e8ebf2cacce3164fd241fd39db173</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698187</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Estudo Clínico De 26 Semanas">
  <data key="d8">1.0</data>
  <data key="d9">Changes in HbA1c levels were used as a primary efficacy measure in the 26-week clinical study to assess glycemic improvement.</data>
  <data key="d10">biomarker monitoring,efficacy measure</data>
  <data key="d11">chunk-2e2fd1844a95ab6fd4f7d89cdbddbc58</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698225</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Levemir® FlexPen®">
  <data key="d8">1.0</data>
  <data key="d9">The efficacy of Levemir® FlexPen® in managing diabetes is evaluated by changes in HbA1c levels in clinical studies.</data>
  <data key="d10">glycemic monitoring,treatment outcome</data>
  <data key="d11">chunk-975d0ad130a42cf2fe8a0f91e4da2b29</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d13">1778698262</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Insulina Humana">
  <data key="d8">1.0</data>
  <data key="d9">The effectiveness of human insulin in managing diabetes is evaluated by changes in HbA1c levels.</data>
  <data key="d10">clinical monitoring,glycemic control</data>
  <data key="d11">chunk-e53353cd9fcafe8d9581b3d0e7980b50</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699040</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Estudo Clínico">
  <data key="d8">1.0</data>
  <data key="d9">A HbA1c foi utilizada como parâmetro para avaliar o controle glicêmico após seis meses de tratamento nos estudos clínicos.</data>
  <data key="d10">clinical endpoint,glycemic monitoring</data>
  <data key="d11">chunk-b1d9cc89371adea01fc1a946ca6d1690</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d13">1778699163</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Glycemic Control">
  <data key="d8">1.0</data>
  <data key="d9">HbA1c represents long-term glycemic control and is a standard metric in diabetes management.</data>
  <data key="d10">chronic assessment,monitoring metric</data>
  <data key="d11">chunk-3a1c7be3f5278cc80c8bc958c35be31c</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709756</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="DCCT">
  <data key="d8">1.0</data>
  <data key="d9">The DCCT established a direct relationship between HbA1c levels and microvascular complications in diabetes.</data>
  <data key="d10">clinical evidence,complication correlation</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709760</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="T1D Exchange">
  <data key="d8">1.0</data>
  <data key="d9">The T1D Exchange study showed that only a minority of people with type 1 diabetes in the U.S. achieve ADA HbA1c targets.</data>
  <data key="d10">data analysis,treatment goal evaluation</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709761</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="ADA">
  <data key="d8">1.0</data>
  <data key="d9">The ADA sets HbA1c as a key target for effective diabetes intervention.</data>
  <data key="d10">clinical guideline,treatment target</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709762</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="AACE">
  <data key="d8">1.0</data>
  <data key="d9">The AACE recognizes point-of-care HbA1c testing in its clinical guidelines.</data>
  <data key="d10">clinical guideline,test validation</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709762</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="EASD">
  <data key="d8">1.0</data>
  <data key="d9">The EASD includes point-of-care HbA1c testing in its clinical guidelines.</data>
  <data key="d10">clinical guideline,test validation</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709763</data>
  <data key="d14"></data>
</edge>
<edge source="HbA1c" target="Point of Care Testing">
  <data key="d8">1.0</data>
  <data key="d9">Point of care testing allows immediate HbA1c measurement, facilitating timely clinical decisions in various medical settings.</data>
  <data key="d10">clinical decision-making,rapid assessment</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709764</data>
  <data key="d14"></data>
</edge>
<edge source="GMI" target="Glucose Sensor">
  <data key="d8">1.0</data>
  <data key="d9">GMI is calculated using data from glucose sensors, providing an estimated average glucose level independent of blood tests.</data>
  <data key="d10">data source, calculation method</data>
  <data key="d11">chunk-457b20f4d8d08ee6b3ed08a225c773de</data>
  <data key="d12">data/raw/DOC Completo.docx</data>
  <data key="d13">1778694575</data>
