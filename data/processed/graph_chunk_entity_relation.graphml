<node id="Coroa Do Dedo">
  <data key="d0">Coroa Do Dedo</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Coroa Do Dedo is the lateral side of the fingertip where the lancet is advised to prick for a safer, less painful blood sample.</data>
