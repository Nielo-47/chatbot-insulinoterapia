<edge source="Insulin Therapy" target="Lipodistrofia">
  <data key="d8">1.0</data>
  <data key="d9">Lipodistrofia is an uncommon adverse effect of insulin therapy that occurs at the injection site and may impair insulin absorption.</data>
  <data key="d10">adverse effect,tissue disorder</data>
  <data key="d11">chunk-1229dbbfb74d991d522a8d53f9383cdc</data>
