<edge source="Open‑Label Controlled Clinical Trial" target="ANCOVA Model">
  <data key="d7">1.0</data>
  <data key="d8">The trial applied an ANCOVA model to adjust for treatment, country, and injection timing.</data>
  <data key="d9">method,statistical analysis</data>
