  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708386</data>
  <data key="d14"></data>
</edge>
<edge source="Insulin Pump" target="Warm Up Not Started Alert">
  <data key="d8">1.0</data>
  <data key="d9">The insulin pump generates a Warm Up Not Started Alert if the sensor fails to begin its warm-up phase.&gt;</data>
