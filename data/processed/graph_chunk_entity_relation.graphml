  <data key="d12">1786310093</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Injection Site Reactions">
  <data key="d7">2.0</data>
  <data key="d8">Insulin administration may lead to local injection site reactions such as redness, pain, itching, urticaria, swelling, and inflammation.&lt;SEP&gt;Insulin injections can cause redness, swelling, or itching at the site.</data>
  <data key="d9">adverse effect,local,local reaction,side effect</data>
  <data key="d10">chunk-d59c9bf7f429a82cbfd7083e36ff8f9a&lt;SEP&gt;chunk-06425d1f80d868bd58871b6a6e740102</data>
