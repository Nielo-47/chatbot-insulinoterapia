  <data key="d14"></data>
</edge>
<edge source="Dextrostix" target="Haemo-Glukotest">
  <data key="d8">1.0</data>
  <data key="d9">Haemo-Glukotest is an improved version of the Dextrostix glucose monitoring method.</data>
  <data key="d10">device evolution,technological advancement</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709760</data>
  <data key="d14"></data>
</edge>
<edge source="Dextrostix" target="Semipermeable Membrane">
  <data key="d8">1.0</data>
  <data key="d9">Dextrostix uses a semipermeable membrane that blocks red blood cells and allows glucose to pass for measurement.</data>
  <data key="d10">device component,selective filtration</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709762</data>
  <data key="d14"></data>
</edge>
<edge source="Dextrostix" target="Oxidase/Peroxidase Reaction">
  <data key="d8">1.0</data>
  <data key="d9">Dextrostix relies on an oxidase/peroxidase reaction to generate a color change that estimates blood glucose levels.</data>
  <data key="d10">chemical detection,colorimetric analysis</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709763</data>
  <data key="d14"></data>
</edge>
<edge source="GlucoTrack" target="Non-Invasive Glucose Sensors">
  <data key="d8">1.0</data>
  <data key="d9">GlucoTrack is a non-invasive glucose sensor that estimates blood glucose using electromagnetic and thermal properties on the earlobe.</data>
  <data key="d10">earlobe measurement,technology type</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709761</data>
  <data key="d14"></data>
</edge>
<edge source="GlucoTrack" target="Electromagnetic Technology">
  <data key="d8">1.0</data>
  <data key="d9">GlucoTrack uses electromagnetic technology to estimate blood glucose levels without blood sampling.</data>
  <data key="d10">non-invasive detection,signal measurement</data>
  <data key="d11">chunk-93fcb9633783dfd958b918dec57d02c8</data>
  <data key="d12">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d13">1778709763</data>
  <data key="d14"></data>
</edge>
<edge source="GlucoTrack" target="Heat Capacity">
  <data key="d8">1.0</data>
  <data key="d9">GlucoTrack uses heat capacity as part of its method to estimate blood glucose levels.</data>
  <data key="d10">glucose estimation,thermal analysis</data>
