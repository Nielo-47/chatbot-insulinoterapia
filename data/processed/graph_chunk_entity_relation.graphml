<node id="Convulsions">
  <data key="d0">Convulsions</data>
  <data key="d1">concept</data>
  <data key="d2">Convulsions are involuntary muscle contractions that can occur during severe hypoglycemia.</data>
  <data key="d3">chunk-1d7223c781e745e72311fccfcdd58583</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
