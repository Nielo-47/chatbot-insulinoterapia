<node id="Temperature Range up to 30°C">
  <data key="d0">Temperature Range up to 30°C</data>
  <data key="d1">data</data>
  <data key="d2">Temperature Range up to 30°C defines the safe ambient temperature for storing SoloStar after removal from refrigeration for up to 28 days.&lt;SEP&gt;Temperature Range up to 30°C specifies the maximum ambient temperature allowed for an opened Apidra Solostar pen.</data>
  <data key="d3">chunk-ffe095bda1b787c5b5ae2d61a2f74c98&lt;SEP&gt;chunk-2dc2313c92b2af4132faaa4d41449eef</data>
