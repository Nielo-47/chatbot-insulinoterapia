  <data key="d13"></data>
</edge>
<edge source="Insulina Humana" target="Mutagênese">
  <data key="d7">2.0</data>
  <data key="d8">Human insulin has been discussed as having a possible mutagenic risk.&lt;SEP&gt;Insulina humana showed no mutagenic activity in genetic toxicity assays.</data>
  <data key="d9">mutagenesis,non-mutagenic,potential risk,safety</data>
  <data key="d10">chunk-a247846b9ec5d44d0bcbe6c5f15599f8&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
