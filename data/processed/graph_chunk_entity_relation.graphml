  <data key="d0">Espessura da Pele</data>
  <data key="d1">concept</data>
  <data key="d2">Espessura da Pele denotes the skin thickness measured at various injection sites.</data>
  <data key="d3">chunk-b64741e11a7d852f462b1269fabfbe43</data>
