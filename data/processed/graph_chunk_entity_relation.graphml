</edge>
<edge source="Insulina" target="Aminoácidos">
  <data key="d8">1.0</data>
  <data key="d9">A insulina facilita o transporte intracelular de aminoácidos, contribuindo para o anabolismo proteico.</data>
  <data key="d10">cellular uptake,protein metabolism</data>
  <data key="d11">chunk-49e5674b4a4db2a056560132addcc354</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d13">1778699727</data>
  <data key="d14"></data>
</edge>
<edge source="Insulina" target="Glicogênio">
  <data key="d8">1.0</data>
  <data key="d9">A insulina promove a conversão de glicose em glicogênio no fígado para armazenamento.</data>
  <data key="d10">carbohydrate storage,glycogenesis</data>
