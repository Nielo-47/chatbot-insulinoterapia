<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Prevalência de DM2 nos EUA 2001‑2009">
  <data key="d7">1.0</data>
  <data key="d8">U.S. data show a 30.5 % increase in youth type 2 diabetes prevalence between 2001 and 2009.</data>
  <data key="d9">prevalence,trend</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
