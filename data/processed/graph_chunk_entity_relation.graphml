  <data key="d13">1778699644</data>
  <data key="d14"></data>
</edge>
<edge source="Humulin R" target="Drug Interactions">
  <data key="d8">1.0</data>
  <data key="d9">The use of other medications alongside Humulin R can increase or decrease insulin requirements.</data>
  <data key="d10">dosage change,pharmacological interaction</data>
  <data key="d11">chunk-128e097e2326548df575159ee000923b</data>
