<edge source="A1C" target="APIDRA">
  <data key="d7">3.0</data>
  <data key="d8">APIDRA treatment led to significant reductions in A1C compared with baseline across all regimens.&lt;SEP&gt;APIDRA treatment led to a significant decrease in A1C levels relative to the baseline phase in both studies.&lt;SEP&gt;APIDRA treatment was associated with a decrease in A1C values without an increase in basal insulin dose.</data>
  <data key="d9">efficacy,glycemic control,outcome,reduction</data>
  <data key="d10">chunk-29710f08f3e10bba4a464e8b4da1917c&lt;SEP&gt;chunk-3f0b85829c02f82470489f3f5e487996&lt;SEP&gt;chunk-b18f8ab53481bf1b63fda1bb71fe80ec</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315553</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="APIDRA Diabetes Tipo 1 Study">
  <data key="d7">1.0</data>
  <data key="d8">A1C is used as a primary efficacy endpoint in the study.</data>
  <data key="d9">efficacy endpoint,measures</data>
  <data key="d10">chunk-fb620bf44b37187faceacd0405c4a819</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315584</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Continuous Glucose Monitoring Devices">
  <data key="d7">1.0</data>
  <data key="d8">Early initiation of continuous glucose monitoring in youth with type 1 diabetes has been shown to decrease A1C levels.</data>
  <data key="d9">outcome improvement,reduction</data>
  <data key="d10">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1786336037</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Structured Blood Glucose Monitoring">
  <data key="d7">1.0</data>
  <data key="d8">Structured BGM reduced A1C by 0.3% more than the control group in a year‑long study.</data>
  <data key="d9">intervention,outcome</data>
  <data key="d10">chunk-40c2c862887db201b07c741a1862dcc1</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
