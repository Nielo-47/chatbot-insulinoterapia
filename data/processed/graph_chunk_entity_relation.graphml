  <data key="d5">1786335872</data>
  <data key="d6"></data>
</node>
<node id="School Nurses">
  <data key="d0">School Nurses</data>
  <data key="d1">person</data>
  <data key="d2">School nurses are health professionals responsible for diabetes care in school settings and must stay up‑to‑date on diabetes technologies.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335872</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Medical Management Plan">
  <data key="d0">Diabetes Medical Management Plan</data>
  <data key="d1">artifact</data>
  <data key="d2">The Diabetes Medical Management Plan (DMMP) is a documented plan that outlines device use instructions and backup strategies for students with diabetes.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335873</data>
  <data key="d6"></data>
</node>
<node id="Backup Plan">
  <data key="d0">Backup Plan</data>
  <data key="d1">artifact</data>
  <data key="d2">A backup plan is a contingency component of the DMMP that specifies alternative devices such as BGM, CGM, or insulin delivery devices in case of failure.&lt;SEP&gt;A contingency strategy for users of DIY closed‑loop systems in case of pump failure.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78&lt;SEP&gt;chunk-5227749196a4c9226dba64a500d84b3a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335873</data>
  <data key="d6"></data>
</node>
<node id="Blood Glucose Monitoring Devices">
  <data key="d0">Blood Glucose Monitoring Devices</data>
  <data key="d1">artifact</data>
  <data key="d2">Blood glucose monitoring (BGM) devices are tools that measure glucose levels and are recommended for people with diabetes.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335873</data>
  <data key="d6"></data>
</node>
<node id="Continuous Glucose Monitoring Devices">
  <data key="d0">Continuous Glucose Monitoring Devices</data>
  <data key="d1">artifact</data>
  <data key="d2">Continuous glucose monitoring (CGM) devices provide real‑time glucose data and are considered early in insulin‑requiring diabetes management.&lt;SEP&gt;Continuous glucose monitoring devices are systems that provide real‑time or scanned glucose data to aid diabetes management.&lt;SEP&gt;Continuous glucose monitoring devices are sensors that provide real‑time glucose readings.&lt;SEP&gt;Devices that provide continuous glucose measurements for diabetes management.</data>
  <data key="d3">chunk-4b355007bba178588f3928b6c8620a78&lt;SEP&gt;chunk-00f6c2252dc945e977b3a2b2f495ffe0&lt;SEP&gt;chunk-05cc642337c2a615c9b40de9336aec18&lt;SEP&gt;chunk-c5c8fa42a8437c5708b04fb4ad1272cf</data>
