<node id="Checked Luggage">
  <data key="d0">Checked Luggage</data>
  <data key="d1">artifact</data>
  <data key="d2">Checked luggage is unsuitable for storing insulin due to potential exposure to extreme temperatures that can reduce insulin effectiveness.</data>
