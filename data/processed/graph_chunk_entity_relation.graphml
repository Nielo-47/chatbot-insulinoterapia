  <data key="d0">Observed Severe Hypoglycemia Rate</data>
  <data key="d1">concept</data>
  <data key="d2">Observed Severe Hypoglycemia Rate is the percentage of patients experiencing severe hypoglycemia per patient‑year, reported in the 18‑week study.</data>
  <data key="d3">chunk-9f85d0ab4cfadc905544cb9e30752dab</data>
