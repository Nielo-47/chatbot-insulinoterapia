<node id="Captação Periférica de Glicose">
  <data key="d0">Captação Periférica de Glicose</data>
  <data key="d1">concept</data>
  <data key="d2">Captação periférica de glicose describes the uptake of glucose by skeletal muscle and adipose tissue stimulated by insulin.</data>
  <data key="d3">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
