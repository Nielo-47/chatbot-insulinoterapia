  <data key="d5">1786338268</data>
  <data key="d6"></data>
</node>
<node id="Jejum">
  <data key="d0">Jejum</data>
  <data key="d1">concept</data>
  <data key="d2">Jejum denotes the fasting measurement condition for blood glucose.&lt;SEP&gt;Jejum is the fasting glucose target range included in the metas glicêmicas.&lt;SEP&gt;Fasting state used as a reference point for glucose measurement targets.</data>
  <data key="d3">chunk-2dff1c37dd504c2e0f6d3e3541019e15&lt;SEP&gt;chunk-7823719c01e7c914b4a58a1bb0d707bd&lt;SEP&gt;chunk-5dce7a759a9de18a4d1bcc77a071fbe2</data>
