</node>
<node id="Ketone Test">
  <data key="d0">Ketone Test</data>
  <data key="d1">method</data>
  <data key="d2">A Ketone Test is used to check for the presence of ketones in the blood or urine, especially when blood glucose levels exceed 240 mg/dL.&lt;SEP&gt;A ketone test is performed when blood glucose exceeds 240 mg/dL during a rising trend to check for diabetic ketoacidosis risk.</data>
  <data key="d3">chunk-cfc5f5eb70e79d2ce44b3ba795b76b3e&lt;SEP&gt;chunk-cf172904e354a6f4cca233304bf69b51</data>
