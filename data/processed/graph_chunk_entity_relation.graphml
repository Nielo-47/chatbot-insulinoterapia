  <data key="d0">Zidovudina</data>
  <data key="d1">artifact</data>
  <data key="d2">Zidovudina is a reverse transcriptase inhibitor used in HIV treatment associated with lipodystrophy.</data>
  <data key="d3">chunk-fee32f1fb0c848b0799071a86119b142</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
