  <data key="d5">1786332083</data>
  <data key="d6"></data>
</node>
<node id="Thirty-Fourth Annual Meeting of the American Physiological Society">
  <data key="d0">Thirty-Fourth Annual Meeting of the American Physiological Society</data>
  <data key="d1">event</data>
  <data key="d2">The thirty‑fourth annual meeting of the American Physiological Society was held in New Haven from 28 to 30 December 1921.</data>
  <data key="d3">chunk-247d0735bf59962683d382203243d395</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332083</data>
  <data key="d6"></data>
</node>
<node id="Pancreas Removal from Dog #35">
  <data key="d0">Pancreas Removal from Dog #35</data>
  <data key="d1">event</data>
  <data key="d2">On 8 December 1921 Frederick G. Banting and Charles H. Best removed the pancreas from Dog #35 to prepare extract.</data>
  <data key="d3">chunk-247d0735bf59962683d382203243d395</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332083</data>
  <data key="d6"></data>
</node>
<node id="Extract Injection into Dog #35">
  <data key="d0">Extract Injection into Dog #35</data>
  <data key="d1">event</data>
  <data key="d2">On 11 December 1921 Dog #35 received an injection of its own pancreatic extract, lowering its blood sugar.</data>
  <data key="d3">chunk-247d0735bf59962683d382203243d395</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332083</data>
  <data key="d6"></data>
</node>
<node id="Collip Invitation to Research Team">
  <data key="d0">Collip Invitation to Research Team</data>
  <data key="d1">event</data>
  <data key="d2">On 12 December 1921 J. J. R. Macleod formally invited James Bertram Collip to join the pancreatic extract research team.</data>
  <data key="d3">chunk-247d0735bf59962683d382203243d395</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332083</data>
  <data key="d6"></data>
</node>
<node id="Attempted Treatment of Joseph Gilchrist">
  <data key="d0">Attempted Treatment of Joseph Gilchrist</data>
  <data key="d1">event</data>
  <data key="d2">On 21 December 1921 Banting and Best administered pancreatic extract via stomach tube to Dr. Joseph Gilchrist, with no observable effect.</data>
  <data key="d3">chunk-247d0735bf59962683d382203243d395</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1786332083</data>
  <data key="d6"></data>
</node>
<node id="The Beneficial Influences of Certain Pancreatic Extracts on Pancreatic Diabetes">
  <data key="d0">The Beneficial Influences of Certain Pancreatic Extracts on Pancreatic Diabetes</data>
  <data key="d1">content</data>
  <data key="d2">The Beneficial Influences of Certain Pancreatic Extracts on Pancreatic Diabetes is the title of the paper presented at the American Physiological Society meeting describing the effects of pancreatic extracts on diabetes.</data>
  <data key="d3">chunk-247d0735bf59962683d382203243d395</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
