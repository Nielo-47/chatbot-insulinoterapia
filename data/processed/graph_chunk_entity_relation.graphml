<node id="Confusion">
  <data key="d0">Confusion</data>
  <data key="d1">concept</data>
  <data key="d2">Confusion is a symptom of hypoglycemia involving impaired mental clarity.&lt;SEP&gt;Confusion is a cognitive symptom associated with hypoglycemia.</data>
