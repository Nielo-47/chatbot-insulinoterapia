</node>
<node id="Lugar De Infusión">
  <data key="d0">Lugar De Infusión</data>
  <data key="d1">location</data>
  <data key="d2">Lugar de infusión is the site on the body where insulin is delivered via pump, which should be changed regularly to ensure proper delivery.</data>
  <data key="d3">chunk-191c82775d35bbc705205ed493c43c7d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d5">1778700919</data>
