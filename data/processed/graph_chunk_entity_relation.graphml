  <data key="d5">1778704180</data>
  <data key="d6"></data>
</node>
<node id="Indice Basal Temporal">
  <data key="d0">Indice Basal Temporal</data>
  <data key="d1">method</data>
  <data key="d2">Indice basal temporal is a function that allows temporary adjustment of basal insulin rates for a defined period, often used during exercise or illness.</data>
