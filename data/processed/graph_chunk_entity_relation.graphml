<node id="tR-SMCG">
  <data key="d0">tR-SMCG</data>
  <data key="d1">data</data>
  <data key="d2">tR‑SMCG (real‑time SMCG) provides continuous interstitial glucose readings displayed instantly to the patient via a receiver or insulin pump.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
