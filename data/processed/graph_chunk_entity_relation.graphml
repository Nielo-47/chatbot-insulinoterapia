  <data key="d14"></data>
</edge>
<edge source="Infusion Set" target="Warning">
  <data key="d8">1.0</data>
  <data key="d9">Warnings specify that the Infusion Set must be disconnected from the body before pump rewinding or reservoir insertion to prevent accidental insulin infusion.</data>
