  <data key="d12">1786377718</data>
  <data key="d13"></data>
</edge>
<edge source="Two-Step Screening Strategy" target="Economic Evaluations of GDM Screening">
  <data key="d7">1.0</data>
  <data key="d8">The two‑step method identifies fewer cases compared with the one‑step approach.</data>
  <data key="d9">case detection,cost‑effectiveness</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377719</data>
  <data key="d13"></data>
</edge>
<edge source="Two-Step Screening Strategy" target="1‑hour 50‑g GLT">
  <data key="d7">1.0</data>
  <data key="d8">The two‑step approach begins with a 1‑hour 50‑g glucose load test.</data>
  <data key="d9">component,uses</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377720</data>
  <data key="d13"></data>
</edge>
<edge source="Two-Step Screening Strategy" target="3‑hour 100‑g OGTT">
  <data key="d7">1.0</data>
  <data key="d8">If the GLT is positive, the strategy proceeds to a 3‑hour 100‑g OGTT.</data>
  <data key="d9">component,uses</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377721</data>
  <data key="d13"></data>
</edge>
<edge source="1‑hour 50‑g GLT" target="American College of Obstetricians and Gynecologists (ACOG)">
  <data key="d7">1.0</data>
  <data key="d8">ACOG recommends using 130, 135, or 140 mg/dL thresholds for the 1‑hour 50‑g GLT.</data>
  <data key="d9">diagnostic threshold,recommendation</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
