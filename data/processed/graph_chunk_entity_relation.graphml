<node id="Common Trash">
  <data key="d0">Common Trash</data>
  <data key="d1">artifact</data>
  <data key="d2">Common Trash is the regular waste container that used needles must not be disposed into.</data>
  <data key="d3">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
