</edge>
<edge source="Insulin Storage" target="In-Use Disposable Insulin Pen">
  <data key="d8">1.0</data>
  <data key="d9">An in-use disposable insulin pen can be stored refrigerated or at room temperature and remains effective for 4 to 8 weeks after opening.</data>
  <data key="d10">storage conditions,usage period</data>
  <data key="d11">chunk-11ac81b4dee4dbb3636b8dc2403e0661</data>
