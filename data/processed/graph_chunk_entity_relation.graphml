  <data key="d0">Glucose Readings</data>
  <data key="d1">data</data>
  <data key="d2">Glucose readings are the numerical results obtained from glucose monitoring devices.</data>
  <data key="d3">chunk-00f6c2252dc945e977b3a2b2f495ffe0</data>
