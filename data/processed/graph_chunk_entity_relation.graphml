  <data key="d14"></data>
</edge>
<edge source="Health Care Provider" target="Blood Glucose Targets">
  <data key="d8">1.0</data>
  <data key="d9">The health care provider may adjust blood glucose targets to prevent hypoglycemia.</data>
  <data key="d10">personalized care,treatment adjustment</data>
