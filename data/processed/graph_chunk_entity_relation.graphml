  <data key="d5">1786329581</data>
  <data key="d6"></data>
</node>
<node id="Max Basal Error Alert">
  <data key="d0">Max Basal Error Alert</data>
  <data key="d1">concept</data>
  <data key="d2">Max Basal Error Alert notifies the user that the attempted Max Basal setting is lower than an existing basal rate, which is not permitted.&lt;SEP&gt;An alert indicating an error with the max basal setting.</data>
  <data key="d3">chunk-db8e2f5011e0e0fe7dc11273e2f345b9&lt;SEP&gt;chunk-59d8fcf807f0beb090b2f3d68cc7c168</data>
