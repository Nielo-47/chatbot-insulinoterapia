  <data key="d10">correction dosing,glucose regulation</data>
  <data key="d11">chunk-3bf188253bd9d2142b4fcf627eacc2b8</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778702778</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Level" target="Basal Rate">
  <data key="d8">1.0</data>
  <data key="d9">The Basal Rate is considered correct when Blood Glucose Level remains within the target range before meals, at bedtime, during the night, and upon waking.</data>
