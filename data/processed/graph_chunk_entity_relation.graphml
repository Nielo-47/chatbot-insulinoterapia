</edge>
<edge source="Insulina Activa" target="Sistema MiniMed ™ 640G">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed™ 640G displays active insulin to prevent overdosing when calculating new bolus doses.</data>
  <data key="d10">insulin tracking,safety mechanism</data>
  <data key="d11">chunk-8ecb158d437bb3657976e38d9b2e33dd</data>
