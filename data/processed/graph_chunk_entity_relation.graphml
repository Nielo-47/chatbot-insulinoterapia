<node id="Insulin Timing">
  <data key="d0">Insulin Timing</data>
  <data key="d1">concept</data>
  <data key="d2">Practice of scheduling insulin administration to align with meals and glucose levels.</data>
  <data key="d3">chunk-5bd45744c4c50bb97abce1352018de47</data>
