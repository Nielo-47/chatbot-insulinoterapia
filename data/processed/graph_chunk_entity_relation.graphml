<edge source="A1C Assay" target="Hemoglobin Variant">
  <data key="d7">1.0</data>
  <data key="d8">Hemoglobin variants can interfere with the accuracy of A1C assays.</data>
  <data key="d9">assay reliability,interference</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377543</data>
  <data key="d13"></data>
</edge>
<edge source="A1C Assay" target="HbS Variant">
  <data key="d7">1.0</data>
  <data key="d8">The HbS variant lowers A1C values by about 0.3% compared with individuals without the trait.</data>
  <data key="d9">bias,lowering effect</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377545</data>
  <data key="d13"></data>
</edge>
<edge source="A1C Assay" target="Glucose-6-Phosphate Dehydrogenase G202A">
  <data key="d7">1.0</data>
  <data key="d8">The G202A variant is associated with a decrease in A1C of about 0.8% in homozygous men and 0.7% in homozygous women.</data>
  <data key="d9">bias,lowering effect</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377546</data>
  <data key="d13"></data>
</edge>
<edge source="A1C Assay" target="Afro-Caribbean People">
  <data key="d7">1.0</data>
  <data key="d8">Afro‑Caribbean people demonstrated lower A1C than predicted by glucose levels.</data>
  <data key="d9">lower observed values</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1786377547</data>
  <data key="d13"></data>
</edge>
<edge source="A1C Assay" target="Taiwanese Population">
  <data key="d7">1.0</data>
  <data key="d8">In the Taiwanese population, age and sex are associated with increased A1C in men.</data>
  <data key="d9">association,demographic factors</data>
  <data key="d10">chunk-d01033177672e6c36e0a368db88e586d</data>
