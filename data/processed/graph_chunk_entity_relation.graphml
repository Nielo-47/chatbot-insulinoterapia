<edge source="Overweight" target="Screening">
  <data key="d7">1.0</data>
  <data key="d8">Adults who are overweight are recommended to undergo diabetes screening.</data>
  <data key="d9">risk factor,screening criteria</data>
  <data key="d10">chunk-55e58732610596ce9a8f3145d34f75a7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
