  <data key="d0">Alteração Do Processo De Fabricação</data>
  <data key="d1">event</data>
  <data key="d2">This event refers to a change in the manufacturing process of Levemir® approved on 30/09/2013 after submission on 03/05/2011.</data>
  <data key="d3">chunk-bad7b7e8e5212b6d7ea0f4b0505f82c0</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698110</data>
