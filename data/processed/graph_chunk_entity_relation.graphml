  <data key="d0">Pump Alarm</data>
  <data key="d1">concept</data>
  <data key="d2">Pump Alarm is the audible or visual signal produced by the pump during a suspend event.</data>
  <data key="d3">chunk-d3b794ead59ea83de139af0358a0e7b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329645</data>
  <data key="d6"></data>
</node>
<node id="Suspend Before Low Event">
  <data key="d0">Suspend Before Low Event</data>
  <data key="d1">event</data>
  <data key="d2">Suspend Before Low Event is the occurrence when insulin delivery is suspended because SG meets low‑limit criteria.</data>
  <data key="d3">chunk-d3b794ead59ea83de139af0358a0e7b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329645</data>
  <data key="d6"></data>
</node>
<node id="Suspend On Low Event">
  <data key="d0">Suspend On Low Event</data>
  <data key="d1">event</data>
  <data key="d2">Suspend On Low Event is the occurrence when insulin delivery is suspended because SG reaches or falls below the low limit.</data>
  <data key="d3">chunk-d3b794ead59ea83de139af0358a0e7b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329645</data>
  <data key="d6"></data>
</node>
<node id="Training">
  <data key="d0">Training</data>
  <data key="d1">method</data>
  <data key="d2">Training is the instructional process provided by a Healthcare Professional for proper pump usage.</data>
  <data key="d3">chunk-d3b794ead59ea83de139af0358a0e7b3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
