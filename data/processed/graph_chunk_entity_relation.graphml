  <data key="d0">NovoMix70/30</data>
  <data key="d1">artifact</data>
  <data key="d2">NovoMix70/30 is a pre-mixed insulin containing 70% NPA and 30% Aspart.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1786331418</data>
  <data key="d6"></data>
</node>
<node id="Basal Insulin Therapy">
  <data key="d0">Basal Insulin Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Basal Insulin Therapy provides a steady background level of insulin to control fasting glucose.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1786331419</data>
  <data key="d6"></data>
</node>
<node id="Prandial Insulin Therapy">
  <data key="d0">Prandial Insulin Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Prandial Insulin Therapy delivers insulin at mealtimes to manage post‑prandial glucose spikes.</data>
  <data key="d3">chunk-494fef0b8efc2c44b3b49ebf9d74b7f2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1786331419</data>
  <data key="d6"></data>
</node>
