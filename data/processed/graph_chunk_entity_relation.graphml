  <data key="d1">concept</data>
  <data key="d2">Memory function is a feature in some reusable insulin pens that can recall previously set dose amounts and timing.</data>
  <data key="d3">chunk-05cc642337c2a615c9b40de9336aec18</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335936</data>
  <data key="d6"></data>
</node>
