  <data key="d12">1786338328</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Lipo-Hipertrofia">
  <data key="d7">1.0</data>
  <data key="d8">Unpredictable insulin absorption in lipo-hipertrofia tissue can cause hypoglycemia.</data>
  <data key="d9">absorption,cause</data>
  <data key="d10">chunk-74b3171b97fd80965359afadc0af9312</data>
