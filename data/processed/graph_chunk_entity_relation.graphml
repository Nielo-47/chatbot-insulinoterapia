  <data key="d12">1786329812</data>
  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Occlusion Alarm">
  <data key="d7">2.0</data>
  <data key="d8">When an occlusion alarm occurs, the user must check the infusion set for clogs or leaks.&lt;SEP&gt;If the infusion set becomes clogged or blocked, the MiniMed 780G system triggers an occlusion alarm.</data>
  <data key="d9">alarm,alert,inspection</data>
  <data key="d10">chunk-474703bb16e6e26e009e9d433c3d3647&lt;SEP&gt;chunk-db5749bec4af1c3ea068b257c4376aaf</data>
