  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Human Insulin Receptor">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargine interacts with the human insulin receptor with affinity comparable to human insulin.</data>
  <data key="d9">pharmacodynamics,receptor binding</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d12">1786313741</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Human IGF‑1 Receptor">
  <data key="d7">2.0</data>
  <data key="d8">Therapeutic levels of insulin glargine are far below those required to occupy IGF‑1 receptors enough to trigger the mitogenic proliferative pathway.&lt;SEP&gt;Insulin glargine binds the human IGF‑1 receptor with 5‑8‑fold higher affinity than human insulin.</data>
  <data key="d9">affinity,off‑target binding,pathway activation,safety</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d12">1786313742</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Glucose Metabolism">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargine lowers blood glucose by enhancing peripheral uptake and inhibiting hepatic production.</data>
  <data key="d9">glucose homeostasis,metabolic regulation</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d12">1786313743</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Metabolite M1">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargine is metabolized in the body to produce the active metabolite M1.</data>
  <data key="d9">conversion,metabolism</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d12">1786313744</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Glargine" target="Metabolite M2">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glargine is metabolized in the body to produce the active metabolite M2.</data>
  <data key="d9">conversion,metabolism</data>
  <data key="d10">chunk-afc28422755c2c44f931bab7b6a2b477</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
