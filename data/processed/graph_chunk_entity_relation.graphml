<node id="6-Month Comparative Study">
  <data key="d0">6-Month Comparative Study</data>
  <data key="d1">event</data>
  <data key="d2">A six‑month clinical study compared glycemic control using the insulin lispro mixture versus two human insulin mixtures in patients with diabetes mellitus.</data>
  <data key="d3">chunk-7084240a735ca2fe3b6d426e3b8c5756</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
