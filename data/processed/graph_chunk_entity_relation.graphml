  <data key="d6"></data>
</node>
<node id="Eritropoiese">
  <data key="d0">Eritropoiese</data>
  <data key="d1">concept</data>
  <data key="d2">Increased erythropoiesis accelerates red blood cell production and can influence HbA1c measurements.</data>
