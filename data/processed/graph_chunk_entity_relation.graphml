  <data key="d1">method</data>
  <data key="d2">Autocontrol de glucemia capilar is a self‑monitoring method using a finger‑stick blood sample to confirm low glucose values.</data>
  <data key="d3">chunk-b0caf812af55afd2de9fea4fdd33fd06</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
