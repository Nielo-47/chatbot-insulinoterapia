<edge source="Quick-set" target="Quick-serter">
  <data key="d8">1.0</data>
  <data key="d9">The Quick-serter is used to insert the Quick-set infusion set into the body for insulin pump therapy.</data>
  <data key="d10">device compatibility,insertion tool</data>
  <data key="d11">chunk-ec9910e322fb247c0bf85c8b8cb3e948</data>
