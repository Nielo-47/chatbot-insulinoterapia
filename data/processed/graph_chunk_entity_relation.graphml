  <data key="d6"></data>
</node>
<node id="Section 15">
  <data key="d0">Section 15</data>
  <data key="d1">content</data>
  <data key="d2">Section 15 is the part of the document that discusses glycemic goals during pregnancy.&lt;SEP&gt;Section 15 discusses the management of diabetes in pregnancy.</data>
  <data key="d3">chunk-b275f50028ef32e322bf8643e0342810&lt;SEP&gt;chunk-aff91698679a52cd7b07563b7b2627a3</data>
