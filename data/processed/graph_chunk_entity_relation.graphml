<node id="Insulin Aspart (Novorapid®)">
  <data key="d0">Insulin Aspart (Novorapid®)</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin Aspart, marketed as NovoRapid®, is a rapid‑acting insulin analogue used for diabetes treatment, administered in relation to meals.</data>
  <data key="d3">chunk-f895f97a023b65cced82334a7f1d1e0b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
