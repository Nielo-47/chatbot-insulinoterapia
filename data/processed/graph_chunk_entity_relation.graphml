  <data key="d13"></data>
</edge>
<edge source="Apidra" target="Captação Periférica de Glicose">
  <data key="d7">1.0</data>
  <data key="d8">Apidra stimulates peripheral glucose uptake by skeletal muscle and adipose tissue, lowering blood glucose levels.</data>
  <data key="d9">stimulation</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315540</data>
  <data key="d13"></data>
</edge>
<edge source="Apidra" target="Produção Hepática de Glicose">
  <data key="d7">1.0</data>
  <data key="d8">Apidra inhibits hepatic glucose production, contributing to reduced plasma glucose concentrations.</data>
  <data key="d9">inhibition</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315541</data>
  <data key="d13"></data>
</edge>
<edge source="Apidra" target="Lipólise">
  <data key="d7">1.0</data>
  <data key="d8">Apidra inhibits lipolysis in adipocytes, decreasing free‑fatty‑acid release.</data>
  <data key="d9">inhibition</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
