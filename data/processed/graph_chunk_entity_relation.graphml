  <data key="d6"></data>
</node>
<node id="Small Intestine">
  <data key="d0">Small Intestine</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Small intestine absorbs nutrients, including glucose, from the digestive tract into the blood.&lt;SEP&gt;Small Intestine is the portion of the digestive tract where nutrients are absorbed, mentioned in the insulin therapy text.&lt;SEP&gt;Small Intestine is the digestive tract segment containing the duodenum.</data>
  <data key="d3">chunk-65c6beab51324e055f4a39b388e2eefe&lt;SEP&gt;chunk-780f90d656277126a05ed136a084fd77&lt;SEP&gt;chunk-eff48c1408719e81f1f423f76dfd19e5</data>
