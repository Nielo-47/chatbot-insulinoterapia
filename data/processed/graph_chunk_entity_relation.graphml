  <data key="d5">1786329669</data>
  <data key="d6"></data>
</node>
<node id="Bolus Types">
  <data key="d0">Bolus Types</data>
  <data key="d1">concept</data>
  <data key="d2">Bolus Types refer to the different bolus delivery options (Normal, Square Wave™, Dual Wave™) available in the pump.</data>
