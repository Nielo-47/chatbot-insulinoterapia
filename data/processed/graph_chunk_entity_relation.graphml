  <data key="d0">Carcinogenicidade</data>
  <data key="d1">concept</data>
  <data key="d2">Carcinogenicidade describes the two‑year cancer studies of insulin glargina in rats and mice, which showed no risk for humans.</data>
  <data key="d3">chunk-d99841fd6d1e1fbf23f184e202bc760e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313636</data>
