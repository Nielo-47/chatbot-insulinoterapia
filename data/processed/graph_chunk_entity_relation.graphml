  <data key="d0">Bagsvaerd</data>
  <data key="d1">location</data>
  <data key="d2">Bagsvaerd is a location in Denmark where Novo Nordisk A/S manufactures Levemir® FlexPen®.</data>
  <data key="d3">chunk-6ca90008a805c9c66eac7ba65db90fdb</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf</data>
  <data key="d5">1778698103</data>
