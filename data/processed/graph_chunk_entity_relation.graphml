  <data key="d14"></data>
</edge>
<edge source="Basal 1" target="Total 24 Hr">
  <data key="d8">3.0</data>
  <data key="d9">The Total 24 Hr value represents the sum of all insulin units delivered in a day under the Basal 1 pattern.&lt;SEP&gt;The Total 24 Hr value reflects the cumulative insulin delivered by Basal 1 over a full day, changing from 18 U to 21.6 U after adjustment.&lt;SEP&gt;The Total 24 Hr insulin dose is calculated based on the sum of all Ufh values set in the Basal 1 pattern.</data>
  <data key="d10">daily dosage,daily dosage calculation,insulin calculation,insulin delivery,insulin summation</data>
  <data key="d11">chunk-cae8b84f90a8e9c929a19f036d8f1e1c&lt;SEP&gt;chunk-be6366eda06d68d222b47729f7ca841b&lt;SEP&gt;chunk-e9947b75a4183c17b6384b798fcda161</data>
