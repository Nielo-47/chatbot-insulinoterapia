  <data key="d1">artifact</data>
  <data key="d2">An insulin-filled infusion set is a device that should not be connected to the body during training to prevent accidental insulin delivery.</data>
  <data key="d3">chunk-6f4df342459d4afd90a81b1a3f13d859</data>
