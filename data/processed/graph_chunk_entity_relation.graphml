</node>
<node id="Medical Library">
  <data key="d0">Medical Library</data>
  <data key="d1">location</data>
  <data key="d2">The medical library is a research facility where Banting and Best spent considerable time reading journal articles about diabetes and the pancreas.</data>
  <data key="d3">chunk-047566df22e783e662966eb52799cb39</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
