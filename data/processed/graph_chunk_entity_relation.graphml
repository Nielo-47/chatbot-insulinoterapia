  <data key="d13">1778709755</data>
  <data key="d14"></data>
</edge>
<edge source="Blood Glucose Level" target="Chatbot">
  <data key="d8">1.0</data>
  <data key="d9">The chatbot interprets patient phrases like "my sugar" to understand references to blood glucose levels.</data>
  <data key="d10">data interpretation,patient interaction</data>
