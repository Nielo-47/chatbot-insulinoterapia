  <data key="d0">Controlled Clinical Study</data>
  <data key="d1">data</data>
  <data key="d2">Controlled Clinical Study denotes a type of research that has not been conducted with Toujeo 300 U/mL in pregnant women.</data>
  <data key="d3">chunk-3397508bdfddde019cb1dfdcfb352435</data>
