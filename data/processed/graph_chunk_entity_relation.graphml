  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Caucasian">
  <data key="d7">1.0</data>
  <data key="d8">Caucasian individuals serve as a reference group with lower prevalence of type 2 diabetes compared to other ethnicities.</data>
  <data key="d9">ethnicity,prevalence</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
