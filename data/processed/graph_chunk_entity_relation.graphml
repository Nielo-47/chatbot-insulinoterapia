  <data key="d13">1778707976</data>
  <data key="d14"></data>
</edge>
<edge source="Startup Wizard" target="Rewinding">
  <data key="d8">1.0</data>
  <data key="d9">After date entry, a "Rewinding" message appears, indicating the pump is initializing by resetting the piston to its start position.</data>
