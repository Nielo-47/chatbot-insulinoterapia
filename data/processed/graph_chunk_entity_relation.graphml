  <data key="d0">Uncompensated Endocrine Disorders</data>
  <data key="d1">concept</data>
  <data key="d2">Uncompensated endocrine disorders are mentioned as a factor that may predispose patients to hypoglycemia.</data>
  <data key="d3">chunk-3397508bdfddde019cb1dfdcfb352435</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
