  <data key="d13"></data>
</edge>
<edge source="Diretriz da Sociedade Brasileira de Diabetes" target="Prega Subcutânea">
  <data key="d7">1.0</data>
  <data key="d8">The guideline recommends performing a prega subcutânea before needle insertion.</data>
  <data key="d9">procedure recommendation</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298866</data>
  <data key="d13"></data>
</edge>
<edge source="Diretriz da Sociedade Brasileira de Diabetes" target="Agulha de 4 mm">
  <data key="d7">1.0</data>
  <data key="d8">The guideline recommends the agulha de 4 mm as the safest needle length for all children.</data>
  <data key="d9">needle length recommendation</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298867</data>
  <data key="d13"></data>
</edge>
<edge source="Diretriz da Sociedade Brasileira de Diabetes" target="Agulha de 5 mm">
  <data key="d7">1.0</data>
  <data key="d8">The guideline notes that using an agulha de 5 mm doubles the intramuscular injection risk in children.</data>
  <data key="d9">risk information</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298867</data>
  <data key="d13"></data>
</edge>
<edge source="Diretriz da Sociedade Brasileira de Diabetes" target="Agulha de 6 mm">
  <data key="d7">1.0</data>
  <data key="d8">The guideline states that using an agulha de 6 mm triples the intramuscular injection risk in children.</data>
  <data key="d9">risk information</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298868</data>
  <data key="d13"></data>
</edge>
<edge source="Diretriz da Sociedade Brasileira de Diabetes" target="Agulha de 8 mm">
  <data key="d7">1.0</data>
  <data key="d8">The guideline warns that an agulha de 8 mm may frequently reach muscle in adults with BMI &lt; 25 kg/m².</data>
  <data key="d9">muscle penetration risk</data>
  <data key="d10">chunk-b64741e11a7d852f462b1269fabfbe43</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1786298869</data>
  <data key="d13"></data>
</edge>
