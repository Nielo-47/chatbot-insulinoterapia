  <data key="d6"></data>
</node>
<node id="IGT">
  <data key="d0">IGT</data>
  <data key="d1">concept</data>
  <data key="d2">Impaired Glucose Tolerance (IGT) is a glucose abnormality defining prediabetes.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377410</data>
  <data key="d6"></data>
</node>
<node id="Family History of Autoimmune Diabetes">
  <data key="d0">Family History of Autoimmune Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Family history of autoimmune diabetes increases risk of developing type 1 diabetes.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377411</data>
  <data key="d6"></data>
</node>
<node id="Allergic Diseases">
  <data key="d0">Allergic Diseases</data>
  <data key="d1">concept</data>
  <data key="d2">Allergic diseases are mentioned as part of family history that raises risk of autoimmune diabetes.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377411</data>
  <data key="d6"></data>
</node>
<node id="Autoimmune Diseases">
  <data key="d0">Autoimmune Diseases</data>
  <data key="d1">concept</data>
  <data key="d2">Autoimmune diseases are mentioned as part of family history that raises risk of autoimmune diabetes.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377411</data>
  <data key="d6"></data>
</node>
<node id="First-degree Relative with Diabetes">
  <data key="d0">First-degree Relative with Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Having a first-degree relative with diabetes is a risk factor for developing diabetes.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377411</data>
  <data key="d6"></data>
</node>
<node id="High-risk Race/Ethnicity">
  <data key="d0">High-risk Race/Ethnicity</data>
  <data key="d1">concept</data>
  <data key="d2">High-risk race/ethnicity (e.g., African American, Latino, Native American, Asian American, Pacific Islander) is a risk factor for diabetes.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377411</data>
  <data key="d6"></data>
</node>
<node id="Validated Risk Calculator">
  <data key="d0">Validated Risk Calculator</data>
  <data key="d1">method</data>
  <data key="d2">Validated Risk Calculator is a tool mentioned for assessing risk of prediabetes and type 2 diabetes during screening.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377411</data>
  <data key="d6"></data>
</node>
<node id="Autoantibody Positive Individuals">
  <data key="d0">Autoantibody Positive Individuals</data>
  <data key="d1">concept</data>
  <data key="d2">Autoantibody Positive Individuals are people who have tested positive for diabetes-related autoantibodies and may need counseling and further monitoring.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Counseling">
  <data key="d0">Counseling</data>
  <data key="d1">method</data>
  <data key="d2">Counseling is the provision of information and guidance about diabetes risk, symptoms, DKA prevention, and further testing for autoantibody positive individuals.</data>
  <data key="d3">chunk-2a430bf53157529ccb22e67171fb28e5</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="International Association of the Diabetes and Pregnancy Study Groups">
  <data key="d0">International Association of the Diabetes and Pregnancy Study Groups</data>
  <data key="d1">organization</data>
  <data key="d2">The International Association of the Diabetes and Pregnancy Study Groups (IADPSG) provides diagnostic criteria for gestational diabetes mellitus.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Early Abnormal Glucose Metabolism">
  <data key="d0">Early Abnormal Glucose Metabolism</data>
  <data key="d1">concept</data>
  <data key="d2">Early abnormal glucose metabolism is defined by fasting glucose &gt;110 mg/dL or A1C ≥5.9% and indicates higher risk of adverse pregnancy and neonatal outcomes.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Preconception Care">
  <data key="d0">Preconception Care</data>
  <data key="d1">concept</data>
  <data key="d2">Preconception care refers to health interventions before pregnancy that lower A1C and reduce risks such as birth defects and neonatal intensive care admission for people with preexisting diabetes.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Lifestyle Interventions">
  <data key="d0">Lifestyle Interventions</data>
  <data key="d1">method</data>
  <data key="d2">Lifestyle interventions are intensive non‑pharmacologic measures recommended for individuals with prediabetes after gestational diabetes mellitus to prevent diabetes.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Early Screening">
  <data key="d0">Early Screening</data>
  <data key="d1">concept</data>
  <data key="d2">Early screening refers to glucose testing before 15 weeks gestation to identify undiagnosed diabetes in pregnancy.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Selective Screening">
  <data key="d0">Selective Screening</data>
  <data key="d1">concept</data>
  <data key="d2">Selective screening is a targeted approach to diabetes testing in pregnancy, contrasted with universal early screening.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Universal Early Screening">
  <data key="d0">Universal Early Screening</data>
  <data key="d1">concept</data>
  <data key="d2">Universal early screening is a strategy of testing all pregnant individuals before 15 weeks gestation for undiagnosed diabetes, especially in high‑risk populations.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Health Disparities">
  <data key="d0">Health Disparities</data>
  <data key="d1">concept</data>
  <data key="d2">Health disparities refer to racial and ethnic differences in the prevalence of undiagnosed diabetes that early screening aims to identify.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377412</data>
  <data key="d6"></data>
</node>
<node id="Non‑Pregnancy Diagnostic Criteria">
  <data key="d0">Non‑Pregnancy Diagnostic Criteria</data>
  <data key="d1">concept</data>
  <data key="d2">Non‑Pregnancy Diagnostic Criteria are diabetes diagnostic standards used outside of pregnancy that classify diabetes complicating pregnancy.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Standard Diagnostic Criteria">
  <data key="d0">Standard Diagnostic Criteria</data>
  <data key="d1">concept</data>
  <data key="d2">Standard Diagnostic Criteria are the same criteria used for identifying undiagnosed diabetes in early pregnancy as in the non‑pregnant population.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Complicating Pregnancy">
  <data key="d0">Diabetes Complicating Pregnancy</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Complicating Pregnancy denotes diabetes (often type 2) present during pregnancy that requires specific management.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Management of Diabetes in Pregnancy">
  <data key="d0">Management of Diabetes in Pregnancy</data>
  <data key="d1">concept</data>
  <data key="d2">Management of Diabetes in Pregnancy is a clinical domain covering screening, diagnosis, and treatment of diabetes during gestation.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Two‑Step Approach">
  <data key="d0">Two‑Step Approach</data>
  <data key="d1">method</data>
  <data key="d2">Two‑Step Approach is a diagnostic pathway for gestational diabetes that uses an initial screening test followed by a confirmatory test.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Randomized Controlled Trials">
  <data key="d0">Randomized Controlled Trials</data>
  <data key="d1">concept</data>
  <data key="d2">Randomized Controlled Trials are study designs referenced regarding treatment of early abnormal glucose metabolism.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Nutrition Counseling">
  <data key="d0">Nutrition Counseling</data>
  <data key="d1">method</data>
  <data key="d2">Nutrition Counseling is a recommended intervention to manage early abnormal glucose metabolism.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377413</data>
  <data key="d6"></data>
</node>
<node id="Block Testing">
  <data key="d0">Block Testing</data>
  <data key="d1">method</data>
  <data key="d2">Block Testing is a periodic weekly glucose monitoring strategy suggested for early abnormal glucose metabolism.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="Macrosomia">
  <data key="d0">Macrosomia</data>
  <data key="d1">concept</data>
  <data key="d2">Macrosomia is excessive fetal growth linked to early abnormal glucose metabolism.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="Shoulder Dystocia">
  <data key="d0">Shoulder Dystocia</data>
  <data key="d1">concept</data>
  <data key="d2">Complication during delivery where the infant’s shoulder is trapped, reduced by treatment of maternal hyperglycemia.&lt;SEP&gt;Shoulder Dystocia is a delivery complication associated with early abnormal glucose metabolism.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140&lt;SEP&gt;chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="Birth Defects">
  <data key="d0">Birth Defects</data>
  <data key="d1">concept</data>
  <data key="d2">Birth Defects are congenital anomalies whose risk is reduced by preconception care in diabetes.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="Preterm Delivery">
  <data key="d0">Preterm Delivery</data>
  <data key="d1">concept</data>
  <data key="d2">Preterm Delivery is early birth associated with diabetes in pregnancy.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="Small‑for‑Gestational‑Age Birth Weight">
  <data key="d0">Small‑for‑Gestational‑Age Birth Weight</data>
  <data key="d1">concept</data>
  <data key="d2">Small‑for‑gestational‑age birth weight is a neonatal factor linked to later insulin resistance.&lt;SEP&gt;Small‑for‑Gestational‑Age Birth Weight is a low birth weight outcome linked to diabetes in pregnancy.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140&lt;SEP&gt;chunk-1a111d4b40ec241cf54126f594a80308</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="Neonatal Intensive Care Unit Admission">
  <data key="d0">Neonatal Intensive Care Unit Admission</data>
  <data key="d1">concept</data>
  <data key="d2">Neonatal Intensive Care Unit Admission is a possible outcome for infants of mothers with diabetes.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="High‑Risk Populations">
  <data key="d0">High‑Risk Populations</data>
  <data key="d1">concept</data>
  <data key="d2">High‑Risk Populations are groups with a high prevalence of undiagnosed diabetes targeted by universal early screening.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="A1C Threshold 5.7%">
  <data key="d0">A1C Threshold 5.7%</data>
  <data key="d1">concept</data>
  <data key="d2">A1C Threshold 5.7% is a glycemic level that has not been shown to be associated with adverse perinatal outcomes.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="Fasting Glucose Threshold 110 mg/dL">
  <data key="d0">Fasting Glucose Threshold 110 mg/dL</data>
  <data key="d1">concept</data>
  <data key="d2">Fasting Glucose Threshold 110 mg/dL defines early abnormal glucose metabolism when exceeded.</data>
  <data key="d3">chunk-83d72fbc44fe0c28f27702c0d4f2c140</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="OSullivan and Mahan Criteria">
  <data key="d0">OSullivan and Mahan Criteria</data>
  <data key="d1">method</data>
  <data key="d2">Older diagnostic criteria that form the basis of the Carpenter‑Coustan interpretation.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377414</data>
  <data key="d6"></data>
</node>
<node id="One‑Step Strategy">
  <data key="d0">One‑Step Strategy</data>
  <data key="d1">method</data>
  <data key="d2">GDM diagnostic approach using a 75‑g OGTT based on IADPSG criteria, expected to raise GDM incidence.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="Two‑Step Strategy">
  <data key="d0">Two‑Step Strategy</data>
  <data key="d1">method</data>
  <data key="d2">GDM diagnostic approach beginning with a 50‑g glucose load test followed by a 100‑g OGTT interpreted with Carpenter‑Coustan criteria.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="75‑g OGTT">
  <data key="d0">75‑g OGTT</data>
  <data key="d1">method</data>
  <data key="d2">A 75‑gram oral glucose tolerance test used as the diagnostic test for GDM in the one‑step strategy.&lt;SEP&gt;Oral glucose tolerance test with 75 g glucose, measured fasting and at 1 and 2 hours, used in the one‑step GDM diagnosis.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6&lt;SEP&gt;chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="50‑g GLT">
  <data key="d0">50‑g GLT</data>
  <data key="d1">method</data>
  <data key="d2">Non‑fasting glucose load test performed at 24–28 weeks gestation as the first step of the two‑step GDM screening.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="100‑g OGTT">
  <data key="d0">100‑g OGTT</data>
  <data key="d1">method</data>
  <data key="d2">Fasting oral glucose tolerance test measuring glucose at fasting, 1, 2, and 3 hours, used in the two‑step GDM diagnosis.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="b‑Cell Dysfunction">
  <data key="d0">b‑Cell Dysfunction</data>
  <data key="d1">concept</data>
  <data key="d2">Underlying pancreatic β‑cell impairment often indicated by GDM.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="Maternal Hyperglycemia">
  <data key="d0">Maternal Hyperglycemia</data>
  <data key="d1">concept</data>
  <data key="d2">Elevated blood glucose levels in pregnant women, a central exposure examined in GDM screening studies.&lt;SEP&gt;Elevated maternal blood glucose levels that correlate with adverse pregnancy outcomes.&lt;SEP&gt;Elevated maternal blood glucose levels during pregnancy that can affect fetal development.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6&lt;SEP&gt;chunk-49c21dd27a63d44c5d80b53aa7e1f48d&lt;SEP&gt;chunk-fedb8cdc485be3c8e38133ddb9ea67cf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="Low‑Cost Test">
  <data key="d0">Low‑Cost Test</data>
  <data key="d1">concept</data>
  <data key="d2">A test characterized by low expense, such as A1C and fasting glucose, that can be performed without special preparation.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="Prenatal Laboratory">
  <data key="d0">Prenatal Laboratory</data>
  <data key="d1">artifact</data>
  <data key="d2">A laboratory setting where prenatal diagnostic tests like A1C are performed.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377415</data>
  <data key="d6"></data>
</node>
<node id="One‑Step GDM Diagnostic Thresholds">
  <data key="d0">One‑Step GDM Diagnostic Thresholds</data>
  <data key="d1">data</data>
  <data key="d2">Specific plasma glucose cutoff values (fasting ≥92 mg/dL, 1‑h ≥180 mg/dL, 2‑h ≥153 mg/dL) used in the one‑step GDM diagnosis.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377416</data>
  <data key="d6"></data>
</node>
<node id="Two‑Step GDM Diagnostic Thresholds">
  <data key="d0">Two‑Step GDM Diagnostic Thresholds</data>
  <data key="d1">data</data>
  <data key="d2">Plasma glucose cutoff values for the two‑step GDM diagnosis (fasting ≥95 mg/dL, 1‑h ≥180 mg/dL, 2‑h ≥155 mg/dL, 3‑h ≥140 mg/dL).</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377416</data>
  <data key="d6"></data>
</node>
<node id="24–28 Weeks Gestation">
  <data key="d0">24–28 Weeks Gestation</data>
  <data key="d1">concept</data>
  <data key="d2">The gestational period between 24 and 28 weeks when GDM screening tests like OGTT are typically performed.</data>
  <data key="d3">chunk-ae844f5b99d595c38f74e375112238e6</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1786377416</data>
  <data key="d6"></data>
</node>
