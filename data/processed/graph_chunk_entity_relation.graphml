  <data key="d0">SmartGuard Checklist Screen</data>
  <data key="d1">interface</data>
  <data key="d2">The SmartGuard Checklist screen displays required conditions for using the SmartGuard feature.</data>
  <data key="d3">chunk-555df1669205bcfa737c81d6936e696e</data>
