  <data key="d12">1786377569</data>
  <data key="d13"></data>
</edge>
<edge source="A1C" target="Systematic Review of 44,203 Individuals">
  <data key="d7">1.0</data>
  <data key="d8">The systematic review found a continuous association between higher A1C levels and increased diabetes risk.</data>
  <data key="d9">association,evidence</data>
  <data key="d10">chunk-ca8741dfdb9ff0f12f049953db6cb9c0</data>
