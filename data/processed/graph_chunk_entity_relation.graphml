  <data key="d6"></data>
</node>
<node id="Dexametasona">
  <data key="d0">Dexametasona</data>
  <data key="d1">concept</data>
  <data key="d2">Dexametasona is a glucocorticoid with a risk threshold above 4 mg/day for inducing hyperglycemia.</data>
  <data key="d3">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
