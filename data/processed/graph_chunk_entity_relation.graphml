</edge>
<edge source="Novolin® R Penfill" target="Potassium Chloride 40 mmol/L">
  <data key="d8">1.0</data>
  <data key="d9">Potassium chloride 40 mmol/L can be included in infusion fluids containing Novolin® R under specified conditions.</data>
  <data key="d10">additive,compatibility</data>
