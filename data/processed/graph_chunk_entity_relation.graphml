</node>
<node id="Intense Magnetic Field">
  <data key="d0">Intense Magnetic Field</data>
  <data key="d1">concept</data>
  <data key="d2">An intense magnetic field is a strong magnetic environment that can affect the sensor or transmitter if accidental exposure occurs.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1786325539</data>
  <data key="d6"></data>
</node>
<node id="Radiation">
  <data key="d0">Radiation</data>
  <data key="d1">concept</data>
  <data key="d2">Radiation from X‑ray machines can render the insulin pump inoperable or damage its insulin‑infusion regulation component.&lt;SEP&gt;Radiation includes x‑ray, CT scan, and other types that can damage the pump and CGM device.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4&lt;SEP&gt;chunk-379a204614747df98c1296e2f76c264f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329564</data>
  <data key="d6"></data>
</node>
<node id="TSA">
  <data key="d0">TSA</data>
  <data key="d1">organization</data>
  <data key="d2">The Transportation Security Administration is the U.S. security agency that oversees airport screening procedures for passengers with medical devices.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1786325539</data>
  <data key="d6"></data>
</node>
<node id="Extreme Temperature">
  <data key="d0">Extreme Temperature</data>
  <data key="d1">concept</data>
  <data key="d2">Extreme hot or cold temperatures can reduce insulin efficacy and cause hyperglycemia.&lt;SEP&gt;Extreme temperatures refer to storage or operating temperatures outside the recommended range that can damage the device.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4&lt;SEP&gt;chunk-379a204614747df98c1296e2f76c264f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d5">1786329565</data>
  <data key="d6"></data>
</node>
<node id="Nutrition Bars">
  <data key="d0">Nutrition Bars</data>
  <data key="d1">artifact</data>
  <data key="d2">Nutrition bars are portable food items recommended for travelers in case of flight delays or cancellations.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1786325540</data>
  <data key="d6"></data>
</node>
