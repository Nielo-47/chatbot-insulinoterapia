  <data key="d14"></data>
</edge>
<edge source="Editar Basal 1" target="8:00 A">
  <data key="d8">1.0</data>
  <data key="d9">In Editar Basal 1, the basal infusion segment is adjusted so that the 0.900 U/h rate ends at 8:00 A.</data>
  <data key="d10">segment adjustment,time configuration</data>
  <data key="d11">chunk-1134674d4e1ab07998567f3fa77e251d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778700980</data>
  <data key="d14"></data>
</edge>
<edge source="Editar Basal 1" target="6:00 P">
  <data key="d8">1.0</data>
  <data key="d9">In Editar Basal 1, the basal infusion segment originally ending at 6:00 P is modified, with its end time later changed to 5:30 P.</data>
  <data key="d10">segment adjustment,time configuration</data>
  <data key="d11">chunk-1134674d4e1ab07998567f3fa77e251d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778700980</data>
  <data key="d14"></data>
</edge>
<edge source="Editar Basal 1" target="5:30 P">
  <data key="d8">1.0</data>
  <data key="d9">The end time of the basal segment in Editar Basal 1 is updated from 6:00 P to 5:30 P.</data>
  <data key="d10">end time modification,time update</data>
  <data key="d11">chunk-1134674d4e1ab07998567f3fa77e251d</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/231037.pdf</data>
  <data key="d13">1778700981</data>
  <data key="d14"></data>
</edge>
<edge source="Editar Basal 1" target="Config. Patrón Basal">
  <data key="d8">1.0</data>
  <data key="d9">Config. Patrón Basal leads to Editar Basal 1, where users can modify the start and end times and insulin rates of the basal pattern.</data>
  <data key="d10">pattern editing,time segment modification</data>
