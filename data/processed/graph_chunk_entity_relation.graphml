  <data key="d5">1786317585</data>
  <data key="d6"></data>
</node>
<node id="Inclusão Inicial de Texto de Bula">
  <data key="d0">Inclusão Inicial de Texto de Bula</data>
  <data key="d1">content</data>
  <data key="d2">Inclusão Inicial de Texto de Bula denotes the first inclusion of the package insert text into the product documentation.&lt;SEP&gt;Inclusão Inicial de Texto de Bula is the initial inclusion of the product’s labeling information in the regulatory database.</data>
  <data key="d3">chunk-a8993f40975183bb8e3b3398f179a00d&lt;SEP&gt;chunk-2dd9ca6f42a5fcd7a3736eab248809ff</data>
