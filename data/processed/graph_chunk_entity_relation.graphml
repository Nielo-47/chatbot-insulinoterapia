  <data key="d13">1778707708</data>
  <data key="d14"></data>
</edge>
<edge source="CareLink Software" target="Download Slow Alert">
  <data key="d8">1.0</data>
  <data key="d9">The Download Slow Alert is generated by CareLink software when data download from the pump is taking longer than expected.</data>
  <data key="d10">performance notification,system feedback</data>
  <data key="d11">chunk-7d37ccd138ed8a095eb197006a33b8a7</data>
