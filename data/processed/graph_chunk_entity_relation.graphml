  <data key="d13">1778703082</data>
  <data key="d14"></data>
</edge>
<edge source="Bomba De Insulina" target="Control De La Terapia Con Bomba">
  <data key="d8">1.0</data>
  <data key="d9">El control de la terapia con bomba implica el manejo adecuado del dispositivo para mantener niveles estables de glucosa.</data>
  <data key="d10">device control,treatment management</data>
  <data key="d11">chunk-d0fdf7fe6f512616144e110952e56f02</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d13">1778703084</data>
  <data key="d14"></data>
</edge>
