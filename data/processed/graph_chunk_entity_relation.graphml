  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/41d0f4.pdf</data>
  <data key="d5">1786324183</data>
  <data key="d6"></data>
</node>
<node id="Enfermedad">
  <data key="d0">Enfermedad</data>
  <data key="d1">concept</data>
  <data key="d2">Enfermedad denotes illness, a factor that may require basal insulin modification.</data>
