</edge>
<edge source="Hypoglycemia" target="Blood Glucose Monitoring">
  <data key="d8">1.0</data>
  <data key="d9">Regular blood glucose monitoring helps detect and prevent hypoglycemia, especially before sleep or critical activities.</data>
  <data key="d10">prevention, detection</data>
