  <data key="d14"></data>
</edge>
<edge source="Non-Invasive Glucose Sensors" target="Nanoparticle Tattoo Sensors">
  <data key="d8">1.0</data>
  <data key="d9">Nanoparticle tattoo sensors are implantable non-invasive devices that continuously monitor glucose levels using tattoo-based technology.</data>
  <data key="d10">continuous monitoring,implantable sensor</data>
