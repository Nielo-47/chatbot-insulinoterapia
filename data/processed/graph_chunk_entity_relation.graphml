</edge>
<edge source="Captação Periférica de Glicose" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina stimulates peripheral glucose uptake, enhancing glucose clearance from the bloodstream.</data>
  <data key="d9">stimulation</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315543</data>
  <data key="d13"></data>
</edge>
<edge source="Produção Hepática de Glicose" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina suppresses liver glucose output, aiding glycemic control.</data>
  <data key="d9">inhibition</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315542</data>
  <data key="d13"></data>
</edge>
<edge source="Lipólise" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina inhibits lipolysis, reducing fatty‑acid mobilization.</data>
  <data key="d9">inhibition</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315544</data>
  <data key="d13"></data>
</edge>
<edge source="Proteólise" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina suppresses proteolytic activity, supporting protein synthesis.</data>
  <data key="d9">inhibition</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315545</data>
  <data key="d13"></data>
</edge>
<edge source="Síntese de Proteínas" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina enhances protein synthesis in target tissues.</data>
  <data key="d9">increase</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
  <data key="d12">1786315546</data>
  <data key="d13"></data>
</edge>
<edge source="Volume de Distribuição Insulina Glulisina" target="Insulin Glulisina">
  <data key="d7">1.0</data>
  <data key="d8">Insulin glulisina exhibits a volume of distribution of approximately 13 L after intravenous administration.</data>
  <data key="d9">distribution volume</data>
  <data key="d10">chunk-b65ee62ad12239ddc729c50a1aef854c</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_apidra.pdf</data>
