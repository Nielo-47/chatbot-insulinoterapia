  <data key="d0">Phone Number 1-866-289-9673</data>
  <data key="d1">data</data>
  <data key="d2">The phone number is the TSA traveler‑information hotline for diabetes‑related travel inquiries.</data>
  <data key="d3">chunk-138cbaf5a43762d4c5b77a07ab51cbd4</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/887d88.pdf</data>
  <data key="d5">1786325540</data>
  <data key="d6"></data>
</node>
<node id="TSA Traveler Information Webpage">
