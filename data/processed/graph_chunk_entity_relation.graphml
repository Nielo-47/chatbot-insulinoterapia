</edge>
<edge source="Insulin Therapy" target="Amiloidose Cutânea">
  <data key="d8">1.0</data>
  <data key="d9">Amiloidose cutânea is a rare or unknown-frequency adverse reaction associated with long-term insulin therapy at repeated injection sites.</data>
  <data key="d10">adverse effect,protein deposition</data>
  <data key="d11">chunk-1229dbbfb74d991d522a8d53f9383cdc</data>
  <data key="d12">data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
