  <data key="d13"></data>
</edge>
<edge source="Two-Step Screening Strategy" target="15‑Member Panel">
  <data key="d7">1.0</data>
  <data key="d8">The panel recommended a two‑step screening approach using a GLT followed by an OGTT.</data>
  <data key="d9">recommendation,screening</data>
  <data key="d10">chunk-49c21dd27a63d44c5d80b53aa7e1f48d</data>
