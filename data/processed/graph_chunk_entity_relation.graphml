<edge source="Active Insulin Reset To Zero Alarm" target="Bolus Screen">
  <data key="d8">1.0</data>
  <data key="d9">After the Active Insulin Reset To Zero Alarm, KJ appears on the Bolus Screen until the specified time.</data>
  <data key="d10">alarm display,status indicator</data>
  <data key="d11">chunk-fcdcd9414b427304808016daa676e270</data>
