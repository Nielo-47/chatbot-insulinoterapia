  <data key="d13">1778707664</data>
  <data key="d14"></data>
</edge>
<edge source="Basal Pattern" target="Adding An Additional Basal Pattern">
  <data key="d8">1.0</data>
  <data key="d9">Users can add additional basal patterns beyond the first one, following a specific procedure detailed elsewhere in the manual.</data>
  <data key="d10">configuration process,pattern expansion</data>
