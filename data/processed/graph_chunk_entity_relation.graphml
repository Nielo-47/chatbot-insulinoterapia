<node id="Traditional Glucose Monitoring">
  <data key="d0">Traditional Glucose Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Traditional glucose monitoring involves finger-prick blood tests using a glucometer, which CGM can help reduce or replace.</data>
  <data key="d3">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
