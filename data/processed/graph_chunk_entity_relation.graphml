<node id="No Adverse Reactions">
  <data key="d0">No Adverse Reactions</data>
  <data key="d1">concept</data>
  <data key="d2">No Adverse Reactions indicates the absence of negative outcomes observed in clinical studies of NovoRapid® during pregnancy.</data>
  <data key="d3">chunk-6d0f18c80f8de2dee960a03599d12052</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/NOVORAPID _ BulasMed.pdf</data>
