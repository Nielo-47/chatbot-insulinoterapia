<node id="Diabetes technology">
  <data key="d0">Diabetes technology</data>
  <data key="d1">concept</data>
  <data key="d2">The term describing hardware, devices, and software that people with diabetes use for self‑management, monitoring, and therapy adjustments.</data>
  <data key="d3">chunk-e4c5ae163a494feafedb71ed2205c02f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335919</data>
  <data key="d6"></data>
</node>
<node id="Hardware">
  <data key="d0">Hardware</data>
  <data key="d1">artifact</data>
  <data key="d2">Physical equipment that forms part of diabetes technology.</data>
  <data key="d3">chunk-e4c5ae163a494feafedb71ed2205c02f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335919</data>
  <data key="d6"></data>
</node>
<node id="Devices">
  <data key="d0">Devices</data>
  <data key="d1">artifact</data>
  <data key="d2">Tangible tools used in diabetes technology for insulin delivery or glucose monitoring.</data>
  <data key="d3">chunk-e4c5ae163a494feafedb71ed2205c02f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
