  <data key="d14"></data>
</edge>
<edge source="Medical Prescription" target="Electronic Health Record">
  <data key="d8">1.0</data>
  <data key="d9">Using an electronic health record system for medical prescriptions reduces handwriting and abbreviation-related insulin errors.</data>
  <data key="d10">digital prescription,standardization</data>
