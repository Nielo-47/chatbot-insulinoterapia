  <data key="d5">1786319726</data>
  <data key="d6"></data>
</node>
<node id="Pharmacist">
  <data key="d0">Pharmacist</data>
  <data key="d1">person</data>
  <data key="d2">Pharmacist is a healthcare professional to be consulted regarding Humalog usage and adverse reactions.&lt;SEP&gt;Pharmacist is a healthcare professional mentioned as a source of guidance for patients regarding medication use.&lt;SEP&gt;Pharmacist is a medication expert who can be consulted to verify the condition of Tresiba® before use.</data>
  <data key="d3">chunk-e89f1dbae629e925f06732cebf41df16&lt;SEP&gt;chunk-d59c9bf7f429a82cbfd7083e36ff8f9a&lt;SEP&gt;chunk-e9ae5f9ffa7eff9bb36cf1a9764df3e7</data>
