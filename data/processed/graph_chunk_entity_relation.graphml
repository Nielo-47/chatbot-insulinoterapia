  <data key="d1">concept</data>
  <data key="d2">Diferenças Na Farmacocinética Da IHB refers to the pharmacokinetic variations of biosynthetic human insulin that may explain observed glucose response differences.</data>
  <data key="d3">chunk-d29256dbc41e0c81e974f018d373c72d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
