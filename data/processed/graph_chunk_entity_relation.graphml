  <data key="d5">1786372192</data>
  <data key="d6"></data>
</node>
<node id="Time Below Range (TBR)">
  <data key="d0">Time Below Range (TBR)</data>
  <data key="d1">concept</data>
  <data key="d2">The percentage of time glucose values fall below the target range, reported as an outcome of the studies.</data>
  <data key="d3">chunk-127dc0e8b8b960bfd1fce3df4f590120</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/cengiz-beck-2026-use-of-inhaled-insulin-with-automated-insulin-delivery-systems.pdf</data>
  <data key="d5">1786332846</data>
  <data key="d6"></data>
</node>
<node id="Standardized Meal">
  <data key="d0">Standardized Meal</data>
  <data key="d1">content</data>
  <data key="d2">A 37 g carbohydrate meal given after a 4‑hour fast to assess postprandial glucose responses.</data>
