</edge>
<edge source="Cetoacidose Diabética" target="Sintomas de Cetoacidose Diabética">
  <data key="d7">1.0</data>
  <data key="d8">Ketoacidosis presents symptoms such as fatigue, fruity‑smelling breath, rapid breathing, and accelerated pulse.</data>
  <data key="d9">has</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d12">1786319820</data>
  <data key="d13"></data>
</edge>
<edge source="Cetoacidose Diabética" target="Morte">
  <data key="d7">2.0</data>
  <data key="d8">Untreated diabetic ketoacidosis can result in death.&lt;SEP&gt;Untreated diabetic ketoacidosis can lead to death.</data>
  <data key="d9">outcome,potential fatality</data>
  <data key="d10">chunk-fb0cd81f0439cbb74e3c0ff54236c45d&lt;SEP&gt;chunk-cbe87fd92ad66dcb02b25b669d829f6c</data>
