  <data key="d0">Post‑prandial Period</data>
  <data key="d1">concept</data>
  <data key="d2">Post‑prandial period refers to the timeframe after meals during which AMGD provides limited glucose monitoring.</data>
  <data key="d3">chunk-7ac99b8588a8c480f44a5519509f7713</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
