  <data key="d14"></data>
</edge>
<edge source="Hipoglicemia" target="Salicylates">
  <data key="d8">1.0</data>
  <data key="d9">Salicylates can potentiate the hypoglycemic effect of insulin, increasing the risk of low blood sugar.</data>
