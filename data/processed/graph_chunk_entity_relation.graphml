</node>
<node id="Regulagem">
  <data key="d0">Regulagem</data>
  <data key="d1">concept</data>
  <data key="d2">The process of adjusting the pen to remove air from the needle and cartridge before each injection.</data>
  <data key="d3">chunk-64d156e12ba8d9418249ea309aab0552</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_1778357531609.pdf</data>
