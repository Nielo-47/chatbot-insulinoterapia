  <data key="d0">Julia</data>
  <data key="d1">person</data>
  <data key="d2">Julia is a user who transfers pump information to CareLink Personal before each medical visit.&lt;SEP&gt;Julia is a user who transfers insulin pump and meter information to the CareLink Personal program before each medical visit.</data>
  <data key="d3">chunk-9855ca7ae42a0c01685280c4cc5bb56a&lt;SEP&gt;chunk-381370d223aabc9b355b55a05c98e07b</data>
