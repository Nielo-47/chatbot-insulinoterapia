</edge>
<edge source="Diabetes Mellitus Tipo 2 (DM2)" target="Antipsicóticos">
  <data key="d7">1.0</data>
  <data key="d8">Antipsychotic drugs are associated with higher diabetes risk through direct insulin effects and indirect weight gain.</data>
  <data key="d9">mechanisms,risk</data>
