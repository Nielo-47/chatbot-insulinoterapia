<node id="Lanceta">
  <data key="d0">Lanceta</data>
  <data key="d1">artifact</data>
  <data key="d2">Lanceta is a medical device used for pricking the skin to obtain blood samples, often used in diabetes management, and must be disposed of in a rigid container.</data>
