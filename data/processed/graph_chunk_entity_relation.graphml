<node id="Glucocorticoids">
  <data key="d0">Glucocorticoids</data>
  <data key="d1">substance</data>
  <data key="d2">Glucocorticoids are anti-inflammatory steroids that increase insulin resistance and insulin requirements.&lt;SEP&gt;Glucocorticoids are steroid hormones that can increase insulin requirements by promoting hyperglycemia.&lt;SEP&gt;Glucocorticoids are steroids that increase insulin resistance and may raise insulin requirements.</data>
  <data key="d3">chunk-bc07da1fd30cc15e0022830f701a9c38&lt;SEP&gt;chunk-62a6c42a674563e36382f398efac64a3&lt;SEP&gt;chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1778710016</data>
  <data key="d6"></data>
  <data key="d7">Glucocorticoids</data>
</node>
<node id="Thiazides">
  <data key="d0">Thiazides</data>
  <data key="d1">substance</data>
  <data key="d2">Thiazides are diuretics that may increase insulin needs due to effects on glucose tolerance.&lt;SEP&gt;Thiazides are diuretics that may increase insulin needs due to their effects on glucose metabolism.&lt;SEP&gt;Thiazides are diuretics that can increase insulin needs by affecting glucose tolerance.</data>
  <data key="d3">chunk-bc07da1fd30cc15e0022830f701a9c38&lt;SEP&gt;chunk-62a6c42a674563e36382f398efac64a3&lt;SEP&gt;chunk-fc71d03de36b3a734f3f7eff9922da5d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_levemir.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Bulas/bula_regular novonordiks.pdf</data>
  <data key="d5">1778709956</data>
  <data key="d6"></data>
  <data key="d7">Thiazides</data>
</node>
<node id="Metformina">
  <data key="d0">Metformina</data>
  <data key="d1">artifact</data>
  <data key="d2">Metformina is an oral antidiabetic agent used in combination with Levemir® and liraglutida for managing type 2 diabetes.&lt;SEP&gt;Metformina is an oral antidiabetic drug used as first-line treatment for type 2 diabetes, frequently combined with other therapies.&lt;SEP&gt;Metformina is an oral antidiabetic drug used as first-line therapy in type 2 diabetes, frequently combined with other agents like liraglutida and Levemir.</data>
  <data key="d3">chunk-2e2fd1844a95ab6fd4f7d89cdbddbc58&lt;SEP&gt;chunk-a24500f5f12a941115e4e44763af8133&lt;SEP&gt;chunk-302e8ebf2cacce3164fd241fd39db173</data>
