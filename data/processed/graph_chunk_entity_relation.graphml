  <data key="d0">Categoria de risco C</data>
  <data key="d1">concept</data>
  <data key="d2">Categoria de risco C is the pregnancy risk classification assigned to APIDRA SOLOSTAR, indicating it should not be used in pregnant women without medical guidance.</data>
  <data key="d3">chunk-e4ba52cc293c5c002b470566321026d6</data>
