  <data key="d13">1778707541</data>
  <data key="d14"></data>
</edge>
<edge source="Backlight" target="Pump Lock Mode">
  <data key="d8">1.0</data>
  <data key="d9">After the backlight turns off, the pump enters lock mode to conserve battery and requires unlocking before use.</data>
  <data key="d10">device inactivity,power saving</data>
