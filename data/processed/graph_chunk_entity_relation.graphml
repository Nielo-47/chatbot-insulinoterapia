  <data key="d14"></data>
</edge>
<edge source="Bolus Cuadrado" target="Ajustes De Infusion">
  <data key="d8">1.0</data>
  <data key="d9">Bolus cuadrado is enabled by selecting the option within the Ajustes de infusion menu.</data>
