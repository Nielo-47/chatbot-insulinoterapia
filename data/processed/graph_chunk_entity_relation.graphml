<edge source="Daily Total Dose (DTD)" target="Sensitivity Factor (FS)">
  <data key="d7">1.0</data>
  <data key="d8">Sensitivity factor is calculated by dividing a constant (e.g., 2000) by the Daily Total Dose.</data>
