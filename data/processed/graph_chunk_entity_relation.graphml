  <data key="d7">1.0</data>
  <data key="d8">Risperidona, a second‑generation antipsychotic, is linked to increased diabetes risk.</data>
  <data key="d9">risk,second‑generation</data>
  <data key="d10">chunk-e7b4535dbb2554b84c7a2e024c4b82c4</data>
