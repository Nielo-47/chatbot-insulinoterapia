<node id="Laminopathies">
  <data key="d0">Laminopathies</data>
  <data key="d1">concept</data>
  <data key="d2">Group of diseases caused by mutations in nuclear lamina proteins, including progeria, mandibuloacral dysplasia, and Emery‑Dreifuss muscular dystrophy.</data>
  <data key="d3">chunk-383b02cc66391d66174344ff49464766</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1786321237</data>
  <data key="d6"></data>
</node>
