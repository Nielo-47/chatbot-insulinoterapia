  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G Insulin Pump" target="24-Hour Technical Support Number">
  <data key="d8">1.0</data>
  <data key="d9">The 24-Hour Technical Support number is printed on the bottom of the MiniMed 780G insulin pump for user assistance.</data>
  <data key="d10">customer support,emergency contact</data>
