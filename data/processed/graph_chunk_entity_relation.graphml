</edge>
<edge source="Type 1 Diabetes" target="Novolin® R">
  <data key="d8">1.0</data>
  <data key="d9">Novolin® R is used to manage blood glucose levels in patients with type 1 diabetes, where insulin deficiency is absolute.</data>
