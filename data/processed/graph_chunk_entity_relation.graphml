  <data key="d14"></data>
</edge>
<edge source="Simplera Sync" target="Sensor Updating">
  <data key="d8">1.0</data>
  <data key="d9">The Simplera Sync system displays the "Sensor Updating" alert, indicating that glucose readings are paused during quality checks, with resumption expected after 30 minutes.&gt;</data>
  <data key="d10">data availability,system check</data>
  <data key="d11">chunk-fb01d55e6a22a76ca93e60f11c9b4cf6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707533</data>
  <data key="d14"></data>
</edge>
<edge source="Simplera Sync" target="Pairing Simplera Sync">
  <data key="d8">1.0</data>
  <data key="d9">Pairing Simplera Sync establishes a secure wireless link between the Simplera Sync system and the insulin pump.</data>
  <data key="d10">device connection,wireless pairing</data>
  <data key="d11">chunk-f2667d6936a8a9a26e886ba90b060796</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707892</data>
  <data key="d14"></data>
</edge>
<edge source="Simplera Sync" target="No Calibration Occurred Alert">
  <data key="d8">1.0</data>
  <data key="d9">The No Calibration Occurred Alert appears in the Simplera Sync system, indicating that calibration is required for glucose readings to resume.</data>
  <data key="d10">calibration requirement,system alert</data>
  <data key="d11">chunk-561977d7e1e0a53f148e049c126c1970</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708073</data>
  <data key="d14"></data>
</edge>
<edge source="Simplera Sync" target="MiniMed 780G System">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G system is designed to work with the Simplera Sync sensor without requiring manual calibration.</data>
  <data key="d10">device integration,sensor compatibility</data>
  <data key="d11">chunk-63f9bd562c68fc510780d6f6629360a4</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708104</data>
  <data key="d14"></data>
</edge>
<edge source="Carb Amount" target="30g Carbs">
  <data key="d8">1.0</data>
  <data key="d9">The system saves 30g of carbs for use in future bolus adjustment calculations.&gt;</data>
  <data key="d10">carb saving,future calculation</data>
  <data key="d11">chunk-9cb3ef3e959b16d99ac4debc0210965b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707536</data>
  <data key="d14"></data>
</edge>
<edge source="Carb Amount" target="15g Carbs">
  <data key="d8">1.0</data>
  <data key="d9">The system saves 15g of carbs for use in future bolus adjustment calculations after a reduced bolus.&gt;</data>
  <data key="d10">carb saving,future calculation</data>
  <data key="d11">chunk-9cb3ef3e959b16d99ac4debc0210965b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707537</data>
  <data key="d14"></data>
</edge>
<edge source="Carb Amount" target="18g Carbs">
  <data key="d8">1.0</data>
  <data key="d9">The system saves 18g of carbs for use in future bolus adjustment calculations after an increased bolus.&gt;</data>
  <data key="d10">carb saving,future calculation</data>
  <data key="d11">chunk-9cb3ef3e959b16d99ac4debc0210965b</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707538</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="CareLink Connect App">
  <data key="d8">1.0</data>
  <data key="d9">The CareLink Connect app allows users to share data from the MiniMed 780G system with caregivers or clinicians.</data>
  <data key="d10">connectivity,data sharing</data>
  <data key="d11">chunk-3fd001e1c01f7ba101b7beb19f131c79</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778707709</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Mobile Communication Devices">
  <data key="d8">1.0</data>
  <data key="d9">Unpaired mobile communication devices may interfere with the MiniMed 780G system due to RF emissions.</data>
  <data key="d10">electromagnetic interference,safety precaution</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708000</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="GPS Navigation Systems">
  <data key="d8">1.0</data>
  <data key="d9">GPS navigation systems may disrupt the MiniMed 780G system’s operation if located too closely.</data>
  <data key="d10">electromagnetic interference,operational risk</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708001</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Anti-Theft Systems">
  <data key="d8">1.0</data>
  <data key="d9">Anti-theft systems may emit signals that interfere with the proper functioning of the insulin pump.</data>
  <data key="d10">device safety,electromagnetic interference</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708003</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="RF Emitters">
  <data key="d8">1.0</data>
  <data key="d9">RF emitters with output power greater than 1 W may interfere with the pump, requiring a minimum 12-inch separation.</data>
  <data key="d10">interference risk,separation guideline</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708004</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Wireless Networks">
  <data key="d8">1.0</data>
  <data key="d9">Wireless networks may prevent communication between the sensor and the insulin pump, though no data corruption occurs.</data>
  <data key="d10">communication interference,signal disruption</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708006</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Cordless Phones">
  <data key="d8">1.0</data>
  <data key="d9">Cordless phones may interfere with the MiniMed 780G system’s sensor-pump communication.</data>
  <data key="d10">electromagnetic interference,operational disruption</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708010</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Walkie-Talkies">
  <data key="d8">1.0</data>
  <data key="d9">Walkie-talkies may block communication between the sensor and the pump due to strong RF emissions.</data>
  <data key="d10">radio frequency interference,signal blocking</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708016</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Pump Tones">
  <data key="d8">1.0</data>
  <data key="d9">Pump tones are used by the MiniMed 780G system to alert users to alarms and system status.</data>
  <data key="d10">auditory feedback,user notification</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708018</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Vibrations">
  <data key="d8">1.0</data>
  <data key="d9">Vibrations are used by the MiniMed 780G system to provide alerts without sound.</data>
  <data key="d10">tactile feedback,user notification</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708019</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Bluetooth">
  <data key="d8">1.0</data>
  <data key="d9">The MiniMed 780G system relies on Bluetooth for communication with compatible transmitters and devices.</data>
  <data key="d10">data synchronization,wireless connectivity</data>
  <data key="d11">chunk-1a9dd84e2a3b75afe80757b7b6e602a6</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708020</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Auto Correction">
  <data key="d8">1.0</data>
  <data key="d9">Auto correction is a bolus automatically delivered by the MiniMed 780G system to maximize time in range.</data>
  <data key="d10">automated dosing,correction delivery</data>
  <data key="d11">chunk-8080e2e312ed6994d0dc059a4aeca5f7</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
  <data key="d13">1778708038</data>
  <data key="d14"></data>
</edge>
<edge source="MiniMed 780G System" target="Pump Error">
  <data key="d8">1.0</data>
  <data key="d9">The Pump Error alarm is generated by the MiniMed 780G system indicating a malfunction requiring restart.</data>
  <data key="d10">alarm trigger,system malfunction</data>
  <data key="d11">chunk-64e8ebad9c2de6a1aeba1645920f2e35</data>
  <data key="d12">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/MiniMed-780G-system-user-guide.pdf</data>
