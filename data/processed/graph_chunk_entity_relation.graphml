  <data key="d5">1786377384</data>
  <data key="d6"></data>
</node>
<node id="70 mg/dL Threshold">
  <data key="d0">70 mg/dL Threshold</data>
  <data key="d1">data</data>
  <data key="d2">70 mg/dL Threshold is the numeric value below which blood glucose is considered low, defining hypoglycemia.</data>
  <data key="d3">chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372327</data>
  <data key="d6"></data>
</node>
<node id="Target Blood Glucose Level">
  <data key="d0">Target Blood Glucose Level</data>
  <data key="d1">concept</data>
  <data key="d2">Target Blood Glucose Level is the desired glucose range set in a treatment plan for managing diabetes.</data>
  <data key="d3">chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372327</data>
  <data key="d6"></data>
</node>
<node id="Pallor">
  <data key="d0">Pallor</data>
  <data key="d1">concept</data>
  <data key="d2">Pallor is a sign characterized by color draining from the skin, indicating low blood glucose.</data>
  <data key="d3">chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372327</data>
  <data key="d6"></data>
</node>
<node id="Seizure">
  <data key="d0">Seizure</data>
  <data key="d1">concept</data>
  <data key="d2">Seizure is a severe neurological event that can occur during extreme low blood glucose.</data>
  <data key="d3">chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
  <data key="d5">1786372328</data>
  <data key="d6"></data>
</node>
<node id="Blurred Vision">
  <data key="d0">Blurred Vision</data>
  <data key="d1">concept</data>
  <data key="d2">Blurred Vision is an impaired visual sign associated with low blood glucose.</data>
