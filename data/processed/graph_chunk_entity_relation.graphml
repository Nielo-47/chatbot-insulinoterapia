  <data key="d14"></data>
</edge>
<edge source="Continuous Glucose Monitoring" target="Low SG Settings">
  <data key="d8">2.0</data>
  <data key="d9">Low SG Settings are configured within the Continuous Glucose Monitoring system to define glucose alert and suspension thresholds.&lt;SEP&gt;Low SG settings define the lower limit for glucose alerts in continuous glucose monitoring.</data>
  <data key="d10">alert system,glucose monitoring,threshold configuration</data>
  <data key="d11">chunk-77d9c07e6a38b29ecca31e8c42df37e6&lt;SEP&gt;chunk-e2ad78a5db5d547aed7e2552fb1ec900</data>
