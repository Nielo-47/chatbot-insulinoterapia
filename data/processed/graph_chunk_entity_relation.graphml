  <data key="d6"></data>
</node>
<node id="Insulinoterapia Intensiva Basal‑Bolus">
  <data key="d0">Insulinoterapia Intensiva Basal‑Bolus</data>
  <data key="d1">method</data>
  <data key="d2">Intensive insulin therapy using basal and bolus injections, where AMGC helps determine insulin dose before meals.</data>
  <data key="d3">chunk-d8e26d518805695de3e4f9d41ae1d3e1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338534</data>
  <data key="d6"></data>
</node>
<node id="Glucose Oxidase (GOx)">
  <data key="d0">Glucose Oxidase (GOx)</data>
  <data key="d1">artifact</data>
  <data key="d2">Enzyme coating glucose sensors that catalyzes oxidation of glucose to gluconolactone, generating an electrical signal.</data>
  <data key="d3">chunk-d8e26d518805695de3e4f9d41ae1d3e1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338534</data>
  <data key="d6"></data>
</node>
<node id="Receptor">
  <data key="d0">Receptor</data>
  <data key="d1">artifact</data>
  <data key="d2">Device that receives glucose data from the transmitter and displays the values.</data>
  <data key="d3">chunk-d8e26d518805695de3e4f9d41ae1d3e1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338535</data>
  <data key="d6"></data>
</node>
<node id="Glicose Intersticial">
  <data key="d0">Glicose Intersticial</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Glucose present in interstitial fluid, measured continuously by SMCG sensors.</data>
  <data key="d3">chunk-d8e26d518805695de3e4f9d41ae1d3e1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/glicemias capilares.pdf</data>
  <data key="d5">1786338535</data>
  <data key="d6"></data>
</node>
<node id="Glicose No Sangue">
  <data key="d0">Glicose No Sangue</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Blood glucose measured by conventional glucose meters.</data>
