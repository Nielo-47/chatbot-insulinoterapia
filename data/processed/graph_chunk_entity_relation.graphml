  <data key="d6"></data>
</node>
<node id="IsCGM">
  <data key="d0">IsCGM</data>
  <data key="d1">artifact</data>
  <data key="d2">IsCGM is an intermittently scanned continuous glucose monitoring device that measures glucose levels and requires scanning for visualization and data storage.</data>
  <data key="d3">chunk-511f6be03d2ea98970bd4c1b29b3e5c8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335962</data>
  <data key="d6"></data>
</node>
<node id="Professional CGM">
  <data key="d0">Professional CGM</data>
  <data key="d1">artifact</data>
  <data key="d2">Professional CGM devices are placed on persons with diabetes by health‑care professionals, worn for 7–14 days, and provide data used to assess glycemic patterns and trends.</data>
  <data key="d3">chunk-511f6be03d2ea98970bd4c1b29b3e5c8</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
