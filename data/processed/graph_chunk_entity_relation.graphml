<edge source="Advanced Glycation End Products" target="RAGE Receptors">
  <data key="d8">1.0</data>
  <data key="d9">Advanced glycation end products bind to RAGE receptors on target organ cells, activating intracellular oxidative stress.</data>
  <data key="d10">molecular interaction,signaling pathway</data>
