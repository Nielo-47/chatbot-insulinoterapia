</node>
<node id="Glicose Oral">
  <data key="d0">Glicose Oral</data>
  <data key="d1">artifact</data>
  <data key="d2">Glicose oral is used to treat mild episodes of hypoglycemia by raising blood sugar levels.</data>
  <data key="d3">chunk-d717433722cc9ac8e746440493df9010</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
  <data key="d5">1778699604</data>
  <data key="d6"></data>
</node>
<node id="Glicose Concentrada">
  <data key="d0">Glicose Concentrada</data>
  <data key="d1">artifact</data>
  <data key="d2">Glicose concentrada is administered intravenously to treat severe hypoglycemic episodes.</data>
  <data key="d3">chunk-d717433722cc9ac8e746440493df9010</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_regular.pdf</data>
