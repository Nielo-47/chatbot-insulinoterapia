  <data key="d7">Hba1c</data>
</node>
<node id="World Athletics Championship">
  <data key="d0">World Athletics Championship</data>
  <data key="d1">event</data>
  <data key="d2">The World Athletics Championship is an international athletics competition where elite athletes compete in track and field events.&lt;SEP&gt;The World Athletics Championship is a global sports competition featuring top athletes in track and field.</data>
