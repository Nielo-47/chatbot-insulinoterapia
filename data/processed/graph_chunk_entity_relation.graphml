<node id="Acquired Partial Lipodystrophy">
  <data key="d0">Acquired Partial Lipodystrophy</data>
  <data key="d1">concept</data>
  <data key="d2">Acquired partial lipodystrophy is a form of lipodystrophy with metabolic and autoimmune derangements.</data>
  <data key="d3">chunk-c1ee3f56f3180d8544dbba6a542c9d68</data>
