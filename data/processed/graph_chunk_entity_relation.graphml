  <data key="d5">1786329574</data>
  <data key="d6"></data>
</node>
<node id="SG Review">
  <data key="d0">SG Review</data>
  <data key="d1">content</data>
  <data key="d2">A review screen for sensor glucose data.&lt;SEP&gt;SG Review is a screen that presents historical sensor glucose data and trends.</data>
  <data key="d3">chunk-db8e2f5011e0e0fe7dc11273e2f345b9&lt;SEP&gt;chunk-b23dfd3ae95fca711f8f10fc98ab467c</data>
