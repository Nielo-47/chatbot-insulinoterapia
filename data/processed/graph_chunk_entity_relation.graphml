  <data key="d0">Continuous Injection Site Rotation</data>
  <data key="d1">method</data>
  <data key="d2">Continuous injection site rotation is a technique of regularly changing injection locations to minimize tissue reactions.</data>
  <data key="d3">chunk-e8934881ec5ab7cfeb836126b3f0e8b2</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Bulas/bula_Toujeo.pdf</data>
  <data key="d5">1786313632</data>
