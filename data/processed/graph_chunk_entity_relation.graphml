</node>
<node id="Low Glucose Suspend">
  <data key="d0">Low Glucose Suspend</data>
  <data key="d1">concept</data>
  <data key="d2">Low Glucose Suspend is a safety feature that stops insulin delivery when glucose falls below a predefined threshold.</data>
  <data key="d3">chunk-9cd925790899146eeb8a373879b5feac</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335882</data>
  <data key="d6"></data>
</node>
<node id="Predictive Low Glucose Suspend">
  <data key="d0">Predictive Low Glucose Suspend</data>
  <data key="d1">concept</data>
  <data key="d2">Predictive Low Glucose Suspend anticipates impending hypoglycemia and suspends insulin delivery to reduce time spent with glucose below 70 mg/dL.</data>
  <data key="d3">chunk-9cd925790899146eeb8a373879b5feac</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1786335882</data>
  <data key="d6"></data>
</node>
