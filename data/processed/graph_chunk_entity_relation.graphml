<node id="Epinephrine (Adrenaline)">
  <data key="d0">Epinephrine (Adrenaline)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Epinephrine, also known as adrenaline, is a hormone released during low blood glucose that triggers physiological symptoms.</data>
  <data key="d3">chunk-208cda7ee40e8d266fadd1eadff49e03</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/hipoglicemia.pdf</data>
