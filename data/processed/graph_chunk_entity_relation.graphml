  <data key="d0">No Reservoir Detected</data>
  <data key="d1">concept</data>
  <data key="d2">No Reservoir Detected is an alert indicating that the device cannot detect the insulin reservoir.&lt;SEP&gt;No Reservoir Detected is an error condition indicating the pump does not detect a reservoir.</data>
  <data key="d3">chunk-f2667d6936a8a9a26e886ba90b060796&lt;SEP&gt;chunk-3f39c0ebbd9b32994a3bb5daf68794d7</data>
