  <data key="d13"></data>
</edge>
<edge source="Monitorização Contínua De Glicose" target="Metas De Glicemia Capilar">
  <data key="d7">1.0</data>
  <data key="d8">As metas de glicemia capilar são complementares às métricas da monitorização contínua de glicose no manejo do diabetes.</data>
  <data key="d9">alternativas de medição,objetivos terapêuticos</data>
  <data key="d10">chunk-60b2f272c0228f3954c05180dd35ce90</data>
