  <data key="d6"></data>
</node>
<node id="First-Degree Relatives">
  <data key="d0">First-Degree Relatives</data>
  <data key="d1">concept</data>
  <data key="d2">First-degree relatives are individuals who share 50% of their genes with a person, such as parents, siblings, or children, and have an increased risk of developing Type 1 Diabetes.&lt;SEP&gt;First-degree relatives are individuals who share 50% of their genes with a person, such as parents, siblings, or children, and have an increased risk of developing Type 1 Diabetes.</data>
  <data key="d3">chunk-309ce40527b1cc8f260e96e195742001</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1776689038</data>
  <data key="d6"></data>
</node>
