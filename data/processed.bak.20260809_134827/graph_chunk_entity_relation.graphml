  <data key="d12">1776689405</data>
  <data key="d13"></data>
</edge>
<edge source="Monitorização Contínua De Glicose" target="Hipoglicemia Nível 1">
  <data key="d7">1.0</data>
  <data key="d8">Time spent in hypoglycemia nível 1 (&lt;70 mg/dL) should be less than 4%, measured using continuous glucose monitoring devices.</data>
  <data key="d9">glucose monitoring,hypoglycemia detection</data>
  <data key="d10">chunk-0778abb680b777bec45d5985b757c743</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689415</data>
  <data key="d13"></data>
</edge>
<edge source="Monitorização Contínua De Glicose" target="Hipoglicemia Nível 2">
  <data key="d7">1.0</data>
  <data key="d8">Time spent in hypoglycemia nível 2 (&lt;54 mg/dL) should be less than 1%, monitored via continuous glucose monitoring systems.</data>
  <data key="d9">glucose monitoring,severe hypoglycemia</data>
  <data key="d10">chunk-0778abb680b777bec45d5985b757c743</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689416</data>
  <data key="d13"></data>
</edge>
<edge source="Mortality Risk" target="Retrospective Cohort Study">
  <data key="d7">1.0</data>
  <data key="d8">The UK-based retrospective cohort study showed a J-shaped relationship between HbA1c levels and mortality risk in patients aged 70 or older.</data>
  <data key="d9">J-curve relationship,epidemiological evidence</data>
  <data key="d10">chunk-02fb9dc2bae2939b212aa5df09194ee4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689406</data>
  <data key="d13"></data>
</edge>
<edge source="Controle Intensivo Da Glicemia" target="Redução Do Risco De IAM">
  <data key="d7">1.0</data>
  <data key="d8">Intensive glycemic control in early type 2 diabetes reduced the risk of non-fatal myocardial infarction by 15%.</data>
  <data key="d9">cardiovascular outcome,treatment benefit</data>
  <data key="d10">chunk-d39cd334b01ad820816bf3cb108c0e27</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689407</data>
  <data key="d13"></data>
</edge>
<edge source="Controle Intensivo Da Glicemia" target="Redução Da Mortalidade Por Todas As Causas">
  <data key="d7">1.0</data>
  <data key="d8">Intensive glycemic control in UKPDS was associated with a 13% reduction in all-cause mortality.</data>
  <data key="d9">long-term survival,treatment benefit</data>
  <data key="d10">chunk-d39cd334b01ad820816bf3cb108c0e27</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689408</data>
  <data key="d13"></data>
</edge>
<edge source="Controle Intensivo Da Glicemia" target="Aumento Da Mortalidade Por Todas As Causas">
  <data key="d7">1.0</data>
  <data key="d8">Intensive glycemic control was associated with a 22% increase in all-cause mortality in the ACCORD study, but not in ADVANCE or VADT.</data>
  <data key="d9">adverse outcome,treatment risk</data>
  <data key="d10">chunk-d39cd334b01ad820816bf3cb108c0e27</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
