  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639151</data>
  <data key="d13"></data>
</edge>
<edge source="Blood Glucose" target="Hyperglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Elevated blood glucose levels indicate hyperglycemia, which can be detected using a glucometer.</data>
  <data key="d9">abnormal condition,high levels</data>
