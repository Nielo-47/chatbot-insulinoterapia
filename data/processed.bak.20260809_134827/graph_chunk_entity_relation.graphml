  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="LADA">
  <data key="d7">1.0</data>
  <data key="d8">LADA is a subtype of autoimmune diabetes mellitus in adults who remain insulin-independent for at least six months post-diagnosis.</data>
