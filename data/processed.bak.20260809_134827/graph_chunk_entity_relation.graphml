<node id="Autoimmune Regulator">
  <data key="d0">Autoimmune Regulator</data>
  <data key="d1">protein</data>
  <data key="d2">Autoimmune regulator is a protein encoded by the AIRE gene, involved in preventing autoimmune diseases.&lt;SEP&gt;Autoimmune regulator is a protein encoded by the AIRE gene, involved in preventing autoimmune diseases.</data>
  <data key="d3">chunk-30c37422889250d7e58837deb17406d8</data>
