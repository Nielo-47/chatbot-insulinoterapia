</node>
<node id="Continuous Glucose Monitoring System">
  <data key="d0">Continuous Glucose Monitoring System</data>
  <data key="d1">artifact</data>
  <data key="d2">Continuous glucose monitoring systems are devices that track glucose levels in real time and are a key component of AID systems.</data>
  <data key="d3">chunk-f357ebc59eb6ed3dd2035a13da0df52f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643693</data>
  <data key="d6"></data>
</node>
<node id="Glucose Management Indicator">
  <data key="d0">Glucose Management Indicator</data>
  <data key="d1">data</data>
  <data key="d2">Glucose Management Indicator (GMI) is a calculated estimate of A1C derived from CGM data.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
