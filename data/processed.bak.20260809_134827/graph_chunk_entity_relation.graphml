  <data key="d1">organization</data>
  <data key="d2">Unidade Básica de Saúde refers to public health clinics in Brazil where medical supplies and waste disposal services are provided.</data>
  <data key="d3">chunk-13a3958ecd422660b4cd1e47e31e1b9c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1776641198</data>
