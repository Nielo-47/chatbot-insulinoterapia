</edge>
<edge source="Insulin Pens" target="Elderly Diabetic Patients">
  <data key="d7">1.0</data>
  <data key="d8">Insulin pens are considered more suitable for elderly diabetic patients due to reduced dexterity requirements.</data>
  <data key="d9">dexterity,usability</data>
  <data key="d10">chunk-e0a49a3e1aba9780862b94a266490691</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643754</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pens" target="Insulin Delivery">
  <data key="d7">1.0</data>
  <data key="d8">Insulin pens are a preferred method of insulin delivery for many individuals due to their ease of use and accurate dosing.</data>
  <data key="d9">administration method,convenience</data>
  <data key="d10">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
