</node>
<node id="Insulin Syringes">
  <data key="d0">Insulin Syringes</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin syringes are medical devices used for insulin delivery, available in various sizes and suitable for different insulin concentrations.</data>
