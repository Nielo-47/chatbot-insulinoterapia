  <data key="d6"></data>
</node>
<node id="FDA Approved Insulin Dose Calculators">
  <data key="d0">FDA Approved Insulin Dose Calculators</data>
  <data key="d1">artifact</data>
  <data key="d2">FDA approved insulin dose calculators are decision support systems designed to assist in titrating insulin doses safely and effectively.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
