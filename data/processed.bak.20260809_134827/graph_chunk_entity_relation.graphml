  <data key="d13"></data>
</edge>
<edge source="Abdomen" target="Insulin Absorption Rate">
  <data key="d7">2.0</data>
  <data key="d8">Insulin is absorbed fastest when injected into the abdomen compared to other body sites.&lt;SEP&gt;Insulin is absorbed most quickly when injected into the abdomen compared to other body sites.</data>
  <data key="d9">absorption speed,faster absorption,injection site,optimal site</data>
