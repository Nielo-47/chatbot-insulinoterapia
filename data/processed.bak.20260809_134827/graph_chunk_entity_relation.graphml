</edge>
<edge source="Metreleptina" target="Via Subcutanea">
  <data key="d7">1.0</data>
  <data key="d8">Metreleptina is administered via subcutaneous injection once daily.</data>
  <data key="d9">administration route,drug delivery</data>
  <data key="d10">chunk-5a6a69d5100e0e8263f965a83797d48b</data>
