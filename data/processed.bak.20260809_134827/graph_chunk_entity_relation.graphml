  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Type 2 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Type 1 diabetes in adults is often misclassified and treated as type 2 diabetes due to overlapping clinical features.</data>
