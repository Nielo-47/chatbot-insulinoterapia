  <data key="d13"></data>
</edge>
<edge source="Insulina" target="Temperatura Ambiente">
  <data key="d7">1.0</data>
  <data key="d8">Insulina em uso pode ser mantida à temperatura ambiente, até 30°C, por até 8 semanas.</data>
  <data key="d9">storage,usage condition</data>
  <data key="d10">chunk-a81bec86298f297d9be7cc985a7eddb6</data>
