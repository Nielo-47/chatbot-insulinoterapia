</edge>
<edge source="Estudo Emerging Risk Factors Collaboration" target="Doença Coronariana">
  <data key="d7">1.0</data>
  <data key="d8">The Emerging Risk Factors Collaboration study found significantly higher coronary heart disease risk in individuals with fasting glucose ≥126 mg/dl or diagnosed diabetes.</data>
  <data key="d9">cardiovascular outcomes,risk assessment</data>
  <data key="d10">chunk-8fd2d58abc8f20df1ff7ae241f4cfee7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
