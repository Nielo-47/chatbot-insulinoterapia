  <data key="d13"></data>
</edge>
<edge source="Renal Transplant Recipients" target="Post-Transplantation Diabetes Mellitus">
  <data key="d7">1.0</data>
  <data key="d8">Renal transplant recipients are at increased risk of developing post-transplantation diabetes mellitus.</data>
  <data key="d9">medical complication,risk factor</data>
  <data key="d10">chunk-4bc0c65f0481b400f36e5caa3f51fabe</data>
