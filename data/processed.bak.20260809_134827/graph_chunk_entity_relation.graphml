  <data key="d6"></data>
</node>
<node id="Implantable Sensors">
  <data key="d0">Implantable Sensors</data>
  <data key="d1">artifact</data>
  <data key="d2">Implantable sensors are long-term CGM sensors placed inside the body for continuous glucose monitoring.</data>
  <data key="d3">chunk-da2ab5aba6808664342df831e5ba749f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
