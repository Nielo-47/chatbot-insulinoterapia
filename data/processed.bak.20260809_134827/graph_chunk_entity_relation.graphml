</edge>
<edge source="Diabetes Mellitus" target="R15">
  <data key="d7">1.0</data>
  <data key="d8">R15 recommends screening for diabetes in individuals with comorbidities such as endocrinopathies, pancreatic diseases, HIV, or fatty liver disease.</data>
  <data key="d9">comorbidity screening,risk factors</data>
