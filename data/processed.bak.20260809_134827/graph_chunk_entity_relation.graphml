</edge>
<edge source="Diagnostic Tests For Diabetes" target="2-Hour Plasma Glucose">
  <data key="d7">1.0</data>
  <data key="d8">The 2-hour plasma glucose value during a 75-g OGTT is used to diagnose diabetes when it reaches or exceeds 200 mg/dL.</data>
  <data key="d9">diagnostic criteria,glucose tolerance</data>
