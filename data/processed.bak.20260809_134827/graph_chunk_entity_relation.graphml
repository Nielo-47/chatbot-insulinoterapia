<node id="Novolin N Flexpen">
  <data key="d0">Novolin N Flexpen</data>
  <data key="d1">artifact</data>
  <data key="d2">Novolin N Flexpen is a pen device containing human insulin suspension, manufactured by Novo Nordisk in Brazil.&lt;SEP&gt;Novolin N Flexpen is an injectable insulin suspension product manufactured by Novo Nordisk, used in diabetes treatment.</data>
  <data key="d3">chunk-c897fc79a7dde2715e95be7ca23f57f5&lt;SEP&gt;chunk-ca576cb8eccfdd91ed235c273f829e81</data>
