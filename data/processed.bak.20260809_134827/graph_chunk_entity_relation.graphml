<node id="Taiwanese Population">
  <data key="d0">Taiwanese Population</data>
  <data key="d1">person</data>
  <data key="d2">The Taiwanese population has been reported to show age- and sex-related increases in A1C, particularly in men.&lt;SEP&gt;The Taiwanese population has been reported to show age- and sex-related increases in A1C, particularly in men.</data>
  <data key="d3">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
