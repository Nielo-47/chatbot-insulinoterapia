</node>
<node id="Triglyceride">
  <data key="d0">Triglyceride</data>
  <data key="d1">concept</data>
  <data key="d2">Triglyceride level above 250 mg/dL (2.82 mmol/L) is associated with insulin resistance and increased diabetes risk.&lt;SEP&gt;Triglyceride level above 250 mg/dL (2.82 mmol/L) is associated with insulin resistance and increased diabetes risk.</data>
  <data key="d3">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
