  <data key="d6"></data>
</node>
<node id="Causes Of Death">
  <data key="d0">Causes Of Death</data>
  <data key="d1">concept</data>
  <data key="d2">Causes of death are the medical and metabolic factors leading to mortality in patients with Berardinelli-Seip congenital generalized lipodystrophy.</data>
  <data key="d3">chunk-55c9f6328c4401f126aa9ac11be639b6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1776640771</data>
  <data key="d6"></data>
</node>
<node id="Bmc Cardiovasc Disord">
  <data key="d0">Bmc Cardiovasc Disord</data>
  <data key="d1">content</data>
  <data key="d2">BMC Cardiovasc Disord is a scientific journal that published research on immune modulation in Brazilian patients with congenital generalized lipodystrophy.</data>
  <data key="d3">chunk-55c9f6328c4401f126aa9ac11be639b6</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d5">1776640772</data>
