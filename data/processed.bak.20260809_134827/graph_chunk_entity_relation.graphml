  <data key="d6"></data>
</node>
<node id="Alcohol">
  <data key="d0">Alcohol</data>
  <data key="d1">substance</data>
  <data key="d2">Alcohol is used to clean the skin before insulin injection, but must be allowed to dry completely to avoid irritation.&lt;SEP&gt;Alcohol is used to clean the skin before insulin injection, but must be allowed to dry completely to avoid irritation.&lt;SEP&gt;Alcohol is a substance that can affect the accuracy of continuous glucose monitoring sensors.</data>
  <data key="d3">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-8651ec88cb5333f03b8af01fee4d3cb0&lt;SEP&gt;chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
