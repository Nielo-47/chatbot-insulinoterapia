  <data key="d13"></data>
</edge>
<edge source="A1C Test" target="National Health and Nutrition Examination Survey">
  <data key="d7">1.0</data>
  <data key="d8">NHANES data show that A1C with a 6.5% threshold identifies only 30% of diabetes cases found by A1C, FPG, or 2-h PG collectively.</data>
  <data key="d9">data source,epidemiological evidence</data>
