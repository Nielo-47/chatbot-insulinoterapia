  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Autoimmunity">
  <data key="d7">1.0</data>
  <data key="d8">Presence of autoantibodies or related autoimmune conditions supports a diagnosis of type 1 diabetes mellitus.</data>
  <data key="d9">antibody testing,autoimmune markers</data>
