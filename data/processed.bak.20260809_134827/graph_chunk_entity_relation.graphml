  <data key="d6"></data>
</node>
<node id="Diabetic Patients">
  <data key="d0">Diabetic Patients</data>
  <data key="d1">group</data>
  <data key="d2">Diabetic patients are individuals with diabetes who were subjects in studies evaluating insulin mixtures and injection techniques.&lt;SEP&gt;Diabetic patients are individuals treated with insulin extract during the early clinical trials at TGH.&lt;SEP&gt;Diabetic patients are individuals treated with insulin extract during the early clinical trials at TGH.&lt;SEP&gt;Diabetic patients are individuals treated with insulin extract during the early clinical trials at TGH.</data>
