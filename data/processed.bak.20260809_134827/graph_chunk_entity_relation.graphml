  <data key="d6"></data>
</node>
<node id="L P Lowe">
  <data key="d0">L P Lowe</data>
  <data key="d1">person</data>
  <data key="d2">L P Lowe is a researcher involved in studies on gestational diabetes and its long-term effects on offspring.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
