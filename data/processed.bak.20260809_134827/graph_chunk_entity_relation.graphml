  <data key="d12">1776642415</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Cgm">
  <data key="d7">1.0</data>
  <data key="d8">CGM has been shown to reduce the incidence of hypoglycemia in both adults and pediatric populations.</data>
