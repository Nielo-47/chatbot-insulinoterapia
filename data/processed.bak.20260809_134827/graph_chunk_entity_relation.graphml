  <data key="d13"></data>
</edge>
<edge source="Maltose" target="GDH-PQQ Devices">
  <data key="d7">3.0</data>
  <data key="d8">Maltose interferes with glucose readings in devices based on GDH-PQQ enzyme technology, causing falsely high results.&lt;SEP&gt;Maltose interferes with glucose readings in devices based on GDH-PQQ enzyme technology, causing falsely high results.&lt;SEP&gt;Maltose interferes with glucose readings in devices based on GDH-PQQ enzyme technology, causing falsely high results.</data>
