</node>
<node id="Infusion Sets">
  <data key="d0">Infusion Sets</data>
  <data key="d1">artifact</data>
  <data key="d2">Infusion sets are components of insulin pump systems that deliver insulin into the body and can cause complications like dislodgement or occlusion.</data>
  <data key="d3">chunk-f357ebc59eb6ed3dd2035a13da0df52f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
