</node>
<node id="24-Hour Analysis">
  <data key="d0">24-Hour Analysis</data>
  <data key="d1">method</data>
  <data key="d2">The 24-Hour Analysis is a method used to evaluate glucose levels, insulin delivery, and device settings over a full day using CGM data.</data>
  <data key="d3">chunk-7a08dc7008091e5ab01812c301e0aab1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/cgm.pdf</data>
