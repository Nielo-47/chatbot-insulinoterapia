  <data key="d12">1776647667</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Pernicious Anemia">
  <data key="d7">1.0</data>
  <data key="d8">Pernicious anemia is an autoimmune condition affecting vitamin B12 absorption and associated with type 1 diabetes.</data>
