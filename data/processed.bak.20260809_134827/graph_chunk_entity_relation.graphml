  <data key="d12">1776638457</data>
  <data key="d13"></data>
</edge>
<edge source="Glycemic Variability" target="Long-Acting Insulin Analogs">
  <data key="d7">1.0</data>
  <data key="d8">Due to their pharmacokinetic and pharmacodynamic profiles, long-acting insulin analogs provide more predictable insulin action and reduce glycemic variability.</data>
  <data key="d9">pharmacokinetic advantage,treatment predictability</data>
  <data key="d10">chunk-a49920639f738eae3de220d132cbc081</data>
