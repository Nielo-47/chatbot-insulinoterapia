  <data key="d0">Sumário de Evidências</data>
  <data key="d3">chunk-2b3097da75459ebf108182050a889e65</data>
  <data key="d2">The Sumário de Evidências provides the evidential basis for R11, explaining the rationale for a 3-year screening interval in low-risk individuals.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
