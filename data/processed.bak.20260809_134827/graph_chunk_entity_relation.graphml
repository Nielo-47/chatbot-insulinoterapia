</edge>
<edge source="Type 1 Diabetes" target="Hashimoto Thyroiditis">
  <data key="d7">1.0</data>
  <data key="d8">Individuals with type 1 diabetes are at increased risk for other autoimmune conditions such as Hashimoto thyroiditis.</data>
  <data key="d9">autoimmune disorder,comorbidity</data>
