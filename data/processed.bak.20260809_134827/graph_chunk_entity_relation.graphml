  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Beta-Cell Insulin Secretion">
  <data key="d7">1.0</data>
  <data key="d8">Deficient beta-cell insulin secretion is a core feature of type 2 diabetes, often occurring alongside insulin resistance.</data>
