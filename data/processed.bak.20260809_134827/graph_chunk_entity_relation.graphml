</node>
<node id="C Y Spong">
  <data key="d0">C Y Spong</data>
  <data key="d1">person</data>
  <data key="d2">C Y Spong is a researcher involved in multicenter trials on the treatment of gestational diabetes.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
