</edge>
<edge source="Metreleptina" target="Ajustes De Dose">
  <data key="d7">1.0</data>
  <data key="d8">Dose adjustments of metreleptina are made based on clinical and laboratory evaluations.</data>
  <data key="d9">clinical monitoring,dose optimization</data>
