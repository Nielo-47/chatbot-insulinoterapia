  <data key="d6"></data>
</node>
<node id="Oral Glucose Tolerance Testing">
  <data key="d0">Oral Glucose Tolerance Testing</data>
  <data key="d1">method</data>
  <data key="d2">Oral glucose tolerance testing is a diagnostic procedure requiring carbohydrate intake prior to testing to ensure accurate results.&lt;SEP&gt;Oral glucose tolerance testing is a diagnostic procedure requiring carbohydrate intake prior to testing to ensure accurate results.</data>
  <data key="d3">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
