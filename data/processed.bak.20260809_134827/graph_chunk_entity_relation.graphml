  <data key="d13"></data>
</edge>
<edge source="Glucose Meter" target="Interfering Substances">
  <data key="d7">1.0</data>
  <data key="d8">Substances like ascorbic acid, uric acid, and acetaminophen can interfere with glucose meter readings, causing inaccuracies.</data>
  <data key="d9">accuracy risk,measurement error</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643806</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Oxidase Monitors" target="Oxygen Saturation">
  <data key="d7">1.0</data>
  <data key="d8">Glucose oxidase monitors are affected by oxygen saturation, leading to false readings in high or low oxygen conditions.</data>
  <data key="d9">accuracy factor,interference</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643801</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Oxidase Monitors" target="Capillary Blood">
  <data key="d7">1.0</data>
  <data key="d8">Glucose oxidase monitors should be used with capillary blood in individuals with normal oxygen saturation.</data>
  <data key="d9">proper use,sample requirement</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643803</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Oxidase Monitors" target="Arterial Blood">
  <data key="d7">1.0</data>
  <data key="d8">Arterial blood may cause falsely low glucose readings in glucose oxidase-based meters due to high oxygen tension.</data>
  <data key="d9">inaccurate reading,interference</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643804</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Oxidase Monitors" target="Venous Blood">
  <data key="d7">1.0</data>
  <data key="d8">Venous blood may result in falsely high glucose readings in glucose oxidase-based meters under low oxygen conditions.</data>
  <data key="d9">inaccurate reading,interference</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
