  <data key="d13"></data>
</edge>
<edge source="Metreleptina" target="Insulinoterapia">
  <data key="d7">1.0</data>
  <data key="d8">Some patients no longer require insulinoterapia after starting metreleptina treatment.</data>
  <data key="d9">therapy discontinuation,treatment alternative</data>
  <data key="d10">chunk-5a6a69d5100e0e8263f965a83797d48b</data>
