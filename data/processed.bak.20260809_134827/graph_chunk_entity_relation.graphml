  <data key="d13"></data>
</edge>
<edge source="R8" target="Hypoglycemia Level 1">
  <data key="d7">1.0</data>
  <data key="d8">R8 recommends that time in Hypoglycemia Level 1 (&lt;70 mg/dL) should be less than 4%.</data>
  <data key="d9">clinical recommendation,glycemic target</data>
  <data key="d10">chunk-eccbaa35bd49db810bbf9c4a8d650469</data>
