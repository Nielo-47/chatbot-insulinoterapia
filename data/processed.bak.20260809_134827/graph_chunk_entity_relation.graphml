<node id="Technosphere Insulin">
  <data key="d0">Technosphere Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Technosphere insulin is an inhaled form of prandial insulin used as an alternative to injected insulin in type 1 diabetes management.</data>
