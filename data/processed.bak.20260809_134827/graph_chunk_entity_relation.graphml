</edge>
<edge source="Subcutaneous Nodule" target="Erythema">
  <data key="d7">1.0</data>
  <data key="d8">Subcutaneous nodules and erythema are common local reactions observed at insulin infusion sites, affecting a majority of patients.</data>
  <data key="d9">infusion site reaction,side effect</data>
  <data key="d10">chunk-54930ff88c0a13a8693f1c1b3407ca63</data>
