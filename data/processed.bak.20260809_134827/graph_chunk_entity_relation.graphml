</edge>
<edge source="PIs" target="Pancreatic B-Cells">
  <data key="d7">1.0</data>
  <data key="d8">PIs may lead to apoptosis of pancreatic beta-cells, impairing insulin production.</data>
  <data key="d9">cell damage,drug toxicity</data>
