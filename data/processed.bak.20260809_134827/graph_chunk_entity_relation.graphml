  <data key="d13"></data>
</edge>
<edge source="Patient" target="Diabetes Education">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes education must consider the patient’s age, life stage, and emotional state to be effective.</data>
  <data key="d9">personalized care,treatment adherence</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638143</data>
  <data key="d13"></data>
</edge>
<edge source="Patient" target="Healthcare Professional">
  <data key="d7">2.0</data>
  <data key="d8">Healthcare professionals must teach patients how to apply insulin correctly and review the technique at every consultation.&lt;SEP&gt;Healthcare professionals teach and demonstrate insulin application to patients to ensure proper understanding and technique.</data>
  <data key="d9">demonstration,education,education delivery,treatment supervision</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-03a1de93a53fbcb513268c123e2c5a16</data>
