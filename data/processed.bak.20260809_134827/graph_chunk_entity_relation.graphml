  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Latent Autoimmune Diabetes in Adults">
  <data key="d7">1.0</data>
  <data key="d8">Latent autoimmune diabetes in adults (LADA) is considered a variant of type 1 diabetes due to autoimmune beta-cell destruction.</data>
  <data key="d9">autoimmune diabetes,disease classification</data>
  <data key="d10">chunk-c47356c03c704ef89b9f41bbd939bc8a</data>
