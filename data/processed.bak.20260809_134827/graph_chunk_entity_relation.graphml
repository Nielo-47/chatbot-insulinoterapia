<edge source="Diabetes Mellitus" target="Retinopatia Diabética">
  <data key="d7">1.0</data>
  <data key="d8">Retinopatia Diabética is a long-term complication of Diabetes Mellitus and was used as the endpoint for establishing diagnostic thresholds.</data>
