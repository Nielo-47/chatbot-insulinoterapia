  <data key="d0">Recommendation Report Number 245</data>
  <data key="d1">content</data>
  <data key="d2">Recommendation Report Number 245 is a document issued by CONITEC in February 2017, evaluating diabetes treatments and providing policy guidance.</data>
  <data key="d3">chunk-5647e96fec802433abcc8922a33d23b8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
