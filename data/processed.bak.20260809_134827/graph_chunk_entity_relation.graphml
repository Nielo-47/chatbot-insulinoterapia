  <data key="d13"></data>
</edge>
<edge source="San Antonio Heart Study" target="DM2">
  <data key="d7">1.0</data>
  <data key="d8">The San Antonio Heart Study provided evidence linking elevated one-hour glucose levels to the future incidence of Type 2 Diabetes.</data>
  <data key="d9">epidemiological evidence,prospective research</data>
