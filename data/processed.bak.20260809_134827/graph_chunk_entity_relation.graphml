  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Oral Glucose Tolerance Test">
  <data key="d7">1.0</data>
  <data key="d8">The oral glucose tolerance test is a standard method used to diagnose gestational diabetes mellitus by assessing glucose metabolism during pregnancy.</data>
  <data key="d9">diagnostic method,glucose metabolism</data>
  <data key="d10">chunk-2f5ebd46f8491409b5f07f5c83542afd</data>
