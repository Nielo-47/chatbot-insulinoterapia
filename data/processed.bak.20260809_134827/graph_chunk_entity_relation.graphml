  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="One-Hour Plasma Glucose">
  <data key="d7">1.0</data>
  <data key="d8">Elevated one-hour plasma glucose is a strong predictor of future type 2 diabetes risk.</data>
  <data key="d9">disease marker,risk prediction</data>
  <data key="d10">chunk-2977bb9a41689e74de2c536343624744</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
