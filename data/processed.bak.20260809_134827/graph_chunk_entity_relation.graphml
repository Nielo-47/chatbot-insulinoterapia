</node>
<node id="Edtion 4">
  <data key="d0">Edtion 4</data>
  <data key="d1">event</data>
  <data key="d2">EDITION 4 is a phase 3a, open-label clinical trial comparing new insulin glargine 300 units/mL with glargine 100 units/mL in people with type 1 diabetes.</data>
  <data key="d3">chunk-ac7fb8feaa2febe2b5f8525b93f3080f</data>
