</node>
<node id="Intensive Insulin Therapies">
  <data key="d0">Intensive Insulin Therapies</data>
  <data key="d1">method</data>
  <data key="d2">Intensive insulin therapies include multiple daily injections or insulin pump therapy and require frequent blood glucose monitoring.</data>
