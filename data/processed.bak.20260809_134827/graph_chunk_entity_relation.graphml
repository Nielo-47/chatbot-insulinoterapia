</node>
<node id="Hipoglicemia Sintomática">
  <data key="d0">Hipoglicemia Sintomática</data>
  <data key="d3">chunk-6a45688326f1b9dbe3fc7ae4ba51043a</data>
  <data key="d2">Insulina Degludeca reduced symptomatic hypoglycemia by 11% compared to insulina glargina U100.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642342</data>
  <data key="d6"></data>
</node>
<node id="Intensive Insulin Therapy">
  <data key="d0">Intensive Insulin Therapy</data>
  <data key="d3">chunk-a49920639f738eae3de220d132cbc081&lt;SEP&gt;chunk-2841f77ed9254c0e5372f3c45f6d3da2&lt;SEP&gt;chunk-df233d11f0547c43f4dc4cad909d392b</data>
  <data key="d2">Intensive insulin therapy significantly reduced HbA1c levels, achieving better glycemic control compared to conventional therapy.&lt;SEP&gt;Intensive insulin therapy mimics the body’s natural insulin secretion using basal and bolus insulin, requiring multiple injections and dose adjustments for lifestyle flexibility.&lt;SEP&gt;Intensive insulin therapy is a treatment approach for insulin-deficient individuals, with response independent of C-peptide levels.</data>
  <data key="d1">method</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Understanding insulin - International Diabetes Federation.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643600</data>
  <data key="d6"></data>
</node>
