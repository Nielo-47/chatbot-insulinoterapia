</edge>
<edge source="Cotton" target="Insulin Injection Procedure">
  <data key="d7">1.0</data>
  <data key="d8">Cotton is used after injection to compress the site for 5 seconds to minimize bleeding or insulin leakage.</data>
  <data key="d9">compression,post-injection care</data>
