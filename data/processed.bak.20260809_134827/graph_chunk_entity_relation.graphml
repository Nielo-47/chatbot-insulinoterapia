</node>
<node id="Ultrarapid Insulin">
  <data key="d0">Ultrarapid Insulin</data>
  <data key="d1">substance</data>
  <data key="d2">Ultrarapid insulin is a fast-acting insulin type used in diabetes therapy, often combined with NPH insulin in a single injection.</data>
  <data key="d3">chunk-035472811a4a16d98e62eba23a86dceb</data>
