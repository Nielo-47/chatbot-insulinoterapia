  <data key="d0">M B Landon</data>
  <data key="d1">person</data>
  <data key="d2">M B Landon is a principal investigator in clinical trials on mild gestational diabetes and long-term child health.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
