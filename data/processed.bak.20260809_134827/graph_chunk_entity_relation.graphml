  <data key="d0">Suco De Laranja Sem Açúcar</data>
  <data key="d1">content</data>
  <data key="d2">Suco de laranja sem açúcar is a beverage containing carbohydrates used to treat hypoglycemia.</data>
  <data key="d3">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
