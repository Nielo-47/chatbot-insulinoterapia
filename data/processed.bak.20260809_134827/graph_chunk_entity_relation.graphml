<node id="Syndromes of Ketosis-Prone Diabetes Mellitus">
  <data key="d0">Syndromes of Ketosis-Prone Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">Syndromes of Ketosis-Prone Diabetes Mellitus refers to a classification of diabetes characterized by ketoacidosis and variable insulin dependency.</data>
  <data key="d3">chunk-ccde7bd12284b1c344a961b0f935b651</data>
