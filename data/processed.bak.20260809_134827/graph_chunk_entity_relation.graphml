</edge>
<edge source="Insulin Resistance" target="Glucocorticoids">
  <data key="d7">1.0</data>
  <data key="d8">Glucocorticoids induce insulin resistance, contributing to elevated blood glucose levels.</data>
  <data key="d9">hyperglycemia,metabolic effect</data>
