  <data key="d12">1776638306</data>
  <data key="d13"></data>
</edge>
<edge source="Syringe" target="Insulin Vial">
  <data key="d7">1.0</data>
  <data key="d8">Insulin is drawn from a vial into a syringe, requiring proper technique such as cleaning the stopper and injecting air first.</data>
  <data key="d9">dose preparation,handling</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
