  <data key="d13"></data>
</edge>
<edge source="Cotton" target="Aplicação de Insulina">
  <data key="d7">1.0</data>
  <data key="d8">Cotton is used alongside alcohol 70% to wipe and prepare the injection site before insulin delivery.</data>
  <data key="d9">cleaning,site preparation</data>
  <data key="d10">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
