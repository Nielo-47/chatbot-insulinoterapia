  <data key="d13"></data>
</edge>
<edge source="Diagnostic Tests For Diabetes" target="Oral Glucose Tolerance Test">
  <data key="d7">1.0</data>
  <data key="d8">The oral glucose tolerance test involves ingesting 75 g of glucose and measuring plasma glucose after 2 hours to assess diabetes.</data>
  <data key="d9">glucose challenge,testing protocol</data>
