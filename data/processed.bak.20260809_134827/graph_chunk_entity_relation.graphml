<node id="Insulin Mixtures">
  <data key="d0">Insulin Mixtures</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin mixtures are combinations of different insulin types administered subcutaneously, whose pharmacokinetics and pharmacodynamics can be affected by storage temperature.</data>
  <data key="d3">chunk-8fc83e266bdeb54c4139a50adf2b793a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
