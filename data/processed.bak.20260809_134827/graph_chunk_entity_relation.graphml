<edge source="Insulin Pen" target="Municipal Health Department">
  <data key="d7">1.0</data>
  <data key="d8">The Municipal Health Department provides insulin pens and replaces them after three years or in case of damage.</data>
  <data key="d9">device provision,replacement</data>
  <data key="d10">chunk-1b3b45cb29102851f76174e378f8e0cc</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Guia-Pratico-SBD-Canetas-Reutilizaveis-de-Insulina-no-SUS.pdf</data>
