  <data key="d13"></data>
</edge>
<edge source="Body Weight" target="Asian Americans">
  <data key="d7">1.0</data>
  <data key="d8">Asian Americans face increased diabetes risk at lower body weights compared to the general population.</data>
  <data key="d9">population-specific criteria,risk factor</data>
