  <data key="d13"></data>
</edge>
<edge source="Rapid-Acting Insulin Analog" target="Faster-Acting Insulin Aspart">
  <data key="d7">1.0</data>
  <data key="d8">Faster-acting insulin aspart is an enhanced version of rapid-acting insulin analogs with an earlier peak and faster action.</data>
  <data key="d9">drug advancement,improved kinetics</data>
