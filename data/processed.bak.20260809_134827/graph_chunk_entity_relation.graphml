</edge>
<edge source="Fasting Glucose" target="Gestational Diabetes Mellitus">
  <data key="d7">1.0</data>
  <data key="d8">Fasting glucose levels of 110–125 mg/dL are used to screen for early abnormal glucose metabolism in pregnancy.&gt;</data>
  <data key="d9">diagnostic criterion,metabolic marker</data>
