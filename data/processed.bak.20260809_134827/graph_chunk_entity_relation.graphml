</edge>
<edge source="Pregnancy" target="Women With Preexisting Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Women with preexisting diabetes must plan pregnancy carefully due to risks from high glucose levels.</data>
  <data key="d9">maternal health,risk factor</data>
