</node>
<node id="Testes De Glicemia">
  <data key="d0">Testes De Glicemia</data>
  <data key="d1">method</data>
  <data key="d2">Testes de glicemia are blood glucose monitoring procedures involving lancets and test strips to measure blood sugar levels.</data>
  <data key="d3">chunk-13a3958ecd422660b4cd1e47e31e1b9c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1776641200</data>
  <data key="d6"></data>
</node>
<node id="Descarte Correto De Lixo">
  <data key="d0">Descarte Correto De Lixo</data>
  <data key="d1">concept</data>
  <data key="d2">Descarte correto de lixo refers to the proper disposal of medical waste to protect public health and the environment.</data>
  <data key="d3">chunk-13a3958ecd422660b4cd1e47e31e1b9c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1776641200</data>
  <data key="d6"></data>
</node>
<node id="Descarte Seguro">
  <data key="d0">Descarte Seguro</data>
  <data key="d1">concept</data>
  <data key="d2">Descarte seguro emphasizes safe handling and disposal practices for hazardous medical waste as a civic responsibility.</data>
  <data key="d3">chunk-13a3958ecd422660b4cd1e47e31e1b9c</data>
