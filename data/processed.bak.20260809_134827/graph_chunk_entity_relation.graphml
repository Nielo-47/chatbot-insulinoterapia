  <data key="d12">1776639176</data>
  <data key="d13"></data>
</edge>
<edge source="Physical Activity" target="Insulin Dosage">
  <data key="d7">1.0</data>
  <data key="d8">Physical activity lowers blood sugar, so insulin doses may need to be reduced to prevent hypoglycemia.</data>
  <data key="d9">dose adjustment,hypoglycemia risk</data>
  <data key="d10">chunk-2a0a3f492aa5ef7771b2246547cb5f02</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638344</data>
  <data key="d13"></data>
</edge>
<edge source="Physical Activity" target="Leg">
  <data key="d7">1.0</data>
  <data key="d8">Injecting insulin into the leg before physical activity like walking can increase the risk of hypoglycemia.</data>
  <data key="d9">hypoglycemia,injection site risk</data>
  <data key="d10">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
