  <data key="d6"></data>
</node>
<node id="Immunomodulatory Medications">
  <data key="d0">Immunomodulatory Medications</data>
  <data key="d3">chunk-7dad8318811ce10b7f639b13057d611f</data>
  <data key="d2">ANVISA has not approved immunomodulatory medications for type 1 diabetes, limiting their availability in Brazil.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1776689166</data>
  <data key="d6"></data>
</node>
