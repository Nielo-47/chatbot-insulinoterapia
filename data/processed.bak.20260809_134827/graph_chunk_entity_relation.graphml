  <data key="d13"></data>
</edge>
<edge source="Pregnancy" target="Insulin Pump Therapy">
  <data key="d7">1.0</data>
  <data key="d8">Insulin pump therapy is beneficial for pregnant women with diabetes due to improved glycemic flexibility and control.</data>
  <data key="d9">safety,treatment benefit</data>
