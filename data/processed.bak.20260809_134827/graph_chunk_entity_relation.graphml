<node id="Seroconversion">
  <data key="d0">Seroconversion</data>
  <data key="d1">concept</data>
  <data key="d2">Seroconversion refers to the development of detectable islet autoantibodies, indicating early autoimmune activity leading to type 1 diabetes.</data>
