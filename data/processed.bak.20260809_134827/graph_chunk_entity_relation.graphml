  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes Screening" target="Overweight And Obesity In Youth">
  <data key="d7">1.0</data>
  <data key="d8">Overweight and obesity in children and adolescents are primary criteria for initiating type 2 diabetes screening, especially when combined with additional risk factors.</data>
  <data key="d9">risk factor,screening indication</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
