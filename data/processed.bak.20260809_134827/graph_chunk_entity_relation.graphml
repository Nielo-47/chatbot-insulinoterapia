<edge source="C-Peptide" target="Pmol/L">
  <data key="d7">1.0</data>
  <data key="d8">C-peptide concentrations can be measured and reported in pmol/L, one of several units available through unit conversion tools.</data>
  <data key="d9">measurement,unit conversion</data>
