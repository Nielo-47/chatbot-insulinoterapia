  <data key="d5">1776648237</data>
  <data key="d6"></data>
</node>
<node id="Hipoglicemias Frequentes">
  <data key="d0">Hipoglicemias Frequentes</data>
  <data key="d1">concept</data>
  <data key="d2">Frequent hypoglycemia refers to recurring low blood sugar levels, a concern for individuals with diabetes.&lt;SEP&gt;Frequent hypoglycemia refers to recurring low blood sugar levels, a concern for individuals with diabetes.</data>
  <data key="d3">chunk-63f18f20af642d4a480c16e7a6780bb6</data>
