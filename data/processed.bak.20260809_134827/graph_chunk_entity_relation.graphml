  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="U.S. Pediatric Cohort">
  <data key="d7">1.0</data>
  <data key="d8">Children in the U.S. cohort with multiple autoantibodies are at high risk of developing type 1 diabetes within 10–15 years.</data>
