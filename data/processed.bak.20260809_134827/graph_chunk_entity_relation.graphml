  <data key="d13"></data>
</edge>
<edge source="Cotton" target="Insulin Application Technique">
  <data key="d7">1.0</data>
  <data key="d8">Cotton is used during the insulin application process, likely in conjunction with alcohol for cleaning.</data>
  <data key="d9">cleaning,material use</data>
  <data key="d10">chunk-e68da6d45eb01c249e854b711007d805</data>
