</edge>
<edge source="Insulin Therapy" target="Frid Ah">
  <data key="d7">1.0</data>
  <data key="d8">Frid AH contributed to new recommendations for insulin delivery and injection practices.</data>
  <data key="d9">clinical recommendation,injection safety</data>
  <data key="d10">chunk-8fc83e266bdeb54c4139a50adf2b793a</data>
