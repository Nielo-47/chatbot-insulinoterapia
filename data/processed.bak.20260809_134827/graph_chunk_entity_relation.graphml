  <data key="d13"></data>
</edge>
<edge source="Intralesional Insulin Injection" target="Impaired Glucose Control">
  <data key="d7">1.0</data>
  <data key="d8">A injeção intralesional de insulina em áreas com lipohipertrofia leva a um controle glicêmico pós-prandial deteriorado.</data>
  <data key="d9">clinical consequence,metabolic effect</data>
  <data key="d10">chunk-202f1dba3a8254f9d5867b459cdbcfa2</data>
