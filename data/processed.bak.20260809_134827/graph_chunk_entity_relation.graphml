  <data key="d13"></data>
</edge>
<edge source="Differential Diagnosis" target="Type B Insulin Resistance Syndrome">
  <data key="d7">1.0</data>
  <data key="d8">Type B Insulin Resistance Syndrome is part of the differential diagnosis for lipodystrophy due to its autoimmune-mediated insulin resistance.</data>
  <data key="d9">autoimmune origin,disease comparison</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
