</node>
<node id="Excess Insulin">
  <data key="d0">Excess Insulin</data>
  <data key="d1">data</data>
  <data key="d2">Excess insulin drawn into the syringe must not be returned to the vial and must be discarded, requiring the procedure to be restarted.</data>
  <data key="d3">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
