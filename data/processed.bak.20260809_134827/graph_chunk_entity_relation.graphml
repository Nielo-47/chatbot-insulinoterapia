  <data key="d0">Patient Choice</data>
  <data key="d3">chunk-45bbbee62d25d825935842af1930bb44</data>
  <data key="d2">Ethical considerations arise when patients choose advanced diabetes technologies despite high costs.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641854</data>
