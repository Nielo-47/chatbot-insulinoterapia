  <data key="d12">1776647673</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Table 2.1">
  <data key="d7">1.0</data>
  <data key="d8">Table 2.1 defines three distinct stages of type 1 diabetes, which are used to guide research and regulatory decisions.</data>
