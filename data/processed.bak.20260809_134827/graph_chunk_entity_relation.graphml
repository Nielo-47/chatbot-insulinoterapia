</edge>
<edge source="Differential Diagnosis" target="Type A Insulin Resistance Syndrome">
  <data key="d7">1.0</data>
  <data key="d8">Type A Insulin Resistance Syndrome is considered in the differential diagnosis of lipodystrophy because of its association with insulin receptor abnormalities.</data>
  <data key="d9">disease comparison,genetic insulin defect</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
