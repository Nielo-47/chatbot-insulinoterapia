  <data key="d12">1776643724</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Insulin Storage">
  <data key="d7">2.0</data>
  <data key="d8">Reusable insulin pens should not be refrigerated to prevent damage to the internal mechanism.&lt;SEP&gt;Insulin pens, especially reusable ones, should not be stored in refrigerators to avoid damage to internal mechanisms.</data>
  <data key="d9">device care,device-specific storage,mechanism protection,temperature sensitivity</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-c8702ff00244abf3caabafff5aad4a65</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Armazenamento e Transporte/transporte e conservação Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-20201.pdf</data>
