</node>
<node id="Dcct/Edic Study">
  <data key="d0">Dcct/Edic Study</data>
  <data key="d1">event</data>
  <data key="d2">The DCCT/EDIC Study combines the original DCCT trial and its long-term follow-up EDIC study to assess the impact of intensive diabetes treatment.</data>
  <data key="d3">chunk-6764f5f0af1c9855a1901ea1bef131d3</data>
