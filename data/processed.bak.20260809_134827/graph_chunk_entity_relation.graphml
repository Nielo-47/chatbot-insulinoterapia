</node>
<node id="Maturity Onset Diabetes Of The Young">
  <data key="d0">Maturity Onset Diabetes Of The Young</data>
  <data key="d1">concept</data>
  <data key="d2">A monogenic form of diabetes that typically occurs in youth and is caused by mutations in genes such as HNF1A, HNF4A, and glucokinase.</data>
  <data key="d3">chunk-f780163f31c33c2bd7449fb5a87b42ee</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647323</data>
  <data key="d6"></data>
</node>
<node id="HNF1A Gene">
  <data key="d0">HNF1A Gene</data>
  <data key="d1">artifact</data>
  <data key="d2">A gene associated with maturity onset diabetes of the young; mutations in this gene are linked to increased risk of diabetes and higher mortality.</data>
  <data key="d3">chunk-f780163f31c33c2bd7449fb5a87b42ee</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
