</edge>
<edge source="Glycemic Variability" target="Capillary Blood Glucose">
  <data key="d7">1.0</data>
  <data key="d8">Capillary Blood Glucose values can be used as an alternative to continuous monitoring for assessing glycemic variability.</data>
  <data key="d9">alternative measurement,data source</data>
