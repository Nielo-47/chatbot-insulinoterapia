</edge>
<edge source="Hepatic Steatosis" target="Cirrhosis">
  <data key="d7">1.0</data>
  <data key="d8">Hepatic steatosis may progress to cirrhosis in advanced lipodystrophy, contributing to mortality.</data>
  <data key="d9">disease progression,liver complication</data>
