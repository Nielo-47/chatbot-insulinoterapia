  <data key="d13"></data>
</edge>
<edge source="A1C Test" target="Clinical Laboratory Improvement Amendments">
  <data key="d7">1.0</data>
  <data key="d8">A1C testing must comply with CLIA regulations regarding personnel competency and proficiency testing.</data>
  <data key="d9">laboratory compliance,testing standards</data>
  <data key="d10">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
