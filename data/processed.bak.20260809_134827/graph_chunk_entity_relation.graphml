  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Insulin Lispro">
  <data key="d7">2.0</data>
  <data key="d8">Insulin lispro is used in type 1 diabetes and shows benefits in glycemic control and reduced hypoglycemia risk.&lt;SEP&gt;Insulin lispro is used in diabetes mellitus, particularly to prevent nocturnal hypoglycaemia in young children.</data>
  <data key="d9">diabetes management,safety,therapy,treatment</data>
