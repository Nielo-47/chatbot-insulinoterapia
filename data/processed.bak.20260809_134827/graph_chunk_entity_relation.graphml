</node>
<node id="6 mm Syringe">
  <data key="d0">6 mm Syringe</data>
  <data key="d1">artifact</data>
  <data key="d2">A 6 mm syringe is a type of insulin injection device with a short needle length, suitable for subcutaneous insulin administration.</data>
  <data key="d3">chunk-e883257c402587c2aedd0509191bc233</data>
