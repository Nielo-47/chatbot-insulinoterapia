  <data key="d0">Idosos com Diabetes Mellitus</data>
  <data key="d1">person</data>
  <data key="d2">Idosos com Diabetes Mellitus are elderly patients with diabetes, the focus of glycemic target recommendations in the text.</data>
  <data key="d3">chunk-d8434e93fae47721617db0727fcd99b1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
