  <data key="d12">1776641883</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin To Carbohydrate Ratio" target="Mealtime Bolus">
  <data key="d7">1.0</data>
  <data key="d8">The Insulin to Carbohydrate Ratio is used to calculate the mealtime bolus based on the grams of carbohydrates to be consumed.</data>
  <data key="d9">carbohydrate coverage,meal dosing</data>
  <data key="d10">chunk-1223db4d3629243420a6e867a9ba6988</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641881</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin To Carbohydrate Ratio" target="Daily Total Dose">
  <data key="d7">1.0</data>
  <data key="d8">Insulin to Carbohydrate Ratio is derived from the Daily Total Dose using formulas such as 450/DTD for adults or 500/DTD for children.</data>
  <data key="d9">dose calculation,meal planning</data>
  <data key="d10">chunk-1223db4d3629243420a6e867a9ba6988</data>
