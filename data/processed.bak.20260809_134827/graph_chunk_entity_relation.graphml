  <data key="d5">1776647315</data>
  <data key="d6"></data>
</node>
<node id="Diabetes.org">
  <data key="d0">Diabetes.org</data>
  <data key="d1">content</data>
  <data key="d2">Diabetes.org is a website providing information about diabetes, including risk assessment, prevention, and management resources.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647315</data>
  <data key="d6"></data>
</node>
<node id="Bang et al.">
  <data key="d0">Bang et al.</data>
  <data key="d1">person</data>
  <data key="d2">Bang et al. refers to the researchers who published the original algorithm for diabetes risk assessment in Ann Intern Med 151:775–783, 2009.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647316</data>
  <data key="d6"></data>
</node>
<node id="Myocardial Infarction">
  <data key="d0">Myocardial Infarction</data>
  <data key="d1">concept</data>
  <data key="d2">Myocardial infarction is a condition that may contribute to the development of DKA in people with type 2 diabetes.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647317</data>
  <data key="d6"></data>
</node>
<node id="Atypical Antipsychotics">
  <data key="d0">Atypical Antipsychotics</data>
  <data key="d1">artifact</data>
  <data key="d2">Atypical antipsychotics are medications associated with an increased risk of DKA in type 2 diabetes patients.&lt;SEP&gt;Atypical antipsychotics are psychiatric medications that increase the risk of diabetes and are considered when evaluating screening eligibility.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc&lt;SEP&gt;chunk-8317327cb2c248762b2dc3852c662000</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647318</data>
  <data key="d6"></data>
</node>
<node id="Sodium–Glucose Cotransporter 2 Inhibitors">
  <data key="d0">Sodium–Glucose Cotransporter 2 Inhibitors</data>
  <data key="d1">artifact</data>
  <data key="d2">Sodium–glucose cotransporter 2 inhibitors are a class of drugs that may lead to DKA in individuals with type 2 diabetes.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647318</data>
  <data key="d6"></data>
</node>
<node id="High Blood Pressure">
  <data key="d0">High Blood Pressure</data>
  <data key="d1">concept</data>
  <data key="d2">High blood pressure is a medical condition and a risk factor included in the assessment for type 2 diabetes risk.&lt;SEP&gt;High blood pressure is a health condition assessed in the ADA risk test, with a diagnosis contributing to diabetes risk score.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc&lt;SEP&gt;chunk-2a874190e40ad535ac9b317a469571d7</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647318</data>
  <data key="d6"></data>
</node>
<node id="Abdominal Fat">
  <data key="d0">Abdominal Fat</data>
  <data key="d1">concept</data>
  <data key="d2">Abdominal fat refers to increased body fat in the abdominal region, a risk factor for type 2 diabetes.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647319</data>
  <data key="d6"></data>
</node>
<node id="Ethnicity">
  <data key="d0">Ethnicity</data>
  <data key="d1">concept</data>
  <data key="d2">Ethnicity influences diabetes risk, with higher prevalence among African Americans, Hispanics/Latinos, Native Americans, Asian Americans, and Native Hawaiians and Pacific Islanders.&lt;SEP&gt;Ethnicity influences DM2 risk, with higher prevalence in ethnic minorities in the U.S., though not considered a primary risk factor in Brazil due to genetic admixture.&lt;SEP&gt;Ethnicity influences DM2 risk, with higher prevalence in ethnic minorities in the U.S., though not considered a primary risk factor in Brazil due to genetic admixture.&lt;SEP&gt;Ethnicity influences DM2 risk, with higher prevalence in ethnic minorities in the U.S., though not considered a primary risk factor in Brazil due to genetic admixture.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc&lt;SEP&gt;chunk-fd83fee2b80ad551bb282975932751ce</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1776689004</data>
  <data key="d6"></data>
</node>
<node id="Asian Americans">
  <data key="d0">Asian Americans</data>
  <data key="d1">person</data>
  <data key="d2">Asian Americans are at increased risk for type 2 diabetes at lower body weights compared to the general population.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
