  <data key="d6"></data>
</node>
<node id="23 November 1921">
  <data key="d0">23 November 1921</data>
  <data key="d1">event</data>
  <data key="d2">On 23 November 1921, Banting and Best injected themselves with a small dose of pancreatic extract to test for safety, observing no harmful effects.&lt;SEP&gt;On 23 November 1921, Banting and Best injected themselves with a small dose of pancreatic extract to test for safety, observing no harmful effects.</data>
  <data key="d3">chunk-1bf43b932b33f125e5a5e679dcb50d79</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
  <data key="d5">1776643971</data>
  <data key="d6"></data>
</node>
<node id="7 December 1921">
  <data key="d0">7 December 1921</data>
  <data key="d1">event</data>
  <data key="d2">On 7 December 1921, Marjorie and Dog #23 received pancreatic extract prepared using the alcohol method, marking an advancement in purification.&lt;SEP&gt;On 7 December 1921, Marjorie and Dog #23 received pancreatic extract prepared using the alcohol method, marking an advancement in purification.</data>
  <data key="d3">chunk-1bf43b932b33f125e5a5e679dcb50d79</data>
