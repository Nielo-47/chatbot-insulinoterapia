<edge source="Diabetes Mellitus" target="Diabetes Classification Guideline">
  <data key="d7">1.0</data>
  <data key="d8">The Diabetes Classification Guideline provides a structured classification system for Diabetes Mellitus based on etiology and pathogenesis.</data>
  <data key="d9">clinical framework,disease classification</data>
