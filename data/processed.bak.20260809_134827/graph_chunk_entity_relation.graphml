  <data key="d13"></data>
</edge>
<edge source="C-Peptide" target="Μg/L">
  <data key="d7">1.0</data>
  <data key="d8">C-peptide concentrations may also be reported in µg/L, which is equivalent to milligrams per cubic meter in environmental or specialized lab contexts.</data>
  <data key="d9">measurement,unit conversion</data>
