  <data key="d13"></data>
</edge>
<edge source="ADAG Study Group" target="Klonoﬀ Dc">
  <data key="d7">1.0</data>
  <data key="d8">Klonoﬀ DC reported findings from the ADAG Study Group linking A1C levels to blood glucose values.</data>
  <data key="d9">research affiliation,scientific contribution</data>
  <data key="d10">chunk-7203a21c31cbdae88ee8bc33914cd054</data>
