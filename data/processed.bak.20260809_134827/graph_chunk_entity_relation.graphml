  <data key="d12">1776638371</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnancy" target="Continuous Glucose Monitor">
  <data key="d7">1.0</data>
  <data key="d8">Using a continuous glucose monitor during pregnancy helps maintain target glucose levels and reduces complications.</data>
  <data key="d9">glucose management,technology benefit</data>
  <data key="d10">chunk-cd6b0367ed2176146798e5cf697d0aeb</data>
