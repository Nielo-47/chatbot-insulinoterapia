<edge source="Insulin Application" target="Paciente">
  <data key="d7">1.0</data>
  <data key="d8">The patient must learn and correctly perform insulin application as part of diabetes management.</data>
  <data key="d9">skill acquisition,treatment adherence</data>
  <data key="d10">chunk-3d0de4d525c273cda4939a501eaecc6d</data>
