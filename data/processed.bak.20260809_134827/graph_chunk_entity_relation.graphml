  <data key="d12">1776639160</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Cold Compress">
  <data key="d7">1.0</data>
  <data key="d8">Using a cold compress can slow insulin absorption and increase blood sugar levels.</data>
  <data key="d9">absorption delay,treatment interference</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
