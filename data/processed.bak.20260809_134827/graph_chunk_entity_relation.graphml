  <data key="d13"></data>
</edge>
<edge source="Renan Montenegro" target="Diabetes Classification Guideline">
  <data key="d7">1.0</data>
  <data key="d8">Renan Montenegro served as the Section Editor for the Diabetes Classification Guideline.</data>
  <data key="d9">editorial role,section editing</data>
  <data key="d10">chunk-f5847db7a558804738e20dca9fd8d746</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647008</data>
  <data key="d13"></data>
</edge>
<edge source="Vacor" target="Beta Cell Destruction">
  <data key="d7">1.0</data>
  <data key="d8">Vacor has the potential to destroy beta cells, leading to diabetes.</data>
  <data key="d9">beta cell damage,toxic effect</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647113</data>
  <data key="d13"></data>
</edge>
<edge source="Pentamidine" target="Beta Cell Destruction">
  <data key="d7">1.0</data>
  <data key="d8">Pentamidine is associated with the destruction of beta cells.</data>
  <data key="d9">drug-induced toxicity,pancreatic damage</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647114</data>
  <data key="d13"></data>
</edge>
<edge source="Nicotinic Acid" target="Beta Cell Destruction">
  <data key="d7">1.0</data>
  <data key="d8">Nicotinic Acid is linked to potential beta cell destruction.</data>
  <data key="d9">cell damage,metabolic interference</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647114</data>
  <data key="d13"></data>
</edge>
<edge source="Glucocorticoids" target="R16">
  <data key="d7">1.0</data>
  <data key="d8">R16 recommends diabetes screening before and after initiating glucocorticoid therapy due to hyperglycemic risk.</data>
  <data key="d9">medication risk,screening indication</data>
  <data key="d10">chunk-a8707947fb493803b7f3759b0105eda4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689121</data>
  <data key="d13"></data>
</edge>
<edge source="Glucocorticoids" target="Glucocorticoid-Induced Hyperglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Glucocorticoids such as prednisolone and dexamethasone can induce hyperglycemia, especially at high doses or with prolonged use.</data>
  <data key="d9">causal relationship,medication side effect</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689144</data>
  <data key="d13"></data>
</edge>
<edge source="Glucocorticoids" target="Prednisolone">
  <data key="d7">1.0</data>
  <data key="d8">Prednisolone is a glucocorticoid that can induce hyperglycemia, particularly at doses above 20 mg per day.</data>
  <data key="d9">dosage effect,drug example</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689154</data>
  <data key="d13"></data>
</edge>
<edge source="Glucocorticoids" target="Hydrocortisone">
  <data key="d7">1.0</data>
  <data key="d8">Hydrocortisone is a glucocorticoid associated with hyperglycemia when used at doses greater than 50 mg per day.</data>
  <data key="d9">dosage effect,drug example</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689155</data>
  <data key="d13"></data>
</edge>
<edge source="Glucocorticoids" target="Dexamethasone">
  <data key="d7">1.0</data>
  <data key="d8">Dexamethasone is a glucocorticoid linked to hyperglycemia, especially at doses exceeding 4 mg per day.</data>
  <data key="d9">dosage effect,drug example</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689156</data>
  <data key="d13"></data>
</edge>
<edge source="Thyroid Hormone" target="Metabolic Rate">
  <data key="d7">1.0</data>
  <data key="d8">Thyroid Hormone increases metabolic rate and can affect glucose homeostasis.</data>
  <data key="d9">glucose metabolism,hormonal regulation</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647120</data>
  <data key="d13"></data>
</edge>
<edge source="Diazoxide" target="Insulin Secretion">
  <data key="d7">1.0</data>
  <data key="d8">Diazoxide impairs insulin secretion, leading to hyperglycemia.</data>
  <data key="d9">hyperglycemia,inhibition</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647120</data>
  <data key="d13"></data>
</edge>
<edge source="Thiazides" target="Glucose Tolerance">
  <data key="d7">1.0</data>
  <data key="d8">Thiazides impair glucose tolerance and may precipitate hyperglycemia.</data>
  <data key="d9">diuretic effect,impaired</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647121</data>
  <data key="d13"></data>
</edge>
<edge source="Phenytoin" target="Glucose Metabolism">
  <data key="d7">1.0</data>
  <data key="d8">Phenytoin may interfere with glucose metabolism, affecting glycemic control.</data>
  <data key="d9">drug interference,metabolic disruption</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647121</data>
  <data key="d13"></data>
</edge>
<edge source="Congenital Rubella" target="Secondary Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Congenital Rubella can lead to secondary diabetes through destruction of pancreatic tissue.</data>
  <data key="d9">immune-mediated damage,viral etiology</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647114</data>
  <data key="d13"></data>
</edge>
<edge source="Cytomegalovirus" target="Secondary Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Cytomegalovirus infection is associated with secondary diabetes due to beta cell damage.</data>
  <data key="d9">beta cell injury,viral infection</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647115</data>
  <data key="d13"></data>
</edge>
<edge source="Latent Autoimmune Diabetes in Adults" target="Anti-GAD Antibody">
  <data key="d7">1.0</data>
  <data key="d8">The presence of anti-GAD antibodies is a key diagnostic criterion for identifying LADA.</data>
  <data key="d9">autoimmunity,diagnostic criterion</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647013</data>
  <data key="d13"></data>
</edge>
<edge source="Latent Autoimmune Diabetes in Adults" target="Serum C-Pe游戏副本eptide Levels">
  <data key="d7">1.0</data>
  <data key="d8">In LADA patients, C-peptide levels are normal or elevated initially, distinguishing it from classic Type 1 diabetes.</data>
  <data key="d9">diagnostic differentiation,insulin production</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647015</data>
  <data key="d13"></data>
</edge>
<edge source="Latent Autoimmune Diabetes in Adults" target="Triglycerides">
  <data key="d7">1.0</data>
  <data key="d8">Serum triglyceride levels &lt; 98 mg/dL are a predictive factor for LADA in adults with newly diagnosed diabetes.</data>
  <data key="d9">clinical predictor,lipid profile</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647016</data>
  <data key="d13"></data>
</edge>
<edge source="Latent Autoimmune Diabetes in Adults" target="Hdl">
  <data key="d7">1.0</data>
  <data key="d8">HDL cholesterol levels &gt; 46 mg/dL are associated with an increased likelihood of LADA in adult patients.</data>
  <data key="d9">clinical predictor,lipid profile</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647017</data>
  <data key="d13"></data>
</edge>
<edge source="Latent Autoimmune Diabetes in Adults" target="Hba1C">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c levels &gt; 8.6% are a significant clinical predictor for identifying LADA in adults with recent diabetes diagnosis.</data>
  <data key="d9">clinical predictor,glycemic control</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647017</data>
  <data key="d13"></data>
</edge>
<edge source="Latent Autoimmune Diabetes in Adults" target="Classification of Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Latent autoimmune diabetes in adults is a recognized subtype within the broader classification of diabetes.</data>
  <data key="d9">diabetes subtype,diagnostic criteria</data>
  <data key="d10">chunk-1fb7f10473b84f2de23852febe7ef317</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647195</data>
  <data key="d13"></data>
</edge>
