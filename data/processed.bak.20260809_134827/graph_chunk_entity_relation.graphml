  <data key="d13"></data>
</edge>
<edge source="Syringe" target="Patient">
  <data key="d7">1.0</data>
  <data key="d8">The patient uses a syringe to draw insulin from a vial and inject it subcutaneously.</data>
  <data key="d9">device usage,injection method</data>
