</edge>
<edge source="Injection Site Rotation" target="Insulin Application Technique">
  <data key="d7">1.0</data>
  <data key="d8">Rotating injection sites prevents lipodystrophy and ensures consistent insulin absorption.</data>
  <data key="d9">absorption,tissue health</data>
  <data key="d10">chunk-e68da6d45eb01c249e854b711007d805</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Insulinas CANETAS.pdf</data>
  <data key="d12">1776638212</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Insulin Injection Procedure">
  <data key="d7">1.0</data>
  <data key="d8">Rotating injection sites during the insulin injection procedure helps prevent lipodystrophy and ensures consistent insulin absorption.</data>
  <data key="d9">long-term care,tissue health</data>
  <data key="d10">chunk-afd148f1edc7929cecea8e4d981ed04e</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas FRASCOS.pdf</data>
  <data key="d12">1776638269</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Lipo-Hypertrophy">
  <data key="d7">2.0</data>
  <data key="d8">Proper injection site rotation helps prevent lipo-hypertrophy by avoiding repeated injections in the same area.&lt;SEP&gt;Proper injection site rotation helps prevent the development of lipo-hypertrophy.</data>
  <data key="d9">best practice,mitigation,prevention</data>
  <data key="d10">chunk-525086e26636af026c417773a8f11a92&lt;SEP&gt;chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1776640292</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Skin Lesion">
  <data key="d7">1.0</data>
  <data key="d8">Proper injection site rotation helps prevent skin lesions caused by repeated injections in the same spot.</data>
  <data key="d9">prevention,skin health</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638388</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Insulin Absorption">
  <data key="d7">1.0</data>
  <data key="d8">Rotating injection sites improves the consistency and effectiveness of insulin absorption.</data>
  <data key="d9">absorption efficiency,consistency</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638389</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Diabetes Control">
  <data key="d7">1.0</data>
  <data key="d8">Effective site rotation contributes to better diabetes control by maintaining optimal insulin performance.</data>
  <data key="d9">management,treatment efficacy</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638389</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Healthcare Team">
  <data key="d7">1.0</data>
  <data key="d8">The healthcare team helps patients adapt their injection site rotation plan, especially for those injecting insulin multiple times per day.</data>
  <data key="d9">adaptation,personalized care</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638391</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Injection Site">
  <data key="d7">1.0</data>
  <data key="d8">Injection sites should be alternated within a region and changed between body areas to allow healing and prevent tissue damage.</data>
  <data key="d9">regional change,spatial alternation</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638391</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Healthcare Professional">
  <data key="d7">3.0</data>
  <data key="d8">Healthcare professionals must assess and adjust the injection site rotation plan at every consultation according to therapy progression.&lt;SEP&gt;Healthcare professionals must teach and regularly evaluate injection site rotation plans with patients and caregivers.&lt;SEP&gt;Healthcare professionals are responsible for teaching patients how to correctly perform injection site rotation.</data>
  <data key="d9">adjustment,education,evaluation,guidance,planning</data>
  <data key="d10">chunk-8b2243846b349d5b78af57a8e77b6ff5&lt;SEP&gt;chunk-48b0f8a5b356409be05a1e866ce0ed8d&lt;SEP&gt;chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1776640294</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Proper injection site rotation prevents lipohypertrophy and glycemic instability, but improper rotation causes significant variability in insulin absorption.</data>
  <data key="d9">absorption variability,glycemic control</data>
  <data key="d10">chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639174</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Diabetes Educator">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes educators must emphasize the importance of injection site rotation and help design practical, daily-applicable schemes.</data>
  <data key="d9">education,routine planning</data>
  <data key="d10">chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639175</data>
  <data key="d13"></data>
</edge>
<edge source="Injection Site Rotation" target="Lipohipertrofia">
  <data key="d7">1.0</data>
  <data key="d8">A rotação inadequada dos locais de injeção contribui para o surgimento de lipohipertrofia, enquanto sua prática correta ajuda a prevenir a condição.</data>
  <data key="d9">best practice,prevention</data>
  <data key="d10">chunk-202f1dba3a8254f9d5867b459cdbcfa2</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/O que você precisa saber sobre Lipohipertrofia - Sociedade Brasileira de Diabetes.pdf</data>
  <data key="d12">1776640770</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Lipohypertrophy">
  <data key="d7">2.0</data>
  <data key="d8">Lipohypertrophy causes irregular insulin absorption, contributing to blood glucose variability and unexplained hypoglycemia.&lt;SEP&gt;Insulin injected into areas with lipohypertrophy is absorbed unpredictably, leading to glycemic variability, hyperglycemia, and unexplained hypoglycemia.</data>
  <data key="d9">absorption variability,metabolic impact</data>
  <data key="d10">chunk-7a2bb9a343108d712fe87613f1b48d18&lt;SEP&gt;chunk-8b2243846b349d5b78af57a8e77b6ff5</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639099</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Refrigerated Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Refrigerated insulin leads to faster absorption, earlier peak plasma levels, and higher initial glucose infusion rates compared to room temperature insulin.</data>
  <data key="d9">absorption kinetics,pharmacodynamics</data>
  <data key="d10">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1776637700</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Room Temperature Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Room temperature insulin results in slower, more prolonged absorption, with lower initial plasma insulin levels and glucose infusion rates.</data>
  <data key="d9">absorption kinetics,pharmacodynamics</data>
  <data key="d10">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1776637702</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Physical Activity">
  <data key="d7">2.0</data>
  <data key="d8">Physical activity and its timing influence insulin absorption and must be considered in injection site selection and dosing.&lt;SEP&gt;Physical activity increases the rate of insulin absorption.</data>
  <data key="d9">acceleration,metabolic effect,metabolic regulation,physiological influence</data>
  <data key="d10">chunk-7a2bb9a343108d712fe87613f1b48d18&lt;SEP&gt;chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d12">1776638701</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Insulin Dosing">
  <data key="d7">1.0</data>
  <data key="d8">Insulin dosing must account for factors affecting absorption, including site, temperature, and presence of lipodystrophy.</data>
  <data key="d9">metabolic control,treatment adjustment</data>
  <data key="d10">chunk-7a2bb9a343108d712fe87613f1b48d18</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1776637709</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Abdomen">
  <data key="d7">1.0</data>
  <data key="d8">Insulin is absorbed fastest when injected into the abdomen due to high vascularity.</data>
  <data key="d9">absorption rate,injection site</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638155</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Arms">
  <data key="d7">1.0</data>
  <data key="d8">The arms are a moderate-speed insulin absorption site, slower than the abdomen.</data>
  <data key="d9">absorption rate,injection site</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638161</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Thighs">
  <data key="d7">1.0</data>
  <data key="d8">The thighs have a slower insulin absorption rate compared to the arms and abdomen.</data>
  <data key="d9">absorption rate,injection site</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638162</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Buttocks">
  <data key="d7">1.0</data>
  <data key="d8">The buttocks are the slowest site for insulin absorption.</data>
  <data key="d9">absorption rate,injection site</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638162</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Exercise">
  <data key="d7">1.0</data>
  <data key="d8">Physical activity increases insulin absorption and can lead to hypoglycemia.</data>
  <data key="d9">accelerated absorption,hypoglycemia risk</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638163</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Heat">
  <data key="d7">1.0</data>
  <data key="d8">Exposure to heat increases insulin absorption speed and the risk of low blood sugar.</data>
  <data key="d9">accelerated absorption,hypoglycemia risk</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638163</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Cold">
  <data key="d7">1.0</data>
  <data key="d8">Cold temperatures slow insulin absorption, potentially increasing blood sugar levels.</data>
  <data key="d9">delayed absorption,elevated blood sugar</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638164</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Dehydration">
  <data key="d7">1.0</data>
  <data key="d8">Dehydration reduces insulin absorption, which may result in higher blood sugar.</data>
  <data key="d9">delayed absorption,elevated blood sugar</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638165</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Massage">
  <data key="d7">2.0</data>
  <data key="d8">Massaging the injection site increases insulin absorption and the risk of hypoglycemia and should be avoided.&lt;SEP&gt;Massaging the injection site after insulin injection accelerates absorption, increasing the risk of hypoglycemia.</data>
  <data key="d9">absorption acceleration,accelerated absorption,hypoglycemia risk,risk factor</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483&lt;SEP&gt;chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d12">1776638703</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Proper insulin absorption depends on correct injection technique and avoiding syringe reuse, which can impair absorption and cause tissue damage.</data>
  <data key="d9">effectiveness,injection technique</data>
  <data key="d10">chunk-e4654b5e9fa02cf051c2d5ebc846c5d6</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638309</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Syringe Reuse">
  <data key="d7">1.0</data>
  <data key="d8">Reusing syringes can cause pain, inflammation, and poor insulin absorption, compromising treatment effectiveness.</data>
  <data key="d9">inflammation,tissue damage</data>
  <data key="d10">chunk-e4654b5e9fa02cf051c2d5ebc846c5d6</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638309</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Lipo-Hypertrophy">
  <data key="d7">2.0</data>
  <data key="d8">Lipo-hypertrophy causes irregular insulin absorption, leading to unpredictable blood sugar control.&lt;SEP&gt;Lipo-hypertrophy causes irregular insulin absorption, leading to unpredictable blood sugar levels.</data>
  <data key="d9">absorption irregularity,dysfunction,physiological impact,treatment efficacy</data>
  <data key="d10">chunk-b91b40e47c97be1b62c0f3d271cd4efd&lt;SEP&gt;chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1776640294</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Rotation Of Injection Sites">
  <data key="d7">1.0</data>
  <data key="d8">Proper rotation of injection sites helps maintain consistent insulin absorption and effective diabetes management.</data>
  <data key="d9">consistency,treatment efficacy</data>
  <data key="d10">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638416</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Irregular insulin absorption due to lipo-hypertrophy can lead to episodes of hypoglycemia.</data>
  <data key="d9">causal relationship,metabolic effect</data>
  <data key="d10">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1776640295</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Hyperglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Irregular insulin absorption due to lipo-hypertrophy can also lead to hyperglycemia.</data>
  <data key="d9">causal relationship,metabolic effect</data>
  <data key="d10">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1776640296</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Absorption" target="Blood Glucose Variability">
  <data key="d7">1.0</data>
  <data key="d8">Poor insulin absorption from lipo-hypertrophy contributes to significant blood glucose fluctuations.</data>
  <data key="d9">causal relationship,symptom manifestation</data>
  <data key="d10">chunk-55f8c8b2b40633cf37993b620002b889</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/Documento sem título.docx</data>
  <data key="d12">1776640296</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Control" target="Diabetes Mellitus">
  <data key="d7">1.0</data>
  <data key="d8">Poor control on non-insulin therapies, low C-peptide, or early insulin need indicate progressive beta-cell failure in diabetes.</data>
  <data key="d9">beta-cell function,disease progression</data>
  <data key="d10">chunk-e575f95ec5a02f7900989e00da53749f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647187</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="Injection Technique">
  <data key="d7">1.0</data>
  <data key="d8">The needle angle is adjusted based on body fat-45° with skin pinch for thin individuals, 90° for others-to target subcutaneous tissue.</data>
  <data key="d9">administration precision,tissue targeting</data>
  <data key="d10">chunk-54575ceb6b15fc8abcc2afcec7b36792</data>
  <data key="d11">data/raw/Documento sem título.docx</data>
  <data key="d12">1776637862</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="4 mm Needle">
  <data key="d7">1.0</data>
  <data key="d8">A 4 mm needle can be injected at a 90-degree angle to ensure proper subcutaneous delivery.</data>
  <data key="d9">injection technique,subcutaneous delivery</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638162</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="5 mm Needle">
  <data key="d7">1.0</data>
  <data key="d8">A 5 mm needle can be used at a 90-degree angle for correct subcutaneous insulin administration.</data>
  <data key="d9">injection technique,subcutaneous delivery</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638163</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="6 mm Needle">
  <data key="d7">1.0</data>
  <data key="d8">A 6 mm needle requires an angle between 45° and 90° in adults and 45° in children to prevent intramuscular injection.</data>
  <data key="d9">injection technique,patient variation</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638163</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="8 mm Needle">
  <data key="d7">1.0</data>
  <data key="d8">An 8 mm needle should be injected at an angle between 45° and 90° in adults and 45° in children for safe use.</data>
  <data key="d9">injection technique,patient variation</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638164</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="Needle Longer Than 8 mm">
  <data key="d7">1.0</data>
  <data key="d8">Needles longer than 8 mm must be injected at 45° and are not recommended for children due to intramuscular risk.</data>
  <data key="d9">injection technique,pediatric restriction</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638165</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="Needle">
  <data key="d7">2.0</data>
  <data key="d8">The needle should be inserted at the angle specified by a healthcare professional to ensure correct insulin delivery.&lt;SEP&gt;The recommended needle angle for insulin injection depends on the length of the needle being used.</data>
  <data key="d9">equipment specification,injection technique,proper administration,technical parameter</data>
  <data key="d10">chunk-c897fc79a7dde2715e95be7ca23f57f5&lt;SEP&gt;chunk-5bbc7b2df438b8290a4da57f63f1ff5d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639187</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="Adolescents">
  <data key="d7">1.0</data>
  <data key="d8">Adolescents should use a 45° needle angle during insulin injection, especially with longer needles.</data>
  <data key="d9">age-specific protocol,injection technique</data>
  <data key="d10">chunk-5bbc7b2df438b8290a4da57f63f1ff5d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639188</data>
  <data key="d13"></data>
</edge>
<edge source="Needle Angle" target="Adults">
  <data key="d7">1.0</data>
  <data key="d8">Adults may use a 45° to 90° needle angle depending on subcutaneous tissue thickness and needle length.</data>
  <data key="d9">individualized care,injection technique</data>
  <data key="d10">chunk-5bbc7b2df438b8290a4da57f63f1ff5d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639189</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnant Women" target="Abdomen">
  <data key="d7">4.0</data>
  <data key="d8">Pregnant women should consult a doctor before injecting insulin in the abdomen and avoid it in the third trimester.&lt;SEP&gt;Pregnant women should avoid insulin injection in the abdomen during the third trimester to prevent risks to the baby.&lt;SEP&gt;The abdomen is a safe insulin injection site for pregnant women during the first and second trimesters when using a 4mm needle and subcutaneous fold.&lt;SEP&gt;Insulin injection in the abdomen is not recommended during the third trimester of pregnancy due to uterine expansion and tissue thinning.</data>
  <data key="d9">contraindication,injection site adjustment,medical consultation,safe injection site,safety,site restriction,trimester,trimester-specific guideline</data>
  <data key="d10">chunk-8abf9336f83edf5c92071da1032dc483&lt;SEP&gt;chunk-ae9010ed1abd5a5160b82713c862d22f&lt;SEP&gt;chunk-c897fc79a7dde2715e95be7ca23f57f5&lt;SEP&gt;chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/DOC Completo.docx&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639177</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnant Women" target="Subcutaneous Fold">
  <data key="d7">2.0</data>
  <data key="d8">Pregnant women are recommended to use the subcutaneous fold technique during insulin administration for safety.&lt;SEP&gt;Pregnant women should use the subcutaneous fold technique during insulin injection for safety.</data>
  <data key="d9">injection safety,patient safety,prenatal care,recommended use</data>
  <data key="d10">chunk-708e3c514f667dc9979cfa8df875e473&lt;SEP&gt;chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx&lt;SEP&gt;data/raw/DOC Completo.docx</data>
  <data key="d12">1776638411</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnant Women" target="45° Injection Angle">
  <data key="d7">1.0</data>
  <data key="d8">Pregnant women are advised to use a 45° angle for insulin injection due to stretched abdominal skin.</data>
  <data key="d9">pregnancy adaptation,technique</data>
  <data key="d10">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638328</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnant Women" target="45° Angle">
  <data key="d7">1.0</data>
  <data key="d8">Pregnant women should use a 45° angle for insulin injection to ensure proper delivery into subcutaneous tissue.</data>
  <data key="d9">injection technique,safety</data>
  <data key="d10">chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639176</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnant Women" target="Uterine Injury">
  <data key="d7">1.0</data>
  <data key="d8">Improper insulin injection technique in pregnant women, especially in the third trimester, poses a risk of uterine injury.</data>
  <data key="d9">prevention,risk</data>
  <data key="d10">chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639178</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnant Women" target="Injection Site">
  <data key="d7">1.0</data>
  <data key="d8">Pregnant women should avoid abdominal insulin injections in the third trimester due to anatomical changes.</data>
  <data key="d9">clinical consideration,safety</data>
  <data key="d10">chunk-5bbc7b2df438b8290a4da57f63f1ff5d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639188</data>
  <data key="d13"></data>
</edge>
<edge source="Healthcare Team" target="Glycemic Control">
  <data key="d7">1.0</data>
  <data key="d8">The healthcare team helps adjust insulin and diet based on glucose monitoring results.</data>
  <data key="d9">medical support,treatment adjustment</data>
  <data key="d10">chunk-cd6b0367ed2176146798e5cf697d0aeb</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638387</data>
  <data key="d13"></data>
</edge>
<edge source="Healthcare Team" target="Disposal Of Syringes And Needles">
  <data key="d7">1.0</data>
  <data key="d8">The healthcare team should handle the disposal of syringes and needles to prevent accidents and protect the environment.</data>
  <data key="d9">proper disposal,safety</data>
  <data key="d10">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d12">1776638701</data>
  <data key="d13"></data>
</edge>
<edge source="Healthcare Team" target="Patient">
  <data key="d7">1.0</data>
  <data key="d8">The healthcare team provides patients with instructions on insulin use, site rotation, and disposal.</data>
  <data key="d9">guidance,medical advice</data>
  <data key="d10">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
  <data key="d12">1776638703</data>
  <data key="d13"></data>
</edge>
<edge source="Healthcare Team" target="Insulin Injection Site">
  <data key="d7">1.0</data>
  <data key="d8">The healthcare team provides recommendations on appropriate insulin injection sites based on individual activity patterns.</data>
  <data key="d9">medical guidance,personalized care</data>
  <data key="d10">chunk-ca576cb8eccfdd91ed235c273f829e81</data>
