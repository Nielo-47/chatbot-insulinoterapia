  <data key="d6"></data>
</node>
<node id="Acidente Vascular Cerebral">
  <data key="d0">Acidente Vascular Cerebral</data>
  <data key="d1">event</data>
  <data key="d2">Acidente Vascular Cerebral is a vascular event whose risk is elevated in individuals with high glycemic levels or diagnosed diabetes mellitus.&lt;SEP&gt;Acidente Vascular Cerebral is a vascular event whose risk is elevated in individuals with high glycemic levels or diagnosed diabetes mellitus.&lt;SEP&gt;Acidente vascular cerebral is a cardiovascular event monitored in diabetes studies, also known as AVC.</data>
