  <data key="d5">1776643578</data>
  <data key="d6"></data>
</node>
<node id="U-40 Insulin">
  <data key="d0">U-40 Insulin</data>
  <data key="d1">product</data>
  <data key="d2">U-40 insulin is an older insulin concentration used in veterinary medicine and certain parts of the world.&lt;SEP&gt;U-40 insulin is a lower concentration insulin used in veterinary medicine and older formulations, requiring specific syringes for accurate dosing.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b&lt;SEP&gt;chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
