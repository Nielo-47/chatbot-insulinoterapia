<node id="Técnicas De Aplicação De Insulina">
  <data key="d0">Técnicas De Aplicação De Insulina</data>
  <data key="d1">method</data>
  <data key="d2">Técnicas de aplicação de insulina refer to the various methods and best practices for administering insulin, including injection site rotation and proper needle use.</data>
  <data key="d3">chunk-8fc83e266bdeb54c4139a50adf2b793a</data>
