  <data key="d12">1776689054</data>
  <data key="d13"></data>
</edge>
<edge source="Pré-Diabetes" target="Estudo STAND">
  <data key="d7">1.0</data>
  <data key="d8">The Estudo STAND evaluated the prevalence of prediabetes in young adults using OGTT and HbA1c.</data>
  <data key="d9">diagnosis,prevalence study</data>
  <data key="d10">chunk-ff472f3e453a6a19ce0b0606ae3427a7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689204</data>
  <data key="d13"></data>
</edge>
<edge source="Pré-Diabetes" target="Adultos Jovens">
  <data key="d7">1.0</data>
  <data key="d8">In young adults with high BMI and additional risk factors, the prevalence of prediabetes was found to be 18.1% in the STAND study.</data>
  <data key="d9">prevalence,risk factors</data>
  <data key="d10">chunk-ff472f3e453a6a19ce0b0606ae3427a7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
