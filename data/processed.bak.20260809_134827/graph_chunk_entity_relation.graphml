  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Tomar As Medicações E/ou Insulina">
  <data key="d7">1.0</data>
  <data key="d8">Medications and/or insulin are used to prevent or manage hiperglicemia.</data>
  <data key="d9">glucose regulation,treatment</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
