</node>
<node id="Blood Glucose Meter">
  <data key="d0">Blood Glucose Meter</data>
  <data key="d1">artifact</data>
  <data key="d2">A blood glucose meter is a medical device used to measure blood glucose levels from a small blood sample.</data>
  <data key="d3">chunk-7c03aef84b96134fc1f0a2a4d8466e0d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
