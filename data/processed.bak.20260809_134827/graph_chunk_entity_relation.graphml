  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="A1C">
  <data key="d7">1.0</data>
  <data key="d8">A1C levels rise before clinical onset of type 1 diabetes, making it a useful biomarker for early detection.</data>
