<node id="Conselho Federal De Farmácia">
  <data key="d0">Conselho Federal De Farmácia</data>
  <data key="d1">organization</data>
  <data key="d2">O Conselho Federal de Farmácia é uma entidade que apoia institucionalmente o uso de canetas reutilizáveis de insulina no SUS.</data>
  <data key="d3">chunk-de80027ca96b7501497bcb85811b669d</data>
