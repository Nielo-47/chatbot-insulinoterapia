  <data key="d13"></data>
</edge>
<edge source="Estudo Emerging Risk Factors Collaboration" target="Acidente Vascular Cerebral">
  <data key="d7">1.0</data>
  <data key="d8">The study showed that diagnosed diabetes or fasting glucose ≥126 mg/dl doubles the risk of stroke.</data>
  <data key="d9">risk assessment,stroke outcomes</data>
  <data key="d10">chunk-8fd2d58abc8f20df1ff7ae241f4cfee7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689055</data>
  <data key="d13"></data>
</edge>
<edge source="Estudo Emerging Risk Factors Collaboration" target="Morte Vascular">
  <data key="d7">1.0</data>
  <data key="d8">The study demonstrated that diagnosed diabetes or fasting glucose ≥126 mg/dl doubles the risk of vascular death.</data>
  <data key="d9">mortality outcomes,risk assessment</data>
  <data key="d10">chunk-8fd2d58abc8f20df1ff7ae241f4cfee7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
