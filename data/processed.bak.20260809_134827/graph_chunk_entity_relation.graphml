<edge source="R6" target="Rastreamento Para Diabetes Mellitus Tipo 2">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation R6 states that screening for Type 2 Diabetes is advised for individuals aged 35 or older and for adults with overweight or obesity plus additional risk factors.</data>
  <data key="d9">clinical recommendation,screening guideline</data>
  <data key="d10">chunk-4e72b56afa6bad1b13c937a3ff9bd13d</data>
