  <data key="d13"></data>
</edge>
<edge source="Acidente Vascular Cerebral" target="Meta-Análise">
  <data key="d7">1.0</data>
  <data key="d8">The meta-analysis did not show a statistically significant reduction in stroke (AVC) risk with lower HbA1c.</data>
  <data key="d9">risk assessment,statistical outcome</data>
  <data key="d10">chunk-d39cd334b01ad820816bf3cb108c0e27</data>
