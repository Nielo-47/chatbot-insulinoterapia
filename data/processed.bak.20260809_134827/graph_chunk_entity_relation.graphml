  <data key="d6"></data>
</node>
<node id="Contact Dermatitis">
  <data key="d0">Contact Dermatitis</data>
  <data key="d1">condition</data>
  <data key="d2">Contact dermatitis is a skin reaction that can occur from wearing CGM devices, including both irritant and allergic types.&lt;SEP&gt;Contact dermatitis is a skin condition caused by allergens such as isobornyl acrylate in medical adhesives, which can affect device usability.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0&lt;SEP&gt;chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
