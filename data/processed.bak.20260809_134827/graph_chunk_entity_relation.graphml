  <data key="d6"></data>
</node>
<node id="DQB1">
  <data key="d0">DQB1</data>
  <data key="d1">concept</data>
  <data key="d2">DQB1 is a gene haplotype linked to increased risk of type 1 diabetes through its role in immune regulation.&lt;SEP&gt;DQB1 is a gene haplotype linked to increased risk of type 1 diabetes through its role in immune regulation.</data>
  <data key="d3">chunk-620e2d1316d6093170f1c9991caabc7e</data>
