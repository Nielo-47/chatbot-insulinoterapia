</edge>
<edge source="Insulin NPH" target="Pharmacodynamics">
  <data key="d7">1.0</data>
  <data key="d8">Non-resuspended Insulin NPH shows altered pharmacodynamics, contributing to increased glycemic variability in type 1 diabetes.</data>
  <data key="d9">clinical effect,glucose response</data>
