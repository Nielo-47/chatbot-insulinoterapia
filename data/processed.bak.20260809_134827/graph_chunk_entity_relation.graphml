  <data key="d6"></data>
</node>
<node id="Morisky Medication Adherence Scale">
  <data key="d0">Morisky Medication Adherence Scale</data>
  <data key="d1">method</data>
  <data key="d2">The Morisky Medication Adherence Scale is a tool used to assess patient adherence to medication, showing improvement in patients who received structured education.</data>
  <data key="d3">chunk-a7740b86f0b3f110bb2c3f3d05e4da41</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
