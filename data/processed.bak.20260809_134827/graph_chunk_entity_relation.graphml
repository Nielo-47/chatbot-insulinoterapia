  <data key="d13"></data>
</edge>
<edge source="Glycemic Variability" target="Blood Glucose">
  <data key="d7">1.0</data>
  <data key="d8">Glycemic variability quantifies the extent of blood glucose swings throughout the day, with lower variability associated with better diabetes outcomes.</data>
  <data key="d9">fluctuation measurement,stability</data>
