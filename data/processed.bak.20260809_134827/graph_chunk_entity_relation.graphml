  <data key="d12">1776647017</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mitocondrial" target="Surdez">
  <data key="d7">1.0</data>
  <data key="d8">Hearing loss is a key clinical feature associated with mitochondrial diabetes and aids in its diagnosis.</data>
  <data key="d9">clinical association,comorbidity</data>
  <data key="d10">chunk-fe02e01a76e16ee223061696b4bcb10b</data>
