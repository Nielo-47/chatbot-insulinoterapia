  <data key="d5">1776643665</data>
  <data key="d6"></data>
</node>
<node id="Hydroxyurea">
  <data key="d0">Hydroxyurea</data>
  <data key="d1">substance</data>
  <data key="d2">Hydroxyurea is a medication that can interfere with the accuracy of Dexcom G6 and Medtronic Guardian CGM systems.&lt;SEP&gt;Hydroxyurea is a medication used for myeloproliferative disorders and hematologic conditions that causes temporary increases in sensor glucose values, leading to inaccuracies.&lt;SEP&gt;Hydroxyurea is a medication identified as causing interference with continuous glucose monitoring systems.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0&lt;SEP&gt;chunk-1319c06eac1875d14b345f09579021be&lt;SEP&gt;chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
