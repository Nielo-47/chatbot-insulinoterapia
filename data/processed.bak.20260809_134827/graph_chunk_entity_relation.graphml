  <data key="d12">1776639965</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Vial" target="Insulin Application">
  <data key="d7">2.0</data>
  <data key="d8">The rubber stopper of the insulin vial must be disinfected before each use during insulin application.&lt;SEP&gt;The insulin vial must be rolled gently about 20 times to mix suspension without creating bubbles that could affect dosage.</data>
  <data key="d9">aseptic technique,dosage accuracy,drug handling,preparation</data>
  <data key="d10">chunk-035472811a4a16d98e62eba23a86dceb&lt;SEP&gt;chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638134</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Vial" target="Alcohol 70%">
  <data key="d7">1.0</data>
  <data key="d8">Alcohol 70% is used to disinfect the rubber stopper of the insulin vial before needle insertion.</data>
  <data key="d9">aseptic procedure,disinfection</data>
  <data key="d10">chunk-035472811a4a16d98e62eba23a86dceb</data>
