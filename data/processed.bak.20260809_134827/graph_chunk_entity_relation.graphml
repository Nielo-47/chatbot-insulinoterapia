  <data key="d0">A. Petersmann</data>
  <data key="d1">person</data>
  <data key="d2">A. Petersmann is an author who contributed to the definition, classification, and diagnosis of diabetes mellitus in a 2019 publication.</data>
  <data key="d3">chunk-1fb7f10473b84f2de23852febe7ef317</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
