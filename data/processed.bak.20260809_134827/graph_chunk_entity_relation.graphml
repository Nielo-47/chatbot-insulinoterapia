  <data key="d12">1776644107</data>
  <data key="d13"></data>
</edge>
<edge source="Continuous Glucose Monitoring" target="Asymptomatic Hypoglycemia">
  <data key="d7">2.0</data>
  <data key="d8">CGM is especially useful for individuals with asymptomatic hypoglycemia who cannot sense low glucose levels.&lt;SEP&gt;CGM is especially useful for individuals with asymptomatic hypoglycemia by detecting low glucose levels before symptoms occur.</data>
  <data key="d9">clinical benefit,early detection,risk detection,symptom monitoring</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161&lt;SEP&gt;chunk-08c7f7bb0209cabd75e27f9c8556c214</data>
