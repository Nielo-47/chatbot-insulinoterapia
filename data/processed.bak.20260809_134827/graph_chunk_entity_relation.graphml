  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Large-Scale Screening">
  <data key="d7">1.0</data>
  <data key="d8">Large-scale screening is used to detect type 1 diabetes risk in populations such as children in Colorado.</data>
