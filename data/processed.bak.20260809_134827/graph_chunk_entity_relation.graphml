  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Family History">
  <data key="d7">1.0</data>
  <data key="d8">Family history helps differentiate between type 1, type 2, and monogenic forms of diabetes.</data>
  <data key="d9">genetic predisposition,inheritance pattern</data>
