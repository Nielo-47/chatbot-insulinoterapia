  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="TTGO 1h">
  <data key="d7">1.0</data>
  <data key="d8">TTGO-1h with a blood glucose level ≥ 209 mg/dl is recommended as a criterion for diagnosing type 2 diabetes.&gt;</data>
  <data key="d9">diagnosis,prediction</data>
  <data key="d10">chunk-fcce093409f85a2fbec9a754f86c8e4e</data>
