  <data key="d6"></data>
</node>
<node id="Sensor Interference">
  <data key="d0">Sensor Interference</data>
  <data key="d1">concept</data>
  <data key="d2">Sensor interference refers to inaccuracies in CGM readings caused by medications, substances, or physiological factors.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
