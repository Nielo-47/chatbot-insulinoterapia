<node id="Supervised Hotel Setting">
  <data key="d0">Supervised Hotel Setting</data>
  <data key="d1">location</data>
  <data key="d2">The supervised hotel setting is a controlled environment used to evaluate closed-loop insulin delivery systems in prepubertal patients with type 1 diabetes.</data>
  <data key="d3">chunk-1eea5927c2474e7c5774b94980fc8b78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
