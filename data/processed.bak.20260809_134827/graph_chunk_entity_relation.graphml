</edge>
<edge source="Table 2.5" target="Diagnosis of Prediabetes">
  <data key="d7">1.0</data>
  <data key="d8">Table 2.5 provides the diagnostic criteria for prediabetes applicable to children, adolescents, and adults.</data>
  <data key="d9">diagnostic criteria,reference standard</data>
