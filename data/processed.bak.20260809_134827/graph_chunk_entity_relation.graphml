<edge source="Diabetes Mellitus" target="Multicenter AIDS Cohort Study">
  <data key="d7">1.0</data>
  <data key="d8">The Multicenter AIDS Cohort Study found a higher incidence of diabetes in HIV-positive men compared to HIV-negative men over four years.</data>
  <data key="d9">epidemiological evidence,risk association</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
