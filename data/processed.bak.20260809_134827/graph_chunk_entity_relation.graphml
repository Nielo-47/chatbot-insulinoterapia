  <data key="d2">Gestação refers to pregnancy, a condition for which specific glycemic control targets are defined.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644198</data>
  <data key="d6"></data>
</node>
<node id="DM Na Gestação">
  <data key="d0">DM Na Gestação</data>
  <data key="d1">concept</data>
  <data key="d2">DM Na Gestação refers to diabetes mellitus during pregnancy, requiring specific glycemic control.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644198</data>
  <data key="d6"></data>
</node>
<node id="1 Hora Pós-Prandial">
  <data key="d0">1 Hora Pós-Prandial</data>
  <data key="d1">concept</data>
  <data key="d2">1 Hora Pós-Prandial refers to one hour after a meal, a time point for measuring postprandial blood glucose levels.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="2 Horas Pós-Prandial">
  <data key="d0">2 Horas Pós-Prandial</data>
  <data key="d1">concept</data>
  <data key="d2">2 Horas Pós-Prandial refers to two hours after a meal, a standard time point for assessing glycemic control.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="Referências Bibliográficas">
  <data key="d0">Referências Bibliográficas</data>
  <data key="d1">content</data>
  <data key="d2">Referências Bibliográficas lists scientific studies and guidelines supporting glycemic control recommendations.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Control and Complications Trial Research Group">
  <data key="d0">Diabetes Control and Complications Trial Research Group</data>
  <data key="d1">organization</data>
  <data key="d2">Diabetes Control and Complications Trial Research Group is a research consortium that studied intensive diabetes treatment outcomes.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="UK Prospective Diabetes Study Group">
  <data key="d0">UK Prospective Diabetes Study Group</data>
  <data key="d1">organization</data>
  <data key="d2">UK Prospective Diabetes Study Group conducted long-term research on type 2 diabetes management and complications.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="American Association of Clinical Endocrinologists">
  <data key="d0">American Association of Clinical Endocrinologists</data>
  <data key="d1">organization</data>
  <data key="d2">American Association of Clinical Endocrinologists is a professional organization involved in diabetes management guidelines.&lt;SEP&gt;The American Association of Clinical Endocrinologists (AACE) is a professional organization that issued a consensus statement on lipodystrophy detection.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57&lt;SEP&gt;chunk-ccde7bd12284b1c344a961b0f935b651</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646975</data>
  <data key="d6"></data>
</node>
<node id="American College of Endocrinology">
  <data key="d0">American College of Endocrinology</data>
  <data key="d1">organization</data>
  <data key="d2">American College of Endocrinology collaborates on clinical guidelines for diabetes care.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="International Diabetes Federation Clinical Guidelines Task Force">
  <data key="d0">International Diabetes Federation Clinical Guidelines Task Force</data>
  <data key="d1">organization</data>
  <data key="d2">International Diabetes Federation Clinical Guidelines Task Force develops global standards for diabetes care.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="American Congress of Obstetricians and Gynecologists">
  <data key="d0">American Congress of Obstetricians and Gynecologists</data>
  <data key="d1">organization</data>
  <data key="d2">American Congress of Obstetricians and Gynecologists is the full name of ACOG, a professional organization providing clinical guidelines for obstetrics and diabetes in pregnancy.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644199</data>
  <data key="d6"></data>
</node>
<node id="Canadian Diabetes Association">
  <data key="d0">Canadian Diabetes Association</data>
  <data key="d1">organization</data>
  <data key="d2">Canadian Diabetes Association is the full name of CDA, responsible for diabetes guidelines in Canada.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644200</data>
  <data key="d6"></data>
</node>
<node id="Intensive Glucose Lowering">
  <data key="d0">Intensive Glucose Lowering</data>
  <data key="d1">method</data>
  <data key="d2">Intensive Glucose Lowering is a treatment approach aimed at tightly controlling blood glucose levels to reduce diabetes complications.</data>
  <data key="d3">chunk-aebc875b323050c4274610952a881b57</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/ref.pdf</data>
  <data key="d5">1776644200</data>
  <data key="d6"></data>
</node>
<node id="Fingerstick Glucose Test">
  <data key="d0">Fingerstick Glucose Test</data>
  <data key="d1">method</data>
  <data key="d2">The fingerstick glucose test, also known as capillary blood glucose self-monitoring (AMGC), involves pricking the finger to obtain a blood sample for measuring glucose levels using a glucometer.</data>
  <data key="d3">chunk-a79d0e4d0f656bd87d2d0c4657378db4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644579</data>
  <data key="d6"></data>
</node>
<node id="Blood Sugar Control">
  <data key="d0">Blood Sugar Control</data>
  <data key="d1">concept</data>
  <data key="d2">Blood sugar control refers to the process of maintaining glucose levels within a target range to manage diabetes and prevent long-term complications.&lt;SEP&gt;Blood sugar control refers to maintaining glucose levels within a safe range to prevent diabetes complications.</data>
  <data key="d3">chunk-a79d0e4d0f656bd87d2d0c4657378db4&lt;SEP&gt;chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644579</data>
  <data key="d6"></data>
</node>
<node id="AMGC">
  <data key="d0">AMGC</data>
  <data key="d1">method</data>
  <data key="d2">AMGC, or Automonitorização da Glicemia Capilar, is the technical term for the fingerstick glucose test, where a drop of blood is analyzed using a glucometer to measure current blood glucose levels.</data>
  <data key="d3">chunk-a79d0e4d0f656bd87d2d0c4657378db4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644581</data>
  <data key="d6"></data>
</node>
<node id="Immune System">
  <data key="d0">Immune System</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The immune system is the body's defense mechanism, which in diabetes type 1 mistakenly attacks insulin-producing cells in the pancreas.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644582</data>
  <data key="d6"></data>
</node>
<node id="Heart Attack">
  <data key="d0">Heart Attack</data>
  <data key="d1">event</data>
  <data key="d2">Heart attack is a cardiovascular complication associated with diabetes, increased by poor blood sugar control.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644583</data>
  <data key="d6"></data>
</node>
<node id="Stroke">
  <data key="d0">Stroke</data>
  <data key="d1">event</data>
  <data key="d2">Stroke is a cerebrovascular event linked to diabetes, resulting from damaged blood vessels in the brain.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644585</data>
  <data key="d6"></data>
</node>
<node id="Urine Sugar Test">
  <data key="d0">Urine Sugar Test</data>
  <data key="d1">method</data>
  <data key="d2">Urine sugar test was an early home method introduced in 1925 to detect glucose in urine as an indicator of high blood sugar.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644586</data>
  <data key="d6"></data>
</node>
<node id="Non-Invasive Glucose Sensor">
  <data key="d0">Non-Invasive Glucose Sensor</data>
  <data key="d1">artifact</data>
  <data key="d2">Non-invasive glucose sensors are emerging devices that measure glucose using light or heat without requiring a finger prick.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644587</data>
  <data key="d6"></data>
</node>
<node id="Glucose Monitoring Watch">
  <data key="d0">Glucose Monitoring Watch</data>
  <data key="d1">artifact</data>
  <data key="d2">A glucose monitoring watch is a wearable device under development that functions like a watch to track glucose levels.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644587</data>
  <data key="d6"></data>
</node>
<node id="Glucose Contact Lens">
  <data key="d0">Glucose Contact Lens</data>
  <data key="d1">artifact</data>
  <data key="d2">A glucose contact lens is an experimental device designed as a lens to monitor glucose levels through the eye.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644588</data>
  <data key="d6"></data>
</node>
<node id="Glucose Tattoo Sensor">
  <data key="d0">Glucose Tattoo Sensor</data>
  <data key="d1">artifact</data>
  <data key="d2">A glucose tattoo sensor is an experimental skin-applied sensor that displays glucose readings through the skin.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644588</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Monitoring">
  <data key="d0">Diabetes Monitoring</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes monitoring refers to the process of tracking blood glucose levels using various methods and devices to manage diabetes effectively.</data>
  <data key="d3">chunk-22078404beeceb5adc3e688d239c585e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644588</data>
  <data key="d6"></data>
</node>
<node id="Fita">
  <data key="d0">Fita</data>
  <data key="d1">artifact</data>
  <data key="d2">Fita is a test strip used in a glicosímetro to analyze blood glucose levels; it must be within its expiration date and properly coded to match the device.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644588</data>
  <data key="d6"></data>
</node>
<node id="Sistema De Monitoramento Contínuo De Glicose">
  <data key="d0">Sistema De Monitoramento Contínuo De Glicose</data>
  <data key="d1">method</data>
  <data key="d2">Sistema De Monitoramento Contínuo De Glicose (SMCG) is a method for continuously tracking glucose levels using a subcutaneous sensor, offering 24-hour monitoring without repeated finger pricks.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644589</data>
  <data key="d6"></data>
</node>
<node id="Braço">
  <data key="d0">Braço</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Braço is a common site for attaching a continuous glucose sensor.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644591</data>
  <data key="d6"></data>
</node>
<node id="Barriga">
  <data key="d0">Barriga</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Barriga is another common site for attaching a continuous glucose sensor.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644591</data>
  <data key="d6"></data>
</node>
<node id="Dedo">
  <data key="d0">Dedo</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Dedo refers to the fingers used for blood sampling in glucose testing, with punctures recommended on the lateral side to reduce pain and complications.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644592</data>
  <data key="d6"></data>
</node>
<node id="Coroa Do Dedo">
  <data key="d0">Coroa Do Dedo</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Coroa Do Dedo is the lateral tip area of the finger recommended for puncture due to being less painful and safer.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644592</data>
  <data key="d6"></data>
</node>
<node id="Água E Sabão">
  <data key="d0">Água E Sabão</data>
  <data key="d1">artifact</data>
  <data key="d2">Água E Sabão is used to clean hands before glucose testing to remove sugar residues that could interfere with results.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644592</data>
  <data key="d6"></data>
</node>
<node id="Toalha Limpa">
  <data key="d0">Toalha Limpa</data>
  <data key="d1">artifact</data>
  <data key="d2">Toalha Limpa is used to dry hands thoroughly after washing to prevent altered glucose test results.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644592</data>
  <data key="d6"></data>
</node>
<node id="Caderno">
  <data key="d0">Caderno</data>
  <data key="d1">artifact</data>
  <data key="d2">Caderno is a physical notebook used to manually record glucose levels and related observations for medical review.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644593</data>
  <data key="d6"></data>
</node>
<node id="Planilha De Controle">
  <data key="d0">Planilha De Controle</data>
  <data key="d1">content</data>
  <data key="d2">Planilha De Controle is a spreadsheet used to log glucose readings and associated data for tracking and treatment adjustment.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644593</data>
  <data key="d6"></data>
</node>
<node id="Sensor Cego Ou Profissional">
  <data key="d0">Sensor Cego Ou Profissional</data>
  <data key="d1">method</data>
  <data key="d2">Sensor “cego” ou profissional (retro-SMCG) grava dados de glicose sem exibi-los ao paciente, permitindo que o médico os analise posteriormente para identificar eventos como hipoglicemias noturnas e variações assintomáticas.&lt;SEP&gt;Sensor Cego Ou Profissional is a type of continuous glucose monitoring system used for retrospective data analysis, often by healthcare professionals to assess patient glucose patterns.</data>
  <data key="d3">chunk-545c19428427ece2c838e352e759e388&lt;SEP&gt;chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644594</data>
  <data key="d6"></data>
</node>
<node id="Sensor Em Tempo Real">
  <data key="d0">Sensor Em Tempo Real</data>
  <data key="d1">equipment</data>
  <data key="d2">Sensor em tempo real (tR-SMCG) mostra os níveis de glicose em tempo real e transmite os dados diretamente para o celular ou bomba de insulina, sendo usado continuamente por longos períodos.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644594</data>
  <data key="d6"></data>
</node>
<node id="Tendência De Glicose">
  <data key="d0">Tendência De Glicose</data>
  <data key="d1">concept</data>
  <data key="d2">Tendência de glicose refere-se à direção e velocidade das mudanças nos níveis de açúcar no sangue, como subida ou descida, ajudando na previsão de crises.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644596</data>
  <data key="d6"></data>
</node>
<node id="Controle De Glicemia">
  <data key="d0">Controle De Glicemia</data>
  <data key="d1">concept</data>
  <data key="d2">Controle de glicemia é o monitoramento e ajuste dos níveis de açúcar no sangue, facilitado pelo uso de sensores contínuos.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644596</data>
  <data key="d6"></data>
</node>
<node id="Calibração De Sensor">
  <data key="d0">Calibração De Sensor</data>
  <data key="d1">method</data>
  <data key="d2">Calibração de sensor é o processo de ajuste do dispositivo com medições de glicose por furo no dedo, exigido por alguns modelos de sensores.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644596</data>
  <data key="d6"></data>
</node>
<node id="Real-Time Glucose Monitoring">
  <data key="d0">Real-Time Glucose Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Real-time glucose monitoring (tR-SMCG) is a method that continuously displays glucose levels to the user via a smartphone or insulin pump.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644596</data>
  <data key="d6"></data>
</node>
<node id="Professional Retrospective Glucose Monitoring">
  <data key="d0">Professional Retrospective Glucose Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Professional retrospective glucose monitoring (retro-SMCG) is a method where glucose data is recorded without patient visibility and later downloaded and analyzed by a healthcare provider.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644597</data>
  <data key="d6"></data>
</node>
<node id="Insulin Timing Error">
  <data key="d0">Insulin Timing Error</data>
  <data key="d1">condition</data>
  <data key="d2">Insulin timing error refers to incorrect scheduling of insulin administration, which can be identified through retrospective analysis of glucose data.</data>
  <data key="d3">chunk-5c804699375feba4c866cc3a1bc00211</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d5">1776644597</data>
  <data key="d6"></data>
</node>
<node id="Glicemia Pós-Prandial">
  <data key="d0">Glicemia Pós-Prandial</data>
  <data key="d1">concept</data>
  <data key="d2">Glicemia pós-prandial refers to blood glucose levels measured two hours after the start of main meals, with normal levels below 140 mg/dL and acceptable up to 160 mg/dL.&lt;SEP&gt;Glicemia pós-prandial refers to blood glucose levels measured 2 hours after the start of main meals, with normal values below 140 mg/dL and tolerable up to 160 mg/dL.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076&lt;SEP&gt;chunk-5acf61a3a7ae9c09040830d5a662f612</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644857</data>
  <data key="d6"></data>
</node>
<node id="Fome E Sede">
  <data key="d0">Fome E Sede</data>
  <data key="d1">concept</data>
  <data key="d2">Fome e sede are symptoms associated with hiperglicemia, indicating increased hunger and thirst.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644857</data>
  <data key="d6"></data>
</node>
<node id="Aumento Da Urina">
  <data key="d0">Aumento Da Urina</data>
  <data key="d1">concept</data>
  <data key="d2">Aumento da urina is a symptom of hiperglicemia, referring to increased frequency or volume of urination.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Cansaço E Fraqueza">
  <data key="d0">Cansaço E Fraqueza</data>
  <data key="d1">concept</data>
  <data key="d2">Cansaço e fraqueza are symptoms linked to both hiperglicemia and hipoglicemia, indicating physical exhaustion and weakness.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Difícil Cicatrização">
  <data key="d0">Difícil Cicatrização</data>
  <data key="d1">concept</data>
  <data key="d2">Difícil cicatrização refers to slow wound healing, a symptom associated with elevated blood glucose levels.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Perda Ou Ganho De Peso">
  <data key="d0">Perda Ou Ganho De Peso</data>
  <data key="d1">concept</data>
  <data key="d2">Perda ou ganho de peso refers to unexplained weight changes, which can be associated with glucose imbalance.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Dificuldade Para Enxergar">
  <data key="d0">Dificuldade Para Enxergar</data>
  <data key="d1">concept</data>
  <data key="d2">Dificuldade para enxergar refers to blurred or impaired vision, a symptom related to hiperglicemia.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Suor Excessivo">
  <data key="d0">Suor Excessivo</data>
  <data key="d1">concept</data>
  <data key="d2">Suor excessivo is a symptom of hipoglicemia, characterized by sudden and unexplained sweating.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Tontura">
  <data key="d0">Tontura</data>
  <data key="d1">concept</data>
  <data key="d2">Tontura is a symptom of hipoglicemia, indicating dizziness or lightheadedness.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Batedeira">
  <data key="d0">Batedeira</data>
  <data key="d1">concept</data>
  <data key="d2">Batedeira likely refers to palpitations or rapid heartbeat, a symptom associated with hipoglicemia.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Sensação De Fome">
  <data key="d0">Sensação De Fome</data>
  <data key="d1">concept</data>
  <data key="d2">Sensação de fome is a symptom of hipoglicemia, indicating sudden and intense hunger.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Palidez">
  <data key="d0">Palidez</data>
  <data key="d1">concept</data>
  <data key="d2">Palidez refers to paleness of the skin, a symptom observed during episodes of low blood sugar.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644858</data>
  <data key="d6"></data>
</node>
<node id="Mudança De Comportamento">
  <data key="d0">Mudança De Comportamento</data>
  <data key="d1">concept</data>
  <data key="d2">Mudança de comportamento refers to altered mental status or irritability, associated with hipoglicemia.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644859</data>
  <data key="d6"></data>
</node>
<node id="Tomar As Medicações E/ou Insulina">
  <data key="d0">Tomar As Medicações E/ou Insulina</data>
  <data key="d1">method</data>
  <data key="d2">Taking medications and/or insulin is a method used to manage blood glucose levels and prevent complications.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644859</data>
  <data key="d6"></data>
</node>
<node id="Monitorar E Controlar A Glicemia">
  <data key="d0">Monitorar E Controlar A Glicemia</data>
  <data key="d1">method</data>
  <data key="d2">Monitoring and controlling blood glucose is a key strategy in managing diabetes and preventing hyperglycemia or hypoglycemia.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644859</data>
  <data key="d6"></data>
</node>
<node id="Ter Uma Alimentação Saudável E Balanceada">
  <data key="d0">Ter Uma Alimentação Saudável E Balanceada</data>
  <data key="d1">method</data>
  <data key="d2">Maintaining a healthy and balanced diet is a preventive measure for stabilizing blood glucose levels.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644859</data>
  <data key="d6"></data>
</node>
<node id="Realizar Atividade Física">
  <data key="d0">Realizar Atividade Física</data>
  <data key="d1">method</data>
  <data key="d2">Engaging in physical activity is a recommended method to help regulate blood sugar levels.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644859</data>
  <data key="d6"></data>
</node>
<node id="mg/dL">
  <data key="d0">mg/dL</data>
  <data key="d1">unit</data>
  <data key="d2">mg/dL is a unit of measurement for blood glucose concentration, used to indicate levels in diagnostic contexts.</data>
  <data key="d3">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644860</data>
  <data key="d6"></data>
</node>
<node id="Hipoglicemia Leve">
  <data key="d0">Hipoglicemia Leve</data>
  <data key="d1">concept</data>
  <data key="d2">Hipoglicemia leve occurs when blood glucose levels are between 54 and 70 mg/dL and is treated with 15 grams of carbohydrate.</data>
  <data key="d3">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644860</data>
  <data key="d6"></data>
</node>
<node id="Hipoglicemia Moderada">
  <data key="d0">Hipoglicemia Moderada</data>
  <data key="d1">concept</data>
  <data key="d2">Hipoglicemia moderada occurs when blood glucose levels are below 54 mg/dL and requires treatment with 30 grams of carbohydrate.</data>
  <data key="d3">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d5">1776644860</data>
  <data key="d6"></data>
</node>
<node id="Teste De Glicemia">
  <data key="d0">Teste De Glicemia</data>
  <data key="d1">method</data>
  <data key="d2">Teste de glicemia is a procedure to measure blood glucose levels using a glucose meter and reactive strip.</data>
  <data key="d3">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
