</edge>
<edge source="Type 2 Diabetes" target="Preconception Care">
  <data key="d7">1.0</data>
  <data key="d8">Preconception care in individuals with preexisting diabetes leads to lower A1C and reduced risk of adverse pregnancy outcomes.</data>
