  <data key="d0">Cohorte Retrospectiva do Reino Unido</data>
  <data key="d1">event</data>
  <data key="d2">Cohorte Retrospectiva do Reino Unido is a study of over 54,803 elderly diabetic patients evaluating long-term mortality risks associated with glycemic control.</data>
  <data key="d3">chunk-d8434e93fae47721617db0727fcd99b1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
