</node>
<node id="Resíduos Perfurocortantes">
  <data key="d0">Resíduos Perfurocortantes</data>
  <data key="d1">concept</data>
  <data key="d2">Resíduos perfurocortantes refers to sharp medical waste like needles, lancets, and syringes that can cause injury and transmit diseases if not disposed of properly.</data>
  <data key="d3">chunk-13a3958ecd422660b4cd1e47e31e1b9c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1776641198</data>
  <data key="d6"></data>
</node>
<node id="Resíduos Biológicos">
  <data key="d0">Resíduos Biológicos</data>
  <data key="d1">concept</data>
  <data key="d2">Resíduos biológicos are biological waste materials generated from medical procedures that may pose health risks due to potential contamination.</data>
  <data key="d3">chunk-13a3958ecd422660b4cd1e47e31e1b9c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1776641198</data>
  <data key="d6"></data>
</node>
