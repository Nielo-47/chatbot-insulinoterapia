</node>
<node id="Class I">
  <data key="d0">Class I</data>
  <data key="d1">concept</data>
  <data key="d2">Class I refers to the recommendation classification indicating that the evidence and agreement support the use of insulin pens and fixed-needle syringes.</data>
  <data key="d3">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
