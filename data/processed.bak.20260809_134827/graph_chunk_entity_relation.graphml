  <data key="d13"></data>
</edge>
<edge source="NRTIs" target="Fat Distribution">
  <data key="d7">1.0</data>
  <data key="d8">NRTIs affect fat distribution, leading to lipohypertrophy and lipoatrophy, which are linked to insulin resistance.</data>
  <data key="d9">drug effect,metabolic change</data>
  <data key="d10">chunk-eb9c311fc732ddd262c56ddc696da954</data>
