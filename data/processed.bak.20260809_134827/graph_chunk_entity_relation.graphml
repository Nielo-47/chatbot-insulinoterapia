  <data key="d12">1776639137</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin NPH" target="Homogenization">
  <data key="d7">1.0</data>
  <data key="d8">Homogenization is essential for Insulin NPH to ensure uniform concentration and therapeutic effectiveness.</data>
  <data key="d9">efficacy,preparation requirement</data>
  <data key="d10">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639155</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin NPH" target="Long-Acting Insulin Analogs">
  <data key="d7">1.0</data>
  <data key="d8">Long-acting insulin analogs offer lower glycemic variability and reduced risk of nocturnal hypoglycemia compared to insulin NPH.</data>
  <data key="d9">comparative efficacy,safety profile</data>
  <data key="d10">chunk-a49920639f738eae3de220d132cbc081</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642346</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin NPH" target="Children and Adolescents">
  <data key="d7">1.0</data>
  <data key="d8">Children and adolescents with type 1 diabetes treated with insulin NPH experienced higher rates of severe and nocturnal hypoglycemia compared to those on insulin glargine U100.</data>
  <data key="d9">hypoglycemia risk,treatment</data>
  <data key="d10">chunk-157fbe972c55a9a0df76dbef85b43e63</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642365</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin NPH" target="Análogos De Insulina De Ação Longa">
  <data key="d7">1.0</data>
  <data key="d8">Análogos de insulina de ação longa are preferred over insulin NPH due to lower glycemic variability and reduced risk of nocturnal hypoglycemia.</data>
  <data key="d9">comparative efficacy,treatment choice</data>
  <data key="d10">chunk-993ef3cd53aca15e211c42cb48f1b4c7</data>
