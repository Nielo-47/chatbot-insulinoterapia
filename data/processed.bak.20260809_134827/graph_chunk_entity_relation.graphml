  <data key="d12">1776638132</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Cold Bath">
  <data key="d7">1.0</data>
  <data key="d8">Taking a cold bath may delay insulin action and lead to higher blood sugar.</data>
  <data key="d9">absorption delay,treatment interference</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638133</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Dehydration">
  <data key="d7">1.0</data>
  <data key="d8">Dehydration can slow insulin action and contribute to elevated blood sugar levels.</data>
  <data key="d9">absorption delay,treatment interference</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
