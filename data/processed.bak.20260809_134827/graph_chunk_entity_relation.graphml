  <data key="d12">1776641877</data>
  <data key="d13"></data>
</edge>
<edge source="Refeição Rica em Carboidrato" target="Carbohydrate-Insulin Ratio">
  <data key="d7">1.0</data>
  <data key="d8">The carbohydrate-insulin ratio (RIC) is used to calculate the bolus insulin dose required for meals high in carbohydrates.</data>
  <data key="d9">insulin calculation,meal coverage</data>
  <data key="d10">chunk-b266ecc39f9ba0b5277aacb36089b4db</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641875</data>
  <data key="d13"></data>
</edge>
<edge source="Refeição Rica em Gordura" target="Fat-Insulin Ratio">
  <data key="d7">1.0</data>
  <data key="d8">The fat-insulin ratio (RGI) determines the insulin needed to cover calories from fat and protein in high-fat meals.</data>
  <data key="d9">fat metabolism,insulin calculation</data>
  <data key="d10">chunk-b266ecc39f9ba0b5277aacb36089b4db</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641875</data>
  <data key="d13"></data>
</edge>
<edge source="Continuous Subcutaneous Insulin Infusion System" target="Postprandial Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Recent studies suggest adjusting the fat-insulin ratio to reduce the risk of postprandial hypoglycemia with SICI therapy.</data>
  <data key="d9">dosing precision,therapy safety</data>
