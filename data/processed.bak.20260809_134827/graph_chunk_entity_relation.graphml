<node id="CVD">
  <data key="d0">CVD</data>
  <data key="d1">concept</data>
  <data key="d2">CVD stands for cardiovascular disease, a condition associated with increased risk for diabetes and other metabolic disorders.&lt;SEP&gt;CVD stands for cardiovascular disease, a condition associated with increased risk for diabetes and other metabolic disorders.</data>
