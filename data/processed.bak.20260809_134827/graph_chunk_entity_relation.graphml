  <data key="d12">1776643811</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pens" target="Glycemic Targets">
  <data key="d7">1.0</data>
  <data key="d8">Trials show that insulin pens generally achieve equivalent or slightly better glycemic outcomes compared to vial and syringe methods.</data>
  <data key="d9">outcome improvement,treatment efficacy</data>
  <data key="d10">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643812</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pens" target="Insulin Requiring Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">For people with insulin requiring diabetes, insulin pens are preferred in most cases due to convenience and ease of use.</data>
  <data key="d9">patient preference,treatment method</data>
  <data key="d10">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
