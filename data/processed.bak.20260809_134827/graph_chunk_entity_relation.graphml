  <data key="d6"></data>
</node>
<node id="E Thom">
  <data key="d0">E Thom</data>
  <data key="d1">person</data>
  <data key="d2">E Thom is a researcher contributing to the Maternal-Fetal Medicine Units Network trial on mild gestational diabetes.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
