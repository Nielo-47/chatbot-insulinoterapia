  <data key="d6"></data>
</node>
<node id="Diabetic Retinopathy">
  <data key="d0">Diabetic Retinopathy</data>
  <data key="d1">condition</data>
  <data key="d2">Diabetic retinopathy is a complication of diabetes that affects the eyes and is associated with elevated plasma glucose levels.&lt;SEP&gt;Diabetic retinopathy is a complication of diabetes that affects the eyes and is associated with elevated plasma glucose levels.</data>
  <data key="d3">chunk-2977bb9a41689e74de2c536343624744</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1776688978</data>
  <data key="d6"></data>
</node>
