  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Fome E Sede">
  <data key="d7">1.0</data>
  <data key="d8">Fome e sede are common symptoms experienced during episodes of hiperglicemia.</data>
  <data key="d9">metabolic imbalance,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
