  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1776638234</data>
  <data key="d6"></data>
</node>
<node id="90° Injection Angle">
  <data key="d0">90° Injection Angle</data>
  <data key="d1">method</data>
  <data key="d2">A 90° injection angle is commonly used for insulin injection when the skin and fat layer allow for perpendicular needle insertion.&lt;SEP&gt;A 90° injection angle is commonly used for insulin injection when the skin and fat layer allow for perpendicular needle insertion.&lt;SEP&gt;A 90° injection angle is commonly used for insulin injection when the skin and fat layer allow for perpendicular needle insertion.</data>
  <data key="d3">chunk-ae9010ed1abd5a5160b82713c862d22f</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
