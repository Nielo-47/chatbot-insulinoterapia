<edge source="Partial Lipodystrophies" target="Lipodystrophies">
  <data key="d7">1.0</data>
  <data key="d8">Partial lipodystrophies are a subtype of the broader category of lipodystrophies.</data>
  <data key="d9">disease classification,subtype relationship</data>
