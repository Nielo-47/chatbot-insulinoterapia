  <data key="d1">person</data>
  <data key="d2">Bode BW is a cited author on strategies for successful insulin pump therapy in adults, adolescents, and children with diabetes.&lt;SEP&gt;A medical expert involved in diabetes technology research, particularly insulin delivery systems.&lt;SEP&gt;Bode BW is a researcher involved in the Juvenile Diabetes Research Foundation Continuous Glucose Monitoring Study Group.&lt;SEP&gt;Bode BW is a researcher involved in assessing the real-world effectiveness of the V-Go insulin delivery system.</data>
  <data key="d3">chunk-7be6907597f74116387925485497fbd0&lt;SEP&gt;chunk-b8d6904368d45b0f9532b36061a00e7c&lt;SEP&gt;chunk-755e9677a7018e4cc382b7d903590786&lt;SEP&gt;chunk-3e1858f15899659bc0116977a6e1e000</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643573</data>
  <data key="d6"></data>
</node>
<node id="Davidson PC">
  <data key="d0">Davidson PC</data>
  <data key="d1">person</data>
  <data key="d2">Davidson PC is a co-author of a study on 21st-century insulin pump therapy and its effective use.</data>
  <data key="d3">chunk-7be6907597f74116387925485497fbd0</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641776</data>
  <data key="d6"></data>
</node>
<node id="Moore LE">
  <data key="d0">Moore LE</data>
  <data key="d1">person</data>
  <data key="d2">Moore LE is the author of a reference on basic insulin pump management, particularly in pregnancy.</data>
  <data key="d3">chunk-7be6907597f74116387925485497fbd0</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641777</data>
  <data key="d6"></data>
</node>
<node id="Insulin Total Daily Dose">
  <data key="d0">Insulin Total Daily Dose</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin Total Daily Dose refers to the estimated total amount of insulin required per day, calculated based on factors such as age, weight, and glycemic control, and divided into basal and bolus components.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641777</data>
  <data key="d6"></data>
</node>
<node id="Continuous Insulin Infusion System">
  <data key="d0">Continuous Insulin Infusion System</data>
  <data key="d1">artifact</data>
  <data key="d2">Continuous Insulin Infusion System is a medical device used to deliver insulin continuously, requiring programming of basal and bolus insulin doses.&lt;SEP&gt;Continuous Insulin Infusion System is a medical device used to deliver insulin continuously, also known as insulin pump therapy, for the management of Diabetes Mellitus Type 1.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234&lt;SEP&gt;chunk-f1abe83ba7814c7afe7a123e2f79a10a</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642303</data>
  <data key="d6"></data>
</node>
<node id="International Society for Pediatric and Adolescent Diabetes">
  <data key="d0">International Society for Pediatric and Adolescent Diabetes</data>
  <data key="d1">organization</data>
  <data key="d2">International Society for Pediatric and Adolescent Diabetes is an organization focused on diabetes care in children and adolescents.&lt;SEP&gt;The International Society for Pediatric and Adolescent Diabetes issued 2018 clinical practice consensus guidelines for diabetes management.&lt;SEP&gt;The International Society for Pediatric and Adolescent Diabetes (ISPAD) develops clinical guidelines and promotes research in pediatric and adolescent diabetes care.&lt;SEP&gt;The International Society for Pediatric and Adolescent Diabetes (ISPAD) develops clinical guidelines and promotes research in pediatric and adolescent diabetes care.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234&lt;SEP&gt;chunk-836e865d51bd855e9d073bd7a5ac7657&lt;SEP&gt;chunk-309ce40527b1cc8f260e96e195742001</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1776689038</data>
  <data key="d6"></data>
</node>
<node id="National Institute for Clinical Excellence">
  <data key="d0">National Institute for Clinical Excellence</data>
  <data key="d1">organization</data>
  <data key="d2">National Institute for Clinical Excellence is an organization that provides clinical guidelines, including those related to diabetes management.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641778</data>
  <data key="d6"></data>
</node>
<node id="Neutral Protamine Hagedorn Insulin">
  <data key="d0">Neutral Protamine Hagedorn Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Neutral Protamine Hagedorn Insulin is an intermediate-acting insulin used in diabetes management, often as part of basal insulin regimens.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641778</data>
  <data key="d6"></data>
</node>
<node id="Insulin Glargine">
  <data key="d0">Insulin Glargine</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin Glargine is a long-acting insulin analog used for basal insulin coverage in diabetes treatment.&lt;SEP&gt;Insulin glargine is a long-acting basal insulin used in the treatment of type 1 diabetes, compared with NPH insulin and other analogs.&lt;SEP&gt;Insulin glargine is a long-acting insulin analog used as a comparator to insulin detemir in a clinical trial for type 2 diabetes.&lt;SEP&gt;Insulin glargine is a long-acting insulin analog used in multiple daily injection regimens in clinical trials.&lt;SEP&gt;Insulin glargine is a long-acting insulin analog used in diabetes treatment.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234&lt;SEP&gt;chunk-ac7fb8feaa2febe2b5f8525b93f3080f&lt;SEP&gt;chunk-6764f5f0af1c9855a1901ea1bef131d3&lt;SEP&gt;chunk-d0cc6a5cedffa24f9a3134770cf1526b&lt;SEP&gt;chunk-d6dadde3434f68ef74ebdf23be6a24ec&lt;SEP&gt;chunk-cdbe9f47931df265e815faee2c67f81b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643638</data>
  <data key="d6"></data>
</node>
<node id="Insulin Detemir">
  <data key="d0">Insulin Detemir</data>
  <data key="d1">method</data>
  <data key="d2">Insulin Detemir is a long-acting insulin analog used to provide basal insulin in diabetes therapy.&lt;SEP&gt;Insulin detemir is a long-acting insulin analog associated with a lower frequency of daytime and nighttime hypoglycemic events compared to insulin glargine U100.&lt;SEP&gt;Insulin detemir is a long-acting insulin analog studied for its pharmacodynamic and pharmacokinetic properties and its effects on nocturnal hypoglycaemia and weight gain.&lt;SEP&gt;Insulin detemir is a long-acting basal insulin analog with lower within-subject variability compared to NPH insulin and glargine.&lt;SEP&gt;Insulin detemir is a long-acting insulin analog compared with insulin glargine in a 52-week treat-to-target trial.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234&lt;SEP&gt;chunk-157fbe972c55a9a0df76dbef85b43e63&lt;SEP&gt;chunk-ac7fb8feaa2febe2b5f8525b93f3080f&lt;SEP&gt;chunk-6764f5f0af1c9855a1901ea1bef131d3&lt;SEP&gt;chunk-d6dadde3434f68ef74ebdf23be6a24ec</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643656</data>
  <data key="d6"></data>
</node>
<node id="Insulin Degludec">
  <data key="d0">Insulin Degludec</data>
  <data key="d1">artifact</data>
  <data key="d2">Insulin Degludec is a long-acting insulin analog used for basal insulin delivery in diabetes management.&lt;SEP&gt;Insulin degludec is an ultra-long-acting basal insulin compared with insulin glargine in basal-bolus therapy for type 1 diabetes.&lt;SEP&gt;Insulin degludec is a long-acting basal insulin used in the treatment of type 1 diabetes.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234&lt;SEP&gt;chunk-ac7fb8feaa2febe2b5f8525b93f3080f&lt;SEP&gt;chunk-6764f5f0af1c9855a1901ea1bef131d3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642263</data>
  <data key="d6"></data>
</node>
<node id="Dawn Phenomenon">
  <data key="d0">Dawn Phenomenon</data>
  <data key="d1">concept</data>
  <data key="d2">Dawn Phenomenon refers to the early morning rise in blood glucose levels due to increased secretion of growth hormone, insulin resistance, and hepatic glucose production, particularly notable in adolescents.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641778</data>
  <data key="d6"></data>
</node>
<node id="Fasting">
  <data key="d0">Fasting</data>
  <data key="d1">method</data>
  <data key="d2">Fasting refers to the metabolic state in which no food has been consumed for a period, often used as a condition for measuring baseline blood glucose levels.&lt;SEP&gt;Fasting is a state in which blood glucose levels are checked to assess baseline glycemic control.&lt;SEP&gt;Fasting refers to the state of not eating for at least 8 hours, required before performing the OGTT.&lt;SEP&gt;Fasting refers to the state of not eating for at least 8 hours, required before performing the OGTT.&lt;SEP&gt;Fasting is a diagnostic method used in conjunction with glucose measurements for diabetes diagnosis.&lt;SEP&gt;Fasting is a diagnostic method used in conjunction with glucose measurements for diabetes diagnosis.</data>
  <data key="d3">chunk-6d0d8750807baddcd948055c83422234&lt;SEP&gt;chunk-e8bc02d862fc2c83e40dafc871482c2c&lt;SEP&gt;chunk-357f19fa58c4dd99dcd7b47a984b4383&lt;SEP&gt;chunk-a796990fe8edf70e4463124a0233c32c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1776688946</data>
  <data key="d6"></data>
</node>
<node id="Faster-Acting Insulin Aspart">
  <data key="d0">Faster-Acting Insulin Aspart</data>
  <data key="d1">artifact</data>
  <data key="d2">Faster-acting insulin aspart, such as Fiasp®, is a newer insulin analog with an even earlier peak than current rapid-acting insulins and is being tested for use in pump therapy with promising results.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641779</data>
  <data key="d6"></data>
</node>
<node id="Meal Bolus">
  <data key="d0">Meal Bolus</data>
  <data key="d1">method</data>
  <data key="d2">A meal bolus is the total insulin required to manage the carbohydrates in an upcoming meal.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641779</data>
  <data key="d6"></data>
</node>
<node id="Basal Infusion">
  <data key="d0">Basal Infusion</data>
  <data key="d1">method</data>
  <data key="d2">Basal infusion is the continuous delivery of insulin between meals to maintain stable blood glucose levels, programmable in blocks throughout the day.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641779</data>
  <data key="d6"></data>
</node>
<node id="Total Daily Insulin Dose">
  <data key="d0">Total Daily Insulin Dose</data>
  <data key="d1">data</data>
  <data key="d2">Total daily insulin dose (TDID) is a coefficient used in configuring CSII, representing the total amount of insulin a patient uses in one day.&lt;SEP&gt;Total daily insulin dose is a metric used to evaluate insulin requirements in patients undergoing different diabetes treatment regimens.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d&lt;SEP&gt;chunk-cdbe9f47931df265e815faee2c67f81b</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643670</data>
  <data key="d6"></data>
</node>
<node id="Insulin-to-Carbohydrate Ratio">
  <data key="d0">Insulin-to-Carbohydrate Ratio</data>
  <data key="d1">data</data>
  <data key="d2">Insulin-to-carbohydrate ratio (ICR) is a coefficient in CSII that determines how many grams of carbohydrates are covered by one unit of insulin.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641779</data>
  <data key="d6"></data>
</node>
<node id="Glycemic Targets">
  <data key="d0">Glycemic Targets</data>
  <data key="d1">concept</data>
  <data key="d2">Glycemic targets are individualized blood glucose goals set before and after meals, at fasting, and before sleep, based on patient age, insulin regimen, supervision level, and lifestyle.&lt;SEP&gt;Glycemic targets are specific glucose level goals set for people with diabetes to reduce complications.&lt;SEP&gt;Glycemic targets are specific blood glucose level goals that individuals with diabetes aim to achieve for optimal health outcomes.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d&lt;SEP&gt;chunk-8651ec88cb5333f03b8af01fee4d3cb0&lt;SEP&gt;chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643668</data>
  <data key="d6"></data>
</node>
<node id="HbA1c Target">
  <data key="d0">HbA1c Target</data>
  <data key="d1">concept</data>
  <data key="d2">HbA1c target refers to the recommended level of glycated hemoglobin, with different guidelines suggesting values such as ≤6.5% (NICE), ≤7% (ISPAD), and ≤7.5% (ADA) for patients with type 1 diabetes.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641780</data>
  <data key="d6"></data>
</node>
<node id="Water Use">
  <data key="d0">Water Use</data>
  <data key="d1">concept</data>
  <data key="d2">Water use refers to the capability of certain insulin pumps, such as patch pumps, to be used during activities involving water, including swimming or showering, due to their waterproof design.</data>
  <data key="d3">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641780</data>
  <data key="d6"></data>
</node>
<node id="MDI">
  <data key="d0">MDI</data>
  <data key="d1">method</data>
  <data key="d2">MDI refers to multiple daily injections, a therapeutic approach for diabetes management that is compared with SICI in terms of efficacy and safety.&lt;SEP&gt;MDI stands for multiple daily injections, an insulin delivery method involving several injections per day.&lt;SEP&gt;Multiple daily injections (MDI) is a method of insulin delivery involving several daily insulin injections, used as a comparison to insulin pump therapy.&lt;SEP&gt;Multiple Daily Injections (MDI) is an insulin delivery method used as a comparison to insulin pump therapy in clinical studies.</data>
  <data key="d3">chunk-2b712afd345ff5f7503205905d3131f9&lt;SEP&gt;chunk-df233d11f0547c43f4dc4cad909d392b&lt;SEP&gt;chunk-f357ebc59eb6ed3dd2035a13da0df52f&lt;SEP&gt;chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643599</data>
  <data key="d6"></data>
</node>
<node id="DM1">
  <data key="d0">DM1</data>
  <data key="d1">concept</data>
  <data key="d2">DM1 refers to type 1 diabetes mellitus, a chronic condition where insulin pump therapy and intensive management are considered standard treatment.&lt;SEP&gt;DM1 refers to Type 1 Diabetes Mellitus, a condition characterized by absolute insulin deficiency requiring immediate insulin therapy.&lt;SEP&gt;DM1 refers to Type 1 Diabetes Mellitus, a condition characterized by insulin deficiency, often requiring insulin therapy and associated with risks such as hypoglycemia.&lt;SEP&gt;DM1 é o diabetes mellitus tipo 1, uma condição que exige tratamento imediato com insulina para prevenir complicações metabólicas.&lt;SEP&gt;DM1 refers to type 1 diabetes mellitus, a chronic condition characterized by the body's inability to produce insulin.</data>
  <data key="d3">chunk-2b712afd345ff5f7503205905d3131f9&lt;SEP&gt;chunk-6a45688326f1b9dbe3fc7ae4ba51043a&lt;SEP&gt;chunk-993ef3cd53aca15e211c42cb48f1b4c7&lt;SEP&gt;chunk-fed992e01da83317a2c9f0adf751f53f&lt;SEP&gt;chunk-0778abb680b777bec45d5985b757c743</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689309</data>
  <data key="d6"></data>
</node>
<node id="MCG">
  <data key="d0">MCG</data>
  <data key="d1">method</data>
  <data key="d2">MCG refers to continuous glucose monitoring devices that provide real-time glucose data and are integrated with insulin delivery systems.&lt;SEP&gt;MCG refers to continuous glucose monitoring systems, a technology used in conjunction with insulin therapy for optimal diabetes management.</data>
  <data key="d3">chunk-2b712afd345ff5f7503205905d3131f9&lt;SEP&gt;chunk-c8085de73bd4812f966c059205e5d3cf</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641780</data>
  <data key="d6"></data>
</node>
<node id="Quadro 1">
  <data key="d0">Quadro 1</data>
  <data key="d1">content</data>
  <data key="d2">Quadro 1 lists the medical indications for the use of SICI, including specific patient groups such as children under six and pregnant women with diabetes.&lt;SEP&gt;Quadro 1 outlines appropriate contexts for lower HbA1c targets (&lt;6.5%) in type 1 diabetes patients without increased hypoglycemia risk.</data>
  <data key="d3">chunk-2b712afd345ff5f7503205905d3131f9&lt;SEP&gt;chunk-d39cd334b01ad820816bf3cb108c0e27</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689308</data>
  <data key="d6"></data>
</node>
<node id="Quadro 2">
  <data key="d0">Quadro 2</data>
  <data key="d1">content</data>
  <data key="d2">Quadro 2 outlines relative indications for the use of SICI, such as poor glycemic control despite intensive therapy and frequent nocturnal hypoglycemia.&lt;SEP&gt;Quadro 2 is a reference table listing additional risk factors for Type 2 Diabetes used in screening recommendations.&lt;SEP&gt;Quadro 2 is a reference table listing additional risk factors for type 2 diabetes used to guide screening recommendations.&lt;SEP&gt;Quadro 2 recommends higher HbA1c targets (&lt;7.5%) in children and adolescents with type 1 diabetes under specific clinical conditions.</data>
  <data key="d3">chunk-2b712afd345ff5f7503205905d3131f9&lt;SEP&gt;chunk-ea289ce35cdd947df9d56e9e4b5c8566&lt;SEP&gt;chunk-4e72b56afa6bad1b13c937a3ff9bd13d&lt;SEP&gt;chunk-d39cd334b01ad820816bf3cb108c0e27</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689308</data>
  <data key="d6"></data>
</node>
<node id="Quadro 3">
  <data key="d0">Quadro 3</data>
  <data key="d1">artifact</data>
  <data key="d2">Quadro 3 presents recommendations and conclusions regarding the use of SICI and MDI in diabetes management, including grading of recommendation levels.&lt;SEP&gt;Quadro 3 lists clinical conditions that can cause inaccuracies in HbA1c measurements, such as hemoglobin variants, anemias, and chronic kidney failure.&lt;SEP&gt;Quadro 3 suggests less strict glycemic targets for patients with limited life expectancy, comorbidities, or high hypoglycemia risk.&lt;SEP&gt;Quadro 3 is a reference chart in the guideline that outlines glycemic management recommendations for elderly diabetic patients.</data>
  <data key="d3">chunk-2b712afd345ff5f7503205905d3131f9&lt;SEP&gt;chunk-8c3c6ce19ad6bc3cc3df22e5e10b0702&lt;SEP&gt;chunk-d8434e93fae47721617db0727fcd99b1&lt;SEP&gt;chunk-d39cd334b01ad820816bf3cb108c0e27</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689289</data>
  <data key="d6"></data>
</node>
