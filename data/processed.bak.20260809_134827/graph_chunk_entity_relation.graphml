  <data key="d12">1776638310</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Application" target="Cotton">
  <data key="d7">1.0</data>
  <data key="d8">Cotton is used to apply pressure to the injection site for 5 seconds after needle removal to minimize bleeding or leakage.</data>
  <data key="d9">post-injection care,pressure application</data>
  <data key="d10">chunk-e4654b5e9fa02cf051c2d5ebc846c5d6</data>
