  <data key="d12">1776641874</data>
  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Infusion Catheter">
  <data key="d7">1.0</data>
  <data key="d8">The infusion catheter is a key part of the infusion set, responsible for subcutaneous insulin delivery.</data>
  <data key="d9">component integration,device structure</data>
  <data key="d10">chunk-679c193ea4fd33e94141ac2c9fef69c9</data>
