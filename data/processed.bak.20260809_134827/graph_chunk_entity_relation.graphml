  <data key="d12">1776641823</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Rapid-Acting Insulin Analog">
  <data key="d7">1.0</data>
  <data key="d8">Rapid-acting insulin analogs are associated with a lower risk of hypoglycemia compared to traditional insulin regimens.</data>
  <data key="d9">risk reduction,safety</data>
  <data key="d10">chunk-182332eb7daaa8deed5e90a79db308e8</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641828</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Diabetes Control And Complications Trial Research Group">
  <data key="d7">1.0</data>
  <data key="d8">The Diabetes Control And Complications Trial Research Group studied hypoglycemia as a complication of intensive diabetes treatment.</data>
  <data key="d9">clinical research,diabetes complications</data>
  <data key="d10">chunk-ddf3203a55511f7874bc210d61b3ccfa</data>
