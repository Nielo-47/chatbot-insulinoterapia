  <data key="d6"></data>
</node>
<node id="Glucose Test Strips">
  <data key="d0">Glucose Test Strips</data>
  <data key="d1">artifact</data>
  <data key="d2">Glucose test strips are consumable components used in blood glucose meters to measure blood sugar levels.</data>
