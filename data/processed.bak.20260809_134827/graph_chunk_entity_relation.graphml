  <data key="d13"></data>
</edge>
<edge source="Cystic Fibrosis–Related Diabetes" target="Placebo">
  <data key="d7">1.0</data>
  <data key="d8">Placebo is used as a control in CFRD studies and is associated with continued weight loss in participants.</data>
  <data key="d9">control,weight loss</data>
