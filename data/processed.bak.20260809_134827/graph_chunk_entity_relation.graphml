  <data key="d0">International Expert Committee Report</data>
  <data key="d1">content</data>
  <data key="d2">The International Expert Committee Report evaluates the role of the A1C assay in the diagnosis of diabetes.&lt;SEP&gt;The International Expert Committee Report evaluates the role of the A1C assay in the diagnosis of diabetes.</data>
