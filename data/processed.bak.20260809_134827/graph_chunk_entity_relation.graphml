</node>
<node id="Australian Carbohydrate Intolerance Study In Pregnant Women Trial Group">
  <data key="d0">Australian Carbohydrate Intolerance Study In Pregnant Women Trial Group</data>
  <data key="d1">organization</data>
  <data key="d2">The ACHOIS Trial Group conducted a major study on the effects of treating gestational diabetes on pregnancy outcomes.&lt;SEP&gt;The ACHOIS Trial Group conducted a major study on the effects of treating gestational diabetes on pregnancy outcomes.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
