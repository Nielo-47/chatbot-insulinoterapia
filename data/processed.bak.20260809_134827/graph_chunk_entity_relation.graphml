</edge>
<edge source="Family History" target="DM2">
  <data key="d7">1.0</data>
  <data key="d8">Over 75% of children with DM2 have a family history of diabetes, indicating a strong genetic component.</data>
  <data key="d9">genetic predisposition,risk factor</data>
  <data key="d10">chunk-fd83fee2b80ad551bb282975932751ce</data>
