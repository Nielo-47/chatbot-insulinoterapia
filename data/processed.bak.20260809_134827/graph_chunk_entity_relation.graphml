  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Diabetes Mellitus Type 1">
  <data key="d7">1.0</data>
  <data key="d8">Insulin is used as a critical treatment for individuals with Diabetes Mellitus Type 1 who cannot produce sufficient insulin.</data>
  <data key="d9">medical management,treatment</data>
