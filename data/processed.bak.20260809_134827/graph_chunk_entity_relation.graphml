<edge source="Diagnostic Tests For Diabetes" target="Fasting Plasma Glucose">
  <data key="d7">1.0</data>
  <data key="d8">Fasting plasma glucose is one of the primary methods used to diagnose diabetes, requiring at least 8 hours of fasting.</data>
