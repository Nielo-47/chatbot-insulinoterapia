  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Exercise During Pregnancy">
  <data key="d7">1.0</data>
  <data key="d8">Randomized clinical trials have shown that exercise during pregnancy can help prevent gestational diabetes mellitus, especially in overweight and obese women.</data>
  <data key="d9">clinical trial,preventive measure</data>
  <data key="d10">chunk-2f5ebd46f8491409b5f07f5c83542afd</data>
