<node id="Onset 1 Trial">
  <data key="d0">Onset 1 Trial</data>
  <data key="d1">event</data>
  <data key="d2">The Onset 1 trial was a 26-week, multicenter, randomized study evaluating fast-acting insulin aspart in basal-bolus treatment for type 1 diabetes.</data>
  <data key="d3">chunk-5647e96fec802433abcc8922a33d23b8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642283</data>
  <data key="d6"></data>
</node>
<node id="Onset 5 Trial">
  <data key="d0">Onset 5 Trial</data>
  <data key="d1">event</data>
  <data key="d2">The Onset 5 trial was a randomized, multicenter trial assessing the efficacy and safety of fast-acting insulin aspart in continuous subcutaneous insulin infusion for adults with type 1 diabetes.</data>
  <data key="d3">chunk-5647e96fec802433abcc8922a33d23b8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642284</data>
  <data key="d6"></data>
</node>
<node id="Stat Study">
  <data key="d0">Stat Study</data>
  <data key="d1">event</data>
  <data key="d2">The STAT Study was a clinical trial comparing inhaled technosphere insulin with insulin aspart in patients with type 1 diabetes on multiple daily injections.</data>
  <data key="d3">chunk-5647e96fec802433abcc8922a33d23b8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642284</data>
  <data key="d6"></data>
</node>
<node id="Comisair Study">
  <data key="d0">Comisair Study</data>
  <data key="d1">event</data>
  <data key="d2">The COMISAIR Study was a 3-year follow-up study evaluating the impact of continuous glucose monitoring versus insulin delivery method on glycemic outcomes in adults with type 1 diabetes.</data>
  <data key="d3">chunk-5647e96fec802433abcc8922a33d23b8</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
