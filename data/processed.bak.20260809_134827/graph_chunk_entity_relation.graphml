  <data key="d13"></data>
</edge>
<edge source="R4" target="Classe IIa">
  <data key="d7">1.0</data>
  <data key="d8">R4 is classified as Classe IIa, indicating a moderate recommendation in the clinical guideline.</data>
  <data key="d9">clinical guideline,recommendation strength</data>
  <data key="d10">chunk-d8434e93fae47721617db0727fcd99b1</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689385</data>
  <data key="d13"></data>
</edge>
