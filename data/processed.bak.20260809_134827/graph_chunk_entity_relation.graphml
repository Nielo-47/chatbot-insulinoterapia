  <data key="d5">1776688996</data>
  <data key="d6"></data>
</node>
<node id="Antiretroviral Drug Use">
  <data key="d0">Antiretroviral Drug Use</data>
  <data key="d1">condition</data>
  <data key="d2">Antiretroviral drug use is associated with potential interference in HbA1c test results, affecting diabetes diagnosis reliability.&lt;SEP&gt;Antiretroviral drug use is associated with potential interference in HbA1c test results, affecting diabetes diagnosis reliability.</data>
  <data key="d3">chunk-8c3c6ce19ad6bc3cc3df22e5e10b0702</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d5">1776688997</data>
  <data key="d6"></data>
</node>
<node id="Blood Transfusions">
  <data key="d0">Blood Transfusions</data>
  <data key="d1">procedure</data>
  <data key="d2">Blood transfusions can alter hemoglobin composition and affect the accuracy of HbA1c testing.&lt;SEP&gt;Blood transfusions can alter hemoglobin composition and affect the accuracy of HbA1c testing.</data>
