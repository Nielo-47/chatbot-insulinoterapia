  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Addison Disease">
  <data key="d7">1.0</data>
  <data key="d8">Addison disease is an autoimmune condition that may develop in individuals with type 1 diabetes.</data>
  <data key="d9">autoimmune disorder,comorbidity</data>
  <data key="d10">chunk-620e2d1316d6093170f1c9991caabc7e</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647634</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Vitiligo">
  <data key="d7">1.0</data>
  <data key="d8">Vitiligo is associated with type 1 diabetes as part of a broader autoimmune diathesis.</data>
  <data key="d9">autoimmune disorder,comorbidity</data>
  <data key="d10">chunk-620e2d1316d6093170f1c9991caabc7e</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647635</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Autoimmune Hepatitis">
  <data key="d7">1.0</data>
  <data key="d8">Autoimmune hepatitis is a liver condition linked to the autoimmune predisposition seen in type 1 diabetes.</data>
