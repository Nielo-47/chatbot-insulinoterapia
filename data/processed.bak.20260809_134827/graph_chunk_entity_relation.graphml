  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="AABBCC Approach">
  <data key="d7">1.0</data>
  <data key="d8">The AABBCC approach is used to classify diabetes mellitus based on multiple clinical parameters.</data>
  <data key="d9">classification system,clinical decision-making</data>
