  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Celiac Disease">
  <data key="d7">1.0</data>
  <data key="d8">Celiac disease frequently co-occurs with type 1 diabetes due to shared autoimmune mechanisms.</data>
  <data key="d9">autoimmune disorder,comorbidity</data>
