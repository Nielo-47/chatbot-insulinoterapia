</edge>
<edge source="Lipodistrofia Generalizada" target="Hiperfagia">
  <data key="d7">1.0</data>
  <data key="d8">Hiperfagia results from hypoleptinemia due to minimal adipose tissue, resembling Prader-Willi syndrome.</data>
