  <data key="d12">1776641825</data>
  <data key="d13"></data>
</edge>
<edge source="Scar Less Than 3 Mm" target="Pediatric Patients">
  <data key="d7">1.0</data>
  <data key="d8">In pediatric patients, insulin infusion is associated with minimal scarring, with 94% having scars less than 3 mm.</data>
  <data key="d9">minimal scarring,tissue response</data>
  <data key="d10">chunk-54930ff88c0a13a8693f1c1b3407ca63</data>
