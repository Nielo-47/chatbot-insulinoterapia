</node>
<node id="Patch Testing">
  <data key="d0">Patch Testing</data>
  <data key="d1">method</data>
  <data key="d2">Patch testing is a diagnostic method used to identify causes of contact dermatitis, including allergies to adhesives used in medical devices.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
