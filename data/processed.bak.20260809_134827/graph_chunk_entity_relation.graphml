  <data key="d5">1776647361</data>
  <data key="d6"></data>
</node>
<node id="Preconception Care">
  <data key="d0">Preconception Care</data>
  <data key="d1">method</data>
  <data key="d2">Preconception care for individuals with preexisting diabetes helps lower A1C and reduces risks of birth defects, preterm delivery, perinatal mortality, and other complications.&lt;SEP&gt;Preconception care for individuals with preexisting diabetes helps lower A1C and reduces risks of birth defects, preterm delivery, perinatal mortality, and other complications.</data>
  <data key="d3">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647361</data>
  <data key="d6"></data>
</node>
<node id="Universal Early Screening">
  <data key="d0">Universal Early Screening</data>
  <data key="d1">method</data>
  <data key="d2">Universal early screening at less than 15 weeks of gestation is recommended for undiagnosed diabetes in high-risk populations to address health disparities and improve outcomes.&lt;SEP&gt;Universal early screening at less than 15 weeks of gestation is recommended for undiagnosed diabetes in high-risk populations to address health disparities and improve outcomes.</data>
  <data key="d3">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647361</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Complicating Pregnancy">
  <data key="d0">Diabetes Complicating Pregnancy</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes complicating pregnancy refers to preexisting diabetes, typically type 2, diagnosed during pregnancy using standard non-pregnancy criteria, requiring appropriate management.&lt;SEP&gt;Diabetes complicating pregnancy refers to preexisting diabetes, typically type 2, diagnosed during pregnancy using standard non-pregnancy criteria, requiring appropriate management.</data>
  <data key="d3">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
