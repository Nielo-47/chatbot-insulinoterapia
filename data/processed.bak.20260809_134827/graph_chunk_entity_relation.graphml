  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Hipoglicemia Grave">
  <data key="d7">1.0</data>
  <data key="d8">Hipoglicemia Grave is a more severe form of hypoglycemia, defined as glucose levels below 54 mg/dL.</data>
