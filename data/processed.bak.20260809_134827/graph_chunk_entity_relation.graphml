  <data key="d6"></data>
</node>
<node id="Sickle Cell Disease">
  <data key="d0">Sickle Cell Disease</data>
  <data key="d1">condition</data>
  <data key="d2">Sickle cell disease is a genetic disorder associated with increased red blood cell turnover, which affects the reliability of A1C as a glycemic marker.&lt;SEP&gt;Sickle cell disease is a genetic disorder associated with increased red blood cell turnover, which affects the reliability of A1C as a glycemic marker.</data>
  <data key="d3">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
