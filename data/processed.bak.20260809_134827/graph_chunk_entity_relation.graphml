</edge>
<edge source="Insulin NPH" target="Insulin Cartridge">
  <data key="d7">1.0</data>
  <data key="d8">Insulin NPH is stored in an insulin cartridge and must be gently agitated before use due to its cloudy appearance.</data>
  <data key="d9">insulin type,storage</data>
