  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Insulin Reflux">
  <data key="d7">1.0</data>
  <data key="d8">When using an insulin pen, keeping the injection button pressed until needle removal prevents insulin or blood reflux into the cartridge.</data>
  <data key="d9">device use,safety protocol</data>
  <data key="d10">chunk-5ea5432a4b376d5a48f31d6694c76d8e</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1776637742</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Insulin Stability">
  <data key="d7">1.0</data>
  <data key="d8">The stability of insulin in pens was maintained even when exposed to temperatures up to 37°C and cyclic temperature changes.</data>
  <data key="d9">device performance,drug integrity</data>
