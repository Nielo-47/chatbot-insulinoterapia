  <data key="d5">1776647386</data>
  <data key="d6"></data>
</node>
<node id="Disposable Sensors">
  <data key="d0">Disposable Sensors</data>
  <data key="d1">artifact</data>
  <data key="d2">Disposable sensors are single-use components of rtCGM and isCGM systems that are replaced regularly.</data>
