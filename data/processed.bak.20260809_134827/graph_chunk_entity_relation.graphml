  <data key="d12">1776641876</data>
  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Diabetic Ketoacidosis">
  <data key="d7">1.0</data>
  <data key="d8">Issues with infusion sets can lead to insulin delivery failure and increase the risk of diabetic ketoacidosis.</data>
