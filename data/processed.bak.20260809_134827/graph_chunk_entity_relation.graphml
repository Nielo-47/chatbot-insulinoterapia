</edge>
<edge source="Glycemic Variability" target="Coefficient Of Variation">
  <data key="d7">1.0</data>
  <data key="d8">Glycemic Variability is measured using the coefficient of variation derived from glucose monitoring data.</data>
  <data key="d9">data analysis,measurement method</data>
