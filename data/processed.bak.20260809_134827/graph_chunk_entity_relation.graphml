<node id="Begin Basal-Bolus Type 1">
  <data key="d0">Begin Basal-Bolus Type 1</data>
  <data key="d1">event</data>
  <data key="d2">BEGIN basal-bolus type 1 is a phase 3, randomized, open-label, treat-to-target non-inferiority trial comparing insulin degludec and insulin glargine in type 1 diabetes.</data>
  <data key="d3">chunk-ac7fb8feaa2febe2b5f8525b93f3080f</data>
