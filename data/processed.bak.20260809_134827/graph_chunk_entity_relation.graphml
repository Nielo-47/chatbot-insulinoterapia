  <data key="d12">1776639099</data>
  <data key="d13"></data>
</edge>
<edge source="Cotton" target="Step-by-Step Insulin Injection Procedure">
  <data key="d7">1.0</data>
  <data key="d8">Cotton is used to compress the injection site for 5 seconds after needle removal as per the injection procedure.</data>
  <data key="d9">compression,post-injection care</data>
  <data key="d10">chunk-622f3feb1f15564393e91cefc71256ec</data>
