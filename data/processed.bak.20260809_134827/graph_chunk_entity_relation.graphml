  <data key="d12">1776647716</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Autoantibody Risk Score">
  <data key="d7">1.0</data>
  <data key="d8">The autoantibody risk score incorporates multiple autoantibody levels to predict the likelihood of developing type 1 diabetes.</data>
