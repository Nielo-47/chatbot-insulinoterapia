</edge>
<edge source="TTGO 1h" target="TTGO 2h">
  <data key="d7">1.0</data>
  <data key="d8">TTGO-1h is superior to TTGO-2h in detecting individuals at risk for developing type 2 diabetes, offering earlier identification.&gt;</data>
  <data key="d9">comparative performance,diagnostic accuracy</data>
