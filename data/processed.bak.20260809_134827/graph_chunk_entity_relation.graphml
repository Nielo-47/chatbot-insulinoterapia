</edge>
<edge source="Oral Glucose Tolerance Test" target="Recommendation 2.10">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.10 includes the 2-hour plasma glucose during a 75-g oral glucose tolerance test as an appropriate screening method.</data>
  <data key="d9">diagnostic method,screening</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974</data>
