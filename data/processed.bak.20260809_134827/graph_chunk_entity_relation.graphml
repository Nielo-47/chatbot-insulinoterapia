  <data key="d12">1776647678</data>
  <data key="d13"></data>
</edge>
<edge source="Genetic Testing" target="ADA-European Association for the Study of Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">The ADA-European Association for the Study of Diabetes consensus report recommends genetic testing for individuals diagnosed with diabetes under six months of age.</data>
  <data key="d9">guideline,recommendation</data>
