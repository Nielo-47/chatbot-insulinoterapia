  <data key="d12">1776639172</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Subcutaneous Injection">
  <data key="d7">1.0</data>
  <data key="d8">An insulin pen is used to deliver insulin subcutaneously, and pressing the button before needle insertion can lead to insulin loss and incorrect dosing.</data>
  <data key="d9">device use,injection technique</data>
  <data key="d10">chunk-dc6a188926df383900f31928c8726a8f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639172</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Insulin Dose">
  <data key="d7">2.0</data>
  <data key="d8">An insulin pen is a practical device used to deliver accurate insulin doses conveniently.&lt;SEP&gt;An insulin pen is a practical device used to deliver accurate insulin doses conveniently.</data>
  <data key="d9">administration method,dosing accuracy</data>
  <data key="d10">chunk-c7e6ef38db0b62d161b13473af47d738</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Documento sem título.docx</data>
  <data key="d12">1776642060</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Insulin Vial">
  <data key="d7">1.0</data>
  <data key="d8">Insulin pens are used with insulin vials to draw and administer insulin, though modern pens often use prefilled cartridges.</data>
  <data key="d9">delivery method,device compatibility</data>
  <data key="d10">chunk-2841f77ed9254c0e5372f3c45f6d3da2</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Understanding insulin - International Diabetes Federation.pdf</data>
  <data key="d12">1776642562</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="U-500 Insulin">
  <data key="d7">1.0</data>
  <data key="d8">U-500 insulin pens deliver doses in 5-unit increments to accommodate high-dose requirements.</data>
  <data key="d9">dose increment,high-concentration delivery</data>
  <data key="d10">chunk-b94e98f4cb6f97fceae5e6d8c30c871b</data>
