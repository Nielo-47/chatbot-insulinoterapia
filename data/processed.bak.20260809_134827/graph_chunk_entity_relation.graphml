  <data key="d0">Selvin e cols</data>
  <data key="d1">organization</data>
  <data key="d2">Selvin e cols refers to the research team led by Selvin that conducted an analysis within the ARIC study on diabetes risk prediction using HbA1c.&lt;SEP&gt;Selvin e cols refers to the research team led by Selvin that conducted an analysis within the ARIC study on diabetes risk prediction using HbA1c.</data>
  <data key="d3">chunk-2b3097da75459ebf108182050a889e65</data>
