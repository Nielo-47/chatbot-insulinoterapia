  <data key="d5">1776643666</data>
  <data key="d6"></data>
</node>
<node id="Mannitol">
  <data key="d0">Mannitol</data>
  <data key="d1">substance</data>
  <data key="d2">Mannitol is a substance that can interfere with continuous glucose monitoring sensor readings.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
