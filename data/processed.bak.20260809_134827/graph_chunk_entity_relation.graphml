  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Graves Disease">
  <data key="d7">1.0</data>
  <data key="d8">Graves disease is one of several autoimmune disorders commonly associated with type 1 diabetes.</data>
  <data key="d9">autoimmune disorder,comorbidity</data>
  <data key="d10">chunk-620e2d1316d6093170f1c9991caabc7e</data>
