  <data key="d5">1776638280</data>
  <data key="d6"></data>
</node>
<node id="Rotation Of Injection Sites">
  <data key="d0">Rotation Of Injection Sites</data>
  <data key="d1">method</data>
  <data key="d2">Rotation of injection sites is a recommended practice to prevent skin complications and ensure consistent insulin absorption.&lt;SEP&gt;Rotation of injection sites is a recommended practice to prevent skin complications and ensure consistent insulin absorption.</data>
  <data key="d3">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1776638280</data>
  <data key="d6"></data>
</node>
<node id="Quadrants">
  <data key="d0">Quadrants</data>
  <data key="d1">concept</data>
  <data key="d2">Quadrants are small divided areas within an injection site used to systematically rotate insulin injections and maintain treatment effectiveness.&lt;SEP&gt;Quadrants are small divided areas within an injection site used to systematically rotate insulin injections and maintain treatment effectiveness.</data>
  <data key="d3">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1776638280</data>
  <data key="d6"></data>
</node>
<node id="Children Under 6 Years">
  <data key="d0">Children Under 6 Years</data>
  <data key="d1">person</data>
  <data key="d2">Children under 6 years are a patient group for whom the subcutaneous fold technique is recommended during insulin injection, regardless of needle size.&lt;SEP&gt;Children under 6 years are a patient group for whom subcutaneous fold is recommended during insulin injection, regardless of needle size, due to lower subcutaneous fat.&lt;SEP&gt;Children under 6 years are a patient group for whom subcutaneous fold is recommended during insulin injection, regardless of needle size, due to lower subcutaneous fat.&lt;SEP&gt;Children under 6 years are a patient group for whom the subcutaneous fold technique is recommended during insulin injection, regardless of needle size.</data>
