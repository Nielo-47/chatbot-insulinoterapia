</edge>
<edge source="Hipoglicemia" target="Tontura">
  <data key="d7">1.0</data>
  <data key="d8">Dizziness occurs due to insufficient glucose supply to the brain during hipoglicemia.</data>
  <data key="d9">neurological effect,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644863</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Batedeira">
  <data key="d7">1.0</data>
  <data key="d8">Palpitations or rapid heartbeat are physiological responses to low blood sugar.</data>
  <data key="d9">cardiovascular response,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
