  <data key="d12">1776644868</data>
  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Monitorar E Controlar A Glicemia">
  <data key="d7">1.0</data>
  <data key="d8">Regular monitoring and control of blood glucose help prevent episodes of hiperglicemia.</data>
  <data key="d9">disease management,prevention</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644868</data>
  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Ter Uma Alimentação Saudável E Balanceada">
  <data key="d7">1.0</data>
  <data key="d8">A healthy and balanced diet helps maintain stable glucose levels and prevent hiperglicemia.</data>
  <data key="d9">dietary management,prevention</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
