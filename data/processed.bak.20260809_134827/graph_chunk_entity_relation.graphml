  <data key="d5">1776643578</data>
  <data key="d6"></data>
</node>
<node id="U-500 Insulin">
  <data key="d0">U-500 Insulin</data>
  <data key="d1">product</data>
  <data key="d2">U-500 insulin is a high-concentration insulin requiring specialized syringes for accurate dosing.&lt;SEP&gt;U-500 insulin is a high-concentration insulin formulation used for patients requiring large insulin doses.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b&lt;SEP&gt;chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643578</data>
  <data key="d6"></data>
</node>
<node id="Connected Insulin Pen">
  <data key="d0">Connected Insulin Pen</data>
  <data key="d1">equipment</data>
  <data key="d2">A connected insulin pen can record and transmit insulin dose data for tracking and clinical review.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643578</data>
  <data key="d6"></data>
</node>
<node id="Insulin Pen Cap">
  <data key="d0">Insulin Pen Cap</data>
  <data key="d1">equipment</data>
  <data key="d2">An insulin pen cap is an accessory that fits on insulin pens and may assist with dose calculation and data reporting.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643578</data>
  <data key="d6"></data>
</node>
<node id="Needle Gauge">
  <data key="d0">Needle Gauge</data>
  <data key="d1">product</data>
  <data key="d2">Needle gauge refers to the thickness of an insulin injection needle, ranging from 22 to 34, with higher numbers indicating thinner needles.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643579</data>
  <data key="d6"></data>
</node>
<node id="Insulin Dose Calculation">
  <data key="d0">Insulin Dose Calculation</data>
  <data key="d1">method</data>
  <data key="d2">Insulin dose calculation is the process of determining the appropriate insulin dose based on glucose levels, food intake, and other factors.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b&lt;SEP&gt;chunk-e0a49a3e1aba9780862b94a266490691</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643579</data>
  <data key="d6"></data>
</node>
<node id="Proper Insulin Injection Technique">
  <data key="d0">Proper Insulin Injection Technique</data>
  <data key="d1">method</data>
  <data key="d2">Proper insulin injection technique ensures accurate delivery of insulin and includes considerations for needle use and injection site.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643579</data>
  <data key="d6"></data>
</node>
<node id="Sensor-Augmented Pump">
  <data key="d0">Sensor-Augmented Pump</data>
  <data key="d1">equipment</data>
  <data key="d2">A sensor-augmented pump is an insulin pump with a low glucose suspend feature that helps prevent hypoglycemia.&lt;SEP&gt;Sensor-augmented pumps are insulin delivery devices that integrate continuous glucose monitoring to inform insulin dosing but do not fully automate delivery.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b&lt;SEP&gt;chunk-b36191c270d1cc8ff8c1fc610d7a533b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Low Glucose Suspend Feature">
  <data key="d0">Low Glucose Suspend Feature</data>
  <data key="d1">function</data>
  <data key="d2">The low glucose suspend feature automatically stops insulin delivery when glucose levels drop too low, reducing hypoglycemia risk.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Professional Cgm">
  <data key="d0">Professional Cgm</data>
  <data key="d1">method</data>
  <data key="d2">Professional CGM is a clinically administered form of continuous glucose monitoring used to improve glucose management in patients with type 2 diabetes.</data>
  <data key="d3">chunk-db64ab86a0fa43346644d41501429015</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Freestyle Libre">
  <data key="d0">Freestyle Libre</data>
  <data key="d1">artifact</data>
  <data key="d2">Freestyle Libre is a glucose sensor system used for flash glucose monitoring that has been associated with skin-related adverse reactions.</data>
  <data key="d3">chunk-db64ab86a0fa43346644d41501429015</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Isobornyl Acrylate">
  <data key="d0">Isobornyl Acrylate</data>
  <data key="d1">chemicalsubstance</data>
  <data key="d2">Isobornyl acrylate is a skin sensitizer that can cause allergic reactions and is associated with contact dermatitis from medical device adhesives.&lt;SEP&gt;Isobornyl acrylate is a chemical compound found in certain glucose sensors, such as Freestyle Libre, known to cause allergic contact dermatitis.</data>
  <data key="d3">chunk-db64ab86a0fa43346644d41501429015&lt;SEP&gt;chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Allergic Contact Dermatitis">
  <data key="d0">Allergic Contact Dermatitis</data>
  <data key="d1">condition</data>
  <data key="d2">Allergic contact dermatitis is a skin condition triggered by allergens, including those from glucose monitoring devices and insulin pumps.</data>
  <data key="d3">chunk-db64ab86a0fa43346644d41501429015</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Irritant Contact Dermatitis">
  <data key="d0">Irritant Contact Dermatitis</data>
  <data key="d1">condition</data>
  <data key="d2">Irritant contact dermatitis is a skin reaction caused by direct irritation from medical devices such as glucose sensors and insulin infusion systems.</data>
  <data key="d3">chunk-db64ab86a0fa43346644d41501429015</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Cutaneous Reactions">
  <data key="d0">Cutaneous Reactions</data>
  <data key="d1">condition</data>
  <data key="d2">Cutaneous reactions are skin-related adverse effects associated with the use of continuous glucose monitoring and insulin delivery devices.</data>
  <data key="d3">chunk-db64ab86a0fa43346644d41501429015</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643580</data>
  <data key="d6"></data>
</node>
<node id="Skin Reaction Report Form">
  <data key="d0">Skin Reaction Report Form</data>
  <data key="d1">artifact</data>
  <data key="d2">The Skin Reaction Report Form is a standardized tool developed to document skin reactions caused by medical devices used in diabetes management.</data>
  <data key="d3">chunk-db64ab86a0fa43346644d41501429015</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643581</data>
  <data key="d6"></data>
</node>
<node id="Primary Care">
  <data key="d0">Primary Care</data>
  <data key="d1">location</data>
  <data key="d2">Primary care refers to the first point of contact in the healthcare system where type 2 diabetes is commonly diagnosed and managed.</data>
