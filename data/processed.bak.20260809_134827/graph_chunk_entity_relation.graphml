  <data key="d13"></data>
</edge>
<edge source="Cystic Fibrosis–Related Diabetes" target="Recommendation 2.16">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.16 specifies the use of annual oral glucose tolerance testing for cystic fibrosis–related diabetes starting at age 10.</data>
  <data key="d9">clinical guideline,screening protocol</data>
  <data key="d10">chunk-eb9c311fc732ddd262c56ddc696da954</data>
