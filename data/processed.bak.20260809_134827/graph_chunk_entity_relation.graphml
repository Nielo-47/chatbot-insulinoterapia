  <data key="d0">Accu-Chek® Aviva</data>
  <data key="d1">artifact</data>
  <data key="d2">The Accu-Chek® Aviva is an integrated glucose meter included in the structure of the Accu-Chek® Solo insulin pump.</data>
  <data key="d3">chunk-45bbbee62d25d825935842af1930bb44</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
