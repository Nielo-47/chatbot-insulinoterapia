  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689395</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="National Health and Nutrition Examination Surveys">
  <data key="d7">1.0</data>
