  <data key="d13"></data>
</edge>
<edge source="Cystic Fibrosis–Related Diabetes" target="Repaglinide">
  <data key="d7">1.0</data>
  <data key="d8">Repaglinide is used in the treatment of CFRD and results in initial weight gain, though not sustained beyond six months.</data>
  <data key="d9">treatment,weight management</data>
  <data key="d10">chunk-836e865d51bd855e9d073bd7a5ac7657</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
