  <data key="d7">1.0</data>
  <data key="d8">Glutamic acid decarboxylase autoantibody testing via electro-chemiluminescence assay helps identify latent autoimmune diabetes in adults.</data>
  <data key="d9">biomarker detection,diagnostic identification</data>
  <data key="d10">chunk-9f76e40d0d9b4211d8c61a53ea298d0b</data>
