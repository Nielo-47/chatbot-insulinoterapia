</edge>
<edge source="Insulina" target="Paninho Limpo">
  <data key="d7">1.0</data>
  <data key="d8">O paninho limpo é usado para envolver a insulina, evitando contato direto com o gelo reciclável dentro da bolsinha térmica.</data>
  <data key="d9">isolamento,proteção térmica</data>
  <data key="d10">chunk-022aabbd0c94aa681dcd00c49d072b46</data>
  <data key="d11">data/raw/Documento sem título.docx</data>
