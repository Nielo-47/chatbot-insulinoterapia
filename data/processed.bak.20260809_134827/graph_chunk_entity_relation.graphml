  <data key="d7">1.0</data>
  <data key="d8">Grossi SAA é um dos autores que adaptaram a Tabela 1 sobre conservação da insulina.</data>
  <data key="d9">adaptation,authorship</data>
  <data key="d10">chunk-a81bec86298f297d9be7cc985a7eddb6</data>
