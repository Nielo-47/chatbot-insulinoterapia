</edge>
<edge source="Abdomen" target="Recommended Injection Sites">
  <data key="d7">1.0</data>
  <data key="d8">The abdomen is a recommended site for insulin injection, with specific distance from the umbilicus and special precautions during pregnancy.</data>
  <data key="d9">injection location,safety</data>
  <data key="d10">chunk-48b0f8a5b356409be05a1e866ce0ed8d</data>
