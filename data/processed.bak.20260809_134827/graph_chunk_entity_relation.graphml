  <data key="d12">1776647667</data>
  <data key="d13"></data>
</edge>
<edge source="Stage 3 Type 1 Diabetes" target="Teplizumab">
  <data key="d7">1.0</data>
  <data key="d8">Teplizumab is used to delay the progression from Stage 2 to Stage 3 Type 1 Diabetes in high-risk individuals.</data>
  <data key="d9">disease delay,immunomodulation</data>
