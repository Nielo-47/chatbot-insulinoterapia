<node id="Celiac Disease">
  <data key="d0">Celiac Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Celiac disease is an autoimmune disorder associated with type 1 diabetes, triggered by gluten intolerance.&lt;SEP&gt;Celiac disease is an autoimmune disorder associated with type 1 diabetes, triggered by gluten intolerance.</data>
