  <data key="d13"></data>
</edge>
<edge source="VLDL Production" target="Protease Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Protease inhibitors increase hepatic VLDL production, leading to hypertriglyceridemia and other lipid abnormalities in patients with HIV-associated lipodystrophy.</data>
  <data key="d9">hepatic effect,lipid metabolism</data>
  <data key="d10">chunk-e6c6decf87d73d5f87597055ec503ae1</data>
