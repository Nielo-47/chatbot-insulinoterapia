  <data key="d12">1776641826</data>
  <data key="d13"></data>
</edge>
<edge source="Rapid-Acting Insulin Analog" target="Infusion Occlusion">
  <data key="d7">1.0</data>
  <data key="d8">Using rapid-acting insulin analogs like lispro or aspart reduces the risk of infusion occlusion compared to glulisine.</data>
  <data key="d9">pharmaceutical factor,prevention</data>
  <data key="d10">chunk-679c193ea4fd33e94141ac2c9fef69c9</data>
