</edge>
<edge source="Médico" target="Planilha De Controle">
  <data key="d7">1.0</data>
  <data key="d8">The médico uses the planilha de controle to assess glycemic patterns and adjust diabetes treatment.</data>
  <data key="d9">clinical decision-making,treatment evaluation</data>
  <data key="d10">chunk-545c19428427ece2c838e352e759e388</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Documento sem título.docx</data>
  <data key="d12">1776644667</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Lipohipertrofia">
  <data key="d7">1.0</data>
  <data key="d8">Lipohipertrofia is more prevalent in patients with diabetes mellitus type 1 compared to other patient groups.</data>
  <data key="d9">association,prevalence</data>
  <data key="d10">chunk-202f1dba3a8254f9d5867b459cdbcfa2</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/O que você precisa saber sobre Lipohipertrofia - Sociedade Brasileira de Diabetes.pdf</data>
  <data key="d12">1776640767</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Continuous Subcutaneous Insulin Infusion">
  <data key="d7">1.0</data>
  <data key="d8">CSII is recommended for pediatric and pregnant patients with type 1 diabetes who have persistent hyperglycemia, hypoglycemia, or difficulty managing insulin with MDI.</data>
  <data key="d9">glycemic control,treatment indication</data>
  <data key="d10">chunk-eed9228bfdd30fe45392a8a9fb8d106b</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641818</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Diabetes Control and Complications Trial">
  <data key="d7">1.0</data>
  <data key="d8">The DCCT provided foundational evidence for managing Diabetes Mellitus Type 1 through intensive insulin therapy.</data>
  <data key="d9">clinical evidence,treatment impact</data>
  <data key="d10">chunk-a49920639f738eae3de220d132cbc081</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642345</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Hemoglobin A1c">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c is a key metric for monitoring glycemic control in Diabetes Mellitus Type 1, with a recommended target of less than 7% to reduce complications.</data>
  <data key="d9">disease monitoring,treatment target</data>
  <data key="d10">chunk-a49920639f738eae3de220d132cbc081</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642353</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Insulin Therapy">
  <data key="d7">1.0</data>
  <data key="d8">Insulin therapy is the fundamental treatment for Diabetes Mellitus Type 1, required from the early stages of the disease.</data>
  <data key="d9">management,treatment</data>
  <data key="d10">chunk-f1abe83ba7814c7afe7a123e2f79a10a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642399</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Diabetic Ketoacidosis">
  <data key="d7">1.0</data>
  <data key="d8">Diabetic ketoacidosis is a potentially severe complication of Diabetes Mellitus Type 1 due to acute insulin deficiency.</data>
  <data key="d9">complication,disease progression</data>
  <data key="d10">chunk-f1abe83ba7814c7afe7a123e2f79a10a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642400</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Insulin Requirements">
  <data key="d7">1.0</data>
  <data key="d8">Daily insulin requirements in Diabetes Mellitus Type 1 are estimated based on body weight and vary with physiological conditions.</data>
  <data key="d9">dosage,metabolic demand</data>
  <data key="d10">chunk-f1abe83ba7814c7afe7a123e2f79a10a</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642401</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="C-Peptide">
  <data key="d7">2.0</data>
  <data key="d8">Low serum C-peptide levels at onset are suggestive of Type 1 diabetes due to minimal insulin production.&lt;SEP&gt;Low C-peptide levels indicate minimal endogenous insulin production, supporting a diagnosis of Type 1 diabetes.</data>
  <data key="d9">diagnostic marker,differential diagnosis,insulin production,low levels</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496&lt;SEP&gt;chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647010</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Latent Autoimmune Diabetes in Adults">
  <data key="d7">1.0</data>
  <data key="d8">LADA shares autoimmune characteristics with Type 1 diabetes, including the presence of autoantibodies like anti-GAD.</data>
  <data key="d9">autoimmune feature,disease overlap</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647011</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Autoantibodies">
  <data key="d7">2.0</data>
  <data key="d8">The presence of autoantibodies such as anti-GAD, anti-IA2, anti-ZnT8, and anti-insulin confirms the autoimmune nature of Type 1 diabetes.&lt;SEP&gt;The presence of multiple autoantibodies such as anti-GAD, anti-IA2, anti-ZnT8, and anti-insulin indicates an increased risk of developing Type 1 Diabetes.</data>
  <data key="d9">autoimmune response,biomarkers,diagnostic marker,risk prediction</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19&lt;SEP&gt;chunk-309ce40527b1cc8f260e96e195742001</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689189</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Age at Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">The incidence of Type 1 diabetes peaks between ages 10–14 and again between 65–70, with 60% of cases diagnosed after age 20.</data>
  <data key="d9">epidemiology,incidence pattern</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647101</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Overweight or Obesity in Type 1 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Overweight or obesity in individuals with Type 1 diabetes complicates diagnosis and challenges the traditional association of obesity with Type 2 diabetes.</data>
  <data key="d9">clinical challenge,phenotypic variation</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647104</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Biomarkers">
  <data key="d7">1.0</data>
  <data key="d8">The addition of biomarkers like anti-GAD, anti-IA2, and genetic testing significantly improves the discrimination between Type 1 and Type 2 diabetes.</data>
  <data key="d9">classification accuracy,risk prediction</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647110</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Pancreatic Beta Cells">
  <data key="d7">1.0</data>
  <data key="d8">Patients with Diabetes Mellitus Type 1 of short duration (&lt; 5 years) may still have significant residual function of pancreatic beta cells, which declines over time.&gt;</data>
  <data key="d9">disease progression,functional decline</data>
  <data key="d10">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647237</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="R18">
  <data key="d7">1.0</data>
  <data key="d8">R18 supports early detection of type 1 diabetes through autoantibody screening in high-risk individuals.</data>
  <data key="d9">early diagnosis,risk prediction</data>
  <data key="d10">chunk-a8707947fb493803b7f3759b0105eda4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689124</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="β-Cells">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes Mellitus Type 1 involves the progressive deterioration of β-cell function due to autoimmune attack.</data>
  <data key="d9">autoimmune destruction,disease progression</data>
  <data key="d10">chunk-309ce40527b1cc8f260e96e195742001</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689188</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Table 1">
  <data key="d7">1.0</data>
  <data key="d8">Table 1 includes individualized glycemic targets for patients with Diabetes Mellitus Type 1 across different age and health categories.</data>
  <data key="d9">clinical recommendation,patient stratification</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689349</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Time In Range">
  <data key="d7">1.0</data>
  <data key="d8">For patients with Diabetes Mellitus Type 1, it is recommended to maintain Time In Range above 70%.</data>
  <data key="d9">clinical recommendation,glycemic control</data>
  <data key="d10">chunk-eccbaa35bd49db810bbf9c4a8d650469</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689350</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Hypoglycemia Level 1">
  <data key="d7">1.0</data>
  <data key="d8">For patients with Diabetes Mellitus Type 1, time spent in Hypoglycemia Level 1 should be less than 4%.</data>
  <data key="d9">clinical recommendation,glycemic control</data>
  <data key="d10">chunk-eccbaa35bd49db810bbf9c4a8d650469</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689351</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Hypoglycemia Level 2">
  <data key="d7">1.0</data>
  <data key="d8">For patients with Diabetes Mellitus Type 1, time spent in Hypoglycemia Level 2 should be less than 1%.</data>
  <data key="d9">clinical recommendation,glycemic control</data>
  <data key="d10">chunk-eccbaa35bd49db810bbf9c4a8d650469</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689352</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Glycemic Variability">
  <data key="d7">1.0</data>
  <data key="d8">For patients with Diabetes Mellitus Type 1, glycemic variability should be kept below 36% as measured by coefficient of variation.</data>
  <data key="d9">clinical recommendation,glycemic control</data>
  <data key="d10">chunk-eccbaa35bd49db810bbf9c4a8d650469</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689354</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Brazilian Diabetes Society">
  <data key="d7">1.0</data>
  <data key="d8">The Brazilian Diabetes Society issued clinical recommendations for managing Diabetes Mellitus Type 1.</data>
  <data key="d9">clinical guidelines,medical authority</data>
  <data key="d10">chunk-eccbaa35bd49db810bbf9c4a8d650469</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689355</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 1" target="Intensive Treatment">
  <data key="d7">1.0</data>
  <data key="d8">In type 1 diabetes, intensive glycemic control within the first 6 years reduces the long-term risk of non-fatal myocardial infarction, stroke, and cardiovascular death by 57% as shown in the DCCT/EDIC study.</data>
  <data key="d9">cardiovascular benefit,early intervention</data>
  <data key="d10">chunk-2ad6cd6b0bad77397aa6685ccb2cfaef</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689391</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Lipohipertrofia">
  <data key="d7">1.0</data>
  <data key="d8">Lipohipertrofia occurs in patients with diabetes mellitus type 2, though at a lower frequency than in type 1.</data>
  <data key="d9">association,prevalence</data>
  <data key="d10">chunk-202f1dba3a8254f9d5867b459cdbcfa2</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/O que você precisa saber sobre Lipohipertrofia - Sociedade Brasileira de Diabetes.pdf</data>
  <data key="d12">1776640768</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Lipodistrofias">
  <data key="d7">1.0</data>
  <data key="d8">Lipodystrophies are often misdiagnosed as type 2 diabetes due to overlapping features like insulin resistance, though they differ in severity and onset.</data>
  <data key="d9">clinical confusion,differential diagnosis</data>
  <data key="d10">chunk-c072c5ad49b2fb7ef54c9a2fe121badb</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776641039</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Continuous Subcutaneous Insulin Infusion">
  <data key="d7">1.0</data>
  <data key="d8">The therapeutic value of CSII in pregnant women with type 2 diabetes has not been established, and no significant differences have been found compared to MDI.</data>
  <data key="d9">evidence gap,treatment uncertainty</data>
  <data key="d10">chunk-eed9228bfdd30fe45392a8a9fb8d106b</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641826</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="C-Peptide">
  <data key="d7">1.0</data>
  <data key="d8">Elevated serum C-peptide levels at any stage indicate insulin resistance and support a diagnosis of Type 2 diabetes.</data>
  <data key="d9">diagnostic marker,high levels</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647011</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Latent Autoimmune Diabetes in Adults">
  <data key="d7">1.0</data>
  <data key="d8">LADA shares clinical features with Type 2 diabetes, such as onset in adulthood and initial lack of insulin requirement.</data>
  <data key="d9">clinical presentation,disease overlap</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647012</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Body Mass Index">
  <data key="d7">2.0</data>
  <data key="d8">High BMI, particularly in adolescents, is a key risk factor for the development of Type 2 diabetes.&lt;SEP&gt;High BMI is a common feature in Type 2 diabetes and used as a predictive factor in classification models.</data>
  <data key="d9">clinical indicator,obesity,risk factor</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496&lt;SEP&gt;chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647016</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Random C-Peptide">
  <data key="d7">1.0</data>
  <data key="d8">Random C-peptide levels above 0.6 ng/ml suggest Diabetes Mellitus Type 2 or monogenic diabetes due to preserved beta-cell function.&gt;</data>
  <data key="d9">diagnostic indicator,preserved function</data>
  <data key="d10">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647234</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Pancreatic Beta Cells">
  <data key="d7">1.0</data>
  <data key="d8">Patients with long-standing Diabetes Mellitus Type 2 may develop significant impairment in pancreatic beta-cell function due to the natural progression of the disease.&gt;</data>
  <data key="d9">natural history,progressive impairment</data>
  <data key="d10">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647237</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="R14">
  <data key="d7">1.0</data>
  <data key="d8">R14 recommends reevaluating individuals with a single abnormal test for type 2 diabetes after 6 months.</data>
  <data key="d9">diagnostic criteria,follow-up</data>
  <data key="d10">chunk-a8707947fb493803b7f3759b0105eda4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689121</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="R17">
  <data key="d7">1.0</data>
  <data key="d8">R17 recommends screening for type 2 diabetes in overweight or obese children and adolescents with additional risk factors.</data>
  <data key="d9">pediatric screening,risk factors</data>
  <data key="d10">chunk-a8707947fb493803b7f3759b0105eda4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689122</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Pre-Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Pre-Diabetes is a precursor condition that increases the risk of developing Diabetes Mellitus Type 2.</data>
  <data key="d9">disease progression,risk factor</data>
  <data key="d10">chunk-2d8f51fe0c33fe28ed188c855a82a3af</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689235</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus Type 2" target="Table 1">
  <data key="d7">1.0</data>
  <data key="d8">Table 1 includes individualized glycemic targets for patients with Diabetes Mellitus Type 2 across different age and health categories.</data>
  <data key="d9">clinical recommendation,patient stratification</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
