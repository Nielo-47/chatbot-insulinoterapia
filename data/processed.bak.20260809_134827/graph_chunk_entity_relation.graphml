  <data key="d13"></data>
</edge>
<edge source="Pregnancy" target="Continuous Subcutaneous Insulin Infusion">
  <data key="d7">1.0</data>
  <data key="d8">CSII is a recommended treatment option for pregnant women with type 1 diabetes who have poor glycemic control or experience significant hypoglycemia.</data>
  <data key="d9">maternal-fetal health,treatment option</data>
  <data key="d10">chunk-eed9228bfdd30fe45392a8a9fb8d106b</data>
