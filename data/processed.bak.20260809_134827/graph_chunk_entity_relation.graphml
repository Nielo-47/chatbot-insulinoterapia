</edge>
<edge source="Insulin Pen" target="Health Unit">
  <data key="d7">1.0</data>
  <data key="d8">A Health Unit is the location where a person can seek help for pen issues or obtain a replacement.</data>
  <data key="d9">replacement,support</data>
  <data key="d10">chunk-1b3b45cb29102851f76174e378f8e0cc</data>
