<node id="Standardized Education">
  <data key="d0">Standardized Education</data>
  <data key="d1">method</data>
  <data key="d2">Standardized Education refers to a consistent educational approach used in conjunction with continuous glucose monitoring in diabetes management.</data>
  <data key="d3">chunk-1af4e8af9934463f38c5951016d9664b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
