<node id="Type 1 Diabetes Mellitus">
  <data key="d0">Type 1 Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">Type 1 diabetes mellitus is a chronic metabolic disorder characterized by insulin deficiency, requiring intensive management through methods like SICI or MDI.&lt;SEP&gt;Type 1 diabetes mellitus (DM1) is a chronic condition characterized by insulin deficiency, requiring exogenous insulin therapy for glycemic control.</data>
  <data key="d3">chunk-2b712afd345ff5f7503205905d3131f9&lt;SEP&gt;chunk-157fbe972c55a9a0df76dbef85b43e63</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642249</data>
  <data key="d6"></data>
</node>
<node id="Hybrid Closed-Loop Insulin Delivery System">
  <data key="d0">Hybrid Closed-Loop Insulin Delivery System</data>
  <data key="d1">artifact</data>
  <data key="d2">A medical technology that automates insulin delivery for people with type 1 diabetes, used in home settings to improve glucose outcomes.&lt;SEP&gt;The hybrid closed-loop insulin delivery system is a technology that automates insulin delivery in adolescents and adults with type 1 diabetes.&lt;SEP&gt;The hybrid closed-loop insulin delivery system is a technology evaluated for safety and effectiveness in patients with type 1 diabetes, particularly those at risk for hypoglycemia.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c&lt;SEP&gt;chunk-93bddc99b2e70c378921ff59ddb3b954&lt;SEP&gt;chunk-1eea5927c2474e7c5774b94980fc8b78</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643647</data>
  <data key="d6"></data>
</node>
<node id="Continuous Glucose Monitoring Systems">
  <data key="d0">Continuous Glucose Monitoring Systems</data>
  <data key="d1">artifact</data>
  <data key="d2">Medical devices that track glucose levels in real time, often integrated with insulin delivery systems for diabetes management.&lt;SEP&gt;Continuous glucose monitoring (CGM) systems are devices that track glucose levels in real time and are supported for use in hospitals under proper supervision.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c&lt;SEP&gt;chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Dual-Hormone Therapy">
  <data key="d0">Dual-Hormone Therapy</data>
  <data key="d1">method</data>
  <data key="d2">An advanced insulin delivery approach that administers both insulin and another hormone, such as glucagon, to better regulate blood glucose levels.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641782</data>
  <data key="d6"></data>
</node>
<node id="Instant Occlusion Detection">
  <data key="d0">Instant Occlusion Detection</data>
  <data key="d1">method</data>
  <data key="d2">A technological feature in next-generation patch pumps that immediately identifies blockages in insulin delivery.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641782</data>
  <data key="d6"></data>
</node>
<node id="Improved Precision">
  <data key="d0">Improved Precision</data>
  <data key="d1">concept</data>
  <data key="d2">A characteristic of next-generation patch pumps referring to more accurate and reliable insulin dosing.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641783</data>
  <data key="d6"></data>
</node>
<node id="Mealtime Insulin Delivery Patch">
  <data key="d0">Mealtime Insulin Delivery Patch</data>
  <data key="d1">artifact</data>
  <data key="d2">A patient-preferred device designed to deliver insulin at mealtimes, reflecting user perceptions and preferences in diabetes care.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641783</data>
  <data key="d6"></data>
</node>
<node id="Sociodemographic Factors">
  <data key="d0">Sociodemographic Factors</data>
  <data key="d1">concept</data>
  <data key="d2">Variables such as age, income, and education that influence insulin pump use in young children with type 1 diabetes.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641786</data>
  <data key="d6"></data>
</node>
<node id="Parent Reported Barriers">
  <data key="d0">Parent Reported Barriers</data>
  <data key="d1">concept</data>
  <data key="d2">Challenges identified by parents in managing insulin pump therapy for young children with type 1 diabetes.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641786</data>
  <data key="d6"></data>
</node>
<node id="Ketoacidosis">
  <data key="d0">Ketoacidosis</data>
  <data key="d1">concept</data>
  <data key="d2">A serious complication of diabetes involving high levels of blood acids called ketones, linked to insulin pump therapy.&lt;SEP&gt;Ketoacidosis is a condition that may occur at the diagnosis of Diabetes Mellitus, followed by low or no insulin requirement, prompting evaluation of C-peptide and autoantibodies, especially in the presence of obesity and insulin resistance.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c&lt;SEP&gt;chunk-c51943f25319629d0e145186a85c3b59</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646958</data>
  <data key="d6"></data>
</node>
<node id="Oral Antidiabetic Drugs">
  <data key="d0">Oral Antidiabetic Drugs</data>
  <data key="d1">method</data>
  <data key="d2">Medications taken by mouth to manage type 2 diabetes, sometimes supplemented with overnight CSII.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d5">1776641786</data>
  <data key="d6"></data>
</node>
<node id="Overnight CSII">
  <data key="d0">Overnight CSII</data>
  <data key="d1">method</data>
  <data key="d2">The use of continuous subcutaneous insulin infusion during nighttime as an adjunct to oral antidiabetic drugs in type 2 diabetes management.</data>
  <data key="d3">chunk-b8d6904368d45b0f9532b36061a00e7c</data>
