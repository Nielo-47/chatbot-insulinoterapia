  <data key="d0">Estudo ARIC</data>
  <data key="d1">event</data>
  <data key="d2">Estudo ARIC refers to the Atherosclerosis Risk in Communities study, a cohort study used to evaluate diabetes risk based on initial HbA1c levels.&lt;SEP&gt;Estudo ARIC refers to the Atherosclerosis Risk in Communities study, a cohort study used to evaluate diabetes risk based on initial HbA1c levels.</data>
  <data key="d3">chunk-2b3097da75459ebf108182050a889e65</data>
