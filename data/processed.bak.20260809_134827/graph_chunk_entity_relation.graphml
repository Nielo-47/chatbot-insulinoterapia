<edge source="Hepatic Steatosis" target="Partial Lipodystrophies">
  <data key="d7">1.0</data>
  <data key="d8">Hepatic steatosis is a frequent finding in partial lipodystrophies, resulting from ectopic fat deposition and impaired lipid metabolism.</data>
  <data key="d9">fat accumulation,liver disease</data>
