  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Used Needle Disposal">
  <data key="d7">1.0</data>
  <data key="d8">Used insulin pen needles must be disposed of in a proper sharps container after removal with a protector.</data>
  <data key="d9">safety practice,waste management</data>
