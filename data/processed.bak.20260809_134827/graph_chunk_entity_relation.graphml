  <data key="d0">Nível B</data>
  <data key="d1">concept</data>
  <data key="d2">Nível B denotes the quality of evidence as moderate in the Brazilian Diabetes Society's clinical guideline classification system.</data>
  <data key="d3">chunk-d8434e93fae47721617db0727fcd99b1</data>
