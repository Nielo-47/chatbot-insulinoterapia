</edge>
<edge source="San Antonio Heart Study" target="TTGO-1h">
  <data key="d7">1.0</data>
  <data key="d8">The San Antonio Heart Study found that TTGO-1h had higher sensitivity and positive predictive value for DM2 over 7–8 years.</data>
  <data key="d9">epidemiological evidence,long-term prediction</data>
  <data key="d10">chunk-fb6ee71a842cf35dd741ee96a80c624b</data>
