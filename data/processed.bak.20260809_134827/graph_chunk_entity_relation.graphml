</edge>
<edge source="Hipoglicemia" target="Suor Excessivo">
  <data key="d7">1.0</data>
  <data key="d8">Excessive sweating is a common autonomic symptom of hipoglicemia.</data>
  <data key="d9">autonomic response,symptom manifestation</data>
