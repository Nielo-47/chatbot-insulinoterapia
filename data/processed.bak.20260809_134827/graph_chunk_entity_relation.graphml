  <data key="d6"></data>
</node>
<node id="Pharmacokinetics">
  <data key="d0">Pharmacokinetics</data>
  <data key="d1">concept</data>
  <data key="d2">Pharmacokinetics refers to how the body absorbs, distributes, metabolizes, and excretes insulin, influenced by factors such as injection technique and insulin preparation.</data>
  <data key="d3">chunk-8fc83e266bdeb54c4139a50adf2b793a&lt;SEP&gt;chunk-e883257c402587c2aedd0509191bc233</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d5">1776637676</data>
  <data key="d6"></data>
</node>
<node id="Pharmacodynamics">
  <data key="d0">Pharmacodynamics</data>
  <data key="d1">concept</data>
  <data key="d2">Pharmacodynamics refers to the biochemical and physiological effects of insulin on the body, including glucose-lowering activity, which can be altered by improper insulin handling.</data>
  <data key="d3">chunk-8fc83e266bdeb54c4139a50adf2b793a&lt;SEP&gt;chunk-e883257c402587c2aedd0509191bc233</data>
