  <data key="d5">1776644095</data>
  <data key="d6"></data>
</node>
<node id="Lunch">
  <data key="d0">Lunch</data>
  <data key="d1">event</data>
  <data key="d2">Lunch is a mealtime event used as a reference point in the 24-hour glucose monitoring analysis.</data>
