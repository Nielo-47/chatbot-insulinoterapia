<edge source="Continuous Glucose Monitoring" target="Sensor">
  <data key="d7">2.0</data>
  <data key="d8">The Continuous Glucose Monitoring system relies on a subcutaneous sensor to collect glucose data from interstitial fluid.&lt;SEP&gt;CGM relies on a sensor placed in the interstitium to measure glucose levels every 5 minutes.</data>
  <data key="d9">data collection,measurement method,medical device,technology implementation</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161&lt;SEP&gt;chunk-7a08dc7008091e5ab01812c301e0aab1</data>
