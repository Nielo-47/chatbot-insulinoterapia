  <data key="d12">1776643777</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pump" target="Diabetes Treatment">
  <data key="d7">1.0</data>
  <data key="d8">Insulin pumps are a key tool in modern diabetes treatment, especially for patients requiring intensive insulin therapy.</data>
