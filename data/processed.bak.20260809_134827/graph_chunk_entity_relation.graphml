<edge source="Carbohydrate Intake" target="Insulin Dosage">
  <data key="d7">1.0</data>
  <data key="d8">The amount of carbohydrates consumed influences the bolus insulin dose required to manage post-meal blood glucose.</data>
  <data key="d9">bolus calculation,mealtime adjustment</data>
