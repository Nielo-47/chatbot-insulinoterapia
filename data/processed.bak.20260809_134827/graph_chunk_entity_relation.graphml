  <data key="d12">1776689098</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Non-Alcoholic Fatty Liver Disease">
  <data key="d7">1.0</data>
  <data key="d8">Non-alcoholic fatty liver disease is associated with an almost twofold increased risk of incident type 2 diabetes.</data>
  <data key="d9">comorbidity,disease risk</data>
  <data key="d10">chunk-e35953dbfdebbbab4bf83ec032ccfb7e</data>
