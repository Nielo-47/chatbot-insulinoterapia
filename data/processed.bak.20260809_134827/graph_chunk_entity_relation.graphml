</edge>
<edge source="Type 1 Diabetes" target="Pancreatic Beta Cells">
  <data key="d7">1.0</data>
  <data key="d8">Type 1 diabetes is characterized by immune-mediated destruction of pancreatic beta cells, leading to little or no insulin secretion.</data>
  <data key="d9">autoimmune destruction,insulin deficiency</data>
