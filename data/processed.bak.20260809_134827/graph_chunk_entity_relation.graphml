  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Perda Ou Ganho De Peso">
  <data key="d7">1.0</data>
  <data key="d8">Unexplained weight changes are associated with prolonged hiperglicemia.</data>
  <data key="d9">metabolic disruption,symptom</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
