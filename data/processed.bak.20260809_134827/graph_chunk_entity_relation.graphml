  <data key="d12">1776647495</data>
  <data key="d13"></data>
</edge>
<edge source="Recommendation 2.11" target="Pediatric Screening">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.11 supports screening for prediabetes and type 2 diabetes in children and adolescents with overweight or obesity and one or more risk factors.</data>
  <data key="d9">early onset,risk-based screening</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647496</data>
  <data key="d13"></data>
</edge>
<edge source="Recommendation 2.14" target="Risk-Based Screening">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.14 recommends risk-based screening for prediabetes and type 2 diabetes after the onset of puberty or after age 10, whichever comes first.</data>
  <data key="d9">age threshold,puberty</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974</data>
