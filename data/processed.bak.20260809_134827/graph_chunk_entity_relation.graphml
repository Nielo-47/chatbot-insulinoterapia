  <data key="d13"></data>
</edge>
<edge source="Insulin Homogenization" target="Premixed Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Premixed insulin formulations require adequate homogenization to maintain consistent potency.</data>
  <data key="d9">mixing requirement,suspension preparation</data>
