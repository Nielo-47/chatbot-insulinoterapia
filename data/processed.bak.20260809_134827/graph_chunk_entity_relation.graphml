  <data key="d13"></data>
</edge>
<edge source="Insulina" target="Conservação da Insulina">
  <data key="d7">1.0</data>
  <data key="d8">A conservação adequada da insulina é essencial para preservar sua ação e estabilidade.</data>
  <data key="d9">stability,storage requirement</data>
  <data key="d10">chunk-a81bec86298f297d9be7cc985a7eddb6</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
