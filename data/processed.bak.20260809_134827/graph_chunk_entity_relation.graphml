<edge source="Random C-Peptide" target="Diabetes Mellitus Type 1B">
  <data key="d7">1.0</data>
  <data key="d8">A random C-peptide level below 0.6 ng/ml in patients with at least five years of Diabetes Mellitus supports a diagnosis of Diabetes Mellitus Type 1B.&gt;</data>
  <data key="d9">diagnostic criterion,threshold value</data>
