</edge>
<edge source="C-Peptide" target="Unitslab.Com">
  <data key="d7">1.0</data>
  <data key="d8">Unitslab.com provides an online converter for C-peptide values across different units, including pmol/L, ng/mL, and nmol/L.</data>
  <data key="d9">online tool,unit conversion</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
