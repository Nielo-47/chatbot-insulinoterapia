  <data key="d6"></data>
</node>
<node id="Fistulas">
  <data key="d0">Fistulas</data>
  <data key="d1">concept</data>
  <data key="d2">Fistulas are abnormal passages between organs or between organs and skin, and insulin must not be injected near them.&lt;SEP&gt;Fistulas are abnormal passages between organs or between organs and skin, and insulin must not be injected near them.&lt;SEP&gt;Fistulas are abnormal passages between organs or between organs and skin, and insulin must not be injected near them.</data>
  <data key="d3">chunk-35a8ffab5eb63600b93fb2c67160b5ef</data>
