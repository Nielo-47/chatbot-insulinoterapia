  <data key="d0">Treatment Change</data>
  <data key="d1">event</data>
  <data key="d2">A modification in diabetes management plan, such as adjusting medication, which may require more frequent glucose testing.&lt;SEP&gt;A modification in diabetes management plan, such as adjusting medication, which may require more frequent glucose testing.</data>
