  <data key="d12">1776641209</data>
  <data key="d13"></data>
</edge>
<edge source="Depósito Rígido" target="Unidade De Saúde">
  <data key="d7">1.0</data>
  <data key="d8">O depósito rígido contendo agulhas usadas deve ser entregue à Unidade de Saúde mais próxima para descarte seguro.</data>
  <data key="d9">disposal process,waste management</data>
