<edge source="Type 2 Diabetes" target="Race/Ethnicity">
  <data key="d7">1.0</data>
  <data key="d8">Certain racial and ethnic groups have a higher prevalence of type 2 diabetes.</data>
  <data key="d9">demographic risk,health disparity</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647622</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Physical Inactivity">
  <data key="d7">1.0</data>
  <data key="d8">Lack of physical activity increases the risk of developing type 2 diabetes.</data>
  <data key="d9">behavioral risk,sedentary lifestyle</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647623</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Polycystic Ovary Syndrome">
  <data key="d7">2.0</data>
  <data key="d8">Polycystic ovary syndrome is linked to insulin resistance and increases the risk of type 2 diabetes.&lt;SEP&gt;Polycystic ovary syndrome is associated with insulin resistance and increases the risk of type 2 diabetes.</data>
  <data key="d9">clinical association,comorbidity,hormonal disorder</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7&lt;SEP&gt;chunk-e4f56a727625747d95bd88ea9712defc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647624</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Acanthosis Nigricans">
  <data key="d7">1.0</data>
  <data key="d8">Acanthosis nigricans is a visible sign of insulin resistance and is associated with increased risk for type 2 diabetes.</data>
  <data key="d9">clinical sign,insulin resistance marker</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647625</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Severe Obesity">
  <data key="d7">1.0</data>
  <data key="d8">Severe obesity is a clinical condition strongly tied to insulin resistance and type 2 diabetes.</data>
  <data key="d9">clinical condition,metabolic risk</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647626</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Small-For-Gestational-Age Birth Weight">
  <data key="d7">1.0</data>
  <data key="d8">Low birth weight for gestational age is associated with increased risk of type 2 diabetes in adulthood.</data>
  <data key="d9">developmental origin,early life risk</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647627</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="HIV">
  <data key="d7">1.0</data>
  <data key="d8">People with HIV are at increased risk for diabetes and should be regularly tested.</data>
  <data key="d9">comorbid condition,metabolic complication</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647627</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Maternal History">
  <data key="d7">1.0</data>
  <data key="d8">A maternal history of diabetes or gestational diabetes during pregnancy increases the child's risk of developing type 2 diabetes.</data>
  <data key="d9">developmental origin,prenatal risk</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647629</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Overweight">
  <data key="d7">2.0</data>
  <data key="d8">Overweight in children, defined as BMI at or above the 85th percentile, is a key risk factor for type 2 diabetes when combined with other conditions.&lt;SEP&gt;Most people with type 2 diabetes have overweight, indicating a strong association between the two.</data>
  <data key="d9">BMI association,association,pediatric risk,risk factor</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7&lt;SEP&gt;chunk-2a874190e40ad535ac9b317a469571d7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647630</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Beta-Cell Dysfunction">
  <data key="d7">1.0</data>
  <data key="d8">Type 2 diabetes involves beta-cell dysfunction often in the context of insulin resistance and metabolic stress.</data>
  <data key="d9">insulin secretion defect,metabolic dysfunction</data>
  <data key="d10">chunk-c47356c03c704ef89b9f41bbd939bc8a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647669</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Insulin Secretory Defect">
  <data key="d7">1.0</data>
  <data key="d8">Insulin secretory defect is a core feature of type 2 diabetes, often occurring alongside insulin resistance.</data>
  <data key="d9">disease特征,pathophysiological mechanism</data>
  <data key="d10">chunk-c47356c03c704ef89b9f41bbd939bc8a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647673</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Diabetes Risk Test">
  <data key="d7">1.0</data>
  <data key="d8">The Diabetes Risk Test is used to evaluate an individual's risk of developing type 2 diabetes.</data>
  <data key="d9">risk assessment,screening</data>
  <data key="d10">chunk-2a874190e40ad535ac9b317a469571d7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647725</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Diabetes Prevention Program Research Group">
  <data key="d7">1.0</data>
  <data key="d8">The Diabetes Prevention Program Research Group studied methods to reduce the incidence of type 2 diabetes.</data>
  <data key="d9">clinical research,diabetes prevention</data>
  <data key="d10">chunk-d3d27a8dbb6882ee6a732de5ac202d64</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647757</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Finnish Diabetes Prevention Study Group">
  <data key="d7">1.0</data>
  <data key="d8">The Finnish Diabetes Prevention Study Group investigated the prevention of type 2 diabetes through lifestyle changes.</data>
  <data key="d9">clinical research,diabetes prevention</data>
  <data key="d10">chunk-d3d27a8dbb6882ee6a732de5ac202d64</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647758</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Insulin Secretion">
  <data key="d7">1.0</data>
  <data key="d8">Defective insulin secretion contributes to the inability to normalize blood glucose in type 2 diabetes.</data>
  <data key="d9">beta cell dysfunction,hormonal regulation</data>
  <data key="d10">chunk-e4f56a727625747d95bd88ea9712defc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647778</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Hyperglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Hyperglycemia is a defining feature of type 2 diabetes caused by impaired insulin action or secretion.</data>
  <data key="d9">clinical manifestation,metabolic imbalance</data>
  <data key="d10">chunk-e4f56a727625747d95bd88ea9712defc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647779</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Hypertension">
  <data key="d7">1.0</data>
  <data key="d8">Hypertension commonly coexists with type 2 diabetes and increases the risk of macrovascular complications.</data>
  <data key="d9">cardiovascular risk,comorbidity</data>
  <data key="d10">chunk-e4f56a727625747d95bd88ea9712defc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647780</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Dyslipidemia">
  <data key="d7">1.0</data>
  <data key="d8">Dyslipidemia is frequently present in individuals with type 2 diabetes and contributes to cardiovascular disease risk.</data>
  <data key="d9">lipid abnormality,metabolic syndrome</data>
  <data key="d10">chunk-e4f56a727625747d95bd88ea9712defc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647781</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Genetic Predisposition">
  <data key="d7">1.0</data>
  <data key="d8">A strong genetic predisposition, especially in first-degree relatives, increases susceptibility to type 2 diabetes.</data>
  <data key="d9">family history,heredity</data>
  <data key="d10">chunk-e4f56a727625747d95bd88ea9712defc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647782</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Paterson AD">
  <data key="d7">1.0</data>
  <data key="d8">Paterson AD advocated for using HbA1c in type 2 diabetes diagnosis with consideration for African and African American populations through personalized medicine.</data>
  <data key="d9">diagnostic method,personalized medicine</data>
  <data key="d10">chunk-050dc3a498d3027939b93706cbdb7f07</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647802</data>
  <data key="d13"></data>
</edge>
<edge source="Type 2 Diabetes" target="Adults With Type 1 Or Type 2 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Some adults have type 2 diabetes, which influences their treatment plan and glycemic goals.</data>
  <data key="d9">adult management,disease classification</data>
  <data key="d10">chunk-12999315830b302d973dd1908eab1e12</data>
