<edge source="Diabetes Mitocondrial" target="Metformina">
  <data key="d7">1.0</data>
  <data key="d8">Patients with mitochondrial diabetes should avoid metformin due to the potential risk of metabolic acidosis.</data>
  <data key="d9">adverse effect risk,treatment contraindication</data>
