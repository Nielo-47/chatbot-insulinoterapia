</edge>
<edge source="Agulha de 4 Mm" target="Adulto">
  <data key="d7">1.0</data>
  <data key="d8">A 4 mm needle is safe and effective for adults, as skin thickness rarely exceeds 3 mm, regardless of weight, age, sex, or ethnicity.</data>
  <data key="d9">adult use,subcutaneous delivery</data>
