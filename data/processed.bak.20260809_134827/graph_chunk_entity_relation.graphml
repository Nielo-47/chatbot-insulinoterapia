  <data key="d13"></data>
</edge>
<edge source="Random C-Peptide" target="Fotopoulou et al.">
  <data key="d7">1.0</data>
  <data key="d8">Fotopoulou et al. found that 86.8% of patients with clinical type 1 diabetes had C-peptide below 0.6 ng/ml, leading to reclassification in 6.8% of cases.&gt;</data>
  <data key="d9">clinical evaluation,reclassification impact</data>
  <data key="d10">chunk-45f87c8aceb9340a61d8283da6282edc</data>
