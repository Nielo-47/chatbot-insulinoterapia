</node>
<node id="Observational Study">
  <data key="d0">Observational Study</data>
  <data key="d1">method</data>
  <data key="d2">An observational study is a type of research where data is collected without intervention, used to assess real-world outcomes of isCGM use.</data>
  <data key="d3">chunk-fdddb31a1876a8809b8555564982acd4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
