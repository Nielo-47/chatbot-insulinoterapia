</node>
<node id="C A Crowther">
  <data key="d0">C A Crowther</data>
  <data key="d1">person</data>
  <data key="d2">C A Crowther is a lead researcher in the Australian Carbohydrate Intolerance Study in Pregnant Women (ACHOIS).</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647393</data>
  <data key="d6"></data>
</node>
<node id="J E Hiller">
  <data key="d0">J E Hiller</data>
  <data key="d1">person</data>
