</edge>
<edge source="Locais De Aplicação De Insulina" target="Coxas">
  <data key="d7">1.0</data>
  <data key="d8">As coxas são um local apropriado para aplicação de insulina, especialmente na parte frontal e lateral.</data>
  <data key="d9">body region,recommended site</data>
  <data key="d10">chunk-e490a7e963a20e2221a8097b50073543</data>
