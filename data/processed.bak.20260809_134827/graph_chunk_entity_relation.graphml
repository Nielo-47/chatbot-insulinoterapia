  <data key="d1">content</data>
  <data key="d2">Hiper e Hipoglicemia is an educational guide providing instructions on managing high and low blood sugar levels.</data>
  <data key="d3">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
