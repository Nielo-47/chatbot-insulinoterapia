  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646993</data>
  <data key="d6"></data>
</node>
<node id="Walker M">
  <data key="d0">Walker M</data>
  <data key="d1">person</data>
  <data key="d2">Walker M is a co-author of studies on MIDD and mitochondrial mutations.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646994</data>
  <data key="d6"></data>
</node>
<node id="Moyle G">
  <data key="d0">Moyle G</data>
  <data key="d1">person</data>
  <data key="d2">Moyle G is a researcher who discussed mitochondrial toxicity, including myths and facts in the context of HIV therapy.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646994</data>
  <data key="d6"></data>
</node>
<node id="Nalini R">
  <data key="d0">Nalini R</data>
  <data key="d1">person</data>
  <data key="d2">Nalini R is a co-author of research on ketosis-prone diabetes.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646994</data>
  <data key="d6"></data>
</node>
<node id="Anti-Insulin Antibody Test">
  <data key="d0">Anti-Insulin Antibody Test</data>
  <data key="d1">method</data>
  <data key="d2">The anti-insulin antibody test detects antibodies against insulin but may be interfered with by exogenous insulin therapy.&gt;</data>
  <data key="d3">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646994</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Mellitus Type 1B">
  <data key="d0">Diabetes Mellitus Type 1B</data>
  <data key="d1">concept</data>
  <data key="d2">Diabetes Mellitus Type 1B is a subtype of type 1 diabetes diagnosed when random C-peptide levels are below 0.6 ng/ml in patients with at least five years of disease duration.&gt;</data>
  <data key="d3">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646994</data>
  <data key="d6"></data>
</node>
<node id="Jones et al.">
  <data key="d0">Jones et al.</data>
  <data key="d1">person</data>
  <data key="d2">Jones et al. proposed a cutoff of 0.6 ng/ml or 0.2 nmol/l for random C-peptide to differentiate between type 1 diabetes with absolute insulin deficiency and other forms of diabetes.&gt;</data>
  <data key="d3">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646994</data>
  <data key="d6"></data>
</node>
<node id="Fotopoulou et al.">
  <data key="d0">Fotopoulou et al.</data>
  <data key="d1">person</data>
  <data key="d2">Fotopoulou et al. evaluated random C-peptide levels in 859 patients clinically diagnosed with type 1 diabetes and found that 86.8% had levels below 0.6 ng/ml.&gt;</data>
  <data key="d3">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646995</data>
  <data key="d6"></data>
</node>
<node id="C-Peptide Conversion">
  <data key="d0">C-Peptide Conversion</data>
  <data key="d1">method</data>
  <data key="d2">C-peptide conversion refers to the process of converting C-peptide measurements between units such as ng/ml, pmol/l, and nmol/l using standardized formulas or online tools.&gt;</data>
  <data key="d3">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646995</data>
  <data key="d6"></data>
</node>
<node id="UNITSLAB.COM">
  <data key="d0">UNITSLAB.COM</data>
  <data key="d1">content</data>
  <data key="d2">UNITSLAB.COM is an online platform providing a converter for C-peptide units between conventional and SI units.&gt;</data>
  <data key="d3">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646995</data>
  <data key="d6"></data>
</node>
<node id="Serum C-Pe游戏副本eptide Levels">
  <data key="d0">Serum C-Pe游戏副本eptide Levels</data>
  <data key="d3">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d2">In LADA patients, C-peptide levels are normal or elevated initially, distinguishing it from classic Type 1 diabetes.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647014</data>
  <data key="d6"></data>
</node>
<node id="Metabolic Rate">
  <data key="d0">Metabolic Rate</data>
  <data key="d3">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d2">Thyroid Hormone increases metabolic rate and can affect glucose homeostasis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647119</data>
  <data key="d6"></data>
</node>
<node id="Glycogenolysis">
  <data key="d0">Glycogenolysis</data>
  <data key="d3">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d2">Beta Adrenergic Agonists stimulate glycogenolysis, increasing blood glucose levels.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647120</data>
  <data key="d6"></data>
</node>
<node id="Glucose Tolerance">
  <data key="d0">Glucose Tolerance</data>
  <data key="d3">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d2">Thiazides impair glucose tolerance and may precipitate hyperglycemia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647120</data>
  <data key="d6"></data>
</node>
<node id="Glucose Metabolism">
  <data key="d0">Glucose Metabolism</data>
  <data key="d3">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d2">Phenytoin may interfere with glucose metabolism, affecting glycemic control.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647121</data>
  <data key="d6"></data>
</node>
<node id="MOD">
  <data key="d0">MOD</data>
  <data key="d3">chunk-cd082b3c0d74b1afd1fdd6eb23b6afd4</data>
  <data key="d2">HNF (Hepatocyte Nuclear Factor) includes HNF4A, a transcription factor whose mutations lead to MODY-HNF4A and neonatal hypoglycemia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647126</data>
  <data key="d6"></data>
</node>
<node id="Optic Atrophy">
  <data key="d0">Optic Atrophy</data>
  <data key="d3">chunk-b31a7157123c058dcd7f3c29001cd7f8</data>
  <data key="d2">Optic atrophy is a key feature of Wolfram syndrome, usually appearing after diabetes, with onset around 11 years.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647136</data>
  <data key="d6"></data>
</node>
<node id="Deafness">
  <data key="d0">Deafness</data>
  <data key="d3">chunk-b31a7157123c058dcd7f3c29001cd7f8</data>
  <data key="d2">Sensorineural deafness is a common feature of Wolfram syndrome.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647138</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Insipidus">
  <data key="d0">Diabetes Insipidus</data>
  <data key="d3">chunk-b31a7157123c058dcd7f3c29001cd7f8</data>
  <data key="d2">Diabetes insipidus is part of the clinical triad in Wolfram syndrome.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647140</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Subtypes">
  <data key="d0">Diabetes Subtypes</data>
  <data key="d3">chunk-1fb7f10473b84f2de23852febe7ef317</data>
  <data key="d2">Precision therapy is used to treat specific diabetes subtypes based on genetic and molecular diagnosis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647196</data>
  <data key="d6"></data>
</node>
<node id="MIDD">
  <data key="d0">MIDD</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d2">The 3243A&gt;G mitochondrial point mutation is associated with maternally inherited diabetes and deafness (MIDD).</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776647227</data>
  <data key="d6"></data>
</node>
<node id="J Formos Med Assoc">
  <data key="d0">J Formos Med Assoc</data>
  <data key="d1">content</data>
  <data key="d2">J Formos Med Assoc is a medical journal that published a cohort study on hypertension cutoffs and diabetes risk.</data>
  <data key="d3">chunk-15a18ecfcb20fceb4fd80ab22186964e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647256</data>
  <data key="d6"></data>
</node>
<node id="PLoS Med">
  <data key="d0">PLoS Med</data>
  <data key="d1">content</data>
  <data key="d2">PLoS Med is a journal that published a transethnic genome-wide meta-analysis on genetic determinants of hemoglobin A1c and type 2 diabetes risk.&lt;SEP&gt;PLoS Med is a peer-reviewed open-access journal that published a population-based cohort study on preconception diabetes and adverse pregnancy outcomes.&lt;SEP&gt;PLoS Med is an open-access medical journal that published a trend analysis on HbA1c levels and severe hypoglycemia in children and young adults with type 1 diabetes.</data>
  <data key="d3">chunk-15a18ecfcb20fceb4fd80ab22186964e&lt;SEP&gt;chunk-050dc3a498d3027939b93706cbdb7f07&lt;SEP&gt;chunk-7203a21c31cbdae88ee8bc33914cd054</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689290</data>
  <data key="d6"></data>
</node>
<node id="Am J Obstet Gynecol">
  <data key="d0">Am J Obstet Gynecol</data>
  <data key="d1">content</data>
  <data key="d2">Am J Obstet Gynecol is a medical journal that published research on the health and cost burden of adverse birth outcomes associated with pregestational diabetes.&lt;SEP&gt;The American Journal of Obstetrics and Gynecology published comparative studies on diagnostic criteria for gestational diabetes.&lt;SEP&gt;Am J Obstet Gynecol is the abbreviated name for the American Journal of Obstetrics and Gynecology, which published a study on the impact of adopting IADPSG criteria for gestational diabetes.</data>
  <data key="d3">chunk-15a18ecfcb20fceb4fd80ab22186964e&lt;SEP&gt;chunk-45a8ca206e61b47964f899c929fbafb3&lt;SEP&gt;chunk-69bf97ae94c34166c23acdc1a684b6bb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647256</data>
  <data key="d6"></data>
</node>
<node id="J Acquir Immune Defic Syndr">
  <data key="d0">J Acquir Immune Defic Syndr</data>
  <data key="d1">content</data>
  <data key="d2">J Acquir Immune Defic Syndr is a journal that published recommendations on managing metabolic complications in HIV patients undergoing antiretroviral therapy.</data>
  <data key="d3">chunk-15a18ecfcb20fceb4fd80ab22186964e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647256</data>
  <data key="d6"></data>
</node>
<node id="International AIDS Society-USA">
  <data key="d0">International AIDS Society-USA</data>
  <data key="d1">organization</data>
  <data key="d2">International AIDS Society-USA is an organization that formed a panel to recommend management strategies for metabolic complications in HIV patients on antiretroviral therapy.</data>
  <data key="d3">chunk-15a18ecfcb20fceb4fd80ab22186964e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647257</data>
  <data key="d6"></data>
</node>
<node id="Classification and Diagnosis of Diabetes">
  <data key="d0">Classification and Diagnosis of Diabetes</data>
  <data key="d1">content</data>
  <data key="d2">Classification and Diagnosis of Diabetes is a section in the Diabetes Care journal that outlines criteria for distinguishing between types of diabetes.&lt;SEP&gt;Classification and Diagnosis of Diabetes is a section or publication outlining criteria and methods for diagnosing diabetes.&lt;SEP&gt;Classification and Diagnosis of Diabetes is a topic discussed in a publication on page 20 of a document, likely part of the Diabetes Care journal.</data>
  <data key="d3">chunk-15a18ecfcb20fceb4fd80ab22186964e&lt;SEP&gt;chunk-c47356c03c704ef89b9f41bbd939bc8a&lt;SEP&gt;chunk-dd2e74b5f8450784b7c60acd6751ae14</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647257</data>
  <data key="d6"></data>
</node>
<node id="ADDITION-Europe">
  <data key="d0">ADDITION-Europe</data>
  <data key="d1">study</data>
  <data key="d2">ADDITION-Europe is a cluster-randomized trial that studied the effect of early intensive multifactorial therapy on cardiovascular outcomes in individuals with screen-detected type 2 diabetes.</data>
  <data key="d3">chunk-15a18ecfcb20fceb4fd80ab22186964e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647257</data>
  <data key="d6"></data>
</node>
<node id="75-G OGTT">
  <data key="d0">75-G OGTT</data>
  <data key="d1">method</data>
  <data key="d2">The 75-gram Oral Glucose Tolerance Test (75-g OGTT) is a diagnostic method used to assess glucose tolerance during pregnancy, performed at 24–28 weeks of gestation.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647273</data>
  <data key="d6"></data>
</node>
<node id="International Association of the Diabetes and Pregnancy Study Groups">
  <data key="d0">International Association of the Diabetes and Pregnancy Study Groups</data>
  <data key="d1">organization</data>
  <data key="d2">The International Association of the Diabetes and Pregnancy Study Groups (IADPSG) established diagnostic criteria for gestational diabetes using the 75-g OGTT.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647275</data>
  <data key="d6"></data>
</node>
<node id="Hyperglycemia and Adverse Pregnancy Outcome Study">
  <data key="d0">Hyperglycemia and Adverse Pregnancy Outcome Study</data>
  <data key="d1">event</data>
  <data key="d2">The Hyperglycemia and Adverse Pregnancy Outcome (HAPO) study is a large-scale multinational cohort study that demonstrated a continuous increase in adverse pregnancy outcomes with rising maternal glycemia.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647276</data>
  <data key="d6"></data>
</node>
<node id="O'Sullivan and Mahan Criteria">
  <data key="d0">O'Sullivan and Mahan Criteria</data>
  <data key="d1">method</data>
  <data key="d2">The O'Sullivan and Mahan criteria are the original diagnostic standards for GDM that were later interpreted by Carpenter-Coustan for use in the two-step diagnostic approach.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647277</data>
  <data key="d6"></data>
</node>
<node id="Two-Step Approach">
  <data key="d0">Two-Step Approach</data>
  <data key="d1">method</data>
  <data key="d2">The two-step approach for GDM diagnosis involves an initial 50-g nonfasting glucose screen followed by a 100-g OGTT for those who screen positive.&lt;SEP&gt;The two-step approach for diagnosing GDM first uses a 50-g GLT for screening, followed by a 3-hour 100-g OGTT if the screen is positive, using thresholds such as Carpenter-Coustan or National Diabetes Data Group.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a&lt;SEP&gt;chunk-7869f89a9c58ace31efe679a36aab7cf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647278</data>
  <data key="d6"></data>
</node>
<node id="One-Step Strategy">
  <data key="d0">One-Step Strategy</data>
  <data key="d1">method</data>
  <data key="d2">The one-step strategy for GDM diagnosis uses a single 75-g OGTT at 24–28 weeks of gestation to diagnose GDM based on IADPSG criteria.&lt;SEP&gt;The one-step strategy for diagnosing GDM involves using the IADPSG criteria with a single diagnostic test, typically a 2-hour 75-g oral glucose tolerance test.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a&lt;SEP&gt;chunk-7869f89a9c58ace31efe679a36aab7cf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647278</data>
  <data key="d6"></data>
</node>
<node id="Preeclampsia">
  <data key="d0">Preeclampsia</data>
  <data key="d1">concept</data>
  <data key="d2">Preeclampsia is an adverse pregnancy outcome associated with gestational diabetes and high maternal glucose levels.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647279</data>
  <data key="d6"></data>
</node>
<node id="Macrosomia">
  <data key="d0">Macrosomia</data>
  <data key="d1">concept</data>
  <data key="d2">Macrosomia is a condition where a newborn has excessive birth weight, associated with maternal hyperglycemia during pregnancy.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647280</data>
  <data key="d6"></data>
</node>
<node id="Shoulder Dystocia">
  <data key="d0">Shoulder Dystocia</data>
  <data key="d1">concept</data>
  <data key="d2">Shoulder dystocia is a birth complication linked to gestational diabetes and macrosomia, occurring when the baby’s shoulder gets stuck during delivery.&lt;SEP&gt;Shoulder dystocia is a childbirth complication where the baby's shoulders get stuck during delivery, which is reduced by treating higher-threshold maternal hyperglycemia.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a&lt;SEP&gt;chunk-7869f89a9c58ace31efe679a36aab7cf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647281</data>
  <data key="d6"></data>
</node>
<node id="Perinatal Death">
  <data key="d0">Perinatal Death</data>
  <data key="d1">concept</data>
  <data key="d2">Perinatal death is a serious adverse outcome associated with uncontrolled maternal glycemia and gestational diabetes.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647281</data>
  <data key="d6"></data>
</node>
<node id="Nutrition Counseling">
  <data key="d0">Nutrition Counseling</data>
  <data key="d1">method</data>
  <data key="d2">Nutrition counseling is recommended for managing early abnormal glucose metabolism during pregnancy to help control blood glucose levels.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647282</data>
  <data key="d6"></data>
</node>
<node id="Glucose Testing">
  <data key="d0">Glucose Testing</data>
  <data key="d1">method</data>
  <data key="d2">Glucose testing involves periodic monitoring of blood glucose levels, ranging from weekly to daily, to identify and manage hyperglycemia in pregnancy.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647283</data>
  <data key="d6"></data>
</node>
<node id="Hemoglobinopathies">
  <data key="d0">Hemoglobinopathies</data>
  <data key="d1">concept</data>
  <data key="d2">Hemoglobinopathies are genetic disorders affecting hemoglobin structure, such as sickle cell trait, which can interfere with A1C measurement accuracy.&lt;SEP&gt;Hemoglobinopathies, such as sickle cell disease, are genetic disorders affecting hemoglobin that can interfere with A1C test accuracy.&lt;SEP&gt;Hemoglobinopathies are genetic disorders affecting hemoglobin that can lead to inaccuracies in A1C testing, typically resulting in lower readings.&lt;SEP&gt;Hemoglobinopathies are genetic disorders affecting hemoglobin structure, which can interfere with the accuracy of HbA1c measurements.&lt;SEP&gt;Hemoglobinopathies are genetic disorders affecting hemoglobin structure, which can interfere with the accuracy of HbA1c measurements.&lt;SEP&gt;Hemoglobinopathies are genetic disorders affecting hemoglobin structure and can cause inaccurate HbA1c measurements.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a&lt;SEP&gt;chunk-5b5fc9e82121669cb9d4aff08c8c9019&lt;SEP&gt;chunk-146b6bf0e9a99df13de25f5e1318178a&lt;SEP&gt;chunk-8c3c6ce19ad6bc3cc3df22e5e10b0702&lt;SEP&gt;chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689264</data>
  <data key="d6"></data>
</node>
<node id="Red Blood Cell Turnover">
  <data key="d0">Red Blood Cell Turnover</data>
  <data key="d1">concept</data>
  <data key="d2">Red blood cell turnover impacts the reliability of A1C testing, with increased turnover leading to lower A1C values and decreased turnover leading to higher values.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647284</data>
  <data key="d6"></data>
</node>
<node id="Table 2.7">
  <data key="d0">Table 2.7</data>
  <data key="d1">artifact</data>
  <data key="d2">Table 2.7 provides guidelines for the screening and diagnosis of gestational diabetes mellitus (GDM), outlining criteria for both one-step and two-step diagnostic strategies.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647284</data>
  <data key="d6"></data>
</node>
<node id="50-G Screen">
  <data key="d0">50-G Screen</data>
  <data key="d1">method</data>
  <data key="d2">The 50-g screen is a nonfasting glucose challenge test used in the two-step approach to identify individuals who require further testing with a 100-g OGTT for GDM diagnosis.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647285</data>
  <data key="d6"></data>
</node>
<node id="100-G OGTT">
  <data key="d0">100-G OGTT</data>
  <data key="d1">method</data>
  <data key="d2">The 100-gram Oral Glucose Tolerance Test (100-g OGTT) is used in the two-step approach to diagnose GDM following a positive 50-g screen.</data>
  <data key="d3">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647285</data>
  <data key="d6"></data>
</node>
<node id="Autoantibody">
  <data key="d0">Autoantibody</data>
  <data key="d1">concept</data>
  <data key="d2">Autoantibodies are immune markers whose presence and number correlate with increased risk of developing type 1 diabetes. Detection of these is used in screening and risk assessment.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647286</data>
  <data key="d6"></data>
</node>
<node id="Fr1da">
  <data key="d0">Fr1da</data>
  <data key="d1">organization</data>
  <data key="d2">Fr1da is a diabetes screening program in Europe that identifies children at risk for type 1 diabetes through autoantibody testing.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647288</data>
  <data key="d6"></data>
</node>
<node id="Gppad.org">
  <data key="d0">Gppad.org</data>
  <data key="d1">organization</data>
  <data key="d2">Gppad.org is a European consortium involved in screening programs for autoimmune diabetes in children.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647289</data>
  <data key="d6"></data>
</node>
<node id="Trialnet.org">
  <data key="d0">Trialnet.org</data>
  <data key="d1">organization</data>
  <data key="d2">TrialNet is a U.S.-based screening and research network for type 1 diabetes that offers risk assessment and monitoring for at-risk individuals.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647289</data>
  <data key="d6"></data>
</node>
<node id="Askhealth.org">
  <data key="d0">Askhealth.org</data>
  <data key="d1">organization</data>
  <data key="d2">Askhealth.org is a U.S. screening initiative that provides testing and education for individuals at risk of developing diabetes.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647289</data>
  <data key="d6"></data>
</node>
<node id="Cascadekids.org">
  <data key="d0">Cascadekids.org</data>
  <data key="d1">organization</data>
  <data key="d2">Cascadekids.org is a U.S. screening program focused on identifying children with a family history of autoimmune diabetes.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647289</data>
  <data key="d6"></data>
</node>
<node id="Cardiovascular Disease">
  <data key="d0">Cardiovascular Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Cardiovascular disease (CVD) is a comorbidity associated with prediabetes and type 2 diabetes, and its risk factors should be identified and treated in affected individuals.&lt;SEP&gt;Cardiovascular disease (CVD) refers to conditions affecting the heart and blood vessels, with increased risk associated with prediabetes and diabetes.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974&lt;SEP&gt;chunk-1a862c4dc9595df3958bd7626f7145d3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647291</data>
  <data key="d6"></data>
</node>
<node id="Screening Program">
  <data key="d0">Screening Program</data>
  <data key="d1">organization</data>
  <data key="d2">Screening programs such as Fr1da, TrialNet, and others aim to identify individuals at risk for diabetes through autoantibody testing, risk assessment, and education.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647293</data>
  <data key="d6"></data>
</node>
<node id="Table 2.3">
  <data key="d0">Table 2.3</data>
  <data key="d1">data</data>
  <data key="d2">Table 2.3 outlines the criteria for screening for diabetes or prediabetes in asymptomatic adults, listing risk factors such as family history, race/ethnicity, hypertension, and obesity.&lt;SEP&gt;Table 2.3 provides the criteria for screening individuals for prediabetes.&lt;SEP&gt;Table 2.3 is a reference tool used for informal assessment of risk factors for prediabetes and type 2 diabetes.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974&lt;SEP&gt;chunk-e4f56a727625747d95bd88ea9712defc&lt;SEP&gt;chunk-1a862c4dc9595df3958bd7626f7145d3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647303</data>
  <data key="d6"></data>
</node>
<node id="Table 2.4">
  <data key="d0">Table 2.4</data>
  <data key="d1">data</data>
  <data key="d2">Table 2.4 contains the evidence grading of risk factors for diabetes in children and adolescents with overweight or obesity.&lt;SEP&gt;Table 2.4 provides recommendations on risk-based screening for type 2 diabetes or prediabetes in asymptomatic children and adolescents in a clinical setting.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974&lt;SEP&gt;chunk-eb9c311fc732ddd262c56ddc696da954</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647303</data>
  <data key="d6"></data>
</node>
<node id="Table 2.5">
  <data key="d0">Table 2.5</data>
  <data key="d1">data</data>
  <data key="d2">Table 2.5 defines the laboratory criteria for diagnosing prediabetes and type 2 diabetes, including A1C, fasting glucose, and oral glucose tolerance test values.&lt;SEP&gt;Table 2.5 outlines the criteria for defining prediabetes using fasting plasma glucose, 2-hour plasma glucose during OGTT, and A1C levels.&lt;SEP&gt;Table 2.5 outlines the criteria for the diagnosis of prediabetes that apply to children, adolescents, and adults.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974&lt;SEP&gt;chunk-eb9c311fc732ddd262c56ddc696da954&lt;SEP&gt;chunk-1a862c4dc9595df3958bd7626f7145d3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647304</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.7">
  <data key="d0">Recommendation 2.7</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.7 advises screening for prediabetes and type 2 diabetes in asymptomatic adults using risk factor assessment or a validated risk calculator.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647304</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.8">
  <data key="d0">Recommendation 2.8</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.8 states that screening should begin at age 35 for all people, regardless of risk factors.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647305</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.9">
  <data key="d0">Recommendation 2.9</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.9 suggests repeating screening every 3 years if results are normal, or sooner if symptoms or risk changes occur.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647305</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.10">
  <data key="d0">Recommendation 2.10</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.10 identifies fasting plasma glucose, 2-hour plasma glucose during OGTT, and A1C as appropriate tests for screening prediabetes and type 2 diabetes.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647306</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.11">
  <data key="d0">Recommendation 2.11</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.11 extends screening to children and adolescents with overweight or obesity and one or more risk factors, starting at puberty or age 10.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647306</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.12">
  <data key="d0">Recommendation 2.12</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.12 specifies that adequate carbohydrate intake (at least 150 g/day) should be maintained for 3 days prior to oral glucose tolerance testing.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647307</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.13">
  <data key="d0">Recommendation 2.13</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.13 emphasizes the importance of identifying and treating cardiovascular disease risk factors in people with prediabetes and type 2 diabetes.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647307</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.14">
  <data key="d0">Recommendation 2.14</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.14 supports risk-based screening for prediabetes and type 2 diabetes after the onset of puberty or after age 10, whichever occurs earlier.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647307</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 2.15">
  <data key="d0">Recommendation 2.15</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 2.15 includes screening for diabetes and prediabetes in people with HIV before and after changes in antiretroviral therapy.</data>
  <data key="d3">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647308</data>
  <data key="d6"></data>
</node>
<node id="DCCT Assay">
  <data key="d0">DCCT Assay</data>
  <data key="d1">method</data>
  <data key="d2">The DCCT assay is a reference method used for standardizing A1C tests and is associated with the Diabetes Control and Complications Trial.</data>
  <data key="d3">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647308</data>
  <data key="d6"></data>
</node>
<node id="A1C Test">
  <data key="d0">A1C Test</data>
  <data key="d1">method</data>
  <data key="d2">The A1C test is a diagnostic method used to measure average blood glucose levels over time and is used in diagnosing diabetes with a threshold of 6.5%.&lt;SEP&gt;The A1C test measures average blood glucose levels over time and is used for screening and diagnosing diabetes, requiring NGSP certification and standardization to the DCCT assay.&lt;SEP&gt;The A1C test measures average blood glucose levels but may underestimate glycemia in people with HIV and is not recommended for diagnosis in this group.&lt;SEP&gt;The A1C test is a diagnostic tool for glycemia but may underestimate blood glucose levels in people with HIV and is not recommended for diagnosis in certain pediatric and clinical conditions.</data>
  <data key="d3">chunk-5b5fc9e82121669cb9d4aff08c8c9019&lt;SEP&gt;chunk-eb9c311fc732ddd262c56ddc696da954&lt;SEP&gt;chunk-8317327cb2c248762b2dc3852c662000&lt;SEP&gt;chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647309</data>
  <data key="d6"></data>
</node>
<node id="Clinical Laboratory Improvement Amendments">
  <data key="d0">Clinical Laboratory Improvement Amendments</data>
  <data key="d1">organization</data>
  <data key="d2">The Clinical Laboratory Improvement Amendments (CLIA) regulate laboratory testing standards, including personnel qualifications and proficiency testing for A1C assays.</data>
  <data key="d3">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647312</data>
  <data key="d6"></data>
</node>
<node id="ADA Position Statement">
  <data key="d0">ADA Position Statement</data>
  <data key="d1">content</data>
  <data key="d2">The ADA position statement titled “Diagnosis and Classification of Diabetes Mellitus” provides evidence-based guidelines for diagnosing diabetes, prediabetes, and abnormal glucose tolerance.</data>
  <data key="d3">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647314</data>
  <data key="d6"></data>
</node>
<node id="NGSP.org">
  <data key="d0">NGSP.org</data>
  <data key="d1">content</data>
  <data key="d2">NGSP.org is the official website of the National Glycohemoglobin Standardization Program, providing information on A1C test standardization.</data>
  <data key="d3">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647315</data>
  <data key="d6"></data>
</node>
<node id="ADA Risk Test">
  <data key="d0">ADA Risk Test</data>
  <data key="d1">method</data>
  <data key="d2">The ADA risk test is a tool used to assess an individual's risk of developing type 2 diabetes, available via diabetes.org/socrisktest.&lt;SEP&gt;The ADA risk test is a screening tool used to assess an individual's risk for prediabetes and type 2 diabetes based on key risk factors.</data>
  <data key="d3">chunk-a51a13b6846af5dd45aca8b13432e7fc&lt;SEP&gt;chunk-e4f56a727625747d95bd88ea9712defc</data>
