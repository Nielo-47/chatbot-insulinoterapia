  <data key="d12">1776639963</data>
  <data key="d13"></data>
</edge>
<edge source="Physical Activity" target="Lipodystrophies">
  <data key="d7">1.0</data>
  <data key="d8">Regular physical activity, particularly aerobic exercise, is recommended to improve glycemic and lipid control in lipodystrophy patients.</data>
  <data key="d9">lifestyle intervention,metabolic benefit</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
