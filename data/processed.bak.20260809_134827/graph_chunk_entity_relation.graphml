<node id="Family Behavioral Intervention">
  <data key="d0">Family Behavioral Intervention</data>
  <data key="d1">method</data>
  <data key="d2">Family Behavioral Intervention is a psychosocial approach used to support CGM use in young children with type 1 diabetes.</data>
  <data key="d3">chunk-1af4e8af9934463f38c5951016d9664b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
