  <data key="d6"></data>
</node>
<node id="Plasma Blood Glucose">
  <data key="d0">Plasma Blood Glucose</data>
  <data key="d1">data</data>
  <data key="d2">Plasma blood glucose is a direct measure of glucose concentration and is recommended for diagnosing diabetes in conditions where A1C is unreliable.&lt;SEP&gt;Plasma blood glucose is a direct measure of glucose concentration and is recommended for diagnosing diabetes in conditions where A1C is unreliable.</data>
  <data key="d3">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
