</edge>
<edge source="Type 1 Diabetes" target="Screening For Type 1 Diabetes Risk">
  <data key="d7">1.0</data>
  <data key="d8">Screening for autoantibodies helps identify individuals at risk of progressing to clinical type 1 diabetes.</data>
