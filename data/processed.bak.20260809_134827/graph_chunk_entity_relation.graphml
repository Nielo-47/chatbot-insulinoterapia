  <data key="d6"></data>
</node>
<node id="Diferenças Étnicas">
  <data key="d0">Diferenças Étnicas</data>
  <data key="d1">concept</data>
  <data key="d2">Diferenças Étnicas affect HbA1c measurements, with individuals of African descent potentially showing higher HbA1c levels than expected for their glycemic profile, leading to false-positive diagnoses.&lt;SEP&gt;Diferenças Étnicas affect HbA1c measurements, with individuals of African descent potentially showing higher HbA1c levels than expected for their glycemic profile, leading to false-positive diagnoses.</data>
  <data key="d3">chunk-8fd2d58abc8f20df1ff7ae241f4cfee7</data>
