  <data key="d0">Consumerguide.diabetes.org</data>
  <data key="d1">content</data>
  <data key="d2">Consumerguide.diabetes.org is an American Diabetes Association resource to help patients and professionals make informed decisions about diabetes devices.</data>
  <data key="d3">chunk-90452c5625b363eb503added0caf901d</data>
