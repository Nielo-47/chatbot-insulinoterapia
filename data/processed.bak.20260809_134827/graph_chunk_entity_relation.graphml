<edge source="Sociedade Brasileira De Diabetes" target="HbA1c %">
  <data key="d7">1.0</data>
  <data key="d8">The Sociedade Brasileira de Diabetes recommends an HbA1c target of &lt;7.0% for most individuals with diabetes to prevent complications.</data>
  <data key="d9">clinical recommendation,treatment target</data>
  <data key="d10">chunk-0a582234d1973113fc899208b5457f47</data>
