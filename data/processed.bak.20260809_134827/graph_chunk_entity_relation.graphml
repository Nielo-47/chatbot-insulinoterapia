</edge>
<edge source="Type 1 Diabetes" target="Environmental Determinants of Diabetes in the Young">
  <data key="d7">1.0</data>
  <data key="d8">The TEDDY study investigates environmental triggers for type 1 diabetes in genetically susceptible children.</data>
  <data key="d9">longitudinal study,risk factors</data>
  <data key="d10">chunk-0510d1781e9c07bebd7a7422d453cbf2</data>
