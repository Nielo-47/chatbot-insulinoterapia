<edge source="Glycemia" target="Diabetes Mellitus Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">Random plasma glucose ≥200 mg/dL in the presence of typical symptoms is recommended for diagnosing diabetes mellitus.</data>
  <data key="d9">diagnostic threshold,hyperglycemia</data>
