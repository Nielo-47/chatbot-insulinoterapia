<node id="Kir6.2">
  <data key="d0">Kir6.2</data>
  <data key="d1">gene</data>
  <data key="d2">Kir6.2 is a gene associated with neonatal diabetes, and mutations in this gene can lead to diabetes treatable with sulfonylureas.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646983</data>
  <data key="d6"></data>
</node>
<node id="SUR1">
  <data key="d0">SUR1</data>
  <data key="d1">gene</data>
  <data key="d2">SUR1 is a sulfonylurea receptor 1 gene, and mutations in this gene can cause diabetes that responds to oral sulfonylurea treatment.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646984</data>
  <data key="d6"></data>
</node>
<node id="3243A&gt;G Mitochondrial Point Mutation">
  <data key="d0">3243A&gt;G Mitochondrial Point Mutation</data>
  <data key="d1">geneticvariant</data>
  <data key="d2">The 3243A&gt;G mitochondrial point mutation is associated with maternally inherited diabetes and deafness (MIDD), a form of diabetes linked to mitochondrial dysfunction.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646984</data>
  <data key="d6"></data>
</node>
<node id="Mitochondrial Disease">
  <data key="d0">Mitochondrial Disease</data>
  <data key="d1">disease</data>
  <data key="d2">Mitochondrial disease refers to disorders caused by mitochondrial dysfunction, which can include forms of diabetes such as MIDD.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646984</data>
  <data key="d6"></data>
</node>
<node id="Ketosis-Prone Diabetes Mellitus">
  <data key="d0">Ketosis-Prone Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">Ketosis-prone diabetes mellitus is a syndrome characterized by episodes of diabetic ketoacidosis, often seen in certain populations and sometimes misdiagnosed as type 1 or type 2 diabetes.&lt;SEP&gt;Ketosis-prone diabetes mellitus is a syndrome characterized by episodes of diabetic ketoacidosis without a permanent requirement for insulin.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb&lt;SEP&gt;chunk-0510d1781e9c07bebd7a7422d453cbf2</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647429</data>
  <data key="d6"></data>
</node>
