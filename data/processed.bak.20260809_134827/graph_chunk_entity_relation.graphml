</edge>
<edge source="Diabetes Mellitus" target="Prevalence Of Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">The prevalence of type 2 diabetes in youth increased by 30.5% from 2001 to 2009, with higher rates observed in minority populations.</data>
  <data key="d9">epidemiological trend,population data</data>
