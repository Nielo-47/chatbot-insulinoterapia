  <data key="d5">1776688800</data>
  <data key="d6"></data>
</node>
<node id="Interfering Substances">
  <data key="d0">Interfering Substances</data>
  <data key="d1">concept</data>
  <data key="d2">Interfering substances are compounds like icodextrin or those affecting glucose dehydrogenase systems that may compromise CGM accuracy.&lt;SEP&gt;Interfering Substances are compounds such as ascorbic acid, uric acid, and acetaminophen that can cause inaccurate glucose meter readings.</data>
  <data key="d3">chunk-f12d6a3cebf5c39bed5629c359502cae&lt;SEP&gt;chunk-da2ab5aba6808664342df831e5ba749f</data>
