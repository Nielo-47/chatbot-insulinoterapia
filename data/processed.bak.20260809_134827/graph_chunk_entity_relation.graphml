<node id="Vitiligo">
  <data key="d0">Vitiligo</data>
  <data key="d1">concept</data>
  <data key="d2">Vitiligo is a skin condition involving depigmentation and is associated with autoimmune processes in type 1 diabetes.&lt;SEP&gt;Vitiligo is a skin condition involving depigmentation and is associated with autoimmune processes in type 1 diabetes.</data>
