  <data key="d12">1776644864</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Sensação De Fome">
  <data key="d7">1.0</data>
  <data key="d8">Intense hunger is triggered by hormonal responses during episodes of hipoglicemia.</data>
  <data key="d9">hormonal signaling,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644865</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Palidez">
  <data key="d7">1.0</data>
  <data key="d8">Paleness occurs due to reduced peripheral blood flow during hypoglycemic episodes.</data>
  <data key="d9">circulatory response,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644865</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Mudança De Comportamento">
  <data key="d7">1.0</data>
  <data key="d8">Behavioral changes such as irritability result from brain glucose deprivation in hipoglicemia.</data>
  <data key="d9">neurological effect,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644866</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Tomar As Medicações E/ou Insulina">
  <data key="d7">1.0</data>
  <data key="d8">Improper dosing of medications or insulin can lead to hipoglicemia as a side effect.</data>
  <data key="d9">glucose lowering,treatment risk</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644867</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Monitorar E Controlar A Glicemia">
  <data key="d7">1.0</data>
  <data key="d8">Monitoring blood glucose levels helps detect and prevent hipoglicemia.</data>
  <data key="d9">disease management,prevention</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644868</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Ter Uma Alimentação Saudável E Balanceada">
  <data key="d7">1.0</data>
  <data key="d8">Proper nutrition helps avoid sudden drops in blood glucose, preventing hipoglicemia.</data>
  <data key="d9">dietary management,prevention</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644868</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Realizar Atividade Física">
  <data key="d7">1.0</data>
  <data key="d8">Excessive physical activity without adequate glucose intake can trigger hipoglicemia.</data>
  <data key="d9">glucose consumption,risk factor</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644913</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Hipoglicemia Leve">
  <data key="d7">1.0</data>
  <data key="d8">Hipoglicemia leve is a mild form of hypoglycemia occurring when glucose levels are between 54 and 70 mg/dL.</data>
  <data key="d9">classification,severity level</data>
  <data key="d10">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644921</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Hipoglicemia Moderada">
  <data key="d7">1.0</data>
  <data key="d8">Hipoglicemia moderada is a more severe form of hypoglycemia occurring when glucose levels fall below 54 mg/dL.</data>
  <data key="d9">classification,severity level</data>
  <data key="d10">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644922</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Diabetes Mellitus">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes Mellitus patients are at risk of developing hipoglicemia due to medication or insulin use.</data>
  <data key="d9">chronic condition,complication</data>
  <data key="d10">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644923</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="HbA1c">
  <data key="d7">1.0</data>
  <data key="d8">In patients without access to modern insulin or glucose sensors, a slightly higher HbA1c is preferred to reduce the risk of hypoglycemia.</data>
  <data key="d9">safety balance,treatment trade-off</data>
  <data key="d10">chunk-82e0d8e22a06c73855abed11561ce467</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1776648247</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Sintomas Comuns">
  <data key="d7">1.0</data>
  <data key="d8">Hipoglicemia presents with Sintomas Comuns such as tremors, cold sweat, sudden hunger, and confusion, aiding in early detection.</data>
  <data key="d9">clinical presentation,symptom recognition</data>
  <data key="d10">chunk-82e0d8e22a06c73855abed11561ce467</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1776648249</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="O Que Fazer">
  <data key="d7">1.0</data>
  <data key="d8">O Que Fazer outlines the recommended actions when a patient experiences Hipoglicemia, including glucose testing and carbohydrate intake.</data>
  <data key="d9">emergency response,treatment protocol</data>
  <data key="d10">chunk-82e0d8e22a06c73855abed11561ce467</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1776648251</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Lanche Leve">
  <data key="d7">1.0</data>
  <data key="d8">After recovery, a Lanche Leve helps stabilize Glicemia and prevent recurrence of Hipoglicemia.</data>
  <data key="d9">metabolic stabilization,prevention</data>
  <data key="d10">chunk-82e0d8e22a06c73855abed11561ce467</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1776648253</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="LO">
  <data key="d7">2.0</data>
  <data key="d8">O indicador LO no glicosímetro geralmente indica uma condição de hipoglicemia, que pode ser perigosa.&lt;SEP&gt;A indicação LO no medidor ou sensor indica hipoglicemia, exigindo ação imediata.</data>
  <data key="d9">health risk,low glucose,medical condition</data>
  <data key="d10">chunk-1136d6aac4c2e881387a4db1a0f4a3a3&lt;SEP&gt;chunk-5dce7a759a9de18a4d1bcc77a071fbe2</data>
