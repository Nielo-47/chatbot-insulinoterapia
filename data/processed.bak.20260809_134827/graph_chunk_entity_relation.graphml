  <data key="d13"></data>
</edge>
<edge source="Cateter" target="Cânula">
  <data key="d7">1.0</data>
  <data key="d8">A cânula está conectada ao cateter, formando um canal para a passagem de insulina do reservatório ao tecido subcutâneo.</data>
