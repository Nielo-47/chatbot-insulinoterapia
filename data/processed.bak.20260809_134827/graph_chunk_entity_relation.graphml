  <data key="d13"></data>
</edge>
<edge source="Antiretroviral Therapy" target="HIV">
  <data key="d7">2.0</data>
  <data key="d8">Antiretroviral therapy is used to treat HIV but may affect glucose metabolism, increasing diabetes risk.&lt;SEP&gt;Antiretroviral therapy is used to manage HIV but is linked to increased risk of prediabetes and diabetes.</data>
  <data key="d9">metabolic impact,side effect,treatment</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974&lt;SEP&gt;chunk-8317327cb2c248762b2dc3852c662000</data>
