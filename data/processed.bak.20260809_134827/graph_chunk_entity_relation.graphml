</edge>
<edge source="Hypoglycemia" target="Glycemic Control">
  <data key="d7">1.0</data>
  <data key="d8">Intensive glycemic control increases the risk of hypoglycemia, which must be individually assessed, especially in vulnerable populations.</data>
  <data key="d9">safety concern,treatment risk</data>
  <data key="d10">chunk-02fb9dc2bae2939b212aa5df09194ee4</data>
