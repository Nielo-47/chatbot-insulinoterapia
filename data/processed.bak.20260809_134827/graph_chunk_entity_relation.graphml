<edge source="Blood Glucose Level" target="Fasting">
  <data key="d7">1.0</data>
  <data key="d8">Fasting is the condition under which baseline Blood Glucose Level is measured, typically ranging from 70 to 100 mg/dL.</data>
  <data key="d9">clinical measurement,metabolic state</data>
