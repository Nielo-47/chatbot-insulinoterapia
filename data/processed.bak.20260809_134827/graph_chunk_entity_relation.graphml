</edge>
<edge source="Insulina" target="Aplicação De Insulina">
  <data key="d7">1.0</data>
  <data key="d8">A insulina é o medicamento administrado durante o processo de aplicação de insulina.</data>
  <data key="d9">medical administration,treatment process</data>
  <data key="d10">chunk-e490a7e963a20e2221a8097b50073543</data>
