  <data key="d0">Classe IIa</data>
  <data key="d1">concept</data>
  <data key="d2">Classe IIa is a classification indicating a moderate recommendation based on moderate-quality evidence in the clinical guidelines.</data>
  <data key="d3">chunk-d8434e93fae47721617db0727fcd99b1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
