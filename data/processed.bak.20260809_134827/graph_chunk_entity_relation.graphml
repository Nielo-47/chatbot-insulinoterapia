</edge>
<edge source="Stankute et al." target="Genetic Testing">
  <data key="d7">1.0</data>
  <data key="d8">Stankute et al. conducted genetic testing in young patients with diabetes and negative antibodies to identify monogenic forms.</data>
  <data key="d9">clinical application,research study</data>
  <data key="d10">chunk-19939072ec52c9018a4c4b386cfd11b8</data>
