</edge>
<edge source="Differential Diagnosis" target="Cushing Syndrome">
  <data key="d7">1.0</data>
  <data key="d8">Cushing Syndrome is differentiated from lipodystrophy due to overlapping features such as abnormal fat distribution and metabolic complications.</data>
