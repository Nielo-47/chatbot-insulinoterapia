  <data key="d12">1776638312</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Application" target="Hard Plastic Container">
  <data key="d7">1.0</data>
  <data key="d8">Used syringes must be discarded in a hard plastic container to ensure safe disposal and prevent needlestick injuries.</data>
  <data key="d9">safety,sharps disposal</data>
  <data key="d10">chunk-e4654b5e9fa02cf051c2d5ebc846c5d6</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638313</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Application" target="Skin Preparation">
  <data key="d7">1.0</data>
  <data key="d8">The skin must be cleaned with alcohol and allowed to dry before insulin application to reduce infection risk.</data>
  <data key="d9">hygiene,infection prevention</data>
