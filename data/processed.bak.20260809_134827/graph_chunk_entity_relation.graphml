  <data key="d5">1776643666</data>
  <data key="d6"></data>
</node>
<node id="Tetracycline">
  <data key="d0">Tetracycline</data>
  <data key="d1">substance</data>
  <data key="d2">Tetracycline is a medication that may interfere with the accuracy of continuous glucose monitoring systems.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643666</data>
  <data key="d6"></data>
</node>
<node id="Continuous Glucose Monitoring Accuracy">
  <data key="d0">Continuous Glucose Monitoring Accuracy</data>
  <data key="d1">concept</data>
  <data key="d2">Continuous glucose monitoring accuracy refers to the reliability of CGM devices in measuring actual blood glucose levels, which can be affected by various substances.</data>
