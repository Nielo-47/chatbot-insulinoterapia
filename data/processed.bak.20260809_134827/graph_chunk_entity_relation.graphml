<node id="Diabetes Classification Guideline">
  <data key="d0">Diabetes Classification Guideline</data>
  <data key="d1">content</data>
  <data key="d2">Diabetes Classification Guideline is a document published by the Sociedade Brasileira de Diabetes outlining the etiopathogenic classification of diabetes and its subtypes, last revised on 14/12/2023.</data>
  <data key="d3">chunk-f5847db7a558804738e20dca9fd8d746</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
