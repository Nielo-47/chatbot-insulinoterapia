  <data key="d7">1.0</data>
  <data key="d8">Metformin is used in lipodystrophy patients to improve insulin sensitivity and manage metabolic complications.</data>
  <data key="d9">insulin sensitivity,pharmacological treatment</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640900</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Thiazolidinediones">
  <data key="d7">1.0</data>
  <data key="d8">Thiazolidinediones can increase subcutaneous fat and improve insulin sensitivity but may cause unwanted fat accumulation in non-lipodystrophic areas and are not recommended for generalized forms.</data>
  <data key="d9">adverse effect,pharmacological treatment</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640901</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Fibrates">
  <data key="d7">1.0</data>
  <data key="d8">Fibrates are first-line agents for treating refractory hypertriglyceridemia in patients with lipodystrophy.</data>
  <data key="d9">lipid management,pharmacological treatment</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640902</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Statins">
  <data key="d7">1.0</data>
  <data key="d8">Statins may be used in combination with fibrates (except gemfibrozil) to manage dyslipidemia in lipodystrophy patients.</data>
  <data key="d9">combination therapy,pharmacological treatment</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640903</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Niacin">
  <data key="d7">1.0</data>
  <data key="d8">Niacin is not recommended in lipodystrophy due to its potential to increase insulin resistance.</data>
  <data key="d9">contraindicated treatment,metabolic risk</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640904</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Estrogens">
  <data key="d7">1.0</data>
  <data key="d8">Estrogens are contraindicated in women with lipodystrophy due to the risk of worsening hypertriglyceridemia.</data>
  <data key="d9">contraindicated treatment,lipid risk</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640937</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Dietary Management">
  <data key="d7">1.0</data>
  <data key="d8">Dietary management, including low-fat diet and omega-3 supplementation, is recommended to manage metabolic complications in lipodystrophy.</data>
  <data key="d9">lifestyle intervention,metabolic control</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640938</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Alcohol Consumption">
  <data key="d7">1.0</data>
  <data key="d8">Alcohol consumption should be avoided in lipodystrophy patients due to its negative metabolic effects.</data>
  <data key="d9">behavioral risk,metabolic impact</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640938</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Psychological Support">
  <data key="d7">1.0</data>
  <data key="d8">Psychological support is recommended for patients and families to address the psychosocial impact of lipodystrophy.</data>
  <data key="d9">psychosocial management,supportive care</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640940</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Diagnostic Evaluation">
  <data key="d7">1.0</data>
  <data key="d8">Diagnostic evaluation involves detailed history, physical examination, and assessment of inheritance patterns to identify lipodystrophy.</data>
  <data key="d9">clinical assessment,disease confirmation</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640940</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Imaging Tests">
  <data key="d7">1.0</data>
  <data key="d8">Imaging tests such as DXA, whole-body MRI, and bioimpedance are used to evaluate body fat distribution in lipodystrophy.</data>
  <data key="d9">diagnostic method,fat distribution analysis</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640941</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Holter Monitoring">
  <data key="d7">1.0</data>
  <data key="d8">Holter monitoring is used in lipodystrophy patients with suspected cardiomyopathy or coronary artery disease.</data>
  <data key="d9">arrhythmia detection,cardiac evaluation</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640944</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Echocardiogram">
  <data key="d7">1.0</data>
  <data key="d8">Echocardiogram is used to assess cardiac structure and function in patients with lipodystrophy-related cardiomyopathy.</data>
  <data key="d9">cardiac evaluation,structural assessment</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640945</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Stress Test">
  <data key="d7">1.0</data>
  <data key="d8">Stress testing is performed to evaluate cardiovascular function during exertion in suspected coronary artery disease.</data>
  <data key="d9">cardiac evaluation,functional assessment</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640946</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Molecular Testing">
  <data key="d7">1.0</data>
  <data key="d8">Molecular testing is indicated in suspected inherited lipodystrophies to confirm the genetic basis.</data>
  <data key="d9">genetic diagnosis,inherited forms</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640947</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Differential Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">The differential diagnosis of lipodystrophy includes insulin resistance syndromes and Cushing's syndrome to rule out similar clinical presentations.</data>
  <data key="d9">diagnostic process,disease distinction</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640947</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Lipodystrophy Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">Lipodystrophy diagnosis involves assessing clinical features such as age of onset, progression, comorbidities, and family history to confirm the condition.</data>
  <data key="d9">clinical evaluation,diagnostic process</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640948</data>
  <data key="d13"></data>
</edge>
<edge source="Lipodystrophies" target="Complementary Tests">
  <data key="d7">1.0</data>
  <data key="d8">Complementary tests are used to evaluate metabolic complications and autoimmunity in patients with lipodystrophy.</data>
  <data key="d9">complication assessment,diagnostic procedure</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640950</data>
  <data key="d13"></data>
</edge>
<edge source="Hypertension" target="Lipodystrophy Partial Familial">
  <data key="d7">1.0</data>
  <data key="d8">Hypertension is a comorbidity associated with familial partial lipodystrophy.</data>
  <data key="d9">cardiovascular risk,clinical association</data>
  <data key="d10">chunk-7c4fc351ae9ead9b05dca3f5378145b9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640996</data>
  <data key="d13"></data>
</edge>
<edge source="Hypertension" target="Lipodistrofias">
  <data key="d7">1.0</data>
  <data key="d8">Hypertension is a common feature in lipodystrophy, contributing to increased cardiovascular risk.</data>
  <data key="d9">cardiovascular risk,comorbidity</data>
  <data key="d10">chunk-c072c5ad49b2fb7ef54c9a2fe121badb</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776641049</data>
  <data key="d13"></data>
</edge>
<edge source="Hypertension" target="Prediabetes">
  <data key="d7">1.0</data>
  <data key="d8">Hypertension is commonly present in individuals with prediabetes and increases cardiovascular risk.</data>
  <data key="d9">cardiovascular comorbidity,risk factor</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
