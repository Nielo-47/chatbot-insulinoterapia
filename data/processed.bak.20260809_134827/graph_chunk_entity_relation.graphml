  <data key="d13"></data>
</edge>
<edge source="Sensor" target="Smartphone">
  <data key="d7">1.0</data>
  <data key="d8">The sensor sends glucose data to a smartphone application for continuous monitoring and alerts.</data>
  <data key="d9">data transmission,mobile integration</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638461</data>
  <data key="d13"></data>
</edge>
<edge source="Sensor" target="Lag Time">
  <data key="d7">2.0</data>
  <data key="d8">Lag time refers to the 10-minute delay between interstitial glucose readings from the sensor and actual blood glucose levels.&lt;SEP&gt;There is an average 10-minute lag time between capillary and interstitial glucose readings, affecting real-time data interpretation.</data>
  <data key="d9">accuracy,measurement delay,measurement limitation,physiological delay</data>
  <data key="d10">chunk-b6828aacfba0c2a6ae59c439a4e4b161&lt;SEP&gt;chunk-7a08dc7008091e5ab01812c301e0aab1</data>
