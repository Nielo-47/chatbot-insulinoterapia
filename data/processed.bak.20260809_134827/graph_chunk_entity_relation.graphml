</node>
<node id="HAPO Follow-Up Study Cooperative Research Group">
  <data key="d0">HAPO Follow-Up Study Cooperative Research Group</data>
  <data key="d1">organization</data>
  <data key="d2">The HAPO Follow-Up Study Cooperative Research Group is a research consortium conducting longitudinal studies on the effects of maternal hyperglycemia on offspring.&lt;SEP&gt;The HAPO Follow-Up Study Cooperative Research Group is a research consortium conducting longitudinal studies on the effects of maternal hyperglycemia on offspring.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
