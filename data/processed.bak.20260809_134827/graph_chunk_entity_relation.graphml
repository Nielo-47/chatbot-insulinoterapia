  <data key="d12">1776647669</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Plasma C-Peptide">
  <data key="d7">1.0</data>
  <data key="d8">Low or undetectable plasma C-peptide levels indicate advanced beta-cell destruction in type 1 diabetes.</data>
