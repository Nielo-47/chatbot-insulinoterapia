<edge source="Insulin NPH" target="Insulin Regular">
  <data key="d7">1.0</data>
  <data key="d8">Some people with diabetes use both Insulin NPH and Insulin Regular, requiring two separate pens clearly labeled to avoid mix-ups.</data>
  <data key="d9">differentiation,treatment regimen</data>
  <data key="d10">chunk-1b3b45cb29102851f76174e378f8e0cc</data>
