  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Rapid-Acting Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Rapid-acting insulin is the only type approved for intramuscular and intravenous administration.</data>
  <data key="d9">administration route,pharmacological class</data>
