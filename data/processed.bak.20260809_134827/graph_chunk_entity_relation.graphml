</edge>
<edge source="Hipoglicemia" target="Tempo Gasto &lt;54 Mg/Dl">
  <data key="d7">1.0</data>
  <data key="d8">O tempo com glicemia abaixo de 54 mg/dL deve ser mantido abaixo de 15 minutos por dia para evitar hipoglicemia grave.</data>
