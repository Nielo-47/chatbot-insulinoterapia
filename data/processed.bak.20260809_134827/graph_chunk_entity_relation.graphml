<node id="James Havens">
  <data key="d0">James Havens</data>
  <data key="d1">person</data>
  <data key="d2">James Havens is associated with the early development of insulin at the University of Toronto around 1921.&lt;SEP&gt;James Havens is associated with the early development of insulin at the University of Toronto around 1921.&lt;SEP&gt;James Havens is associated with the early development of insulin at the University of Toronto around 1921.</data>
  <data key="d3">chunk-69124f1cc2248b019af52b9d2e71c12e</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/The Discovery and Development.pdf</data>
