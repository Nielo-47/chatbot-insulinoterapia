  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Glucose Testing">
  <data key="d7">1.0</data>
  <data key="d8">Regular glucose testing is used to monitor and manage blood sugar levels in individuals at risk for or diagnosed with GDM.</data>
  <data key="d9">disease management,monitoring method</data>
