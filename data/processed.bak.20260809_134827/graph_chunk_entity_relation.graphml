  <data key="d13"></data>
</edge>
<edge source="Recommendation 2.9" target="Screening Interval">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.9 recommends repeating screening every 3 years if initial results are normal, or sooner with changes in risk.</data>
  <data key="d9">follow-up testing,normal results</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974</data>
