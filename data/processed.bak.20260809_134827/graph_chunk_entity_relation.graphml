  <data key="d5">1776639041</data>
  <data key="d6"></data>
</node>
<node id="Heart Attack And Stroke">
  <data key="d0">Heart Attack And Stroke</data>
  <data key="d1">concept</data>
  <data key="d2">Heart attack and stroke are cardiovascular complications associated with poorly managed diabetes.</data>
  <data key="d3">chunk-b91b40e47c97be1b62c0f3d271cd4efd</data>
