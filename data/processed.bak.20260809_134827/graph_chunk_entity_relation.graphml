</edge>
<edge source="Bolus" target="Correction Bolus">
  <data key="d7">1.0</data>
  <data key="d8">A correction bolus is a type of bolus used to lower blood glucose to a target level.</data>
  <data key="d9">dose type,glucose correction</data>
  <data key="d10">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641897</data>
  <data key="d13"></data>
</edge>
<edge source="Bolus" target="Meal Bolus">
  <data key="d7">1.0</data>
  <data key="d8">A meal bolus is a type of bolus used to cover the carbohydrates in a meal.</data>
  <data key="d9">carbohydrate coverage,dose type</data>
  <data key="d10">chunk-768c26e20aaed169fbf07de7ca22c08d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
