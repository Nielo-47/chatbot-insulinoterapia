<edge source="Hba1c" target="Diagnosis Of Diabetes Mellitus">
  <data key="d7">1.0</data>
  <data key="d8">Hemoglobin A1c is used as a diagnostic criterion for classifying diabetes and prediabetes.</data>
  <data key="d9">diagnostic marker,glycemic assessment</data>
