  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Paciente">
  <data key="d7">1.0</data>
  <data key="d8">The patient recognizes symptoms of low blood sugar and takes immediate action to correct it.</data>
  <data key="d9">emergency response,symptom recognition</data>
