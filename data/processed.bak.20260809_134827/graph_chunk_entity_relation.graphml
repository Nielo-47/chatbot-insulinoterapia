<edge source="Lopinavir" target="Protease Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Lopinavir is a protease inhibitor linked to the development of lipodystrophy.</data>
  <data key="d9">component,drug classification</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
