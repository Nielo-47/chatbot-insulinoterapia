  <data key="d13"></data>
</edge>
<edge source="Recommendation 2.8" target="Age 35">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.8 states that screening for prediabetes and type 2 diabetes should begin at age 35 for all individuals.</data>
  <data key="d9">age-based criterion,screening initiation</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974</data>
