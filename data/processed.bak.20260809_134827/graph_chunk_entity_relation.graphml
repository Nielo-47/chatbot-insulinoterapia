</edge>
<edge source="SICI" target="DM1">
  <data key="d7">1.0</data>
  <data key="d8">SICI is considered the gold standard for treating patients with type 1 diabetes mellitus.</data>
  <data key="d9">standard of care,treatment indication</data>
