</node>
<node id="1 October 1921">
  <data key="d0">1 October 1921</data>
  <data key="d1">event</data>
  <data key="d2">On 1 October 1921, Banting secured a lecturer position and laboratory space, and retroactive pay was arranged for him and Best.&lt;SEP&gt;On 1 October 1921, Banting secured a lecturer position and laboratory space, and retroactive pay was arranged for him and Best.</data>
  <data key="d3">chunk-1bf43b932b33f125e5a5e679dcb50d79</data>
