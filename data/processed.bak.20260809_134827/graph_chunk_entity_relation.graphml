</node>
<node id="Randomized Clinical Trial">
  <data key="d0">Randomized Clinical Trial</data>
  <data key="d1">event</data>
  <data key="d2">A randomized clinical trial involving 1,289 type 2 diabetes patients evaluated the impact of structured education on HbA1c levels and medication adherence.</data>
  <data key="d3">chunk-a7740b86f0b3f110bb2c3f3d05e4da41</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d5">1776637696</data>
  <data key="d6"></data>
</node>
<node id="Moscow Clinical Trial">
  <data key="d0">Moscow Clinical Trial</data>
  <data key="d1">event</data>
  <data key="d2">A randomized clinical trial conducted in Moscow divided 116 patients into three groups to assess the impact of structured training and needle supply on insulin injection technique and A1C levels.</data>
  <data key="d3">chunk-a7740b86f0b3f110bb2c3f3d05e4da41</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
