  <data key="d6"></data>
</node>
<node id="Genetic Screening">
  <data key="d0">Genetic Screening</data>
  <data key="d1">method</data>
  <data key="d2">Genetic screening is used in research to identify individuals at high risk for type 1 diabetes based on HLA associations.&lt;SEP&gt;Genetic screening is recommended for children with hyperglycemia detected before 6 months of age without an evident secondary cause, and also for individuals with characteristic phenotypes of MODY-GCK even in the absence of family history.&lt;SEP&gt;Genetic screening is used in research to identify individuals at high risk for type 1 diabetes based on HLA associations.</data>
  <data key="d3">chunk-620e2d1316d6093170f1c9991caabc7e&lt;SEP&gt;chunk-cd082b3c0d74b1afd1fdd6eb23b6afd4</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
