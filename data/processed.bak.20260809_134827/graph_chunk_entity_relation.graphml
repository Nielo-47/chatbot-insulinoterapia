<edge source="IGT" target="2-h PG">
  <data key="d7">1.0</data>
  <data key="d8">Impaired glucose tolerance is diagnosed using 2-hour plasma glucose levels during a 75-g OGTT.</data>
  <data key="d9">diagnostic criterion,glucose tolerance test</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
