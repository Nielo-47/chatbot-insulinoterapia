  <data key="d13"></data>
</edge>
<edge source="Insulin Application" target="Cuidador">
  <data key="d7">1.0</data>
  <data key="d8">The caregiver must learn and correctly perform insulin application to support the patient's treatment.</data>
  <data key="d9">skill acquisition,treatment support</data>
  <data key="d10">chunk-3d0de4d525c273cda4939a501eaecc6d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
