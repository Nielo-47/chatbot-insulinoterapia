</edge>
<edge source="Sensor" target="Glucose Reader">
  <data key="d7">1.0</data>
  <data key="d8">The sensor wirelessly transmits glucose readings to a glucose reader that displays real-time values and trends.</data>
  <data key="d9">data transmission,device integration</data>
