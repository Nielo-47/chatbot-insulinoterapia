  <data key="d12">1776689406</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Insulin Analogues">
  <data key="d7">1.0</data>
  <data key="d8">The use of insulin analogues is associated with a lower risk of hypoglycemia compared to conventional insulin treatments.</data>
