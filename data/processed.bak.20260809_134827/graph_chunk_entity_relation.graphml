  <data key="d12">1776642342</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Análogos De Ação Rápida">
  <data key="d7">1.0</data>
  <data key="d8">Análogos de ação rápida são recomendados no esquema basal-bolus para reduzir o risco de hipoglicemia em pacientes com DM1.</data>
