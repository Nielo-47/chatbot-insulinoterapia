</edge>
<edge source="Gestational Diabetes Mellitus" target="Shoulder Dystocia">
  <data key="d7">1.0</data>
  <data key="d8">Shoulder dystocia is a potential consequence of macrosomia in infants of mothers with GDM.</data>
