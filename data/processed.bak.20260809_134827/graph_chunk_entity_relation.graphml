  <data key="d12">1776638390</data>
  <data key="d13"></data>
</edge>
<edge source="Syringe" target="Sharps Container">
  <data key="d7">1.0</data>
  <data key="d8">Used syringes must be disposed of in a sharps container to ensure safe handling and prevent injury.</data>
  <data key="d9">safety,waste disposal</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638391</data>
  <data key="d13"></data>
</edge>
<edge source="Syringe" target="Insulin Types">
  <data key="d7">1.0</data>
  <data key="d8">Rapid-acting and intermediate-acting insulins can be mixed in the same syringe, provided the correct order is followed to ensure efficacy.</data>
  <data key="d9">compatibility,mixing</data>
  <data key="d10">chunk-191286ebd759321d40620f77c84ef5a0</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638393</data>
  <data key="d13"></data>
</edge>
<edge source="Syringe" target="Excess Insulin">
  <data key="d7">1.0</data>
  <data key="d8">If excess insulin is drawn into the syringe, it must not be returned to the vial and the syringe must be discarded.</data>
  <data key="d9">disposal,procedural error</data>
  <data key="d10">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
