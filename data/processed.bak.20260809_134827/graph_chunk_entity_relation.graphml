  <data key="d12">1776647668</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Immunotherapy">
  <data key="d7">1.0</data>
  <data key="d8">Immunotherapy, including checkpoint inhibitors, is being studied for immune modulation in type 1 diabetes but may also trigger autoimmune responses.</data>
  <data key="d9">immune modulation,treatment</data>
