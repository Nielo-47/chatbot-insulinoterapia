  <data key="d13"></data>
</edge>
<edge source="C-Peptide" target="Ng/L">
  <data key="d7">1.0</data>
  <data key="d8">C-peptide can be measured in ng/L, a unit suitable for very low concentration readings.</data>
  <data key="d9">measurement,unit conversion</data>
