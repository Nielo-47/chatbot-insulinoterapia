</edge>
<edge source="Insulin Application" target="Patient">
  <data key="d7">2.0</data>
  <data key="d8">Patients should practice insulin application under supervision and repeat the process to confirm understanding.&lt;SEP&gt;Patients must learn and practice insulin application to manage their diabetes effectively and safely.</data>
  <data key="d9">self-care,technique,treatment practice</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275&lt;SEP&gt;chunk-03a1de93a53fbcb513268c123e2c5a16</data>
