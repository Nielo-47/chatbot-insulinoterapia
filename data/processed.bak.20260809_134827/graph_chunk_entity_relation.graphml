  <data key="d12">1776643775</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Insulin Pumps">
  <data key="d7">1.0</data>
  <data key="d8">Evidence suggests insulin pumps reduce the rates of severe and nocturnal hypoglycemia compared to MDI.</data>
  <data key="d9">risk reduction,safety</data>
  <data key="d10">chunk-f357ebc59eb6ed3dd2035a13da0df52f</data>
