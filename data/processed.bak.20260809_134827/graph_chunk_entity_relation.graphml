  <data key="d12">1776639110</data>
  <data key="d13"></data>
</edge>
<edge source="Abdomen" target="Third Trimester">
  <data key="d7">1.0</data>
  <data key="d8">Abdominal insulin injections are not recommended during the third trimester of pregnancy.</data>
  <data key="d9">injection restriction,safety</data>
