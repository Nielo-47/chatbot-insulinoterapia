  <data key="d13"></data>
</edge>
<edge source="Insulin Injection Site Rotation" target="Glycemia">
  <data key="d7">1.0</data>
  <data key="d8">Effective insulin injection site rotation supports stable insulin absorption, contributing to better glycemic control.</data>
  <data key="d9">glucose regulation,treatment efficacy</data>
  <data key="d10">chunk-708e3c514f667dc9979cfa8df875e473</data>
