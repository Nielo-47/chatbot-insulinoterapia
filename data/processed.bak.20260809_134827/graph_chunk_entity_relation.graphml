</edge>
<edge source="Carbohydrate Intake" target="Oral Glucose Tolerance Test">
  <data key="d7">1.0</data>
  <data key="d8">Carbohydrate intake prior to the oral glucose tolerance test affects the accuracy and interpretation of the test results.</data>
