  <data key="d12">1776638702</data>
  <data key="d13"></data>
</edge>
<edge source="Physical Activity" target="Insulin Injection Site">
  <data key="d7">1.0</data>
  <data key="d8">The choice of insulin injection site should consider upcoming physical activity to avoid rapid absorption and hypoglycemia.</data>
  <data key="d9">risk prevention,site selection</data>
