</edge>
<edge source="Insulin Bolus" target="Carbohydrate Intake Estimation">
  <data key="d7">1.0</data>
  <data key="d8">Accurate carbohydrate intake estimation is necessary to calculate the correct insulin bolus dose for proper glycemic management.</data>
  <data key="d9">dosing accuracy,metabolic control</data>
  <data key="d10">chunk-679c193ea4fd33e94141ac2c9fef69c9</data>
