  <data key="d12">1776647676</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Teplizumab">
  <data key="d7">1.0</data>
  <data key="d8">Teplizumab is an anti-CD3 antibody used to delay or prevent the onset of type 1 diabetes in high-risk individuals.</data>
