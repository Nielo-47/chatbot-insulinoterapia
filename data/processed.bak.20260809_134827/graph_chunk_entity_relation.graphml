  <data key="d13"></data>
</edge>
<edge source="Pré-Diabetes" target="Retinopatia Diabética">
  <data key="d7">1.0</data>
  <data key="d8">Population cohorts have evaluated the association between glycemic levels in pre-diabetes and the development of retinopathy diabética.</data>
  <data key="d9">complication association,risk progression</data>
  <data key="d10">chunk-8fd2d58abc8f20df1ff7ae241f4cfee7</data>
