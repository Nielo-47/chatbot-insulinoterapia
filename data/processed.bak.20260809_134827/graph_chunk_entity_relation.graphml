  <data key="d6"></data>
</node>
<node id="DRB1">
  <data key="d0">DRB1</data>
  <data key="d1">concept</data>
  <data key="d2">DRB1 is a gene haplotype associated with type 1 diabetes susceptibility and part of the HLA complex.&lt;SEP&gt;DRB1 is a gene haplotype associated with type 1 diabetes susceptibility and part of the HLA complex.</data>
  <data key="d3">chunk-620e2d1316d6093170f1c9991caabc7e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
