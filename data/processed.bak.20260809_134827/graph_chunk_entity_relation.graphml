  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Wolfram Syndrome">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes mellitus is typically the first manifestation of Wolfram syndrome, with onset around six years of age.</data>
  <data key="d9">clinical manifestation,early symptom</data>
  <data key="d10">chunk-b31a7157123c058dcd7f3c29001cd7f8</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647135</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Diabetes 3c">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes 3c is a subtype of diabetes mellitus caused by exocrine pancreatic diseases and is often misclassified as type 2 diabetes.</data>
  <data key="d9">disease classification,secondary diabetes</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647138</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Alcoholism">
  <data key="d7">1.0</data>
  <data key="d8">Alcoholism is a contributing factor to exocrine pancreatic disease, which can result in secondary diabetes (diabetes 3c).</data>
  <data key="d9">disease association,secondary cause</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647147</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Biliary Lithiasis">
  <data key="d7">1.0</data>
  <data key="d8">Biliary lithiasis can cause exocrine pancreatic disease, leading to the development of diabetes 3c.</data>
  <data key="d9">disease association,secondary cause</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647147</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Hyperglycemic Medications">
  <data key="d7">1.0</data>
  <data key="d8">The use of hyperglycemic medications is a potential cause of hyperglycemia and should be considered in diabetes classification.</data>
  <data key="d9">drug-induced disease,etiology</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647148</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Acromegaly">
  <data key="d7">1.0</data>
  <data key="d8">Acromegaly is an endocrine disorder that can induce hyperglycemia and contribute to secondary diabetes.</data>
  <data key="d9">endocrinopathy association,secondary diabetes</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647149</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Cushing Syndrome">
  <data key="d7">1.0</data>
  <data key="d8">Cushing Syndrome is an endocrine condition associated with hyperglycemia and secondary diabetes development.</data>
  <data key="d9">endocrinopathy association,secondary diabetes</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647149</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="HIV">
  <data key="d7">1.0</data>
  <data key="d8">HIV infection is linked to lipodystrophy and metabolic disturbances that can lead to diabetes.</data>
  <data key="d9">infection association,secondary cause</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647150</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Hepatitis B">
  <data key="d7">1.0</data>
  <data key="d8">Hepatitis B infection is a potential contributor to hyperglycemia and secondary diabetes.</data>
  <data key="d9">infection association,secondary cause</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647181</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Hepatitis C">
  <data key="d7">1.0</data>
  <data key="d8">Hepatitis C infection is associated with insulin resistance and can lead to secondary diabetes.</data>
  <data key="d9">infection association,secondary cause</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647182</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Hemochromatosis">
  <data key="d7">1.0</data>
  <data key="d8">Hemochromatosis can damage the pancreas and lead to the development of secondary diabetes.</data>
  <data key="d9">disease association,secondary cause</data>
  <data key="d10">chunk-02efb2a3687e39bf186d9b0146d95077</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
