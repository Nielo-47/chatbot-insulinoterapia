<edge source="Impaired Glucose Tolerance" target="Finnish Diabetes Prevention Study Group">
  <data key="d7">1.0</data>
  <data key="d8">The Finnish Diabetes Prevention Study Group focused on individuals with impaired glucose tolerance to prevent diabetes.</data>
