  <data key="d0">NPL/Lispro</data>
  <data key="d1">artifact</data>
  <data key="d2">NPL/Lispro refers to premixed insulin formulations containing NPL and Lispro, such as Humalog Mix 25 and Humalog Mix 50.</data>
  <data key="d3">chunk-fed992e01da83317a2c9f0adf751f53f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642312</data>
  <data key="d6"></data>
</node>
<node id="75% NPL/25% Lispro (Humalog Mix 25)">
  <data key="d0">75% NPL/25% Lispro (Humalog Mix 25)</data>
  <data key="d1">artifact</data>
  <data key="d2">75% NPL/25% Lispro (Humalog Mix 25) is a premixed insulin with a rapid onset of 5-15 minutes and duration of up to 16 hours.</data>
  <data key="d3">chunk-fed992e01da83317a2c9f0adf751f53f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642312</data>
  <data key="d6"></data>
