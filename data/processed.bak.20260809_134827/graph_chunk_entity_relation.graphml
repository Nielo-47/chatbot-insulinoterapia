  <data key="d6"></data>
</node>
<node id="Ke Et Al">
  <data key="d0">Ke Et Al</data>
  <data key="d1">person</data>
  <data key="d2">Ke et al. conducted a study in Hong Kong on the performance of clinical classification in a predominantly type 2 diabetes population.&lt;SEP&gt;Ke et al. are researchers who developed and validated algorithms to classify type 1 and type 2 diabetes using electronic health records.</data>
  <data key="d3">chunk-c156c40ae38c1b220a3c59d658c17171&lt;SEP&gt;chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d5">1776646903</data>
  <data key="d6"></data>
</node>
<node id="Algorithms To Classify Type 1 And 2 Diabetes">
  <data key="d0">Algorithms To Classify Type 1 And 2 Diabetes</data>
  <data key="d1">method</data>
