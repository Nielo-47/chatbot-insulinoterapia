  <data key="d13"></data>
</edge>
<edge source="Insulin Therapy" target="Hirsch Lj">
  <data key="d7">1.0</data>
  <data key="d8">Hirsch LJ is a key researcher in evaluating insulin injection techniques and needle safety.</data>
  <data key="d9">device evaluation,injection technique</data>
  <data key="d10">chunk-8fc83e266bdeb54c4139a50adf2b793a</data>
