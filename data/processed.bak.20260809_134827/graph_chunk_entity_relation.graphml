  <data key="d13"></data>
</edge>
<edge source="Corticosteroids" target="Iatrogenic Hypercortisolism">
  <data key="d7">1.0</data>
  <data key="d8">The use of corticosteroids carries a risk of iatrogenic hypercortisolism in patients.</data>
