<node id="Blood Glucose Recording">
  <data key="d0">Blood Glucose Recording</data>
  <data key="d1">method</data>
  <data key="d2">Blood glucose recording involves documenting test results to monitor glycemic control over time.&lt;SEP&gt;Blood glucose recording involves documenting test results to monitor glycemic control over time.&lt;SEP&gt;Blood glucose recording involves documenting test results to monitor glycemic control over time.</data>
