  <data key="d0">Sharps Injury</data>
  <data key="d1">event</data>
  <data key="d2">Sharps injury refers to accidental cuts or punctures from needles or other sharp medical instruments, a recognized occupational hazard in healthcare.</data>
  <data key="d3">chunk-54f4c3fffcb1c054dd2b100c36c64717</data>
