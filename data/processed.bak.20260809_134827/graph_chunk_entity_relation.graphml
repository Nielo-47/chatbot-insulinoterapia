  <data key="d4">data/raw/DOC Completo.docx</data>
  <data key="d5">1776638235</data>
  <data key="d6"></data>
</node>
<node id="People With Motor Limitations">
  <data key="d0">People With Motor Limitations</data>
  <data key="d1">person</data>
  <data key="d2">People with motor limitations or tremors may require assistance or slightly longer needles for easier insulin injection.&lt;SEP&gt;People with motor limitations or tremors may require assistance or slightly longer needles for easier insulin injection.&lt;SEP&gt;People with motor limitations or tremors may require assistance or slightly longer needles for easier insulin injection.</data>
