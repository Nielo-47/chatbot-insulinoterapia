</edge>
<edge source="Rapid-Acting Insulin" target="50-Unit Syringe">
  <data key="d7">1.0</data>
  <data key="d8">The 50-unit syringe allows accurate measurement of odd insulin doses, making it suitable for administering rapid-acting insulin to young patients.</data>
  <data key="d9">dose accuracy,pediatric use</data>
  <data key="d10">chunk-eb4a4dec39574c303988e93b87c351d4</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
