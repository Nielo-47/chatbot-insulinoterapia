  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641901</data>
  <data key="d13"></data>
</edge>
<edge source="SICI" target="MCG">
  <data key="d7">1.0</data>
  <data key="d8">SICI and MCG are advanced technologies that together represent the gold standard in diabetes treatment.</data>
  <data key="d9">diabetes management,technology integration</data>
  <data key="d10">chunk-2b712afd345ff5f7503205905d3131f9</data>
