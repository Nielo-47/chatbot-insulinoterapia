  <data key="d12">1776639126</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Pen Needle">
  <data key="d7">1.0</data>
  <data key="d8">The pen needle is attached to the insulin pen for injection and must be removed immediately afterward to prevent leakage and air entry.</data>
  <data key="d9">device-component,proper use</data>
  <data key="d10">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
