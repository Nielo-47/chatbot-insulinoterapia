  <data key="d12">1776648255</data>
  <data key="d13"></data>
</edge>
<edge source="Hipoglicemia" target="Profissional De Saúde">
  <data key="d7">1.0</data>
  <data key="d8">O profissional de saúde deve ser contatado imediatamente em caso de hipoglicemia confirmada ou suspeita.</data>
  <data key="d9">emergency response,medical guidance</data>
