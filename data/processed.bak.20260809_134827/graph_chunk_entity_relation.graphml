  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="One-Step Strategy">
  <data key="d7">1.0</data>
  <data key="d8">The one-step strategy uses a single 75-g OGTT to diagnose GDM without prior screening.</data>
