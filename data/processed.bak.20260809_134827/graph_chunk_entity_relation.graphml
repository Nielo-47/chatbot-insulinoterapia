<node id="Screening For Type 1 Diabetes">
  <data key="d0">Screening For Type 1 Diabetes</data>
  <data key="d1">method</data>
  <data key="d2">Screening for Type 1 Diabetes involves measuring autoantibodies in first-degree relatives of affected individuals to assess risk and enable early intervention.&lt;SEP&gt;Screening for Type 1 Diabetes involves measuring autoantibodies in first-degree relatives of affected individuals to assess risk and enable early intervention.</data>
  <data key="d3">chunk-309ce40527b1cc8f260e96e195742001</data>
