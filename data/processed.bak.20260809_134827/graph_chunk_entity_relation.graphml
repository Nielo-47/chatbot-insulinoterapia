  <data key="d0">Novo Nordisk Pharmaceutical Production Brazil Ltd</data>
  <data key="d1">organization</data>
  <data key="d2">Novo Nordisk Pharmaceutical Production Brazil Ltd is the manufacturer of Novolin N Flexpen.</data>
  <data key="d3">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
