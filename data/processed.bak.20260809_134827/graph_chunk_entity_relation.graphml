</node>
<node id="Large-For-Gestational-Age Births">
  <data key="d0">Large-For-Gestational-Age Births</data>
  <data key="d1">concept</data>
  <data key="d2">Large-for-gestational-age births refer to newborns with birth weight above the 90th percentile, associated with maternal hyperglycemia.&lt;SEP&gt;Large-for-gestational-age (LGA) births refer to infants born larger than expected for their gestational age, a risk reduced by treating maternal hyperglycemia.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84&lt;SEP&gt;chunk-7869f89a9c58ace31efe679a36aab7cf</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647415</data>
  <data key="d6"></data>
</node>
<node id="Neonatal Hypoglycemia">
  <data key="d0">Neonatal Hypoglycemia</data>
  <data key="d1">medicalcondition</data>
  <data key="d2">Neonatal hypoglycemia is a condition in newborns characterized by low blood glucose levels, often linked to maternal diabetes.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643694</data>
  <data key="d6"></data>
</node>
<node id="Basal Insulin Therapy">
  <data key="d0">Basal Insulin Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Basal insulin therapy involves long-acting insulin to maintain baseline glucose control in people with diabetes.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643694</data>
  <data key="d6"></data>
</node>
<node id="Noninsulin Therapy">
  <data key="d0">Noninsulin Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Noninsulin therapy refers to diabetes treatments that do not involve insulin, such as oral medications or lifestyle interventions.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643694</data>
  <data key="d6"></data>
</node>
<node id="RCT">
  <data key="d0">RCT</data>
  <data key="d1">method</data>
  <data key="d2">RCT stands for randomized controlled trial, a study design used to evaluate the effectiveness of medical interventions.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643694</data>
  <data key="d6"></data>
</node>
<node id="Observational Cohort Study">
  <data key="d0">Observational Cohort Study</data>
  <data key="d1">method</data>
  <data key="d2">An observational cohort study is a research method that follows a group over time to assess outcomes based on exposure or behavior.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643694</data>
  <data key="d6"></data>
</node>
<node id="Table 7.4">
  <data key="d0">Table 7.4</data>
  <data key="d1">content</data>
  <data key="d2">Table 7.4 lists interfering substances for continuous glucose monitoring devices, including medications and the systems they affect.</data>
  <data key="d3">chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643694</data>
  <data key="d6"></data>
</node>
<node id="Digital Therapeutics">
  <data key="d0">Digital Therapeutics</data>
  <data key="d1">artifact</data>
  <data key="d2">Digital therapeutics, also known as "digiceuticals," are FDA-approved digital technologies designed to treat medical or psychological conditions, including diabetes.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Tidepool">
  <data key="d0">Tidepool</data>
  <data key="d1">organization</data>
  <data key="d2">Tidepool is a cloud-based data aggregator program designed for people with diabetes, compliant with U.S. data privacy regulations.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Glooko">
  <data key="d0">Glooko</data>
  <data key="d1">organization</data>
  <data key="d2">Glooko is a cloud-based data aggregator program for diabetes management that ensures data security and compliance with HIPAA.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="U.S. Health Insurance Portability and Accountability Act Of 1996">
  <data key="d0">U.S. Health Insurance Portability and Accountability Act Of 1996</data>
  <data key="d1">concept</data>
  <data key="d2">The U.S. Health Insurance Portability and Accountability Act of 1996 establishes data privacy and security standards for protecting medical information.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Diabetes Prevention Program">
  <data key="d0">Diabetes Prevention Program</data>
  <data key="d1">event</data>
  <data key="d2">The Diabetes Prevention Program is a model used by some online interventions to treat prediabetes and prevent progression to diabetes.&lt;SEP&gt;The Diabetes Prevention Program (DPP) is a clinical study that identified high-risk individuals for diabetes and evaluated interventions to prevent or delay type 2 diabetes.&lt;SEP&gt;The Diabetes Prevention Program is a randomized clinical trial investigating interventions to prevent type 2 diabetes.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398&lt;SEP&gt;chunk-a775efb764958cf67853f275782e2a69&lt;SEP&gt;chunk-1a862c4dc9595df3958bd7626f7145d3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d5">1776647366</data>
  <data key="d6"></data>
</node>
<node id="Inpatient Care">
  <data key="d0">Inpatient Care</data>
  <data key="d1">concept</data>
  <data key="d2">Inpatient care refers to medical treatment provided in a hospital setting, where individuals with diabetes may continue using personal diabetes devices under supervision.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Coronavirus Disease 2019 Pandemic">
  <data key="d0">Coronavirus Disease 2019 Pandemic</data>
  <data key="d1">event</data>
  <data key="d2">The coronavirus disease 2019 pandemic prompted the FDA to allow temporary use of CGM devices in hospitals to reduce exposure and optimize patient monitoring.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Online Privacy And Security">
  <data key="d0">Online Privacy And Security</data>
  <data key="d1">concept</data>
  <data key="d2">Online privacy and security are critical concerns in digital health, requiring users to understand data policies and control over personal health information sharing.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Recommendation 7.30">
  <data key="d0">Recommendation 7.30</data>
  <data key="d1">concept</data>
  <data key="d2">Recommendation 7.30 supports the continued use of diabetes devices like insulin pumps and CGM in inpatient settings when the individual is competent and under proper supervision.</data>
  <data key="d3">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643695</data>
  <data key="d6"></data>
</node>
<node id="Standards of Care in Diabetes">
  <data key="d0">Standards of Care in Diabetes</data>
  <data key="d1">content</data>
  <data key="d2">The Standards of Care in Diabetes is a document published by the American Diabetes Association that outlines clinical practice recommendations, treatment goals, and tools for evaluating quality of care.&lt;SEP&gt;The Standards of Care in Diabetes is a publication by the American Diabetes Association that provides clinical practice recommendations, treatment goals, and tools for evaluating diabetes care quality.&lt;SEP&gt;The Standards of Care in Diabetes is a publication by the American Diabetes Association that provides clinical practice recommendations, treatment goals, and tools for evaluating diabetes care quality.</data>
  <data key="d3">chunk-f0524115c9e0c2a0ed35c413e50c658e&lt;SEP&gt;chunk-6f5cd98bab9909442c09e3fcd5b21fda</data>
