<edge source="Monitoramento Diário da Glicemia Capilar" target="Complicações Agudas e Crônicas">
  <data key="d7">3.0</data>
  <data key="d8">Daily capillary glucose monitoring helps prevent acute and chronic complications of diabetes.&lt;SEP&gt;Daily capillary glucose monitoring helps prevent acute and chronic complications of diabetes.&lt;SEP&gt;Daily capillary glucose monitoring helps prevent acute and chronic complications of diabetes.</data>
  <data key="d9">disease management,prevention</data>
  <data key="d10">chunk-19e4dac1289de717e1280645c07b7a40</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688857</data>
  <data key="d13"></data>
</edge>
<edge source="Inadequate Hand Drying" target="Wet Fingers">
  <data key="d7">3.0</data>
  <data key="d8">Inadequate hand drying leads to wet fingers, which can interfere with accurate blood glucose testing.&lt;SEP&gt;Inadequate hand drying leads to wet fingers, which can interfere with accurate blood glucose testing.&lt;SEP&gt;Inadequate hand drying leads to wet fingers, which can interfere with accurate blood glucose testing.</data>
  <data key="d9">cause,risk factor</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688858</data>
  <data key="d13"></data>
</edge>
<edge source="Fingers With Food Residue Containing Sugar" target="Blood Glucose Test Strips">
  <data key="d7">3.0</data>
  <data key="d8">Sugar residue on fingers can contaminate the test sample and cause falsely high glucose readings.&lt;SEP&gt;Sugar residue on fingers can contaminate the test sample and cause falsely high glucose readings.&lt;SEP&gt;Sugar residue on fingers can contaminate the test sample and cause falsely high glucose readings.</data>
  <data key="d9">contamination,interference</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688858</data>
  <data key="d13"></data>
</edge>
<edge source="Fingers With Alcohol Residue" target="Blood Glucose Test Strips">
  <data key="d7">3.0</data>
  <data key="d8">Alcohol residue on fingers may affect the chemical reaction on test strips, leading to inaccurate results.&lt;SEP&gt;Alcohol residue on fingers may affect the chemical reaction on test strips, leading to inaccurate results.&lt;SEP&gt;Alcohol residue on fingers may affect the chemical reaction on test strips, leading to inaccurate results.</data>
  <data key="d9">contamination,interference</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688859</data>
  <data key="d13"></data>
</edge>
<edge source="Fingers With Moisturizing Cream" target="Blood Glucose Test Strips">
  <data key="d7">3.0</data>
  <data key="d8">Moisturizing cream on fingers can contaminate the blood sample and compromise test accuracy.&lt;SEP&gt;Moisturizing cream on fingers can contaminate the blood sample and compromise test accuracy.&lt;SEP&gt;Moisturizing cream on fingers can contaminate the blood sample and compromise test accuracy.</data>
  <data key="d9">contamination,interference</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688860</data>
  <data key="d13"></data>
</edge>
<edge source="Expired Test Strips" target="Blood Glucose Test Strips">
  <data key="d7">3.0</data>
  <data key="d8">Expired test strips are no longer reliable and should not be used for glucose testing.&lt;SEP&gt;Expired test strips are no longer reliable and should not be used for glucose testing.&lt;SEP&gt;Expired test strips are no longer reliable and should not be used for glucose testing.</data>
  <data key="d9">expiration,reliability loss</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688860</data>
  <data key="d13"></data>
</edge>
<edge source="Environmental Conditions" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">Environmental conditions such as temperature and altitude can affect the accuracy of blood glucose tests.&lt;SEP&gt;Environmental conditions such as temperature and altitude can affect the accuracy of blood glucose tests.&lt;SEP&gt;Environmental conditions such as temperature and altitude can affect the accuracy of blood glucose tests.</data>
  <data key="d9">accuracy impact,external influence</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688859</data>
  <data key="d13"></data>
</edge>
<edge source="High Oxygen Partial Pressure" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">High oxygen partial pressure can interfere with glucose measurements in oxygen-sensitive devices.&lt;SEP&gt;High oxygen partial pressure can interfere with glucose measurements in oxygen-sensitive devices.&lt;SEP&gt;High oxygen partial pressure can interfere with glucose measurements in oxygen-sensitive devices.</data>
  <data key="d9">device sensitivity,oxygen interference</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688860</data>
  <data key="d13"></data>
</edge>
<edge source="Low Oxygen Partial Pressure" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">Low oxygen partial pressure can alter glucose readings, especially in devices affected by tissue oxygenation.&lt;SEP&gt;Low oxygen partial pressure can alter glucose readings, especially in devices affected by tissue oxygenation.&lt;SEP&gt;Low oxygen partial pressure can alter glucose readings, especially in devices affected by tissue oxygenation.</data>
  <data key="d9">oxygen interference,tissue perfusion</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688861</data>
  <data key="d13"></data>
</edge>
<edge source="Low Temperatures" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">Temperatures below 10°C can slow down the chemical reaction on test strips, affecting test accuracy.&lt;SEP&gt;Temperatures below 10°C can slow down the chemical reaction on test strips, affecting test accuracy.&lt;SEP&gt;Temperatures below 10°C can slow down the chemical reaction on test strips, affecting test accuracy.</data>
  <data key="d9">delayed reading,reaction inhibition</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688861</data>
  <data key="d13"></data>
</edge>
<edge source="Physiological And Medication Conditions" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">Various physiological and medication conditions can interfere with glucose test accuracy.&lt;SEP&gt;Various physiological and medication conditions can interfere with glucose test accuracy.&lt;SEP&gt;Various physiological and medication conditions can interfere with glucose test accuracy.</data>
  <data key="d9">biological interference,result distortion</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688862</data>
  <data key="d13"></data>
</edge>
<edge source="High Hematocrit" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">Elevated hematocrit levels (&gt;45%) can lead to altered glucose readings in some devices.&lt;SEP&gt;Elevated hematocrit levels (&gt;45%) can lead to altered glucose readings in some devices.&lt;SEP&gt;Elevated hematocrit levels (&gt;45%) can lead to altered glucose readings in some devices.</data>
  <data key="d9">blood viscosity,measurement bias</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688863</data>
  <data key="d13"></data>
</edge>
<edge source="Low Hematocrit" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">Low hematocrit levels (&lt;35%) may affect the accuracy of glucose measurements.&lt;SEP&gt;Low hematocrit levels (&lt;35%) may affect the accuracy of glucose measurements.&lt;SEP&gt;Low hematocrit levels (&lt;35%) may affect the accuracy of glucose measurements.</data>
  <data key="d9">blood composition,measurement bias</data>
  <data key="d10">chunk-5f2616cb245736f951a3dcbf261b3b9b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/Orientacoes_Glicemia_SBD.pdf</data>
  <data key="d12">1776688863</data>
  <data key="d13"></data>
</edge>
<edge source="Hyperuricemia" target="Blood Glucose Testing">
  <data key="d7">3.0</data>
  <data key="d8">Elevated uric acid levels may interfere with some glucose meter systems.&lt;SEP&gt;Elevated uric acid levels may interfere with some glucose meter systems.&lt;SEP&gt;Elevated uric acid levels may interfere with some glucose meter systems.</data>
