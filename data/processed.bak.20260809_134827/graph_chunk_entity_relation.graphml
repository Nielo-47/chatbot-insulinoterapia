  <data key="d12">1776637707</data>
  <data key="d13"></data>
</edge>
<edge source="Subcutaneous Injection" target="Forearm">
  <data key="d7">1.0</data>
  <data key="d8">The forearm was used as an injection site for insulin, although it is not recommended for routine insulin administration.</data>
  <data key="d9">improper use,injection site</data>
