</edge>
<edge source="Insulin" target="Glycemic Control">
  <data key="d7">1.0</data>
  <data key="d8">Proper insulin use is critical for maintaining glycemic control and preventing complications like hyperglycemia or hypoglycemia.</data>
  <data key="d9">blood glucose regulation,therapeutic effect</data>
  <data key="d10">chunk-dde6c55191737188788dc809811837cc</data>
