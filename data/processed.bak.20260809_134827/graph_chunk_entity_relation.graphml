  <data key="d5">1776643688</data>
  <data key="d6"></data>
</node>
<node id="Detemir Insulin">
  <data key="d0">Detemir Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Detemir insulin is a long-acting insulin that must not be mixed with any other insulin in the same syringe.</data>
  <data key="d3">chunk-c897fc79a7dde2715e95be7ca23f57f5</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/insulinas em seringa.pdf</data>
