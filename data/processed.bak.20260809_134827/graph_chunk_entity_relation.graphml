<node id="Postprandial Glycemic Control">
  <data key="d0">Postprandial Glycemic Control</data>
  <data key="d1">concept</data>
  <data key="d2">Postprandial glycemic control is the regulation of blood glucose levels after meals, a key target in diabetes management.</data>
  <data key="d3">chunk-6764f5f0af1c9855a1901ea1bef131d3</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642286</data>
  <data key="d6"></data>
