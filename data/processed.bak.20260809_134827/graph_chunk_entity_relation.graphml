  <data key="d12">1776642063</data>
  <data key="d13"></data>
</edge>
<edge source="Physical Activity" target="Blood Glucose Monitoring">
  <data key="d7">2.0</data>
  <data key="d8">Blood glucose levels should be checked before and during physical activity to manage potential hypoglycemia.&lt;SEP&gt;Glucose monitoring data can be used to adjust physical activity for better diabetes control.</data>
  <data key="d9">activity impact,glucose fluctuation,lifestyle management,treatment adjustment</data>
