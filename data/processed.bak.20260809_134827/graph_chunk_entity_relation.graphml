  <data key="d12">1776647620</data>
  <data key="d13"></data>
</edge>
<edge source="Hypertension" target="Diabetes Mellitus Type 2 Screening">
  <data key="d7">1.0</data>
  <data key="d8">Hypertension is a qualifying condition that supports the need for Type 2 Diabetes screening in overweight or obese youth.</data>
  <data key="d9">comorbidity,risk factor</data>
  <data key="d10">chunk-309ce40527b1cc8f260e96e195742001</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
