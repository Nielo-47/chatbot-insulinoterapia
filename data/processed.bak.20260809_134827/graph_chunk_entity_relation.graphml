  <data key="d13"></data>
</edge>
<edge source="Panniculitis" target="Corticosteroids">
  <data key="d7">1.0</data>
  <data key="d8">Corticosteroids are used to reduce progression of panniculitis but do not restore lost adipose tissue.</data>
  <data key="d9">disease management,treatment</data>
  <data key="d10">chunk-d0e841f6957bc713f769fbd0c5b5ee33</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
