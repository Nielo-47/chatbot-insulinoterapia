  <data key="d13"></data>
</edge>
<edge source="Locais De Aplicação De Insulina" target="Nádegas">
  <data key="d7">1.0</data>
  <data key="d8">As nádegas, no quadrante superior lateral externo, são um local seguro para aplicação de insulina.</data>
  <data key="d9">body region,recommended site</data>
  <data key="d10">chunk-e490a7e963a20e2221a8097b50073543</data>
