  <data key="d13"></data>
</edge>
<edge source="Insulin Injection Site Rotation" target="Injection Quadrants">
  <data key="d7">1.0</data>
  <data key="d8">Dividing injection sites into quadrants helps organize the rotation process and ensures adequate spacing between injection points.</data>
  <data key="d9">organized planning,systematic rotation</data>
