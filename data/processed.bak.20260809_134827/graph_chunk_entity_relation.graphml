  <data key="d13"></data>
</edge>
<edge source="Insulin Application" target="Blood Vessel">
  <data key="d7">1.0</data>
  <data key="d8">Accidental contact with a blood vessel during injection may cause sharp pain but does not lead to serious injury.</data>
  <data key="d9">injection complication,pain cause</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
