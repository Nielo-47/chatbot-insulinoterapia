  <data key="d12">1776647491</data>
  <data key="d13"></data>
</edge>
<edge source="Antiretroviral Therapy" target="Integrase Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Integrase inhibitors are a type of antiretroviral drug associated with increased insulin resistance and higher incidence of type 2 diabetes.</data>
  <data key="d9">drug class,metabolic impact</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689140</data>
  <data key="d13"></data>
</edge>
<edge source="Antiretroviral Therapy" target="Protease Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Protease inhibitors are antiretroviral agents linked to insulin resistance and increased risk of developing type 2 diabetes.</data>
  <data key="d9">drug class,metabolic impact</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
