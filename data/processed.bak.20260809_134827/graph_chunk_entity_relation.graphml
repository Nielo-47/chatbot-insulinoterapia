<edge source="Type 1 Diabetes" target="Pediatric Diabetes Consortium Registries">
  <data key="d7">1.0</data>
  <data key="d8">The Pediatric Diabetes Consortium Registries collect clinical data on children and adolescents with type 1 diabetes to assess characteristics and glycemic control.</data>
