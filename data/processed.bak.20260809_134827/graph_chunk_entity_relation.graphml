  <data key="d1">organization</data>
  <data key="d2">Diretriz Diabetes is the organization responsible for publishing clinical guidelines on diabetes management, including insulin therapy for Diabetes Mellitus Type 1.</data>
  <data key="d3">chunk-f1abe83ba7814c7afe7a123e2f79a10a</data>
