  <data key="d12">1776647635</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Myasthenia Gravis">
  <data key="d7">1.0</data>
  <data key="d8">Myasthenia gravis is an autoimmune neuromuscular disorder that may occur alongside type 1 diabetes.</data>
  <data key="d9">autoimmune disorder,comorbidity</data>
