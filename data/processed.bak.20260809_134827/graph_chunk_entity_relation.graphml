</edge>
<edge source="Bolus Bifásico" target="Refeição Rica em Gordura">
  <data key="d7">1.0</data>
  <data key="d8">Bolus Bifásico is used to prevent late postprandial glucose rises caused by high-fat meals like pizza and burgers.</data>
  <data key="d9">delayed glucose control,fat metabolism</data>
  <data key="d10">chunk-b266ecc39f9ba0b5277aacb36089b4db</data>
