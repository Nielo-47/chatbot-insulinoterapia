<node id="HLA Associations">
  <data key="d0">HLA Associations</data>
  <data key="d1">concept</data>
  <data key="d2">HLA associations refer to genetic links between type 1 diabetes and specific haplotypes such as DQB1 and DRB1, influencing disease susceptibility.&lt;SEP&gt;HLA associations refer to genetic links between type 1 diabetes and specific haplotypes such as DQB1 and DRB1, influencing disease susceptibility.</data>
  <data key="d3">chunk-620e2d1316d6093170f1c9991caabc7e</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
