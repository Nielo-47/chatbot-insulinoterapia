</edge>
<edge source="Irregular Insulin Absorption" target="Blood Sugar Fluctuations">
  <data key="d7">1.0</data>
  <data key="d8">Irregular insulin absorption in affected areas results in blood sugar fluctuations.</data>
  <data key="d9">metabolic effect,treatment complication</data>
