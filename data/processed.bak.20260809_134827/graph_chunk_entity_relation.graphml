</edge>
<edge source="Type 1 Diabetes" target="Postpancreatitis Diabetes Mellitus">
  <data key="d7">1.0</data>
  <data key="d8">Postpancreatitis diabetes mellitus lacks type 1 diabetes-associated autoimmunity, helping differentiate it from autoimmune diabetes.&gt;</data>
