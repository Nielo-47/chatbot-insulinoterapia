</edge>
<edge source="Gestational Diabetes Mellitus" target="75-G OGTT">
  <data key="d7">1.0</data>
  <data key="d8">The 75-g OGTT is used to diagnose GDM at 24–28 weeks of gestation according to IADPSG criteria.</data>
  <data key="d9">diagnosis method,testing protocol</data>
