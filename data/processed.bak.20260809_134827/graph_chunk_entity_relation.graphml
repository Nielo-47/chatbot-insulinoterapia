  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643550</data>
  <data key="d6"></data>
</node>
<node id="Pharmacologic Therapy">
  <data key="d0">Pharmacologic Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Pharmacologic therapy refers to the use of medications to treat diabetes and regulate blood glucose.</data>
