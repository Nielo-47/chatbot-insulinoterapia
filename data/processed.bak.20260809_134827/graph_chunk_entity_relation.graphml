  <data key="d6"></data>
</node>
<node id="Insulin Requirements">
  <data key="d0">Insulin Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin requirements in Diabetes Mellitus Type 1 vary by body weight, typically ranging from 0.4 to 1.0 U/kg/day, with higher doses needed during puberty, pregnancy, or infections.</data>
  <data key="d3">chunk-f1abe83ba7814c7afe7a123e2f79a10a&lt;SEP&gt;chunk-8aa8638b27cbd181b507c81fea49c6f0</data>
