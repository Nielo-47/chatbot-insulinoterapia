<edge source="Rodrigo Lamounier" target="Diabetes Classification Guideline">
  <data key="d7">1.0</data>
  <data key="d8">Rodrigo Lamounier is one of the authors who contributed to the development of the Diabetes Classification Guideline.</data>
  <data key="d9">authorship,contribution</data>
  <data key="d10">chunk-f5847db7a558804738e20dca9fd8d746</data>
