  <data key="d6"></data>
</node>
<node id="Intensive Lifestyle Interventions">
  <data key="d0">Intensive Lifestyle Interventions</data>
  <data key="d1">method</data>
  <data key="d2">Intensive lifestyle interventions are recommended for individuals with a history of gestational diabetes mellitus who are found to have prediabetes to prevent progression to diabetes.&lt;SEP&gt;Intensive lifestyle interventions are recommended for individuals with a history of gestational diabetes mellitus who are found to have prediabetes to prevent progression to diabetes.</data>
  <data key="d3">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
