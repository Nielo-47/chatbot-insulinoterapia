<edge source="Subcutaneous Injection" target="Abdomen">
  <data key="d7">1.0</data>
  <data key="d8">The abdomen is a preferred site for subcutaneous insulin injection due to its reliable absorption characteristics.</data>
  <data key="d9">anatomical location,injection site</data>
