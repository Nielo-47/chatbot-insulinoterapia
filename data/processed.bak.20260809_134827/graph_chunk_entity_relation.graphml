</edge>
<edge source="CGM" target="Ambulatory Glucose Profile">
  <data key="d7">1.0</data>
  <data key="d8">Continuous glucose monitoring (CGM) is essential for creating an ambulatory glucose profile, which helps analyze glucose patterns over time.</data>
  <data key="d9">clinical tool generation,data utilization</data>
  <data key="d10">chunk-fdddb31a1876a8809b8555564982acd4</data>
