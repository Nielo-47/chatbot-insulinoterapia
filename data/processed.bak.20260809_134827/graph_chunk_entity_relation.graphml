</edge>
<edge source="Type 1 Diabetes" target="Finnish Pediatric Cohort">
  <data key="d7">1.0</data>
  <data key="d8">Children in the Finnish cohort with multiple autoantibodies showed high progression rates to type 1 diabetes.</data>
