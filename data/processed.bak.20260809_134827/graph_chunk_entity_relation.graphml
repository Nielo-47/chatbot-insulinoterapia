  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Diabetes Monogênico">
  <data key="d7">1.0</data>
  <data key="d8">Negative autoantibodies are a key criterion for identifying monogenic diabetes, distinguishing it from type 1 diabetes.</data>
  <data key="d9">diagnostic criterion,differential diagnosis</data>
  <data key="d10">chunk-19939072ec52c9018a4c4b386cfd11b8</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647023</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="LADA">
  <data key="d7">1.0</data>
  <data key="d8">The presence of autoantibodies is a key diagnostic criterion for identifying LADA.</data>
  <data key="d9">autoimmune condition,diagnostic marker</data>
  <data key="d10">chunk-19939072ec52c9018a4c4b386cfd11b8</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647055</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Anti-GAD">
  <data key="d7">1.0</data>
  <data key="d8">Anti-GAD is the most frequently detected autoantibody in adults with Type 1 diabetes.</data>
  <data key="d9">biomarker specificity,detection frequency</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647101</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Anti-IA2">
  <data key="d7">1.0</data>
  <data key="d8">Anti-IA2 is a specific autoantibody used to improve the accuracy of Type 1 diabetes classification.</data>
  <data key="d9">biomarker,diagnostic support</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647104</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Anti-ZnT8">
  <data key="d7">1.0</data>
  <data key="d8">Anti-ZnT8 is a useful autoantibody for confirming Type 1 diabetes, particularly when other autoantibodies are negative.</data>
  <data key="d9">complementary testing,diagnostic utility</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647106</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Anti-Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Anti-insulin autoantibodies are less common in adults and can be confounded by exogenous insulin therapy.</data>
  <data key="d9">diagnostic limitation,interference</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647108</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Clinical Diagnosis Uncertainty">
  <data key="d7">1.0</data>
  <data key="d8">Autoantibody testing is recommended in cases of diagnostic uncertainty to differentiate Type 1 from Type 2 diabetes.</data>
  <data key="d9">diagnostic clarification,supplementary testing</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647109</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Diagnosis of Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Autoantibody testing is most sensitive at or within the first three years after diagnosis of diabetes, with declining titers over time.</data>
  <data key="d9">diagnostic timing,test sensitivity</data>
  <data key="d10">chunk-8631f035300b1b65337131c6c6079b19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647110</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Differential Diagnosis Of DM1 And DM2">
  <data key="d7">1.0</data>
  <data key="d8">Autoantibody testing is recommended to confirm type 1 diabetes in adults with clinical suspicion.</data>
  <data key="d9">autoimmune confirmation,laboratory testing</data>
  <data key="d10">chunk-fff9929a18d525e3805a8ed08356d41b</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647118</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="Diabetes Monogenico">
  <data key="d7">1.0</data>
  <data key="d8">Negative autoantibodies are a key criterion in distinguishing monogenic diabetes from autoimmune type 1 diabetes.</data>
  <data key="d9">differential diagnosis,immune markers</data>
  <data key="d10">chunk-c51943f25319629d0e145186a85c3b59</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647190</data>
  <data key="d13"></data>
</edge>
<edge source="Autoantibodies" target="R18">
  <data key="d7">1.0</data>
  <data key="d8">R18 suggests autoantibody testing in first-degree relatives of type 1 diabetes patients to prevent ketoacidosis and enable early intervention.</data>
  <data key="d9">prevention,screening method</data>
  <data key="d10">chunk-a8707947fb493803b7f3759b0105eda4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689122</data>
  <data key="d13"></data>
</edge>
<edge source="Pancreatic Beta Cells" target="Random C-Peptide">
  <data key="d7">1.0</data>
  <data key="d8">Random C-peptide levels reflect the residual secretory function of pancreatic beta cells in diabetic patients.&gt;</data>
  <data key="d9">functional assessment,secretion marker</data>
  <data key="d10">chunk-45f87c8aceb9340a61d8283da6282edc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647236</data>
  <data key="d13"></data>
</edge>
<edge source="HLA Associations" target="Genetic Screening">
  <data key="d7">1.0</data>
  <data key="d8">Genetic screening based on HLA associations is used in research to identify populations at high risk for type 1 diabetes.</data>
  <data key="d9">research application,risk identification</data>
  <data key="d10">chunk-620e2d1316d6093170f1c9991caabc7e</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647630</data>
  <data key="d13"></data>
</edge>
<edge source="Genetic Screening" target="Diabetes Neonatal">
  <data key="d7">1.0</data>
  <data key="d8">Genetic screening is recommended for all children with hyperglycemia before 6 months of age without a secondary cause to diagnose neonatal diabetes.</data>
  <data key="d9">diagnostic recommendation,early detection</data>
  <data key="d10">chunk-cd082b3c0d74b1afd1fdd6eb23b6afd4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647124</data>
  <data key="d13"></data>
</edge>
<edge source="Genetic Screening" target="MODY-GCK">
  <data key="d7">1.0</data>
  <data key="d8">For suspected MODY-GCK cases, genetic evaluation should be specific using the Sanger method to analyze GCK gene mutations, rather than a full panel.</data>
  <data key="d9">diagnostic strategy,targeted testing</data>
  <data key="d10">chunk-cd082b3c0d74b1afd1fdd6eb23b6afd4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647125</data>
  <data key="d13"></data>
</edge>
<edge source="Fructosamine" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">Fructosamine may be used as an alternative to A1C for assessing glycemic control in individuals with conditions affecting A1C accuracy.</data>
  <data key="d9">alternative marker,glycemic assessment</data>
  <data key="d10">chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647774</data>
  <data key="d13"></data>
</edge>
<edge source="Glycated Albumin" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">Glycated albumin serves as an alternative glycemic marker when A1C is unreliable due to hemoglobin variants or other interfering factors.</data>
  <data key="d9">alternative marker,glycemic assessment</data>
  <data key="d10">chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647776</data>
  <data key="d13"></data>
</edge>
<edge source="1,5-Anhydroglucitol" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">1,5-Anhydroglucitol provides information on short-term and postprandial glucose levels, complementing A1C in assessing overall glycemic burden.</data>
  <data key="d9">complementary marker,postprandial glucose</data>
  <data key="d10">chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647777</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose-6-Phosphate Dehydrogenase Deficiency" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">Glucose-6-phosphate dehydrogenase deficiency can alter A1C results, making plasma glucose criteria more reliable for diagnosis.</data>
  <data key="d9">diagnostic limitation,test interference</data>
  <data key="d10">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647503</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose-6-Phosphate Dehydrogenase Deficiency" target="Cappellini MD">
  <data key="d7">1.0</data>
  <data key="d8">Cappellini MD co-authored a study on glucose-6-phosphate dehydrogenase deficiency and its clinical implications.</data>
  <data key="d9">genetic disorder,medical research</data>
  <data key="d10">chunk-050dc3a498d3027939b93706cbdb7f07</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647803</data>
  <data key="d13"></data>
</edge>
<edge source="Hemodialysis" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">Hemodialysis can affect red blood cell lifespan and lead to inaccurate A1C readings, necessitating plasma glucose testing.</data>
  <data key="d9">diagnostic limitation,test interference</data>
  <data key="d10">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647504</data>
  <data key="d13"></data>
</edge>
<edge source="Hemodialysis" target="Hemoglobin Glycation">
  <data key="d7">1.0</data>
  <data key="d8">Hemodialysis can affect hemoglobin glycation independently of glycemia, potentially reducing the accuracy of A1C.</data>
  <data key="d9">diagnostic accuracy,interference</data>
  <data key="d10">chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647764</data>
  <data key="d13"></data>
</edge>
<edge source="Blood Transfusion" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">Recent blood transfusion can distort A1C results due to mixed red blood cell populations, requiring alternative diagnostic approaches.</data>
  <data key="d9">diagnostic limitation,test interference</data>
  <data key="d10">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647505</data>
  <data key="d13"></data>
</edge>
<edge source="Erythropoietin Therapy" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">Erythropoietin therapy influences red blood cell production and can compromise A1C test validity, warranting use of plasma glucose criteria.</data>
  <data key="d9">diagnostic limitation,test interference</data>
  <data key="d10">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647506</data>
  <data key="d13"></data>
</edge>
<edge source="Plasma Blood Glucose" target="Diabetes Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">Plasma blood glucose is the recommended diagnostic method in conditions where A1C is unreliable.</data>
  <data key="d9">direct measurement,primary diagnostic method</data>
  <data key="d10">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647747</data>
  <data key="d13"></data>
</edge>
<edge source="Oral Glucose Tolerance Testing" target="Diabetes Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">Oral glucose tolerance testing is used to diagnose diabetes when other tests are inconclusive or unavailable.</data>
  <data key="d9">diagnostic method,glucose challenge</data>
  <data key="d10">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647748</data>
  <data key="d13"></data>
</edge>
<edge source="Random Plasma Glucose" target="Diabetes Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">Random plasma glucose $200 mg/dL with classic symptoms is sufficient for diagnosing diabetes.</data>
  <data key="d9">acute hyperglycemia,diagnostic criterion</data>
  <data key="d10">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647740</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Diagnosis" target="Racial/Ethnic Disparities">
  <data key="d7">1.0</data>
  <data key="d8">Racial and ethnic disparities affect the diagnosis and glycemic control of diabetes in women of reproductive age.</data>
  <data key="d9">clinical variation,health inequality</data>
  <data key="d10">chunk-4fab467dd1cac7fbb17a945a0aa8240f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647735</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Diagnosis" target="Confirmatory Screening Test">
  <data key="d7">1.0</data>
  <data key="d8">A confirmatory screening test is required to validate an initial abnormal result before finalizing a diabetes diagnosis.</data>
  <data key="d9">diagnostic validation,repeat testing</data>
  <data key="d10">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647751</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Diagnosis" target="A1C Assay Interference">
  <data key="d7">1.0</data>
  <data key="d8">When A1C results are discordant with other tests, A1C assay interference must be considered and investigated.</data>
  <data key="d9">diagnostic challenge,result discordance</data>
  <data key="d10">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647752</data>
  <data key="d13"></data>
</edge>
<edge source="Cystic Fibrosis–Related Diabetes" target="HOMA of β-cell Function">
  <data key="d7">1.0</data>
  <data key="d8">HOMA of β-cell function may detect early risk for cystic fibrosis–related diabetes but lacks evidence for clinical use outside research.</data>
  <data key="d9">research use,risk detection</data>
  <data key="d10">chunk-c53f409a49620f4d40ad687bd0c0df19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647516</data>
  <data key="d13"></data>
</edge>
<edge source="Cystic Fibrosis–Related Diabetes" target="Cystic Fibrosis Foundation Patient Registry">
  <data key="d7">1.0</data>
  <data key="d8">The Cystic Fibrosis Foundation Patient Registry identified a 13% diagnosis rate of cystic fibrosis–related diabetes among 3,553 patients and linked early treatment to preserved lung function.</data>
  <data key="d9">data collection,diagnosis rate</data>
  <data key="d10">chunk-c53f409a49620f4d40ad687bd0c0df19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647517</data>
  <data key="d13"></data>
</edge>
<edge source="Cystic Fibrosis–Related Diabetes" target="European Cystic Fibrosis Society Patient Registry">
  <data key="d7">1.0</data>
  <data key="d8">The European Cystic Fibrosis Society Patient Registry reported that cystic fibrosis–related diabetes increases with age, female sex, and reduced lung function.</data>
  <data key="d9">epidemiology,risk factors</data>
  <data key="d10">chunk-c53f409a49620f4d40ad687bd0c0df19</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647517</data>
  <data key="d13"></data>
</edge>
<edge source="Cystic Fibrosis–Related Diabetes" target="Random Blood Glucose">
  <data key="d7">1.0</data>
  <data key="d8">Random blood glucose is referenced as a method used in screening, though not as a primary diagnostic tool for cystic fibrosis–related diabetes.</data>
  <data key="d9">preliminary detection,screening method</data>
  <data key="d10">chunk-c53f409a49620f4d40ad687bd0c0df19</data>
