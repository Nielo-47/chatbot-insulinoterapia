</edge>
<edge source="Syringe" target="Insulin Preparation">
  <data key="d7">1.0</data>
  <data key="d8">Insulin is drawn into a syringe during the preparation process for accurate dosing and administration.</data>
  <data key="d9">dosage measurement,drug administration</data>
