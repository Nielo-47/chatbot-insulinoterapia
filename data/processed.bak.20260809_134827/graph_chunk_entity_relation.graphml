</edge>
<edge source="Insulin" target="Latin American Network for Safe Medication Use">
  <data key="d7">1.0</data>
  <data key="d8">The Latin American Network for Safe Medication Use identifies insulin as a high-risk medication frequently involved in errors during prescription, preparation, and administration.</data>
  <data key="d9">error prevention,high-risk medication</data>
  <data key="d10">chunk-dc6a188926df383900f31928c8726a8f</data>
