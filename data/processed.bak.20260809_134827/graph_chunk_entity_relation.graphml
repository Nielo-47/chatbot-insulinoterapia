  <data key="d6"></data>
</node>
<node id="Recombinant Erythropoietin Use">
  <data key="d0">Recombinant Erythropoietin Use</data>
  <data key="d1">condition</data>
  <data key="d2">Recombinant erythropoietin use is a treatment that can affect red blood cell turnover and interfere with HbA1c measurement accuracy.&lt;SEP&gt;Recombinant erythropoietin use is a treatment that can affect red blood cell turnover and interfere with HbA1c measurement accuracy.</data>
  <data key="d3">chunk-8c3c6ce19ad6bc3cc3df22e5e10b0702</data>
