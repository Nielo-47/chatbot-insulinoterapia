  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Dificuldade Para Enxergar">
  <data key="d7">1.0</data>
  <data key="d8">Blurred vision in hiperglicemia results from fluid shifts in the lenses of the eyes.</data>
  <data key="d9">symptom,visual impairment</data>
