</edge>
<edge source="Insulin Application" target="Short Needle">
  <data key="d7">1.0</data>
  <data key="d8">Using short needles (4–6 mm) helps reduce pain during insulin injection.</data>
  <data key="d9">injection comfort,pain reduction</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
