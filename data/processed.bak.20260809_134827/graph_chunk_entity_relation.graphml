  <data key="d12">1776641873</data>
  <data key="d13"></data>
</edge>
<edge source="Infusion Set" target="Adhesive Allergy">
  <data key="d7">2.0</data>
  <data key="d8">Adhesive allergy is caused by the adhesive used to secure the infusion set, leading to discomfort and potential discontinuation.&lt;SEP&gt;The adhesive on the infusion set can cause allergic reactions, leading to discomfort and potential discontinuation of SICI use.</data>
  <data key="d9">device tolerance,material sensitivity,skin reaction</data>
  <data key="d10">chunk-679c193ea4fd33e94141ac2c9fef69c9</data>
