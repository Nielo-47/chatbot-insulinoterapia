  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Beta-Cell Destruction">
  <data key="d7">1.0</data>
  <data key="d8">Type 1 diabetes is caused by autoimmune-mediated beta-cell destruction leading to insulin deficiency.</data>
