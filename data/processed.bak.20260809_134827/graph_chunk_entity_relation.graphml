  <data key="d0">Função Cognitiva Comprometida</data>
  <data key="d1">concept</data>
  <data key="d2">Função Cognitiva Comprometida refers to impaired cognitive abilities in elderly diabetic patients, influencing glycemic target decisions.</data>
  <data key="d3">chunk-d8434e93fae47721617db0727fcd99b1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689287</data>
  <data key="d6"></data>
</node>
<node id="Capacidade Funcional Comprometida">
  <data key="d0">Capacidade Funcional Comprometida</data>
  <data key="d1">concept</data>
  <data key="d2">Capacidade Funcional Comprometida refers to reduced physical functionality in elderly patients, affecting diabetes treatment goals.</data>
  <data key="d3">chunk-d8434e93fae47721617db0727fcd99b1</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
