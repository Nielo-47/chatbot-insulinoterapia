  <data key="d12">1776648242</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Adults With Type 1 Or Type 2 Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Adults with diabetes generally target an HbA1c below 7% as part of standard glycemic control.</data>
  <data key="d9">adult management,standard targets</data>
  <data key="d10">chunk-12999315830b302d973dd1908eab1e12</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1776648245</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Elderly With Chronic Illnesses Or Limitations">
  <data key="d7">1.0</data>
  <data key="d8">Elderly patients with chronic illnesses may have a higher HbA1c target of up to 8% to avoid treatment risks.</data>
  <data key="d9">comorbidity management,relaxed targets</data>
  <data key="d10">chunk-12999315830b302d973dd1908eab1e12</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Documento sem título.docx</data>
  <data key="d12">1776648247</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Glycation">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c is formed through the non-enzymatic glycation of hemoglobin, which correlates with average blood glucose levels.</data>
  <data key="d9">biochemical process,measurement basis</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689345</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Red Blood Cell Lifespan">
  <data key="d7">1.0</data>
  <data key="d8">The HbA1c value reflects average glucose over 3 to 4 months, corresponding to the lifespan of red blood cells.</data>
  <data key="d9">biological correlation,time reflection</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689346</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Estimated Average Glucose">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c values correlate with estimated average glucose, which can also be derived from continuous glucose monitoring data.</data>
  <data key="d9">clinical monitoring,data correlation</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689346</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="National Glycohemoglobin Standardization Program">
  <data key="d7">1.0</data>
  <data key="d8">The National Glycohemoglobin Standardization Program certifies laboratory methods for HbA1c testing to ensure accuracy and comparability.</data>
  <data key="d9">laboratory certification,standardization</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689347</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Anemia">
  <data key="d7">1.0</data>
  <data key="d8">Anemia affects red blood cell lifespan and can cause discrepancies between HbA1c and actual average blood glucose levels.</data>
  <data key="d9">clinical discrepancy,measurement interference</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689348</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Hemolysis">
  <data key="d7">1.0</data>
  <data key="d8">Hemolysis shortens red blood cell survival, leading to potentially inaccurate HbA1c readings.</data>
  <data key="d9">clinical discrepancy,measurement interference</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689349</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Chronic Kidney Disease">
  <data key="d7">1.0</data>
  <data key="d8">Chronic kidney disease alters red blood cell metabolism and can result in misleading HbA1c values.</data>
  <data key="d9">clinical discrepancy,measurement interference</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689350</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Pregnancy">
  <data key="d7">1.0</data>
  <data key="d8">Pregnancy alters red blood cell turnover, affecting HbA1c interpretation and requiring specialized glycemic targets.</data>
  <data key="d9">clinical adjustment,physiological impact</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689350</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Hemoglobinopathies">
  <data key="d7">1.0</data>
  <data key="d8">Hemoglobinopathies can lead to inaccurate HbA1c measurements due to structural hemoglobin abnormalities.</data>
  <data key="d9">diagnostic limitation,measurement interference</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689351</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Erythropoiesis-Stimulating Drugs">
  <data key="d7">1.0</data>
  <data key="d8">Drugs that stimulate erythropoiesis can alter HbA1c levels independently of glycemic control.</data>
  <data key="d9">clinical adjustment,pharmacological interference</data>
  <data key="d10">chunk-e3f7252ca9147660b04b7329edbe843f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689352</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Hemoglobin A1c is used to monitor blood glucose levels in individuals with diabetes.</data>
  <data key="d9">biomarker,disease association</data>
  <data key="d10">chunk-292560db65a76615eea6b62c57efdd3d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d12">1776689395</data>
  <data key="d13"></data>
</edge>
<edge source="Hemoglobin A1c" target="Older Adults">
  <data key="d7">1.0</data>
  <data key="d8">Hemoglobin A1c levels are associated with mortality risk in older adults, both with and without diabetes.</data>
  <data key="d9">health indicator,mortality risk</data>
