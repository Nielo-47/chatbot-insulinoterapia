  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Colorado">
  <data key="d7">1.0</data>
  <data key="d8">A large-scale screening program for type 1 diabetes was implemented and evaluated in Colorado.</data>
