  <data key="d13"></data>
</edge>
<edge source="Metreleptina" target="Dose Diaria Maxima">
  <data key="d7">1.0</data>
  <data key="d8">The daily dose of metreleptina must not exceed the maximum limit based on patient weight and sex.</data>
  <data key="d9">dosage limit,treatment safety</data>
  <data key="d10">chunk-5a6a69d5100e0e8263f965a83797d48b</data>
