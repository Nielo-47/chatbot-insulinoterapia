</edge>
<edge source="Sensitivity Factor" target="Daily Total Dose">
  <data key="d7">1.0</data>
  <data key="d8">Sensitivity Factor is calculated using the formula 1700/DTD for adults or 2000/DTD for children to estimate insulin sensitivity.</data>
  <data key="d9">dose calculation,glucose management</data>
  <data key="d10">chunk-1223db4d3629243420a6e867a9ba6988</data>
