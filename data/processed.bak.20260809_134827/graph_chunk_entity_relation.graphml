</edge>
<edge source="IGT" target="75-g OGTT">
  <data key="d7">1.0</data>
  <data key="d8">The 75-gram oral glucose tolerance test is used to assess 2-hour plasma glucose levels for diagnosing IGT.</data>
  <data key="d9">diagnostic method,glucose challenge</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
