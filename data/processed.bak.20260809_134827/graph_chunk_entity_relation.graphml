  <data key="d13"></data>
</edge>
<edge source="Universal Early Screening" target="Undiagnosed Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Universal early screening at less than 15 weeks of gestation helps identify undiagnosed diabetes, especially in high-risk and racially or ethnically diverse populations.</data>
  <data key="d9">early detection,health equity</data>
  <data key="d10">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
