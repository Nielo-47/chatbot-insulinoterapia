  <data key="d6"></data>
</node>
<node id="Refrigerante Normal">
  <data key="d0">Refrigerante Normal</data>
  <data key="d1">content</data>
  <data key="d2">Refrigerante normal is a sugary soft drink used as a source of carbohydrates to treat low blood sugar.</data>
  <data key="d3">chunk-5acf61a3a7ae9c09040830d5a662f612</data>
