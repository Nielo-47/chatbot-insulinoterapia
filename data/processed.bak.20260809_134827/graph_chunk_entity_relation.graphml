  <data key="d12">1776647507</data>
  <data key="d13"></data>
</edge>
<edge source="Tesamorelin" target="Growth Hormone-Releasing Hormone">
  <data key="d7">1.0</data>
  <data key="d8">Tesamorelin is an analog of growth hormone-releasing hormone (aGHRH) used to treat visceral lipohypertrophy.</data>
  <data key="d9">hormone analog,pharmacological class</data>
  <data key="d10">chunk-d0e841f6957bc713f769fbd0c5b5ee33</data>
