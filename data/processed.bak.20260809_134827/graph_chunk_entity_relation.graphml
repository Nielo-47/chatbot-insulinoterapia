</edge>
<edge source="Insulina" target="Tabela 1">
  <data key="d7">1.0</data>
  <data key="d8">Tabela 1 fornece informações sobre conservação e validade da insulina, conforme orientações de fabricantes.</data>
  <data key="d9">guideline,reference</data>
  <data key="d10">chunk-a81bec86298f297d9be7cc985a7eddb6</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
