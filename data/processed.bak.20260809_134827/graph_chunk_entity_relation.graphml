</edge>
<edge source="Oral Glucose Tolerance Test" target="Recommendation 2.12">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.12 requires adequate carbohydrate intake (at least 150 g/day) for 3 days prior to oral glucose tolerance testing.</data>
  <data key="d9">dietary requirement,test preparation</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974</data>
