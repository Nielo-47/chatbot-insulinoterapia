  <data key="d13"></data>
</edge>
<edge source="Insulin NPH" target="Nursing Technician">
  <data key="d7">1.0</data>
  <data key="d8">The nursing technician administered Insulin NPH without homogenizing it, leading to ineffective insulin delivery.</data>
  <data key="d9">administration,improper technique</data>
  <data key="d10">chunk-9c96e22adae6d8c02ec9ce8430d0cf64</data>
