<edge source="Fasting Glucose" target="PTDM">
  <data key="d7">1.0</data>
  <data key="d8">Fasting glucose screening helps identify individuals at high risk for PTDM who may need further assessment.</data>
  <data key="d9">risk identification,screening</data>
