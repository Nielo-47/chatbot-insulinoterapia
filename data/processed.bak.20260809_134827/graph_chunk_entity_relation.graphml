  <data key="d6"></data>
</node>
<node id="D M Scholtens">
  <data key="d0">D M Scholtens</data>
  <data key="d1">person</data>
  <data key="d2">D M Scholtens is a researcher contributing to longitudinal studies on maternal glycemia and childhood metabolic outcomes.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
