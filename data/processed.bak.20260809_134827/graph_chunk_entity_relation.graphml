  <data key="d6"></data>
</node>
<node id="Children And Adolescents">
  <data key="d0">Children And Adolescents</data>
  <data key="d3">chunk-b0f94f216119cfdc3c74eab51c88a823&lt;SEP&gt;chunk-e3f7252ca9147660b04b7329edbe843f&lt;SEP&gt;chunk-d39cd334b01ad820816bf3cb108c0e27</data>
  <data key="d2">Type 2 diabetes screening is recommended in children and adolescents starting at age 10 or after puberty onset if they have overweight/obesity and at least one additional risk factor.&lt;SEP&gt;Children and adolescents are a patient group for whom an HbA1c target of less than 7.0% is recommended in diabetes management.</data>
  <data key="d1">concept</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf&lt;SEP&gt;data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
  <data key="d5">1776689266</data>
  <data key="d6"></data>
</node>
<node id="Diagnosis of Diabetes Mellitus">
  <data key="d0">Diagnosis of Diabetes Mellitus</data>
  <data key="d3">chunk-7dad8318811ce10b7f639b13057d611f</data>
  <data key="d2">The Brazilian Diabetes Society published a clinical guideline on the diagnosis of diabetes mellitus, including recommendations on screening and management of type 1 diabetes.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
