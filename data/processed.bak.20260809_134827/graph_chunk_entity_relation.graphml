  <data key="d0">Arch Endocrinol Metab</data>
  <data key="d1">content</data>
  <data key="d2">Arch Endocrinol Metab is a journal publishing research on endocrinology and metabolism, including studies on MODY probability calculators.</data>
  <data key="d3">chunk-ad3acc8463b5ff47461b1c16ae2559cb</data>
