  <data key="d7">1.0</data>
  <data key="d8">Uncontrolled GDM is linked to an increased risk of perinatal death.</data>
  <data key="d9">mortality risk,severe outcome</data>
  <data key="d10">chunk-7f182d57176633ee05e1a23031d6ad2a</data>
