  <data key="d13"></data>
</edge>
<edge source="Insulin Application" target="Alcohol">
  <data key="d7">1.0</data>
  <data key="d8">Alcohol should be used to clean the injection site, but must dry completely before injection to avoid irritation.</data>
  <data key="d9">infection prevention,skin preparation</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
