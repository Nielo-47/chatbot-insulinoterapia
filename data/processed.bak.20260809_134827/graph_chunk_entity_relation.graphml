</edge>
<edge source="Family History" target="Screening For DM2">
  <data key="d7">1.0</data>
  <data key="d8">Family history is a key criterion in determining who should be screened for DM2 in pediatric populations.</data>
  <data key="d9">preventive care,risk assessment</data>
