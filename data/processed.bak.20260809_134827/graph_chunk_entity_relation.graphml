  <data key="d13"></data>
</edge>
<edge source="Stage 1 Type 1 Diabetes" target="Autoantibodies">
  <data key="d7">1.0</data>
  <data key="d8">Stage 1 type 1 diabetes is characterized by the presence of two or more islet autoantibodies, marking the presymptomatic phase of the disease.</data>
  <data key="d9">biomarker,disease staging</data>
