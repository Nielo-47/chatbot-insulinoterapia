  <data key="d5">1776647418</data>
  <data key="d6"></data>
</node>
<node id="1,5-Anhydroglucitol">
  <data key="d0">1,5-Anhydroglucitol</data>
  <data key="d1">data</data>
  <data key="d2">1,5-Anhydroglucitol is a biomarker that reflects short-term glycemic control, especially postprandial glucose excursions, with lower levels indicating higher glucose exposure.&lt;SEP&gt;1,5-Anhydroglucitol is a biomarker reflecting short-term glycemic control, particularly postprandial glucose, and may be lower in African American individuals.&lt;SEP&gt;1,5-Anhydroglucitol is a biomarker that reflects short-term glycemic control, especially postprandial glucose excursions, with lower levels indicating higher glucose exposure.&lt;SEP&gt;1,5-Anhydroglucitol is a biomarker reflecting short-term glycemic control, particularly postprandial glucose, and may be lower in African American individuals.</data>
  <data key="d3">chunk-20b3e88dda40e2d303af38aea0d19b86&lt;SEP&gt;chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
