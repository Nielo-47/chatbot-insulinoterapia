</edge>
<edge source="Recommendation 2.7" target="Risk Assessment">
  <data key="d7">1.0</data>
  <data key="d8">Recommendation 2.7 recommends using an informal assessment of risk factors or a validated risk calculator to screen for prediabetes and type 2 diabetes.</data>
  <data key="d9">risk calculator,screening indication</data>
