</node>
<node id="Eunice Kennedy Shriver National Institute Of Child Health And Human Development Maternal-Fetal Medicine Units Network">
  <data key="d0">Eunice Kennedy Shriver National Institute Of Child Health And Human Development Maternal-Fetal Medicine Units Network</data>
  <data key="d1">organization</data>
  <data key="d2">This organization supports clinical research in maternal-fetal medicine, including trials on gestational diabetes and pregnancy outcomes.&lt;SEP&gt;This organization supports clinical research in maternal-fetal medicine, including trials on gestational diabetes and pregnancy outcomes.</data>
  <data key="d3">chunk-45a8ca206e61b47964f899c929fbafb3</data>
