  <data key="d12">1776638374</data>
  <data key="d13"></data>
</edge>
<edge source="Pregnancy" target="Ultrarapid-Acting Insulin Analog">
  <data key="d7">1.0</data>
  <data key="d8">Ultrarapid-acting insulin analogs like aspart and lispro are used in insulin pumps during pregnancy and are not associated with adverse fetal effects according to current guidelines.</data>
  <data key="d9">fetal outcome,insulin safety</data>
  <data key="d10">chunk-eed9228bfdd30fe45392a8a9fb8d106b</data>
