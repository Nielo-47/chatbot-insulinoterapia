  <data key="d13"></data>
</edge>
<edge source="IFG" target="FPG">
  <data key="d7">1.0</data>
  <data key="d8">Impaired fasting glucose is diagnosed using fasting plasma glucose levels between 100–125 mg/dL.</data>
  <data key="d9">diagnostic criterion,glucose measurement</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647622</data>
  <data key="d13"></data>
</edge>
<edge source="IFG" target="World Health Organization">
  <data key="d7">1.0</data>
  <data key="d8">The World Health Organization defines the lower limit of impaired fasting glucose at 110 mg/dL (6.1 mmol/L).</data>
  <data key="d9">diagnostic standard,health guideline</data>
  <data key="d10">chunk-6cc7d59e52d23bbcf0d499f8423581f7</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647624</data>
  <data key="d13"></data>
</edge>
<edge source="GDM" target="OGTT">
  <data key="d7">1.0</data>
  <data key="d8">The OGTT is used to diagnose Gestational Diabetes Mellitus based on specific plasma glucose thresholds.</data>
  <data key="d9">diagnostic method,disease detection</data>
  <data key="d10">chunk-357f19fa58c4dd99dcd7b47a984b4383</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647687</data>
  <data key="d13"></data>
</edge>
<edge source="GDM" target="American College Of Obstetricians And Gynecologists">
  <data key="d7">1.0</data>
  <data key="d8">The organization states that a single elevated glucose value may be sufficient for diagnosing GDM, differing from traditional two-value requirements.</data>
  <data key="d9">clinical policy,diagnostic guidance</data>
  <data key="d10">chunk-357f19fa58c4dd99dcd7b47a984b4383</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647688</data>
  <data key="d13"></data>
</edge>
<edge source="GDM" target="IADPSG Criteria">
  <data key="d7">1.0</data>
  <data key="d8">The IADPSG criteria are used to diagnose Gestational Diabetes Mellitus by identifying hyperglycemia during pregnancy based on specific glucose thresholds.</data>
  <data key="d9">diagnostic criteria,disease classification</data>
  <data key="d10">chunk-357f19fa58c4dd99dcd7b47a984b4383</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647689</data>
  <data key="d13"></data>
</edge>
<edge source="GDM" target="IADPSG">
  <data key="d7">1.0</data>
  <data key="d8">The IADPSG established diagnostic criteria for GDM used in the one-step method.</data>
  <data key="d9">diagnostic criteria,guideline development</data>
  <data key="d10">chunk-d936160aac8a6b8ba40b196280422fe5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647771</data>
  <data key="d13"></data>
</edge>
<edge source="GDM" target="Carpenter-Coustan">
  <data key="d7">1.0</data>
  <data key="d8">The Carpenter-Coustan criteria are used in the two-step method to diagnose GDM.</data>
  <data key="d9">diagnostic method,two-step screening</data>
  <data key="d10">chunk-d936160aac8a6b8ba40b196280422fe5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647772</data>
  <data key="d13"></data>
</edge>
<edge source="GDM" target="Lifestyle Therapy">
  <data key="d7">1.0</data>
  <data key="d8">80–90% of mild GDM cases can be managed with lifestyle therapy alone.</data>
  <data key="d9">non-pharmacological management,treatment approach</data>
  <data key="d10">chunk-d936160aac8a6b8ba40b196280422fe5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647774</data>
  <data key="d13"></data>
</edge>
<edge source="Obesity" target="DM2">
  <data key="d7">1.0</data>
  <data key="d8">Obesity is strongly associated with DM2, with 70% to 90% of affected youth being obese and having increased disease risk.</data>
  <data key="d9">disease association,risk factor</data>
  <data key="d10">chunk-fd83fee2b80ad551bb282975932751ce</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
  <data key="d12">1776689110</data>
  <data key="d13"></data>
</edge>
<edge source="World Health Organization" target="Latent Autoimmune Diabetes in Adults">
  <data key="d7">1.0</data>
  <data key="d8">The World Health Organization classifies LADA as a hybrid form of diabetes with overlapping features of Type 1 and Type 2 diabetes.</data>
  <data key="d9">classification,hybrid form</data>
  <data key="d10">chunk-00f6ea581f76ddc15bc463d1eccc4496</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
  <data key="d12">1776647012</data>
  <data key="d13"></data>
</edge>
<edge source="World Health Organization" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">The World Health Organization is associated with establishing international standards for diabetes diagnosis, which may include A1C testing.</data>
  <data key="d9">diagnostic criteria,international standards</data>
  <data key="d10">chunk-5b5fc9e82121669cb9d4aff08c8c9019</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647506</data>
  <data key="d13"></data>
</edge>
<edge source="World Health Organization" target="BMI">
  <data key="d7">1.0</data>
  <data key="d8">The World Health Organization recommends using a BMI of ≥23 kg/m² to define increased diabetes risk in Asian American individuals.</data>
  <data key="d9">guideline,risk definition</data>
  <data key="d10">chunk-8317327cb2c248762b2dc3852c662000</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647603</data>
  <data key="d13"></data>
</edge>
<edge source="World Health Organization" target="Oral Glucose Tolerance Test">
  <data key="d7">1.0</data>
  <data key="d8">The WHO provides the official description for how the oral glucose tolerance test should be performed.</data>
  <data key="d9">protocol standardization,testing guidelines</data>
  <data key="d10">chunk-85b36fc8288de16b0682d3530712dcb4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647610</data>
  <data key="d13"></data>
</edge>
<edge source="Cardiovascular Risk Factors" target="Intensive Multifactorial Intervention">
  <data key="d7">1.0</data>
  <data key="d8">Intensive multifactorial intervention targets cardiovascular risk factors to improve outcomes in diabetes patients.</data>
  <data key="d9">risk reduction,treatment</data>
  <data key="d10">chunk-8317327cb2c248762b2dc3852c662000</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647598</data>
  <data key="d13"></data>
</edge>
<edge source="FPG" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">A1C, FPG, and 2-h PG are all used to identify diabetes, but A1C alone diagnoses only 30% of cases detected by any of the three methods.</data>
  <data key="d9">complementary testing,diagnostic comparison</data>
  <data key="d10">chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647763</data>
  <data key="d13"></data>
</edge>
<edge source="2-h PG" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">A1C and 2-h PG are different diagnostic methods for diabetes, with combined use improving case detection.</data>
  <data key="d9">complementary testing,diagnostic comparison</data>
  <data key="d10">chunk-146b6bf0e9a99df13de25f5e1318178a</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647764</data>
  <data key="d13"></data>
</edge>
<edge source="75-g OGTT" target="One-Step Method">
  <data key="d7">1.0</data>
  <data key="d8">The one-step method uses a single 75-g OGTT to diagnose GDM without prior screening.</data>
  <data key="d9">diagnostic procedure,glucose testing</data>
  <data key="d10">chunk-d936160aac8a6b8ba40b196280422fe5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647776</data>
  <data key="d13"></data>
</edge>
<edge source="BMI" target="Screening For Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">BMI is used to determine diabetes risk, with lower thresholds recommended for certain ethnic groups.</data>
  <data key="d9">risk assessment,threshold</data>
  <data key="d10">chunk-8317327cb2c248762b2dc3852c662000</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647601</data>
  <data key="d13"></data>
</edge>
<edge source="BMI" target="Asian American Population">
  <data key="d7">1.0</data>
  <data key="d8">The Asian American population has increased diabetes risk at lower BMI levels, supporting a cutoff of 23 kg/m².</data>
  <data key="d9">ethnic variation,risk stratification</data>
  <data key="d10">chunk-8317327cb2c248762b2dc3852c662000</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647602</data>
  <data key="d13"></data>
</edge>
<edge source="BMI" target="African American Population">
  <data key="d7">1.0</data>
  <data key="d8">For equivalent diabetes risk, African American individuals have a lower BMI threshold (26 kg/m²) compared to non-Hispanic White individuals (30 kg/m²).</data>
  <data key="d9">ethnic comparison,risk equivalence</data>
  <data key="d10">chunk-8317327cb2c248762b2dc3852c662000</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647603</data>
  <data key="d13"></data>
</edge>
<edge source="BMI" target="PTDM">
  <data key="d7">1.0</data>
  <data key="d8">Elevated BMI is a known risk factor for the development of PTDM after organ transplantation.</data>
  <data key="d9">association,risk factor</data>
  <data key="d10">chunk-50c85dba4b510b2463c6766fd8a2dbf5</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647675</data>
  <data key="d13"></data>
</edge>
<edge source="Race/Ethnicity" target="A1C Test">
  <data key="d7">1.0</data>
  <data key="d8">A1C levels may vary by race/ethnicity independently of glycemia, with African American individuals showing higher A1C than non-Hispanic White individuals at similar glucose levels.</data>
  <data key="d9">diagnostic variation,health disparity</data>
