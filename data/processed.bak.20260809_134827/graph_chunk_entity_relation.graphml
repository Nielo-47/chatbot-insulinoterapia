  <data key="d13"></data>
</edge>
<edge source="Genetic Testing" target="Diabetes Genetics Center">
  <data key="d7">1.0</data>
  <data key="d8">Consultation with a diabetes genetics center is recommended to interpret genetic mutations and guide treatment and counseling.</data>
  <data key="d9">consultation,interpretation</data>
