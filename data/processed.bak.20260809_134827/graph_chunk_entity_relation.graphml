<edge source="Type 2 Diabetes Screening" target="Children And Adolescents">
  <data key="d7">1.0</data>
  <data key="d8">Type 2 diabetes screening is recommended in children and adolescents starting at age 10 or after puberty onset if they have overweight/obesity and at least one additional risk factor.</data>
  <data key="d9">age-based recommendation,risk criteria</data>
  <data key="d10">chunk-b0f94f216119cfdc3c74eab51c88a823</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Diagnóstico de diabetes mellitus.pdf</data>
