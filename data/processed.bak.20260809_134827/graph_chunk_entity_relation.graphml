  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638394</data>
  <data key="d13"></data>
</edge>
<edge source="Depósito Rígido" target="Lanceta">
  <data key="d7">1.0</data>
  <data key="d8">Lancetas, along with needles, must be discarded in a rigid container for safe handling and disposal.</data>
  <data key="d9">sharps containment,waste disposal</data>
  <data key="d10">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638396</data>
  <data key="d13"></data>
</edge>
<edge source="Unidade De Saúde" target="Paciente">
  <data key="d7">1.0</data>
  <data key="d8">O paciente deve procurar a Unidade de Saúde em caso de reações adversas ou necessidade de reposição de caneta.</data>
  <data key="d9">adverse event reporting,healthcare access</data>
  <data key="d10">chunk-de80027ca96b7501497bcb85811b669d</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Guia-Pratico-SBD-Canetas-Reutilizaveis-de-Insulina-no-SUS.pdf</data>
  <data key="d12">1776638019</data>
  <data key="d13"></data>
</edge>
<edge source="Álcool 70%" target="Cuidados Com A Pele">
  <data key="d7">1.0</data>
  <data key="d8">O uso de álcool 70% é recomendado em ambientes clínicos para limpar a pele antes da aplicação de insulina.</data>
  <data key="d9">disinfection,skin preparation</data>
  <data key="d10">chunk-e490a7e963a20e2221a8097b50073543</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
  <data key="d12">1776638154</data>
  <data key="d13"></data>
</edge>
<edge source="Álcool 70%" target="Procedimento para Teste de Glicemia Capilar">
  <data key="d7">3.0</data>
  <data key="d8">Álcool 70% is used to disinfect the skin before performing a capillary glucose test.&lt;SEP&gt;Álcool 70% is used to disinfect the skin before performing a capillary glucose test.&lt;SEP&gt;Álcool 70% is used to disinfect the skin before performing a capillary glucose test.</data>
  <data key="d9">preparation,skin disinfection</data>
