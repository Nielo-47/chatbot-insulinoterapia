  <data key="d13"></data>
</edge>
<edge source="Racial And Ethnic Disparities" target="Undiagnosed Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Strong racial and ethnic disparities exist in the prevalence of undiagnosed diabetes, necessitating targeted screening efforts.</data>
  <data key="d9">health inequality,prevalence difference</data>
