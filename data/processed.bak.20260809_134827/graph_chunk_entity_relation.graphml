  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="Comorbidities">
  <data key="d7">1.0</data>
  <data key="d8">Cardiac or renal comorbidities affect treatment strategies and therapeutic targets in diabetes care.</data>
