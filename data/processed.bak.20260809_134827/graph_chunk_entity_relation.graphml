</edge>
<edge source="Glucose Meter" target="Glucose Oxidase Monitors">
  <data key="d7">1.0</data>
  <data key="d8">Some glucose meters use glucose oxidase technology, which is sensitive to oxygen levels and environmental factors.</data>
  <data key="d9">measurement method,technology type</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643800</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Meter" target="Glucose Dehydrogenase Monitors">
  <data key="d7">1.0</data>
  <data key="d8">Some glucose meters use glucose dehydrogenase technology, which is not affected by oxygen levels.</data>
  <data key="d9">measurement method,technology type</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643801</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Meter" target="Temperature">
  <data key="d7">1.0</data>
  <data key="d8">Glucose meter accuracy is affected by temperature, with most devices having an acceptable operating range.</data>
  <data key="d9">environmental impact,performance factor</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643804</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Meter" target="Humidity">
  <data key="d7">1.0</data>
  <data key="d8">Humidity can alter glucose meter readings and affect the reliability of results.</data>
  <data key="d9">environmental impact,performance factor</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643804</data>
  <data key="d13"></data>
</edge>
<edge source="Glucose Meter" target="Altitude">
  <data key="d7">1.0</data>
  <data key="d8">Altitude can influence glucose meter accuracy, particularly for oxygen-sensitive models.</data>
  <data key="d9">environmental impact,performance factor</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
