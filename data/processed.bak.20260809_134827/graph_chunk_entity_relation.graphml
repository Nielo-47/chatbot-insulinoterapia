<edge source="Early Abnormal Glucose Metabolism" target="Adverse Pregnancy Outcomes">
  <data key="d7">1.0</data>
  <data key="d8">Early abnormal glucose metabolism is associated with increased risk of preeclampsia, macrosomia, shoulder dystocia, perinatal death, and need for insulin treatment.</data>
  <data key="d9">health risk,maternal-fetal complications</data>
  <data key="d10">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
