  <data key="d13"></data>
</edge>
<edge source="A1C Test" target="International Expert Committee">
  <data key="d7">1.0</data>
  <data key="d8">In 2009, the International Expert Committee included A1C in diabetes diagnostic criteria to promote increased screening.</data>
  <data key="d9">diagnostic policy,guideline development</data>
  <data key="d10">chunk-146b6bf0e9a99df13de25f5e1318178a</data>
