</edge>
<edge source="Partial Lipodystrophies" target="Physical Examination">
  <data key="d7">1.0</data>
  <data key="d8">Physical examination is a key diagnostic tool for partial lipodystrophies, used to identify specific fat loss sites and associated physical signs.</data>
