</node>
<node id="Level B">
  <data key="d0">Level B</data>
  <data key="d1">concept</data>
  <data key="d2">Level B denotes the quality of evidence supporting the R2 recommendation, based on systematic reviews of cohort studies.</data>
  <data key="d3">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
