  <data key="d13"></data>
</edge>
<edge source="Insulin Homogenization" target="Air Bubbles">
  <data key="d7">1.0</data>
  <data key="d8">Vigorous shaking during homogenization can introduce air bubbles, leading to inaccurate dosing if not removed.</data>
  <data key="d9">dosing error,preparation flaw</data>
