</node>
<node id="Cheng P">
  <data key="d0">Cheng P</data>
  <data key="d1">person</data>
  <data key="d2">Cheng P is a researcher studying racial/ethnic minority youth with recent-onset type 1 diabetes.&lt;SEP&gt;Cheng P is a co-author of a study on pediatric diabetes clinical characteristics.&lt;SEP&gt;Cheng P is a co-author of a study on pediatric diabetes clinical characteristics.</data>
