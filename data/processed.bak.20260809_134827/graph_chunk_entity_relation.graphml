</edge>
<edge source="Insulin" target="Regular Insulin">
  <data key="d7">1.0</data>
  <data key="d8">Regular Insulin is a short-acting form of insulin used in diabetes treatment.</data>
  <data key="d9">insulin type,medical formulation</data>
  <data key="d10">chunk-180dc3d244f7d832cf505b09cfc34746</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639155</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Syringe With Removable Needle">
  <data key="d7">1.0</data>
  <data key="d8">Using a syringe with a removable needle creates dead space, leading patients to administer excess insulin to compensate.</data>
  <data key="d9">device risk,dosing error</data>
