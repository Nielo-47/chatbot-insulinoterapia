</node>
<node id="CAD">
  <data key="d0">CAD</data>
  <data key="d1">concept</data>
  <data key="d2">CAD refers to Cetoacidose Diabética (Diabetic Ketoacidosis), a life-threatening complication of DM1 that can develop rapidly without insulin treatment.</data>
  <data key="d3">chunk-fed992e01da83317a2c9f0adf751f53f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
