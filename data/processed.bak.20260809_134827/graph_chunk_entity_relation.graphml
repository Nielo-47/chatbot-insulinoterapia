  <data key="d13"></data>
</edge>
<edge source="Syringe" target="Sharps Disposal">
  <data key="d7">1.0</data>
  <data key="d8">Used syringes must be disposed of in a rigid plastic container as part of sharps disposal to prevent injury and contamination.</data>
