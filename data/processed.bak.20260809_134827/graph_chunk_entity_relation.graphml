</node>
<node id="Diretrizes">
  <data key="d0">Diretrizes</data>
  <data key="d1">content</data>
  <data key="d2">Diretrizes are clinical guidelines providing evidence-based recommendations for the management of diabetes and insulin use.</data>
  <data key="d3">chunk-fed992e01da83317a2c9f0adf751f53f</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d5">1776642313</data>
