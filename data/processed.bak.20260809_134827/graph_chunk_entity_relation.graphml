  <data key="d6"></data>
</node>
<node id="Inhaled Insulin">
  <data key="d0">Inhaled Insulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Inhaled insulin is an alternative insulin delivery method useful for individuals averse to injections.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
