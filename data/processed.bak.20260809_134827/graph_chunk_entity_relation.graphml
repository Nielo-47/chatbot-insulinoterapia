  <data key="d13"></data>
</edge>
<edge source="Diabetes Mellitus" target="BMI">
  <data key="d7">1.0</data>
  <data key="d8">High BMI is characteristic of type 2 diabetes but does not rule out type 1 diabetes due to rising obesity rates.</data>
  <data key="d9">phenotypic feature,risk factor</data>
  <data key="d10">chunk-e575f95ec5a02f7900989e00da53749f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classificação do diabetes.pdf</data>
