  <data key="d13"></data>
</edge>
<edge source="NHANES III" target="Variabilidade Intraindividual">
  <data key="d7">2.0</data>
  <data key="d8">NHANES III evaluated intraindividual variability of glycemic methods, finding higher variability in 2-hour glucose compared to fasting glucose.&lt;SEP&gt;NHANES III provided data from 685 individuals to assess intraindividual variability of glycemic measurements.</data>
  <data key="d9">data source,epidemiological study,glycemic testing,measurement variability</data>
