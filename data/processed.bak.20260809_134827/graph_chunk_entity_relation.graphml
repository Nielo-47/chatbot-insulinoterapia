</node>
<node id="Oral Agents">
  <data key="d0">Oral Agents</data>
  <data key="d1">artifact</data>
  <data key="d2">Oral agents are medications taken by mouth to help manage blood glucose levels in people with diabetes.&lt;SEP&gt;Oral Agents are medications taken by mouth to help manage blood glucose levels in people with type 2 diabetes.&lt;SEP&gt;Oral agents are medications taken by mouth for managing blood glucose levels in cystic fibrosis-related diabetes.</data>
