<node id="Self-Monitoring of Blood Glucose">
  <data key="d0">Self-Monitoring of Blood Glucose</data>
  <data key="d1">method</data>
  <data key="d2">Self-monitoring of blood glucose is a process by which patients with diabetes regularly check their blood sugar levels using portable devices.</data>
  <data key="d3">chunk-755e9677a7018e4cc382b7d903590786</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643577</data>
  <data key="d6"></data>
</node>
<node id="Fingerstick Testing">
  <data key="d0">Fingerstick Testing</data>
  <data key="d1">method</data>
  <data key="d2">Fingerstick testing is a traditional method of blood glucose monitoring that involves pricking the finger to obtain a blood sample for analysis.</data>
  <data key="d3">chunk-755e9677a7018e4cc382b7d903590786</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d5">1776643577</data>
  <data key="d6"></data>
</node>
<node id="U-100 Insulin">
  <data key="d0">U-100 Insulin</data>
  <data key="d1">product</data>
  <data key="d2">U-100 insulin is a common insulin concentration for which standard syringes are calibrated, allowing precise dosing.&lt;SEP&gt;U-100 insulin is a standard concentration of insulin used in diabetes treatment, delivered in varying units.</data>
  <data key="d3">chunk-b94e98f4cb6f97fceae5e6d8c30c871b&lt;SEP&gt;chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
