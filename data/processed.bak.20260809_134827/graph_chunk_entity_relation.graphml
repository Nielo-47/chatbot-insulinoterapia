</edge>
<edge source="Insulina" target="Caneta Descartável">
  <data key="d7">1.0</data>
  <data key="d8">The disposable insulin pen comes with insulin already inside and is used until empty, then discarded.</data>
  <data key="d9">medication delivery,pre-filled device</data>
  <data key="d10">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Documento sem título.docx</data>
