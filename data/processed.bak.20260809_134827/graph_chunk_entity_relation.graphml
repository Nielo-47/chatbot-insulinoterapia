  <data key="d6"></data>
</node>
<node id="Less Than 70 Mg/Dl">
  <data key="d0">Less Than 70 Mg/Dl</data>
  <data key="d1">concept</data>
  <data key="d2">Less than 70 mg/dL is the glucose threshold defining Hypoglycemia Level 1.</data>
  <data key="d3">chunk-eccbaa35bd49db810bbf9c4a8d650469</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Metas glicêmicas/Metas no tratamento.pdf</data>
