  <data key="d12">1776644863</data>
  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Aumento Da Urina">
  <data key="d7">1.0</data>
  <data key="d8">Increased urination occurs as the body attempts to eliminate excess glucose in hiperglicemia.</data>
  <data key="d9">glucose excretion,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644864</data>
  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Cansaço E Fraqueza">
  <data key="d7">1.0</data>
  <data key="d8">Cansaço e fraqueza result from impaired cellular glucose utilization during hiperglicemia.</data>
  <data key="d9">energy deficiency,symptom manifestation</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644865</data>
  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Difícil Cicatrização">
  <data key="d7">1.0</data>
  <data key="d8">High blood sugar levels in hiperglicemia can impair wound healing.</data>
  <data key="d9">complication,tissue repair impairment</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
