  <data key="d5">1776643667</data>
  <data key="d6"></data>
</node>
<node id="Insulin Requiring Diabetes">
  <data key="d0">Insulin Requiring Diabetes</data>
  <data key="d1">condition</data>
  <data key="d2">Insulin requiring diabetes refers to types of diabetes where individuals depend on exogenous insulin for glycemic control.</data>
  <data key="d3">chunk-8651ec88cb5333f03b8af01fee4d3cb0</data>
