  <data key="d6"></data>
</node>
<node id="CLC">
  <data key="d0">CLC</data>
  <data key="d1">method</data>
  <data key="d2">CLC, or closed-loop control, is an automated insulin delivery method assessed for glycemic outcomes in type 1 diabetes.</data>
  <data key="d3">chunk-1eea5927c2474e7c5774b94980fc8b78</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
