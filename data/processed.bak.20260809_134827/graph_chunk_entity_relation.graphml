  <data key="d6"></data>
</node>
<node id="Diabetes Self-Management Support Software">
  <data key="d0">Diabetes Self-Management Support Software</data>
  <data key="d1">artifact</data>
  <data key="d2">Diabetes self-management support software serves as a medical device to assist individuals in managing diabetes through digital tools and data tracking.</data>
