  <data key="d11">data/raw/INSULINOTERAPIA/Complicações relacionadas ao uso da insulina/LIPODISTROFIAS.pdf</data>
  <data key="d12">1776640890</data>
  <data key="d13"></data>
</edge>
<edge source="Corticosteroids" target="Hyperglycemia Neonatal">
  <data key="d7">1.0</data>
  <data key="d8">Corticosteroids can cause neonatal hyperglycemia and must be ruled out during diagnosis.</data>
