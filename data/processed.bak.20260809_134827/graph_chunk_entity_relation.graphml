</edge>
<edge source="Hba1c" target="Diabetes Mellitus Diagnosis">
  <data key="d7">1.0</data>
  <data key="d8">HbA1c ≥6.5% is recommended as a diagnostic criterion for diabetes mellitus when combined with fasting glucose ≥126 mg/dL.</data>
