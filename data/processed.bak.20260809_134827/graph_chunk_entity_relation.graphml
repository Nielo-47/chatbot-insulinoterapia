  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638343</data>
  <data key="d13"></data>
</edge>
<edge source="Carbohydrate Intake" target="Oral Glucose Tolerance Testing">
  <data key="d7">1.0</data>
  <data key="d8">Patients must consume at least 150 g of carbohydrates for 3 days before oral glucose tolerance testing to ensure accurate results.</data>
