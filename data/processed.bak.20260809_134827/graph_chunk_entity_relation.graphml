</node>
<node id="HNF4A Gene">
  <data key="d0">HNF4A Gene</data>
  <data key="d1">artifact</data>
  <data key="d2">A gene implicated in monogenic diabetes, particularly in maturity onset diabetes of the young.</data>
  <data key="d3">chunk-f780163f31c33c2bd7449fb5a87b42ee</data>
