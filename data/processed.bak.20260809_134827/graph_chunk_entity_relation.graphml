</edge>
<edge source="Lipodistrofia Generalizada" target="Amenorrhea">
  <data key="d7">1.0</data>
  <data key="d8">Amenorrhea occurs in generalized lipodystrophy due to insulin resistance and hypoleptinemia.</data>
  <data key="d9">endocrine complication,reproductive disorder</data>
  <data key="d10">chunk-b4cd4168b98a4b43209b773ecb18d316</data>
