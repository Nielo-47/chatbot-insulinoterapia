  <data key="d13"></data>
</edge>
<edge source="Fixed-Needle Syringe" target="Healthcare Professionals">
  <data key="d7">1.0</data>
  <data key="d8">Healthcare professionals are advised to use fixed-needle syringes with 6 mm needles for safe and accurate insulin administration.</data>
  <data key="d9">recommended equipment,safe practice</data>
  <data key="d10">chunk-eb4a4dec39574c303988e93b87c351d4</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639101</data>
  <data key="d13"></data>
</edge>
<edge source="Fixed-Needle Syringe" target="Rapid-Acting Insulin">
  <data key="d7">1.0</data>
  <data key="d8">The fixed-needle syringe allows accurate measurement of odd and even insulin doses and ensures proper subcutaneous injection.</data>
  <data key="d9">dose precision,subcutaneous delivery</data>
