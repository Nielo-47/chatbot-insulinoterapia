</edge>
<edge source="Diabetes Mellitus" target="Monogenic Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">Monogenic diabetes is a hereditary form of diabetes mellitus with early onset and specific diagnostic criteria.</data>
