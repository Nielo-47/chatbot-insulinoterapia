  <data key="d5">1776647420</data>
  <data key="d6"></data>
</node>
<node id="Confirmatory Screening Test">
  <data key="d0">Confirmatory Screening Test</data>
  <data key="d1">method</data>
  <data key="d2">A confirmatory screening test is a repeated or alternative test used to validate an initial abnormal result for diabetes diagnosis.&lt;SEP&gt;A confirmatory screening test is a repeated or alternative test used to validate an initial abnormal result for diabetes diagnosis.</data>
  <data key="d3">chunk-20b3e88dda40e2d303af38aea0d19b86</data>
