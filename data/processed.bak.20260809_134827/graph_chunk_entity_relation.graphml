</edge>
<edge source="SICI" target="Quadro 1">
  <data key="d7">1.0</data>
  <data key="d8">Quadro 1 outlines the medical conditions and patient groups for which SICI is indicated, such as children under six and pregnant women.</data>
  <data key="d9">medical indications,patient criteria</data>
  <data key="d10">chunk-2b712afd345ff5f7503205905d3131f9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641903</data>
  <data key="d13"></data>
</edge>
<edge source="SICI" target="Quadro 2">
  <data key="d7">1.0</data>
  <data key="d8">Quadro 2 lists relative indications for SICI use, including poor glycemic control and frequent nocturnal hypoglycemia.</data>
  <data key="d9">clinical criteria,relative indications</data>
  <data key="d10">chunk-2b712afd345ff5f7503205905d3131f9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641904</data>
  <data key="d13"></data>
</edge>
<edge source="SICI" target="Quadro 3">
  <data key="d7">1.0</data>
  <data key="d8">Quadro 3 provides graded recommendations (e.g., Grade B) on the efficacy and safety of SICI in diabetes management.</data>
  <data key="d9">clinical evidence,recommendation grading</data>
  <data key="d10">chunk-2b712afd345ff5f7503205905d3131f9</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641905</data>
  <data key="d13"></data>
</edge>
<edge source="SICI" target="CARE">
  <data key="d7">1.0</data>
  <data key="d8">The CARE acronym is a strategy to help clinicians understand how SICI systems calculate and adjust insulin delivery.</data>
  <data key="d9">clinical strategy,dose calculation</data>
  <data key="d10">chunk-2b712afd345ff5f7503205905d3131f9</data>
