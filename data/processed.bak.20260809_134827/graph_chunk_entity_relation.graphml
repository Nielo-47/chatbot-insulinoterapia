</edge>
<edge source="Insulin Pens" target="Machry Rv">
  <data key="d7">1.0</data>
  <data key="d8">Machry RV conducted a randomized controlled trial comparing insulin pens and syringes in elderly patients with type 2 diabetes.</data>
  <data key="d9">clinical trial,elderly patients</data>
