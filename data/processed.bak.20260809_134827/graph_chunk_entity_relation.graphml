  <data key="d13"></data>
</edge>
<edge source="Caneta Recarregável" target="Fabricante">
  <data key="d7">1.0</data>
  <data key="d8">The rechargeable pen must be used with a refill from the same manufacturer to ensure accurate dosing and proper function.</data>
  <data key="d9">device compatibility,manufacturer specification</data>
  <data key="d10">chunk-780053d90e5c36ef6ea68e1a598cc53b</data>
