  <data key="d13"></data>
</edge>
<edge source="Insulin Application" target="i-Port">
  <data key="d7">1.0</data>
  <data key="d8">The i-Port device allows multiple insulin injections without daily skin punctures, improving comfort.</data>
  <data key="d9">injection convenience,reduced skin puncture</data>
  <data key="d10">chunk-84c3145631d64a0c7b9ea21dfb9c8275</data>
