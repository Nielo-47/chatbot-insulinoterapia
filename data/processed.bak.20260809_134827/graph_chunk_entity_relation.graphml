<edge source="Insulin NPH" target="Pharmacokinetics">
  <data key="d7">1.0</data>
  <data key="d8">Improper resuspension of Insulin NPH leads to significant alterations in pharmacokinetics, affecting plasma insulin concentrations.</data>
  <data key="d9">absorption variation,drug behavior</data>
