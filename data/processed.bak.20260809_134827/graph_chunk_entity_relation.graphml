  <data key="d12">1776644913</data>
  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Realizar Atividade Física">
  <data key="d7">1.0</data>
  <data key="d8">Physical activity improves insulin sensitivity and helps prevent hiperglicemia.</data>
  <data key="d9">metabolic regulation,prevention</data>
  <data key="d10">chunk-bdc1ebe811024ff43dc507d9ab063076</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/GLICEMIAS CAPILARES/HIPO_HIPER.pdf</data>
  <data key="d12">1776644917</data>
  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="Profissional De Saúde">
  <data key="d7">1.0</data>
  <data key="d8">O profissional de saúde deve ser contatado imediatamente em caso de hiperglicemia confirmada ou suspeita.</data>
