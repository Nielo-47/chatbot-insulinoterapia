  <data key="d12">1776638168</data>
  <data key="d13"></data>
</edge>
<edge source="Agulha De Insulina" target="Agulha De 4 Mm">
  <data key="d7">1.0</data>
  <data key="d8">A agulha de 4 mm é o modelo mais curto para canetas de insulina, recomendado por ser menos doloroso e seguro.</data>
  <data key="d9">product type,size variation</data>
  <data key="d10">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638396</data>
  <data key="d13"></data>
</edge>
<edge source="Agulha De Insulina" target="Agulha De 6 Mm">
  <data key="d7">1.0</data>
  <data key="d8">A agulha de 6 mm é usada em seringas e requer prega subcutânea para evitar aplicação no músculo.</data>
  <data key="d9">product type,size variation</data>
  <data key="d10">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638397</data>
  <data key="d13"></data>
</edge>
<edge source="Agulha De Insulina" target="Tecido Subcutâneo">
  <data key="d7">1.0</data>
  <data key="d8">Agulhas de insulina devem ser escolhidas conforme o tamanho adequado para garantir que a insulina atinja o tecido subcutâneo sem atingir o músculo.</data>
  <data key="d9">injection site,medical safety</data>
  <data key="d10">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638397</data>
