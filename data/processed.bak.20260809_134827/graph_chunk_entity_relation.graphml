</edge>
<edge source="Hypoglycemia" target="Diabetes Control And Complications Trial">
  <data key="d7">1.0</data>
  <data key="d8">The Diabetes Control And Complications Trial studied hypoglycemia as a key adverse effect associated with intensive diabetes treatment.</data>
  <data key="d9">adverse effect,clinical research</data>
  <data key="d10">chunk-ddf3203a55511f7874bc210d61b3ccfa</data>
  <data key="d11">data/raw/INSULINOTERAPIA/SICI (bomba de insulina)/sici.pdf</data>
  <data key="d12">1776641849</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Intensive Insulin Therapy">
  <data key="d7">1.0</data>
  <data key="d8">Intensive insulin therapy increased the incidence of severe hypoglycemia, particularly in patients achieving lower HbA1c levels.</data>
  <data key="d9">adverse effect,treatment risk</data>
  <data key="d10">chunk-a49920639f738eae3de220d132cbc081</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642347</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Long-Acting Insulin Analogs">
  <data key="d7">2.0</data>
  <data key="d8">Long-acting insulin analogs are associated with a lower frequency of hypoglycemia compared to NPH insulin in people with type 1 diabetes.&lt;SEP&gt;Long-acting insulin analogs are associated with a lower frequency of hypoglycemia, particularly at night, compared to insulin NPH.</data>
  <data key="d9">risk reduction,safety benefit,safety profile</data>
  <data key="d10">chunk-a49920639f738eae3de220d132cbc081&lt;SEP&gt;chunk-157fbe972c55a9a0df76dbef85b43e63</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642357</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Ultra-Long-Acting Insulin Analogs">
  <data key="d7">1.0</data>
  <data key="d8">Ultra-long-acting insulin analogs are linked to reduced incidence of hypoglycemia and greater flexibility, making them suitable for individuals at increased risk.</data>
  <data key="d9">risk reduction,safety advantage</data>
  <data key="d10">chunk-157fbe972c55a9a0df76dbef85b43e63</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642363</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Insulin NPH">
  <data key="d7">1.0</data>
  <data key="d8">Insulin NPH is associated with a higher frequency of hypoglycemia in people with type 1 diabetes compared to long-acting insulin analogs.</data>
  <data key="d9">risk factor,safety profile</data>
  <data key="d10">chunk-157fbe972c55a9a0df76dbef85b43e63</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Tipos de insulinas/Insulinoterapia – Diretriz da Sociedade Brasileira de Diabetes – Ed. 2024.pdf</data>
  <data key="d12">1776642364</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Flash Glucose Monitoring">
  <data key="d7">1.0</data>
  <data key="d8">Intermittently scanned continuous glucose monitoring is effective in preventing recurrent severe hypoglycemia.</data>
  <data key="d9">monitoring efficacy,risk reduction</data>
  <data key="d10">chunk-9f4e05859597c5f1693c2f9fe1ef0a02</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643712</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Blood Glucose Monitoring">
  <data key="d7">1.0</data>
  <data key="d8">Regular blood glucose monitoring helps prevent hypoglycemia by detecting low glucose levels early.</data>
  <data key="d9">prevention,safety monitoring</data>
  <data key="d10">chunk-e8bc02d862fc2c83e40dafc871482c2c</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643718</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Type 1 Diabetes">
  <data key="d7">2.0</data>
  <data key="d8">Individuals with type 1 diabetes are at risk for hypoglycemia, a primary outcome measured in glucose monitoring trials.&lt;SEP&gt;CGM use in type 1 diabetes reduces episodes of hypoglycemia, especially in young children.</data>
  <data key="d9">clinical risk,disease complication,risk reduction</data>
  <data key="d10">chunk-418c63d7f8a7a0408d9107e40d9251db&lt;SEP&gt;chunk-fdddb31a1876a8809b8555564982acd4</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643759</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="Sensor Use Frequency">
  <data key="d7">1.0</data>
  <data key="d8">Frequent scanning with isCGM devices is associated with reduced hypoglycemia episodes.</data>
  <data key="d9">risk reduction,usage pattern</data>
  <data key="d10">chunk-418c63d7f8a7a0408d9107e40d9251db</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643760</data>
  <data key="d13"></data>
</edge>
<edge source="Hypoglycemia" target="rtCGM">
  <data key="d7">2.0</data>
  <data key="d8">The use of rtCGM significantly reduced rates of emergency department visits and hospitalizations for hypoglycemia in a Veterans Affairs population.&lt;SEP&gt;rtCGM use in pregnancy showed no increase in hypoglycemia despite improved glycemic control.</data>
  <data key="d9">complication reduction,emergency care,glucose monitoring,safety</data>
  <data key="d10">chunk-fdddb31a1876a8809b8555564982acd4&lt;SEP&gt;chunk-a1f5c2bbe2ca0e80b85850ca2f9a5c84</data>
