  <data key="d12">1776647777</data>
  <data key="d13"></data>
</edge>
<edge source="Body Weight" target="Insulin Dosage">
  <data key="d7">1.0</data>
  <data key="d8">Body weight is a primary factor in calculating the initial and adjusted insulin dosage for a patient.</data>
