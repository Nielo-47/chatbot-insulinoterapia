  <data key="d6"></data>
</node>
<node id="Two-Hour Glucose Tolerance Testing">
  <data key="d0">Two-Hour Glucose Tolerance Testing</data>
  <data key="d1">method</data>
  <data key="d2">Two-hour glucose tolerance testing is a diagnostic procedure used to evaluate glucose metabolism and identify prediabetes or diabetes.&lt;SEP&gt;Two-hour glucose tolerance testing is a diagnostic procedure used to evaluate glucose metabolism and identify prediabetes or diabetes.</data>
  <data key="d3">chunk-2977bb9a41689e74de2c536343624744</data>
