  <data key="d12">1776638463</data>
  <data key="d13"></data>
</edge>
<edge source="Patient" target="Insulin Transport">
  <data key="d7">1.0</data>
  <data key="d8">Patients must carry insulin in their carry-on luggage during travel and avoid leaving it in hot or cold environments like car glove compartments.</data>
  <data key="d9">carry-on,travel safety</data>
  <data key="d10">chunk-03a1de93a53fbcb513268c123e2c5a16</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638469</data>
  <data key="d13"></data>
</edge>
<edge source="Patient" target="Insulin Lispro">
  <data key="d7">1.0</data>
  <data key="d8">Insulin lispro was administered at a time not aligned with the patient's meal schedule, causing severe hypoglycemia.</data>
  <data key="d9">adverse effect,timing error</data>
