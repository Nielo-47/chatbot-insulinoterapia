  <data key="d13"></data>
</edge>
<edge source="Hiperglicemia" target="HI">
  <data key="d7">2.0</data>
  <data key="d8">O indicador HI no glicosímetro geralmente indica uma condição de hiperglicemia, que pode ser perigosa.&lt;SEP&gt;A indicação HI no medidor ou sensor indica hiperglicemia, exigindo avaliação médica.</data>
