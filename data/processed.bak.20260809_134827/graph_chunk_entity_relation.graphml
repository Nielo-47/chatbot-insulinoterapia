  <data key="d12">1776647777</data>
  <data key="d13"></data>
</edge>
<edge source="Type 1 Diabetes" target="Immune Checkpoint Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Immune checkpoint inhibitors can trigger insulin-dependent type 1 diabetes through autoimmune mechanisms.</data>
  <data key="d9">adverse event,autoimmunity</data>
  <data key="d10">chunk-0510d1781e9c07bebd7a7422d453cbf2</data>
