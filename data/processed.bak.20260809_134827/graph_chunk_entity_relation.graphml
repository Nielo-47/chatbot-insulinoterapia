<edge source="Insulin Therapy" target="Chowdhury S">
  <data key="d7">1.0</data>
  <data key="d8">Chowdhury S conducted research on real-life errors in insulin therapy, particularly in developing countries.</data>
  <data key="d9">clinical error,research focus</data>
