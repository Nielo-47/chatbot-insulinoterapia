  <data key="d5">1776643648</data>
  <data key="d6"></data>
</node>
<node id="Long-Term Complications In Insulin-Dependent Diabetes Mellitus">
  <data key="d0">Long-Term Complications In Insulin-Dependent Diabetes Mellitus</data>
  <data key="d1">concept</data>
  <data key="d2">Long-term complications in insulin-dependent diabetes mellitus include retinopathy, nephropathy, and cardiovascular disease, influenced by glycemic control.</data>
  <data key="d3">chunk-6764f5f0af1c9855a1901ea1bef131d3</data>
