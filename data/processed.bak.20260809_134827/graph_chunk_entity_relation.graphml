  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Double-Check Procedure">
  <data key="d7">1.0</data>
  <data key="d8">The double-check procedure is implemented in nursing practice to verify insulin preparation and administration and reduce the risk of errors.</data>
  <data key="d9">error reduction,safety protocol</data>
  <data key="d10">chunk-dc6a188926df383900f31928c8726a8f</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
  <data key="d12">1776639158</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin" target="Healthcare Professionals">
  <data key="d7">1.0</data>
  <data key="d8">Healthcare professionals must undergo continuous training to safely manage insulin prescription, preparation, and administration and prevent critical errors.</data>
  <data key="d9">continuous training,medication safety</data>
  <data key="d10">chunk-dc6a188926df383900f31928c8726a8f</data>
