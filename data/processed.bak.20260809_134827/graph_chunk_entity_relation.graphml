  <data key="d6"></data>
</node>
<node id="Insulin Dosing Decision">
  <data key="d0">Insulin Dosing Decision</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin dosing decision is the process of determining the appropriate insulin dose based on glucose levels, which modern CGM systems like Dexcom G6 are approved to support without requiring confirmatory finger-prick tests.&lt;SEP&gt;Insulin dosing decision is the process of determining the appropriate insulin dose based on glucose levels, which modern CGM systems like Dexcom G6 are approved to support without requiring confirmatory finger-prick tests.</data>
  <data key="d3">chunk-08c7f7bb0209cabd75e27f9c8556c214</data>
  <data key="d4">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/Documento sem título.docx</data>
  <data key="d5">1776642917</data>
  <data key="d6"></data>
</node>
<node id="Você">
  <data key="d0">Você</data>
  <data key="d1">person</data>
  <data key="d2">You are a person with diabetes who may benefit from using a sensor for better treatment management.&lt;SEP&gt;You are a person with diabetes who may benefit from using a sensor for better treatment management.</data>
