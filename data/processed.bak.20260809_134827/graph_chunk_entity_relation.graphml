  <data key="d5">1776638194</data>
  <data key="d6"></data>
</node>
<node id="Intensive Education">
  <data key="d0">Intensive Education</data>
  <data key="d1">method</data>
  <data key="d2">Intensive education refers to structured, systematic, and continuous training on insulin application techniques provided to people with diabetes and caregivers to improve treatment outcomes.</data>
  <data key="d3">chunk-a7740b86f0b3f110bb2c3f3d05e4da41</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
