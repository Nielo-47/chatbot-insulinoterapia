</edge>
<edge source="Type 1 Diabetes" target="Diabetes in Young Adults Study">
  <data key="d7">1.0</data>
  <data key="d8">The Diabetes in Young Adults (DiYA) study examined the incidence and predictors of type 1 diabetes in adults aged 20–45 years.</data>
  <data key="d9">epidemiological research,incidence tracking</data>
  <data key="d10">chunk-9f76e40d0d9b4211d8c61a53ea298d0b</data>
