<edge source="Insulin Pen" target="HbA1c">
  <data key="d7">1.0</data>
  <data key="d8">Insulin pen use is associated with improved average HbA1c levels compared to syringe use.</data>
  <data key="d9">clinical outcome,glycemic control</data>
  <data key="d10">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
  <data key="d12">1776637712</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Pen" target="Hypoglycemia">
  <data key="d7">1.0</data>
  <data key="d8">Insulin pen use is linked to a lower incidence of hypoglycemia compared to syringe use.</data>
  <data key="d9">clinical benefit,risk reduction</data>
  <data key="d10">chunk-4fee4c8681a7629eb6ff0eb2470a98e3</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/Cópia de Técnicas de aplicação de insulina.pdf</data>
