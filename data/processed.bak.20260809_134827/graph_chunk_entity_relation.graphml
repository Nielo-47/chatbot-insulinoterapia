  <data key="d12">1776638174</data>
  <data key="d13"></data>
</edge>
<edge source="Insulin Injection Site Rotation" target="14-Day Reuse Rule">
  <data key="d7">1.0</data>
  <data key="d8">Following the 14-day reuse rule allows injection sites to heal and prevents skin lesions from frequent insulin administration.</data>
  <data key="d9">injury prevention,tissue recovery</data>
