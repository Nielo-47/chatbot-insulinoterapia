</edge>
<edge source="Type 2 Diabetes" target="Diabetes Complicating Pregnancy">
  <data key="d7">1.0</data>
  <data key="d8">Diabetes diagnosed during pregnancy using standard criteria is classified as diabetes complicating pregnancy, most often due to type 2 diabetes.</data>
