  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Standards of Care in Diabetes">
  <data key="d7">1.0</data>
  <data key="d8">The Standards of Care in Diabetes defines gestational diabetes mellitus as diabetes diagnosed during pregnancy.</data>
  <data key="d9">disease classification,pregnancy-related condition</data>
  <data key="d10">chunk-6f5cd98bab9909442c09e3fcd5b21fda</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647578</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Early Abnormal Glucose Metabolism">
  <data key="d7">1.0</data>
  <data key="d8">Individuals with early abnormal glucose metabolism are at high risk of a later diagnosis of gestational diabetes mellitus.</data>
  <data key="d9">diagnosis progression,risk factor</data>
  <data key="d10">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647603</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="75-G Oral Glucose Tolerance Test">
  <data key="d7">1.0</data>
  <data key="d8">Individuals with gestational diabetes mellitus should be screened postpartum using the 75-g oral glucose tolerance test to detect prediabetes or diabetes.</data>
  <data key="d9">diagnostic method,postpartum screening</data>
  <data key="d10">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647604</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Lifelong Screening">
  <data key="d7">1.0</data>
  <data key="d8">Individuals with a history of gestational diabetes mellitus should undergo lifelong screening for diabetes or prediabetes at least every 3 years.</data>
  <data key="d9">diabetes prevention,long-term monitoring</data>
  <data key="d10">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647606</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Intensive Lifestyle Interventions">
  <data key="d7">1.0</data>
  <data key="d8">Individuals with a history of gestational diabetes mellitus and prediabetes should receive intensive lifestyle interventions to prevent diabetes.</data>
  <data key="d9">prevention,treatment</data>
  <data key="d10">chunk-d6b2f90b1ec83426a0df84d7693bc26d</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647607</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Maternal Disorders Of Glucose Metabolism">
  <data key="d7">1.0</data>
  <data key="d8">Gestational diabetes mellitus is a form of maternal disorder of glucose metabolism occurring during pregnancy.</data>
  <data key="d9">disease association,metabolic condition</data>
  <data key="d10">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647689</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Childhood Adiposity">
  <data key="d7">1.0</data>
  <data key="d8">Maternal gestational diabetes is associated with increased childhood adiposity in offspring.</data>
  <data key="d9">long-term outcome,maternal-fetal health</data>
  <data key="d10">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647690</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Childhood Glucose Metabolism">
  <data key="d7">1.0</data>
  <data key="d8">Maternal gestational diabetes affects childhood glucose metabolism in later life.</data>
  <data key="d9">fetal programming,metabolic impact</data>
  <data key="d10">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647691</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="American College Of Obstetricians And Gynecologists">
  <data key="d7">1.0</data>
  <data key="d8">ACOG issues practice bulletins with recommendations for the diagnosis and management of gestational diabetes.</data>
  <data key="d9">clinical guidelines,practice bulletin</data>
  <data key="d10">chunk-45a8ca206e61b47964f899c929fbafb3</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647694</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Fasting Plasma Glucose">
  <data key="d7">1.0</data>
  <data key="d8">Fasting plasma glucose is used in the first prenatal visit to diagnose gestational diabetes mellitus in China.</data>
  <data key="d9">diagnostic method,disease detection</data>
  <data key="d10">chunk-4fab467dd1cac7fbb17a945a0aa8240f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647733</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Screening">
  <data key="d7">1.0</data>
  <data key="d8">Gestational diabetes mellitus is screened for between 24–28 weeks of gestation using standard diagnostic criteria.&gt;</data>
  <data key="d9">diagnostic protocol,pregnancy care</data>
  <data key="d10">chunk-8aa8638b27cbd181b507c81fea49c6f0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647794</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="A1c">
  <data key="d7">1.0</data>
  <data key="d8">A1C levels between 5.9% and 6.4% are used as a screening tool for early detection of abnormal glucose metabolism during pregnancy.&gt;</data>
  <data key="d9">diagnostic criterion,metabolic marker</data>
  <data key="d10">chunk-8aa8638b27cbd181b507c81fea49c6f0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647796</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Diabetes-Associated Autoantibodies">
  <data key="d7">1.0</data>
  <data key="d8">The presence of diabetes-associated autoantibodies is not typical in gestational diabetes mellitus, helping differentiate it from type 1 diabetes.&gt;</data>
  <data key="d9">differential diagnosis,exclusion criterion</data>
  <data key="d10">chunk-8aa8638b27cbd181b507c81fea49c6f0</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647827</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Göbl CS">
  <data key="d7">1.0</data>
  <data key="d8">Göbl CS studied whether early postpartum HbA1c is an appropriate predictor of future diabetes risk after gestational diabetes mellitus.</data>
  <data key="d9">postpartum monitoring,risk prediction</data>
  <data key="d10">chunk-050dc3a498d3027939b93706cbdb7f07</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647828</data>
  <data key="d13"></data>
</edge>
<edge source="Gestational Diabetes Mellitus" target="Megia A">
  <data key="d7">1.0</data>
  <data key="d8">Megia A evaluated the usefulness of HbA1c in reclassifying gestational diabetes after childbirth.</data>
  <data key="d9">HbA1c utility,diagnostic reclassification</data>
  <data key="d10">chunk-050dc3a498d3027939b93706cbdb7f07</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647851</data>
  <data key="d13"></data>
</edge>
<edge source="DKA" target="Autoantibody">
  <data key="d7">1.0</data>
  <data key="d8">Early detection of autoantibodies enables timely education and monitoring, which can prevent diabetic ketoacidosis.</data>
  <data key="d9">early detection,prevention</data>
  <data key="d10">chunk-e3bdf442194477639404123cea5d5974</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647490</data>
  <data key="d13"></data>
</edge>
<edge source="DKA" target="Myocardial Infarction">
  <data key="d7">1.0</data>
  <data key="d8">Myocardial infarction is a condition that may precipitate DKA in patients with type 2 diabetes.</data>
  <data key="d9">comorbidity,trigger</data>
  <data key="d10">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647506</data>
  <data key="d13"></data>
</edge>
<edge source="DKA" target="Atypical Antipsychotics">
  <data key="d7">1.0</data>
  <data key="d8">Atypical antipsychotics are linked to an increased risk of DKA in individuals with type 2 diabetes.</data>
  <data key="d9">drug-induced condition,risk factor</data>
  <data key="d10">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647508</data>
  <data key="d13"></data>
</edge>
<edge source="DKA" target="Sodium–Glucose Cotransporter 2 Inhibitors">
  <data key="d7">1.0</data>
  <data key="d8">Sodium–glucose cotransporter 2 inhibitors can contribute to the onset of DKA in people with type 2 diabetes.</data>
  <data key="d9">drug-induced condition,risk factor</data>
  <data key="d10">chunk-a51a13b6846af5dd45aca8b13432e7fc</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647509</data>
  <data key="d13"></data>
</edge>
<edge source="Ketosis" target="Infusion Sets">
  <data key="d7">1.0</data>
  <data key="d8">Issues with infusion sets such as dislodgement or occlusion can lead to insulin deficiency and place individuals at risk for ketosis and DKA.</data>
  <data key="d9">complication,risk factor</data>
  <data key="d10">chunk-f357ebc59eb6ed3dd2035a13da0df52f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643831</data>
  <data key="d13"></data>
</edge>
<edge source="Infusion Sets" target="Pump Site Infection">
  <data key="d7">1.0</data>
  <data key="d8">Pump site infections are a potential complication arising from the use of infusion sets.</data>
  <data key="d9">complication,infection risk</data>
  <data key="d10">chunk-f357ebc59eb6ed3dd2035a13da0df52f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643834</data>
  <data key="d13"></data>
</edge>
<edge source="Sensor-Augmented Pumps" target="ASPIRE Trial">
  <data key="d7">1.0</data>
  <data key="d8">The ASPIRE trial demonstrated that sensor-augmented pump therapy reduces nocturnal hypoglycemia without increasing A1C.</data>
  <data key="d9">clinical evidence,trial outcome</data>
  <data key="d10">chunk-f357ebc59eb6ed3dd2035a13da0df52f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643833</data>
  <data key="d13"></data>
</edge>
<edge source="Sensor-Augmented Pumps" target="Predictive Low Glucose Suspend">
  <data key="d7">1.0</data>
  <data key="d8">Predictive low glucose suspend is a feature of advanced sensor-augmented pumps that reduces time spent in hypoglycemia.</data>
  <data key="d9">glucose management,technology feature</data>
  <data key="d10">chunk-f357ebc59eb6ed3dd2035a13da0df52f</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643834</data>
  <data key="d13"></data>
</edge>
<edge source="Large-For-Gestational-Age Births" target="Two-Step Approach">
  <data key="d7">1.0</data>
  <data key="d8">The two-step approach helps reduce large-for-gestational-age births through treatment of maternal hyperglycemia.</data>
  <data key="d9">risk reduction,treatment outcome</data>
  <data key="d10">chunk-7869f89a9c58ace31efe679a36aab7cf</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/METAS GLICÊMICAS/Diagnostico e Classificação/Classification and Diagnosis of.pdf</data>
  <data key="d12">1776647729</data>
  <data key="d13"></data>
</edge>
<edge source="Tidepool" target="U.S. Health Insurance Portability And Accountability Act Of 1996">
  <data key="d7">1.0</data>
  <data key="d8">Tidepool complies with HIPAA regulations to ensure secure handling of personal health data.</data>
  <data key="d9">data compliance,security standards</data>
  <data key="d10">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643842</data>
  <data key="d13"></data>
</edge>
<edge source="Glooko" target="U.S. Health Insurance Portability And Accountability Act Of 1996">
  <data key="d7">1.0</data>
  <data key="d8">Glooko is designed with data security features that comply with HIPAA requirements.</data>
  <data key="d9">data compliance,security standards</data>
  <data key="d10">chunk-03ff5070c8f5a6109621d29aa2b13398</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
  <data key="d12">1776643843</data>
  <data key="d13"></data>
</edge>
<edge source="Diabetes Prevention Program" target="Diabetes Prevention Program Research Group">
  <data key="d7">1.0</data>
  <data key="d8">The Diabetes Prevention Program Research Group conducted the Diabetes Prevention Program as a randomized clinical trial.</data>
  <data key="d9">clinical trial,research initiative</data>
