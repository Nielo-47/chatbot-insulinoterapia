  <data key="d6"></data>
</node>
<node id="Blood Vessel">
  <data key="d0">Blood Vessel</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Accidentally touching a blood vessel during injection may cause sharp pain but does not result in serious harm.&lt;SEP&gt;Accidentally touching a blood vessel during injection may cause sharp pain but does not result in serious harm.</data>
