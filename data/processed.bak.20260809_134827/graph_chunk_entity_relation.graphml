  <data key="d13"></data>
</edge>
<edge source="Rapid-Acting Insulin" target="30-Unit Syringe">
  <data key="d7">1.0</data>
  <data key="d8">The 30-unit syringe enables precise delivery of small and odd insulin doses, ideal for children and adolescents using rapid-acting insulin.</data>
  <data key="d9">dose accuracy,pediatric use</data>
  <data key="d10">chunk-eb4a4dec39574c303988e93b87c351d4</data>
