</edge>
<edge source="Insulina" target="Diabetes Tipo 2">
  <data key="d7">1.0</data>
  <data key="d8">A insulina é parte natural do tratamento do diabetes tipo 2 e não deve ser encarada como punição.</data>
  <data key="d9">componente natural,tratamento médico</data>
