</edge>
<edge source="Screening For Diabetes" target="Cost-Effectiveness">
  <data key="d7">1.0</data>
  <data key="d8">Studies indicate that diabetes screening starting at age 30 or 45 may be cost-effective, especially when measured in quality-adjusted life years.</data>
  <data key="d9">economic evaluation,efficiency</data>
  <data key="d10">chunk-8317327cb2c248762b2dc3852c662000</data>
