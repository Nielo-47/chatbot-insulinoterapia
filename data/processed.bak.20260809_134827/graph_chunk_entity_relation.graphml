  <data key="d5">1776647353</data>
  <data key="d6"></data>
</node>
<node id="ADA Professional Practice Committee">
  <data key="d0">ADA Professional Practice Committee</data>
  <data key="d1">organization</data>
  <data key="d2">The ADA Professional Practice Committee is a multidisciplinary expert group responsible for updating the Standards of Care annually.&lt;SEP&gt;The ADA Professional Practice Committee is a multidisciplinary expert committee responsible for annually updating the ADA's Standards of Care.&lt;SEP&gt;The ADA Professional Practice Committee is a multidisciplinary expert committee responsible for annually updating the ADA's Standards of Care.</data>
  <data key="d3">chunk-f0524115c9e0c2a0ed35c413e50c658e&lt;SEP&gt;chunk-6f5cd98bab9909442c09e3fcd5b21fda</data>
