  <data key="d6"></data>
</node>
<node id="Children And Adolescents With Diabetes">
  <data key="d0">Children And Adolescents With Diabetes</data>
  <data key="d1">concept</data>
  <data key="d2">Children and adolescents with diabetes are a patient group requiring specialized glycemic management, often involving insulin therapy.</data>
