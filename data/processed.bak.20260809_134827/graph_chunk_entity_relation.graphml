  <data key="d13"></data>
</edge>
<edge source="Physical Examination" target="Lipodystrophies">
  <data key="d7">1.0</data>
  <data key="d8">Physical examination helps identify characteristic signs of lipodystrophy, including fat loss, muscle prominence, and phlebomegaly.</data>
  <data key="d9">clinical assessment,physical signs</data>
  <data key="d10">chunk-d000f0bd5254e1a2df1aba208ecc4170</data>
