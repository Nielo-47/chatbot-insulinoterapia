  <data key="d13"></data>
</edge>
<edge source="Physical Activity" target="Insulin Dose">
  <data key="d7">1.0</data>
  <data key="d8">Physical activity affects insulin needs, often requiring lower doses to prevent hypoglycemia.</data>
  <data key="d9">dose adjustment,metabolic demand</data>
