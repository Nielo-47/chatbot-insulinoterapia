</edge>
<edge source="Glucose Oxidase Monitors" target="Ascorbic Acid">
  <data key="d7">1.0</data>
  <data key="d8">Ascorbic acid can cause falsely high or low readings in glucose oxidase-based meters.</data>
  <data key="d9">chemical interference,false result</data>
  <data key="d10">chunk-f12d6a3cebf5c39bed5629c359502cae</data>
  <data key="d11">data/raw/MONITORIZAÇÃO GLICÊMICA/CGM/blood glucose monitoring.pdf</data>
