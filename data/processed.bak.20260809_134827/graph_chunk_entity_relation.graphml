  <data key="d0">Resíduos Químicos</data>
  <data key="d1">concept</data>
  <data key="d2">Resíduos químicos are chemical waste materials from medical devices or treatments that require safe handling and disposal.</data>
  <data key="d3">chunk-13a3958ecd422660b4cd1e47e31e1b9c</data>
  <data key="d4">data/raw/INSULINOTERAPIA/Descarte/descarte.pdf</data>
  <data key="d5">1776641200</data>
