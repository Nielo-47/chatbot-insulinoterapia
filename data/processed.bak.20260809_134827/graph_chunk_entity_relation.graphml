  <data key="d13"></data>
</edge>
<edge source="Insulina" target="Caneta De Insulina">
  <data key="d7">1.0</data>
  <data key="d8">Canetas de insulina são projetadas para aplicar insulina, com tipos específicos de insulina compatíveis apenas com canetas.</data>
  <data key="d9">compatibility,medication delivery</data>
  <data key="d10">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638391</data>
  <data key="d13"></data>
</edge>
<edge source="Insulina" target="Seringa">
  <data key="d7">1.0</data>
  <data key="d8">Seringas são usadas como alternativa às canetas para aplicar insulina, especialmente em doses pequenas ou precisas.</data>
  <data key="d9">alternative method,medication delivery</data>
  <data key="d10">chunk-ebdb9452013f0e340884677832714553</data>
  <data key="d11">data/raw/DOC Completo.docx</data>
  <data key="d12">1776638395</data>
  <data key="d13"></data>
</edge>
<edge source="Insulina" target="Geladeira Doméstica">
  <data key="d7">1.0</data>
  <data key="d8">Insulina deve ser armazenada na geladeira doméstica entre 2 e 8°C para manter sua estabilidade.</data>
  <data key="d9">storage,temperature control</data>
  <data key="d10">chunk-a81bec86298f297d9be7cc985a7eddb6</data>
  <data key="d11">data/raw/INSULINOTERAPIA/Aplicação de insulina/uso da insulina - Diretrizes-Sociedade-Brasileira-de-Diabetes-2019-2020.pdf</data>
