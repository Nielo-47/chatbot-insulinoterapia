  <data key="d7">1.0</data>
  <data key="d8">Kuang A is a researcher involved in the HAPO Follow-up Study on metabolic outcomes in mothers after gestational diabetes.</data>
  <data key="d9">authorship,research contribution</data>
  <data key="d10">chunk-2f5ebd46f8491409b5f07f5c83542afd</data>
