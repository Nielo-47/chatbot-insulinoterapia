# OpenRouter (LLM completions - OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_SITE_TITLE=

# LLM Configuration
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_MODEL_FALLBACK=anthropic/claude-3-haiku
LLM_TIMEOUT_SECONDS=30
LLM_PRIMARY_RETRIES=1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_FALLBACK_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_PRIMARY_RETRIES=1
EMBEDDING_FALLBACK_RETRIES=0
EMBEDDING_DIM=1024
MAX_EMBED_TOKENS=8192

# RAG Query Settings
RAG_QUERY_TEMPERATURE=0.1
RAG_QUERY_MAX_TOKENS=500

# Database Connection Settings (Supabase Postgres, pooled connection).
# Use the transaction pooler URL from Supabase Dashboard > Project Settings >
# Database > Connection string (with pgbouncer, port 6543). Example:
# postgresql+psycopg://postgres.<ref>:<STRONG_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Cache
CHAT_CACHE_REDIS_URL=redis://redis:6379/1
CHAT_CACHE_TTL_SECONDS=300
CHAT_CACHE_KEY_PREFIX=chat:conv
SEMANTIC_CACHE_THRESHOLD=0.9

# Data Paths
WORKING_DIR=data/processed

# Authentication is delegated to Supabase Auth (email + password). The
# frontend authenticates via supabase-js (PKCE) and sends the JWT access token
# to the backend as a Bearer header; the backend verifies it against the
# project's public JWKS endpoint (RS256, SUPABASE_JWKS_URL). Account deletion
# calls the "delete-account" edge function (supabase/functions/delete-account),
# built with @supabase/server, which verifies the caller's JWT and uses the
# secret key injected automatically by the edge runtime — it never lives in
# this stack:
#
#   supabase functions deploy delete-account
#   supabase secrets set SUPABASE_SECRET_KEY=<your secret key>

# Supabase project URL (e.g. https://<ref>.supabase.co). No trailing slash.
SUPABASE_URL=
# Public JWKS endpoint (Project Settings > API > JWT Settings). Required: the
# backend verifies access tokens against these public signing keys.
SUPABASE_JWKS_URL=

# Frontend build-time variables (docker compose build args; defaults shown).
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY are also used at container start
# to extend the CSP connect-src so supabase-js can reach Supabase directly.
VITE_API_URL=/api
VITE_REQUEST_TIMEOUT_MS=60000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ngrok tunnel (docker-compose service "ngrok"). Required: your ngrok authtoken
# from https://dashboard.ngrok.com/get-started/your-authtoken, plus the static
# dev domain assigned to your account (https://dashboard.ngrok.com/domains).
# The tunnel is pinned to NGROK_STATIC_DOMAIN so the URL never rotates: the
# Supabase email-confirmation redirects are allowlisted against it, and the
# frontend's localStorage session is scoped to it.
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=

# Query rate limiting (per user) — app-level quota; login throttling/lockout
# are owned by Supabase Auth.
QUERY_RATE_LIMIT=30
QUERY_RATE_WINDOW_SECONDS=60

# Conversation
CONVERSATION_HISTORY_LIMIT=50
SUMMARIZE_MAX_MESSAGES=20
CHECKPOINTER_ENABLED=false
SUMMARIZER_TEMPERATURE=0.1
SUMMARIZER_MAX_TOKENS=300
CRITIQUE_TEMPERATURE=0.0
CRITIQUE_MAX_TOKENS=600
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=800

# API
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# LLM semantic cache (Redis). GLOBAL and keyed by prompt hash — NOT user-scoped,
# so a cached response containing PII could be served to another user. Disabled
# by default for that reason; enable only if responses can never contain
# user-specific data.
SEMANTIC_CACHE_ENABLED=false

# UI / TLS
# The UI nginx serves HTTPS on port 443 (HTTP on port 3000 redirects to it).
# Without certificates mounted, a self-signed cert is generated at container
# start (browsers show a warning; HSTS stays off). To use a trusted cert, place
# server.crt + server.key in ./certs (repo root) and restart the ui service;
# HSTS is then enabled automatically.
UI_HTTP_PORT=3000
UI_HTTPS_PORT=443
