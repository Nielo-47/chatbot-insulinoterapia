# OpenRouter (LLM completions - OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_SITE_TITLE=

# LLM Configuration
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_MODEL_FALLBACK=anthropic/claude-3-haiku
LLM_TIMEOUT_SECONDS=30
LLM_PRIMARY_RETRIES=1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_FALLBACK_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_PRIMARY_RETRIES=1
EMBEDDING_FALLBACK_RETRIES=0
EMBEDDING_DIM=1024
MAX_EMBED_TOKENS=8192

# RAG Query Settings
RAG_QUERY_TEMPERATURE=0.1
RAG_QUERY_MAX_TOKENS=500

# Database Connection Settings
# DATABASE_URL is required and is what the backend uses to connect.
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD are OPTIONAL: when left empty,
# the postgres service derives them from DATABASE_URL at startup (see
# scripts/postgres-entrypoint.sh), so `docker compose up` works with only
# DATABASE_URL set. If set, they must match the credentials in DATABASE_URL.
# Example: postgresql+psycopg://diabetes_chatbot:<STRONG_PASSWORD>@postgres:5432/diabetes_chatbot
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Cache
CHAT_CACHE_REDIS_URL=redis://redis:6379/1
CHAT_CACHE_TTL_SECONDS=300
CHAT_CACHE_KEY_PREFIX=chat:conv
SEMANTIC_CACHE_THRESHOLD=0.9

# Data Paths
WORKING_DIR=data/processed

# Authentication is fully delegated to Authentik (forward-auth proxy at the
# nginx edge). The backend never sees passwords and never issues tokens: it only
# consumes the X-authentik-uid / X-authentik-username headers injected by nginx
# after a successful Authentik auth subrequest, and uses the Admin API below for
# account deletion.

# Authentik deployment (docker-compose services authentik-server/authentik-worker)
# AUTHENTIK_SECRET_KEY: required, must be a strong random value (openssl rand -hex 32).
# AUTHENTIK_BOOTSTRAP_TOKEN/PASSWORD/EMAIL: used ONLY on first boot to create the
# admin user (bootstrap_*). Remove them after the initial provisioning.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=

# Base URL used by the backend Admin API for account deletion. Reachable
# directly from the docker network, so http://authentik-server:9000 works; leave
# empty only if account deletion should fail closed (502).
AUTHENTIK_BASE_URL=http://authentik-server:9000
# The app's public URL as registered on the Authentik outpost provider
# (external_host). NOT set by hand: the authentik-server/worker entrypoint
# (scripts/authentik-entrypoint.sh) discovers the ngrok tunnel URL at container
# start and exports it as AUTHENTIK_APP_EXTERNAL_HOST, which the
# blueprints/authentik.yaml provider/application/outpost entries consume.

# Service-account token for the Authentik Admin API (account deletion only).
# Optional: when empty, account deletion fails closed (502). The blueprint
# creates a token with this exact value as its key (identifier
# "authentik-admin-api") when set.
AUTHENTIK_ADMIN_API_TOKEN=

# Authentik Postgres (dedicated auth database; not the application DB).
# On the docker network the host is authentik-db.
AUTHENTIK_POSTGRESQL__HOST=authentik-db
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=

# Authentik Redis (shares the application Redis; separate logical DB).
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_REDIS__DB=2

# ngrok tunnel (docker-compose service "ngrok"). Required: your ngrok authtoken
# from https://dashboard.ngrok.com/get-started/your-authtoken. The tunnel URL is
# discovered automatically at Authentik container start. The URL rotates on each
# ngrok restart unless you configure a reserved domain in scripts/ngrok.yml.
NGROK_AUTHTOKEN=

# Beta users created by blueprints/authentik.yaml (members of the "beta_users"
# group; each entry is skipped when its username is empty). Password is shared
# across both users and must be set for them to be able to log in.
AUTHENTIK_BETA_PASSWORD=
AUTHENTIK_BETA_USER_1_USERNAME=
AUTHENTIK_BETA_USER_1_NAME=
AUTHENTIK_BETA_USER_1_EMAIL=
AUTHENTIK_BETA_USER_2_USERNAME=
AUTHENTIK_BETA_USER_2_NAME=
AUTHENTIK_BETA_USER_2_EMAIL=

# Frontend redirect URLs into Authentik (same-origin via nginx by default; the
# base URL is left empty so login/logout stay on the app origin regardless of the
# ngrok tunnel URL).
VITE_AUTHENTIK_LOGIN_FLOW=default-authentication-flow
VITE_AUTHENTIK_LOGOUT_FLOW=default-invalidation-flow

# Query rate limiting (per user) — app-level quota; login throttling/lockout
# are owned by Authentik.
QUERY_RATE_LIMIT=30
QUERY_RATE_WINDOW_SECONDS=60

# Conversation
CONVERSATION_HISTORY_LIMIT=50
SUMMARIZE_MAX_MESSAGES=20
CHECKPOINTER_ENABLED=false
SUMMARIZER_TEMPERATURE=0.1
SUMMARIZER_MAX_TOKENS=300
CRITIQUE_TEMPERATURE=0.0
CRITIQUE_MAX_TOKENS=600
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=800

# API
DEV=false
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# API docs (/docs, /redoc, /openapi.json). Disabled by default to avoid
# exposing the API schema for reconnaissance; set to true only for development.
DOCS_ENABLED=false

# Trusted reverse proxies for real client IP resolution and Authentik identity
# headers. X-Real-IP / X-Forwarded-For and the Authentik X-authentik-* headers
# are honored ONLY when the request's direct peer matches one of these entries
# (comma-separated IPs or CIDRs). For the compose stack this is the docker
# private network range (default 172.16.0.0/12). Empty disables forwarded-IP
# handling entirely (and would also break authentication, since identity only
# arrives via the proxy headers).
TRUSTED_PROXY_IPS=172.16.0.0/12

# LLM semantic cache (Redis). GLOBAL and keyed by prompt hash — NOT user-scoped,
# so a cached response containing PII could be served to another user. Disabled
# by default for that reason; enable only if responses can never contain
# user-specific data.
SEMANTIC_CACHE_ENABLED=false

# UI / TLS
# The UI nginx serves HTTPS on port 443 (HTTP on port 3000 redirects to it).
# Without certificates mounted, a self-signed cert is generated at container
# start (browsers show a warning; HSTS stays off). To use a trusted cert, place
# server.crt + server.key in ./certs (repo root) and restart the ui service;
# HSTS is then enabled automatically.
UI_HTTP_PORT=3000
UI_HTTPS_PORT=443

# UI build-time variables (docker compose build args; defaults shown).
VITE_API_URL=/api
VITE_REQUEST_TIMEOUT_MS=60000