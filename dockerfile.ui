FROM node:20-alpine AS build

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
ARG VITE_API_URL=/api
ARG VITE_REQUEST_TIMEOUT_MS=60000
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_REQUEST_TIMEOUT_MS=${VITE_REQUEST_TIMEOUT_MS}
RUN npm run build

FROM nginx:1.27-alpine

RUN apk add --no-cache openssl curl

COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx/ui.conf.tmpl /etc/nginx/ui.conf.tmpl
COPY frontend/nginx/10-security-config.sh /docker-entrypoint.d/10-security-config.sh
RUN chmod +x /docker-entrypoint.d/10-security-config.sh

EXPOSE 80 443

# /etc/nginx/certs (optional) is mounted by docker-compose for real certificates.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS -o /dev/null --insecure https://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
