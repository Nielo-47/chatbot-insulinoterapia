FROM node:20-alpine AS build

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
ARG VITE_API_URL=/api
ARG VITE_REQUEST_TIMEOUT_MS=60000
ARG VITE_AUTHENTIK_BASE_URL=
ARG VITE_AUTHENTIK_LOGIN_FLOW=default-authentication-flow
ARG VITE_AUTHENTIK_LOGOUT_FLOW=default-invalidation-flow
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_REQUEST_TIMEOUT_MS=${VITE_REQUEST_TIMEOUT_MS}
ENV VITE_AUTHENTIK_BASE_URL=${VITE_AUTHENTIK_BASE_URL}
ENV VITE_AUTHENTIK_LOGIN_FLOW=${VITE_AUTHENTIK_LOGIN_FLOW}
ENV VITE_AUTHENTIK_LOGOUT_FLOW=${VITE_AUTHENTIK_LOGOUT_FLOW}
RUN npm run build

FROM nginx:1.27-alpine

RUN apk add --no-cache openssl curl

COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx/ui.conf.tmpl /etc/nginx/ui.conf.tmpl
COPY frontend/nginx/security-headers.conf.tmpl /etc/nginx/security-headers.conf.tmpl
COPY frontend/nginx/10-security-config.sh /docker-entrypoint.d/10-security-config.sh
RUN chmod +x /docker-entrypoint.d/10-security-config.sh

EXPOSE 80 443

# /etc/nginx/certs (optional) is mounted by docker-compose for real certificates.
# Healthcheck hits /api/health, which is exempt from forward-auth, and uses
# --insecure because it connects to localhost with either self-signed or real
# certs. This is container-internal traffic only.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS -o /dev/null --insecure https://127.0.0.1/api/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
